# Ambiente dos prints da interface grafica (fliperos-setup/gui): o Ubuntu da
# ISO com o pygame. Os prints saem com o driver de video "dummy" do SDL, sem
# X nem placa de video (tools/gui-shots.sh).
#   docker build -t fliperos-guitest -f tools/Dockerfile.guitest tools
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pygame jq util-linux \
    && rm -rf /var/lib/apt/lists/*
