[Unit]
Description=FliperOS Pixelcade marquee (pixelweb)
# So depois do Setup > Games > Extras > Pixelcade (config/fliperos-pixelcade fetch).
ConditionPathExists=/home/fliperos/pixelcade/pixelweb
After=network.target
# Sem o marquee conectado o pixelweb procura uns 30 s e sai com erro, mesmo
# com -devicescan: tres tentativas (a USB ainda enumerando no boot) e para. A
# udev (99-fliperos-pixelcade.rules) o abre quando o marquee e conectado.
StartLimitIntervalSec=180
StartLimitBurst=3

[Service]
User=fliperos
WorkingDirectory=/home/fliperos/pixelcade
ExecStart=/opt/fliperos/bin/fliperos-pixelcade daemon
# "Bye" no marquee quando o computador desliga (numa reabertura do servico,
# nada).
ExecStop=-/opt/fliperos/bin/fliperos-pixelcade bye pixelcade
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
