#!/usr/bin/env python3
# O placar de uma partida versus no LED do gabinete (Pixelcade, ZeDMD): as
# vitorias da sessao de cada lado e os pontos do jogo ao vivo.
#
# O jogo so desenha o placar na tela, entao ele e lido da memoria do jogo.
# De onde vem os enderecos:
#
#   - os detectores do Fightcade (github.com/fightcadeorg/fightcade-detectors,
#     um arquivo por jogo, mais de 300): onde a partida comeca, onde cada lado
#     ganha e o personagem de cada um. E o mapa que o Fightcade usa para saber
#     quem ganhou cada partida online. Sem licenca no repositorio, entao nao
#     vem na imagem: o "fetch" os baixa (o Setup > System > Extras o chama junto do
#     Pixelcade e do ZeDMD). Dao as vitorias; os pontos, nao.
#   - /etc/fliperos/versus-games.conf (e ~/config/versus-games.conf, para
#     experimentar): valores lidos direto, como os pontos de cada jogador.
#
# Quem le a memoria:
#
#   - GroovyMAME: o plugin fliperos-versus (config/mame-plugins) avalia os
#     detectores e le a tabela, e escreve o resultado (fliperos_wins1,
#     fliperos_char1, fliperos_score1...) num arquivo em $XDG_RUNTIME_DIR,
#     que daqui se acompanha. Nao sao saidas do MAME: no MAME de agora um
#     script nao cria saidas novas.
#   - RetroArch: o Network Command Interface (UDP 55355), ligado pelo
#     /etc/fliperos/retroarch/versus.cfg. Os detectores valem no core FBNeo,
#     o emulador para o qual foram escritos: a memoria principal do jogo vem
#     por READ_CORE_RAM, e o detector e avaliado aqui. As linhas "retroarch"
#     da tabela vao por READ_CORE_MEMORY. Os cores do MAME (mame2010, mame)
#     nao deixam ler a memoria.
#   - SM2-Emu (Model 2): o proprio emulador le a memoria e publica os rounds
#     de cada lado (P1_Wins, P2_Wins) entre as saidas do jogo, na porta 8000
#     (o protocolo do MAMEHooker; ver config/fliperos-outputs). Os jogos que
#     os tem sao os do games.xml dele (o patch em config/sm2-emu-patches).
#
# As vitorias da sessao vem do detector, do proprio jogo (wins1, wins2) ou
# dos rounds: o vencedor e contado quando os rounds voltam a zero. A cada
# mudanca vai um evento "versus" para o config/fliperos-pixelcade.
#
#   fliperos-versus has SOURCE GAME          status 0 se ha placar para o jogo (SOURCE: mame | retroarch | model2)
#   fliperos-versus run SOURCE GAME [PID]    o placar no LED ate o jogo (o processo PID) fechar
#   fliperos-versus watch SOURCE GAME        mostra cada valor quando muda (para conferir um jogo)
#   fliperos-versus fetch                    baixa os detectores do Fightcade (de novo: atualiza)
import io
import os
import re
import socket
import subprocess
import sys
import tarfile
import time
import urllib.request

TABLES = os.environ.get('VERSUS_TABLES', '/etc/fliperos/versus-games.conf:/home/fliperos/config/versus-games.conf')
PIXELCADE = os.environ.get('FLIPEROS_PIXELCADE', '/opt/fliperos/bin/fliperos-pixelcade')
# O arquivo em que o plugin do MAME escreve o placar (o mesmo caminho de la).
FEED = os.environ.get('VERSUS_FEED') or os.path.join(os.environ.get('XDG_RUNTIME_DIR') or '/tmp', 'fliperos-versus.feed')
RA_COMMAND = os.environ.get('RA_COMMAND', '127.0.0.1:55355')
# As saidas do SM2-Emu e a tabela de jogos dele, ao lado do binario.
SM2_OUTPUTS = os.environ.get('SM2_OUTPUTS', '127.0.0.1:8000')
SM2_GAMES = os.environ.get('SM2_GAMES', '/home/fliperos/.local/src/sm2-emu/build/bin/games.xml')
# Os detectores do Fightcade, num commit fixo (a pasta que o plugin do MAME le).
DETECTORS = os.environ.get('VERSUS_DETECTORS', '/home/fliperos/.local/share/fliperos/versus-detectors')
DETECTORS_COMMIT = 'de9e7a99c494af488ed64155678e9d22d78f7ae6'
DETECTORS_URL = os.environ.get(
    'VERSUS_DETECTORS_URL',
    'https://codeload.github.com/fightcadeorg/fightcade-detectors/tar.gz/' + DETECTORS_COMMIT)
# As areas de um detector que cada fonte sabe ler. "raw" e o endereco da
# CPU; as outras sao areas de memoria do FBNeo: a RAM do CPS, a do Neo Geo e
# a do CPS3. No MAME o plugin as converte em enderecos da CPU. No core FBNeo
# do RetroArch cada uma e a memoria principal do jogo (READ_CORE_RAM), no
# mesmo arranjo que o detector descreve; o "raw" la nao da, porque o core nao
# diz em que endereco cada area fica.
DETECTOR_AREAS = {'mame': ('raw', 'CpsRamFF', '68K RAM', 'Main RAM'),
                  'retroarch': ('CpsRamFF', '68K RAM', 'Main RAM')}
# Os tempos do Fightcade (vid_overlay.cpp), em segundos de 60 quadros: uma
# condicao vale depois de 30 quadros seguidos, e a vitoria so e procurada 300
# quadros depois de a espera pelo comeco ter iniciado. No RetroArch a
# memoria e lida 10 vezes por segundo.
HOLD = float(os.environ.get('VERSUS_HOLD', '0.5'))
START_WAIT = float(os.environ.get('VERSUS_START_WAIT', '5'))
POLL = float(os.environ.get('VERSUS_POLL', '0.1'))
FIELDS = ('score1', 'score2', 'rounds1', 'rounds2', 'wins1', 'wins2', 'char1', 'char2')
FORMATS = ('bcd', 'bcdle', 'bin', 'binle')
# Segundos entre dois eventos (os pontos mudam muitas vezes por segundo).
EVERY = float(os.environ.get('VERSUS_EVERY', '0.5'))


# -- Tabela ----------------------------------------------------------

# read_tables: {fonte: {jogo: {campo: (endereco, bytes, formato, multiplicador)}}}
# e os clones. Um jogo num arquivo lido depois troca o mesmo jogo dos
# anteriores.
def read_tables(paths=None):
    games, clones = {'mame': {}, 'retroarch': {}}, {}
    for path in (paths or TABLES).split(':'):
        try:
            with open(path, encoding='utf-8', errors='replace') as f:
                lines = f.readlines()
        except OSError:
            continue
        seen = set()
        for line in lines:
            words = line.split('#', 1)[0].split()
            if len(words) >= 3 and words[0] == 'clone':
                clones[words[1]] = words[2]
            elif len(words) >= 6 and words[0] in games:
                source, game, field = words[:3]
                fmt, _, mult = words[5].partition('*')
                try:
                    entry = (int(words[3], 16), int(words[4]), fmt, int(mult or 1))
                except ValueError:
                    continue
                if field not in FIELDS or fmt not in FORMATS or not 0 < entry[1] <= 8:
                    continue
                if (source, game) not in seen:
                    seen.add((source, game))
                    games[source][game] = {}
                games[source][game][field] = entry
    return games, clones


def lookup(source, game, tables=None):
    games, clones = tables or read_tables()
    for _ in range(8):
        if game in games.get(source, {}):
            return games[source][game]
        if game not in clones:
            break
        game = clones[game]
    return None


# -- Detectores do Fightcade -----------------------------------------

# read_detector: do <jogo>.inf, os nomes dos personagens pelo numero
# ("char=3,Guile") e se ha os campos char1/char2; None sem o arquivo ou sem
# as tres linhas que fazem um detector (start, player1, player2). Quem
# avalia os enderecos e o plugin do MAME.
def read_detector(game, source='mame'):
    if not re.fullmatch(r'[A-Za-z0-9_]+', game):
        return None
    try:
        with open(os.path.join(DETECTORS, game + '.inf'), encoding='utf-8', errors='replace') as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    names = {}
    found = {'start': [], 'player1': [], 'player2': [], 'char1': [], 'char2': []}
    for line in lines:
        target, sep, rest = line.strip().partition('=')
        if not sep:
            continue
        if target == 'char':
            number, _, name = rest.partition(',')
            if number.strip().isdigit() and name.strip():
                names[int(number)] = name.strip()
            continue
        # "alvo=nome,area,operacao,0xENDERECO,valor,bits"
        parts = rest.split(',')
        if target not in found or len(parts) < 6:
            continue
        try:
            entry = {'area': parts[1], 'op': parts[2], 'ptr': int(parts[3], 16), 'value': int(parts[4]),
                     'bits': int(parts[5])}
        except ValueError:
            continue
        known = entry['area'] in DETECTOR_AREAS[source]
        if target in ('char1', 'char2'):
            if known:
                found[target] = [entry]
        elif not known:
            # Uma area que esta fonte nao sabe ler: o jogo fica sem placar.
            return None
        else:
            found[target].append(entry)
    if not (found['start'] and found['player1'] and found['player2']):
        return None
    found['names'] = names
    found['chars'] = {t for t in ('char1', 'char2') if found[t]}
    return found


# detector_of: o detector do jogo (ou do pai, pela linha "clone") para a
# fonte. No RetroArch so com o core FBNeo, o emulador para o qual os
# detectores foram escritos.
def detector_of(source, game, tables, core=''):
    if source == 'retroarch' and not core.startswith('fbneo'):
        return None
    return read_detector(game, source) or read_detector(tables[1].get(game, ''), source)


# fields_of: os campos que o jogo tem (os da tabela e as vitorias e os
# personagens do detector, se a tabela nao conta as vitorias) e os nomes dos
# personagens. (None, {}) se nao ha placar para o jogo.
def fields_of(source, game, tables=None, core=''):
    if source == 'model2':
        return ({'rounds1': None, 'rounds2': None} if model2_has(game) else None), {}
    tables = tables or read_tables()
    fields = dict(lookup(source, game, tables) or {})
    names = {}
    if not any(f[:-1] in ('wins', 'rounds') for f in fields):
        detector = detector_of(source, game, tables, core)
        if detector:
            names = detector['names']
            for field in ['wins1', 'wins2'] + sorted(detector['chars']):
                fields[field] = None
    return (fields or None), names


# model2_has: o games.xml do SM2-Emu da ao jogo as saidas P1_Wins e P2_Wins.
# O .zip de um jogo pode abrir como uma revisao dele (doa.zip como "doaa"):
# vale o jogo com esse nome ou um clone dele.
def model2_has(game):
    try:
        with open(SM2_GAMES, encoding='utf-8', errors='replace') as f:
            text = f.read()
    except OSError:
        return False
    for block in re.findall(r'<game\b.*?</game>', text, re.S):
        head = block[:block.index('>')]
        named = re.search(r'\bname="([^"]*)"', head)
        parent = re.search(r'\bparent="([^"]*)"', head)
        if game in (named and named.group(1), parent and parent.group(1)) and \
                all(re.search(r'<value\b[^>]*\bname="%s"' % name, block) for name in ('P1_Wins', 'P2_Wins')):
            return True
    return False


# fetch: os .inf do repositorio do Fightcade, no commit fixado, para a pasta
# que o plugin le. So arquivos <jogo>.inf pequenos entram.
def fetch():
    try:
        with urllib.request.urlopen(DETECTORS_URL, timeout=120) as response:
            data = response.read(64 * 1024 * 1024)
    except (OSError, ValueError) as error:
        sys.stderr.write('fliperos-versus: the download of the detectors failed: %s\n' % error)
        return 1
    found = {}
    try:
        with tarfile.open(fileobj=io.BytesIO(data), mode='r:gz') as tar:
            for member in tar:
                name = member.name.rsplit('/', 1)[-1]
                if member.isfile() and re.fullmatch(r'[A-Za-z0-9_]+\.inf', name) and member.size <= 65536:
                    found[name] = tar.extractfile(member).read()
    except (tarfile.TarError, OSError, EOFError) as error:
        sys.stderr.write('fliperos-versus: the downloaded file is not the detectors package: %s\n' % error)
        return 1
    if len(found) < 10:
        sys.stderr.write('fliperos-versus: the downloaded package has no detectors\n')
        return 1
    try:
        os.makedirs(DETECTORS, exist_ok=True)
        for old in os.listdir(DETECTORS):
            if old.endswith('.inf') and old not in found:
                os.unlink(os.path.join(DETECTORS, old))
        for name, content in found.items():
            with open(os.path.join(DETECTORS, name), 'wb') as f:
                f.write(content)
    except OSError as error:
        sys.stderr.write('fliperos-versus: could not write %s: %s\n' % (DETECTORS, error))
        return 1
    print('%d Fightcade detectors in %s' % (len(found), DETECTORS))
    return 0


# decode: os bytes lidos (na ordem da memoria) como numero; None se nao e
# um BCD valido (a memoria ainda nao tem o placar).
def decode(data, fmt, mult=1):
    if fmt.endswith('le'):
        data = data[::-1]
    value = 0
    if fmt.startswith('bcd'):
        for b in data:
            if b >> 4 > 9 or b & 15 > 9:
                return None
            value = value * 100 + (b >> 4) * 10 + (b & 15)
    else:
        value = int.from_bytes(data, 'big')
    return value * mult


# -- Vitorias da sessao ----------------------------------------------

class Tally:
    """Os valores do jogo e as vitorias da sessao de cada lado."""

    def __init__(self, fields):
        self.own_wins = 'wins1' in fields and 'wins2' in fields
        self.rounds = 'rounds1' in fields and 'rounds2' in fields
        self.values = {}
        self.wins = [0, 0]
        self.best = [0, 0]

    def update(self, field, value):
        old = self.values.get(field)
        self.values[field] = value
        if old == value:
            return False
        if self.own_wins:
            self.wins = [self.values.get('wins1', 0), self.values.get('wins2', 0)]
        elif self.rounds and field in ('rounds1', 'rounds2'):
            now = [self.values.get('rounds1', 0), self.values.get('rounds2', 0)]
            # Os rounds voltaram a zero: a partida acabou, e ganhou quem
            # tinha mais. (Um empate nao conta para ninguem.)
            if now == [0, 0] and self.best != [0, 0]:
                if self.best[0] != self.best[1]:
                    self.wins[0 if self.best[0] > self.best[1] else 1] += 1
                self.best = [0, 0]
            else:
                self.best = [max(self.best[0], now[0]), max(self.best[1], now[1])]
        return True

    # state: vitorias e pontos de cada lado ("-" = o jogo nao tem) e, se o
    # jogo diz os personagens, o nome de cada um ("" enquanto nao se sabe).
    def state(self, names=None):
        counted = self.own_wins or self.rounds
        wins = [str(w) for w in self.wins] if counted else ['-', '-']
        out = wins + [str(self.values[f]) if f in self.values else '-' for f in ('score1', 'score2')]
        if names and ('char1' in self.values or 'char2' in self.values):
            out += [names.get(self.values.get(f), '') for f in ('char1', 'char2')]
        return out


# -- Fontes ----------------------------------------------------------

def address(text):
    host, _, port = text.rpartition(':')
    return host or '127.0.0.1', int(port)


def alive(pid):
    if pid <= 1:
        return True
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return True


# mame_source: as linhas "fliperos_CAMPO = VALOR" que o plugin do MAME
# escreve no FEED, ate o "mame_stop" ou o jogo (PID) fechar. O arquivo
# recomeca a cada jogo: o de um jogo que ja fechou (tem o mame_stop, ou e
# de antes de este programa abrir) nao serve. O MAME demora a abrir (o X, o
# modo de video).
def mame_source(fields, pid):
    began = time.time()
    deadline = time.monotonic() + 120
    feed = None
    while feed is None and alive(pid) and time.monotonic() < deadline:
        try:
            # Sem PID (o "watch", com o jogo ja aberto) vale o arquivo que houver.
            if pid <= 1 or os.path.getmtime(FEED) >= began - 30:
                feed = open(FEED, encoding='ascii', errors='replace')
                text = feed.read()
                if not text.startswith('mame_start') or 'mame_stop' in text:
                    feed.close()
                    feed = None
                else:
                    feed.seek(0)
        except OSError:
            feed = None
        if feed is None:
            time.sleep(0.2)
    if feed is None:
        return
    buf = ''
    with feed:
        while alive(pid):
            data = feed.read()
            if not data:
                # Um reset da maquina recomeca o arquivo.
                try:
                    if os.path.getsize(FEED) < feed.tell():
                        feed.seek(0)
                        buf = ''
                        continue
                except OSError:
                    return
                yield None
                time.sleep(0.2)
                continue
            *lines, buf = (buf + data).split('\n')
            for line in lines:
                name, sep, value = line.partition('=')
                name, value = name.strip(), value.strip()
                if name == 'mame_stop':
                    return
                if sep and name.startswith('fliperos_') and name[9:] in fields:
                    try:
                        yield name[9:], int(value)
                    except ValueError:
                        pass
            yield None


class Detector:
    """O detector de um jogo, avaliado como o GameDetector do Fightcade
    (vid_overlay.cpp), com o tempo no lugar da contagem de quadros."""

    def __init__(self, detector):
        self.lists = {t: [dict(d, since=None, start=0, current=0) for d in detector[t]]
                      for t in ('start', 'player1', 'player2', 'char1', 'char2')}
        self.wins = [0, 0]
        self.waiting_start = True
        self.began = None

    # Detector::Update: "eq" e o valor igual ao do arquivo; "gts" e o valor
    # maior que o guardado quando a partida comecou.
    @staticmethod
    def update(d, value, start_detected, now):
        d['current'] = value
        if start_detected:
            d['start'] = value
        found = False
        if d['op'] == 'eq':
            found = value == d['value']
        elif d['op'] == 'gts':
            found = not start_detected and value > d['start']
        d['since'] = (d['since'] if d['since'] is not None else now) if found else None

    @staticmethod
    def detected(entries, now):
        return any(d['since'] is not None and now - d['since'] >= HOLD for d in entries)

    # step: read(d) da o valor de um detector (None se nao deu para ler);
    # devolve os campos como estao agora.
    def step(self, read, now):
        if self.began is None:
            self.began = now
        values = {}
        for target in ('start', 'player1', 'player2', 'char1', 'char2'):
            for d in self.lists[target]:
                values[id(d)] = read(d)
        if any(v is None for v in values.values()):
            return {}
        for d in self.lists['start']:
            self.update(d, values[id(d)], False, now)
        start_detected = self.detected(self.lists['start'], now)
        for target in ('player1', 'player2', 'char1', 'char2'):
            for d in self.lists[target]:
                self.update(d, values[id(d)], start_detected, now)
        if self.waiting_start:
            if start_detected:
                self.waiting_start = False
        elif now - self.began > START_WAIT:
            won = False
            for side, target in enumerate(('player1', 'player2')):
                if self.detected(self.lists[target], now):
                    self.wins[side] += 1
                    won = True
            if won:
                self.waiting_start = True
                self.began = now
        out = {'wins1': self.wins[0], 'wins2': self.wins[1]}
        for target in ('char1', 'char2'):
            if self.lists[target]:
                out[target] = self.lists[target][0]['current']
        return out


# retroarch_source: a memoria do jogo pelo Network Command Interface, ate o
# RetroArch (PID) fechar. Os campos da tabela por READ_CORE_MEMORY (o
# endereco do mapa de memoria do core); os de um detector por READ_CORE_RAM
# (a memoria principal do core FBNeo, no arranjo que o detector descreve: o
# valor de 16 ou 32 bits com o byte menos significativo primeiro). A
# resposta e "COMANDO endereco b0 b1..." ou "... -1" sem aquele endereco.
def retroarch_source(fields, pid, detector=None):
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.settimeout(0.5)
    target = address(RA_COMMAND)
    silent = time.monotonic()
    game = Detector(detector) if detector else None

    def ask(command, addr, size):
        nonlocal silent
        try:
            sock.sendto(b'%s %x %d\n' % (command, addr, size), target)
            words = sock.recv(4096).decode('ascii', 'replace').split()
        except OSError:
            return None
        silent = time.monotonic()
        if len(words) != 2 + size or words[0] != command.decode():
            return None
        try:
            return bytes(int(w, 16) for w in words[2:])
        except ValueError:
            return None

    def read_detector_value(d):
        size = 4 if d['bits'] == 32 else 2 if d['bits'] == 16 else 1
        data = ask(b'READ_CORE_RAM', d['ptr'] & ~(size - 1), size)
        return None if data is None else int.from_bytes(data, 'little')

    with sock:
        while alive(pid):
            for field, entry in fields.items():
                if entry is None:
                    continue
                addr, size, fmt, mult = entry
                data = ask(b'READ_CORE_MEMORY', addr, size)
                value = None if data is None else decode(data, fmt, mult)
                if value is not None:
                    yield field, value
            if game:
                for field, value in game.step(read_detector_value, time.monotonic()).items():
                    yield field, value
            yield None
            # Sem PID para vigiar: 30 s sem resposta e o jogo fechou.
            if pid <= 1 and time.monotonic() - silent > 30:
                return
            time.sleep(POLL if game else 0.25)


# model2_source: as linhas "P1_Wins = N" e "P2_Wins = N" das saidas do
# SM2-Emu (TCP, uma linha por mudanca, terminada em \r), como os rounds de
# cada lado, ate o "mame_stop", a conexao cair ou o jogo (PID) fechar. O
# emulador demora a abrir a porta (o X, o modo de video).
def model2_source(fields, pid):
    names = {'P1_Wins': 'rounds1', 'P2_Wins': 'rounds2'}
    deadline = time.monotonic() + 120
    sock = None
    while sock is None and alive(pid) and time.monotonic() < deadline:
        try:
            sock = socket.create_connection(address(SM2_OUTPUTS), timeout=2)
        except OSError:
            time.sleep(0.5)
    if sock is None:
        return
    buf = b''
    with sock:
        sock.settimeout(0.5)
        while alive(pid):
            try:
                data = sock.recv(4096)
            except socket.timeout:
                yield None
                continue
            except OSError:
                return
            if not data:
                return
            *lines, buf = (buf + data).replace(b'\n', b'\r').split(b'\r')
            for line in lines:
                name, sep, value = line.decode('ascii', 'replace').partition('=')
                name, value = name.strip(), value.strip()
                if name == 'mame_stop':
                    return
                if sep and names.get(name) in fields:
                    try:
                        yield names[name], int(value)
                    except ValueError:
                        pass
            yield None


def source_of(name, fields, pid, detector=None):
    if name == 'mame':
        return mame_source(fields, pid)
    if name == 'model2':
        return model2_source(fields, pid)
    return retroarch_source(fields, pid, detector)


# -- Comandos --------------------------------------------------------

def run(source, game, pid, core=''):
    tables = read_tables()
    fields, names = fields_of(source, game, tables, core)
    if not fields:
        return 0
    tally = Tally(fields)
    sent, last, dirty = None, 0.0, False
    detector = detector_of(source, game, tables, core) if fields.get('wins1', 0) is None else None
    for item in source_of(source, fields, pid, detector):
        if item is not None:
            dirty = tally.update(*item) or dirty
        now = time.monotonic()
        if dirty and now - last >= EVERY:
            state = tally.state(names)
            # Enquanto ninguem ganhou e nao ha pontos, o painel fica com a
            # arte do jogo: na demonstracao e na escolha dos personagens o
            # placar seria um "0 x 0" trocando de nomes.
            if state[:4] in (['0', '0', '-', '-'], ['-', '-', '-', '-']):
                dirty = False
                continue
            if state != sent:
                subprocess.call([PIXELCADE, 'versus'] + state, stdin=subprocess.DEVNULL,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                sent, last = state, now
            dirty = False
    return 0


def watch(source, game, core=''):
    tables = read_tables()
    fields, names = fields_of(source, game, tables, core)
    if not fields:
        sys.stderr.write('fliperos-versus: no score for %s (%s): no detector and no line in the table\n'
                         % (game, source))
        return 1
    tally = Tally(fields)
    print('watching %s (%s): %s' % (game, source, ', '.join(sorted(fields))), flush=True)
    detector = detector_of(source, game, tables, core) if fields.get('wins1', 0) is None else None
    for item in source_of(source, fields, 0, detector):
        if item is not None and tally.update(*item):
            wins = tally.state()[:2]
            print('%-8s = %-10d   session wins: %s x %s' % (item[0], item[1], wins[0], wins[1]), flush=True)
    return 0


def main(argv):
    if len(argv) == 2 and argv[1] == 'fetch':
        return fetch()
    if len(argv) >= 4 and argv[2] in ('mame', 'retroarch', 'model2'):
        # O core do RetroArch: o nome do arquivo, com ou sem pasta e "_libretro.so".
        rest = [a for a in argv[4:] if not a.isdigit()]
        core = os.path.basename(rest[0]).replace('_libretro.so', '') if rest else ''
        if argv[1] == 'has':
            return 0 if fields_of(argv[2], argv[3], None, core)[0] else 1
        if argv[1] == 'run':
            return run(argv[2], argv[3], int(argv[4]) if len(argv) > 4 and argv[4].isdigit() else 0, core)
        if argv[1] == 'watch':
            try:
                return watch(argv[2], argv[3], core)
            except KeyboardInterrupt:
                return 0
    sys.stderr.write('usage: fliperos-versus has mame|retroarch|model2 GAME [CORE]\n'
                     '       fliperos-versus run mame|retroarch|model2 GAME [PID] [CORE]\n'
                     '       fliperos-versus watch mame|retroarch|model2 GAME [CORE]\n'
                     '       fliperos-versus fetch\n')
    return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv))
