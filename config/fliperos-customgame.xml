<?xml version="1.0" encoding="UTF-8"?>
<!--
  O tipo de arquivo dos pacotes de jogo custom do FliperOS (JOGO.fliperos-customgame.zip).
  Sem ele o desktop os ve como um zip qualquer e abre o gerenciador de arquivos
  compactados; com ele, o duplo clique abre config/applications/fliperos-customgame-install.desktop,
  que instala o jogo (a opcao install-package do fliperos-setup). Como um zip, o "Abrir com"
  continua mostrando os programas de zip. O glob maior vence o *.zip, como o
  .tar.gz vence o .gz. fliperos-rootfs.sh o poe em /usr/share/mime/packages e
  roda o update-mime-database.

  O segundo tipo e o de uma parte de um pacote dividido (JOGO.fliperos-customgame.zip.001,
  .002... um pacote maior que o arquivo do plano gratuito do Telegram anda assim): o duplo
  clique em QUALQUER parte abre o mesmo instalador, que junta as partes da pasta e instala.
  Nao e um zip (so um pedaco dele), e leva o icone do pacote.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-fliperos-customgame">
    <comment>FliperOS custom game package</comment>
    <comment xml:lang="pt-BR">Pacote de jogo custom do FliperOS</comment>
    <sub-class-of type="application/zip"/>
    <generic-icon name="package-x-generic"/>
    <glob pattern="*.fliperos-customgame.zip" weight="60"/>
  </mime-type>
  <mime-type type="application/x-fliperos-customgame-part">
    <comment>FliperOS custom game package, one part of a split file</comment>
    <comment xml:lang="pt-BR">Parte de um pacote de jogo custom do FliperOS (arquivo dividido)</comment>
    <sub-class-of type="application/octet-stream"/>
    <icon name="application-x-fliperos-customgame"/>
    <generic-icon name="package-x-generic"/>
    <glob pattern="*.fliperos-customgame.zip.[0-9][0-9][0-9]" weight="60"/>
  </mime-type>
  <!--
    O terceiro e o pacote de ROM (TITULO.fliperos-EMULADOR.zip, config/fliperos-rompack): o
    mesmo instalador o reconhece pelo nome e poe cada arquivo de volta no lugar. O glob dele e
    mais curto que o do jogo custom, entao um .fliperos-customgame.zip continua do primeiro tipo.
  -->
  <mime-type type="application/x-fliperos-rompack">
    <comment>FliperOS ROM package</comment>
    <comment xml:lang="pt-BR">Pacote de ROMs do FliperOS</comment>
    <sub-class-of type="application/zip"/>
    <icon name="application-x-fliperos-customgame"/>
    <generic-icon name="package-x-generic"/>
    <glob pattern="*.fliperos-*.zip" weight="55"/>
  </mime-type>
</mime-info>
