#!/usr/bin/env python3
# ZeDMD (DMD de LED open source, github.com/PPUC/ZeDMD): mostra no painel o
# jogo aberto ou selecionado, ou o sistema.
#
# Quem fala com o painel pela USB e o dmdserver (libdmdutil, do Visual
# Pinball), baixado pelo Setup > Games > Extras > ZeDMD e aberto pelo servico
# fliperos-zedmd.service. Daqui sai uma imagem RGB24 de 128x32 por TCP
# (localhost:6789); o dmdserver a escala para um painel 256x64.
#
# A arte do Pixelcade so pode ser usada no hardware dele. A imagem vem de
# ~/media, na ordem: dmd/ (arte feita para 128x32, PNG ou GIF animado),
# marquee/ e logo/ (as do Setup > Games > Scraper), com as pastas de ~/roms. Sem
# imagem, o nome do jogo em texto (rolando se nao cabe).
#
#   fliperos-dmd show game|select|system SISTEMA ROM [TITULO] [ABERTURA]
#   fliperos-dmd slide SISTEMA [ANTERIOR [PASSO]]   o logotipo do sistema entrando e piscando duas vezes
#   fliperos-dmd image ARQUIVO
#   fliperos-dmd text TEXTO
#   fliperos-dmd attract [art]        o protetor de tela: a animacao do logo (com "art",
#                                     as artes de ~/media, uma depois da outra)
#   fliperos-dmd startup              o logo do FliperOS (animacao vetorial 3D), quando o dmdserver abre
#   fliperos-dmd versus ESQ VIT_ESQ VIT_DIR DIR PONTOS_ESQ PONTOS_DIR
#                                     o placar de uma partida versus: os nomes dos
#                                     lados, as vitorias e os pontos ("-" = sem)
#   fliperos-dmd title ROM            o nome do jogo nas listas dos frontends
#   fliperos-dmd art SISTEMA [ROM]    o arquivo da imagem do jogo (ou do sistema)
#
# ABERTURA e um texto que rola uma vez antes da imagem (os recordes, "Now
# Playing ...", uma conquista). Um GIF, um texto rolando ou o attract fica
# aberto ate o proximo evento, que o encerra (o pid fica em
# $XDG_RUNTIME_DIR/fliperos-dmd.pid).
import glob
import os
import random
import re
import signal
import socket
import struct
import sys
import time

# Sem o Pillow (Setup > Games > Extras > ZeDMD) nada e desenhado; o "title" nao
# precisa dele.
try:
    from PIL import Image, ImageDraw, ImageFont, ImageSequence
except ImportError:
    Image = None

W, H = 128, 32
SERVER = os.environ.get('DMD_SERVER', '127.0.0.1:6789')
MEDIA = os.environ.get('MEDIA_DIR', '/home/fliperos/media')
ATTRACT = os.environ.get('ATTRACT_DIR', '/home/fliperos/.attract')
ESDE = os.environ.get('ESDE_DIR', '/home/fliperos/ES-DE')
FONT = os.environ.get('DMD_FONT', '/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf')
PIDFILE = os.path.join(os.environ.get('XDG_RUNTIME_DIR') or '/tmp', 'fliperos-dmd.pid')
# A abertura: a animacao vetorial 3D do logo (config/zedmd-fliperos.gif, feita por
# tools/zedmd-vector-anim.py). Sem ela, o logo parado, que o Pixelcade tambem usa.
STARTUP = os.environ.get('DMD_STARTUP', '/usr/local/share/fliperos/pixelcade/zedmd-fliperos.gif')
LOGO = '/usr/local/share/fliperos/pixelcade/fliperos.png'
ATTRACT_SECONDS = float(os.environ.get('DMD_ATTRACT_SECONDS', '8'))
EXTS = ('gif', 'png', 'webp', 'jpg', 'jpeg')
COLOR = {'game': (255, 184, 108), 'select': (255, 255, 255), 'system': (139, 233, 253)}
# Sistema dos eventos (os nomes do Pixelcade) -> pastas de ~/media, alem da
# de mesmo nome: as de ~/roms (mame, model2...) e as de plataforma de antes
# (arcade...). A de um core do RetroArch (retroarch/<core>) e achada pelo
# nome do jogo, em qualquer pasta do tipo.
PLATFORMS = {
    'mame': ['model2', 'model3', 'naomi', 'naomi2', 'atomiswave', 'arcade', 'fbneo'],
    'genesis': ['megadrive'],
    'nintendo_gamecube': ['gamecube'],
    'sega_saturn': ['saturn'],
    'segacd': ['megacd'],
    'pcengine': ['pcengine', 'tg16'],
}


def platforms(system):
    return [system] + PLATFORMS.get(system, [])


def find_art(system, rom):
    for kind in ('dmd', 'marquee', 'logo'):
        for plat in platforms(system):
            for ext in EXTS:
                path = os.path.join(MEDIA, kind, plat, '%s.%s' % (rom, ext))
                if os.path.isfile(path):
                    return path
        for ext in EXTS:
            hits = sorted(glob.glob(os.path.join(MEDIA, kind, '**', '%s.%s' % (glob.escape(rom), ext)),
                                    recursive=True))
            if hits:
                return hits[0]
    return None


def find_system_art(system):
    for plat in platforms(system):
        for ext in EXTS:
            path = os.path.join(MEDIA, 'dmd', '%s.%s' % (plat, ext))
            if os.path.isfile(path):
                return path
    return None


# title_of ROM: o nome do jogo nas listas do Attract-Mode e do ES-DE.
def title_of(rom):
    prefix = rom + ';'
    for path in glob.glob(os.path.join(ATTRACT, 'romlists', '*.txt')):
        try:
            with open(path, encoding='utf-8', errors='replace') as f:
                for line in f:
                    if line.startswith(prefix):
                        title = line.split(';')[1].strip()
                        if title:
                            return title
        except OSError:
            pass
    pattern = re.compile(r'<path>\./%s\.[^<]*</path>\s*<name>([^<]+)</name>' % re.escape(rom))
    for path in glob.glob(os.path.join(ESDE, 'gamelists', '*', 'gamelist.xml')):
        try:
            with open(path, encoding='utf-8', errors='replace') as f:
                m = pattern.search(f.read())
        except OSError:
            continue
        if m:
            return m.group(1).strip()
    return rom


def clean(title):
    title = re.sub(r'\s*[\(\[].*$', '', title).strip() or title
    return title.replace('&amp;', '&')


# -- Imagens ------------------------------------------------------

def fit(img):
    img = img.convert('RGBA')
    w, h = img.size
    scale = min(W / w, H / h)
    if scale != 1:
        size = (max(1, round(w * scale)), max(1, round(h * scale)))
        img = img.resize(size, Image.NEAREST if scale > 1 else Image.LANCZOS)
    frame = Image.new('RGB', (W, H))
    frame.paste(img, ((W - img.width) // 2, (H - img.height) // 2), img)
    return frame.tobytes()


def image_frames(path):
    img = Image.open(path)
    frames = []
    for f in ImageSequence.Iterator(img):
        frames.append((fit(f), max(20, f.info.get('duration', 100) or 100)))
    return frames


def font(size):
    try:
        return ImageFont.truetype(FONT, size)
    except OSError:
        return ImageFont.load_default()


def canvas():
    img = Image.new('RGB', (W, H))
    draw = ImageDraw.Draw(img)
    draw.fontmode = '1'
    return img, draw


def draw_line(draw, text, f, y, color, x=None):
    left, top, right, _ = draw.textbbox((0, 0), text, font=f)
    if x is None:
        x = (W - (right - left)) // 2 - left
    draw.text((x, y - top), text, font=f, fill=color)


def text_frames(text, color):
    text = ' '.join(text.split())
    probe = ImageDraw.Draw(Image.new('RGB', (1, 1)))

    def size_of(s, f):
        left, top, right, bottom = probe.textbbox((0, 0), s, font=f)
        return right - left, bottom - top

    for size in range(22, 11, -1):
        f = font(size)
        w, h = size_of(text, f)
        if w <= W - 4 and h <= H:
            img, draw = canvas()
            draw_line(draw, text, f, (H - h) // 2, color)
            return [(img.tobytes(), 1000)]
    words = text.split()
    if len(words) > 1:
        for size in range(14, 8, -1):
            f = font(size)
            best = None
            for i in range(1, len(words)):
                a, b = ' '.join(words[:i]), ' '.join(words[i:])
                wa, ha = size_of(a, f)
                wb, hb = size_of(b, f)
                if wa <= W - 2 and wb <= W - 2 and ha + hb + 2 <= H:
                    widest = max(wa, wb)
                    if best is None or widest < best[0]:
                        best = (widest, a, b, ha, hb)
            if best:
                _, a, b, ha, hb = best
                img, draw = canvas()
                top = (H - ha - hb - 2) // 2
                draw_line(draw, a, f, top, color)
                draw_line(draw, b, f, top + ha + 2, color)
                return [(img.tobytes(), 1000)]
    return scroll_frames(text, color)


def scroll_frames(text, color):
    text = ' '.join(text.split())
    f = font(18)
    left, top, right, bottom = canvas()[1].textbbox((0, 0), text, font=f)
    w, h = right - left, bottom - top
    frames = []
    for x in range(W, -w - 1, -2):
        img, draw = canvas()
        draw_line(draw, text, f, (H - h) // 2, color, x=x)
        frames.append((img.tobytes(), 30))
    return frames


# -- dmdserver ------------------------------------------------------

# Cabecalho DMDStream versao 1, com os campos na ordem de rede (big-endian),
# como o DMD::StreamHeader do libdmdutil (empacotado em 1 byte). Modo 2:
# RGB24. "buffered" deixa o quadro no painel depois que a conexao fecha.
def header(length, disconnect_others):
    return struct.pack('!10sBiHHBBI', b'DMDStream', 1, 2, W, H, 1, int(disconnect_others), length)


def read_pid():
    try:
        with open(PIDFILE) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return 0


# claim: o ultimo evento vence. O pid dele vai para o PIDFILE antes de
# desenhar, e o anterior (um GIF ou texto rolando) e encerrado; um que ainda
# estava desenhando ve o pid trocado e desiste (mine).
def claim():
    old = read_pid()
    tmp = '%s.%d' % (PIDFILE, os.getpid())
    with open(tmp, 'w') as f:
        f.write('%d\n' % os.getpid())
    os.replace(tmp, PIDFILE)
    if old and old != os.getpid():
        try:
            with open('/proc/%d/cmdline' % old, 'rb') as f:
                if b'fliperos-dmd' in f.read():
                    os.kill(old, signal.SIGTERM)
        except OSError:
            pass


def mine():
    return read_pid() == os.getpid()


def release():
    if mine():
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass


def connect():
    host, _, port = SERVER.rpartition(':')
    try:
        return socket.create_connection((host or '127.0.0.1', int(port)), timeout=3)
    except (OSError, ValueError):
        return None


# nap SEGUNDOS: dorme enquanto este evento for o ultimo; False se outro chegou.
def nap(seconds):
    end = time.monotonic() + seconds
    while mine():
        left = end - time.monotonic()
        if left <= 0:
            return True
        time.sleep(min(left, 0.25))
    return False


# play: a abertura (intro) uma vez e depois os quadros; um so fica no painel,
# varios (GIF, texto rolando) repetem ate o proximo evento. retry: segundos
# esperando o dmdserver abrir.
def play(frames, intro=(), retry=0, once=False):
    if not (frames or intro) or not mine():
        return
    sock = connect()
    while sock is None and retry > 0 and nap(1):
        retry -= 1
        sock = connect()
    if sock is None:
        return
    with sock:
        first = True
        for data, ms in intro:
            sock.sendall(header(len(data), first) + data)
            first = False
            if not nap(ms / 1000):
                return
        if len(frames) == 1:
            sock.sendall(header(len(frames[0][0]), first) + frames[0][0])
            return
        if once:
            # Uma vez so, e o painel fica no ultimo quadro (a animacao da
            # troca de sistema).
            for i, (data, ms) in enumerate(frames):
                sock.sendall(header(len(data), first) + data)
                first = False
                if i < len(frames) - 1 and not nap(ms / 1000):
                    return
            return
        while frames and mine():
            for data, ms in frames:
                sock.sendall(header(len(data), first) + data)
                first = False
                if not nap(ms / 1000):
                    return


# attract: o protetor de tela (o frontend ocioso): a animacao do logo, a mesma
# da abertura, ate o proximo evento. "attract art": as artes de ~/media (dmd e
# marquee) em ordem aleatoria, cada uma por ATTRACT_SECONDS; sem nenhuma, o logo.
def attract(art=False):
    if not art:
        return play(startup_frames())
    files = []
    for kind in ('dmd', 'marquee'):
        for ext in EXTS:
            files += glob.glob(os.path.join(MEDIA, kind, '**', '*.' + ext), recursive=True)
    if not files:
        return play(startup_frames())
    sock = connect()
    if sock is None:
        return
    with sock:
        first = True
        while mine():
            try:
                frames = image_frames(random.choice(files))
            except (OSError, ValueError, SyntaxError):
                if not nap(0.25):
                    return
                continue
            end = time.monotonic() + ATTRACT_SECONDS
            while time.monotonic() < end:
                for data, ms in frames:
                    sock.sendall(header(len(data), first) + data)
                    first = False
                    left = max(0, end - time.monotonic())
                    if not nap(min(ms / 1000, left) if len(frames) > 1 else left):
                        return


# versus_frame: o placar de uma partida versus (config/fliperos-versus). Os
# nomes dos lados em cima, as vitorias grandes no meio e os pontos embaixo;
# num jogo sem vitorias na tabela, so os pontos, maiores.
def versus_frame(left, wins_left, wins_right, right, score_left, score_right):
    img, draw = canvas()
    small = font(9)

    def width(text, f):
        box = draw.textbbox((0, 0), text, font=f)
        return box[2] - box[0]

    def group(text):
        return '{:,}'.format(int(text)) if text.isdigit() else ''

    def corner(text, y, color, on_right):
        # Cada lado tem a sua metade: um nome comprido perde letras do fim.
        while text and width(text, small) > W // 2 - 3:
            text = text[:-1].rstrip()
        if text:
            draw_line(draw, text, small, y, color, x=W - width(text, small) - 1 if on_right else 1)

    corner(left, 0, COLOR['system'], False)
    corner(right, 0, COLOR['game'], True)
    if wins_left.isdigit() and wins_right.isdigit():
        # As vitorias embaixo dos nomes: maiores quando nao ha pontos, que
        # ficam com a ultima linha.
        points = group(score_left) or group(score_right)
        big = font(15 if points else 20)
        x_mark = font(9 if points else 11)
        top = 10 if points else 12
        gap = 6
        height = draw.textbbox((0, 0), '0', font=big)
        height = height[3] - height[1]
        total = width(wins_left, big) + width('x', x_mark) + width(wins_right, big) + 2 * gap
        x = (W - total) // 2
        draw_line(draw, wins_left, big, top, COLOR['select'], x=x)
        x += width(wins_left, big) + gap
        draw_line(draw, 'x', x_mark, top + height // 2 - 3, (98, 114, 164), x=x)
        x += width('x', x_mark) + gap
        draw_line(draw, wins_right, big, top, COLOR['select'], x=x)
        corner(group(score_left), H - 8, COLOR['system'], False)
        corner(group(score_right), H - 8, COLOR['game'], True)
    else:
        # O maior tamanho em que os dois numeros cabem lado a lado.
        for size in range(13, 7, -1):
            mid = font(size)
            if width(group(score_left), mid) + width(group(score_right), mid) + 6 <= W:
                break
        for text, color, on_right in ((group(score_left), COLOR['system'], False),
                                      (group(score_right), COLOR['game'], True)):
            if text:
                draw_line(draw, text, mid, 15, color, x=W - width(text, mid) - 1 if on_right else 1)
    return [(img.tobytes(), 1000)]


def startup_frames():
    for path in (STARTUP, LOGO):
        if os.path.isfile(path):
            try:
                return image_frames(path)
            except (OSError, ValueError, SyntaxError):
                pass
    return text_frames('FliperOS', COLOR['system'])


# slide_frames: a troca de sistema na lista do frontend. O logotipo (o do
# Arcadeflow, desenhado por config/fliperos-syslogo) entra deslizando e pisca
# duas vezes; step e o sentido em que a lista andou (-1 ou 1) e old o sistema
# de antes, que sai. Sem o logotipo (o tema nao esta instalado, ou o sistema
# nao esta nele), o nome em texto. Os quadros vao direto ao dmdserver: nao ha
# GIF nem arquivo.
def slide_frames(name, old, step):
    path = os.environ.get('SYSLOGO', os.path.join(os.path.dirname(os.path.abspath(__file__)), 'fliperos-syslogo'))
    try:
        from importlib.machinery import SourceFileLoader
        from importlib.util import module_from_spec, spec_from_loader
        spec = spec_from_loader('fliperos_syslogo', SourceFileLoader('fliperos_syslogo', path))
        syslogo = module_from_spec(spec)
        spec.loader.exec_module(syslogo)
        anim = syslogo.frames(name, old, step, (W, H), COLOR['system'])
    except (ImportError, OSError, SyntaxError, AttributeError):
        anim = []
    if not anim:
        return text_frames(name.upper(), COLOR['system'])
    return [(fit(img), ms) for img, ms in anim]


def show(kind, system, rom, title):
    color = COLOR.get(kind, COLOR['game'])
    if kind == 'system':
        art = find_system_art(system)
        if art:
            return image_frames(art)
        return text_frames(title or system.replace('_', ' ').upper(), color)
    art = find_art(system, rom)
    if art:
        return image_frames(art)
    return text_frames(clean(title or title_of(rom)), color)


def main(argv):
    if len(argv) == 3 and argv[1] == 'title':
        print(clean(title_of(argv[2])))
        return 0
    # art SISTEMA [ROM]: a imagem que o painel mostraria (a do jogo ou, sem
    # ROM, a do sistema); o marquee do OBS (config/fliperos-web) a usa.
    if len(argv) in (3, 4) and argv[1] == 'art':
        path = find_art(argv[2], argv[3]) if len(argv) == 4 and argv[3] else None
        path = path or find_system_art(argv[2])
        if path:
            print(path)
        return 0 if path else 1
    if Image is None:
        return 0
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    claim()
    try:
        return run(argv)
    finally:
        release()


def run(argv):
    intro, retry, once = (), 0, False
    try:
        if len(argv) >= 4 and argv[1] == 'show':
            frames = show(argv[2], argv[3], argv[4] if len(argv) > 4 else '', argv[5] if len(argv) > 5 else '')
            if len(argv) > 6 and argv[6]:
                intro = scroll_frames(argv[6], COLOR['select'])
        elif len(argv) in (3, 4, 5) and argv[1] == 'slide':
            frames = slide_frames(argv[2], argv[3] if len(argv) > 3 else '', -1 if len(argv) > 4 and argv[4] == '-1' else 1)
            once = len(frames) > 1
        elif len(argv) == 3 and argv[1] == 'image':
            frames = image_frames(argv[2])
        elif len(argv) == 3 and argv[1] == 'text':
            frames = text_frames(argv[2], COLOR['game'])
        elif len(argv) == 8 and argv[1] == 'versus':
            frames = versus_frame(*argv[2:8])
        elif argv[1:2] == ['attract'] and argv[2:] in ([], ['art']):
            attract(art=len(argv) == 3)
            return 0
        elif len(argv) == 2 and argv[1] == 'startup':
            # O dmdserver ainda esta abrindo a porta do painel.
            frames, retry = startup_frames(), 20
        else:
            sys.stderr.write('usage: fliperos-dmd show game|select|system SYSTEM ROM [TITLE] [INTRO]\n'
                             '       fliperos-dmd slide SYSTEM [PREVIOUS [STEP]]\n'
                             '       fliperos-dmd image FILE\n'
                             '       fliperos-dmd text TEXT\n'
                             '       fliperos-dmd attract [art] | startup\n'
                             '       fliperos-dmd versus LEFT WINS_LEFT WINS_RIGHT RIGHT SCORE_LEFT SCORE_RIGHT\n'
                             '       fliperos-dmd title ROM\n'
                             '       fliperos-dmd art SYSTEM [ROM]\n')
            return 1
        play(frames, intro, retry, once)
    except OSError:
        pass
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
