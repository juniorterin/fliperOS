#!/usr/bin/env python3
# ZeDMD (DMD de LED open source, github.com/PPUC/ZeDMD): mostra no painel o
# jogo aberto ou selecionado, ou o sistema.
#
# Quem fala com o painel pela USB e o dmdserver (libdmdutil, do Visual
# Pinball), baixado pelo Setup > Games > Extras > ZeDMD e aberto pelo servico
# fliperos-zedmd.service. Daqui sai uma imagem RGB24 de 128x32 por TCP
# (localhost:6789); o dmdserver a escala para um painel 256x64.
#
# A arte do Pixelcade so pode ser usada no hardware dele. A imagem vem de
# ~/media, na ordem: dmd/ (arte feita para 128x32, PNG ou GIF animado),
# marquee/ e logo/ (as do Setup > Games > Scraper), com as pastas de ~/roms. Sem
# imagem, o nome do jogo em texto (rolando se nao cabe).
#
#   fliperos-dmd show game|select|system SISTEMA ROM [TITULO] [ABERTURA]
#   fliperos-dmd slide SISTEMA [ANTERIOR [PASSO]]   a varredura que troca o logotipo do sistema de antes pelo novo
#   fliperos-dmd image ARQUIVO
#   fliperos-dmd text TEXTO
#   fliperos-dmd attract [art]        o protetor de tela: a animacao do logo (com "art",
#                                     as artes de ~/media, uma depois da outra)
#   fliperos-dmd startup              o logo do FliperOS (animacao vetorial 3D), quando o dmdserver abre
#   fliperos-dmd versus ESQ VIT_ESQ VIT_DIR DIR PONTOS_ESQ PONTOS_DIR [JOGADOR_ESQ [FT]]
#                                     o placar de uma partida versus: os nomes dos
#                                     lados, as vitorias e os pontos ("-" = sem);
#                                     JOGADOR_ESQ (1 ou 2) da a cor de cada lado, e
#                                     FT (o first to) aparece no meio, em cima
#   fliperos-dmd win NOME JOGADOR     quem fechou o first to: o nome na cor do
#                                     jogador, WIN! embaixo e fogos nos cantos
#   fliperos-dmd title ROM            o nome do jogo nas listas dos frontends
#   fliperos-dmd art SISTEMA [ROM]    o arquivo da imagem do jogo (ou do sistema)
#
# ABERTURA e um texto que rola uma vez antes da imagem (os recordes, "Now
# Playing ...", uma conquista). Um GIF, um texto rolando ou o attract fica
# aberto ate o proximo evento, que o encerra (o pid fica em
# $XDG_RUNTIME_DIR/fliperos-dmd.pid).
import glob
import math
import os
import random
import re
import signal
import socket
import struct
import sys
import time

# Sem o Pillow (Setup > Games > Extras > ZeDMD) nada e desenhado; o "title" nao
# precisa dele.
try:
    from PIL import Image, ImageDraw, ImageFont, ImageSequence
except ImportError:
    Image = None

W, H = 128, 32
SERVER = os.environ.get('DMD_SERVER', '127.0.0.1:6789')
MEDIA = os.environ.get('MEDIA_DIR', '/home/fliperos/media')
ATTRACT = os.environ.get('ATTRACT_DIR', '/home/fliperos/.attract')
ESDE = os.environ.get('ESDE_DIR', '/home/fliperos/ES-DE')
FONT = os.environ.get('DMD_FONT', '/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf')
PIDFILE = os.path.join(os.environ.get('XDG_RUNTIME_DIR') or '/tmp', 'fliperos-dmd.pid')
# A abertura: a animacao vetorial 3D do logo (config/zedmd-fliperos.gif, feita por
# tools/zedmd-vector-anim.py). Sem ela, o logo parado, que o Pixelcade tambem usa.
STARTUP = os.environ.get('DMD_STARTUP', '/usr/local/share/fliperos/pixelcade/zedmd-fliperos.gif')
LOGO = '/usr/local/share/fliperos/pixelcade/fliperos.png'
ATTRACT_SECONDS = float(os.environ.get('DMD_ATTRACT_SECONDS', '8'))
EXTS = ('gif', 'png', 'webp', 'jpg', 'jpeg')
COLOR = {'game': (255, 184, 108), 'select': (255, 255, 255), 'system': (139, 233, 253)}
# A cor de cada jogador no placar e na vitoria do FT: as do placar de sempre,
# o 1 ciano e o 2 laranja.
PLAYER = {'1': COLOR['system'], '2': COLOR['game']}
# Sistema dos eventos (os nomes do Pixelcade) -> pastas de ~/media, alem da
# de mesmo nome: as de ~/roms (mame, model2...) e as de plataforma de antes
# (arcade...). A de um core do RetroArch (retroarch/<core>) e achada pelo
# nome do jogo, em qualquer pasta do tipo.
PLATFORMS = {
    'mame': ['model2', 'model3', 'naomi', 'naomi2', 'atomiswave', 'arcade', 'fbneo'],
    'genesis': ['megadrive'],
    'nintendo_gamecube': ['gamecube'],
    'sega_saturn': ['saturn'],
    'segacd': ['megacd'],
    'pcengine': ['pcengine', 'tg16'],
}


def platforms(system):
    return [system] + PLATFORMS.get(system, [])


def find_art(system, rom):
    for kind in ('dmd', 'marquee', 'logo'):
        for plat in platforms(system):
            for ext in EXTS:
                path = os.path.join(MEDIA, kind, plat, '%s.%s' % (rom, ext))
                if os.path.isfile(path):
                    return path
        for ext in EXTS:
            hits = sorted(glob.glob(os.path.join(MEDIA, kind, '**', '%s.%s' % (glob.escape(rom), ext)),
                                    recursive=True))
            if hits:
                return hits[0]
    return None


def find_system_art(system):
    for plat in platforms(system):
        for ext in EXTS:
            path = os.path.join(MEDIA, 'dmd', '%s.%s' % (plat, ext))
            if os.path.isfile(path):
                return path
    return None


# title_of ROM: o nome do jogo nas listas do Attract-Mode e do ES-DE.
def title_of(rom):
    prefix = rom + ';'
    for path in glob.glob(os.path.join(ATTRACT, 'romlists', '*.txt')):
        try:
            with open(path, encoding='utf-8', errors='replace') as f:
                for line in f:
                    if line.startswith(prefix):
                        title = line.split(';')[1].strip()
                        if title:
                            return title
        except OSError:
            pass
    pattern = re.compile(r'<path>\./%s\.[^<]*</path>\s*<name>([^<]+)</name>' % re.escape(rom))
    for path in glob.glob(os.path.join(ESDE, 'gamelists', '*', 'gamelist.xml')):
        try:
            with open(path, encoding='utf-8', errors='replace') as f:
                m = pattern.search(f.read())
        except OSError:
            continue
        if m:
            return m.group(1).strip()
    return rom


def clean(title):
    title = re.sub(r'\s*[\(\[].*$', '', title).strip() or title
    return title.replace('&amp;', '&')


# -- Imagens ------------------------------------------------------

def fit(img):
    img = img.convert('RGBA')
    w, h = img.size
    scale = min(W / w, H / h)
    if scale != 1:
        size = (max(1, round(w * scale)), max(1, round(h * scale)))
        img = img.resize(size, Image.NEAREST if scale > 1 else Image.LANCZOS)
    frame = Image.new('RGB', (W, H))
    frame.paste(img, ((W - img.width) // 2, (H - img.height) // 2), img)
    return frame.tobytes()


def image_frames(path):
    img = Image.open(path)
    frames = []
    for f in ImageSequence.Iterator(img):
        frames.append((fit(f), max(20, f.info.get('duration', 100) or 100)))
    return frames


def font(size):
    try:
        return ImageFont.truetype(FONT, size)
    except OSError:
        return ImageFont.load_default()


def canvas():
    img = Image.new('RGB', (W, H))
    draw = ImageDraw.Draw(img)
    draw.fontmode = '1'
    return img, draw


def draw_line(draw, text, f, y, color, x=None):
    left, top, right, _ = draw.textbbox((0, 0), text, font=f)
    if x is None:
        x = (W - (right - left)) // 2 - left
    draw.text((x, y - top), text, font=f, fill=color)


def text_frames(text, color):
    text = ' '.join(text.split())
    probe = ImageDraw.Draw(Image.new('RGB', (1, 1)))

    def size_of(s, f):
        left, top, right, bottom = probe.textbbox((0, 0), s, font=f)
        return right - left, bottom - top

    for size in range(22, 11, -1):
        f = font(size)
        w, h = size_of(text, f)
        if w <= W - 4 and h <= H:
            img, draw = canvas()
            draw_line(draw, text, f, (H - h) // 2, color)
            return [(img.tobytes(), 1000)]
    # Nao cabe numa linha: o nome vai em paginas de letra grande, uma linha
    # cada, trocadas pela varredura, sem parar (antes rolava, e o link do
    # ZeDMD nao acompanhava: travava).
    return page_frames(text, color, loop=True)


# -- Texto em paginas --------------------------------------------------
#
# O link do ZeDMD (ESP32 + CH340) leva ~12 ms por quadro mais ~1 ms a cada 8
# pixels que mudam (os mesmos numeros do config/fliperos-syslogo). Um texto
# rolando muda ~600 pixels por quadro: pedia 30 ms e levava ~90, o painel ia
# ficando para tras e pulava quadros (as travadas do "Now Playing"). Em vez de
# rolar, o texto vai em paginas paradas, e a troca e a varredura: uma linha
# acesa passa e deixa a pagina nova atras dela, cada pixel mudando uma vez.
LINK_FRAME_MS = 12
LINK_PIXELS_PER_MS = 8
MIN_FRAME_MS = 30
SWEEP_STEPS = 8
PAGE_MS = 1500             # cada pagina parada
PAGE_SIZES = range(18, 12, -1)


def link_ms(pixels):
    """O tempo que o painel leva para receber um quadro em que `pixels` mudam."""
    return max(MIN_FRAME_MS, round(LINK_FRAME_MS + pixels / LINK_PIXELS_PER_MS))


def changed_pixels(a, b):
    return sum(1 for i in range(0, len(a), 3) if a[i:i + 3] != b[i:i + 3])


def text_pages(text):
    """As paginas de um texto: os recordes uma a uma ("#1 ...", "#2 ..."), o
    "Now Playing" na dele, e o resto quebrado em linhas que cabem na maior
    letra possivel (palavra por palavra). [(linha, tamanho da letra)]."""
    text = ' '.join(text.split())
    probe = ImageDraw.Draw(Image.new('RGB', (1, 1)))
    width = lambda s, f: probe.textbbox((0, 0), s, font=f)[2] - probe.textbbox((0, 0), s, font=f)[0]
    parts = re.split(r' (?=#\d)', text)
    if parts and re.match(r'(?i)now playing ', parts[0]):
        parts[0:1] = [parts[0][:11], parts[0][12:]]
    pages = []
    for part in filter(None, parts):
        for size in PAGE_SIZES:
            if width(part, font(size)) <= W - 4:
                pages.append((part, size))
                break
        else:
            # Quebra em linhas na letra do meio; uma palavra que sozinha nao
            # cabe vai numa pagina dela (que rola devagar, page_frames).
            f, size, line = font(PAGE_SIZES[2]), PAGE_SIZES[2], ''
            for word in part.split(' '):
                trial = (line + ' ' + word).strip()
                if line and width(trial, f) > W - 4:
                    pages.append((line, size))
                    line = word
                else:
                    line = trial
            if line:
                pages.append((line, size))
    return pages


def page_image(line, size, color):
    img, draw = canvas()
    f = font(size)
    box = draw.textbbox((0, 0), line, font=f)
    if box[2] - box[0] > W - 4:
        return None
    draw_line(draw, line, f, (H - (box[3] - box[1])) // 2, color)
    return img.tobytes()


def sweep(old, new, color):
    """A troca de old por new: uma frente com uma linha acesa vai da direita
    para a esquerda e deixa new atras dela; cada quadro dura o que o link leva."""
    out, shown = [], old
    line = bytes(color) * 1
    for i in range(1, SWEEP_STEPS + 1):
        edge = W - round(W * i / SWEEP_STEPS)
        frame = bytearray(old)
        for y in range(H):
            row = y * W * 3
            frame[row + edge * 3:row + W * 3] = new[row + edge * 3:row + W * 3]
            if i < SWEEP_STEPS:
                frame[row + edge * 3:row + edge * 3 + 3] = line
        frame = bytes(frame)
        out.append((frame, link_ms(changed_pixels(shown, frame))))
        shown = frame
    return out


def slow_scroll(line, size, color):
    """Uma palavra que nao cabe nem na letra menor: rola 2 pontos por quadro,
    cada quadro com o tempo que o link leva para recebe-lo (devagar, sem
    travar)."""
    f = font(size)
    box = canvas()[1].textbbox((0, 0), line, font=f)
    w, h = box[2] - box[0], box[3] - box[1]
    out, shown = [], bytes(W * H * 3)
    for x in range(W, -w - 1, -2):
        img, draw = canvas()
        draw_line(draw, line, f, (H - h) // 2, color, x=x)
        frame = img.tobytes()
        out.append((frame, link_ms(changed_pixels(shown, frame))))
        shown = frame
    return out


def page_frames(text, color, loop=False):
    """O texto em paginas: a primeira aparece, cada outra entra pela varredura
    e fica PAGE_MS. Com loop, a ultima volta para a primeira (o laco do painel
    emenda sem pulo); sem, termina na ultima (a abertura antes da arte)."""
    pages = text_pages(text)
    frames, shown = [], None
    for n, (line, size) in enumerate(pages + (pages[:1] if loop and len(pages) > 1 else [])):
        img = page_image(line, size, color)
        if img is None:
            frames += slow_scroll(line, size, color)
            shown = frames[-1][0]
            continue
        if shown is None:
            frames.append((img, PAGE_MS))
        else:
            frames += sweep(shown, img, color)
            if not (loop and n == len(pages)):
                frames.append((img, PAGE_MS))
        shown = img
    return frames


# -- dmdserver ------------------------------------------------------

# Cabecalho DMDStream versao 1, com os campos na ordem de rede (big-endian),
# como o DMD::StreamHeader do libdmdutil (empacotado em 1 byte). Modo 2:
# RGB24. "buffered" deixa o quadro no painel depois que a conexao fecha.
def header(length, disconnect_others):
    return struct.pack('!10sBiHHBBI', b'DMDStream', 1, 2, W, H, 1, int(disconnect_others), length)


def read_pid():
    try:
        with open(PIDFILE) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return 0


# claim: o ultimo evento vence. O pid dele vai para o PIDFILE antes de
# desenhar; o anterior ve o pid trocado e para de desenhar (mine), mas segura
# a conexao (hold) ate este conectar e mandar o primeiro quadro, e so entao e
# encerrado (retire). Uma conexao fechada antes de outra abrir fazia o
# dmdserver repor no painel quadros de eventos antigos (o fim da troca de
# sistema voltava a um logotipo de antes).
PREVIOUS = [0]


def claim():
    old = read_pid()
    tmp = '%s.%d' % (PIDFILE, os.getpid())
    with open(tmp, 'w') as f:
        f.write('%d\n' % os.getpid())
    os.replace(tmp, PIDFILE)
    PREVIOUS[0] = old if old != os.getpid() else 0


def retire():
    old, PREVIOUS[0] = PREVIOUS[0], 0
    if old:
        try:
            with open('/proc/%d/cmdline' % old, 'rb') as f:
                if b'fliperos-dmd' in f.read():
                    os.kill(old, signal.SIGTERM)
        except OSError:
            pass


# hold: o painel fica no ultimo quadro com a conexao aberta ate o proximo
# evento, que encerra este depois de conectar (retire). Sem evento novo em
# HOLD_GRACE segundos depois de perder a vez, sai sozinho. DMD_HOLD=0 (o "Bye"
# do desligamento, que espera o fliperos-dmd acabar): sai meio segundo depois.
HOLD_GRACE = 5
FLUSH, FLUSH_MS = 10, 30


def hold():
    if os.environ.get('DMD_HOLD') == '0':
        time.sleep(0.5)
        return
    while mine():
        time.sleep(0.25)
    end = time.monotonic() + HOLD_GRACE
    while time.monotonic() < end:
        time.sleep(0.1)


def mine():
    return read_pid() == os.getpid()


def release():
    if mine():
        try:
            os.unlink(PIDFILE)
        except OSError:
            pass


def connect():
    host, _, port = SERVER.rpartition(':')
    try:
        return socket.create_connection((host or '127.0.0.1', int(port)), timeout=3)
    except (OSError, ValueError):
        return None


# nap SEGUNDOS: dorme enquanto este evento for o ultimo; False se outro chegou.
def nap(seconds):
    end = time.monotonic() + seconds
    while mine():
        left = end - time.monotonic()
        if left <= 0:
            return True
        time.sleep(min(left, 0.25))
    return False


# play: a abertura (intro) uma vez e depois os quadros; um so fica no painel,
# varios (GIF, texto rolando) repetem ate o proximo evento. retry: segundos
# esperando o dmdserver abrir.
def play(frames, intro=(), retry=0, once=False):
    if not (frames or intro) or not mine():
        return
    sock = connect()
    while sock is None and retry > 0 and nap(1):
        retry -= 1
        sock = connect()
    if sock is None:
        return
    sent = [False]

    def send(data):
        sock.sendall(header(len(data), not sent[0]) + data)
        if not sent[0]:
            sent[0] = True
            retire()            # o evento anterior so solta a conexao agora

    with sock:
        for data, ms in intro:
            send(data)
            if not nap(ms / 1000):
                return hold()
        def flush(data):
            # O dmdserver so passa um quadro ao painel quando chegam outros
            # depois dele (no gabinete, os 6 ultimos da varredura ficavam
            # presos ate o proximo evento: o logotipo parava cortado). O
            # ultimo vai de novo FLUSH vezes; repetido, o painel nao paga nada.
            for _ in range(FLUSH):
                send(data)
                if not nap(FLUSH_MS / 1000):
                    return

        if len(frames) == 1:
            send(frames[0][0])
            flush(frames[0][0])
            return hold()
        if once:
            # Uma vez so, e o painel fica no ultimo quadro (a animacao da
            # troca de sistema).
            for data, ms in frames:
                send(data)
                if not nap(ms / 1000):
                    return hold()
            flush(frames[-1][0])
            return hold()
        while frames and mine():
            for data, ms in frames:
                send(data)
                if not nap(ms / 1000):
                    return hold()


# attract: o protetor de tela (o frontend ocioso): a animacao do logo, a mesma
# da abertura, ate o proximo evento. "attract art": as artes de ~/media (dmd e
# marquee) em ordem aleatoria, cada uma por ATTRACT_SECONDS; sem nenhuma, o logo.
def attract(art=False):
    if not art:
        return play(startup_frames())
    files = []
    for kind in ('dmd', 'marquee'):
        for ext in EXTS:
            files += glob.glob(os.path.join(MEDIA, kind, '**', '*.' + ext), recursive=True)
    if not files:
        return play(startup_frames())
    sock = connect()
    if sock is None:
        return
    with sock:
        first = True
        while mine():
            try:
                frames = image_frames(random.choice(files))
            except (OSError, ValueError, SyntaxError):
                if not nap(0.25):
                    return hold()
                continue
            end = time.monotonic() + ATTRACT_SECONDS
            while time.monotonic() < end:
                for data, ms in frames:
                    sock.sendall(header(len(data), first) + data)
                    if first:
                        first = False
                        retire()
                    left = max(0, end - time.monotonic())
                    if not nap(min(ms / 1000, left) if len(frames) > 1 else left):
                        return hold()


# O nome de um lado que nao cabe na metade dele roda: o espaco minimo entre o
# fim e o comeco de novo, e o tempo de cada ponto andado.
NAME_GAP = 16
NAME_STEP_MS = 60


# versus_frame: o placar de uma partida versus (config/fliperos-versus). Os
# nomes dos lados em cima, as vitorias grandes no meio e os pontos embaixo;
# num jogo sem vitorias na tabela, so os pontos, maiores. Cada lado na cor do
# seu jogador (left_player: quem esta a esquerda, "1" ou "2"; o gabinete do
# jogador 2 o mostra primeiro). ft: o "FT3" do first to, em cima no meio.
def versus_frame(left, wins_left, wins_right, right, score_left, score_right, left_player='1', ft=''):
    img, draw = canvas()
    small = font(9)
    colors = (PLAYER['2'], PLAYER['1']) if left_player == '2' else (PLAYER['1'], PLAYER['2'])
    label = 'FT%s' % ft if ft.isdigit() and int(ft) > 0 else ''

    def width(text, f):
        box = draw.textbbox((0, 0), text, font=f)
        return box[2] - box[0]

    def group(text):
        return '{:,}'.format(int(text)) if text.isdigit() else ''

    room = W // 2 - 3 - ((width(label, small) + 1) // 2 + 2 if label else 0)

    def corner(text, y, color, on_right, room=W // 2 - 3):
        # Cada lado tem a sua metade (os pontos; os nomes compridos rodam, abaixo).
        while text and width(text, small) > room:
            text = text[:-1].rstrip()
        if text:
            draw_line(draw, text, small, y, color, x=W - width(text, small) - 1 if on_right else 1)

    # Os nomes: o que cabe na sua metade fica parado; o que nao cabe roda em
    # circulo dentro dela (nada cortado), desenhado depois, quadro a quadro.
    runs = []
    for text, color, on_right in ((left, colors[0], False), (right, colors[1], True)):
        if text and width(text, small) > room:
            runs.append((text, color, W - room - 1 if on_right else 1))
        else:
            corner(text, 0, color, on_right, room)
    if label:
        draw_line(draw, label, small, 0, (150, 150, 170))
    if wins_left.isdigit() and wins_right.isdigit():
        # As vitorias embaixo dos nomes: maiores quando nao ha pontos, que
        # ficam com a ultima linha.
        points = group(score_left) or group(score_right)
        big = font(15 if points else 20)
        x_mark = font(9 if points else 11)
        top = 10 if points else 12
        gap = 6
        height = draw.textbbox((0, 0), '0', font=big)
        height = height[3] - height[1]
        total = width(wins_left, big) + width('x', x_mark) + width(wins_right, big) + 2 * gap
        x = (W - total) // 2
        draw_line(draw, wins_left, big, top, COLOR['select'], x=x)
        x += width(wins_left, big) + gap
        draw_line(draw, 'x', x_mark, top + height // 2 - 3, (98, 114, 164), x=x)
        x += width('x', x_mark) + gap
        draw_line(draw, wins_right, big, top, COLOR['select'], x=x)
        corner(group(score_left), H - 8, colors[0], False)
        corner(group(score_right), H - 8, colors[1], True)
    else:
        # O maior tamanho em que os dois numeros cabem lado a lado.
        for size in range(13, 7, -1):
            mid = font(size)
            if width(group(score_left), mid) + width(group(score_right), mid) + 6 <= W:
                break
        for text, color, on_right in ((group(score_left), colors[0], False),
                                      (group(score_right), colors[1], True)):
            if text:
                draw_line(draw, text, mid, 15, color, x=W - width(text, mid) - 1 if on_right else 1)
    if not runs:
        return [(img.tobytes(), 1000)]
    # Os nomes compridos: cada um roda na faixa dele (room de largura, a linha
    # de cima), um ponto por quadro, com o comeco voltando atras do fim. Os dois
    # com a mesma volta (o espaco entre as copias completa o mais curto), para
    # o laco do painel emendar sem pulo.
    lap = max(width(text, small) for text, _, _ in runs) + NAME_GAP
    frames = []
    for i in range(lap):
        frame = img.copy()
        for text, color, x0 in runs:
            strip = Image.new('RGB', (room, 10))
            sdraw = ImageDraw.Draw(strip)
            sdraw.fontmode = '1'
            for copy in (0, lap):
                draw_line(sdraw, text, small, 0, color, x=room // 3 - i + copy)
            frame.paste(strip, (x0, 0))
        frames.append((frame.tobytes(), NAME_STEP_MS))
    return frames


# win_frames: quem fechou o first to (config/fliperos-versus). O nome em cima
# na cor do jogador, WIN! embaixo piscando em dourado e fogos de artificio
# estourando nos quatro cantos, um depois do outro. Os fogos ficam nas faixas
# das pontas (o nome vai no meio, ate WIN_ROOM de largura); um nome que nao
# cabe nem na letra menor roda na faixa de cima, sem ser cortado. Antes, um
# lampejo da cor do jogador (uma vez); depois o laco fica ate o proximo evento.
WIN_ROOM = W - 36
WIN_LOOP = 40                  # quadros de 50 ms: 2 s por volta dos fogos
SPARKS = ((255, 220, 80), (255, 255, 255), (255, 121, 198), (80, 250, 123), (190, 120, 255))


def firework(px, cx, cy, age, color, seed):
    """Um estouro em (cx, cy) com age quadros. Antes (age < 0) a faisca sobe do
    chao ate o ponto; no estouro, 14 raios abrem ate 9 pontos com um rastro
    que vai do branco a cor e cai um pouco no fim, piscando antes de apagar."""
    if age < -5 or age > 18:
        return
    rng = random.Random(seed)
    if age < 0:
        for t in (0, 1):
            y = cy + (-age + t) * 3
            if 0 <= y < H:
                px[cx, y] = (255, 210, 140) if t == 0 else (120, 80, 40)
        return
    rays = 14
    turn = rng.random()
    radius = min(9.0, 1.0 + age * 1.1)
    fade = 1.0 if age < 9 else max(0.0, 1 - (age - 9) / 10)
    drop = max(0, age - 8) * 0.35
    for k in range(rays):
        a = (k + turn) * 2 * math.pi / rays
        speed = 0.8 + 0.2 * ((k * 7 + seed) % 5) / 4
        for n, back in enumerate((0.0, 1.6, 3.2)):
            r = radius * speed - back
            if r < 0.5:
                continue
            x = int(round(cx + r * math.cos(a)))
            y = int(round(cy + r * math.sin(a) * 0.85 + drop))
            if not (0 <= x < W and 0 <= y < H):
                continue
            if age > 11 and (x + y + age) % 3 == 0:
                continue                  # o brilho piscando no fim
            c = (255, 255, 255) if age < 3 else color
            dim = fade * (1.0, 0.55, 0.25)[n]
            px[x, y] = tuple(int(v * dim) for v in c)
    if age < 2:
        for dx, dy in ((0, 0), (1, 0), (-1, 0), (0, 1), (0, -1)):
            if 0 <= cx + dx < W and 0 <= cy + dy < H:
                px[cx + dx, cy + dy] = (255, 255, 255)


def win_frames(name, player):
    color = PLAYER.get(player, PLAYER['1'])
    name = ' '.join(name.split()).upper() or 'P%s' % player
    probe = ImageDraw.Draw(Image.new('RGB', (1, 1)))

    def box(text, f):
        left, top, right, bottom = probe.textbbox((0, 0), text, font=f)
        return right - left, bottom - top

    big, scroll = None, False
    for size in range(16, 8, -1):
        if box(name, font(size))[0] <= WIN_ROOM:
            big = font(size)
            break
    if big is None:
        big, scroll = font(13), True
    name_w, name_h = box(name, big)
    word = font(12)
    win_w = box('WIN!', word)[0]
    # Os quatro cantos estouram em sequencia, dois sempre no ar: o de cima e o
    # de baixo de cada lado se alternam (a faixa de cada lado tem 18 pontos).
    corners = ((9, 9, 0), (W - 10, 10, 10), (9, H - 10, 20), (W - 10, H - 9, 30))
    count = max(WIN_LOOP, (W + name_w) // 2 if scroll else 0)
    frames = []
    for i in range(count):
        img, draw = canvas()
        px = img.load()
        for n, (cx, cy, start) in enumerate(corners):
            age = (i - start) % WIN_LOOP - 5
            hue = color if n in (0, 3) else SPARKS[(n + i // WIN_LOOP) % len(SPARKS)]
            firework(px, cx, cy, age, hue, n * 7 + i // WIN_LOOP)
        x = W - 2 * i if scroll else None
        draw_line(draw, name, big, max(0, (17 - name_h) // 2), color, x=x)
        # WIN! pisca: 0,3 s aceso, 0,2 s apagado (10 quadros, 4 por volta dos fogos).
        if i % 10 < 6:
            draw_line(draw, 'WIN!', word, 19, (255, 220, 80), x=(W - win_w) // 2)
        frames.append((img.tobytes(), 50))
    flash = []
    for level in (0.55, 0.25):
        img = Image.new('RGB', (W, H), tuple(int(v * level) for v in color))
        flash.append((img.tobytes(), 60))
    return flash, frames


def startup_frames():
    for path in (STARTUP, LOGO):
        if os.path.isfile(path):
            try:
                return image_frames(path)
            except (OSError, ValueError, SyntaxError):
                pass
    return text_frames('FliperOS', COLOR['system'])


# slide_frames: a troca de sistema na lista do frontend. O logotipo (o do
# Arcadeflow, desenhado por config/fliperos-syslogo) entra numa varredura que
# troca o de old, o sistema de antes; step e o sentido em que a lista andou
# (-1 ou 1). Cada quadro leva o que o painel aguenta pela USB (link_ms do
# syslogo): um slide ou um fade, que mexem no logotipo inteiro a cada quadro,
# chegavam ao ZeDMD a ~5 quadros por segundo. Sem o logotipo (o tema nao esta
# instalado, ou o sistema nao esta nele), o nome em texto. Os quadros vao
# direto ao dmdserver: nao ha GIF nem arquivo.
def slide_frames(name, old, step):
    path = os.environ.get('SYSLOGO', os.path.join(os.path.dirname(os.path.abspath(__file__)), 'fliperos-syslogo'))
    try:
        from importlib.machinery import SourceFileLoader
        from importlib.util import module_from_spec, spec_from_loader
        spec = spec_from_loader('fliperos_syslogo', SourceFileLoader('fliperos_syslogo', path))
        syslogo = module_from_spec(spec)
        spec.loader.exec_module(syslogo)
        anim = syslogo.frames(name, old, step, (W, H), COLOR['system'])
    except (ImportError, OSError, SyntaxError, AttributeError):
        anim = []
    if not anim:
        return text_frames(name.upper(), COLOR['system'])
    return [(fit(img), ms) for img, ms in anim]


def show(kind, system, rom, title):
    color = COLOR.get(kind, COLOR['game'])
    if kind == 'system':
        art = find_system_art(system)
        if art:
            return image_frames(art)
        return text_frames(title or system.replace('_', ' ').upper(), color)
    art = find_art(system, rom)
    if art:
        return image_frames(art)
    return text_frames(clean(title or title_of(rom)), color)


def main(argv):
    if len(argv) == 3 and argv[1] == 'title':
        print(clean(title_of(argv[2])))
        return 0
    # art SISTEMA [ROM]: a imagem que o painel mostraria (a do jogo ou, sem
    # ROM, a do sistema); o marquee do OBS (config/fliperos-web) a usa.
    if len(argv) in (3, 4) and argv[1] == 'art':
        path = find_art(argv[2], argv[3]) if len(argv) == 4 and argv[3] else None
        path = path or find_system_art(argv[2])
        if path:
            print(path)
        return 0 if path else 1
    if Image is None:
        return 0
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    claim()
    try:
        return run(argv)
    finally:
        # Saindo: o SIGTERM do evento novo (retire) pode chegar agora, no meio da saida.
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        release()


def run(argv):
    intro, retry, once = (), 0, False
    try:
        if len(argv) >= 4 and argv[1] == 'show':
            frames = show(argv[2], argv[3], argv[4] if len(argv) > 4 else '', argv[5] if len(argv) > 5 else '')
            if len(argv) > 6 and argv[6]:
                intro = page_frames(argv[6], COLOR['select'])
        elif len(argv) in (3, 4, 5) and argv[1] == 'slide':
            frames = slide_frames(argv[2], argv[3] if len(argv) > 3 else '', -1 if len(argv) > 4 and argv[4] == '-1' else 1)
            once = len(frames) > 1
        elif len(argv) == 3 and argv[1] == 'image':
            frames = image_frames(argv[2])
        elif len(argv) == 3 and argv[1] == 'text':
            frames = text_frames(argv[2], COLOR['game'])
        elif 8 <= len(argv) <= 10 and argv[1] == 'versus':
            frames = versus_frame(*argv[2:10])
        elif len(argv) == 4 and argv[1] == 'win':
            intro, frames = win_frames(argv[2], argv[3])
        elif argv[1:2] == ['attract'] and argv[2:] in ([], ['art']):
            attract(art=len(argv) == 3)
            return 0
        elif len(argv) == 2 and argv[1] == 'startup':
            # O dmdserver ainda esta abrindo a porta do painel.
            frames, retry = startup_frames(), 20
        else:
            sys.stderr.write('usage: fliperos-dmd show game|select|system SYSTEM ROM [TITLE] [INTRO]\n'
                             '       fliperos-dmd slide SYSTEM [PREVIOUS [STEP]]\n'
                             '       fliperos-dmd image FILE\n'
                             '       fliperos-dmd text TEXT\n'
                             '       fliperos-dmd attract [art] | startup\n'
                             '       fliperos-dmd versus LEFT WINS_LEFT WINS_RIGHT RIGHT SCORE_LEFT SCORE_RIGHT'
                             ' [LEFT_PLAYER [FT]]\n'
                             '       fliperos-dmd win NAME PLAYER\n'
                             '       fliperos-dmd title ROM\n'
                             '       fliperos-dmd art SYSTEM [ROM]\n')
            return 1
        # DMD_WAIT: segundos esperando o dmdserver abrir (o jogo de volta no
        # painel quando o servico reabre no meio da partida).
        retry = max(retry, int(os.environ.get('DMD_WAIT', '0') or 0))
        play(frames, intro, retry, once)
    except OSError:
        pass
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
