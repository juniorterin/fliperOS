#!/usr/bin/env python3
"""Le e muda uma configuracao de um byte do SYSCONF do Wii do Dolphin (a
NAND dele: ~/.local/share/dolphin-emu/Wii/shared2/sys/SYSCONF).

  fliperos-wii-sysconf [--file ARQ] get CHAVE
  fliperos-wii-sysconf [--file ARQ] set CHAVE VALOR

Quem usa: o fliperos-x11-run, antes de abrir o Dolphin, poe IPL.AR em 0: o
Wii pergunta ao SYSCONF se a TV e 4:3 (0) ou 16:9 (1), e o Dolphin nasce com
16:9. Um jogo de Wii em 16:9 espremido no tubo (a imagem do Dolphin e
esticada na janela de 640x240, ver AspectRatio no GFX.ini) sai com todo
mundo magro; em 4:3 ele sai como foi feito.

O arquivo: "SCv0", o numero de itens (u16), os enderecos deles (u16 cada) e,
em cada endereco, um byte (tipo nos 3 bits de cima, tamanho do nome - 1 nos
5 de baixo), o nome e o dado. So os tipos de um byte (3 e 7) se leem e se
trocam; o resto do arquivo fica como estava. Status 0: feito (ou ja estava
assim); 1: sem arquivo, sem a chave ou de outro tipo (o Dolphin cria o
arquivo na primeira vez que abre um jogo de Wii; nada a fazer antes); 2: uso.
"""
import os
import struct
import sys

DEFAULT = os.path.join(os.path.expanduser("~"), ".local/share/dolphin-emu/Wii/shared2/sys/SYSCONF")
BYTE_TYPES = (3, 7)


def find(data, key):
    """(tipo, endereco do dado) da chave, ou None."""
    if len(data) < 6 or data[:4] != b"SCv0":
        return None
    count = struct.unpack(">H", data[4:6])[0]
    if len(data) < 6 + 2 * count:
        return None
    for off in struct.unpack(">%dH" % count, data[6:6 + 2 * count]):
        if off >= len(data):
            continue
        kind, size = data[off] >> 5, (data[off] & 0x1F) + 1
        if data[off + 1:off + 1 + size] == key.encode("ascii"):
            return kind, off + 1 + size
    return None


def main(argv):
    path = DEFAULT
    if argv[:1] == ["--file"] and len(argv) > 1:
        path, argv = argv[1], argv[2:]
    if argv[:1] == ["get"] and len(argv) == 2:
        value = None
    elif argv[:1] == ["set"] and len(argv) == 3 and argv[2].isdigit() and int(argv[2]) < 256:
        value = int(argv[2])
    else:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    try:
        with open(path, "r+b" if value is not None else "rb") as f:
            data = f.read()
            found = find(data, argv[1])
            if not found or found[0] not in BYTE_TYPES:
                return 1
            where = found[1]
            if value is None:
                print(data[where])
                return 0
            if data[where] != value:
                f.seek(where)
                f.write(bytes([value]))
    except OSError:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
