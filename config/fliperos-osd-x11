#!/usr/bin/env python3
"""A OSD do FliperOS por cima de um jogo no X que a camada nao alcanca.

A OSD (config/fliperos-osd) desenha uma imagem de 320x240 em
/run/fliperos-osd/screen, e quem a poe na tela e a camada das trocas de quadro
(config/fliperos-deflicker.c no OpenGL, config/fliperos-vkfps.c no Vulkan).
Um jogo que desenha pelo X sem OpenGL (o MUGEN em RenderMode = System, o
Fightcade) nao tem troca de quadro para ela, e o container do PortProton tira
a camada de todo jogo dele (o LD_PRELOAD trocado, o /run/user privado): a OSD
nao abria. Este programa, um por X de jogo (config/fliperos-x11-client), faz o
papel da camada nesses casos:

  - sem uma camada gravando o FPS (o $XDG_RUNTIME_DIR/fliperos-fps de outro
    programa, novo), grava ele o arquivo a cada segundo: "pid - programa - 0",
    com o pid do xinit do jogo (FLIPEROS_GAME_PID; o Quit da OSD o fecha) e o
    nome do programa (FLIPEROS_DEFLICKER_APP), e a OSD passa a abrir;
  - com a imagem visivel, mostra-a numa janela sem moldura (override-redirect)
    por cima de tudo, esticada para a tela inteira como na camada. O que e
    transparente na imagem fica vazado pela extensao Shape do X: o jogo aparece
    em volta do menu sem compositor. O translucido sai opaco;
  - a janela nao recebe clique nem tecla (a forma de entrada e vazia): os
    controles a OSD ja toma pelo evdev;
  - o flash da pistola de luz da camada (config/fliperos-deflicker.c): no tiro
    de uma pistola (ID_INPUT_GUN no udev, lida sem prender o aparelho), uma
    janela da tela inteira em cinza no brilho gun_flash_level, por cima de
    tudo, por FLASH_FRAMES quadros (pulse) ou enquanto o gatilho esta apertado
    (hold); gun_flash=off nao mostra. Sem ele, nos jogos do PortProton a GunCon
    nao achava a mira nas partes escuras (o The House of the Dead Remake, num
    gabinete de usuario em 2026-11-28).

Com uma camada viva (um jogo em OpenGL ou Vulkan neste X), fica escondido e nao
grava nada: a OSD e o flash sao dela. Sai junto com o X (a conexao cai) ou com o
xinit.

    fliperos-osd-x11

Variaveis: FLIPEROS_OSD_DIR (a pasta do screen), FLIPEROS_FPS_FILE,
FLIPEROS_GAME_PID, FLIPEROS_DEFLICKER_APP, FLIPEROS_CONF (o fliperos.conf),
FLIPEROS_GUN_DEVICES (as pistolas, separadas por ":", nos testes),
FLIPEROS_UDEV_DATA e FLIPEROS_RES_HZ (o refresh do modo, para os quadros).
"""
import ctypes
import errno
import os
import re
import select
import struct
import sys
import time
from array import array

OSD_DIR = os.environ.get("FLIPEROS_OSD_DIR", "/run/fliperos-osd")
MAGIC = 0x44534F46  # "FOSD", o do fliperos-osd
HEADER = struct.Struct("<5I")  # magic, seq, visible, largura, altura
WIDTH, HEIGHT = 320, 240
# A OSD aceita um FPS de ate FPS_FRESH segundos (config/fliperos-osd).
FPS_FRESH = 3.0
BEAT = 1.0
POLL = 0.04
RAISE = 1.0


def fps_path():
    file = os.environ.get("FLIPEROS_FPS_FILE")
    if file:
        return file
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    return os.path.join(runtime, "fliperos-fps") if runtime else None


def layer_alive(path, own_pid, now=None):
    """Uma camada de outro programa gravou o FPS ha pouco (o programa existe)?"""
    if not path:
        return False
    try:
        age = (now if now is not None else time.time()) - os.path.getmtime(path)
        with open(path, encoding="utf-8", errors="replace") as f:
            fields = f.read().split()
    except OSError:
        return False
    if age > FPS_FRESH or not fields or not fields[0].isdigit() or int(fields[0]) == own_pid:
        return False
    return os.path.exists("/proc/" + fields[0])


def beat_line(pid, app):
    """A linha do FPS sem FPS ("-"): a OSD le pid, fps, programa, core."""
    app = re.sub(r"\s+", "_", app or "x11") or "x11"
    return "%d - %s - 0\n" % (pid, app)


def write_beat(path, pid, app):
    if not path:
        return
    tmp = "%s.%d" % (path, os.getpid())
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(beat_line(pid, app))
        os.rename(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def read_screen(path):
    """(seq, visivel, pixels RGBA) do arquivo da OSD; None sem ele, com outro
    formato ou no meio de uma gravacao (seq impar)."""
    try:
        with open(path, "rb") as f:
            head = f.read(HEADER.size)
            if len(head) < HEADER.size:
                return None
            magic, seq, visible, width, height = HEADER.unpack(head)
            if magic != MAGIC or width != WIDTH or height != HEIGHT or seq & 1:
                return None
            if not visible:
                return seq, False, b""
            pixels = f.read(WIDTH * HEIGHT * 4)
            f.seek(4)
            again = struct.unpack("<I", f.read(4))[0]
    except OSError:
        return None
    if again != seq or len(pixels) < WIDTH * HEIGHT * 4:
        return None
    return seq, True, pixels


def to_bgrx(rgba):
    """RGBA para a ordem do X em 24 bits (0x00RRGGBB em little-endian)."""
    out = bytearray(rgba)
    out[0::4], out[2::4] = out[2::4], out[0::4]
    return out


def scale(bgrx, dw, dh):
    """A imagem de 320x240 esticada para dw x dh, pelo pixel mais perto."""
    src = array("I")
    src.frombytes(bytes(bgrx))
    cols = [x * WIDTH // dw for x in range(dw)]
    rows = {}
    out = []
    for y in range(dh):
        sy = y * HEIGHT // dh
        if sy not in rows:
            line = src[sy * WIDTH:(sy + 1) * WIDTH]
            rows[sy] = array("I", map(line.__getitem__, cols)).tobytes()
        out.append(rows[sy])
    return b"".join(out)


def shape_rects(rgba, dw, dh):
    """Os retangulos (x, y, largura, altura) da tela de dw x dh onde a imagem
    nao e transparente: as sequencias de alfa nao zero de cada linha."""
    alpha = bytes(rgba[3::4])
    rects = []
    for sy in range(HEIGHT):
        y0, y1 = sy * dh // HEIGHT, (sy + 1) * dh // HEIGHT
        if y1 <= y0:
            continue
        for m in re.finditer(rb"[^\x00]+", alpha[sy * WIDTH:(sy + 1) * WIDTH]):
            x0, x1 = m.start() * dw // WIDTH, m.end() * dw // WIDTH
            if x1 > x0:
                rects.append((x0, y0, x1 - x0, y1 - y0))
    return rects


# ── O flash da pistola de luz (o mesmo da camada) ──

CONF = os.environ.get("FLIPEROS_CONF", "/etc/fliperos/fliperos.conf")
UDEV_DATA = os.environ.get("FLIPEROS_UDEV_DATA", "/run/udev/data")
EVENT = struct.Struct("llHHi")  # o input_event de 64 bits
EV_KEY, EV_MSC = 0x01, 0x04
BTN_LEFT, MSC_RAW = 0x110, 0x03
GUN_MAX = 4
FLASH_FRAMES = 2
# Sem pistola aberta, procura de novo a cada GUN_SCAN segundos (a que chega
# depois do jogo aberto tambem conta).
GUN_SCAN = 2.0


def flash_settings(text):
    """(modo, brilho) das linhas gun_flash= e gun_flash_level= do fliperos.conf,
    como a camada: a ultima de cada vale; modo 0 off, 1 pulse (o padrao), 2 hold;
    brilho de 0,1 a 1 (gun_flash_level de 10 a 100, o padrao 100)."""
    mode, level = 1, 100
    for line in text.splitlines():
        key, eq, value = line.partition("=")
        if not eq:
            continue
        value = (value.split() or [""])[0]
        if key == "gun_flash":
            mode = 0 if value == "off" else 2 if value == "hold" else 1
        elif key == "gun_flash_level":
            digits = re.match(r"[+-]?\d+", value)
            level = int(digits.group()) if digits else 0
    return mode, min(100, max(10, level)) / 100.0


def gun_devices():
    """Os /dev/input/eventN das pistolas (ID_INPUT_GUN=1 no udev, ate GUN_MAX),
    ou os de FLIPEROS_GUN_DEVICES."""
    env = os.environ.get("FLIPEROS_GUN_DEVICES", "")
    if env:
        return [p for p in env.split(":") if p][:GUN_MAX]
    out = []
    for n in range(32):
        try:
            with open(os.path.join(UDEV_DATA, "c13:%d" % (64 + n)), encoding="utf-8", errors="replace") as f:
                if any(line.startswith("E:ID_INPUT_GUN=1") for line in f):
                    out.append("/dev/input/event%d" % n)
        except OSError:
            continue
    return out[:GUN_MAX]


class GunFlash:
    """Quando a tela fica clara. O gatilho e o MSC_RAW do driver do GunCon 2, que
    vem na hora (o BTN_LEFT dele espera o flash quando a pistola nao ve luz), e o
    BTN_LEFT das outras pistolas, como na camada."""

    def __init__(self, hz=60.0):
        self.pulse = FLASH_FRAMES / (hz if hz > 0 else 60.0)
        self.mode, self.level = 1, 1.0
        self.fds, self.next_scan, self.stamp = [], 0.0, None
        self.held, self.until = False, 0.0

    def reload(self, path=CONF):
        """Rele o fliperos.conf quando ele muda (o menu da OSD e o painel mudam o
        flash com o jogo aberto)."""
        try:
            st = os.stat(path)
            stamp = (st.st_mtime_ns, st.st_size)
            if stamp == self.stamp:
                return
            with open(path, encoding="utf-8", errors="replace") as f:
                text = f.read()
        except OSError:
            stamp, text = None, ""
            if stamp == self.stamp:
                return
        self.stamp = stamp
        self.mode, self.level = flash_settings(text)

    def scan(self, now):
        if self.fds or now < self.next_scan:
            return
        self.next_scan = now + GUN_SCAN
        for path in gun_devices():
            try:
                self.fds.append(os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC))
            except OSError:
                pass

    def close(self):
        for fd in self.fds:
            try:
                os.close(fd)
            except OSError:
                pass
        self.fds, self.held, self.until = [], False, 0.0

    def feed(self, data, now):
        """Os input_event lidos de uma pistola."""
        for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
            _, _, kind, code, value = EVENT.unpack_from(data, i)
            if (kind, code) not in ((EV_KEY, BTN_LEFT), (EV_MSC, MSC_RAW)):
                continue
            if value == 1:
                self.held, self.until = True, now + self.pulse
            elif value == 0:
                self.held = False

    def read(self, now):
        """Le o que as pistolas mandaram; uma que saiu (ENODEV) ou da erro fecha
        todas e a busca recomeca (um aparelho sempre pronto e sem dados faria o
        select acordar sem parar)."""
        for fd in list(self.fds):
            while True:
                try:
                    data = os.read(fd, EVENT.size * 64)
                except OSError as exc:
                    if exc.errno in (errno.EAGAIN, errno.EWOULDBLOCK):
                        break
                    self.close()
                    self.next_scan = now + GUN_SCAN
                    return
                if not data:
                    break
                self.feed(data, now)

    def brightness(self, now):
        """O brilho do flash agora (0: sem flash)."""
        if not self.mode:
            return 0.0
        if (self.mode == 2 and self.held) or now < self.until:
            return self.level
        return 0.0

    def wait(self, now, longest):
        """Quanto o laco pode dormir: ate um pulso acabar, no maximo longest."""
        return max(0.0, min(longest, self.until - now)) if now < self.until else longest


# ── O X (libX11 e libXext por ctypes: nada a instalar) ──

class XSetWindowAttributes(ctypes.Structure):
    _fields_ = [("background_pixmap", ctypes.c_ulong), ("background_pixel", ctypes.c_ulong),
                ("border_pixmap", ctypes.c_ulong), ("border_pixel", ctypes.c_ulong),
                ("bit_gravity", ctypes.c_int), ("win_gravity", ctypes.c_int), ("backing_store", ctypes.c_int),
                ("backing_planes", ctypes.c_ulong), ("backing_pixel", ctypes.c_ulong), ("save_under", ctypes.c_int),
                ("event_mask", ctypes.c_long), ("do_not_propagate_mask", ctypes.c_long),
                ("override_redirect", ctypes.c_int), ("colormap", ctypes.c_ulong), ("cursor", ctypes.c_ulong)]


class XRectangle(ctypes.Structure):
    _fields_ = [("x", ctypes.c_short), ("y", ctypes.c_short), ("width", ctypes.c_ushort), ("height", ctypes.c_ushort)]


CW_BACK_PIXEL = 1 << 1
CW_OVERRIDE_REDIRECT = 1 << 9
CW_EVENT_MASK = 1 << 11
EXPOSURE_MASK = 1 << 15
EXPOSE = 12
XEVENT_SIZE = 192  # o union XEvent: 24 longs
INPUT_OUTPUT = 1
Z_PIXMAP = 2
SHAPE_BOUNDING, SHAPE_INPUT = 0, 2
SHAPE_SET = 0


class Overlay:
    def __init__(self):
        x11 = ctypes.CDLL("libX11.so.6")
        ext = ctypes.CDLL("libXext.so.6")
        vp, ul, ui, i = ctypes.c_void_p, ctypes.c_ulong, ctypes.c_uint, ctypes.c_int
        x11.XOpenDisplay.restype, x11.XOpenDisplay.argtypes = vp, [ctypes.c_char_p]
        x11.XDefaultScreen.restype, x11.XDefaultScreen.argtypes = i, [vp]
        x11.XRootWindow.restype, x11.XRootWindow.argtypes = ul, [vp, i]
        x11.XDefaultVisual.restype, x11.XDefaultVisual.argtypes = vp, [vp, i]
        x11.XDefaultDepth.restype, x11.XDefaultDepth.argtypes = i, [vp, i]
        x11.XDefaultGC.restype, x11.XDefaultGC.argtypes = vp, [vp, i]
        x11.XCreateWindow.restype = ul
        x11.XCreateWindow.argtypes = [vp, ul, i, i, ui, ui, ui, i, ui, vp, ul, ctypes.POINTER(XSetWindowAttributes)]
        x11.XGetGeometry.restype = i
        x11.XGetGeometry.argtypes = [vp, ul, ctypes.POINTER(ul), ctypes.POINTER(i), ctypes.POINTER(i),
                                     ctypes.POINTER(ui), ctypes.POINTER(ui), ctypes.POINTER(ui), ctypes.POINTER(ui)]
        x11.XMoveResizeWindow.argtypes = [vp, ul, i, i, ui, ui]
        x11.XMapRaised.argtypes = [vp, ul]
        x11.XRaiseWindow.argtypes = [vp, ul]
        x11.XUnmapWindow.argtypes = [vp, ul]
        x11.XFlush.argtypes = [vp]
        x11.XSync.argtypes = [vp, i]
        x11.XCreateImage.restype = vp
        x11.XCreateImage.argtypes = [vp, vp, ui, i, i, ctypes.c_char_p, ui, ui, i, i]
        x11.XPutImage.argtypes = [vp, ul, vp, vp, i, i, i, i, ui, ui]
        x11.XPending.restype, x11.XPending.argtypes = i, [vp]
        x11.XNextEvent.argtypes = [vp, vp]
        x11.XFree.argtypes = [vp]
        x11.XStoreName.argtypes = [vp, ul, ctypes.c_char_p]
        x11.XSetWindowBackground.argtypes = [vp, ul, ul]
        x11.XClearWindow.argtypes = [vp, ul]
        ext.XShapeCombineRectangles.argtypes = [vp, ul, i, i, i, ctypes.POINTER(XRectangle), i, i, i]
        self.x11, self.ext = x11, ext
        self.dpy = x11.XOpenDisplay(None)
        if not self.dpy:
            raise OSError("no X display")
        self.screen = x11.XDefaultScreen(self.dpy)
        self.root = x11.XRootWindow(self.dpy, self.screen)
        if x11.XDefaultDepth(self.dpy, self.screen) not in (24, 32):
            raise OSError("the X screen is not 24-bit")
        self.size = self.root_size()
        # O Expose: um compositor que entra ou sai (o picom do filtro, que fecha
        # e abre a cada troca de nivel) faz o servidor limpar a janela na cor de
        # fundo, e so quem a repinta a traz de volta (exposed, abaixo).
        attrs = XSetWindowAttributes(background_pixel=0, override_redirect=1, event_mask=EXPOSURE_MASK)
        self.win = x11.XCreateWindow(self.dpy, self.root, 0, 0, self.size[0], self.size[1], 0, 0, INPUT_OUTPUT, None,
                                     CW_BACK_PIXEL | CW_OVERRIDE_REDIRECT | CW_EVENT_MASK, ctypes.byref(attrs))
        x11.XStoreName(self.dpy, self.win, b"fliperos-osd")
        # Nada de clique nem foco: a forma de entrada vazia.
        ext.XShapeCombineRectangles(self.dpy, self.win, SHAPE_INPUT, 0, 0, None, 0, SHAPE_SET, 0)
        self.gc = x11.XDefaultGC(self.dpy, self.screen)
        self.mapped = False
        # A ultima imagem posta (pixels, largura, altura), para repintar.
        self.shown = None
        # O flash da pistola: outra janela, so a cor de fundo (o servidor a pinta
        # ao mapear, sem desenho nosso), tambem sem clique nem foco.
        attrs = XSetWindowAttributes(background_pixel=0xFFFFFF, override_redirect=1)
        self.flash_win = x11.XCreateWindow(self.dpy, self.root, 0, 0, self.size[0], self.size[1], 0, 0, INPUT_OUTPUT,
                                           None, CW_BACK_PIXEL | CW_OVERRIDE_REDIRECT, ctypes.byref(attrs))
        x11.XStoreName(self.dpy, self.flash_win, b"fliperos-gun-flash")
        ext.XShapeCombineRectangles(self.dpy, self.flash_win, SHAPE_INPUT, 0, 0, None, 0, SHAPE_SET, 0)
        self.flash_level = 0.0

    def root_size(self):
        """A tela de agora (muda a cada modo do Switchres ou xrandr --scale)."""
        root, x, y = ctypes.c_ulong(), ctypes.c_int(), ctypes.c_int()
        w, h, b, d = ctypes.c_uint(), ctypes.c_uint(), ctypes.c_uint(), ctypes.c_uint()
        self.x11.XGetGeometry(self.dpy, self.root, ctypes.byref(root), ctypes.byref(x), ctypes.byref(y),
                              ctypes.byref(w), ctypes.byref(h), ctypes.byref(b), ctypes.byref(d))
        return max(1, w.value), max(1, h.value)

    def show(self, rgba):
        x11 = self.x11
        self.size = dw, dh = self.root_size()
        rects = shape_rects(rgba, dw, dh)
        data = scale(to_bgrx(rgba), dw, dh)
        x11.XMoveResizeWindow(self.dpy, self.win, 0, 0, dw, dh)
        arr = (XRectangle * max(1, len(rects)))(*[XRectangle(*r) for r in rects])
        self.ext.XShapeCombineRectangles(self.dpy, self.win, SHAPE_BOUNDING, 0, 0, arr, len(rects), SHAPE_SET, 0)
        if not self.mapped:
            x11.XMapRaised(self.dpy, self.win)
            self.mapped = True
        else:
            x11.XRaiseWindow(self.dpy, self.win)
        # O flash fica por cima da OSD, como na camada.
        if self.flash_level:
            x11.XRaiseWindow(self.dpy, self.flash_win)
        self.shown = (data, dw, dh)
        self.paint()

    def paint(self):
        """Poe a ultima imagem na janela."""
        if not self.shown:
            return
        x11 = self.x11
        data, dw, dh = self.shown
        buf = ctypes.create_string_buffer(data, len(data))
        image = x11.XCreateImage(self.dpy, x11.XDefaultVisual(self.dpy, self.screen),
                                 x11.XDefaultDepth(self.dpy, self.screen), Z_PIXMAP, 0, buf, dw, dh, 32, dw * 4)
        if image:
            x11.XPutImage(self.dpy, self.win, self.gc, image, 0, 0, 0, 0, dw, dh)
            # So a estrutura: os pixels sao do buf (o XDestroyImage os liberaria).
            x11.XFree(image)
        x11.XSync(self.dpy, 0)

    def exposed(self):
        """O X pediu para repintar a janela (Expose): ela foi limpa, como quando
        o picom do filtro reinicia na troca de nivel (o menu ficava todo preto
        ate mudar de novo). Repinta com a ultima imagem; True se repintou."""
        x11 = self.x11
        hit = False
        event = ctypes.create_string_buffer(XEVENT_SIZE)
        while x11.XPending(self.dpy):
            x11.XNextEvent(self.dpy, ctypes.addressof(event))
            if struct.unpack_from("i", event, 0)[0] == EXPOSE:
                hit = True
        if hit and self.mapped and self.shown:
            self.paint()
            return True
        return False

    def raise_(self):
        if self.mapped:
            self.x11.XRaiseWindow(self.dpy, self.win)
            if self.flash_level:
                self.x11.XRaiseWindow(self.dpy, self.flash_win)
            self.x11.XFlush(self.dpy)

    def flash(self, level):
        """A tela inteira em cinza no brilho level (0 a 1) por cima de tudo, como o
        flash da camada (glClear com a mesma cor); 0 esconde. So fala com o X
        quando muda, e manda na hora (o driver espera a luz por flash_ms)."""
        if level == self.flash_level:
            return
        x11 = self.x11
        if level > 0:
            gray = max(0, min(255, round(level * 255)))
            x11.XSetWindowBackground(self.dpy, self.flash_win, gray << 16 | gray << 8 | gray)
            if self.flash_level:
                x11.XClearWindow(self.dpy, self.flash_win)
            else:
                w, h = self.root_size()
                x11.XMoveResizeWindow(self.dpy, self.flash_win, 0, 0, w, h)
                x11.XMapRaised(self.dpy, self.flash_win)
        else:
            x11.XUnmapWindow(self.dpy, self.flash_win)
        x11.XFlush(self.dpy)
        self.flash_level = level

    def hide(self):
        if self.mapped:
            self.x11.XUnmapWindow(self.dpy, self.win)
            self.x11.XFlush(self.dpy)
            self.mapped = False


def main():
    try:
        overlay = Overlay()
    except OSError as exc:
        print("fliperos-osd-x11: %s" % exc, file=sys.stderr)
        return 0
    own = os.environ.get("FLIPEROS_GAME_PID", "")
    own_pid = int(own) if own.isdigit() else os.getppid()
    app = os.environ.get("FLIPEROS_DEFLICKER_APP", "")
    fps = fps_path()
    screen = os.path.join(OSD_DIR, "screen")
    try:
        hz = float(os.environ.get("FLIPEROS_RES_HZ", "") or 60)
    except ValueError:
        hz = 60.0
    gun = GunFlash(hz)
    shown_seq, shown_size, last_beat, last_raise = None, None, 0.0, 0.0
    while True:
        # O X caindo, o Xlib fecha o programa; o xinit saindo, sai aqui.
        if not os.path.exists("/proc/%d" % own_pid):
            return 0
        now = time.time()
        overlay.exposed()
        if layer_alive(fps, own_pid, now):
            overlay.hide()
            # O flash tambem e da camada: as pistolas ficam com ela.
            gun.close()
            overlay.flash(0.0)
            shown_seq = None
            time.sleep(0.5)
            continue
        if now - last_beat >= BEAT:
            write_beat(fps, own_pid, app)
            last_beat = now
        state = read_screen(screen)
        if state and state[1]:
            if state[0] != shown_seq or overlay.root_size() != shown_size:
                overlay.show(state[2])
                shown_seq, shown_size, last_raise = state[0], overlay.size, now
            elif now - last_raise >= RAISE:
                overlay.raise_()
                last_raise = now
        elif state is not None or not os.path.exists(screen):
            overlay.hide()
            shown_seq = None
        # Ate a proxima volta (POLL), esperando nas pistolas: o tiro acende a tela
        # na hora, e o fim do pulso a apaga na hora.
        gun.reload()
        if gun.mode:
            gun.scan(now)
        else:
            gun.close()
        deadline = now + POLL
        while True:
            t = time.time()
            gun.read(t)
            overlay.flash(gun.brightness(t))
            if t >= deadline:
                break
            pause = gun.wait(t, deadline - t)
            try:
                select.select(gun.fds, [], [], pause) if gun.fds else time.sleep(pause)
            except (OSError, ValueError):
                time.sleep(pause)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
