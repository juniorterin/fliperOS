#!/usr/bin/env python3
"""Calibracao de light gun (GunCon 2) e de eixos (volante, pedais,
analogico), pelo Setup > Joysticks do fliperos-setup ou na mao:

    fliperos-calibrate list               controles que dao para calibrar
    fliperos-calibrate guncon2 EVENTO [ROTULO]
                                          alvos na tela; grava guncon2.conf (e o
                                          da porta USB da pistola, para varias)
    fliperos-calibrate trigger ARQUIVO EVENTO...
                                          escreve no ARQUIVO a pistola que atirou
    fliperos-calibrate axes EVENTO        volante, pedais, analogico
    fliperos-calibrate apply EVENTO       reaplica o que foi salvo (udev)

O evdev nao guarda calibracao no aparelho: ela se perde a cada conexao, e a
regra do udev (config/99-fliperos-input.rules) a reaplica. O GunCon 2 segue
em /etc/fliperos/guncon2.conf (X_MIN, X_MAX, Y_MIN, Y_MAX), que o
fliperos-guncon2-calibrate le; os eixos ficam em
/etc/fliperos/calibration.conf, uma linha por eixo.

Sem dependencias: evdev lido e calibrado com struct e ioctl.
"""
import fcntl
import glob
import os
import re
import select
import struct
import sys
import termios
import time
import tty

GUNCON_CONF = os.environ.get('FLIPEROS_GUNCON_CONF', '/etc/fliperos/guncon2.conf')
GUNCON_PARAMS = os.environ.get('GUNCON2_PARAMS', '/sys/module/guncon2/parameters')
AXES_CONF = os.environ.get('FLIPEROS_CALIBRATION_CONF', '/etc/fliperos/calibration.conf')
# A faixa da pistola durante a calibracao. O driver (config/guncon2-patches)
# decide pela faixa calibrada se a pistola ve a tela: com uma faixa salva
# errada (visto: X 521..589 num tubo de 144..728) todo tiro de verdade saia
# como fora da tela, e nenhuma calibracao nova conseguia ler um tiro.
OPEN_X, OPEN_Y = (0, 1023), (0, 511)
# Menor faixa que se aceita gravar: a tela inteira le uns 580 em X e 230 em Y
# a 15 kHz (metade de X a 31 kHz). Menos que isto e tiro no mesmo lugar.
MIN_SPAN = (100, 50)
GUNCON_ID = (0x0b9a, 0x016a)
PADKEYS_NAME = b'FliperOS pad keys'

EV_KEY, EV_ABS = 0x01, 0x03
ABS_X, ABS_Y = 0x00, 0x01
BTN_LEFT, BTN_MIDDLE = 0x110, 0x112
BTN_B, BTN_SELECT = 0x131, 0x13a
KEY_ESC = 1
ABS_NAMES = {0: 'X', 1: 'Y', 2: 'Z', 3: 'RX', 4: 'RY', 5: 'RZ', 6: 'Throttle', 7: 'Rudder',
             8: 'Wheel', 9: 'Gas', 10: 'Brake'}
ABS_RX, ABS_RY, ABS_HAT0X, ABS_HAT0Y = 0x03, 0x04, 0x10, 0x11
# O nome de um eixo que descansa numa ponta (pedal, gatilho, manete) quando
# o codigo ja diz o que e; os outros sao "PEDAL Y", "PEDAL RZ".
PEDAL_NAMES = {6: 'THROTTLE', 7: 'RUDDER', 9: 'GAS', 10: 'BRAKE'}
HATS = range(0x10, 0x18)
EVENT = struct.Struct('llHHi')
ABSINFO = struct.Struct('6i')   # value, minimum, maximum, fuzz, flat, resolution
# Setas, F1... no terminal: ESC [ ... letra, ou ESC O letra.
ESCAPE_SEQ = re.compile(rb'\x1b(\[[0-9;?]*[ -/]*[@-~]|O.)')

# Force feedback (linux/input.h): o volante puxa e treme no teste.
EV_FF = 0x15
FF_RUMBLE, FF_PERIODIC, FF_CONSTANT, FF_SINE, FF_AUTOCENTER = 0x50, 0x51, 0x52, 0x5a, 0x61
# Volante: tem o centramento do force feedback, ou o nome diz.
WHEEL_NAME = re.compile(rb'wheel|racing|driving|steering|formula', re.I)
# Segurar um botao do controle este tempo passa para o passo seguinte; um
# toque so acende o botao na tela (o teste dos botoes).
HOLD = 1.0


def _ioc(direction, nr, size):
    return (direction << 30) | (size << 16) | (ord('E') << 8) | nr


EVIOCGID = _ioc(2, 0x02, 8)
EVIOCGNAME = _ioc(2, 0x06, 256)
EVIOCGPHYS = _ioc(2, 0x07, 256)
# struct ff_effect tem 48 bytes no x86_64 (a union alinhada em 8, pelo
# ponteiro do ff_periodic_effect).
FF_EFFECT_SIZE = 48
EVIOCSFF = _ioc(1, 0x80, FF_EFFECT_SIZE)
EVIOCRMFF = _ioc(1, 0x81, 4)


def eviocgbit(ev, length):
    return _ioc(2, 0x20 + ev, length)


def eviocgabs(axis):
    return _ioc(2, 0x40 + axis, ABSINFO.size)


def eviocsabs(axis):
    return _ioc(1, 0xc0 + axis, ABSINFO.size)


