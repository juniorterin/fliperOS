def guncon_range(raw1, raw2, frac1, frac2):
    """Valor cru nas bordas da tela (fracao 0 e 1) a partir de dois tiros em
    pontos conhecidos: o GunCon 2 e linear ao longo da linha e da coluna."""
    slope = (raw2 - raw1) / (frac2 - frac1)
    return round(raw1 - slope * frac1), round(raw1 + slope * (1 - frac1))


def median(values):
    s = sorted(values)
    return s[len(s) // 2]


def gun_sees(x, y):
    """O tiro leu a tela? Sem luz o GunCon 2 manda x 0 ou 1 (y 5), e o driver,
    fora da tela, um valor abaixo da faixa, negativo com a faixa aberta."""
    return x > 1 and y > 0


def plausible_range(xr, yr):
    """A faixa medida cobre a tela? Dois alvos lidos quase no mesmo ponto dao
    uma faixa curta, que travaria a pistola (veja OPEN_X)."""
    return xr[1] - xr[0] >= MIN_SPAN[0] and yr[1] - yr[0] >= MIN_SPAN[1]


def axis_calibration(seen_min, seen_max, rest, orig_min, orig_max, wheel=False):
    """(min, max, zona morta) de um eixo pelo curso visto e pelo repouso, ou
    None se ele quase nao se mexeu. Volante (wheel): o curso de batente a
    batente, sem zona morta; o centro e o meio dele, que e o mecanico, e nao
    o repouso: sem mola (o centramento do driver Logitech vem em 0) o
    volante fica onde a mao o deixou. Analogico: faixa simetrica em volta do
    repouso, para o centro dar 0, com 1% de zona morta; o lado mais longo
    satura no fim do curso. Repouso longe do meio do curso (mais de 10%) nao
    e centro (um eixo sem mola de outro controle): o meio do curso. Eixo de
    repouso numa ponta (pedal): a faixa vista, sem zona morta."""
    span = orig_max - orig_min
    seen = seen_max - seen_min
    if span <= 0 or seen < span * 0.05:
        return None
    if wheel:
        return seen_min, seen_max, 0
    if rest - seen_min > seen * 0.2 and seen_max - rest > seen * 0.2:
        if abs(rest - (seen_min + seen_max) / 2) > seen * 0.1:
            return seen_min, seen_max, max(1, round(seen * 0.01))
        half = min(rest - seen_min, seen_max - rest)
        return rest - half, rest + half, max(1, round(2 * half * 0.01))
    return seen_min, seen_max, 0


def read_key(data):
    """O que a calibracao entende de uma leitura do terminal: "\\n" (Enter),
    "\\033" (um Esc sozinho), outro caractere ou "". Setas e outras sequencias
    de escape nao contam: com o controle como teclado ligado, girar o volante
    mandava ESC [ D, e o ESC delas cancelava a calibracao."""
    data = ESCAPE_SEQ.sub(b'', data)
    if b'\n' in data or b'\r' in data:
        return '\n'
    if data == b'\x1b':
        return '\033'
    if data[:1] in (b'', b'\x1b'):
        return ''
    return data[:1].decode(errors='replace')


def ff_effect(kind, length_ms, level=0, period=50, strong=0, weak=0):
    """Um struct ff_effect para o EVIOCSFF (id -1: o kernel da um). A forca
    constante vai sempre na direcao 0x4000 e o lado sai do sinal do nivel: o
    hid-lg4ff do kernel ignora a direcao, o new-lg4ff multiplica pelo seno
    dela (que e 1 em 0x4000)."""
    head = struct.pack('<HhHHHHH', kind, -1, 0x4000, 0, 0, length_ms, 0) + b'\0\0'
    if kind == FF_CONSTANT:
        body = struct.pack('<hHHHH', level, 0, 0, 0, 0)
    elif kind == FF_PERIODIC:
        # waveform, period, magnitude, offset, phase, envelope (4)
        body = struct.pack('<HHhhHHHHH', FF_SINE, period, level, 0, 0, 0, 0, 0, 0)
    else:
        body = struct.pack('<HH', strong, weak)
    return bytearray(head + body.ljust(FF_EFFECT_SIZE - len(head), b'\0'))


# A tela dos botoes desenha o controle com cada botao no lugar dele.
# Volantes de PlayStation da Logitech: a ordem dos botoes do relatorio USB
# (o Driving Force Pro tem estes 14; o cambio sequencial sao os dois
# ultimos). Volante que nao esta na lista usa os mesmos lugares, com o
# numero do botao no lugar do simbolo.
LOGITECH_PS = ['cross', 'square', 'circle', 'triangle', 'r1', 'l1', 'r2', 'l2', 'select', 'start',
               'r3', 'l3', 'gear_up', 'gear_down']
KNOWN_LAYOUTS = {(0x046d, 0xc298): ('wheel', 'ps', LOGITECH_PS)}   # Driving Force Pro
# Joypad que o kernel ja diz o que e cada botao (xpad, hid-sony, hid-nintendo).
PAD_CODES = {0x130: 'south', 0x131: 'east', 0x133: 'north', 0x134: 'west', 0x136: 'tl', 0x137: 'tr',
             0x138: 'tl2', 0x139: 'tr2', 0x13a: 'select', 0x13b: 'start', 0x13c: 'mode',
             0x13d: 'thumbl', 0x13e: 'thumbr', 0x220: 'dup', 0x221: 'ddown', 0x222: 'dleft', 0x223: 'dright'}
SONY_NAME = re.compile(rb'sony|playstation|dualshock|dualsense', re.I)


def button_layout(ident, name, buttons, wheel):
    """(familia, simbolos, lugar de cada botao) para a tela dos botoes:
    'wheel' (o volante de frente), 'pad' (o joypad) ou 'grid' (painel,
    encoder: os botoes em fileiras). simbolos: 'ps' (cruz, quadrado...),
    'xbox' (A B X Y) ou 'numbers'. O lugar e None quando nao ha um."""
    if ident in KNOWN_LAYOUTS:
        family, symbols, slots = KNOWN_LAYOUTS[ident]
        return family, symbols, [slots[i] if i < len(slots) else None for i in range(len(buttons))]
    if wheel:
        return 'wheel', 'numbers', [LOGITECH_PS[i] if i < len(LOGITECH_PS) else None for i in range(len(buttons))]
    if any(code in PAD_CODES for code in buttons):
        return 'pad', 'ps' if SONY_NAME.search(name) else 'xbox', [PAD_CODES.get(code) for code in buttons]
    return 'grid', 'numbers', [None] * len(buttons)


# O teste do force feedback: (nome, efeito, ms). Puxa para um lado, para o
# outro e treme; o lado que aparece na tela e o que o volante andou.
FF_TEST = [('pull', (FF_CONSTANT, 700, 0x5000), 700),
           ('pull', (FF_CONSTANT, 700, -0x5000), 700),
           ('shake', None, 900)]


def axis_kind(code, lo, hi, value, wheel):
    """'wheel' (o X de um volante), 'pedal' (descansa numa ponta: pedal,
    gatilho, manete) ou 'center' (analogico, eixo de volante de outro
    controle), pelo valor de agora, com o controle solto."""
    span = max(1, hi - lo)
    if wheel and code == ABS_X:
        return 'wheel'
    if min(value - lo, hi - value) <= span * 0.1:
        return 'pedal'
    return 'center'


def axis_fraction(kind, value, lo, hi, rest):
    """Posicao para a barra: pedal de 0 a 1 (quanto foi pisado, da ponta de
    repouso), o resto de -1 a 1 em volta do meio."""
    span = max(1, hi - lo)
    if kind == 'pedal':
        return max(0.0, min(1.0, abs(value - rest) / span))
    return max(-1.0, min(1.0, (value - (lo + hi) / 2) / (span / 2)))


def axis_label(kind, code):
    if kind == 'wheel':
        return 'WHEEL'
    name = PEDAL_NAMES.get(code) or ABS_NAMES.get(code, str(code)).upper()
    return name if code in PEDAL_NAMES or kind != 'pedal' else 'PEDAL ' + name


def bar_cells(kind, frac, seen, width):
    """[(cor, caractere)] de uma linha da barra. Pedal: cheia da esquerda ate
    a pressao; o resto: do meio ate a posicao, com o meio marcado. O ponto
    mais longe visto fica amarelo (o quanto ja chegou)."""
    cells = [('1;30', '░')] * width
    if kind == 'pedal':
        fill = round(frac * width)
        for i in range(fill):
            cells[i] = ('1;32', '█')
        top = round(max(seen) * width) - 1
        if top >= fill:
            cells[top] = ('0;33', '█')
        return cells
    half = width // 2
    pos = max(0, min(width - 1, half + round(frac * half)))
    for i in range(min(half, pos), max(half, pos) + 1):
        cells[i] = ('1;36', '█')
    for f in seen:
        mark = max(0, min(width - 1, half + round(f * half)))
        if not min(half, pos) <= mark <= max(half, pos):
            cells[mark] = ('0;33', '█')
    cells[half] = ('1;37', '█')
    return cells


def read_axes_conf(path):
    """{(vendor, produto): {eixo: (min, max, zona)}} do calibration.conf."""
    out = {}
    try:
        lines = open(path).read().splitlines()
    except OSError:
        return out
    for line in lines:
        line = line.split('#', 1)[0].split()
        if len(line) != 5 or ':' not in line[0]:
            continue
        vid, pid = (int(v, 16) for v in line[0].split(':'))
        out.setdefault((vid, pid), {})[int(line[1])] = tuple(int(v) for v in line[2:])
    return out


def write_axes_conf(path, ident, name, axes):
    """Troca as linhas do controle (vendor, produto) pelas novas."""
    key = '%04x:%04x' % ident
    keep = []
    try:
        for line in open(path).read().splitlines():
            if line.split(' ', 1)[0] != key and not line.startswith('#'):
                keep.append(line)
    except OSError:
        pass
    new = ['%s %d %d %d %d  # %s %s' % (key, axis, lo, hi, flat, name, ABS_NAMES.get(axis, axis))
           for axis, (lo, hi, flat) in sorted(axes.items())]
    os.makedirs(os.path.dirname(path) or '.', exist_ok=True)
    with open(path + '.new', 'w') as f:
        f.write('# Calibracao de eixos (Setup > Joysticks, fliperos-calibrate). Uma\n'
                '# linha por eixo: VENDOR:PRODUTO EIXO MINIMO MAXIMO ZONA_MORTA\n')
        f.write(''.join(l + '\n' for l in keep + new))
    os.chmod(path + '.new', 0o644)
    os.replace(path + '.new', path)


def gun_conf_path(base, phys):
    """O guncon2.conf de UMA pistola: guncon2-<porta USB>.conf ao lado do geral.
    Duas GunCon 2 sao iguais no vendor/produto; o que as separa e a porta em que
    estao (o phys do evdev), que vale a cada reconexao. Sem porta, o geral."""
    key = ''.join(c if c.isalnum() else '_' for c in phys).strip('_')
    if not key:
        return base
    stem, ext = os.path.splitext(base)
    return '%s-%s%s' % (stem, key, ext)


def write_guncon_conf(path, x, y):
    os.makedirs(os.path.dirname(path) or '.', exist_ok=True)
    with open(path + '.new', 'w') as f:
        f.write('# Faixa util do GunCon 2 neste monitor, medida em Setup > Joysticks >\n'
                '# Calibrate GunCon 2 (fliperos-calibrate). Refaca se mudar o modo de\n'
                '# video, a geometria ou a posicao do tubo.\n')
        f.write('X_MIN=%d\nX_MAX=%d\nY_MIN=%d\nY_MAX=%d\n' % (x[0], x[1], y[0], y[1]))
    os.chmod(path + '.new', 0o644)
    os.replace(path + '.new', path)


# ── evdev ──────────────────────────────────────────────────────────

class Device:
    def __init__(self, path, write=False):
        self.path = path
        self.fd = os.open(path, (os.O_RDWR if write else os.O_RDONLY) | os.O_NONBLOCK)
        buf = bytearray(256)
        fcntl.ioctl(self.fd, EVIOCGNAME, buf)
        self.name = bytes(buf).split(b'\0')[0]
        buf = bytearray(256)
        try:
            fcntl.ioctl(self.fd, EVIOCGPHYS, buf)
        except OSError:
            buf = bytearray(256)
        self.phys = bytes(buf).split(b'\0')[0].decode(errors='replace')
        ident = bytearray(8)
        fcntl.ioctl(self.fd, EVIOCGID, ident)
        _bus, vid, pid, _ver = struct.unpack('4H', ident)
        self.ident = (vid, pid)
        self.keys = self.bits(EV_KEY, 0x300)
        self.abs = self.bits(EV_ABS, 0x40)
        self.ff = self.bits(EV_FF, 0x80)
        self.effects = {}

    def bits(self, ev, count):
        buf = bytearray((count + 7) // 8)
        fcntl.ioctl(self.fd, eviocgbit(ev, len(buf)), buf)
        return {i for i in range(count) if buf[i // 8] >> (i % 8) & 1}

    def absinfo(self, axis):
        buf = bytearray(ABSINFO.size)
        fcntl.ioctl(self.fd, eviocgabs(axis), buf)
        return list(ABSINFO.unpack(buf))

    def set_abs(self, axis, lo, hi, flat=None):
        info = self.absinfo(axis)
        info[1], info[2] = lo, hi
        if flat is not None:
            info[4] = flat
        fcntl.ioctl(self.fd, eviocsabs(axis), ABSINFO.pack(*info))

    def analog_axes(self):
        return sorted(a for a in self.abs if a not in HATS and self.absinfo(a)[2] - self.absinfo(a)[1] > 2)

    def is_gun(self):
        return self.ident == GUNCON_ID or (b'guncon' in self.name.lower() and BTN_LEFT in self.keys)

    def has_axes(self):
        joyish = any(0x120 <= k < 0x140 or 0x2c0 <= k < 0x2e8 for k in self.keys)
        return (joyish and not self.is_gun() and BTN_LEFT not in self.keys
                and self.name != PADKEYS_NAME and bool(self.analog_axes()))

    def is_wheel(self):
        return FF_AUTOCENTER in self.ff or bool(WHEEL_NAME.search(self.name))

    def buttons(self):
        """Os botoes de joystick/gamepad na ordem do SDL (de BTN_JOYSTICK em
        diante): o botao 1 da tela e o primeiro."""
        return sorted(k for k in self.keys if 0x120 <= k < 0x140 or 0x2c0 <= k < 0x2e8)

    def ff_kinds(self):
        """Os efeitos do teste que o controle faz: pull (forca constante) e
        shake (periodico, ou o rumble de um joypad)."""
        out = []
        if FF_CONSTANT in self.ff:
            out.append('pull')
        if FF_PERIODIC in self.ff or FF_RUMBLE in self.ff:
            out.append('shake')
        return out

    def ff_play(self, effect):
        """Sobe o efeito (ff_effect) e o toca uma vez. Fechar o arquivo apaga
        os efeitos dele no kernel."""
        buf = effect
        fcntl.ioctl(self.fd, EVIOCSFF, buf)
        eid = struct.unpack_from('<h', buf, 2)[0]
        os.write(self.fd, EVENT.pack(0, 0, EV_FF, eid, 1))
        return eid

    def ff_stop(self, eid):
        try:
            os.write(self.fd, EVENT.pack(0, 0, EV_FF, eid, 0))
            fcntl.ioctl(self.fd, EVIOCRMFF, eid)
        except OSError:
            pass

    def shake_effect(self, ms):
        if FF_PERIODIC in self.ff:
            return ff_effect(FF_PERIODIC, ms, 0x4000, period=60)
        return ff_effect(FF_RUMBLE, ms, strong=0xA000, weak=0x6000)

    def events(self):
        try:
            data = os.read(self.fd, EVENT.size * 64)
        except BlockingIOError:
            return []
        return [EVENT.unpack_from(data, i)[2:] for i in range(0, len(data) - EVENT.size + 1, EVENT.size)]

    def close(self):
        os.close(self.fd)


def devices():
    for path in sorted(glob.glob('/dev/input/event*'), key=lambda p: int(p.rsplit('event', 1)[1])):
        try:
            yield Device(path)
        except OSError:
            continue


# ── Tela ───────────────────────────────────────────────────────────

class Screen:
    """Desenho direto no terminal (o console do gabinete): o Gum nao pinta a
    tela inteira de branco, e a pistola precisa de luz onde mira."""

    def __init__(self):
        self.out = sys.stdout
        self.fd = sys.stdin.fileno()
        self.saved = termios.tcgetattr(self.fd) if os.isatty(self.fd) else None
        if self.saved:
            tty.setcbreak(self.fd)
        try:
            self.cols, self.rows = os.get_terminal_size(self.out.fileno())
        except OSError:
            self.cols, self.rows = 80, 30

    def write(self, text):
        self.out.write(text)
        self.out.flush()

    def at(self, row, col, text):
        self.write('\033[%d;%dH%s' % (row, col, text))

    def key(self):
        """Tecla apertada, sem esperar (Enter = "\\n", Esc = "\\033")."""
        if select.select([self.fd], [], [], 0)[0]:
            return read_key(os.read(self.fd, 64))
        return ''

    def flush(self):
        """Joga fora o que foi digitado antes do passo atual."""
        if self.saved:
            try:
                termios.tcflush(self.fd, termios.TCIFLUSH)
            except termios.error:
                pass

    def restore(self):
        self.write('\033[0m\033[2J\033[H\033[?25h')
        if self.saved:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)

    # A calibracao de eixos no terminal (Setup em texto) ----------------

    def axes(self, state):
        """Os eixos em barras, os botoes e o passo, em 40 colunas ou mais
        (o console de 320x240 tem 40x30). Ate 10 quadros por segundo."""
        now = time.monotonic()
        if now - getattr(self, 'drawn', 0) < 0.1 and state['step'] == getattr(self, 'last_step', None):
            return
        self.drawn, self.last_step = now, state['step']
        cols = max(30, self.cols)
        out = ['\033[?25l\033[0m\033[2J']

        def put(row, col, text):
            out.append('\033[%d;%dH%s\033[0m' % (row, col, text))

        put(1, 2, '\033[1;35m' + ('Calibrate: ' + state['name'])[:cols - 2])
        row = 2
        for line in wrap_text(state['text'], cols - 2):
            put(row, 2, '\033[1;37m' + line)
            row += 1
        row += 1
        width = cols - 4
        if state['step'] == 'result':
            put(row, 2, '\033[1;37mNew calibration (min..max, dead zone):')
            for label, lo, hi, flat in state['result']:
                row += 1
                put(row, 4, '%-10s %6d..%-6d %d' % (label[:10], lo, hi, flat))
            row += 2
        compact = len(state['axes']) > 3
        for axis in state['axes']:
            if row > self.rows - 6:
                break
            info = axis_text(axis, state['degrees'])
            put(row, 3, '\033[1;36m' + axis['label'])
            put(row, max(3, cols - len(info)), '\033[1;37m' + info)
            line = ''.join('\033[%sm%s' % cell for cell in bar_cells(axis['kind'], axis['frac'], axis['seen'], width))
            for r in range(1 if compact else 2):
                put(row + 1 + r, 3, line)
            row += 2 if compact else 3
        if state['buttons'] and state['step'] == 'buttons':
            # Os numeros dos botoes (verdes depois de testados), em ate duas
            # linhas de cols - 2.
            lines, line, used = [], [], 0
            for i, (pressed, tested) in enumerate(state['buttons']):
                color = '30;42' if pressed else '1;32' if tested else '1;30'
                n = str(i + 1)
                if line and used + 1 + len(n) > cols - 2:
                    lines.append(line)
                    line, used = [], 0
                used += len(n) + (1 if line else 0)
                line.append('\033[%sm%s\033[0m' % (color, n))
            lines.append(line)
            for k, marks in enumerate(lines[-2:]):
                put(self.rows - 3 + k, 2, ' '.join(marks))
        if state['step'] == 'ff' and state['ff']:
            names = ' '.join(('\033[30;43m%s\033[0m' if i == state['ff']['phase'] else '\033[1;30m%s\033[0m')
                             % ff_label(p, m) for i, (p, m) in enumerate(state['ff']['phases']))
            put(self.rows - 4, 2, names)
        if state['hold'] > 0:
            n = round(state['hold'] * (cols - 10))
            put(self.rows - 1, 2, '\033[1;33mHOLD \033[30;43m%s\033[0m' % (' ' * n))
        put(self.rows, 2, '\033[1;30m' + '   '.join('%s: %s' % k for k in state['keys']))
        self.write(''.join(out))


def wrap_text(lines, width):
    out = []
    for line in lines:
        words, cur = line.split(), ''
        for word in words:
            if cur and len(cur) + 1 + len(word) > width:
                out.append(cur)
                cur = word
            else:
                cur = (cur + ' ' + word).strip()
        out.append(cur)
    return out


def axis_text(axis, degrees):
    """O valor de um eixo para a tela: graus do volante, % do pedal."""
    f = axis['frac']
    if axis['kind'] == 'wheel':
        side = 'LEFT' if f < -0.01 else 'RIGHT' if f > 0.01 else 'CENTER'
        if degrees:
            return '%d° %s' % (round(abs(f) * degrees / 2), side)
        return '%d%% %s' % (round(abs(f) * 100), side)
    if axis['kind'] == 'pedal':
        return '%d%%' % round(f * 100)
    return '%+d%%' % round(f * 100)


def ff_label(phase, moved):
    if phase == 'shake':
        return 'SHAKE'
    return {-1: 'PULL <', 1: 'PULL >'}.get(moved, 'PULL')


def wheel_degrees(path):
    """O giro total do volante, de batente a batente (o `range` do driver
    Logitech), ou None."""
    try:
        with open('/sys/class/input/%s/device/device/range' % os.path.basename(path)) as f:
            return int(f.read().split()[0])
    except (OSError, ValueError, IndexError):
        return None


def make_axes_screen():
    """A tela da calibracao de eixos: a da interface grafica do Setup
    (fliperos-setup/gui/wheelscreen.py) quando o Setup esta nela, senao o
    terminal."""
    if os.environ.get('FLIPEROS_CALIBRATE_GUI') == '1':
        sys.path.insert(0, os.environ.get('FLIPEROS_GUI_DIR', '/usr/local/lib/fliperos-setup/gui'))
        try:
