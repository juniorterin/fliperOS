def make_screen():
    """A tela da calibracao da pistola: a da interface grafica do Setup
    (fliperos-setup/gui/gunscreen.py) quando o Setup esta nela
    (FLIPEROS_CALIBRATE_GUI=1), senao o terminal."""
    if os.environ.get('FLIPEROS_CALIBRATE_GUI') == '1':
