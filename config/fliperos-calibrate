class Cancelled(Exception):
    pass


def white(screen, *lines):
    """Tela toda branca (o fundo 7 da paleta) com o texto em cima."""
    if hasattr(screen, 'white'):
        return screen.white(*lines)
    screen.write('\033[?25l\033[30;47m\033[2J')
    for i, line in enumerate(lines):
        screen.at(2 + i, max(1, (screen.cols - len(line)) // 2 + 1), line)


def draw_target(screen, row, col):
    if hasattr(screen, 'draw_target'):
        return screen.draw_target(row, col)
    # A mira e a celula branca do meio: o sensor precisa de luz onde aponta.
    screen.write('\033[1;31;47m')
    screen.at(row, col, '+')
    screen.at(row, col - 3, '>>')
    screen.at(row, col + 2, '<<')
    screen.at(row - 1, col, 'v')
    screen.at(row + 1, col, '^')
    screen.write('\033[0;30;47m')


def drain(dev):
    """Joga fora os eventos na fila: tiros dados antes do alvo aparecer (o
    segundo de um tiro duplo caia no alvo seguinte, na mira do anterior)."""
    while dev.events():
        pass


def gun_param(name, value=None):
    """Le (ou escreve) um parametro do driver guncon2; None se ele nao tem."""
    path = os.path.join(GUNCON_PARAMS, name)
    try:
        if value is None:
            with open(path) as f:
                return f.read().strip()
        with open(path, 'w') as f:
            f.write(str(value))
        return str(value)
    except OSError:
        return None


def open_range(path):
    """Abre a faixa da pistola e tira a espera do flash (a tela ja e branca)
    durante a calibracao, para o driver deixar passar todo tiro. Devolve a
    funcao que poe tudo como estava."""
    dev = Device(path, write=True)
    saved = {axis: dev.absinfo(axis)[1:3] for axis in (ABS_X, ABS_Y)}
    dev.set_abs(ABS_X, *OPEN_X)
    dev.set_abs(ABS_Y, *OPEN_Y)
    flash = gun_param('flash_ms')
    if flash is not None:
        gun_param('flash_ms', 0)

    def restore():
        try:
            for axis, (lo, hi) in saved.items():
                dev.set_abs(axis, lo, hi)
        finally:
            dev.close()
            if flash is not None:
                gun_param('flash_ms', flash)

    return restore


def shoot(screen, gun, need):
    """Coordenadas cruas de `need` tiros (gatilho). Esc ou B cancela."""
    drain(gun)
    x, y = gun.absinfo(ABS_X)[0], gun.absinfo(ABS_Y)[0]
    shots = []
    while len(shots) < need:
        if screen.key() == '\033':
            raise Cancelled()
        if not select.select([gun.fd], [], [], 0.05)[0]:
            continue
        for etype, code, value in gun.events():
            if etype == EV_ABS and code == ABS_X:
                x = value
            elif etype == EV_ABS and code == ABS_Y:
                y = value
            elif etype == EV_KEY and value == 1 and code in (BTN_B, BTN_MIDDLE, BTN_SELECT):
                raise Cancelled()
            elif etype == EV_KEY and value == 1 and code == BTN_LEFT:
                if not gun_sees(x, y):
                    screen.at(screen.rows, 2, 'The gun did not see the screen: aim at the white area.   ')
                    continue
                shots.append((x, y))
                screen.at(screen.rows, 2, 'Shot %d of %d: x=%d y=%d%s' % (len(shots), need, x, y, ' ' * 30))
    return shots


def calibrate_guncon(path, label=''):
    gun = Device(path)
    reopen = open_range(path)
    try:
        screen = make_screen()
    except BaseException:
        reopen()
        gun.close()
        raise
    title = 'GunCon 2 calibration' + (' (%s)' % label if label else '')
    try:
        # Alvos a 15% e 85% da tela, longe da borda, onde o tubo distorce.
        t1 = (max(3, round(screen.rows * 0.15)), max(5, round(screen.cols * 0.15)))
        t2 = (min(screen.rows - 2, round(screen.rows * 0.85)), min(screen.cols - 4, round(screen.cols * 0.85)))
        points = []
        for target, where in ((t1, 'top left'), (t2, 'bottom right')):
            white(screen, '%s: aim at the + of the %s target' % (title, where),
                  'and pull the trigger 3 times. B or Esc cancels.')
            draw_target(screen, *target)
            shots = shoot(screen, gun, 3)
            points.append((median([s[0] for s in shots]), median([s[1] for s in shots])))
            time.sleep(0.3)
        fx = [(c - 0.5) / screen.cols for _, c in (t1, t2)]
        fy = [(r - 0.5) / screen.rows for r, _ in (t1, t2)]
        xr = guncon_range(points[0][0], points[1][0], fx[0], fx[1])
        yr = guncon_range(points[0][1], points[1][1], fy[0], fy[1])
        if not plausible_range(xr, yr):
            white(screen, 'The two targets read almost the same position.',
                  'Nothing was saved. Press Enter.')
            drain(gun)
            wait_enter(screen, gun)
            return 1
        # Conferencia no centro, ja com a faixa nova.
        center = (screen.rows // 2, screen.cols // 2)
        white(screen, 'Check: aim at the + of the center target and shoot once.')
        draw_target(screen, *center)
        cx, cy = shoot(screen, gun, 1)[0]
        hit = (100 * (cx - xr[0]) / (xr[1] - xr[0]), 100 * (cy - yr[0]) / (yr[1] - yr[0]))
        want = (100 * (center[1] - 0.5) / screen.cols, 100 * (center[0] - 0.5) / screen.rows)
        white(screen, 'Center shot at %.0f%% x %.0f%% (target %.0f%% x %.0f%%).' % (hit + want),
              'Range: X %d to %d, Y %d to %d.' % (xr + yr), '',
              'Trigger or Enter saves. B or Esc discards.')
        if hasattr(screen, 'show_result'):
            screen.show_result(hit, want)
        time.sleep(0.3)
        drain(gun)
        if not confirm(screen, gun):
            return 1
        phys = gun.phys
    except Cancelled:
        return 1
    finally:
        reopen()
        screen.restore()
        gun.close()
    # A faixa desta pistola (pela porta USB) e a geral, que vale para as que
    # ainda nao foram calibradas (o mesmo tubo, em geral a mesma faixa).
    write_guncon_conf(gun_conf_path(GUNCON_CONF, phys), xr, yr)
    write_guncon_conf(GUNCON_CONF, xr, yr)
    apply_guncon(path, xr, yr)
    return 0


def wait_enter(screen, dev):
    while True:
        if screen.key() in ('\n', '\r', '\033'):
            return
        if select.select([dev.fd], [], [], 0.05)[0]:
            if any(t == EV_KEY and v == 1 for t, _, v in dev.events()):
                return


def confirm(screen, dev):
    while True:
        k = screen.key()
        if k in ('\n', '\r'):
            return True
        if k == '\033':
            return False
        if select.select([dev.fd], [], [], 0.05)[0]:
            for t, code, v in dev.events():
                if t == EV_KEY and v == 1:
                    if code in (BTN_B, BTN_MIDDLE, BTN_SELECT):
                        return False
                    return True


def apply_guncon(path, xr, yr):
    dev = Device(path, write=True)
    try:
        dev.set_abs(ABS_X, *xr)
        dev.set_abs(ABS_Y, *yr)
    finally:
        dev.close()


class AxesSession:
    """A calibracao de eixos (volante, pedais, analogico) que as duas telas
    desenham, a do terminal (Screen.axes) e a grafica (wheelscreen.py): os
    eixos ao vivo, o curso visto, os botoes testados e o segurar para
    avancar."""

    STEPS = {
        'move': (['Turn the wheel lock to lock and push each pedal all the way.'],
                 ['Move every axis to its limits: sticks all around, triggers and pedals all the way.'],
                 [('HOLD A BUTTON', 'NEXT'), ('ESC', 'CANCEL')]),
        'rest': (['Now release the pedals. The wheel can stay where it is.'],
                 ['Now let go of everything: sticks, triggers and pedals at rest.'],
                 [('HOLD A BUTTON', 'NEXT'), ('ESC', 'CANCEL')]),
        'result': (['Hold a button to save this calibration.'], ['Hold a button to save this calibration.'],
                   [('HOLD', 'SAVE'), ('ESC', 'DISCARD')]),
        'nomove': (['No axis moved enough. Nothing was saved.'], ['No axis moved enough. Nothing was saved.'],
                   [('HOLD', 'BACK')]),
        'buttons': (['Saved! Now press every button: each one lights up where it is.'],
                    ['Saved! Now press every button: each one lights up where it is.'],
                    [('HOLD A BUTTON', 'NEXT'), ('ESC', 'DONE')]),
        'ff': (['Force feedback test: hold the wheel lightly.'],
               ['Vibration test.'],
               [('TAP', 'AGAIN'), ('HOLD', 'DONE')]),
    }

    def __init__(self, dev):
        self.dev = dev
        self.name = dev.name.decode(errors='replace')
        self.wheel = dev.is_wheel()
        self.axes = dev.analog_axes()
        self.info = {a: dev.absinfo(a) for a in self.axes}
        self.cur = {a: self.info[a][0] for a in self.axes}
        self.seen = {a: [self.cur[a], self.cur[a]] for a in self.axes}
        self.kind, self.rest_end = {}, {}
        for a in self.axes:
            value, lo, hi = self.info[a][:3]
            self.kind[a] = axis_kind(a, lo, hi, value, self.wheel)
            self.rest_end[a] = lo if value - lo <= hi - value else hi
        self.buttons = dev.buttons()
        self.pressed = {}
        self.tested = set()
        self.hat = [0, 0] if ABS_HAT0X in dev.abs else None
        self.armed = True
        self.degrees = wheel_degrees(dev.path) if self.wheel else None
        self.layout = button_layout(dev.ident, dev.name, self.buttons, self.wheel)

    def pump(self, timeout):
        """Le o controle. 'next' quando um botao ficou segurado HOLD s, 'tap'
        num toque curto. Depois de um 'next', so vale outro com tudo solto."""
        out = None
        if select.select([self.dev.fd], [], [], timeout)[0]:
            for etype, code, value in self.dev.events():
                if etype == EV_ABS and code in self.cur:
                    self.cur[code] = value
                    self.seen[code] = [min(self.seen[code][0], value), max(self.seen[code][1], value)]
                elif etype == EV_ABS and self.hat is not None and code in (ABS_HAT0X, ABS_HAT0Y):
                    self.hat[code - ABS_HAT0X] = value
                elif etype == EV_KEY and code in self.buttons:
                    if value == 1:
                        self.pressed[code] = time.monotonic()
                        self.tested.add(code)
                    elif value == 0:
                        start = self.pressed.pop(code, None)
                        if start is not None and self.armed and time.monotonic() - start < HOLD:
                            out = 'tap'
        if not self.pressed:
            self.armed = True
        if self.armed and self.hold() >= 1:
            self.armed = False
            out = 'next'
        return out

    def hold(self):
        if not self.pressed or not self.armed:
            return 0.0
        return min(1.0, (time.monotonic() - min(self.pressed.values())) / HOLD)

    def fraction(self, a, value=None):
        lo, hi = self.info[a][1:3]
        return axis_fraction(self.kind[a], self.cur[a] if value is None else value, lo, hi, self.rest_end[a])

    def result(self):
        out = {}
        for a in self.axes:
            cal = axis_calibration(self.seen[a][0], self.seen[a][1], self.cur[a], self.info[a][1],
                                   self.info[a][2], wheel=self.kind[a] == 'wheel')
            if cal:
                out[a] = cal
        return out

    def state(self, step, result=None, ff=None):
        text, other, keys = self.STEPS[step]
        return {
            'name': self.name, 'step': step, 'wheel': self.wheel, 'degrees': self.degrees,
            'text': text if self.wheel else other, 'keys': keys, 'hold': self.hold(),
            'axes': [{'code': a, 'kind': self.kind[a], 'label': axis_label(self.kind[a], a),
                      'frac': self.fraction(a),
                      'seen': tuple(sorted((self.fraction(a, self.seen[a][0]), self.fraction(a, self.seen[a][1]))))}
                     for a in self.axes],
            'buttons': [(code in self.pressed, code in self.tested) for code in self.buttons],
            'layout': {'family': self.layout[0], 'symbols': self.layout[1], 'slots': self.layout[2]},
            'hat': tuple(self.hat) if self.hat is not None else None,
            'result': [(axis_label(self.kind[a], a), lo, hi, flat) for a, (lo, hi, flat) in sorted((result or {}).items())],
            'ff': ff,
        }


def run_step(screen, session, step, result=None):
    """Um passo da calibracao: 'next' (segurou um botao, ou Enter) ou
    'cancel' (Esc no teclado)."""
    screen.flush()
    session.armed = not session.pressed
    while True:
        k = screen.key()
        if k == '\033':
            return 'cancel'
        if k in ('\n', '\r'):
            return 'next'
        if session.pump(1 / 30) == 'next':
            return 'next'
        screen.axes(session.state(step, result))


def run_ff(screen, session):
    """O teste do force feedback: puxa para um lado, para o outro e treme
    (num joypad, so a vibracao). Um toque repete; segurar ou Esc termina."""
    dev = session.dev
    kinds = dev.ff_kinds()
    phases = [p for p in FF_TEST if p[0] in kinds]
    if not phases:
        return
    moved = [0] * len(phases)
    x = ABS_X if ABS_X in session.cur else None
    span = (session.info[x][2] - session.info[x][1]) if x is not None else 1
    current = {'i': -1, 'eid': None, 'until': 0, 'x0': 0}

    def start(i):
        name, effect, ms = phases[i]
        current.update(i=i, until=time.monotonic() + ms / 1000, x0=session.cur.get(x, 0))
        try:
            current['eid'] = dev.ff_play(ff_effect(*effect) if effect else dev.shake_effect(ms))
        except OSError as error:
            print('fliperos-calibrate: force feedback failed (%s)' % error, file=sys.stderr)
            current['eid'] = None

    def stop():
        if current['eid'] is not None:
            dev.ff_stop(current['eid'])
            current['eid'] = None
        i = current['i']
        if i >= 0 and phases[i][0] == 'pull' and x is not None:
            delta = session.cur[x] - current['x0']
            moved[i] = (delta > 0) - (delta < 0) if abs(delta) > span * 0.01 else 0

    screen.flush()
    session.armed = not session.pressed
    start(0)
    try:
        while True:
            k = screen.key()
            if k in ('\033', '\n', '\r'):
                return
            event = session.pump(1 / 30)
            if event == 'next':
                return
            if current['i'] >= 0 and time.monotonic() >= current['until']:
                stop()
                current['i'] = current['i'] + 1 if current['i'] + 1 < len(phases) else -1
                if current['i'] >= 0:
                    start(current['i'])
            elif event == 'tap' and current['i'] < 0:
                start(0)
            screen.axes(session.state('ff', ff={'phase': current['i'],
                                                'phases': [(p[0], m) for p, m in zip(phases, moved)]}))
    finally:
        stop()


def calibrate_axes(path):
    dev = Device(path, write=True)
    try:
        session = AxesSession(dev)
        screen = make_axes_screen()
    except BaseException:
        dev.close()
        raise
    try:
        for step in ('move', 'rest'):
            if run_step(screen, session, step) != 'next':
                return 1
        result = session.result()
        if not result:
            run_step(screen, session, 'nomove')
            return 1
        if run_step(screen, session, 'result', result) != 'next':
            return 1
        write_axes_conf(AXES_CONF, dev.ident, session.name, result)
        apply(path)
        # Ja salvo: os botoes e o force feedback sao so testes.
        if session.buttons and run_step(screen, session, 'buttons') != 'next':
            return 0
        run_ff(screen, session)
        return 0
    finally:
        screen.restore()
        dev.close()


def apply(path):
    """Reaplica a calibracao salva do controle (regra do udev)."""
    try:
        dev = Device(path, write=True)
    except OSError:
        return 0
    try:
        for axis, (lo, hi, flat) in read_axes_conf(AXES_CONF).get(dev.ident, {}).items():
            if axis in dev.abs:
                dev.set_abs(axis, lo, hi, flat)
    finally:
        dev.close()
    return 0


def pick_trigger(out_path, paths, timeout=60):
    """Qual destas pistolas deu o tiro? Escreve o caminho dela em out_path
    (o Setup roda isto com o video solto, sem como ler a saida). Esc cancela."""
    guns = []
    for path in paths:
        try:
            guns.append(Device(path))
        except OSError:
            continue
    screen = Screen()
    try:
        screen.write('\033[0m\033[2J\033[H')
        screen.at(2, 2, 'Pull the trigger of the gun for %s. Esc cancels.' % (os.environ.get('FLIPEROS_GUN_LABEL') or 'this player'))
        end = time.monotonic() + timeout
        while time.monotonic() < end:
            if screen.key() == '\033':
                return 1
            ready = select.select([g.fd for g in guns], [], [], 0.05)[0]
            for gun in guns:
                if gun.fd not in ready:
                    continue
                if any(t == EV_KEY and v == 1 and c == BTN_LEFT for t, c, v in gun.events()):
                    with open(out_path, 'w') as f:
                        f.write(gun.path + '\n')
                    return 0
        return 1
    finally:
        screen.restore()
        for gun in guns:
            gun.close()


def main(argv):
    if len(argv) >= 4 and argv[1] == 'trigger':
        return pick_trigger(argv[2], argv[3:])
    if len(argv) >= 2 and argv[1] == 'list':
        for dev in devices():
            kind = 'gun' if dev.is_gun() else 'axes' if dev.has_axes() else ''
            if kind and (len(argv) < 3 or argv[2] == kind):
                print('%s|%s|%s' % (dev.path, dev.name.decode(errors='replace'), kind))
            dev.close()
        return 0
    if len(argv) in (3, 4) and argv[1] == 'guncon2':
        return calibrate_guncon(argv[2], argv[3] if len(argv) == 4 else '')
    if len(argv) == 3 and argv[1] == 'axes':
        return calibrate_axes(argv[2])
    if len(argv) == 3 and argv[1] == 'apply':
        return apply(argv[2])
    print(__doc__.split('\n\n')[1], file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv))
