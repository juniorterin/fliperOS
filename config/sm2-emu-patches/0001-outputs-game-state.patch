+            output.live  = true;
+            output.value = output.on_frames > 0 ? 1 : 0;
+            if (output.on_frames > 0) {
+                if (--output.on_frames == 0) {
+                    output.off_frames = 1;
+                }
+            } else if (output.off_frames > 0) {
+                --output.off_frames;
+            }
+            break;
+        }
+        }
+    }
