#!/usr/bin/env bash
# Abre um programa num Xorg so para ele, num modo de video criado pelo
# Switchres (fliperos-x11-client) no monitor escolhido no Setup:
#
#   fliperos-x11-run [--mode LARGURAxALTURA@HZ] programa [argumentos]
#
# Sem --mode, o modo vem de /etc/fliperos/emulator-modes.conf (um para
# monitor de 15 kHz, outro para 25/31 kHz e LCD) ou, fora da tabela,
# 320x240@60. docs/wiki/Emulators.md, "Running a program at 640x240".
set -euo pipefail
MODES=${FLIPEROS_MODES:-/etc/fliperos/emulator-modes.conf}
CONF=${FLIPEROS_CONF:-/etc/fliperos/fliperos.conf}

mode=""
if [[ ${1:-} == --mode ]]; then
  mode=${2:-}
  shift 2 || true
fi
[[ $# -gt 0 ]] || { echo "Usage: fliperos-x11-run [--mode 640x240@60] program [arguments]" >&2; exit 2; }
[[ -z "${DISPLAY:-}" ]] || { echo "Run on the console (TTY), outside an X session." >&2; exit 2; }
command -v "$1" > /dev/null || { echo "Nao instalado: $1" >&2; exit 127; }
name=$(basename -- "$1")

if [[ -z $mode ]]; then
  column=3
  # O setup grava "15k" (e versoes antigas "15"). Comparar so com "15" fazia
  # todo emulador cair na coluna de 31 kHz: 640x480, entrelacado no tubo.
  [[ $(sed -n 's/^frequency=//p' "$CONF" 2> /dev/null) == 15* ]] && column=2
  mode=$(awk -v p="$name" -v c="$column" '!/^[[:space:]]*#/ && $1 == p { print $c; exit }' "$MODES" 2> /dev/null)
fi
[[ -n $mode ]] || mode=320x240@60
if [[ ! $mode =~ ^([0-9]+)x([0-9]+)@([0-9.]+)$ ]]; then
  echo "Invalid mode: $mode (use WIDTHxHEIGHT@HZ, e.g. 640x240@60)" >&2
  exit 2
fi
export FLIPEROS_RES_W=${BASH_REMATCH[1]} FLIPEROS_RES_H=${BASH_REMATCH[2]} FLIPEROS_RES_HZ=${BASH_REMATCH[3]}

# Tela cheia e imagem esticada: num modo como 640x240 (tela 8:3 em pixels,
# que o tubo mostra em 4:3) um emulador que "mantem 4:3" usaria so metade da
# largura. stretch e quanto esticar na horizontal para o 4:3 preencher o modo.
stretch=$((300 * FLIPEROS_RES_W / (4 * FLIPEROS_RES_H)))
case $name in
  flycast)
    ((stretch < 100)) && stretch=100
    ((stretch > 250)) && stretch=250
    # A BIOS em ~/bios/dc (fliperos-roms): o emu.cfg tem o Dreamcast.BiosPath,
    # e a variavel vale tambem num emu.cfg recriado pelo Flycast.
    export FLYCAST_BIOS_PATH="${FLYCAST_BIOS_PATH:+$FLYCAST_BIOS_PATH:}$HOME/bios/dc"
    set -- "$1" -config "window:fullscreen=yes,config:rend.ScreenStretching=$stretch" "${@:2}"
    ;;
  dolphin-emu)
    set -- "$1" -C Dolphin.Display.Fullscreen=True -C GFX.Settings.AspectRatio=3 "${@:2}"
    ;;
  pcsx2)
    # Sem PCSX2.ini, o de partida do FliperOS (/etc/fliperos/pcsx2.ini): com
    # o SettingsVersion dele o PCSX2 o aceita e completa o resto. Em todo
    # caso, a cada abertura: sem o assistente, tela cheia no Big Picture,
    # sem o ponteiro do mouse, a BIOS em ~/bios/ps2 e a imagem esticada.
    ini="$HOME/.config/PCSX2/inis/PCSX2.ini"
    iniset=${FLIPEROS_INI_SET:-/opt/fliperos/bin/fliperos-ini-set}
    [[ -f $ini ]] || install -Dm600 "${FLIPEROS_PCSX2_INI:-/etc/fliperos/pcsx2.ini}" "$ini" 2> /dev/null || true
    if [[ -f $ini ]]; then
      "$iniset" "$ini" EmuCore/GS AspectRatio Stretch
      "$iniset" "$ini" UI SetupWizardIncomplete false
      "$iniset" "$ini" UI StartFullscreen true
      "$iniset" "$ini" UI StartBigPictureMode true
      "$iniset" "$ini" UI HideMouseCursor true
      "$iniset" "$ini" Folders Bios "$HOME/bios/ps2"
      # Lista de jogos em ~/roms/ps2, se a pessoa ainda nao escolheu pastas.
      grep -q '^RecursivePaths' "$ini" ||
        "$iniset" "$ini" GameList RecursivePaths /home/fliperos/roms/ps2
      # Os controles pelo SDL, Pad1 e Pad2 nos dois primeiros: o painel ja
      # chega como fight stick (o mapeamento do Setup > Joysticks > Button
      # mapping no gamecontrollerdb), entao X Y RB / A B RT = Quadrado
      # Triangulo R1 / X Bola R2. So enquanto nada estiver no SDL: um ajuste
      # feito no proprio PCSX2 fica.
      if ! grep -q 'SDL-[0-9]/' "$ini"; then
        "$iniset" "$ini" InputSources SDL true
        for pad in 1 2; do
          for kv in Type=DualShock2 Up=DPadUp Down=DPadDown Left=DPadLeft Right=DPadRight Cross=FaceSouth \
            Circle=FaceEast Square=FaceWest Triangle=FaceNorth L1=LeftShoulder R1=RightShoulder L2=+LeftTrigger \
            R2=+RightTrigger Start=Start Select=Back; do
            value=${kv#*=}
            [[ ${kv%%=*} == Type ]] || value="SDL-$((pad - 1))/$value"
            "$iniset" "$ini" "Pad$pad" "${kv%%=*}" "$value"
          done
        done
      fi
      # O direcional do painel tambem no analogico esquerdo: jogo de corrida
      # (NFS Underground 2) so vira por ele. Enquanto o analogico estiver
      # vazio ou nas teclas padrao do PCSX2 (W A S D).
      for pad in 1 2; do
        for kv in LUp=DPadUp LDown=DPadDown LLeft=DPadLeft LRight=DPadRight; do
          value=$(awk -v s="[Pad$pad]" -v k="${kv%%=*}" '/^\[/ { in_pad = ($0 == s) }
            in_pad && $1 == k && $2 == "=" { print $3; exit }' "$ini")
          if [[ -z $value || $value == Keyboard/* ]]; then
            "$iniset" "$ini" "Pad$pad" "${kv%%=*}" "SDL-$((pad - 1))/${kv#*=}"
          fi
        done
      done
    fi
    set -- "$1" -fullscreen "${@:2}"
    # O driver OpenGL do Mesa numa thread propria: a thread GS do PCSX2 e o
    # gargalo num processador fraco (NFS Underground 2 no i3 540: 28 -> 35
    # quadros/s so com isso).
    export mesa_glthread="${mesa_glthread:-true}"
    ;;
  hypseus | singe)
    # O Hypseus le o jogo e o player primeiro ("hypseus lair vldp ..."); as
    # opcoes vao no fim. Sem -x/-y ele abriria em 640x480, e sem
    # -ignore_aspect_ratio manteria o 4:3 do video, com faixas pretas no
    # 640x240 (o esticado de 200% dos outros).
    set -- "$@" -fullscreen -x "$FLIPEROS_RES_W" -y "$FLIPEROS_RES_H" -ignore_aspect_ratio
    ;;
  supermodel)
    # Com ~/.config/supermodel (criado na primeira abertura) ele procura ali
    # o Games.xml e o Music.xml, e os Assets em ~/.local/share/supermodel; o
    # build os deixa em /usr/local/share/supermodel. Sem o Games.xml nenhuma
    # ROM e reconhecida ("No complete Model 3 games found").
    share=${FLIPEROS_SUPERMODEL_SHARE:-/usr/local/share/supermodel}
    mkdir -p "$HOME/.config/supermodel/Config" "$HOME/.local/share/supermodel"
    for f in Config/Games.xml Config/Music.xml; do
      [[ -e $HOME/.config/supermodel/$f || ! -e $share/$f ]] || ln -s "$share/$f" "$HOME/.config/supermodel/$f"
    done
    [[ -e $HOME/.local/share/supermodel/Assets || ! -d $share/Assets ]] ||
      ln -s "$share/Assets" "$HOME/.local/share/supermodel/Assets"
    # Sem -res ele abre em 496x384 (o nativo do Model 3), que no 15 kHz so
    # existe entrelacado; aqui ocupa o modo da tabela, esticado para o 4:3.
    # O PowerPC emulado e o gargalo num processador fraco (Fighting Vipers 2
    # no i3 540: 35 quadros/s a 166 MHz, 59 a 75 MHz): nos jogos de stepping
    # 1.5 e 2.x (100 e 166 MHz) ele roda a FLIPEROS_SUPERMODEL_PPC; os de 1.0
    # ja sao 66 MHz.
    ppc=()
    game=$(basename -- "${*: -1}" .zip)
    step=$(awk -v g="<game name=\"$game\"" 'index($0, g) { found = 1 }
      found && /<stepping>/ { gsub(/.*<stepping>|<\/stepping>.*/, ""); print; exit }' \
      "$share/Config/Games.xml" 2> /dev/null) || step=""
    if [[ $step == 1.5 || $step == 2.* ]] && [[ ${FLIPEROS_SUPERMODEL_PPC:-75} != 0 ]]; then
      ppc=(-ppc-frequency="${FLIPEROS_SUPERMODEL_PPC:-75}")
    fi
    set -- "$1" -fullscreen -res="$FLIPEROS_RES_W,$FLIPEROS_RES_H" -stretch "${ppc[@]}" "${@:2}"
    ;;
  fliperos-model2 | sm2-emu)
    # 640x240 tem pixel mais largo que o 4:3: no tubo a imagem so preenche
    # com stretch. So na primeira vez; o que a pessoa gravar no F10 fica.
    cfg=${XDG_CONFIG_HOME:-$HOME/.config}/sm2-emu
    mkdir -p "$cfg"
    if [[ ! -f $cfg/sm2-emu.ini ]] && ((FLIPEROS_RES_H * 4 < FLIPEROS_RES_W * 3)); then
      printf 'aspect_mode = stretch\n' > "$cfg/sm2-emu.ini"
    fi
    set -- "$1" --fullscreen "${@:2}"
    ;;
esac

# SDL no X: chamado de dentro do fliperos-kms-run (o GroovyMAME, que se abre
# no X sozinho), herdaria o kmsdrm de la.
export SDL_VIDEODRIVER=x11
# Audio SDL direto no ALSA (o FliperOS nao tem servidor de som).
export SDL_AUDIODRIVER="${SDL_AUDIODRIVER:-alsa}"
# Mapeamentos de controle do SDL (fliperos-rootfs.sh).
export SDL_GAMECONTROLLERCONFIG_FILE="${SDL_GAMECONTROLLERCONFIG_FILE:-/var/lib/fliperos/gamecontrollerdb.txt}"
# Sem terminal (chamado por um frontend), o tty falha: vale o vt1.
vt=$(tty 2> /dev/null) || vt=""
vt=${vt#/dev/tty}
[[ $vt =~ ^[0-9]+$ ]] || vt=1
# Cursor so para quem tem interface de mouse: Dolphin, Flycast e o Fightcade
# (a sala de jogos). Eles mesmos o escondem durante o
# jogo em tela cheia. O PCSX2 abre no Big Picture, que se usa pelo controle;
# os demais abrem direto no jogo.
cursor=(-nocursor)
case $name in
  dolphin-emu | flycast | fightcade) cursor=() ;;
esac
export FLIPEROS_X11_CURSOR=$((${#cursor[@]} == 0))
# A saida do X, do Switchres e do emulador vai para
# /opt/fliperos/logs/<programa>.log, nao para a tela; no modo debug (Setup >
# Debug mode) ela aparece. Sem como gravar o log, abre assim mesmo.
log="${FLIPEROS_LOGS:-/opt/fliperos/logs}/$name.log"
if [[ ! -f ${FLIPEROS_DEBUG_FLAG:-/etc/fliperos/debug} ]] && { : > "$log"; } 2> /dev/null; then
  exec xinit /opt/fliperos/bin/fliperos-x11-client "$@" -- :0 -nolisten tcp "${cursor[@]}" "vt$vt" -keeptty \
    >> "$log" 2>&1
fi
exec xinit /opt/fliperos/bin/fliperos-x11-client "$@" -- :0 -nolisten tcp "${cursor[@]}" "vt$vt" -keeptty
