#!/usr/bin/env bash
# Abre um emulador que so roda em X (PCSX2, Supermodel) num Xorg so para ele;
# o fliperos-x11-client pede ao Switchres o modo do jogo. A configuracao do
# monitor vem do /etc/X11/xorg.conf.d/10-fliperos.conf gerado pelo
# fliperos-setup.
set -euo pipefail
[[ $# -gt 0 ]] || { echo "Uso: fliperos-x11-run emulador [argumentos]" >&2; exit 2; }
[[ -z "${DISPLAY:-}" ]] || { echo "Execute no console (TTY), fora de uma sessao X." >&2; exit 2; }
command -v "$1" > /dev/null || { echo "Emulador nao instalado: $1" >&2; exit 127; }
export FLIPEROS_RES_W="${FLIPEROS_RES_W:-320}" FLIPEROS_RES_H="${FLIPEROS_RES_H:-240}"
export FLIPEROS_RES_HZ="${FLIPEROS_RES_HZ:-60}"
vt=$(tty 2> /dev/null)
vt=${vt#/dev/tty}
[[ $vt =~ ^[0-9]+$ ]] || vt=1
exec xinit /opt/fliperos/bin/fliperos-x11-client "$@" -- :0 -nolisten tcp -nocursor "vt$vt" -keeptty
