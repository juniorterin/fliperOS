#!/usr/bin/env bash
# Abre um programa num Xorg so para ele, num modo de video criado pelo
# Switchres (fliperos-x11-client) no monitor escolhido no Setup:
#
#   fliperos-x11-run [--mode LARGURAxALTURA@HZ] programa [argumentos]
#
# Sem --mode, o modo vem de /etc/fliperos/emulator-modes.conf (um para
# monitor de 15 kHz, outro para 25/31 kHz e LCD) ou, fora da tabela,
# 320x240@60. docs/wiki/Emulators.md, "Running a program at 640x240".
set -euo pipefail
MODES=${FLIPEROS_MODES:-/etc/fliperos/emulator-modes.conf}
CONF=${FLIPEROS_CONF:-/etc/fliperos/fliperos.conf}

mode=""
if [[ ${1:-} == --mode ]]; then
  mode=${2:-}
  shift 2 || true
fi
[[ $# -gt 0 ]] || { echo "Usage: fliperos-x11-run [--mode 640x240@60] program [arguments]" >&2; exit 2; }
[[ -z "${DISPLAY:-}" ]] || { echo "Run on the console (TTY), outside an X session." >&2; exit 2; }
command -v "$1" > /dev/null || { echo "Not installed: $1" >&2; exit 127; }
name=$(basename -- "$1")
# O groovymame escolhe sozinho entre o KMS e o X (config/fliperos-groovymame):
# as linhas de frontend gravadas com "fliperos-x11-run groovymame" vao para
# ele, que volta para ca (com FLIPEROS_GROOVYMAME_X11) so quando fica no X.
if [[ $name == groovymame && -z $mode && -z ${FLIPEROS_GROOVYMAME_X11:-} ]]; then
  exec "$@"
fi
# O jogo da linha de comando no marquee do Pixelcade (config/fliperos-pixelcade;
# sem o Pixelcade instalado, nada). Em segundo plano: a abertura nao espera.
pixelcade=${FLIPEROS_PIXELCADE:-/opt/fliperos/bin/fliperos-pixelcade}
[[ -x $pixelcade ]] && { "$pixelcade" launch "$@" < /dev/null > /dev/null 2>&1 & }
# As saidas do jogo para placas e LEDs (config/fliperos-outputs; sem o
# Hook Of The Reaper e o LEDSpicer instalados, nada).
outputs=${FLIPEROS_OUTPUTS:-/opt/fliperos/bin/fliperos-outputs}
[[ -x $outputs ]] && { "$outputs" launch "$@" < /dev/null > /dev/null 2>&1 & }
# As pistolas de luz ligadas (config/fliperos-lightgun): com uma, nenhum
# emulador desenha mira nem a seta do X por cima do jogo.
lightgun=${FLIPEROS_LIGHTGUN:-/opt/fliperos/bin/fliperos-lightgun}
guns=""
[[ -x $lightgun ]] && guns=$("$lightgun" guns 2> /dev/null)

if [[ -z $mode ]]; then
  column=3
  # O setup grava "15k" (e versoes antigas "15"). Comparar so com "15" fazia
  # todo emulador cair na coluna de 31 kHz: 640x480, entrelacado no tubo.
  [[ $(sed -n 's/^frequency=//p' "$CONF" 2> /dev/null) == 15* ]] && column=2
  # Setup > Video Setup > Interlaced hacks: com o entrelacado (filtro ou puro)
  # para o programa, o modo da coluna dos outros monitores (640x480, que no
  # tubo de 15 kHz sai entrelacado) em vez do 640x240.
  if ((column == 2)); then
    case $(awk -F= -v k="mode480_$name" '$1 == k { v = $2 } END { print v }' "$CONF" 2> /dev/null) in
      filter | pure) column=3 ;;
    esac
  fi
  mode=$(awk -v p="$name" -v c="$column" '!/^[[:space:]]*#/ && $1 == p { print $c; exit }' "$MODES" 2> /dev/null)
  # Um jogo PAL do DuckStation (pelo nome: "(Europe)", "(Germany)"...) no
  # tubo de 15 kHz abre a 50 Hz, como na TV PAL: os 50 quadros num modo de
  # 60 Hz repetiam um a cada cinco, e o que pisca a cada quadro (sombras,
  # transparencias) piscava fora de ritmo. As 288 linhas sao as do PAL.
  pal='\((Europe|Australia|Germany|France|Spain|Italy|UK|Netherlands|Sweden|Scandinavia|Austria|Switzerland|Denmark|Finland|Norway|Portugal|Belgium|Greece|Poland|E)[,)]'
  if [[ $name == duckstation && $column == 2 && $# -gt 1 && $(basename -- "${*: -1}") =~ $pal ]]; then
    mode=640x288@50
  fi
fi
[[ -n $mode ]] || mode=320x240@60
if [[ ! $mode =~ ^([0-9]+)x([0-9]+)@([0-9.]+)$ ]]; then
  echo "Invalid mode: $mode (use WIDTHxHEIGHT@HZ, e.g. 640x240@60)" >&2
  exit 2
fi
export FLIPEROS_RES_W=${BASH_REMATCH[1]} FLIPEROS_RES_H=${BASH_REMATCH[2]} FLIPEROS_RES_HZ=${BASH_REMATCH[3]}

# Placa sem dotclock baixo (Intel, NVIDIA: o Setup grava dotclock_min no
# switchres.ini). O Switchres dobraria a largura ate passar do minimo, e o
# modo sairia com uma largura que as contas abaixo nao conhecem (o Flycast
# estreito no meio, o Supermodel num pedaco da tela). Com a super resolucao
# (25 MHz) pede direto a largura dela, como o RetroArch: so a largura muda,
# linhas e frequencias ficam. Com o minimo de uma NVIDIA no nouveau (o degrau
# do grid, abaixo de 25) faz aqui a mesma dobra do Switchres, so quando o
# modo fica abaixo dele: 640x240 (13 MHz) fica, 320x240 (6,5 MHz) vira 640.
sr_ini=${FLIPEROS_SWITCHRES_INI:-/etc/switchres.ini}
read -r dotclock_min super_width < <(awk '$1 == "dotclock_min" { d = $2 } $1 == "super_width" { s = $2 }
  END { print d + 0, (s + 0 > 0 ? int(s) : 2560) }' "$sr_ini" 2> /dev/null) || dotclock_min=0
if awk -v d="${dotclock_min:-0}" 'BEGIN { exit !(d >= 25) }'; then
  ((FLIPEROS_RES_W < super_width)) && FLIPEROS_RES_W=$super_width
elif [[ ${dotclock_min:-0} != 0 ]]; then
  # O pixel clock do Switchres: a largura com uns 30% de apagamento, vezes a
  # frequencia horizontal do monitor (15,66 kHz no de 15 kHz).
  khz=$(awk -v f="$(sed -n 's/^frequency=//p' "$CONF" 2> /dev/null)" \
    'BEGIN { print (f ~ /^25/ ? 25 : f ~ /^31/ ? 31.5 : f == "lcd" ? 31.5 : 15.66) }')
  FLIPEROS_RES_W=$(awk -v w="$FLIPEROS_RES_W" -v d="$dotclock_min" -v k="$khz" \
    'BEGIN { while (w * 1.3 * k / 1000 <= d) w *= 2; print w }')
fi

# Tela cheia e imagem esticada: num modo como 640x240 (tela 8:3 em pixels,
# que o tubo mostra em 4:3) um emulador que "mantem 4:3" usaria so metade da
# largura. stretch e quanto esticar na horizontal para o 4:3 preencher o modo.
stretch=$((300 * FLIPEROS_RES_W / (4 * FLIPEROS_RES_H)))

# O filtro de flicker do entrelacado (config/fliperos-deflicker.c, que o
# fliperos-x11-client poe no LD_PRELOAD) acha o nivel do programa pelo nome
# da tabela (deflicker_NOME= no fliperos.conf), mesmo quando o comando e um
# script que abre outro binario.
export FLIPEROS_DEFLICKER_APP=$name

case $name in
  flycast)
    # O limite de 250 e so o do controle na interface do Flycast: a super
    # resolucao de 2560x240 pede 800.
    ((stretch < 100)) && stretch=100
    ((stretch > 1000)) && stretch=1000
    # A BIOS em ~/bios/dc (fliperos-roms): o emu.cfg tem o Dreamcast.BiosPath,
    # e a variavel vale tambem num emu.cfg recriado pelo Flycast.
    export FLYCAST_BIOS_PATH="${FLYCAST_BIOS_PATH:+$FLYCAST_BIOS_PATH:}$HOME/bios/dc"
    # As saidas do jogo pela rede, se ha quem as leia (config/fliperos-outputs).
    netout=""
    [[ -x $outputs ]] && "$outputs" installed && netout=",network:NetworkOutput=yes"
    # Com uma pistola, sem a mira das armas de luz (cor 0 nao desenha).
    nocross=""
    [[ -n $guns ]] && nocross=",config:rend.CrossHairColor1=0,config:rend.CrossHairColor2=0,config:rend.CrossHairColor3=0,config:rend.CrossHairColor4=0"
    set -- "$1" -config "window:fullscreen=yes,config:rend.ScreenStretching=$stretch$netout$nocross" "${@:2}"
    # Jogos de varias placas NAOMI (Games[].multiboard no naomi_roms.cpp do
    # Flycast: esquerda, centro e direita) com 3 monitores e os jogos de
    # varias telas ligados: uma placa em cada monitor (fliperos-multiscreen).
    game=$(basename -- "${*: -1}")
    game=${game%.*}
    case $game in
      alpilot | alpilotj | f355 | f355twin | f355twinp | f355twn2 | sstrkfgt | sstrkfgta)
        if grep -qE '^screens=[^,]+,[^,]+,' "$CONF" 2> /dev/null && ! grep -q '^multiscreen=off' "$CONF"; then
          export FLIPEROS_FLYCAST_STRETCH=$stretch
          set -- "${FLIPEROS_MULTISCREEN:-/opt/fliperos/bin/fliperos-multiscreen}" "$@"
        fi
        ;;
    esac
    ;;
  dolphin-emu)
    set -- "$1" -C Dolphin.Display.Fullscreen=True -C GFX.Settings.AspectRatio=3 "${@:2}"
    # O -C do AspectRatio sozinho nao estica (visto no gabinete com o 2609:
    # 4:3 no meio do 640x240, com o GFX.ini vazio); no GFX.ini, sim. O VSync
    # tambem: sem ele o jogo rasgava a imagem no tubo.
    iniset=${FLIPEROS_INI_SET:-/opt/fliperos/bin/fliperos-ini-set}
    gfx="$HOME/.config/dolphin-emu/GFX.ini"
    mkdir -p "${gfx%/*}" 2> /dev/null || true
    "$iniset" "$gfx" Settings AspectRatio 3 2> /dev/null || true
    "$iniset" "$gfx" Hardware VSync True 2> /dev/null || true
    # Sem os avisos do emulador na tela ao abrir o jogo.
    "$iniset" "${gfx%/*}/Dolphin.ini" Interface OnScreenDisplayMessages False 2> /dev/null || true
    ;;
  pcsx2 | pcsx2x6)
    # O pcsx2x6 e o fork dos arcades Namco System 246/256 (~/roms/namco2x6): o
    # mesmo PCSX2, com a pasta de dados propria dele
    # (~/.config/PCSX2x6, a que o fork usa sozinho), a BIOS e os cartoes por
    # placa; as configuracoes do PCSX2 oficial nao se misturam com as dele.
    datadir="$HOME/.config/PCSX2" biosdir="$HOME/bios/ps2" gamesdir=/home/fliperos/roms/ps2
    if [[ $1 == pcsx2x6 ]]; then
      # Uma pasta so de jogos, de BIOS e de dongles (namco2x6). A 256.BIN serve
      # as duas placas (o projeto diz que um jogo 246 roda com ela); a
      # COH-H31000.BIN, a da 246 de 2000, derrubou o Soul Calibur II com
      # "Jump to unaligned address", entao so entra se nao houver a 256.BIN.
      datadir="$HOME/.config/PCSX2x6" gamesdir=/home/fliperos/roms/namco2x6
      biosdir="$HOME/bios/namco2x6" savedir="$HOME/save/namco2x6"
      # A linha de um .acgame (gameid, subdir, platform...).
      acval() { sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$2" | head -n 1 | tr -d '\r'; }
      biosfile=256.BIN
      [[ -f $biosdir/$biosfile ]] || biosfile=COH-H31000.BIN
      # A memoria do jogo (32 KB) o fork grava em sram.bin dentro da pasta do
      # jogo (linha sram= do .acgame): ela vai para ~/nvram/<placa>/<gameid>.bin
      # e o sram.bin vira link para la. Um sram.bin que ja existe de verdade
      # vai para la antes (sem sobrescrever).
      if [[ ${2:-} == *.acgame && -f $2 ]]; then
        gid=$(acval gameid "$2") sub=$(acval subdir "$2") sram=$(acval sram "$2")
        if [[ -n $gid ]]; then
          nvdir="${FLIPEROS_NVRAM:-$HOME/nvram}/namco2x6"
          sramfile="$(dirname -- "$2")/${sub:-$gid}/${sram:-sram.bin}"
          # Um link que ficou sem destino (a pasta da memoria mudou de nome) e refeito.
          [[ ! -L $sramfile || -e $sramfile ]] || rm -f "$sramfile"
          if [[ -d ${sramfile%/*} && ! -L $sramfile ]] && mkdir -p "$nvdir" 2> /dev/null; then
            [[ ! -f $sramfile || -e $nvdir/$gid.bin ]] || mv -n "$sramfile" "$nvdir/$gid.bin" 2> /dev/null || true
            [[ -e $sramfile ]] || ln -s "$nvdir/$gid.bin" "$sramfile" 2> /dev/null || true
          fi
        fi
      fi
    fi
    # Sem PCSX2.ini, o de partida do FliperOS (/etc/fliperos/pcsx2.ini): com
    # o SettingsVersion dele o PCSX2 o aceita e completa o resto. Em todo
    # caso, a cada abertura: sem o assistente, tela cheia no Big Picture,
    # sem o ponteiro do mouse, a BIOS em ~/bios/ps2 e a imagem esticada.
    ini="$datadir/inis/PCSX2.ini"
    iniset=${FLIPEROS_INI_SET:-/opt/fliperos/bin/fliperos-ini-set}
    if [[ ! -f $ini ]]; then
      install -Dm600 "${FLIPEROS_PCSX2_INI:-/etc/fliperos/pcsx2.ini}" "$ini" 2> /dev/null || true
      # O de partida lista ~/roms/ps2: o fork lista a pasta Namco.
      [[ $1 != pcsx2x6 ]] || sed -i '/^RecursivePaths = /d' "$ini" 2> /dev/null || true
    fi
    if [[ -f $ini ]]; then
      "$iniset" "$ini" EmuCore/GS AspectRatio Stretch
      "$iniset" "$ini" UI SetupWizardIncomplete false
      "$iniset" "$ini" UI StartFullscreen true
      # Com um jogo (um frontend) o jogo abre direto, sem passar pelo Big
      # Picture; sem jogo, o Big Picture, que se usa pelo controle.
      if (($# > 1)); then
        "$iniset" "$ini" UI StartBigPictureMode false
      else
        "$iniset" "$ini" UI StartBigPictureMode true
      fi
      "$iniset" "$ini" UI HideMouseCursor true
      # Sem os avisos na tela ao abrir o jogo (0 = None no OsdOverlayPos).
      "$iniset" "$ini" EmuCore/GS OsdMessagesPos 0
      # Nem os contadores (velocidade, FPS, CPU, GPU, resolucao): o emulador
      # grava o que estava ligado ao fechar, e um teste de desempenho ficava.
      for osd in Speed FPS CPU GPU Resolution; do
        "$iniset" "$ini" EmuCore/GS "OsdShow$osd" false
      done
      "$iniset" "$ini" Folders Bios "$biosdir"
      if [[ $1 == pcsx2x6 ]]; then
        "$iniset" "$ini" Folders MemoryCards "$savedir"
        # A BIOS da placa do jogo: as duas estao na mesma pasta.
        [[ ! -f $biosdir/$biosfile ]] || "$iniset" "$ini" Filenames BIOS "$biosfile"
        # As pastas por placa de antes (namco246, namco256) viram a unica.
        if grep -qE 'roms/namco2(46|56)' "$ini"; then
          sed -i -E 's#roms/namco2(46|56)#roms/namco2x6#' "$ini"
          awk '!(/^RecursivePaths = / && seen[$0]++)' "$ini" > "$ini.new" && cat "$ini.new" > "$ini"
          rm -f "$ini.new"
        fi
      fi
      # Os botoes dos jogos de arcade vem da secao [JVS], nao do [Pad1]: sem
      # binding la o jogo nao recebe nada. Cada botao do jogo na posicao do
      # painel do Setup > Joysticks > Button mapping (e do Buttons layout): o
      # fliperos-buttons pcsx2x6 grava a secao (e o save do Button mapping a
      # regrava a cada mudanca). Sem ele (ou sem controle ligado), a tabela
      # config/pcsx2x6-jvs-bindings direto, o botao N do jogo na posicao N do
      # fight stick (X Y RB / A B RT), jogador 1 no SDL-0 e 2 no SDL-1. So
      # enquanto nada estiver no SDL: depois disso e o save que manda.
      jvs_bindings=${FLIPEROS_PCSX2X6_BINDINGS:-/etc/fliperos/pcsx2x6-jvs-bindings}
      jvs_has_sdl() { awk '/^\[JVS\]/ { p = 1; next } /^\[/ { p = 0 } p' "$ini" | grep -q 'SDL-[0-9]/'; }
      if [[ $1 == pcsx2x6 && -f $jvs_bindings ]] && ! jvs_has_sdl; then
        "${FLIPEROS_BUTTONS:-/opt/fliperos/bin/fliperos-buttons}" pcsx2x6 "$ini" > /dev/null 2>&1 || true
        if ! jvs_has_sdl; then
          panel=("" FaceWest FaceNorth RightShoulder FaceSouth FaceEast +RightTrigger)
          # Os jogos de 4 botoes 2x2, como nos gabinetes da Namco: 1 2 em cima, 3 4 embaixo.
          four=("" 1 2 4 5)
          while IFS=$'\t' read -r key player role; do
            [[ -z $key || $key == \#* ]] && continue
            if [[ $role == button:* ]]; then
              n=${role##*:}
              [[ $role != button:4:* ]] || n=${four[n]}
              role=${panel[n]:-}
              [[ -n $role ]] || continue
            fi
            "$iniset" "$ini" JVS "$key" "SDL-$((player - 1))/$role"
          done < "$jvs_bindings"
        fi
      fi
      # Lista de jogos em ~/roms/ps2 (no fork, as duas pastas Namco), se a
      # pessoa ainda nao escolheu pastas.
      if ! grep -q '^RecursivePaths' "$ini"; then
        "$iniset" "$ini" GameList RecursivePaths "$gamesdir"
      fi
      # Os controles pelo SDL, Pad1 e Pad2 nos dois primeiros: o painel ja
      # chega como fight stick (o mapeamento do Setup > Joysticks > Button
      # mapping no gamecontrollerdb), entao X Y RB / A B RT = Quadrado
      # Triangulo R1 / X Bola R2. So enquanto nada estiver no SDL: um ajuste
      # feito no proprio PCSX2 fica.
      if ! grep -q 'SDL-[0-9]/' "$ini"; then
        "$iniset" "$ini" InputSources SDL true
        for pad in 1 2; do
          for kv in Type=DualShock2 Up=DPadUp Down=DPadDown Left=DPadLeft Right=DPadRight Cross=FaceSouth \
            Circle=FaceEast Square=FaceWest Triangle=FaceNorth L1=LeftShoulder R1=RightShoulder L2=+LeftTrigger \
            R2=+RightTrigger Start=Start Select=Back; do
            value=${kv#*=}
            [[ ${kv%%=*} == Type ]] || value="SDL-$((pad - 1))/$value"
            "$iniset" "$ini" "Pad$pad" "${kv%%=*}" "$value"
          done
        done
      fi
      # O direcional do painel tambem no analogico esquerdo: jogo de corrida
      # (NFS Underground 2) so vira por ele. Enquanto o analogico estiver
      # vazio ou nas teclas padrao do PCSX2 (W A S D).
      for pad in 1 2; do
        for kv in LUp=DPadUp LDown=DPadDown LLeft=DPadLeft LRight=DPadRight; do
          value=$(awk -v s="[Pad$pad]" -v k="${kv%%=*}" '/^\[/ { in_pad = ($0 == s) }
            in_pad && $1 == k && $2 == "=" { print $3; exit }' "$ini")
          if [[ -z $value || $value == Keyboard/* ]]; then
            "$iniset" "$ini" "Pad$pad" "${kv%%=*}" "SDL-$((pad - 1))/${kv#*=}"
          fi
        done
      done
    fi
    # Com jogo, -nogui: sem a janela principal nem a lista de jogos antes do
    # jogo, e fechar o jogo fecha o PCSX2 e volta ao frontend.
    if (($# > 1)); then
      set -- "$1" -fullscreen -nogui "${@:2}"
    else
      set -- "$1" -fullscreen
    fi
    # O driver OpenGL do Mesa numa thread propria: a thread GS do PCSX2 e o
    # gargalo num processador fraco (NFS Underground 2 no i3 540: 28 -> 35
    # quadros/s so com isso).
    export mesa_glthread="${mesa_glthread:-true}"
    ;;
  duckstation)
    # O DuckStation (Setup > Games > Emulators & Games, config/fliperos-duckstation)
    # le o settings.ini de ~/.local/share/duckstation (ou de
    # $XDG_CONFIG_HOME/duckstation). Sem ele, o de partida: com o
    # SetupWizardIncomplete o assistente nao abre, e sem os atalhos de teclado
    # padrao (um settings.ini que ja existe nao os ganha) o Esc nao abriria o
    # menu. Select+Start tambem o abre, pelo painel.
    ini=${XDG_CONFIG_HOME:+$XDG_CONFIG_HOME/duckstation}
    ini=${ini:-$HOME/.local/share/duckstation}/settings.ini
    iniset=${FLIPEROS_INI_SET:-/opt/fliperos/bin/fliperos-ini-set}
    if [[ ! -f $ini ]] && mkdir -p "${ini%/*}" 2> /dev/null; then
      cat > "$ini" << 'INI'
[Main]
SetupWizardIncomplete = false

[Display]
VSync = true
Scaling = Nearest

[Hotkeys]
FastForward = Keyboard/Tab
TogglePause = Keyboard/Space
Screenshot = Keyboard/F10
OpenPauseMenu = Keyboard/Escape
OpenPauseMenu = SDL-0/Back & SDL-0/Start
LoadSelectedSaveState = Keyboard/F1
SaveSelectedSaveState = Keyboard/F2
SelectPreviousSaveStateSlot = Keyboard/F3
SelectNextSaveStateSlot = Keyboard/F4
INI
    fi
    if [[ -f $ini ]]; then
      # A cada abertura: sem o assistente, tela cheia sem o ponteiro, sem
      # perguntar ao fechar, a BIOS em ~/bios (a mesma do RetroArch) e a
      # imagem esticada no modo (640x240 e 8:3 em pixels; o tubo o mostra 4:3).
      "$iniset" "$ini" Main SetupWizardIncomplete false
      "$iniset" "$ini" Main StartFullscreen true
      "$iniset" "$ini" Main HideCursorInFullscreen true
      "$iniset" "$ini" Main ConfirmPowerOff false
      "$iniset" "$ini" BIOS SearchDirectory "$HOME/bios"
      # O log dele na saida, que vai para o duckstation.log (o painel web o
      # mostra): sem BIOS ele so fecha, e ali fica onde a procurou.
      "$iniset" "$ini" Logging LogToConsole true
      "$iniset" "$ini" Display AspectRatio "Stretch To Fill"
      # O corte padrao (Overscan) mostra a area toda do NTSC/PAL: um jogo que
      # usa menos linhas (Silent Iron, PAL) ficava com faixas pretas em cima e
      # embaixo. Borders corta ate o que o jogo
      # desenha, e o esticado o leva a tela toda. Um corte escolhido no
      # DuckStation fica.
      grep -q '^CropMode' "$ini" || "$iniset" "$ini" Display CropMode Borders
      # Num modo progressivo (240 ou 288 linhas) um jogo de 480i com o
      # desentrelacamento Disabled ou Weave mostra um campo por quadro e
      # pisca; o Progressive desenha o quadro inteiro, que o modo reduz sem
      # piscar. No 480i do tubo a escolha fica.
      if ((FLIPEROS_RES_H <= 288)) && grep -q -E '^DeinterlacingMode = (Disabled|Weave)$' "$ini"; then
        "$iniset" "$ini" GPU DeinterlacingMode Progressive
      fi
      # O filtro de flicker do entrelacado pedia o OpenGL ate a camada do Vulkan
      # filtrar tambem (config/fliperos-vkfps.c): quem ficou nele por isso volta
      # ao automatico. O renderizador escolhido no proprio DuckStation fica.
      if [[ -e ${ini%/*}/.fliperos-opengl ]]; then
        grep -q '^Renderer = OpenGL' "$ini" && "$iniset" "$ini" GPU Renderer Automatic
        rm -f "${ini%/*}/.fliperos-opengl"
      fi
      # Os jogos de ~/roms/ps1 (com as subpastas) e os da pasta do core PS1
      # do RetroArch, se a pessoa ainda nao escolheu pastas. A ~/roms/psx e a
      # ~/roms/duckstation de antes (config/fliperos-roms) viram a nova.
      sed -i -E "s#^RecursivePaths = $HOME/roms/(psx|duckstation)\$#RecursivePaths = $HOME/roms/ps1#" "$ini" 2> /dev/null || true
      grep -q '^RecursivePaths' "$ini" || "$iniset" "$ini" GameList RecursivePaths "$HOME/roms/ps1"
      grep -q '^Paths' "$ini" || "$iniset" "$ini" GameList Paths "$HOME/roms/retroarch/pcsx_rearmed"
      # Os controles pelo SDL, Pad1 e Pad2 nos dois primeiros, como no PCSX2:
      # o painel ja chega como fight stick (Setup > Joysticks > Button
      # mapping), X Y RB / A B RT = Quadrado Triangulo R1 / X Bola R2. So
      # enquanto nada estiver no SDL: um ajuste feito no DuckStation fica.
      if ! grep -q 'SDL-[0-9]/[A-Z]' <(grep -v '^OpenPauseMenu' "$ini"); then
        "$iniset" "$ini" InputSources SDL true
        for pad in 1 2; do
          for kv in Type=AnalogController Up=DPadUp Down=DPadDown Left=DPadLeft Right=DPadRight Cross=A \
            Circle=B Square=X Triangle=Y L1=LeftShoulder R1=RightShoulder L2=+LeftTrigger R2=+RightTrigger \
            Start=Start Select=Back; do
            value=${kv#*=}
            [[ ${kv%%=*} == Type ]] || value="SDL-$((pad - 1))/$value"
            "$iniset" "$ini" "Pad$pad" "${kv%%=*}" "$value"
          done
        done
      fi
    fi
    # Com um jogo (um frontend), -nogui: sem a janela principal (a lista de
    # jogos, com menu e barra de status) antes do jogo, e fechar o jogo fecha
    # o DuckStation e volta ao frontend (o -nogui ja e o -batch). Sem jogo, o
    # Big Picture, que se usa pelo controle.
    # Sem o "--" antes do jogo (o DuckStation o aceita, mas nao precisa: o
    # caminho do frontend e absoluto): o xinit separa o programa do servidor
    # no primeiro "--", e o .cue virava o servidor X.
    if (($# > 1)); then
      set -- "$1" -fullscreen -nogui "${@:2}"
    else
      set -- "$1" -fullscreen -bigpicture
    fi
    ;;
  hypseus | singe)
    # O Hypseus le o jogo e o player primeiro ("hypseus lair vldp ..."); as
    # opcoes vao no fim. Sem -x/-y ele abriria em 640x480, e sem
    # -ignore_aspect_ratio manteria o 4:3 do video, com faixas pretas no
    # 640x240 (o esticado de 200% dos outros).
    set -- "$@" -fullscreen -x "$FLIPEROS_RES_W" -y "$FLIPEROS_RES_H" -ignore_aspect_ratio
    ;;
  supermodel)
    # Com ~/.config/supermodel (criado na primeira abertura) ele procura ali
    # o Games.xml e o Music.xml, e os Assets em ~/.local/share/supermodel; o
    # build os deixa em /usr/local/share/supermodel. Sem o Games.xml nenhuma
    # ROM e reconhecida ("No complete Model 3 games found").
    share=${FLIPEROS_SUPERMODEL_SHARE:-/usr/local/share/supermodel}
    mkdir -p "$HOME/.config/supermodel/Config" "$HOME/.local/share/supermodel"
    for f in Config/Games.xml Config/Music.xml; do
      [[ -e $HOME/.config/supermodel/$f || ! -e $share/$f ]] || ln -s "$share/$f" "$HOME/.config/supermodel/$f"
    done
    [[ -e $HOME/.local/share/supermodel/Assets || ! -d $share/Assets ]] ||
      ln -s "$share/Assets" "$HOME/.local/share/supermodel/Assets"
    # Sem -res ele abre em 496x384 (o nativo do Model 3), que no 15 kHz so
    # existe entrelacado; aqui ocupa o modo da tabela, esticado para o 4:3.
    # O PowerPC emulado e o gargalo num processador fraco (Fighting Vipers 2
    # no i3 540: 35 quadros/s a 166 MHz, 59 a 75 MHz): nos jogos de stepping
    # 1.5 e 2.x (100 e 166 MHz) ele roda a FLIPEROS_SUPERMODEL_PPC; os de 1.0
    # ja sao 66 MHz.
    ppc=()
    game=$(basename -- "${*: -1}" .zip)
    step=$(awk -v g="<game name=\"$game\"" 'index($0, g) { found = 1 }
      found && /<stepping>/ { gsub(/.*<stepping>|<\/stepping>.*/, ""); print; exit }' \
      "$share/Config/Games.xml" 2> /dev/null) || step=""
    if [[ $step == 1.5 || $step == 2.* ]] && [[ ${FLIPEROS_SUPERMODEL_PPC:-75} != 0 ]]; then
      ppc=(-ppc-frequency="${FLIPEROS_SUPERMODEL_PPC:-75}")
    fi
    # As saidas do jogo pela rede, se ha quem as leia (config/fliperos-outputs).
    netout=()
    [[ -x $outputs ]] && "$outputs" installed && netout=(-outputs=net)
    # Os quads de verdade (o padrao do Supermodel, por geometry shader)
    # quebram poligonos nas Radeon antigas: no gabinete (Oland, radeonsi) o
    # Fighting Vipers 2 tinha triangulos pretos e brancos e texturas vazadas,
    # e com triangulos ainda chegou aos 57,5 quadros/s. O QuadRendering
    # escrito no Supermodel.ini fica.
    quads=()
    grep -qE '^[[:space:]]*QuadRendering[[:space:]]*=' "$HOME/.config/supermodel/Config/Supermodel.ini" 2> /dev/null ||
      quads=(-no-quad-rendering)
    # Com uma pistola, sem a mira dos jogos de pistola.
    nocross=()
    [[ -n $guns ]] && nocross=(-crosshairs=0)
    set -- "$1" -fullscreen -res="$FLIPEROS_RES_W,$FLIPEROS_RES_H" -stretch "${quads[@]}" "${ppc[@]}" "${netout[@]}" \
      "${nocross[@]}" "${@:2}"
    # O Switchres nem sempre cria o modo pedido: no 15 kHz o 496x384 do entrelacado
    # vira 661x496 entrelacado (as linhas que cabem, na mesma proporcao), e o
    # Supermodel desenhava os 496x384 do -res num quadrado no meio da tela.
    # Depois da troca, o -res do modo na tela (o ultimo -res vale). Numa
    # linha so: o printf %q do fliperos-x11-client poria a quebra num $'\n',
    # que o sh do Switchres nao entende.
    # shellcheck disable=SC2016 # o $ e do awk
    fit='/ connected/ { for (i = 3; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+[+]/) { split($i, a, /[x+]/); print a[1] "," a[2]; exit } }'
    # shellcheck disable=SC2016 # o $ e do sh -c, depois da troca de modo
    set -- sh -c 'res=$(xrandr --current 2> /dev/null | awk "$0"); exec "$@" ${res:+-res=$res}' "$fit" "$@"
    ;;
  fliperos-model2 | sm2-emu)
    cfg=${XDG_CONFIG_HOME:-$HOME/.config}/sm2-emu
    mkdir -p "$cfg"
    ini=$cfg/sm2-emu.ini
    # sm2_set CHAVE VALOR: troca a linha da chave no ini, ou a acrescenta.
    sm2_set() {
      if [[ -f $ini ]] && grep -q "^$1[[:space:]=]" "$ini"; then
        sed -i -E "s/^$1[[:space:]=].*/$1 = $2/" "$ini"
      else
        printf '%s = %s\n' "$1" "$2" >> "$ini"
      fi
    }
    # 640x240 tem pixel mais largo que o 4:3: no tubo a imagem so preenche
    # com stretch. O ini do emulador nasce em 4:3, entao cada abertura
    # nesse modo grava stretch de novo; o resto da configuracao fica.
    if ((FLIPEROS_RES_H * 4 < FLIPEROS_RES_W * 3)); then
      sm2_set aspect_mode stretch
    fi
    # O emulador nasce sem VSync (rasga a imagem no tubo). Liga uma vez so:
    # quem desligar no menu do F10 fica com a escolha.
    if [[ ! -e $cfg/.fliperos-vsync ]]; then
      sm2_set vsync true
      : > "$cfg/.fliperos-vsync"
    fi
    # As saidas do jogo pela rede (as lampadas; nos jogos de pistola, com o
    # patch do FliperOS, o recuo, a municao e a vida), se ha quem as leia
    # (config/fliperos-outputs). Sem leitor, so desliga o que ligou aqui:
    # quem ligou no menu do F10 fica com a escolha.
    # O placar versus no LED do gabinete (config/fliperos-versus) tambem as
    # le: num jogo que publica os rounds, com um painel instalado.
    versus=${FLIPEROS_VERSUS:-/opt/fliperos/bin/fliperos-versus}
    game=$(basename -- "${*: -1}")
    if { [[ -x $outputs ]] && "$outputs" installed; } ||
      { [[ $# -ge 2 && -x $versus && -x $pixelcade ]] && "$pixelcade" panel &&
        "$versus" has model2 "${game%.zip}"; }; then
      if ! grep -qE '^outputs_network[[:space:]]*=[[:space:]]*true' "$ini" 2> /dev/null; then
        sm2_set outputs_network true
        : > "$cfg/.fliperos-outputs"
      fi
    elif [[ -e $cfg/.fliperos-outputs ]]; then
      sm2_set outputs_network false
      rm -f "$cfg/.fliperos-outputs"
    fi
    # Pistola de luz: o modo dela (le cada pistola direto, a primeira e o
    # jogador 1) sem a mira do emulador. Os botoes do GunCon 2 sao padrao:
    # gatilho, A ou C recarrega, Start, Select e a ficha, sem direcional (os
    # padroes do emulador sao os da Sinden). Uma vez so: quem mudar no menu
    # do F10 fica com a escolha.
    if [[ -n $guns ]]; then
      sm2_set lightgun true
      sm2_set lightgun_crosshair false
      if [[ ! -e $cfg/.fliperos-guncon ]] && "$lightgun" guncon; then
        for p in 1 2; do
          sm2_set "gun${p}_button_trigger" 272
          sm2_set "gun${p}_button_reload" 273
          sm2_set "gun${p}_button_coin" 314
          sm2_set "gun${p}_button_start" 315
          for hat in up down left right; do sm2_set "gun${p}_button_hat_$hat" 0; done
        done
        : > "$cfg/.fliperos-guncon"
      fi
    fi
    # Setup > Joysticks > Button mapping e Buttons layout: o mapeamento de
    # game controller do Model 2 (config/fliperos-buttons), o do numero de
    # botoes deste jogo se ha um layout para ele, por cima do do sistema.
    m2db=${FLIPEROS_SDL_MODEL2_DB:-/var/lib/fliperos/gamecontrollerdb-model2.txt}
    if [[ -f $m2db ]]; then
      game_buttons=${FLIPEROS_GAME_BUTTONS:-/var/lib/fliperos/game-buttons.txt}
      count=""
      [[ ! -f $game_buttons ]] ||
        count=$(awk -v g="${game%.zip}" '$1 == g { print $2; exit }' "$game_buttons")
      [[ -z $count || ! -f ${m2db%.txt}-$count.txt ]] || m2db=${m2db%.txt}-$count.txt
      sysdb=${SDL_GAMECONTROLLERCONFIG_FILE:-/var/lib/fliperos/gamecontrollerdb.txt}
      if cat "$sysdb" "$m2db" > "$cfg/gamecontrollerdb.txt" 2> /dev/null ||
        cat "$m2db" > "$cfg/gamecontrollerdb.txt" 2> /dev/null; then
        export SDL_GAMECONTROLLERCONFIG_FILE=$cfg/gamecontrollerdb.txt
      fi
    fi
    set -- "$1" --fullscreen "${@:2}"
    ;;
esac

# Monitores extras (Setup > Video Setup > Multiple Monitors): o
# fliperos-kms-run deixa so o principal ligado; no X voltam todos, e o
# comando groovymame sabe que este X e so dele.
if grep -q '^screens=.*,' "$CONF" 2> /dev/null; then
  sudo -n /usr/local/bin/fliperos-setup --outputs all > /dev/null 2>&1 || true
fi
export FLIPEROS_X11_RUN_SESSION=1
# A camada do filtro herdada de um frontend do fliperos-kms-run sai daqui:
# o fliperos-x11-client a poe so no emulador (no Xorg, no Switchres e no
# Electron do Fightcade ela nao tem o que fazer, e no Wine de 32 bits so
# gera erro).
if [[ -n ${LD_PRELOAD:-} ]]; then
  preload=""
  for lib in ${LD_PRELOAD//:/ }; do
    [[ $lib == */libfliperos-deflicker.so ]] || preload+=${preload:+:}$lib
  done
  if [[ -n $preload ]]; then export LD_PRELOAD=$preload; else unset LD_PRELOAD; fi
fi
# SDL no X: chamado de dentro do fliperos-kms-run (o GroovyMAME, que se abre
# no X sozinho), herdaria o kmsdrm de la.
export SDL_VIDEODRIVER=x11
# O Qt tambem (PCSX2, Dolphin, DuckStation): aberto por um frontend no
# fliperos-kms-run, herdaria o eglfs do console, nao acharia a tela com o X
# dono dela e fecharia na hora.
export QT_QPA_PLATFORM=xcb
unset QT_QPA_EGLFS_INTEGRATION QT_QPA_EGLFS_HIDECURSOR
# Audio SDL direto no ALSA (o FliperOS nao tem servidor de som).
export SDL_AUDIODRIVER="${SDL_AUDIODRIVER:-alsa}"
# Mapeamentos de controle do SDL (fliperos-rootfs.sh).
export SDL_GAMECONTROLLERCONFIG_FILE="${SDL_GAMECONTROLLERCONFIG_FILE:-/var/lib/fliperos/gamecontrollerdb.txt}"
# A calibracao de cor na placa antes do Xorg (a matriz e a faixa RGB ficam;
# a tabela de gama o fliperos-x11-client poe no X).
color=${FLIPEROS_COLOR:-/usr/local/bin/fliperos-color}
# Sem a calibracao (outro programa dono da tela) o jogo abre assim mesmo: no
# fim do "&&", a falha encerrava o script pelo set -e, sem abrir nada.
[[ -x $color ]] && { "$color" apply > /dev/null 2>&1 || true; }
# Sem terminal (chamado por um frontend), o tty falha: vale o vt1.
vt=$(tty 2> /dev/null) || vt=""
vt=${vt#/dev/tty}
[[ $vt =~ ^[0-9]+$ ]] || vt=1
# Cursor so para quem tem interface de mouse: Dolphin, Flycast, o Fightcade
# (a sala de jogos) e o navegador do Downloader (fliperos-browser). O Flycast
# o esconde durante o jogo em tela cheia; o Dolphin aberto direto num jogo
# (-e, pelo frontend) deixava a seta no meio da tela, entao vai sem. O PCSX2
# abre no Big Picture, que se usa pelo controle; os demais abrem direto no jogo.
cursor=(-nocursor)
case $name in
  # Com uma pistola a seta seguiria a mira por cima do jogo.
  flycast) [[ -n $guns ]] || cursor=() ;;
  fightcade | fliperos-browser) cursor=() ;;
  dolphin-emu) [[ " $* " == *" -e "* || " $* " == *" --exec"* ]] || cursor=() ;;
esac
export FLIPEROS_X11_CURSOR=$((${#cursor[@]} == 0))
# O Esc fecha o jogo (config/fliperos-escquit), como nos outros emuladores: o
# Flycast nao tem tecla de sair, e o Esc do Dolphin so para a emulacao e
# deixa a janela dele. O vigia segue este PID, que o exec passa ao xinit; o
# SIGTERM fecha o X e o emulador junto. --ignore-children: o emulador e
# neto do xinit.
case $name in
  flycast | dolphin-emu)
    escquit=${FLIPEROS_ESCQUIT:-/opt/fliperos/bin/fliperos-escquit}
    [[ -x $escquit ]] && "$escquit" --ignore-children $$ < /dev/null > /dev/null 2>&1 &
    ;;
esac
# A saida do X, do Switchres e do emulador vai para
# /opt/fliperos/logs/<programa>.log, nao para a tela; no modo debug (Setup > System >
# Debug mode) ela aparece. Sem como gravar o log, abre assim mesmo.
log="${FLIPEROS_LOGS:-/opt/fliperos/logs}/$name.log"
# Um frontend que espera o jogo lendo a saida do comando (o ES-DE: popen ate
# o fim do arquivo) veria o pipe fechar ja na troca para o log e retomaria a
# tela com o jogo aberto. Uma copia do pipe fica com o programa ate ele sair.
[[ ! -p /dev/stdout ]] || exec 9>&1
# O xinit separa o programa do servidor no primeiro "--": um "--" no comando
# do programa faria do resto o servidor X (o jogo executado como script, e o X
# nao sobe). Para aqui, com o motivo no log.
for arg in "$@"; do
  if [[ $arg == -- ]]; then
    echo "fliperos-x11-run: '--' in the command of $name: xinit would take what follows as the X server" |
      { tee -a "$log" 2> /dev/null || cat; } >&2
    exit 2
  fi
done
if [[ ! -f ${FLIPEROS_DEBUG_FLAG:-/etc/fliperos/debug} ]] && { : > "$log"; } 2> /dev/null; then
  exec xinit /opt/fliperos/bin/fliperos-x11-client "$@" -- :0 -nolisten tcp "${cursor[@]}" "vt$vt" -keeptty \
    >> "$log" 2>&1
fi
exec xinit /opt/fliperos/bin/fliperos-x11-client "$@" -- :0 -nolisten tcp "${cursor[@]}" "vt$vt" -keeptty
