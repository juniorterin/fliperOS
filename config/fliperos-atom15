                   (15, 8, 16, CLOCK_12587, 80, 84, 96, 100, 480, SCAN_TYPE_0 | SCAN_INTERLACE)),
    (0x13,): ((31, 8, 8, CLOCK_25175, 80, 84, 96, 100, 400, SCAN_TYPE_1),
              (25, 8, 8, CLOCK_25175, 80, 95, 110, 126, 400, SCAN_TYPE_1),
              (15, 8, 8, CLOCK_12587, 80, 84, 96, 100, 200, SCAN_TYPE_0)),
}


def standard_mode_write(data, at, m):
    """standard_mode_from_modedef: o modo de volta nos bytes da tabela."""
    crtc = at + 10

    def bit(value, position, on):
        return (value & ~(1 << position) & 0xff) | (int(bool(on)) << position)

    data[at + 2] = m['lines_per_char'] & 0xff
    poke_word(data, at + 3, m['buffer_size'])
    seq = data[at + 5]
    seq = bit(seq, 0, m['dots_per_char'] == 8)
    seq = bit(seq, 3, m['dotclock_div'])
    data[at + 5] = seq
    misc = (data[at + 9] & 0b11110011) | (m['clock_select'] * 4)
    misc = bit(misc, 7, not m['vsync_polarity'])
    misc = bit(misc, 6, not m['hsync_polarity'])
    data[at + 9] = misc

    ht, vt = m['horizontal_total'], m['vertical_total']
    vde = m['vertical_display_end'] - 1
    vrs, vbs, lc = m['vertical_retrace_start'], m['vertical_blanking_start'], m['line_compare']
    hbe = m['horizontal_blanking_end']
    data[crtc + 0x00] = (ht - 5) & 0xff
    data[crtc + 0x01] = m['horizontal_display_end'] & 0xff
    data[crtc + 0x02] = m['horizontal_blanking_start'] & 0xff
    data[crtc + 0x03] = (hbe & 0b11111) + 0b10000000
    data[crtc + 0x04] = m['horizontal_retrace_start'] & 0xff
    data[crtc + 0x05] = (m['horizontal_retrace_end'] & 0b11111) + (hbe & 0b100000) * 4
    data[crtc + 0x06] = vt & 0xff
    data[crtc + 0x07] = ((vt & 0x100) // 256 + (vde & 0x100) // 128 + (vrs & 0x100) // 64 + (vbs & 0x100) // 32 +
                         (lc & 0x100) // 16 + (vt & 0x200) // 16 + (vde & 0x200) // 8 + (vrs & 0x200) // 4) & 0xff
    data[crtc + 0x09] = (m['maximum_scan_line'] + (vbs & 0x200) // 16 + (lc & 0x200) // 8 +
                         m['scan_doubling'] * 128) & 0xff
    data[crtc + 0x0a] = m['cursor_start'] & 0xff
    data[crtc + 0x0b] = m['cursor_end'] & 0xff
    data[crtc + 0x10] = vrs & 0xff
    data[crtc + 0x11] = (m['vertical_retrace_end'] & 0b1111) + (data[crtc + 0x11] & 0b11110000)
    data[crtc + 0x12] = vde & 0xff
    data[crtc + 0x13] = m['line_pitch'] & 0xff
    data[crtc + 0x15] = vbs & 0xff
    data[crtc + 0x16] = (m['vertical_blanking_end'] & 0b01111111) + (data[crtc + 0x16] & 0b10000000)
    data[crtc + 0x18] = lc & 0xff


def process_standard_modes(b, ranges, csync):
    data = b.data
    numbers = STANDARD_OLD if b.old_modes else STANDARD_NEW
    for i in range(b.num_standard):
        at = b.vpt + i * 64
        if data[at] == 0:
            continue
        number = numbers[i]
        options = next((v for k, v in STANDARD_TABLE.items() if number in k), None)
        if options is None:
            b.log.append('Standard mode %02Xh: not reprogrammed' % max(number, 0))
            continue
        crtc = at + 10
        m = {
            'buffer_size': word(data, at + 3),
            'line_pitch': data[crtc + 0x13],
            'line_compare': data[crtc + 0x18] + (data[crtc + 0x07] & 0b10000) * 16 + (data[crtc + 0x09] & 0b1000000) * 8,
            'cursor_start': 0, 'cursor_end': 0, 'interlace': 0,
        }
        for option in options:
            if option[0] in ranges and modedef_adjust(m, RANGES[option[0]], *option[1:], csync):
                standard_mode_write(data, at, m)
                b.table[number] = INTERLACE_ENABLE if m['interlace'] else 0
                b.log.append('Standard mode %02Xh: %.3f kHz, %.3f Hz%s' % (
                    number, m['hfreq'] / 1000, m['vfreq'], ' interlaced' if m['interlace'] else ''))
                break
        else:
            raise Atom15Error('Mode %02Xh is out of range for the chosen monitor.' % number)


def modeline_adjust(ml, r, csync):
    """As contas de um modo VESA numa faixa (modeline_adjust). False: nao cabe."""
    hmin, hmax, vmin, vmax, hfp, hsp, hbp = r[:7]
    vfp, vsp, vbp, blank = vertical_times(r)
    xres, yres = ml['width'], ml['height']

    interlace = 1
    vfreq = float(x(hmax) / (Fraction(yres, interlace) + round(x(hmax) * x(blank))))
    if vfreq < vmin:
        interlace = 2
        vfreq = float(x(hmax) / (Fraction(yres, interlace) + round(x(hmax) * x(blank))))
        if vfreq < vmin:
            return False

    vfreq = min(vfreq, vmax)
    hfreq = float(x(vfreq) * yres / (interlace * (1 - x(vfreq) * x(blank))))
    hfreq = max(hfreq, hmin)

    line_time = float(1 / x(hfreq) * 1000000)
    hfp_min, hsp_min, hbp_min = float(x(hfp) * x(0.9)), float(x(hsp) * x(0.9)), float(x(hbp) * x(0.9))
    hh = round(Fraction(xres, 8))
    hs = he = ht = 1
    while True:
        char_time = x(float(x(line_time) / (hh + hs + he + ht)))
        if hs * char_time < x(hfp_min) or abs((hs + 1) * char_time - x(hfp)) < abs(hs * char_time - x(hfp)):
            hs += 1
        if he * char_time < x(hsp_min) or abs((he + 1) * char_time - x(hsp)) < abs(he * char_time - x(hsp)):
            he += 1
        if ht * char_time < x(hbp_min) or abs((ht + 1) * char_time - x(hbp)) < abs(ht * char_time - x(hbp)):
            ht += 1
        if x(float(x(line_time) / (hh + hs + he + ht))) == char_time:
            break

    dotclock = pb_round(x(hfreq) * (hh + hs + he + ht) * 8)
    if dotclock < DOT_CLOCK_MIN:
        return False

    half = Fraction(1, 2) if interlace == 2 else 0
    field_active = Fraction(yres, interlace)
    field_total = round(x(hfreq) / x(vfreq)) + half
    field_blank = math.floor(x(hfreq) * x(blank)) + half
    field_padding = field_total - field_blank - field_active
    doublescan = 0
    if field_padding >= field_active:
        doublescan = 1
        field_padding -= field_active

    ml['pclock'] = pb_round(Fraction(dotclock, 10000))
    ml['hactive'] = xres
    ml['hbegin'] = (hh + hs) * 8
    ml['hend'] = (hh + hs + he) * 8
    ml['htotal'] = (hh + hs + he + ht) * 8
    ml['vactive'] = yres
    ml['vbegin'] = pb_round(yres + (max(round(x(hfreq) * x(vfp)), 1) + field_padding / 2) * interlace)
    ml['vend'] = ml['vbegin'] + max(round(x(hfreq) * x(vsp)), 1) * interlace
    ml['vtotal'] = pb_round(field_total * interlace)
    ml['interlace'] = 1 if interlace == 2 else 0
    ml['doublescan'] = doublescan
    ml['refresh'] = math.floor(vfreq)
    ml['hsync'] = 1 if csync else 0
    ml['vsync'] = 1 if csync else 0
    return True


def timing_read(b, at):
    """vesa_timing_to_modeline."""
    data = b.data
    if b.vesa_old:
        f = struct.unpack_from('<9HH', data, at)
        ml = {'pclock': f[8], 'htotal': f[0], 'hactive': f[1], 'hbegin': f[2], 'hend': f[2] + f[3],
              'vtotal': f[4], 'vactive': f[5], 'vbegin': f[6], 'vend': f[6] + f[7]}
        misc = f[9]
        ml['number'], ml['refresh'] = data[at + 30], data[at + 31]
    else:
        f = struct.unpack_from('<9H', data, at)
        ml = {'pclock': f[0], 'htotal': f[1] + f[2], 'hactive': f[1], 'hbegin': f[1] + f[5],
              'hend': f[1] + f[5] + f[6], 'vtotal': f[3] + f[4], 'vactive': f[3], 'vbegin': f[3] + f[7],
              'vend': f[3] + f[7] + f[8]}
        misc = word(data, at + 24)
        ml['number'], ml['refresh'] = data[at + 26], data[at + 27]
    ml['interlace'] = (misc >> 7) & 1
    ml['doublescan'] = (misc >> 5) & 1
    ml['hsync'] = ((misc >> 1) & 1) ^ 1
    ml['vsync'] = ((misc >> 2) & 1) ^ 1
    ml['width'], ml['height'] = ml['hactive'], ml['vactive']
    return ml


def timing_write(b, at, ml):
    """vesa_timing_from_modeline: o resto da entrada fica zerado."""
    misc = (ATOM_INTERLACE if ml['interlace'] else 0) | (ATOM_V_REPLICATIONBY2 if ml['doublescan'] else 0)
    misc |= (0 if ml['hsync'] else ATOM_HSYNC_POLARITY) | (0 if ml['vsync'] else ATOM_VSYNC_POLARITY)
    if b.vesa_old:
        out = struct.pack('<9HH5HBB', ml['htotal'], ml['hactive'], ml['hbegin'], ml['hend'] - ml['hbegin'],
                          ml['vtotal'], ml['vactive'], ml['vbegin'], ml['vend'] - ml['vbegin'], ml['pclock'], misc,
                          0, 0, 0, 0, 0, ml['number'], ml['refresh'])
    else:
        out = struct.pack('<11HBBHBB', ml['pclock'], ml['hactive'], ml['htotal'] - ml['hactive'], ml['vactive'],
                          ml['vtotal'] - ml['vactive'], ml['hbegin'] - ml['hactive'], ml['hend'] - ml['hbegin'],
                          ml['vbegin'] - ml['vactive'], ml['vend'] - ml['vbegin'], 0, 0, 0, 0, misc, ml['number'],
                          ml['refresh'])
    b.data[at:at + len(out)] = out


def timing_describe(ml):
    if not ml['htotal'] or not ml['vtotal']:
        return '%dx%d' % (ml['width'], ml['height'])
    hfreq = ml['pclock'] * 10000 / ml['htotal']
    vfreq = hfreq / ml['vtotal'] * (2 if ml['interlace'] else 1)
    return '%dx%d %.3f kHz %.3f Hz%s' % (ml['width'], ml['height'], hfreq / 1000, vfreq,
                                         ' interlaced' if ml['interlace'] else '')


def process_vesa_modes(b, ranges, csync):
    data = b.data
    first = b.vesa_timing + 4
    for i in range(b.num_vesa_timings):
        at = first + i * b.timing_bytes
        ml = timing_read(b, at)
        before = timing_describe(ml)
        order = {200: (15, 31), 240: (15, 31), 350: (25, 31), 384: (25, 31), 768: (25, 31), 400: (31, 25, 15),
                 480: (31, 25, 15), 600: (31, 25, 15), 864: (31,), 960: (31,)}.get(ml['height'], ())
        for r in order:
            if r in ranges and modeline_adjust(ml, RANGES[r], csync):
                timing_write(b, at, ml)
                b.log.append('VESA timing %s -> %s' % (before, timing_describe(ml)))
                break
        else:
            # Sem faixa: o modo sai da lista (vesa_timing_disable).
            data[at + (30 if b.vesa_old else 26)] = 0
            b.log.append('VESA timing %s -> disabled' % before)

    # A tabela VESA -> modo interno: so os modos que ainda tem timing, juntos no
    # comeco, e o resto em branco.
    lut = b.vesa_lut + 4
    j = 0
    for i in range(b.num_vesa_modes):
        mode, extended = struct.unpack_from('<HH', data, lut + i * 4)
        if not mode:
            continue
        number = extended // 256
        at = next((first + t * b.timing_bytes for t in range(b.num_vesa_timings)
                   if data[first + t * b.timing_bytes + (30 if b.vesa_old else 26)] == number), None)
        if at is None:
            struct.pack_into('<HH', data, lut + i * 4, 0, 0)
            continue
        if 0x100 <= mode < 0x200:
            b.table[20 + mode - 0x100] = INTERLACE_ENABLE if timing_read(b, at)['interlace'] else 0
        struct.pack_into('<HH', data, lut + j * 4, mode, extended)
        j += 1
    for i in range(j, b.num_vesa_modes):
        struct.pack_into('<HH', data, lut + i * 4, 0xffff, 0xffff)
    poke_word(data, b.vesa_lut, j * 4 + 4)


def find_blank(data, start, end, size):
    """find_blank_space: uma sequencia de 00 e FF. O deslocamento ou None."""
    region = bytes(data[start:end]).replace(b'\xff', b'\x00')
    at = region.find(bytes(size))
    return None if at < 0 else at + start


def bios_hook(b, csync):
    data = b.data
    legacy = data[2] * 512
    size = len(HOOK)
    start = min(b.length, BIOS_HOOK_OFFSET_MIN)
    if b.length < BIOS_MIN_SIZE:
        for i in range(b.length, BIOS_MIN_SIZE):
            data[i] = 0
        b.length = BIOS_MIN_SIZE
        legacy = BIOS_MIN_SIZE

    offset = find_blank(data, start, BIOS_END_OFFSET, size)
    if offset is None:
        if b.gop is None:
            raise Atom15Error('No room for the hook: not enough blank space below 0xFFFF.')
        # BIOS legada + EFI: abre espaco empurrando o bloco GOP para baixo.
        block_start = b.gop
        block_end = block_start + data[b.gop + 2] * 512
        if block_start >= 0x10000:
            raise Atom15Error('No room for the hook: GOP reallocation failed.')
        shift = 0
        while shift < size - 1:
            shift += 1
            offset = find_blank(data, start, BIOS_END_OFFSET, size - shift)
            if offset is not None:
                break
        new_legacy = math.ceil((legacy + shift) / 512) * 512
        shift = new_legacy - legacy
        if b.mcuc_block:
            block_end = b.mcuc_block + word(data, b.mcuc_block + 10) + 320
        block_size = block_end - block_start
        if 0x20000 - 0x100 - block_end < shift or offset is None or block_end + shift > b.length:
            raise Atom15Error('No room for the hook: GOP reallocation failed.')
        block = bytes(data[block_start:block_start + block_size])
        data[block_start + shift:block_start + shift + block_size] = block
        data[block_start:block_start + shift] = bytes(shift)
        if b.mcuc_block:
            b.mcuc_block += shift
            poke_dword(data, b.mcuc_offset, b.mcuc_block)
        legacy = new_legacy
        # O branco achado pode ser de dentro do GOP: o hook teria de caber no que
        # ficou livre, senao o original cresce a parte legada por cima do EFI.
        if offset + size > legacy:
            raise Atom15Error('No room for the hook: the blank space is inside the EFI part of this BIOS.')
    elif b.gop is not None and offset + size > legacy:
        # Depois do fim da parte legada comeca o EFI: o original cresceria por
        # cima dele (e o trecho em branco pode ser de dentro do GOP).
        raise Atom15Error('No room for the hook: the blank space is inside the EFI part of this BIOS.')

    if offset + size > legacy:
        legacy = math.ceil((offset + size) / 512) * 512
    data[2] = legacy // 512
    data[offset:offset + size] = HOOK
    label = HOOK_LABELS

    def poke_at(name, delta, value):
        poke_word(data, offset + label[name] + delta, value)

    def poke_call(name, target):
        poke_at(name, 1, target - (offset + label[name] + 3))

    data[offset + label['standard_modes']:offset + label['standard_modes'] + 276] = b.table
    poke_word(data, b.standard_call + 1, offset + label['standard_bios_hook'] - (b.standard_call + 3))
    poke_word(data, b.vesa_call + 1, offset + label['vesa_bios_hook'] - (b.vesa_call + 3))
    poke_at('get_standard_modes_offset', 2, offset + label['standard_modes'])
    poke_call('standard_bios_service', b.standard_proc)
    poke_at('get_vesa_modes_offset', 2, offset + label['vesa_modes'])
    poke_call('vesa_bios_service', b.vesa_proc)
    poke_at('get_pci_bus', 3, b.pci_bus)
    for name in ('call_get_BAR4', 'call_get_BAR1'):
        poke_call(name, offset + label['get_BAR'])
    for name in ('call_set_value1', 'call_set_value2', 'call_set_value3'):
        poke_call(name, offset + label['set_value'])

    interlace, data_format, interleave, hsync, composite, crtcs = REGISTERS[pci_class(b.device)]
    poke_at('crtc_interlace_control_reg', 2, interlace)
    poke_at('data_format_reg', 2, data_format)
    poke_at('interleave_enable_set', 2, interleave)
    if csync:
        poke_at('crtc_enable_composite_sync', 0, 0x9090)
    poke_at('crtc_h_sync_a_cntl_reg', 2, hsync)
    poke_dword(data, offset + label['crtc_composite_enable_set'] + 2, composite)
    for n, off in enumerate(crtcs):
        poke_at('crtc%d_enable_interlace' % n, 1, off)
        poke_call('call_crtc%d' % n, offset + label['crtc_program_registers'])
    return offset + label['checksum_fix']


def fix_checksum(b, fix):
    """Devolve a soma de antes: os bytes da tabela trocam com FE (o entrelacado
    e so o bit 0, que nao muda), e um byte proprio fecha a conta."""
    data = b.data
    diff = (b.checksum - checksum(data)) & 0xffff
    for i in range(1, diff // 0xfe + 1):
        data[fix + i] ^= 0xfe
    data[fix] = (b.checksum - checksum(data)) & 0xff


def patch(image, ranges, csync=False):
    """A imagem nova e o log; Atom15Error se ela nao pode ser feita."""
    b = Bios(image)
    if b.vendor != VENDOR_ATI:
        raise Atom15Error('Not an ATI/AMD BIOS.')
    if pci_class(b.device) is None:
        raise Atom15Error('This card (%04x) is not in the ATOM-15 list.' % b.device)
    if b.patched:
        raise Atom15Error('This BIOS already has the ATOM-15 hook: start from the original one.')
    if b.vpt < 0:
        raise Atom15Error('Video parameter table not found.')
    if not ranges or not set(ranges) <= set(RANGES):
        raise Atom15Error('Choose the monitor ranges: 15, 25 and/or 31 kHz.')
    process_vesa_modes(b, ranges, csync)
    process_standard_modes(b, ranges, csync)
    fix_checksum(b, bios_hook(b, csync))
    out = bytes(b.data[:b.length]) + b.tail

    # O resultado passa pelas mesmas conferencias, e a soma tem de ser a de antes.
    check = Bios(out)
    if check.device != b.device or not check.patched or checksum(check.data) != b.checksum:
        raise Atom15Error('The patched image did not pass the check. Nothing was written.')
    if out[0x48:0x4a] != bytes(image[0x48:0x4a]):
        raise Atom15Error('The patched image did not pass the check. Nothing was written.')
    return out, b.log


def info(image):
    b = Bios(image)
    print('device=%04x' % b.device)
    print('vendor=%04x' % b.vendor)
    print('class=%s' % (pci_class(b.device) or 'unknown'))
    print('size=%d' % len(image))
    print('legacy_size=%d' % (b.data[2] * 512))
    print('efi=%d' % (0 if b.gop is None else 1))
    print('patched=%d' % int(b.patched))


def adapter(text, bus, dev):
    """A linha da placa na lista do amdvbflash -i: o numero, o tamanho da ROM e
    o teste dele. As colunas de nome (asic, flash) tem espacos, entao o tamanho e
    o que vem antes do teste; com ou sem a coluna do segmento:
      adapter bn dn dID       asic           flash      romsize test    bios p/n
      ======= == == ==== =============== ============== ======= ==== ============
         0    01 00 6613 Oland           W25X20          40000 pass  113-...
    """
    columns = None
    found = []
    for line in text.splitlines():
        fields = line.split()
        if {'adapter', 'bn', 'dn'} <= set(fields):
            columns = fields
            continue
        if not columns or not fields or not fields[0].isdigit() or len(fields) <= columns.index('dn'):
            continue
        try:
            if int(fields[columns.index('bn')], 16) != bus or int(fields[columns.index('dn')], 16) != dev:
                continue
        except ValueError:
            continue
        size, test = 0, '-'
        for i in range(len(fields) - 1, columns.index('dn'), -1):
            if fields[i].lower() in ('pass', 'fail', 'failed', 'bad', 'error'):
                test = fields[i].lower()
                try:
                    size = int(fields[i - 1], 16)
                except ValueError:
                    size = 0
                break
        found.append('%s %d %s' % (fields[0], size, test))
    if len(found) != 1:
        raise Atom15Error('The flash tool does not list this card (%02x:%02x).' % (bus, dev))
    print(found[0])


def main():
    parser = argparse.ArgumentParser(description='ATOM-15 BIOS patch')
    sub = parser.add_subparsers(dest='command', required=True)
    p = sub.add_parser('info')
    p.add_argument('rom')
    p = sub.add_parser('patch')
    p.add_argument('rom')
    p.add_argument('out')
    p.add_argument('--ranges', default='15')
    p.add_argument('--csync', action='store_true')
    p.add_argument('--log')
    p = sub.add_parser('adapter')
    p.add_argument('bus')
    p.add_argument('dev')
    args = parser.parse_args()
    try:
        if args.command == 'adapter':
            adapter(sys.stdin.read(), int(args.bus, 16), int(args.dev, 16))
            return 0
        with open(args.rom, 'rb') as f:
            image = f.read()
        if args.command == 'info':
            info(image)
            return 0
        ranges = {int(r) for r in args.ranges.split(',') if r}
        out, log = patch(image, ranges, args.csync)
        with open(args.out, 'wb') as f:
            f.write(out)
        if args.log:
            with open(args.log, 'w') as f:
                f.write('\n'.join(log) + '\n')
    except (Atom15Error, OSError, ValueError, struct.error, IndexError) as exc:
        print(str(exc), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
