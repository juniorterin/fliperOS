class Atom15Error(Exception):
    pass


def pci_class(device):
    """avivo, dce4 ou dce8 (ASIC_IS_DCE4 e ASIC_IS_DCE8); None fora da tabela."""
    text = '%04x' % device
    for name, ids in PCI_CLASSES.items():
        if text in ids.split():
            return name
    return None


def pb_round(value):
    """O que o PowerBASIC faz ao gravar um Double num Long: arredonda para o par
    (o round do Python, o mesmo do Round() dele)."""
    return int(round(value))


def x(value):
    """O PowerBASIC faz as contas nos 80 bits do x87 e so arredonda para 64 ao
    gravar a variavel. Sem isso o resultado muda: 15625 * 0.00128 da 19,99... la
    (o Int dele da 19) e 20.0 num double (uma linha a mais no 640x480, conferida
    numa BIOS feita pelo atom-15.exe, tools/atom15-check.py). A Fraction e a conta
    sem perda, o mais perto disso."""
    return Fraction(value)


def word(data, offset):
    return struct.unpack_from('<H', data, offset)[0]


def poke_word(data, offset, value):
    struct.pack_into('<H', data, offset, value & 0xffff)


def poke_dword(data, offset, value):
    struct.pack_into('<I', data, offset, value & 0xffffffff)


def checksum(data):
    """A soma dos bytes da parte legada, em 16 bits (compute_checksum)."""
    return sum(data[:data[2] * 512]) & 0xffff


class Bios:
    """A imagem e os ponteiros dela (atombios_get_info)."""

    def __init__(self, image):
        self.tail = bytes(image[BIOS_MAX_SIZE:])
        self.length = min(BIOS_MAX_SIZE, len(image))
        self.data = bytearray(image[:self.length]) + bytearray(BIOS_MAX_SIZE - self.length)
        data = self.data
        if self.length < 0x200 or data[0] != 0x55 or data[1] != 0xaa:
            raise Atom15Error('Not a video BIOS image (no 55 AA signature).')
        if data[2] == 0 or data[2] * 512 > self.length:
            raise Atom15Error('The size written in the BIOS image is wrong.')
        if checksum(data) & 0xff:
            raise Atom15Error('The checksum of the BIOS image is wrong: a bad read of the card?')
        if data[BIOS_ENTRY_POINT] != 0xe9:
            raise Atom15Error('BIOS entry point not recognized.')

        self.rom_header = word(data, 0x48)
        if self.rom_header + 36 > self.length or bytes(data[self.rom_header + 4:self.rom_header + 8]) != b'ATOM':
            raise Atom15Error('ATOM signature not found.')
        self.int10 = word(data, self.rom_header + 18)
        pci_info = word(data, self.rom_header + 28)
        master_data = word(data, self.rom_header + 32)
        self.vendor = word(data, pci_info + 4)
        self.device = word(data, pci_info + 6)
        self.vesa_timing = word(data, master_data + 10)
        self.vesa_lut = word(data, master_data + 30)
        self.checksum = checksum(data)
        self.patched = HOOK_MARK in data

        # Numa BIOS ja com o patch a assinatura da tabela pode ter mudado (o modo 0
        # em 31 kHz tem outra altura de caractere): quem precisa dela e o patch.
        self.vpt = bytes(data).find(bytes((0x28, 0x18, 0x08, 0x00)))
        self.old_modes = self.vpt >= 0 and data[self.vpt + 64] == 80
        self.num_standard = 20 if self.old_modes else 29

        lut_size = word(data, self.vesa_lut)
        timing_size = word(data, self.vesa_timing)
        self.num_vesa_modes = (lut_size - 4) // 4
        self.vesa_old = (timing_size - 4) % 28 != 0
        self.timing_bytes = 32 if self.vesa_old else 28
        self.num_vesa_timings = (timing_size - 4) // self.timing_bytes

        vesa_check = bytes(data).find(bytes((0x80, 0xfc, 0x4f)), max(self.int10 - 1, 0))
        if vesa_check < 0:
            raise Atom15Error('Vesa check point not found.')
        self.standard_call = vesa_check + 10
        if data[self.standard_call] != 0xe8:
            raise Atom15Error('Standard video service proc not found.')
        self.standard_proc = (word(data, self.standard_call + 1) + self.standard_call + 3) & 0xffff
        self.vesa_call = vesa_check + 5
        if data[self.vesa_call] != 0xe8:
            raise Atom15Error('Vesa video service proc not found.')
        self.vesa_proc = (word(data, self.vesa_call + 1) + self.vesa_call + 3) & 0xffff

        init = word(data, BIOS_ENTRY_POINT + 1) + BIOS_ENTRY_POINT + 3
        at = bytes(data[init:init + 256]).find(b'\xa3')
        if at < 0:
            raise Atom15Error('PCI Bus offset not found.')
        self.pci_bus = word(data, init + at + 1)

        mcuc = bytes(data).find(b'MCuC')
        self.mcuc_offset = mcuc - 8 if mcuc >= 0 else None
        self.mcuc_block = struct.unpack_from('<I', data, self.mcuc_offset)[0] if mcuc >= 0 else None

        end = data[2] * 512
        self.gop = end if bytes(data[end + 28:end + 32]) == b'PCIR' else None

        self.table = bytearray(276)     # standard(19) e vesa(255) do original
        self.log = []


def vertical_times(r):
    """Os tempos verticais em segundos e a soma deles (set_monitor_range)."""
    vfp, vsp, vbp = (float(Fraction(str(v)) / 1000) for v in r[7:10])
    return vfp, vsp, vbp, float(x(vfp) + x(vsp) + x(vbp))


def modedef_adjust(m, r, c_dots, c_lines, clock_select, hh, hs, he, ht, vv, scan_type, csync):
    """As contas de um modo padrao numa faixa. False: fora da faixa."""
    vmin, vmax = r[2], r[3]
    vfp, vsp, vbp, blank = vertical_times(r)
    m['dots_per_char'] = c_dots
    m['lines_per_char'] = c_lines
    if scan_type & SCAN_TEXT:
        m['scan_doubling'] = 0
        m['maximum_scan_line'] = c_lines - 1
        m['cursor_end'] = m['maximum_scan_line'] - 1
        m['cursor_start'] = m['cursor_end'] - 1
    else:
        kind = scan_type & 0x07f
        m['scan_doubling'] = 1 if kind in (SCAN_TYPE_2, SCAN_TYPE_3) else 0
        m['maximum_scan_line'] = 1 if kind in (SCAN_TYPE_1, SCAN_TYPE_3) else 0
    m['interlace'] = 1 if scan_type & SCAN_INTERLACE else 0
    interlace = 2 if m['interlace'] else 1

    m['horizontal_display_end'] = hh - 1
    m['horizontal_retrace_start'] = hs
    m['horizontal_retrace_end'] = he
    m['horizontal_total'] = ht
    m['horizontal_blanking_start'] = hh + 1
    m['horizontal_blanking_end'] = ht - 1

    m['clock_select'] = clock_select & 0x07f
    m['dotclock_div'] = 1 if clock_select & CLOCK_DIV_2 else 0
    dotclock = x(CLOCK_MHZ[m['clock_select']])
    hfreq = float(dotclock / (2 if m['dotclock_div'] else 1) * 1000000 / (ht * c_dots))
    vfreq = float(min(x(hfreq) / (Fraction(vv, interlace) + round(x(hfreq) * x(blank))), x(vmax)))
    if vfreq < vmin:
        return False
    m['hfreq'], m['vfreq'] = hfreq, vfreq

    half = Fraction(1, 2) if interlace == 2 else 0
    field_active = Fraction(vv, interlace)
    field_total = round(x(hfreq) / x(vfreq)) + half
    field_blank = math.floor(x(hfreq) * x(blank)) + half
    field_padding = field_total - field_blank - field_active

    m['vertical_display_end'] = vv
    m['vertical_retrace_start'] = pb_round(vv + (max(round(x(hfreq) * x(vfp)), 1) + field_padding / 2) * interlace)
    m['vertical_retrace_end'] = m['vertical_retrace_start'] + max(round(x(hfreq) * x(vsp)), 1) * interlace
    m['vertical_total'] = pb_round(field_total * interlace)
    m['vertical_blanking_start'] = vv + 1
    m['vertical_blanking_end'] = m['vertical_total'] - 1
    m['hsync_polarity'] = 1 if csync else 0
    m['vsync_polarity'] = 1 if csync else 0
    return True


