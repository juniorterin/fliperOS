#!/usr/bin/env bash
# Pixelcade (pixelcade.org): o marquee de LED ou LCD do gabinete mostra o
# jogo selecionado no frontend e o jogo aberto.
#
# Quem fala com o marquee pela USB e o pixelweb, programa de codigo fechado
# do Pixelcade, com uma API REST em localhost:8080. Ele e a arte nao vem na
# imagem: o Setup > Games > Extras os baixa (fetch) para ~/pixelcade, a pasta que o
# proprio Pixelcade documenta (o --install-artpack roda la). O servico
# fliperos-pixelcade.service o mantem aberto, e a udev o liga quando o
# marquee e conectado.
#
# Os eventos chegam por tres caminhos:
#   - o fliperos-kms-run e o fliperos-x11-run (todo jogo de todo frontend e
#     emulador passa por eles): "launch" com a linha de comando do jogo. O
#     launch fica esperando o jogo fechar (end) e, no RetroArch, le as
#     conquistas (RetroAchievements) do log dele;
#   - o ES-DE: os scripts de evento game-select, system-select,
#     screensaver-start e screensaver-end (esde);
#   - o Attract-Mode Plus: o plugin Pixelcade (attract, screensaver).
# Sao os eventos dos scripts do proprio Pixelcade para o EmulationStation
# (github.com/alinke/pixelcade-linux, batocera/scripts), com as mesmas
# chamadas a API.
#
# Os mesmos eventos vao para um ZeDMD (DMD de LED open source), se o Setup > System >
# Extras > ZeDMD baixou o dmdserver (libdmdutil) para ~/zedmd: o
# fliperos-dmd desenha a imagem e o fliperos-zedmd.service abre o servidor.
#
#   fliperos-pixelcade fetch [--progress]          baixa o pixelweb, a arte e o hi2txt (de novo: atualiza)
#   fliperos-pixelcade artpack CODIGO [--progress] instala o pacote de arte pago do Pixelcade (o codigo da compra)
#   fliperos-pixelcade installed                   status 0 se o pixelweb esta baixado
#   fliperos-pixelcade daemon                      o servico: liga os frontends e abre o pixelweb
#   fliperos-pixelcade fetch-zedmd [--progress]    baixa o dmdserver do ZeDMD
#   fliperos-pixelcade zedmd-installed             status 0 se o dmdserver e o Pillow estao la
#   fliperos-pixelcade zedmd-daemon                o servico do ZeDMD: abre o dmdserver
#   fliperos-pixelcade fetch-doflinx [--progress]  baixa o DOFLinx (efeitos durante o jogo)
#   fliperos-pixelcade doflinx-installed           status 0 se o DOFLinx esta baixado
#   fliperos-pixelcade doflinx-daemon              o servico do DOFLinx
#   fliperos-pixelcade frontends                   scripts do ES-DE e plugin do Attract-Mode Plus
#   fliperos-pixelcade launch PROGRAMA [ARGS...]   o jogo da linha de comando, se houver
#   fliperos-pixelcade now                         o jogo que ja esta aberto (o marquee do OBS ligado no meio dele)
#   fliperos-pixelcade esde EVENTO [ARGS...]       os argumentos de um evento do ES-DE
#   fliperos-pixelcade attract EMULADOR ROM        o jogo selecionado no Attract-Mode Plus
#   fliperos-pixelcade game|select SISTEMA ROM [TITULO]   o marquee do jogo (aberto | selecionado)
#   fliperos-pixelcade end SISTEMA ROM             o jogo fechou: volta ao marquee da selecao
#   fliperos-pixelcade system SISTEMA              o marquee do sistema
#   fliperos-pixelcade logo SISTEMA [ANTERIOR [PASSO]]   a troca de sistema no frontend do FliperOS: o logotipo entra deslizando e pisca duas vezes
#   fliperos-pixelcade screensaver start|stop      o modo attract, no protetor de tela do frontend
#   fliperos-pixelcade home                        saiu do frontend: a animacao do logo
#   fliperos-pixelcade achievement ID TITULO [DESCRICAO]   uma conquista do jogo aberto
#   fliperos-pixelcade cheevos                     status 0 se o RetroArch deve registrar as conquistas no log
#   fliperos-pixelcade versus V1 V2 P1 P2          o placar de uma partida versus (vitorias e pontos de cada lado)
#   fliperos-pixelcade bg COMANDO [ARGS...]        o mesmo comando em segundo plano (volta na hora)
#   fliperos-pixelcade panel                       status 0 se ha um painel instalado (Pixelcade ou ZeDMD)
#   fliperos-pixelcade bye pixelcade|zedmd         "Bye", quando o computador desliga
#   fliperos-pixelcade lcd-usb INTERFACE           o Pixelcade LCD ligado pela USB (root, pela udev)
set -uo pipefail
dir=${PIXELCADE_DIR:-/home/fliperos/pixelcade}
base_url=${PIXELCADE_URL:-https://github.com/alinke/pixelcade-linux-builds/raw/main/linux_amd64/pixelweb}
api=${PIXELCADE_API:-http://127.0.0.1:8080}
# hi2txt (le os recordes dos arquivos .hi do MAME; GPL, o mesmo que o
# instalador do Pixelcade usa), fixado por hash. Precisa do Java, que o Setup
# > Extras instala pelo apt.
hi2txt_url=${HI2TXT_URL:-https://github.com/alinke/pixelcade-linux/raw/main/hi2txt}
HI2TXT_JAR_SHA256="2ae74fd71e4fd0c8fa0cb52c6e9d18dfdb2c3aa0ca387f941138b3ef9f7c4e6f"
HI2TXT_ZIP_SHA256="84c5a0667e224186ebe513d613675c98d0c70ff5323145b9943b34e852aed7df"
# O logo do FliperOS que o marquee mostra ao ligar (fliperos-rootfs.sh).
logo=${PIXELCADE_LOGO:-/usr/local/share/fliperos/pixelcade/fliperos.png}
# A animacao do logo, no protetor de tela (o frontend parado) do Pixelcade e do ZeDMD.
idle_gif=${PIXELCADE_IDLE:-/usr/local/share/fliperos/pixelcade/zedmd-fliperos.gif}
# Onde os emuladores gravam os recordes (.hi): o GroovyMAME (plugin hiscore)
# e os cores de arcade do RetroArch.
hi_dirs=${HISCORE_DIRS:-/home/fliperos/.mame/hiscore:/opt/fliperos/saves/retroarch}
ra_cfg=${RA_CFG:-/home/fliperos/.config/retroarch/retroarch.cfg}
ra_log=${RA_LOG:-${FLIPEROS_LOGS:-/opt/fliperos/logs}/retroarch.log}
# Um jogo que fala direto com o painel (Visual Pinball) deixa aqui o pid
# dele: o pixelweb e o dmdserver soltam a porta ate ele fechar.
hold_file=${PIXELCADE_HOLD:-/tmp/fliperos-pixelcade.hold}
# O placar de uma partida versus (config/fliperos-versus) e o lado deste
# gabinete (versus= e versus_side= do fliperos.conf).
versus=${FLIPEROS_VERSUS:-/opt/fliperos/bin/fliperos-versus}
conf=${FLIPEROS_CONF:-/etc/fliperos/fliperos.conf}
# O Pixelcade LCD pela USB e uma placa de rede (gadget): ele e 169.254.100.1.
lcd_ip=${PIXELCADE_LCD_IP:-169.254.100.1}
lcd_host_ip=${PIXELCADE_LCD_HOST_IP:-169.254.100.2}
# dmdserver do libdmdutil (github.com/vpinball/libdmdutil), fixado por hash.
DMDUTIL_VERSION="0.11.0"
DMDUTIL_SHA256="4c633689ef23237da6634f276a632773efd933c864eebead7c8d18d3f1bb394e"
zedmd_dir=${ZEDMD_DIR:-/home/fliperos/zedmd}
zedmd_url=${ZEDMD_URL:-https://github.com/vpinball/libdmdutil/releases/download/v${DMDUTIL_VERSION}/libdmdutil-${DMDUTIL_VERSION}-linux-x64.tar.gz}
zedmd_device=${ZEDMD_DEVICE:-/dev/zedmd}
# DOFLinx (doflinx.github.io, codigo fechado): efeitos no marquee durante o
# jogo (placar, explosoes) nos arcades do FBNeo, pelo RetroArch. Vem do
# GitHub dele, com a configuracao que o Pixelcade publica.
doflinx_dir=${DOFLINX_DIR:-/home/fliperos/doflinx}
doflinx_url=${DOFLINX_URL:-https://codeload.github.com/DOFLinx/CurrentExecutable/tar.gz/refs/heads/main}
doflinx_cfg_url=${DOFLINX_CFG_URL:-https://github.com/alinke/pixelcade-linux-builds/raw/main/rcade}
ra_doflinx=${RA_DOFLINX_CFG:-/etc/fliperos/retroarch/doflinx.cfg}
dmd=${FLIPEROS_DMD:-/opt/fliperos/bin/fliperos-dmd}
syslogo=${FLIPEROS_SYSLOGO:-/opt/fliperos/bin/fliperos-syslogo}
user=${FLIPEROS_USER:-fliperos}
roms=${ROMS_DIR:-/home/fliperos/roms}
ra_info=${RA_INFO_DIR:-/opt/fliperos/retroarch/info}
esde_dir=${ESDE_DIR:-/home/fliperos/ES-DE}
attract_dir=${ATTRACT_DIR:-/home/fliperos/.attract}
plugin_src=${PIXELCADE_PLUGIN_SRC:-/usr/local/share/fliperos/attractplus-plugins/Pixelcade}
last_file=${XDG_RUNTIME_DIR:-/tmp}/fliperos-pixelcade.last
self=$(readlink -f -- "${BASH_SOURCE[0]}")

progress=0 fail_label=Pixelcade
# As etapas vao de PIXELCADE_PROGRESS_FROM a 100 (o Setup > Games > Extras instala
# pacotes pelo apt antes).
from=${PIXELCADE_PROGRESS_FROM:-0}
say() {
  if ((progress)); then printf '@step %s %s\n' "$((from + $1 * (100 - from) / 100))" "$2"; else printf '%s\n' "$2"; fi
}
fail() {
  if ((progress)); then printf '@fail %s|%s\n' "$fail_label" "$1"; else printf 'fliperos-pixelcade: %s\n' "$1" >&2; fi
  exit 1
}

installed() {
  [[ -x $dir/pixelweb ]]
}

zedmd_installed() {
  [[ -x $zedmd_dir/dmdserver ]]
}

doflinx_installed() {
  [[ -x $doflinx_dir/DOFLinx ]]
}

# -- O marquee para o OBS --------------------------------------------
# Com marquee_overlay=on no fliperos.conf (Setup e painel web), cada evento
# grava o que o marquee mostra em $XDG_RUNTIME_DIR/fliperos-marquee
# ("chave=valor"), que a pagina /overlay/marquee do painel web desenha. Nao
# precisa de Pixelcade nem de ZeDMD: a arte vem de ~/media, como no ZeDMD (a
# do Pixelcade so pode ser usada no hardware dele).
overlay_file=${XDG_RUNTIME_DIR:-/tmp}/fliperos-marquee

overlay_on() {
  [[ $(sed -n 's/^marquee_overlay=//p' "$conf" 2> /dev/null | tail -n 1) == on ]]
}

# overlay EVENTO SISTEMA ROM TITULO TEXTO [CHAVE=VALOR...]: EVENTO e game,
# select, system, achievement, attract ou versus; sem TITULO, o das listas.
overlay() {
  local tmp title=${4:-} text=${5:-} kv
  overlay_on || return 0
  [[ -z $title && -n ${3:-} && $1 != achievement ]] && title=$(title_of "$3")
  tmp=$(mktemp "$overlay_file.XXXXXX" 2> /dev/null) || return 0
  {
    printf 'event=%s\nsystem=%s\nrom=%s\n' "$1" "${2:-}" "${3:-}"
    printf 'title=%s\ntext=%s\n' "${title//$'\n'/ }" "${text//$'\n'/ }"
    for kv in "${@:6}"; do printf '%s\n' "${kv//$'\n'/ }"; done
    printf 'time=%s\n' "$(date +%s)"
  } > "$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$overlay_file" 2> /dev/null || rm -f "$tmp"
}

# -- Instalacao ------------------------------------------------------

fetch() {
  local part="$dir/.pixelweb.part" rc
  [[ ${1:-} == --progress ]] && progress=1
  # Pelo Setup (root): a pasta e do usuario e o download roda como ele; o
  # servico so sobe depois, como root.
  if ((EUID == 0)) && [[ $user != root ]]; then
    mkdir -p "$dir" && chown "$user:" "$dir" || fail "could not create $dir"
    runuser -u "$user" -- env PIXELCADE_AS_ROOT=1 "$self" fetch "$@" || exit 1
    systemctl daemon-reload 2> /dev/null
    systemctl enable fliperos-pixelcade.service > /dev/null 2>&1
    systemctl restart fliperos-pixelcade.service 2> /dev/null
    say 100 "Pixelcade $(cd "$dir" && ./pixelweb -version 2> /dev/null | sed -n 's/^Pixelweb version: //p') installed"
    return 0
  fi
  mkdir -p "$dir" 2> /dev/null && [[ -w $dir ]] || fail "$dir is not writable"
  say 0 "Downloading pixelweb from GitHub (alinke/pixelcade-linux-builds)"
  if ! curl -sSfL --retry 3 --max-time 900 -o "$part" "$base_url" >&2; then
    rm -f "$part"
    fail "the download failed (no network?)"
  fi
  if [[ $(head -c 4 "$part" | od -An -c | tr -d ' ') != '177ELF' ]]; then
    rm -f "$part"
    fail "the downloaded file is not the pixelweb program"
  fi
  chmod 755 "$part" && mv -f "$part" "$dir/pixelweb" || fail "could not write $dir/pixelweb"
  # O pixelweb da porta 8080 segura a pasta: o servico para durante a arte.
  curl -s -m 2 -o /dev/null "$api/quit" 2> /dev/null
  say 10 "Downloading the Pixelcade artwork"
  # A primeira vez instala; com a arte ja la ele sai com 2, e entao atualiza.
  # O progresso sai como "N%" no stdout: de 10% a 95%.
  (cd "$dir" && ./pixelweb -p "$dir" -install-artwork -progress-installer -progress-stdout) 2>&1 | artwork_progress
  rc=${PIPESTATUS[0]}
  if ((rc == 2)); then
    say 10 "Updating the Pixelcade artwork"
    (cd "$dir" && ./pixelweb -p "$dir" -update-artwork -progress-installer -progress-stdout) 2>&1 | artwork_progress
    rc=${PIPESTATUS[0]}
  fi
  ((rc == 0)) || fail "the artwork download failed (details in the log)"
  say 95 "Downloading hi2txt (high scores)"
  fetch_hi2txt || echo "fliperos-pixelcade: hi2txt was not installed; the marquee works without the high scores" >&2
  # O placar das partidas versus: os detectores do Fightcade (sem eles, so
  # nao ha placar).
  [[ -x $versus ]] && { "$versus" fetch >&2 || echo "fliperos-pixelcade: the versus detectors were not downloaded" >&2; }
  say 96 "Frontend events (ES-DE, Attract-Mode Plus)"
  frontends
  # Pelo Setup, quem fecha e o root, depois de abrir o servico.
  [[ -n ${PIXELCADE_AS_ROOT:-} ]] && return 0
  say 100 "Pixelcade installed (sudo systemctl restart fliperos-pixelcade starts it)"
}

# artpack CODIGO [--progress]: o pacote de arte pago do Pixelcade LED, com o
# codigo de licenca que a pessoa recebeu na compra. E o
# "pixelweb -install-artpack CODIGO" do guia do Pixelcade, com o servico
# parado enquanto baixa (o pixelweb da porta 8080 segura a pasta). Quem
# confere o codigo e o servidor do Pixelcade.
artpack() {
  local code=${1:-} out rc
  fail_label="Pixelcade art pack"
  [[ ${2:-} == --progress ]] && progress=1
  installed || fail "Pixelcade is not installed (Setup > Games > Extras > Pixelcade)"
  code=${code//[[:space:]]/}
  [[ -n $code ]] || fail "the license code is empty"
  [[ $code != -* ]] || fail "that is not a license code"
  if ((EUID == 0)) && [[ $user != root ]]; then
    runuser -u "$user" -- env PIXELCADE_AS_ROOT=1 "$self" artpack "$code" "${@:2}"
    rc=$?
    systemctl restart fliperos-pixelcade.service 2> /dev/null
    ((rc == 0)) || exit 1
    say 100 "Pixelcade art pack installed"
    return 0
  fi
  out=$(mktemp) || fail "could not create a temporary file"
  curl -s -m 2 -o /dev/null "$api/quit" 2> /dev/null
  say 5 "Checking the license code with Pixelcade"
  (cd "$dir" && ./pixelweb -p "$dir" -install-artpack "$code" -progress-installer -progress-stdout) 2>&1 |
    tee "$out" | artwork_progress
  rc=${PIPESTATUS[0]}
  if ((rc != 0)); then
    if grep -qi 'license is invalid' "$out"; then
      rm -f "$out"
      fail "Pixelcade did not accept this license code"
    fi
    rm -f "$out"
    fail "the art pack was not installed (no network? details in the log)"
  fi
  rm -f "$out"
  [[ -n ${PIXELCADE_AS_ROOT:-} ]] && return 0
  say 100 "Pixelcade art pack installed (sudo systemctl restart fliperos-pixelcade shows it)"
}

# fetch_hi2txt: o hi2txt.jar e a base dele (hi2txt.zip) em ~/pixelcade/hi2txt,
# onde o instalador do Pixelcade os poe. Sem eles o marquee so nao rola os
# recordes.
fetch_hi2txt() {
  local name sum part
  mkdir -p "$dir/hi2txt" || return 1
  for name in jar zip; do
    sum=$HI2TXT_JAR_SHA256
    [[ $name == zip ]] && sum=$HI2TXT_ZIP_SHA256
    part="$dir/hi2txt/.hi2txt.$name.part"
    if [[ -f $dir/hi2txt/hi2txt.$name ]] && echo "$sum  $dir/hi2txt/hi2txt.$name" | sha256sum -c --quiet - 2> /dev/null; then
      continue
    fi
    if ! curl -sSfL --retry 3 --max-time 300 -o "$part" "$hi2txt_url/hi2txt.$name" >&2 ||
      ! echo "$sum  $part" | sha256sum -c --quiet - >&2; then
      rm -f "$part"
      return 1
    fi
    mv -f "$part" "$dir/hi2txt/hi2txt.$name" || return 1
  done
}

artwork_progress() {
  local line last=-1 p
  while IFS= read -r line; do
    line=${line%$'\r'}
    if [[ $line =~ ^([0-9]+)%$ ]]; then
      p=$((10 + BASH_REMATCH[1] * 85 / 100))
      ((p != last)) && say "$p" "Downloading the Pixelcade artwork (${BASH_REMATCH[1]}%)"
      last=$p
    else
      printf '%s\n' "$line" >&2
    fi
  done
}

# fetch_zedmd: o dmdserver e as bibliotecas dele (o pacote do release, sem os
# testes) em ~/zedmd. O Pillow do fliperos-dmd vem do apt, pelo Setup > System >
# Extras (config/fliperos-extras).
fetch_zedmd() {
  local tgz rc
  [[ ${1:-} == --progress ]] && progress=1
  fail_label=ZeDMD
  if ((EUID == 0)) && [[ $user != root ]]; then
    mkdir -p "$zedmd_dir" && chown "$user:" "$zedmd_dir" || fail "could not create $zedmd_dir"
    runuser -u "$user" -- env PIXELCADE_AS_ROOT=1 "$self" fetch-zedmd "$@" || exit 1
    systemctl daemon-reload 2> /dev/null
    systemctl enable fliperos-zedmd.service > /dev/null 2>&1
    systemctl restart fliperos-zedmd.service 2> /dev/null
    say 100 "ZeDMD (dmdserver $DMDUTIL_VERSION) installed"
    return 0
  fi
  mkdir -p "$zedmd_dir" 2> /dev/null && [[ -w $zedmd_dir ]] || fail "$zedmd_dir is not writable"
  tgz="$zedmd_dir/.libdmdutil.tar.gz"
  say 60 "Downloading dmdserver $DMDUTIL_VERSION from GitHub (vpinball/libdmdutil)"
  if ! curl -sSfL --retry 3 --max-time 900 -o "$tgz" "$zedmd_url" >&2; then
    rm -f "$tgz"
    fail "the download failed (no network?)"
  fi
  if ! echo "$DMDUTIL_SHA256  $tgz" | sha256sum -c --quiet - >&2; then
    rm -f "$tgz"
    fail "the downloaded file is not the libdmdutil $DMDUTIL_VERSION package"
  fi
  say 90 "Unpacking dmdserver"
  tar -xzf "$tgz" -C "$zedmd_dir" --wildcards --exclude='test/*' --exclude='*_test*' --exclude='*.a' \
    'dmdserver' '*.so*' >&2
  rc=$?
  rm -f "$tgz"
  ((rc == 0)) && [[ -x $zedmd_dir/dmdserver ]] || fail "could not unpack dmdserver into $zedmd_dir"
  # O placar das partidas versus: os detectores do Fightcade (sem eles, so
  # nao ha placar).
  [[ -x $versus ]] && { "$versus" fetch >&2 || echo "fliperos-pixelcade: the versus detectors were not downloaded" >&2; }
  say 96 "Frontend events (ES-DE, Attract-Mode Plus)"
  frontends
  [[ -n ${PIXELCADE_AS_ROOT:-} ]] && return 0
  say 100 "ZeDMD installed (sudo systemctl restart fliperos-zedmd starts it)"
}

# zedmd_config: o dmdserver.ini. So o ZeDMD (o Pixelcade e do pixelweb), sem
# colorizacao de pinball. A udev (99-fliperos-zedmd.rules) da o nome
# /dev/zedmd ao conversor USB-serial do ESP32; sem ele, o dmdserver procura
# o ZeDMD em todas as portas seriais USB.
zedmd_config() {
  local device=""
  [[ -e $zedmd_device ]] && device=$zedmd_device
  cat > "$zedmd_dir/dmdserver.ini" << EOF
; FliperOS: gerado pelo fliperos-pixelcade zedmd-daemon a cada inicio.
[DMDServer]
Addr = 127.0.0.1
Port = 6789
AltColor = 0
PUPCapture = 0

[ZeDMD]
Enabled = 1
Device = $device
Debug = 0
RGBOrder = -1
Brightness = -1
SaveSettings = 0

[ZeDMD-WiFi]
Enabled = 0

[ZeDMD-SPI]
Enabled = 0

[Pixelcade]
Enabled = 0

[PIN2DMD]
Enabled = 0
EOF
}

# fetch_doflinx: o DOFLinx (so a pasta Linux_x64 do pacote) em ~/doflinx, a
# configuracao que o Pixelcade publica com as pastas do FliperOS, e os
# arquivos de jogo (.MAME) pelo pixelweb. O root liga o Network Command
# Interface do RetroArch, por onde o DOFLinx sabe o jogo aberto e le a
# memoria dele, e abre o servico.
fetch_doflinx() {
  local tgz rc name tmp
  [[ ${1:-} == --progress ]] && progress=1
  fail_label=DOFLinx
  installed || fail "install Pixelcade first (Setup > Games > Extras > Pixelcade)"
  if ((EUID == 0)) && [[ $user != root ]]; then
    mkdir -p "$doflinx_dir" && chown "$user:" "$doflinx_dir" || fail "could not create $doflinx_dir"
    runuser -u "$user" -- env PIXELCADE_AS_ROOT=1 "$self" fetch-doflinx "$@" || exit 1
    mkdir -p "$(dirname "$ra_doflinx")" &&
      printf '%s\n' '# FliperOS: o DOFLinx (Setup > Games > Extras) le o jogo aberto por aqui.' \
        'network_cmd_enable = "true"' 'network_cmd_port = "55355"' > "$ra_doflinx" ||
      fail "could not write $ra_doflinx"
    systemctl daemon-reload 2> /dev/null
    systemctl restart fliperos-pixelcade.service 2> /dev/null
    systemctl enable fliperos-doflinx.service > /dev/null 2>&1
    systemctl restart fliperos-doflinx.service 2> /dev/null
    say 100 "DOFLinx installed"
    return 0
  fi
  mkdir -p "$doflinx_dir/config" 2> /dev/null && [[ -w $doflinx_dir ]] || fail "$doflinx_dir is not writable"
  tgz="$doflinx_dir/.doflinx.tar.gz"
  say 0 "Downloading DOFLinx from GitHub (DOFLinx/CurrentExecutable, about 230 MB)"
  if ! curl -sSfL --retry 3 --max-time 1800 -o "$tgz" "$doflinx_url" >&2; then
    rm -f "$tgz"
    fail "the download failed (no network?)"
  fi
  say 60 "Unpacking DOFLinx"
  "$doflinx_dir/DOFLinxMsg" QUIT > /dev/null 2>&1
  tar -xzf "$tgz" -C "$doflinx_dir" --strip-components=2 --wildcards '*/Linux_x64/*' >&2
  rc=$?
  rm -f "$tgz"
  ((rc == 0)) && [[ $(head -c 4 "$doflinx_dir/DOFLinx" 2> /dev/null | od -An -c | tr -d ' ') == '177ELF' ]] ||
    fail "could not unpack DOFLinx into $doflinx_dir"
  chmod 755 "$doflinx_dir/DOFLinx" "$doflinx_dir/DOFLinxMsg" "$doflinx_dir/keycodes" 2> /dev/null
  say 70 "DOFLinx configuration"
  for name in DOFLinx.ini colours.ini; do
    tmp="$doflinx_dir/config/.$name.part"
    if ! curl -sSfL --retry 3 --max-time 120 -o "$tmp" "$doflinx_cfg_url/$name" >&2; then
      rm -f "$tmp"
      fail "the download of $name failed (no network?)"
    fi
    [[ $name == DOFLinx.ini ]] && doflinx_paths "$tmp"
    doflinx_keep "$tmp" "$doflinx_dir/config/$name"
  done
  say 80 "Downloading the DOFLinx game files"
  curl -s -m 2 -o /dev/null "$api/quit" 2> /dev/null
  (cd "$dir" && ./pixelweb -p "$dir" -update-doflinx) >&2 ||
    echo "fliperos-pixelcade: the DOFLinx game files were not updated; the ones of the artwork stay" >&2
  [[ -n ${PIXELCADE_AS_ROOT:-} ]] && return 0
  say 100 "DOFLinx installed (as root: fliperos-extras install doflinx turns the service on)"
}

# doflinx_paths ARQUIVO: as pastas do gabinete RCade, para o qual o Pixelcade
# publica o DOFLinx.ini, trocadas pelas do FliperOS. O Java e o do apt.
doflinx_paths() {
  local java
  java=$(command -v java) || java=/usr/bin/java
  sed -i -e "s|/rcade/share/pixelcade/jdk/bin/|${java%/*}/|g" \
    -e "s|/rcade/share/pixelcade/|$dir/|g" \
    -e "s|/rcade/share/roms/mame/|$roms/retroarch/fbneo/|g" \
    -e "s|/rcade/share/saves/fbneo/|${hi_dirs##*:}/fbneo/|g" \
    -e 's|Config file for DOFLinx Linux on RCade|Config file for DOFLinx Linux on FliperOS|' "$1"
}

# doflinx_keep NOVO DESTINO: a configuracao nova entra se a que esta la e a
# que o FliperOS gravou (o hash fica ao lado); uma alterada pela pessoa fica,
# e a nova vai para DESTINO.latest.
doflinx_keep() {
  local new=$1 dest=$2 hash="${2%/*}/.${2##*/}.sha256" sum
  sum=$(sha256sum < "$new")
  if [[ ! -f $dest || $(sha256sum < "$dest") == "$(cat "$hash" 2> /dev/null)" ]]; then
    mv -f "$new" "$dest" && printf '%s\n' "$sum" > "$hash"
    rm -f "$dest.latest"
  elif [[ $(sha256sum < "$dest") == "$sum" ]]; then
    rm -f "$new"
  else
    mv -f "$new" "$dest.latest"
  fi
}

# -- Pixelcade LCD pela USB -----------------------------------------

# lcd_ini: o pixelcade.ini com o LCD da USB ligado e o nome dele, como o
# instalador do Pixelcade faz. Escreve "changed" se o arquivo mudou.
lcd_ini() {
  local ini="$dir/pixelcade.ini" before host
  [[ -f $ini ]] || return 1
  before=$(cksum < "$ini")
  sed -i -e 's/^lcdMarquee[ ]*=.*/lcdMarquee = true/' -e 's/^lcdUsbConnected[ ]*=.*/lcdUsbConnected = true/' "$ini"
  host=$(curl -s --connect-timeout 5 -m 10 "http://$lcd_ip:8080/v2/info" 2> /dev/null |
    sed -n 's/.*"hostname":"\([^"]*\)".*/\1/p')
  [[ $host =~ ^[A-Za-z0-9._-]+$ ]] && sed -i "s|^lcdMarqueeHostName[ ]*=.*|lcdMarqueeHostName = $host|" "$ini"
  [[ $(cksum < "$ini") == "$before" ]] || echo changed
}

# lcd_usb INTERFACE: (root, pela udev) a placa de rede do LCD ganha o
# endereco que o pixelweb espera e fica fora do NetworkManager (a regra da
# udev); o pixelcade.ini passa a usar o LCD e o servico reabre.
lcd_usb() {
  local iface=${1:-} i changed
  [[ -n $iface ]] || fail "lcd-usb needs the network interface"
  ip link set "$iface" up && ip addr replace "$lcd_host_ip/16" dev "$iface" || fail "could not configure $iface"
  echo 1 > "/proc/sys/net/ipv6/conf/$iface/disable_ipv6" 2> /dev/null
  installed || return 0
  # O pixelweb cria o pixelcade.ini na primeira vez que abre.
  if [[ ! -f $dir/pixelcade.ini ]]; then
    systemctl reset-failed fliperos-pixelcade.service 2> /dev/null
    systemctl start --no-block fliperos-pixelcade.service 2> /dev/null
    for i in {1..30}; do
      [[ -f $dir/pixelcade.ini ]] && break
      sleep 1
    done
  fi
  changed=$(runuser -u "$user" -- "$self" lcd-ini)
  if [[ -n $changed ]] || ! systemctl is-active -q fliperos-pixelcade.service; then
    systemctl reset-failed fliperos-pixelcade.service 2> /dev/null
    systemctl restart --no-block fliperos-pixelcade.service 2> /dev/null
  fi
  return 0
}

# -- Servicos ------------------------------------------------------

# serve PROGRAMA [ARGS...]: o programa do servico (pixelweb, dmdserver). Se
# ele fecha porque um jogo que fala direto com o painel abriu (dmd_hold),
# espera o jogo fechar e o abre de novo; senao sai com o status dele.
serve() {
  local rc pid
  while :; do
    "$@"
    rc=$?
    pid=$(cat "$hold_file" 2> /dev/null) || return "$rc"
    while [[ $pid =~ ^[0-9]+$ && -e $hold_file ]] && kill -0 "$pid" 2> /dev/null; do
      sleep 2
    done
    rm -f "$hold_file"
  done
}

# dmd_hold PID: o pixelweb e o dmdserver soltam a porta do painel para o jogo
# PID (o Visual Pinball desenha o DMD ele mesmo, pela mesma porta serial).
dmd_hold() {
  printf '%s\n' "$1" > "$hold_file" 2> /dev/null || return 0
  call quit
  zedmd_installed && pkill -x -u "$(id -u)" dmdserver 2> /dev/null
  return 0
}

# bye pixelcade|zedmd: o ExecStop dos servicos. So quando o computador esta
# desligando ou reiniciando; numa reabertura do servico, nada.
bye() {
  [[ ${PIXELCADE_STOPPING:-$(systemctl is-system-running 2> /dev/null)} == stopping ]] || return 0
  if [[ ${1:-} == zedmd ]]; then
    [[ -x $dmd ]] && "$dmd" text Bye < /dev/null > /dev/null 2>&1
  else
    call "text?t=Bye"
    sleep 2
  fi
  return 0
}

# -- Frontends ------------------------------------------------------

# frontends: os scripts de evento do ES-DE e o plugin do Attract-Mode Plus.
# Com o frontend aberto a configuracao dele nao muda (ele a regrava ao
# fechar); fica para a proxima vez (o servico roda isto a cada boot).
frontends() {
  if [[ -d $esde_dir ]]; then
    local event
    for event in game-select system-select screensaver-start screensaver-end; do
      mkdir -p "$esde_dir/scripts/$event"
      printf '#!/bin/sh\n# FliperOS: o marquee do Pixelcade (config/fliperos-pixelcade).\nexec %s esde %s "$@"\n' \
        "$self" "$event" > "$esde_dir/scripts/$event/fliperos-pixelcade"
      chmod 755 "$esde_dir/scripts/$event/fliperos-pixelcade"
    done
    if ! pgrep -x es-de > /dev/null 2>&1; then
      esde_setting CustomEventScripts true
      esde_setting CustomEventScriptsBrowsing true
      esde_setting CustomEventScriptsBrowsingNonBlocking true
    fi
  fi
  if [[ -d $attract_dir && -f $plugin_src/plugin.nut ]]; then
    mkdir -p "$attract_dir/plugins/Pixelcade"
    cp -f "$plugin_src/plugin.nut" "$attract_dir/plugins/Pixelcade/plugin.nut"
    pgrep -x attractplus > /dev/null 2>&1 || attract_enable
  fi
  return 0
}

# esde_setting NOME true|false: uma opcao bool do es_settings.xml.
esde_setting() {
  local settings="$esde_dir/settings/es_settings.xml" line="<bool name=\"$1\" value=\"$2\" />"
  mkdir -p "$esde_dir/settings"
  if [[ ! -f $settings ]]; then
    printf '<?xml version="1.0"?>\n%s\n' "$line" > "$settings"
  elif grep -q "name=\"$1\"" "$settings"; then
    sed -i "s|<bool name=\"$1\" value=\"[^\"]*\" />|$line|" "$settings"
  else
    printf '%s\n' "$line" >> "$settings"
  fi
}

# attract_enable: o plugin ligado. O Attract-Mode Plus 3.x le os plugins de
# config/plugins.cfg quando ha config/attract.cfg; antes da primeira
# execucao, do attract.cfg (que ele migra).
attract_enable() {
  local cfg="$attract_dir/attract.cfg"
  [[ -f $attract_dir/config/attract.cfg ]] && cfg="$attract_dir/config/plugins.cfg"
  if [[ -f $cfg ]] && grep -qE '^plugin[[:space:]]+Pixelcade[[:space:]]*$' "$cfg"; then
    return 0
  fi
  printf 'plugin\tPixelcade\n\tenabled              yes\n\n' >> "$cfg"
}

# -- Eventos ------------------------------------------------------

# system_of CAMINHO: o sistema do Pixelcade (a pasta da arte dele) de um
# jogo ou pasta de ~/roms. Os arcades (sets do MAME) sao "mame".
system_of() {
  local rel=${1#"$roms"/} folder core id
  [[ $rel != "$1" ]] || { basename -- "$(dirname -- "$1")"; return; }
  folder=${rel%%/*}
  case $folder in
    mame | naomi | naomi2 | atomiswave | model2 | model3 | fightcade) echo mame ;;
    dolphin) echo nintendo_gamecube ;;
    duckstation) echo psx ;;
    retroarch)
      core=${rel#retroarch/}
      core=${core%%/*}
      id=$(sed -n 's/^systemid *= *"\(.*\)"/\1/p' "$ra_info/${core}_libretro.info" 2> /dev/null | head -1)
      libretro_system "${id:-$core}"
      ;;
    *) echo "$folder" ;;
  esac
}

# libretro_system SYSTEMID: o systemid do .info de um core -> sistema do
# Pixelcade; os que tem o mesmo nome passam direto.
libretro_system() {
  case $1 in
    mame | hbmame | fb_alpha | fbneo | cps1 | cps2 | cps3) echo mame ;;
    super_nes) echo snes ;;
    playstation) echo psx ;;
    playstation2) echo ps2 ;;
    playstation_portable) echo psp ;;
    game_boy) echo gb ;;
    game_boy_color) echo gbc ;;
    game_boy_advance) echo gba ;;
    nintendo_64) echo n64 ;;
    gamecube) echo nintendo_gamecube ;;
    virtual_boy) echo nintendo_virtual_boy ;;
    mega_drive) echo genesis ;;
    master_system) echo mastersystem ;;
    game_gear) echo gamegear ;;
    mega_cd | sega_cd) echo segacd ;;
    sega_32x) echo sega32x ;;
    sega_saturn) echo sega_saturn ;;
    pc_engine) echo pcengine ;;
    atari_2600) echo atari2600 ;;
    atari_5200) echo atari5200 ;;
    atari_7800) echo atari7800 ;;
    atari_lynx) echo atarilynx ;;
    atari_jaguar) echo atarijaguar ;;
    commodore_amiga) echo amiga ;;
    commodore_c64) echo c64 ;;
    colecovision) echo coleco ;;
    cpc) echo amstradcpc ;;
    wonderswan) echo bandai_wonderswan ;;
    3do) echo panasonic_3do ;;
