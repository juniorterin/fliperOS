# system_of CAMINHO: o sistema do Pixelcade (a pasta da arte dele) de um
# jogo ou pasta de ~/roms. Os arcades (sets do MAME) sao "mame".
system_of() {
  local rel=${1#"$roms"/} folder core id
  [[ $rel != "$1" ]] || { basename -- "$(dirname -- "$1")"; return; }
  folder=${rel%%/*}
  case $folder in
    mame | naomi | naomi2 | atomiswave | model2 | model3 | fightcade) echo mame ;;
    dolphin) echo nintendo_gamecube ;;
    retroarch)
      core=${rel#retroarch/}
      core=${core%%/*}
      id=$(sed -n 's/^systemid *= *"\(.*\)"/\1/p' "$ra_info/${core}_libretro.info" 2> /dev/null | head -1)
      libretro_system "${id:-$core}"
      ;;
    *) echo "$folder" ;;
  esac
}

# libretro_system SYSTEMID: o systemid do .info de um core -> sistema do
# Pixelcade; os que tem o mesmo nome passam direto.
libretro_system() {
  case $1 in
    mame | hbmame | fb_alpha | fbneo | cps1 | cps2 | cps3) echo mame ;;
    super_nes) echo snes ;;
    playstation) echo psx ;;
    playstation2) echo ps2 ;;
    playstation_portable) echo psp ;;
    game_boy) echo gb ;;
    game_boy_color) echo gbc ;;
    game_boy_advance) echo gba ;;
    nintendo_64) echo n64 ;;
    gamecube) echo nintendo_gamecube ;;
    virtual_boy) echo nintendo_virtual_boy ;;
    mega_drive) echo genesis ;;
    master_system) echo mastersystem ;;
    game_gear) echo gamegear ;;
    mega_cd | sega_cd) echo segacd ;;
    sega_32x) echo sega32x ;;
    sega_saturn) echo sega_saturn ;;
    pc_engine) echo pcengine ;;
    atari_2600) echo atari2600 ;;
    atari_5200) echo atari5200 ;;
    atari_7800) echo atari7800 ;;
    atari_lynx) echo atarilynx ;;
    atari_jaguar) echo atarijaguar ;;
    commodore_amiga) echo amiga ;;
    commodore_c64) echo c64 ;;
    colecovision) echo coleco ;;
    cpc) echo amstradcpc ;;
    wonderswan) echo bandai_wonderswan ;;
    3do) echo panasonic_3do ;;
    *) echo "$1" ;;
  esac
}

# rom_of CAMINHO: o nome do jogo (o arquivo, sem pasta e extensao).
rom_of() {
  local name=${1##*/}
  printf '%s\n' "${name%.*}"
}

urlencode() {
  local LC_ALL=C s=$1 out="" c n i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case $c in
      [a-zA-Z0-9._~-]) out+=$c ;;
      *)
        printf -v n '%d' "'$c"
        ((n < 0)) && n=$((n + 256))
        printf -v c '%%%02X' "$n"
        out+=$c
        ;;
    esac
  done
  printf '%s\n' "$out"
}

call() {
  curl -s -m 3 -o /dev/null "$api/$1"
}

# game SISTEMA ROM: o jogo aberto, ate o proximo evento. O mesmo jogo de
# segundos antes e a mesma abertura (o groovymame do fliperos-kms-run ainda
# passa pelo fliperos-x11-run).
game() {
  [[ -n $1 && -n $2 ]] || return 0
  if [[ $(cat "$last_file" 2> /dev/null) == "game:$1/$2" ]] &&
    (($(date +%s) - $(stat -c %Y "$last_file" 2> /dev/null || echo 0) < 10)); then
    return 0
  fi
  printf 'game:%s/%s\n' "$1" "$2" > "$last_file" 2> /dev/null
  call "attract/stop"
  call "arcade/stream/$(urlencode "$1")/$(urlencode "$2")?l=99999&event=GameStart"
}

# select SISTEMA ROM: o jogo selecionado na lista. O mesmo de antes nao vai
# de novo (o marquee piscaria a cada volta da lista).
select_game() {
  [[ -n $1 && -n $2 ]] || return 0
  [[ $(cat "$last_file" 2> /dev/null) == "$1/$2" ]] && return 0
  printf '%s/%s\n' "$1" "$2" > "$last_file" 2> /dev/null
  call "arcade/stream/$(urlencode "$1")/$(urlencode "$2")?event=FEScroll"
}

system() {
  [[ -n $1 ]] || return 0
  printf 'system/%s\n' "$1" > "$last_file" 2> /dev/null
  call "console/stream/$(urlencode "$1")"
}

# launch PROGRAMA [ARGS...]: a linha de comando que o fliperos-kms-run ou o
# fliperos-x11-run recebeu. O jogo e o ultimo argumento: um arquivo de
# ~/roms, ou o nome do set no GroovyMAME e no Model 2 (o [name] dos
# frontends). Sem jogo (um frontend, o menu de um emulador), nada.
launch() {
  local prog last
  (($# >= 2)) || return 0
  prog=${1##*/}
  last=${*: -1}
  case $prog in
    groovymame | fliperos-model2)
      [[ $last == -* ]] && return 0
      game mame "$(rom_of "$last")"
      ;;
    *)
      [[ -f $last ]] || return 0
      game "$(system_of "$last")" "$(rom_of "$last")"
      ;;
  esac
}

# esde EVENTO ARGS...: game-select "rom" "nome" "sistema" "nome do sistema";
# system-select "sistema" "nome do sistema" "pasta". Com rolagem rapida o
# game-select chega vazio. No Linux o ES-DE escapa os espacos do caminho.
esde() {
  local event=$1 path
  shift
  case $event in
    game-select)
      path=${1:-}
      path=${path//\\/}
      [[ -n $path ]] || return 0
      select_game "$(system_of "$path")" "$(rom_of "$path")"
      ;;
    system-select)
      path=${3:-}
      path=${path//\\/}
      [[ -n $path ]] || return 0
      system "$(system_of "${path%/}/x")"
      ;;
  esac
}

# attract EMULADOR ROM: a pasta das ROMs vem do .cfg do emulador.
attract() {
  local rompath sys=mame
  rompath=$(awk '$1 == "rompath" { sub(/^[ \t]*rompath[ \t]+/, ""); print; exit }' \
    "$attract_dir/emulators/$1.cfg" 2> /dev/null)
  rompath=${rompath%%;*}
  [[ -n $rompath ]] && sys=$(system_of "${rompath%/}/x")
  select_game "$sys" "${2:-}"
}

cmd=${1:-}
shift
case $cmd in
  fetch) fetch "$@" ;;
  installed)
    installed
    exit $?
    ;;
  frontends) frontends ;;
  daemon)
    installed || { echo "fliperos-pixelcade: pixelweb is not installed (Setup > Extras)" >&2; exit 1; }
    frontends
    cd "$dir" || exit 1
    exec ./pixelweb -p "$dir" -startup
    ;;
  launch | esde | attract | game | select | system)
    installed || exit 0
    case $cmd in
      select) select_game "$@" ;;
      *) "$cmd" "$@" ;;
    esac
    ;;
  *)
    sed -n '18,26p' "$0" | sed 's/^# *//' >&2
    exit 1
    ;;
esac
exit 0
