# rom_of CAMINHO: o nome do jogo (o arquivo, sem pasta e extensao).
rom_of() {
  local name=${1##*/}
  printf '%s\n' "${name%.*}"
}

urlencode() {
  local LC_ALL=C s=$1 out="" c n i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case $c in
      [a-zA-Z0-9._~-]) out+=$c ;;
      *)
        printf -v n '%d' "'$c"
        ((n < 0)) && n=$((n + 256))
        printf -v c '%%%02X' "$n"
        out+=$c
        ;;
    esac
  done
  printf '%s\n' "$out"
}

call() {
  installed || return 0
  # Com holding=1 (a volta do protetor de tela), so guarda o pedido em held_calls.
  if [[ ${holding:-} == 1 ]]; then
    held_calls+=("$1")
    return 0
  fi
  curl -s -m 3 -o /dev/null "$api/$1"
}

# zedmd ARGS...: o fliperos-dmd em segundo plano (um GIF, um texto rolando ou
# o attract fica aberto ate o proximo evento).
zedmd() {
  zedmd_installed && [[ -x $dmd ]] || return 0
  setsid "$dmd" "$@" < /dev/null > /dev/null 2>&1 &
}

# title_of ROM [TITULO]: o nome do jogo, sem o que vem entre parenteses; sem
# TITULO, o das listas dos frontends (fliperos-dmd title).
title_of() {
  local title=${2:-}
  [[ -n $title ]] || title=$("$dmd" title "$1" 2> /dev/null)
  [[ -n $title ]] || title=$1
  title=${title%%[(\[]*}
  title=${title%"${title##*[![:space:]]}"}
  printf '%s\n' "${title:-$1}"
}

# highscores SISTEMA ROM: os tres primeiros recordes de um arcade ("#1
# 19,130 DAA #2 ..."), do arquivo .hi mais novo do jogo, lido pelo hi2txt.
# Status 1 sem recordes (ou sem o hi2txt ou o Java).
highscores() {
  local java hi line out="" i rank score name
  local -a dirs head=() cols
  [[ $1 == mame && -f $dir/hi2txt/hi2txt.jar && -f $dir/hi2txt/hi2txt.zip ]] || return 1
  java=$(command -v java) || return 1
  IFS=: read -r -a dirs <<< "$hi_dirs"
  hi=$(find "${dirs[@]}" -type f -name "$2.hi" -printf '%T@ %p\n' 2> /dev/null | sort -rn | head -1 | cut -d' ' -f2-)
  [[ -n $hi ]] || return 1
  # A primeira linha diz as colunas: RANK|SCORE|NAME (ha jogos sem NAME).
  while IFS= read -r line; do
    [[ $line == *'|'* ]] || continue
    if ((${#head[@]} == 0)); then
      IFS='|' read -r -a head <<< "$line"
      continue
    fi
    IFS='|' read -r -a cols <<< "$line"
    rank="" score="" name=""
    for i in "${!head[@]}"; do
      case ${head[i]} in
        RANK) rank=${cols[i]:-} ;;
        SCORE) score=${cols[i]:-} ;;
        NAME) name=${cols[i]:-} ;;
      esac
    done
    [[ $score =~ ^[0-9]+$ ]] || continue
    score=$(sed ':a;s/\B[0-9]\{3\}\>/,&/;ta' <<< "$score")
    out+="#${rank:-?} $score ${name% } "
  done < <(cd "$dir/hi2txt" && timeout 20 "$java" -jar hi2txt.jar -r "$hi" -max-lines 3 -max-columns 3 \
    -keep-field SCORE -keep-field NAME -keep-field RANK 2> /dev/null)
  [[ -n $out ]] || return 1
  printf '%s\n' "${out% }"
}

# game SISTEMA ROM [TITULO]: o jogo aberto. Primeiro rola uma vez os recordes
# do jogo, ou "Now Playing" e o nome dele; depois fica o marquee do jogo, ate
# o proximo evento. O mesmo jogo de segundos antes e a mesma abertura (o
# groovymame do fliperos-kms-run ainda passa pelo fliperos-x11-run): status 1.
game() {
  local title intro
  [[ -n ${1:-} && -n ${2:-} ]] || return 1
  if [[ $(cat "$last_file" 2> /dev/null) == "game:$1/$2" ]] &&
    (($(date +%s) - $(stat -c %Y "$last_file" 2> /dev/null || echo 0) < 10)); then
    return 1
  fi
  # O sistema escolhido no frontend do FliperOS (ele so manda o sistema): o
  # "end" o traz de volta, e nao o jogo como selecao.
  local before
  before=$(cat "$last_file" 2> /dev/null)
  if [[ $before == system/* ]]; then
    printf '%s\n' "${before#system/}" > "$last_file.system" 2> /dev/null
  else
    rm -f "$last_file.system"
  fi
  printf 'game:%s/%s\n' "$1" "$2" > "$last_file" 2> /dev/null
  rm -f "$last_file.versus"
  title=$(title_of "$2" "${3:-}")
  intro=$(highscores "$1" "$2") || intro="Now Playing $title"
  # O ZeDMD e o marquee do painel/OBS antes do Pixelcade: um pixelweb sem o
  # painel ligado so devolve cada pedido no fim dos 3 s do curl.
  zedmd show game "$1" "$2" "$title" "$intro"
  overlay game "$1" "$2" "$title" "$intro"
  if installed; then
    call "attract/stop"
    # A fila do pixelweb vazia: sem isto o texto espera o que estava nela.
    call "console/stream/black"
    sleep 1
    call "text?t=$(urlencode "$intro")&ss=1&l=1&scroll=true&game=$(urlencode "$2")&system=$(urlencode "$1")&event=GameStart"
    call "arcade/stream/$(urlencode "$1")/$(urlencode "$2")?l=99999&event=GameStart"
  fi
  return 0
}

# end SISTEMA ROM: o jogo fechou. O painel volta para o pixelweb e o
# dmdserver (dmd_hold), e o marquee para o sistema que o frontend do FliperOS
# tinha escolhido (o logotipo dele) ou, nos outros, para o do jogo como selecao
# do frontend: o Pegasus nao avisa o que esta selecionado.
game_end() {
  local system
  rm -f "$hold_file"
  [[ $(cat "$last_file" 2> /dev/null) == "game:${1:-}/${2:-}" ]] || return 0
  rm -f "$last_file"
  system=$(cat "$last_file.system" 2> /dev/null)
  rm -f "$last_file.system"
  if [[ -n $system ]]; then
    logo "$system"
    return 0
  fi
  select_game "$1" "$2"
}

# watch SISTEMA ROM PROGRAMA [CORE]: espera o jogo fechar e manda o "end". O jogo e o pai: o
# fliperos-kms-run e o fliperos-x11-run chamam o launch em segundo plano e
# viram o emulador (exec). No RetroArch com as conquistas ligadas, enquanto
# isso le as conquistas do log dele.
watch() {
  local pid=${PIXELCADE_GAME_PID:-$PPID}
  [[ $pid =~ ^[0-9]+$ ]] && ((pid > 1)) || return 0
  (
    # O placar de uma partida versus, se o jogo esta na tabela
    # (config/fliperos-versus): ele mesmo sai quando o jogo fecha.
    case ${3:-} in
      groovymame) source=mame ;;
      retroarch) source=retroarch ;;
      fliperos-model2 | sm2-emu) source=model2 ;;
      *) source="" ;;
    esac
    if [[ -n $source && -n $2 && -x $versus ]] && "$versus" has "$source" "$2" "${4:-}"; then
      "$versus" run "$source" "$2" "$pid" "${4:-}" &
    fi
    if [[ ${3:-} == retroarch ]] && cheevos; then
      cheevos_watch "$pid"
    else
      tail --pid="$pid" -f /dev/null
    fi
    "$self" end "$1" "$2"
  ) < /dev/null > /dev/null 2>&1 &
}

# versus_score VITORIAS1 VITORIAS2 PONTOS1 PONTOS2 [NOME1 NOME2]: o placar de
# uma partida versus (config/fliperos-versus; "-" = o jogo nao tem aquele
# valor). Cada lado aparece com o personagem que escolheu, se o jogo o diz
# (ate 10 letras), ou como P1 e P2. Cada gabinete mostra o proprio lado
# primeiro: o lado e o versus_side do fliperos.conf (1 ou 2), e com dois
# gabinetes ligados (versus=host ou join) os lados se chamam YOU e RIVAL. No
# ZeDMD o placar fica na tela; no Pixelcade, um texto a cada vitoria, e o
# marquee do jogo volta.
versus_score() {
  local mode side left=P1 right=P2 wl=${1:--} wr=${2:--} sl=${3:--} sr=${4:--} last
  [[ -n ${5:-} ]] && left=${5%% (*} && left=${left:0:10} && left=${left^^}
  [[ -n ${6:-} ]] && right=${6%% (*} && right=${right:0:10} && right=${right^^}
  mode=$(sed -n 's/^versus=//p' "$conf" 2> /dev/null | tail -1)
  side=$(sed -n 's/^versus_side=//p' "$conf" 2> /dev/null | tail -1)
  [[ -z $side && $mode == join ]] && side=2
  if [[ $side == 2 ]]; then
    set -- "$wr" "$wl" "$sr" "$sl" "$right" "$left"
    wl=$1 wr=$2 sl=$3 sr=$4 left=$5 right=$6
  fi
  [[ $mode == host || $mode == join ]] && left=YOU right=RIVAL
  zedmd versus "$left" "$wl" "$wr" "$right" "$sl" "$sr"
  last=$(cat "$last_file" 2> /dev/null)
  last=${last#game:}
  overlay versus "${last%%/*}" "${last#*/}" "" "" "left=$left" "right=$right" "wins_left=$wl" "wins_right=$wr" \
    "score_left=$sl" "score_right=$sr"
  [[ $wl$wr =~ ^[0-9]+$ ]] && ((wl + wr > 0)) || return 0
  [[ $(cat "$last_file.versus" 2> /dev/null) == "$wl $wr" ]] && return 0
  printf '%s %s\n' "$wl" "$wr" > "$last_file.versus" 2> /dev/null
  installed || return 0
  call "text?t=$(urlencode "$left $wl x $wr $right")&l=1&event=GameStart"
  last=$(cat "$last_file" 2> /dev/null)
  if [[ $last == game:*/* ]]; then
    last=${last#game:}
    call "arcade/stream/$(urlencode "${last%%/*}")/$(urlencode "${last#*/}")?l=99999&event=GameStart"
  fi
}

# cheevos: status 0 se o RetroArch tem as conquistas (RetroAchievements)
# ligadas e ha um painel para mostra-las. O fliperos-kms-run entao o abre com
# --verbose: so assim a conquista aparece no log.
cheevos() {
  installed || zedmd_installed || overlay_on || return 1
  grep -qE '^cheevos_enable[[:space:]]*=[[:space:]]*"true"' "$ra_cfg" 2> /dev/null
}

# cheevos_watch PID: as linhas "[RCHEEVOS] Awarding achievement ID: TITULO"
# do log do RetroArch (rc_client.c do rcheevos), ate ele fechar. O
# fliperos-kms-run esvazia o log ao abrir; o tail -F segue o arquivo novo.
cheevos_watch() {
  local line
  # O log da vez anterior ja foi esvaziado quando o tail comeca: nenhuma
  # conquista sai nos primeiros segundos do jogo.
  sleep 2
  tail --pid="$1" -n 0 -F "$ra_log" 2> /dev/null | while IFS= read -r line; do
    if [[ $line =~ \[RCHEEVOS\]\ (Awarding|Unlocked\ unofficial)\ achievement\ ([0-9]+):\ (.*)$ ]]; then
      achievement "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
    fi
  done
}

# achievement ID TITULO [DESCRICAO]: uma conquista do jogo aberto: o
# pixelweb mostra o emblema e o texto e volta ao marquee do jogo.
achievement() {
  local last sys="" rom="" text=${2:-}
  [[ -n ${1:-} && -n $text ]] || return 0
  [[ -n ${3:-} ]] && text+=" : $3"
  last=$(cat "$last_file" 2> /dev/null)
  if [[ $last == game:*/* ]]; then
    last=${last#game:}
    sys=${last%%/*} rom=${last#*/}
  fi
  zedmd show game "$sys" "$rom" "" "$text"
  overlay achievement "$sys" "$rom" "" "$text"
  call "achievements/stream/$(urlencode "${sys:-mame}")/$(urlencode "$1")?t=$(urlencode "$text")&currentgame=$(urlencode "$rom")"
}

# screensaver start|stop: o protetor de tela do frontend. No Pixelcade, o
# modo attract dele (a lista se monta em http://<ip>:8080); no ZeDMD, as
# artes de ~/media. Ao sair volta o que estava selecionado.
#
# Hoje os dois tocam a animacao do logo ($idle_gif): o ZeDMD pelo
# fliperos-dmd attract, o Pixelcade pela pasta console (como o logotipo do
# sistema). Sem a animacao, o Pixelcade volta ao modo attract dele.
idle_show() {
  zedmd attract
  overlay attract
  if installed && [[ -f $idle_gif && -d $dir/console ]] &&
    cp -f "$idle_gif" "$dir/console/fliperos-idle.gif" 2> /dev/null; then
    call "console/stream/fliperos-idle"
  else
    call "attract?nointerrupt"
  fi
}

# home: saiu do frontend (o menu do FliperOS): a animacao do logo, como o
# protetor de tela, mas sem ele (nada para voltar; o frontend que abrir manda
# o sistema dele).
home() {
  rm -f "$last_file" "$last_file.system"
  idle_show
}

screensaver() {
  local last
  last=$(cat "$last_file" 2> /dev/null)
  case ${1:-} in
    start)
      [[ $last == screensaver:* ]] && return 0
      printf 'screensaver:%s\n' "$last" > "$last_file" 2> /dev/null
      idle_show
      ;;
    stop)
      [[ $last == screensaver:* ]] || return 0
      last=${last#screensaver:}
      rm -f "$last_file"
      # A volta no ZeDMD e no marquee do painel/OBS na hora; os pedidos dela ao
      # pixelweb ficam guardados e vao depois do attract/stop (um pixelweb sem o
      # painel ligado so responde no fim dos 3 s do curl).
      local url
      held_calls=() holding=1
      case $last in
        system/*) system "${last#system/}" ;;
        game:*) ;;
        */*) select_game "${last%%/*}" "${last#*/}" ;;
        *) zedmd startup ;;
      esac
      holding=0
      call "attract/stop"
      for url in "${held_calls[@]}"; do call "$url"; done
      ;;
  esac
  return 0
}

# select SISTEMA ROM [TITULO]: o jogo selecionado na lista. O mesmo de antes
# nao vai de novo (o marquee piscaria a cada volta da lista).
select_game() {
  [[ -n $1 && -n $2 ]] || return 0
  [[ $(cat "$last_file" 2> /dev/null) == "$1/$2" ]] && return 0
  printf '%s/%s\n' "$1" "$2" > "$last_file" 2> /dev/null
  zedmd show select "$1" "$2" "${3:-}"
  overlay select "$1" "$2" "${3:-}"
  call "arcade/stream/$(urlencode "$1")/$(urlencode "$2")?event=FEScroll"
}

# system SISTEMA [TITULO]
system() {
  [[ -n $1 ]] || return 0
  printf 'system/%s\n' "$1" > "$last_file" 2> /dev/null
  zedmd show system "$1" "" "${2:-}"
  overlay system "$1" "" "${2:-}"
  call "console/stream/$(urlencode "$1")"
}

# logo SISTEMA [ANTERIOR [PASSO]]: a troca de sistema no frontend do FliperOS.
# O logotipo escrito do sistema (config/fliperos-syslogo) entra deslizando, no
# sentido em que a lista andou (PASSO 1 ou -1), com o de ANTERIOR saindo, e
# pisca duas vezes, como a tela do frontend. No ZeDMD os quadros vao direto
# ao painel (fliperos-dmd slide); o Pixelcade so mostra arquivos, entao o
# logotipo vai num GIF, em ~/pixelcade/console (o "console/stream/NOME" o
# procura la), que e apagado quando o proximo chega. Sem o logotipo (o tema
# Arcadeflow nao esta instalado, ou o sistema nao esta nele), o de antes: a
# arte do sistema.
logo() {
  local name=${1:-} old=${2:-} step=${3:-1} gif art
  [[ -n $name ]] || return 0
  printf 'system/%s\n' "$name" > "$last_file" 2> /dev/null
  if ! "$syslogo" find "$name" > /dev/null 2>&1; then
    system "$name"
    return 0
  fi
  # O ZeDMD e o marquee do painel/OBS antes do Pixelcade: um pixelweb sem o
  # painel ligado so devolve cada pedido no fim dos 3 s do curl.
  if zedmd_installed && [[ -x $dmd ]]; then
    setsid "$dmd" slide "$name" "$old" "$step" < /dev/null > /dev/null 2>&1 &
  fi
  # O marquee do OBS e a previa do painel web desenham o mesmo logotipo e a
  # mesma animacao (logo= o sistema, old= o de antes, step= o sentido).
  overlay system "$name" "" "$name" "" "logo=$name" "old=$old" "step=$step"
  if installed; then
    art=$dir/console
    gif=fliperos-logo-$$
    if [[ -d $art ]] && "$syslogo" gif "$name" "$art/$gif.gif" "$old" "$step" "${PIXELCADE_LOGO_SIZE:-128x32}" 2> /dev/null; then
      find "$art" -maxdepth 1 -name 'fliperos-logo-*.gif' ! -name "$gif.gif" -delete 2> /dev/null
      call "console/stream/$gif"
    else
      call "console/stream/$(urlencode "$name")"
    fi
  fi
}

# launch PROGRAMA [ARGS...]: a linha de comando que o fliperos-kms-run ou o
# fliperos-x11-run recebeu. O jogo e o ultimo argumento: um arquivo de
# ~/roms, ou o nome do set no GroovyMAME e no Model 2 (o [name] dos
# frontends). Sem jogo (um frontend, o menu de um emulador), nada. O Visual
# Pinball desenha o DMD ele mesmo: o painel fica com ele ate fechar.
launch() {
  local prog last sys rom core="" i next
  (($# >= 1)) || return 0
  prog=${1##*/}
  if [[ ${prog,,} == vpinball* ]]; then
    dmd_hold "${PIXELCADE_GAME_PID:-$PPID}"
    watch "" "" "$prog"
    return 0
  fi
  (($# >= 2)) || return 0
  last=${*: -1}
  case $prog in
    groovymame | fliperos-model2)
      [[ $last == -* ]] && return 0
      sys=mame
      ;;
    *)
      [[ -f $last ]] || return 0
      sys=$(system_of "$last")
      ;;
  esac
  rom=$(rom_of "$last")
  # O core do RetroArch (-L): o placar versus depende dele.
  for ((i = 2; i < $#; i++)); do
    if [[ ${!i} == -L || ${!i} == --libretro ]]; then next=$((i + 1)) core=${!next}; fi
  done
  game "$sys" "$rom" && watch "$sys" "$rom" "$prog" "${core:-}"
}

# now: o jogo que ja esta aberto, como o launch dele. O marquee do OBS
# ligado no meio de uma partida nao recebia nada ate o proximo jogo (os
# eventos so chegam ao abrir e ao trocar a selecao). O jogo e o processo do
# usuario cujo ultimo argumento e um arquivo de ~/roms, ou o set do
# GroovyMAME.
now() {
  local dir last
  local -a args
  rm -f "$last_file"
  for dir in /proc/[0-9]*; do
    [[ $(stat -c %U "$dir" 2> /dev/null) == "$user" ]] || continue
    mapfile -d '' -t args < "$dir/cmdline" 2> /dev/null || continue
    ((${#args[@]} >= 2)) || continue
    last=${args[-1]}
    case ${args[0]##*/} in
      groovymame | fliperos-model2) [[ $last != -* ]] || continue ;;
      *) [[ $last == "$roms"/* && -f $last ]] || continue ;;
    esac
    PIXELCADE_GAME_PID=${dir#/proc/} launch "${args[@]}"
    return 0
  done
}

# esde EVENTO ARGS...: game-select "rom" "nome" "sistema" "nome do sistema";
# system-select "sistema" "nome do sistema" "pasta"; screensaver-start e
# screensaver-end. Com rolagem rapida o game-select chega vazio. No Linux o
# ES-DE escapa os espacos do caminho.
esde() {
  local event=$1 path
  shift
  case $event in
    screensaver-start) screensaver start ;;
    screensaver-end) screensaver stop ;;
    game-select)
      path=${1:-}
      path=${path//\\/}
      [[ -n $path ]] || return 0
      select_game "$(system_of "$path")" "$(rom_of "$path")" "${2:-}"
      ;;
    system-select)
      path=${3:-}
      path=${path//\\/}
      [[ -n $path ]] || return 0
      system "$(system_of "${path%/}/x")" "${2:-}"
      ;;
  esac
}

# attract EMULADOR ROM: a pasta das ROMs vem do .cfg do emulador.
attract() {
  local rompath sys=mame
  rompath=$(awk '$1 == "rompath" { sub(/^[ \t]*rompath[ \t]+/, ""); print; exit }' \
    "$attract_dir/emulators/$1.cfg" 2> /dev/null)
  rompath=${rompath%%;*}
  [[ -n $rompath ]] && sys=$(system_of "${rompath%/}/x")
  select_game "$sys" "${2:-}"
}

# Lido com "source" (os testes), so as funcoes.
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0

cmd=${1:-}
shift
case $cmd in
  fetch) fetch "$@" ;;
  artpack) artpack "$@" ;;
  installed)
    installed
    exit $?
    ;;
  frontends) frontends ;;
  daemon)
    installed || { echo "fliperos-pixelcade: pixelweb is not installed (Setup > Games > Extras)" >&2; exit 1; }
    frontends
    cd "$dir" || exit 1
    # Ao ligar, o logo do FliperOS no lugar do do Pixelcade.
    startup=()
    if [[ -f $logo ]] && mkdir -p "$dir/system" && cp -f "$logo" "$dir/system/fliperos.png"; then
      startup=(-image system/fliperos.png -text FliperOS)
    fi
    serve ./pixelweb -p "$dir" -startup "${startup[@]}"
    exit $?
    ;;
  lcd-usb) lcd_usb "$@" ;;
  lcd-ini)
    lcd_ini
    exit $?
    ;;
  fetch-doflinx) fetch_doflinx "$@" ;;
  doflinx-installed)
    doflinx_installed
    exit $?
    ;;
  doflinx-daemon)
    doflinx_installed || { echo "fliperos-pixelcade: DOFLinx is not installed (Setup > Games > Extras)" >&2; exit 1; }
    # O DOFLinx fala com o pixelweb: espera a API dele (ate 60 s).
    for _ in {1..30}; do
      curl -s -m 2 -o /dev/null "$api/info" 2> /dev/null && break
      sleep 2
    done
    cd "$doflinx_dir" || exit 1
    exec ./DOFLinx
    ;;
  cheevos)
    cheevos
    exit $?
    ;;
  bye) bye "$@" ;;
  fetch-zedmd) fetch_zedmd "$@" ;;
  zedmd-installed)
    zedmd_installed && [[ -x $dmd ]] && python3 -c 'import PIL' 2> /dev/null
    exit $?
    ;;
  zedmd-daemon)
    zedmd_installed || { echo "fliperos-pixelcade: dmdserver is not installed (Setup > Games > Extras)" >&2; exit 1; }
    frontends
    zedmd_config
    cd "$zedmd_dir" || exit 1
    # O logo do FliperOS assim que o dmdserver abrir a porta do painel.
    zedmd startup
    serve ./dmdserver -c "$zedmd_dir/dmdserver.ini" -l
    exit $?
    ;;
  panel)
    installed || zedmd_installed
    exit $?
    ;;
  # bg COMANDO [ARGS...]: o mesmo comando, solto, e volta na hora. Para quem
  # espera o filho acabar (o plugin do Attract-Mode Plus): a espera e so a
  # deste bash abrir.
  bg)
    setsid "$self" "$@" < /dev/null > /dev/null 2>&1 &
    exit 0
    ;;
  launch | esde | attract | game | select | system | logo | end | screensaver | home | achievement | versus | now)
    # Sem marquee nenhum (nem o do OBS), os eventos nao fazem nada.
    installed || zedmd_installed || overlay_on || exit 0
    case $cmd in
      select) select_game "$@" ;;
      end) game_end "$@" ;;
      versus) versus_score "$@" ;;
      *) "$cmd" "$@" ;;
    esac
    ;;
  *)
    sed -n '/^#   fliperos-pixelcade /p' "$0" | sed 's/^# *//' >&2
    exit 1
    ;;
esac
exit 0
