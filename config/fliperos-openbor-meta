#!/usr/bin/env python3
"""Os metadados dos paks do OpenBOR, para os frontends.

  fliperos-openbor-meta scan [--paks PASTA] [--media PASTA] [--lists PASTA] [--skyscraper PASTA]
  fliperos-openbor-meta mode PAK 15k|31k
  fliperos-openbor-meta info PAK

Um pak e um pacote (PACK + tabela no fim, engine/source/gamelib/packfile.c:
PAK32, formato 0, e PAK64, formato 1) com os arquivos do jogo, sem ficha de
nome, autor ou ano. O que da para tirar dele:

- a tela de titulo (data/bgs/title.*): a imagem do jogo (snap) em ~/media,
  quando ainda nao ha uma. Uma imagem quase sem cores (os fundos lisos que
  muitos paks deixam no lugar) nao vale;
- os jogadores: o maior maxplayers dos modos do levels.txt (o OpenBOR assume
  2; "single" e 1; antes do primeiro set, muda o padrao), e os modos (set),
  que tambem fazem uma descricao curta enquanto o ScreenScraper nao traz a
  dele ("An OpenBOR game for 1 player. Mode: Story. Resolution 400x300.");
- a resolucao (data/videopc.txt ou data/video.txt: "video 400x300" ou um dos
  modos 0 a 6), para o jogo abrir no modo dele (fliperos-x11-run, mode).

O que o pak nao tem (o titulo, o ano, o fabricante, o genero, a descricao)
vem do ScreenScraper, pelo cache do Skyscraper (~/.skyscraper/cache/openbor,
que o Setup > Games > Scraper enche: o Skyscraper conhece a plataforma
openbor, id 214 no ScreenScraper). scan grava tudo na lista do FliperOS
(~/.local/share/fliperos/lists/OpenBOR.txt, no formato das romlists do
Attract-Mode: o frontend do FliperOS e o painel web a leem) e a descricao em
~/media/texto/openbor. A arte que ja existe (a do Scraper, a posta a mao)
fica. Roda como o usuario (fliperos-setup --romlists, lib/frontends.sh).
"""

import argparse
import io
import os
import re
import struct
import sys
import xml.etree.ElementTree as ET

KEY = "openbor"
EMULATOR = "OpenBOR"
HOME = os.environ.get("FLIPEROS_HOME") or os.path.expanduser("~")
PAKS = os.environ.get("FLIPEROS_OPENBOR_PAKS") or os.path.join(
    os.environ.get("FLIPEROS_OPENBOR_DIR", "/opt/fliperos/roms/openbor"), "Paks")
FIELDS = ("Name", "Title", "Emulator", "CloneOf", "Year", "Manufacturer", "Category", "Players", "Rotation",
          "Control", "Status", "DisplayCount", "DisplayType", "AltRomname", "AltTitle", "Extra", "Buttons",
          "Series", "Language", "Region", "Rating")
GENRE = "Beat 'em Up"
# Os modos de video.txt (init_videomodes, engine/openbor.c).
VIDEO_MODES = {0: (320, 240), 1: (480, 272), 2: (640, 480), 3: (720, 480), 4: (800, 480), 5: (800, 600),
               6: (960, 540)}
IMAGE_EXTS = (".png", ".gif", ".jpg", ".jpeg", ".webp")
# A imagem do jogo: os arquivos de data/bgs, na ordem de preferencia. A tela
# de selecao (select) e so um fundo com "Player Select" (visto nos paks do
# gabinete): nao serve de capa; a capa, o logo e o marquee vem do Scraper.
ART = (("snap", ("title", "titleb", "logo", "select")),)
MIN_COLORS = 8


# ── O pak ──────────────────────────────────────────────────────────

class Pak:
    """A tabela do pak: {nome em minusculas, com /: (inicio, tamanho)}."""

    def __init__(self, path):
        self.path = path
        self.files = {}
        with open(path, "rb") as f:
            head = f.read(8)
            if len(head) < 8:
                raise ValueError("not a pak")
            magic, fmt = struct.unpack("<II", head)
            if magic != 0x4B434150 or fmt not in (0, 1):
                raise ValueError("not a pak")
            footer, entry = (4, 12) if fmt == 0 else (8, 20)
            size = f.seek(0, 2)
            f.seek(size - footer)
            table = struct.unpack("<I" if fmt == 0 else "<Q", f.read(footer))[0]
            if not 8 <= table <= size - footer:
                raise ValueError("bad pak table")
            f.seek(table)
            data = f.read(size - footer - table)
        pos = 0
        while pos + entry <= len(data):
            record = struct.unpack_from("<I", data, pos)[0]
            if record <= entry or pos + record > len(data):
                break
            start, length = struct.unpack_from("<II" if fmt == 0 else "<QQ", data, pos + 4)
            name = data[pos + entry:pos + record].split(b"\0")[0].decode("latin-1")
            self.files[name.replace("\\", "/").lower().lstrip("./")] = (start, length)
            pos += record

    def read(self, name, limit=None):
        hit = self.files.get(name.lower())
        if not hit:
            return None
        start, length = hit
        with open(self.path, "rb") as f:
            f.seek(start)
            return f.read(length if limit is None else min(length, limit))

    def text(self, name):
        data = self.read(name, 1 << 20)
        return None if data is None else data.decode("latin-1", "replace")


def lines(text):
    """As linhas com comando (sem os comentarios #), ja divididas."""
    for line in (text or "").splitlines():
        line = line.split("#", 1)[0].strip()
        if line:
            yield line.split()


def video_settings(pak):
    """(largura, altura) e o levels.txt de outro nome, do videopc.txt (o do
    PC, primeiro) ou do video.txt. Sem nenhum, 320x240."""
    size, levels = VIDEO_MODES[0], None
    text = pak.text("data/videopc.txt")
    if text is None:
        text = pak.text("data/video.txt")
    for args in lines(text):
        command = args[0].lower()
        if command == "video" and len(args) > 1:
            m = re.match(r"(\d+)x(\d+)", args[1].lower())
            if m:
                size = (int(m.group(1)), int(m.group(2)))
            elif args[1].lstrip("-").isdigit():
                size = VIDEO_MODES.get(int(args[1]), VIDEO_MODES[0])
        elif command == "levels" and len(args) > 1:
            levels = args[1]
    return size, levels


def levels_info(pak, levels=None):
    """(jogadores, modos) do levels.txt, como o OpenBOR o le."""
    text = pak.text("data/" + levels) if levels else None
    if text is None:
        text = pak.text("data/levels.txt")
    default, sets, current = 2, [], None
    for args in lines(text):
        command = args[0].lower()
        if command == "set":
            current = {"name": " ".join(args[1:]), "players": None}
            sets.append(current)
        elif command in ("maxplayers", "single"):
            value = 1 if command == "single" else (int(args[1]) if len(args) > 1 and args[1].isdigit() else None)
            if value is None:
                continue
            if current is None:
                default = value
            else:
                current["players"] = value
    players = max([s["players"] or default for s in sets] or [default])
    return players, [s["name"] for s in sets if s["name"]]


def colors(data, name):
    """Quantas cores tem a imagem (numa grade de pontos), ou None sem o
    pygame para abrir."""
    try:
        os.environ.setdefault("PYGAME_HIDE_SUPPORT_PROMPT", "1")
        import pygame
        image = pygame.image.load(io.BytesIO(data), name)
    except Exception:
        return None
    w, h = image.get_size()
    seen = set()
    for y in range(0, h, max(1, h // 48)):
        for x in range(0, w, max(1, w // 64)):
            seen.add(tuple(image.get_at((x, y))[:3]))
            if len(seen) >= 64:
                return len(seen)
    return len(seen)


def art_candidates(pak):
    """{nome base em data/bgs: (arquivo, extensao)} das imagens."""
    out = {}
    for name in pak.files:
        m = re.match(r"data/bgs/([^/]+?)(\.[a-z]+)$", name)
        if m and m.group(2) in IMAGE_EXTS and m.group(1) not in out:
            out[m.group(1)] = (name, m.group(2))
    return out


def good_image(pak, name):
    data = pak.read(name)
    if not data:
        return None
    n = colors(data, name)
    if n is None:
        return data if len(data) >= 4096 else None
    return data if n >= MIN_COLORS else None


def info(path):
    pak = Pak(path)
    (w, h), levels = video_settings(pak)
    players, modes = levels_info(pak, levels)
    return {"pak": pak, "width": w, "height": h, "players": players, "modes": modes}


# ── O modo de video ────────────────────────────────────────────────

def mode_for(width, height, monitor):
    """O modo do fliperos-x11-run para a resolucao do pak. O OpenBOR, em tela
    cheia, mantem a proporcao do pak ("Preserve Aspect Ratio", o padrao de
    cada .cfg): num modo de outra proporcao sobram faixas pretas (400x300
    num 400x240 saia com 320 de largura, visto no gabinete). Entao o modo tem
    a forma do pak. Num monitor de 15 kHz so ha 240 linhas a 60 Hz (288 a 50,
    como o PAL): ate ai, a do pak; senao a do pak dividida por 2 ou 3, se der
    exata e com 200 linhas ou mais (640x480: 320x240; 960x540: 480x270); senao
    240 linhas na mesma forma (400x300: 320x240). Nos outros monitores, a do
    pak."""
    if monitor != "15k":
        return "%dx%d@60" % (width, height)
    for d in (1, 2, 3):
        if width % d or height % d or (d > 1 and height // d < 200):
            continue
        w, h = width // d, height // d
        if h <= 240:
            return "%dx%d@60" % (w, h)
        if h <= 288:
            return "%dx%d@50" % (w, h)
    w = int(round(width * 240.0 / height / 2)) * 2
    return "%dx240@60" % w


def resolve(pak):
    """O caminho do pak: o dado, ou o nome de um que esta em Paks/."""
    if os.path.isfile(pak):
        return pak
    other = os.path.join(PAKS, pak)
    return other if os.path.basename(pak) == pak and os.path.isfile(other) else None


# ── O ScreenScraper, pelo cache do Skyscraper ──────────────────────

def skyscraper_cache(folder):
    """{nome do arquivo: {tipo: valor}} do cache do Skyscraper (quickid.xml
    liga o arquivo ao id; db.xml tem os recursos de cada id). O do
    ScreenScraper vence o de outra fonte."""
    out = {}
    try:
        quick = ET.parse(os.path.join(folder, "quickid.xml")).getroot()
        db = ET.parse(os.path.join(folder, "db.xml")).getroot()
    except (OSError, ET.ParseError):
        return out
    resources = {}
    for r in db.iter("resource"):
        rid, kind, value = r.get("id"), r.get("type"), (r.text or "").strip()
        if not rid or not kind or not value:
            continue
        mine = resources.setdefault(rid, {})
        if kind not in mine or r.get("source") == "screenscraper":
            mine[kind] = value
    for q in quick.iter("quickid"):
        path, rid = q.get("filepath"), q.get("id")
        if path and rid in resources:
            out[os.path.basename(path)] = resources[rid]
    return out


def players_text(value):
    """"1-2", "2", "1 - 4": o maior."""
    numbers = [int(n) for n in re.findall(r"\d+", value or "")]
    return str(max(numbers)) if numbers else ""


# ── scan ───────────────────────────────────────────────────────────

def media_exists(media, kind, stem):
    folder = os.path.join(media, kind, KEY)
    return any(os.path.exists(os.path.join(folder, stem + ext)) for ext in IMAGE_EXTS)


def write(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "%s.%d.tmp" % (path, os.getpid())
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, path)


# A descricao feita do pak, quando o ScreenScraper nao tem uma; reconhecida
# depois (OWN_TEXT) para a dele entrar no lugar. Um texto de outro (o Scraper,
# a pessoa) fica.
OWN_TEXT = re.compile(r"^An OpenBOR game for \d+ players?\.")


def own_description(meta):
    n = meta["players"]
    text = "An OpenBOR game for %d player%s." % (n, "" if n == 1 else "s")
    if meta["modes"]:
        text += " Mode%s: %s." % ("" if len(meta["modes"]) == 1 else "s", ", ".join(meta["modes"]))
    return text + " Resolution %dx%d.\n" % (meta["width"], meta["height"])


def describe(path, scraped, meta):
    """Grava a descricao do jogo: a do ScreenScraper ou, sem ela, a do pak.
    Devolve 1 se gravou."""
    try:
        with open(path, encoding="utf-8") as f:
            current = f.read()
    except OSError:
        current = None
    if current is not None and not OWN_TEXT.match(current):
        return 0
    if scraped:
        text = scraped.strip() + "\n"
    elif meta:
        text = own_description(meta)
    else:
        return 0
    if text == current:
        return 0
    write(path, text.encode("utf-8"))
    return 1


def paks_in(folder):
    try:
        names = sorted(os.listdir(folder), key=str.lower)
    except OSError:
        return []
    return [n for n in names if n.lower().endswith(".pak") and not n.startswith(".")
            and os.path.isfile(os.path.join(folder, n))]


def scan(paks, media, lists, sky):
    scraped = skyscraper_cache(os.path.join(sky, "cache", KEY))
    rows, art, texts = [], 0, 0
    names = paks_in(paks)
    for name in names:
        stem = name[:-4]
        row = {"Name": stem, "Title": stem, "Emulator": EMULATOR, "Category": GENRE}
        try:
            meta = info(os.path.join(paks, name))
        except (OSError, ValueError, struct.error) as e:
            print("%s: %s" % (name, e), file=sys.stderr)
            meta = None
        if meta:
            row["Players"] = str(meta["players"])
            row["Extra"] = "%dx%d" % (meta["width"], meta["height"])
            if meta["modes"]:
                row["Series"] = ", ".join(meta["modes"])
            found = art_candidates(meta["pak"])
            for kind, wanted in ART:
                if media_exists(media, kind, stem):
                    continue
                for base in wanted:
                    if base not in found:
                        continue
                    data = good_image(meta["pak"], found[base][0])
                    if data:
                        write(os.path.join(media, kind, KEY, stem + found[base][1]), data)
                        art += 1
                        break
        ss = scraped.get(name, {})
        if ss.get("title"):
            row["Title"] = ss["title"]
        year = re.match(r"\d{4}", ss.get("releasedate", ""))
        if year:
            row["Year"] = year.group(0)
        if ss.get("developer") or ss.get("publisher"):
            row["Manufacturer"] = ss.get("developer") or ss.get("publisher")
        if ss.get("tags"):
            row["Category"] = ss["tags"].split(",")[0].strip()
        if players_text(ss.get("players")):
            row["Players"] = players_text(ss.get("players"))
        texts += describe(os.path.join(media, "texto", KEY, stem + ".txt"), ss.get("description"), meta)
        rows.append(row)
    path = os.path.join(lists, EMULATOR + ".txt")
    if rows:
        body = "#" + ";".join(FIELDS) + "\n" + "".join(
            ";".join(row.get(f, "").replace(";", ",").replace("\n", " ") for f in FIELDS) + "\n" for row in rows)
        try:
            with open(path, encoding="utf-8") as f:
                same = f.read() == body
        except OSError:
            same = False
        if not same:
            write(path, body.encode("utf-8"))
    elif os.path.exists(path):
        os.remove(path)
    print("paks=%d art=%d texts=%d scraped=%d" % (len(rows), art, texts, sum(1 for n in names if n in scraped)))


def main(argv=None):
    parser = argparse.ArgumentParser(prog="fliperos-openbor-meta")
    sub = parser.add_subparsers(dest="command", required=True)
    s = sub.add_parser("scan")
    s.add_argument("--paks", default=PAKS)
    s.add_argument("--media", default=os.path.join(HOME, "media"))
    s.add_argument("--lists", default=os.environ.get("FLIPEROS_LISTS")
                   or os.path.join(HOME, ".local", "share", "fliperos", "lists"))
    s.add_argument("--skyscraper", default=os.path.join(HOME, ".skyscraper"))
    m = sub.add_parser("mode")
    m.add_argument("pak")
    m.add_argument("monitor", choices=("15k", "31k"))
    i = sub.add_parser("info")
    i.add_argument("pak")
    args = parser.parse_args(argv)
    if args.command == "scan":
        scan(args.paks, args.media, args.lists, args.skyscraper)
        return 0
    path = resolve(args.pak)
    if not path:
        return 1
    try:
        meta = info(path)
    except (OSError, ValueError, struct.error):
        return 1
    if args.command == "mode":
        print(mode_for(meta["width"], meta["height"], args.monitor))
    else:
        print("resolution=%dx%d\nplayers=%d\nmodes=%s\nimages=%s" % (
            meta["width"], meta["height"], meta["players"], ", ".join(meta["modes"]),
            ", ".join(sorted(b + e for b, (_, e) in art_candidates(meta["pak"]).items()))))
    return 0


if __name__ == "__main__":
    sys.exit(main())
