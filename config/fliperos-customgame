# Os .exe que nao abrem o jogo: instaladores, desinstaladores, as bibliotecas
# do Windows e os relatorios de erro.
SKIP_EXE = re.compile(r"^(unins\d*|uninst(all)?|setup|install(er)?|vc_?redist.*|dxsetup|dxwebsetup|directx.*|"
                      r"dotnet.*|ndp\d.*|unitycrashhandler(32|64)?|crashreport.*|crashpad_handler|ue[45]prereqsetup.*|"
                      r"oalinst|physx.*|easyanticheat.*|be_?setup|.*redist.*|dosbox_?setup|config(urator)?|"
                      r"launcher_?setup|notification_helper|quicksfv|7z.*|winrar.*)\.(exe|bat)$", re.I)
LINUX_EXTS = (".x86_64", ".x86", ".appimage", ".sh", ".bin", ".run")
SCAN_DEPTH = 3
SCAN_FILES = 20000


def simple(s):
    return re.sub(r"[^a-z0-9]+", "", s.lower())


def game_name(folder):
    """O nome de um jogo pelo nome da pasta: _ e . viram espacos."""
    name = re.sub(r"\s+", " ", re.sub(r"[_.]+", " ", os.path.basename(folder.rstrip("/")))).strip()
    return name if valid_name(name) else ""


def rank(rels, folder_name, sizes):
    """Os candidatos em ordem: o nome parecido com o da pasta, o mais raso, o
    maior."""
    want = simple(folder_name)

    def score(rel):
        stem = simple(os.path.splitext(os.path.basename(rel))[0])
        near = 3 if stem and stem == want else 2 if stem and want and (stem in want or want in stem) else 0
        return (-near, rel.count("/"), -sizes.get(rel, 0), rel.lower())
    return sorted(rels, key=score)


# ── A estrutura do pacote numa pasta (o zip aberto) ──
# A pasta JOGO/ (os arquivos do jogo) ao lado de JOGO.cfg, JOGO.jpg,
# JOGO.mp4, JOGO.txt, JOGO.key e JOGO.ppdb. A pessoa pode escolher a pasta de
# cima (o zip aberto) ou a do jogo (os outros ficam ao lado dela); a imagem e
# o video com o nome do jogo dentro da pasta dele (ou snap.png, cover.jpg,
# trailer.mp4...) tambem servem. O painel e o Setup preenchem a arte com eles.

SIDE_KINDS = (("cfg", ("cfg",)), ("snap", IMAGE_EXTS), ("preview", VIDEO_EXTS), ("texto", ("txt",)),
              ("key", ("key",)), ("ppdb", ("ppdb",)))
# Os nomes de arte comuns dentro da pasta do jogo (comparados sem caixa,
# espacos ou _).
INNER_ART = {"snap": ("snap", "screenshot", "screen", "cover", "thumbnail", "thumb", "title", "boxart"),
             "preview": ("preview", "video", "trailer", "gameplay", "snap", "intro")}
JUNK = {"thumbs.db", "desktop.ini", ".ds_store"}


def plain_files(folder):
    """{nome: caminho} dos arquivos comuns (sem atalhos) da pasta."""
    out = {}
    try:
        names = os.listdir(folder)
    except OSError:
        return out
    for n in names:
        path = os.path.join(folder, n)
        if not n.startswith(".") and os.path.isfile(path) and not os.path.islink(path):
            out[n] = path
    return out


def side_files(files, base):
    """{tipo: caminho} dos BASE.* entre os arquivos (o nome comparado sem
    caixa, espacos ou _; entre dois, a ordem das extensoes decide)."""
    want = simple(base)
    by_ext = {}
    for n, path in sorted(files.items()):
        stem, dot, ext = n.rpartition(".")
        if dot and want and simple(stem) == want:
            by_ext.setdefault(ext.lower(), path)
    out = {}
    for kind, exts in SIDE_KINDS:
        for ext in exts:
            if ext in by_ext:
                out[kind] = by_ext[ext]
                break
    return out


def our_cfg(path):
    """O cfg de um jogo custom (platform windows ou native), ou None."""
    try:
        if os.path.getsize(path) > (1 << 20):
            return None
        cfg = read_cfg(path)
    except OSError:
        return None
    return cfg if cfg.get("platform", "").lower() in PLATFORMS else None


def unpacked(folder):
    """(pasta do jogo, arquivos ao lado) quando FOLDER e o zip aberto: uma
    subpasta JOGO com JOGO.cfg do FliperOS, ou a unica subpasta com so os
    JOGO.* em volta. None se nao e."""
    files = plain_files(folder)
    try:
        dirs = sorted(d for d in os.listdir(folder) if not d.startswith(".")
                      and os.path.isdir(os.path.join(folder, d)) and not os.path.islink(os.path.join(folder, d)))
    except OSError:
        return None
    for d in dirs:
        side = side_files(files, d)
        if "cfg" in side and our_cfg(side["cfg"]) is not None:
            return os.path.join(folder, d), side
    if len(dirs) == 1:
        side = side_files(files, dirs[0])
        loose = [n for n, p in files.items() if p not in side.values() and n.lower() not in JUNK]
        if side and not loose:
            return os.path.join(folder, dirs[0]), side
    return None


def layout(folder):
    """A pasta do jogo e o que veio com ela: {"folder", "snap", "video",
    "text", "key", "ppdb", "cfg"} (caminhos; cfg sao as chaves do JOGO.cfg
    que servem) e "where": package (o zip aberto), beside (ao lado da pasta),
    inside (so a arte de dentro dela) ou "" (nada)."""
    folder = os.path.realpath(folder)
    found = unpacked(folder)
    where = "package" if found else ""
    if found:
        game, side = found
    else:
        game = folder
        side = side_files(plain_files(os.path.dirname(folder)), os.path.basename(folder)) \
            if os.path.dirname(folder) != folder else {}
        if "cfg" in side and our_cfg(side["cfg"]) is None:
            del side["cfg"]
        where = "beside" if side else ""
    out = {"folder": game, "where": where, "snap": side.get("snap", ""), "video": side.get("preview", ""),
           "text": side.get("texto", ""), "key": side.get("key", ""), "ppdb": side.get("ppdb", ""), "cfg": {}}
    # A arte de dentro da pasta do jogo: com o nome dele, ou um nome comum.
    inner = plain_files(game)
    base = os.path.basename(game)
    for key, kind in (("snap", "snap"), ("video", "preview")):
        if out[key]:
            continue
        exts = dict(MEDIA)[kind]
        names = (simple(base),) + INNER_ART[kind]
        for want in names:
            hit = sorted(p for n, p in inner.items() if "." in n and n.rsplit(".", 1)[1].lower() in exts
                         and simple(n.rsplit(".", 1)[0]) == want)
            if hit:
                out[key] = hit[0]
                out["where"] = out["where"] or "inside"
                break
    if side.get("cfg"):
        out["cfg"] = cfg_hints(our_cfg(side["cfg"]) or {}, game)
    return out


def cfg_hints(cfg, game):
    """As chaves do JOGO.cfg que valem para a pasta GAME (as erradas saem)."""
    out = {}
    if valid_name(cfg.get("name", "")):
        out["name"] = cfg["name"]
    platform = cfg.get("platform", "").lower()
    if platform in PLATFORMS:
        out["platform"] = platform
    exe = rel_path(cfg.get("exe", ""))
    if platform == "windows" and exe and os.path.isfile(os.path.join(game, *exe.split("/"))):
        out["exe"] = exe
    if platform == "native" and cfg.get("command", "").strip():
        out["command"] = cfg["command"].strip()
    mode = mode_of(cfg.get("mode", ""))
    if mode:
        out["mode"] = mode
    if cfg.get("category") and len(cfg["category"]) <= 80:
        out["category"] = cfg["category"]
    controls = [c.strip().lower() for c in cfg.get("controls", "").split(",") if c.strip().lower() in CONTROLS]
    if controls:
        out["controls"] = ",".join(dict.fromkeys(controls))
    for key, low in (("buttons", 0), ("players", 1)):
        value = cfg.get(key, "")
        if value.isdigit() and low <= int(value) <= 8:
            out[key] = value
    return out


def cmd_found(args):
    if not os.path.isdir(args.folder):
        print("not a folder: %s" % args.folder, file=sys.stderr)
        return 1
    found = layout(args.folder)
    for key in ("folder", "where", "snap", "video", "text", "key", "ppdb"):
        print("%s=%s" % (key, found[key]))
    for key, value in found["cfg"].items():
        print("cfg_%s=%s" % (key, value))
    return 0


def scan_folder(folder):
    found = layout(folder)
    folder = found["folder"]
    exes, programs, sizes = [], [], {}
    total = count = 0
    for top, dirs, names in os.walk(folder):
        dirs[:] = sorted(d for d in dirs if not d.startswith(".") and not os.path.islink(os.path.join(top, d)))
        depth = os.path.relpath(top, folder).count(os.sep) + (top != folder)
        if depth >= SCAN_DEPTH:
            dirs[:] = []
        for n in sorted(names):
            path = os.path.join(top, n)
            if os.path.islink(path) or not os.path.isfile(path):
                continue
            count += 1
            try:
                st = os.stat(path)
            except OSError:
                continue
            total += st.st_size
            if count > SCAN_FILES:
                continue
            rel = os.path.relpath(path, folder).replace(os.sep, "/")
            low = n.lower()
            sizes[rel] = st.st_size
            if low.endswith((".exe", ".bat")):
                if not SKIP_EXE.match(n):
                    exes.append(rel)
                continue
            # As bibliotecas (os .so, as pastas lib*) nao abrem o jogo.
            if low.endswith(".so") or ".so." in low or any(p.startswith("lib") for p in rel.lower().split("/")[:-1]):
                continue
            if low.endswith(LINUX_EXTS) or st.st_mode & 0o111:
                try:
                    with open(path, "rb") as f:
                        head = f.read(4)
                except OSError:
                    continue
                if runnable(head) or low.endswith(".appimage"):
                    programs.append(rel)
    name = os.path.basename(folder.rstrip("/"))
    exes, programs = rank(exes, name, sizes), rank(programs, name, sizes)
    row = {"path": folder, "name": game_name(folder), "bytes": total, "files": count, "exes": exes[:40],
           "programs": programs[:40], "platform": "windows" if exes else "native" if programs else "",
           "exe": exes[0] if exes else "", "command": ""}
    if not exes and programs:
        row["command"] = "./" + programs[0].replace(" ", "\\ ")
    # O que veio com a pasta (a estrutura do pacote): a arte, o .key, o
    # .ppdb e o que o JOGO.cfg diz vencem o que o scan adivinhou.
    hints = found["cfg"]
    for key in ("snap", "video", "text", "key", "ppdb", "where"):
        row[key] = found[key]
    row["cfg"] = {k: v for k, v in hints.items() if k in ("mode", "category", "controls", "buttons", "players")}
    if hints.get("name"):
        row["name"] = hints["name"]
    # cfg_run: o exe= (ou command=) veio do JOGO.cfg (a pagina o poe por
    # cima do que a linha tinha).
    row["cfg_run"] = False
    if hints.get("platform") == "windows" and hints.get("exe"):
        row.update(platform="windows", exe=hints["exe"], command="", cfg_run=True)
        if hints["exe"] not in row["exes"]:
            row["exes"] = [hints["exe"]] + row["exes"][:39]
    elif hints.get("platform") == "native" and hints.get("command"):
        row.update(platform="native", command=hints["command"], exe="", cfg_run=True)
    return row


def cmd_scan(args):
    folder = os.path.realpath(args.folder)
    if not os.path.isdir(folder):
        print("not a folder: %s" % args.folder, file=sys.stderr)
        return 1
    if args.one:
        out = scan_folder(folder)
    else:
        games = []
        try:
            names = sorted(os.listdir(folder), key=str.lower)
        except OSError as exc:
            print(str(exc), file=sys.stderr)
            return 1
        for n in names:
            path = os.path.join(folder, n)
            if n.startswith(".") or not os.path.isdir(path):
                continue
            row = scan_folder(path)
            if row["name"]:
                games.append(row)
        out = {"path": folder, "games": games}
    print(json.dumps(out))
    return 0


