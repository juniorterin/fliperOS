ENV = os.environ.get
USER = ENV("FLIPEROS_USER", "fliperos")
BIN = ENV("FLIPEROS_BIN", "/opt/fliperos/bin")
SUFFIX = ".fliperos-customgame.zip"
FORMAT = "1"

IMAGE_EXTS = ("png", "jpg", "jpeg", "webp", "gif")
VIDEO_EXTS = ("mp4", "mkv", "webm", "avi", "mov", "flv")
# As midias do pacote e a pasta de ~/media de cada uma (as do fedata.py).
MEDIA = (("snap", IMAGE_EXTS), ("preview", VIDEO_EXTS), ("texto", ("txt",)))
PLATFORMS = ("windows", "native")
# Os 13 tipos de controle do filtro de ROMs (lib/romclean.sh) e como o
# Attract-Mode os escreve no campo Control da romlist (fliperos-romclean
# control_label): o frontend os filtra por ele.
CONTROLS = {"joy8": "joystick (8-way)", "joy4": "joystick (4-way)", "joy2": "joystick (2-way)",
            "twin": "double joystick (8-way)", "trackball": "trackball", "spinner": "dial", "paddle": "paddle",
            "positional": "positional", "analog": "analog stick", "pedal": "pedal", "lightgun": "lightgun",
            "keyboard": "keyboard", "mahjong": "mahjong"}
# 240p-hack ("240p hack (Mugen)" na tela): 240p no tubo, mas o jogo ve uma tela
# de 640x480 (fliperos-x11-run --mode MODO/TELA). O MUGEN em tela cheia so abre
# em 640x480 e no 240p comum fechava com erro; um jogo que abre em 320x240 ou
# 640x240 fica no 240p.
MODES = {"240p": "640x240@60", "240p-hack": "640x240@60/640x480", "480i": "640x480@60"}
# O modo de um jogo custom que nao diz o dele (mode= no cfg): 640x480i.
DEFAULT_MODE = "640x480@60"
MODE_RE = re.compile(r"^[1-9][0-9]{1,3}x[1-9][0-9]{1,3}@[1-9][0-9]{0,2}(\.[0-9]+)?(/[1-9][0-9]{1,3}x[1-9][0-9]{1,3})?$")
# Os controles de um jogador no .key (os do buttons.map).
KEY_CONTROLS = ("up", "down", "left", "right", "b1", "b2", "b3", "b4", "b5", "b6", "b7", "b8", "start", "coin")
KEY_LINE = re.compile(r"^p([1-8])_(%s)=([A-Z0-9_]{1,24})$" % "|".join(KEY_CONTROLS))
# A ordem das chaves no cfg gravado.
CFG_ORDER = ("format", "name", "platform", "exe", "command", "mode", "category", "controls", "buttons", "players",
             "folder", "package", "package_stamp")
# O que ja vem comprimido vai no zip sem comprimir de novo (o pacote feito no
# gabinete: o video, as imagens e os arquivos dos jogos que ja sao zip).
STORED_EXTS = {"zip", "7z", "rar", "gz", "xz", "bz2", "zst", "cab", "jpg", "jpeg", "png", "webp", "gif",
               "mp4", "mkv", "webm", "avi", "mov", "flv", "mp3", "ogg", "opus", "flac", "wma", "wmv", "bik", "pak"}
CHUNK = 1 << 20


class Bad(Exception):
    """O pacote nao serve. problems: [(codigo, argumento, texto)] de cada
    problema achado (o painel traduz pelo codigo; o texto, em ingles, vai
    para a tela do Setup); a mensagem e os textos juntos. looks: o zip parece
    um pacote (tem um .cfg), mesmo com problemas."""

    def __init__(self, message="", code="other", arg="", problems=None, looks=False):
        self.problems = problems or [(code, arg, message)]
        self.looks = looks
        super().__init__(message or "; ".join(text for _, _, text in self.problems))


def codes_of(problems):
    """Os codigos de uma lista de problemas numa linha so (o campo CODIGOS do
    pending): codigo=argumento separados por ;."""
    clean = lambda s: re.sub(r"[|;\n\r]", "/", str(s))
    return ";".join("%s=%s" % (code, clean(arg)) if arg != "" else code for code, arg, _ in problems)


def player_home():
    try:
        return pwd.getpwnam(USER).pw_dir
    except KeyError:
        return os.path.expanduser("~")


def owner():
    """(uid, gid) do jogador, ou None (sem o usuario: os testes)."""
    try:
        p = pwd.getpwnam(USER)
        return p.pw_uid, p.pw_gid
    except KeyError:
        return None


def give(path):
    """O arquivo do jogador (o Setup roda como root)."""
    who = owner()
    if who and os.geteuid() == 0:
        try:
            os.lchown(path, *who)
        except OSError:
            pass


def give_tree(path):
    give(path)
    for top, dirs, files in os.walk(path):
        for n in dirs + files:
            give(os.path.join(top, n))


def makedirs(path):
    """A pasta e as que faltam acima dela, todas do jogador."""
    missing = []
    while path and not os.path.isdir(path):
        missing.append(path)
        path = os.path.dirname(path)
    for p in reversed(missing):
        os.mkdir(p)
        give(p)


def valid_name(s):
    """Serve de nome de grupo ou de jogo (o customgames_valid_name)."""
    return bool(s and s.strip() and not any(c in s for c in "/|\n\r") and not s.startswith("."))


def mode_of(s):
    s = (s or "").strip()
    s = MODES.get(s, s)
    return s if MODE_RE.match(s) else None


def stamp(path):
    st = os.stat(path)
    return "%d:%d" % (st.st_size, int(st.st_mtime))


def parse_cfg(text):
    out = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        out[key.strip().lower()] = value.strip()
    return out


def read_cfg(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        return parse_cfg(f.read())


def cfg_text(cfg):
    lines = ["# FliperOS custom game (Setup > Games > Custom games)."]
    for key in CFG_ORDER + tuple(sorted(k for k in cfg if k not in CFG_ORDER)):
        value = cfg.get(key)
        if value not in (None, ""):
            lines.append("%s=%s" % (key, str(value).replace("\n", " ")))
    return "\n".join(lines) + "\n"


def write_file(path, data):
    """Grava pelo .tmp e troca (nunca um arquivo pela metade), do jogador."""
    tmp = path + ".tmp"
    with open(tmp, "wb") as f:
        f.write(data if isinstance(data, bytes) else data.encode("utf-8"))
    os.chmod(tmp, 0o644)
    give(tmp)
    os.replace(tmp, path)


def key_lines(text):
    """As linhas validas de um .key, na ordem."""
    out = []
    for line in text.splitlines():
        line = line.strip()
        if KEY_LINE.match(line):
            out.append(line)
    return out


def check_cfg(cfg, base, game_files, problems=None):
    """O cfg do pacote conferido e normalizado. game_files: os caminhos dos
    arquivos da pasta do jogo (relativos a ela). Todos os problemas vao para
    problems (com ela, a conferencia segue; sem ela, Bad com todos no fim)."""
    found = [] if problems is None else problems
    bad = lambda code, arg, text: found.append((code, arg, text))
    # O minimo do cfg: name, platform e exe (Windows) ou command (Linux).
    out = {"format": FORMAT}
    name = cfg.get("name", "")
    if not name.strip():
        bad("name_missing", "", "%s.cfg: no name= (the name in the frontend)" % base)
    elif not valid_name(name):
        bad("name_bad", name, "invalid game name in %s.cfg: %r" % (base, name))
    out["name"] = name or base
    platform = cfg.get("platform", "").lower()
    if not platform:
        bad("platform_missing", "", "%s.cfg: no platform= (windows or native)" % base)
    elif platform not in PLATFORMS:
        bad("platform_bad", platform, "%s.cfg: platform must be windows or native, not %r" % (base, platform))
    out["platform"] = platform
    if platform == "windows":
        exe = rel_path(cfg.get("exe", ""))
        if not exe:
            bad("exe_missing", "", "%s.cfg: no exe= (the .exe inside the folder %s)" % (base, base))
        elif game_files and exe not in game_files:
            bad("exe_not_found", exe, "%s.cfg: %s is not in the folder %s" % (base, exe, base))
        out["exe"] = exe
    elif platform == "native":
        command = cfg.get("command", "")
        if not command.strip():
            bad("command_missing", "", "%s.cfg: no command= (what opens the game, run in its folder)" % base)
        out["command"] = command
    mode = mode_of(cfg.get("mode") or DEFAULT_MODE)
    if not mode:
        bad("mode_bad", cfg.get("mode"), "%s.cfg: invalid mode %r (240p, 240p-hack, 480i or WIDTHxHEIGHT@HZ)" % (base, cfg.get("mode")))
    out["mode"] = mode
    category = cfg.get("category", "")
    if len(category) > 80:
        bad("category_long", "", "%s.cfg: category too long" % base)
    out["category"] = category
    controls = [c.strip().lower() for c in cfg.get("controls", "").split(",") if c.strip()]
    wrong = [c for c in controls if c not in CONTROLS]
    if wrong:
        bad("controls_bad", ",".join(wrong),
            "%s.cfg: unknown controls %s (use %s)" % (base, ",".join(wrong), ",".join(CONTROLS)))
    out["controls"] = ",".join(dict.fromkeys(controls))
    for key, low in (("buttons", 0), ("players", 1)):
        value = cfg.get(key, "")
        if value and not (value.isdigit() and low <= int(value) <= 8):
            bad(key + "_bad", value, "%s.cfg: %s must be %d to 8" % (base, key, low))
        out[key] = value
    if found and problems is None:
        raise Bad(problems=found, looks=True)
    return out


def rel_path(p):
    """Um caminho relativo limpo (barras do Windows tambem), ou "" se ele
    sai da pasta."""
    parts = [x for x in p.replace("\\", "/").split("/") if x not in ("", ".")]
    if not parts or ".." in parts or p.startswith(("/", "\\")):
        return ""
    return "/".join(parts)


class Package:
    """Um JOGO.fliperos-customgame.zip conferido."""

    def __init__(self, path):
        self.path = path
        try:
            self.zf = zipfile.ZipFile(path)
        except (OSError, zipfile.BadZipFile) as exc:
            raise Bad("not a zip file: %s" % exc, "not_zip")
        # O que poe o gabinete em risco para tudo na hora; o resto (o que
        # falta, o que sobra, o cfg) e juntado: a lista mostra tudo de uma vez.
        entries = []
        for info in self.zf.infolist():
            name = info.filename.replace("\\", "/")
            if name.startswith("/") or re.match(r"^[A-Za-z]:", name):
                raise Bad("absolute path in the zip: %s" % info.filename, "unsafe", info.filename)
            parts = name.rstrip("/").split("/")
            if ".." in parts:
                raise Bad("'..' in the zip: %s" % info.filename, "unsafe", info.filename)
            if info.flag_bits & 1:
                raise Bad("the zip is encrypted: %s" % info.filename, "encrypted", info.filename)
            kind = stat.S_IFMT(info.external_attr >> 16) if info.create_system == 3 else 0
            if kind == stat.S_IFLNK:
                raise Bad("link in the zip: %s" % info.filename, "unsafe", info.filename)
            if kind not in (0, stat.S_IFREG, stat.S_IFDIR):
                raise Bad("special file in the zip: %s" % info.filename, "unsafe", info.filename)
            if name.startswith("__MACOSX/") or parts[-1] in (".DS_Store", "Thumbs.db", "desktop.ini"):
                continue
            entries.append((name, info))
        problems = []
        bad = lambda code, arg, text: problems.append((code, arg, text))
        # O cfg no topo; ou tudo dentro de uma pasta so (o zip da pasta).
        prefix = ""
        tops = {n.split("/")[0] for n, _ in entries}
        if not [n for n, _ in entries if "/" not in n and n.lower().endswith(".cfg")] and len(tops) == 1 and \
                any("/" in n for n, _ in entries):
            only = next(iter(tops))
            if [n for n, _ in entries if n.lower().endswith(".cfg") and n.count("/") == 1 and n.startswith(only + "/")]:
                prefix = only + "/"
        cfgs = [n[len(prefix):] for n, _ in entries
                if n.startswith(prefix) and "/" not in n[len(prefix):] and n.lower().endswith(".cfg")]
        looks = bool(cfgs)
        if len(cfgs) == 1:
            self.base = cfgs[0][:-4]
        else:
            # Sem o cfg: o nome pela pasta do jogo (a unica do zip) ou pelo zip.
            dirs = sorted({n[len(prefix):].split("/")[0] for n, _ in entries
                           if n.startswith(prefix) and "/" in n[len(prefix):]})
            stem = os.path.basename(path)
            stem = stem[:-len(SUFFIX)] if stem.lower().endswith(SUFFIX) else stem.rsplit(".", 1)[0]
            self.base = dirs[0] if len(dirs) == 1 else stem
            if not cfgs:
                bad("cfg_missing", self.base + ".cfg", "%s.cfg is missing (the settings: platform, exe or command...)"
                    % self.base)
            else:
                bad("cfg_many", len(cfgs), "the package needs one GAME.cfg, it has %d" % len(cfgs))
        if not valid_name(self.base):
            raise Bad("invalid package name: %r" % self.base, "name_bad", self.base)
        self.files = {}          # caminho dentro da pasta do jogo -> ZipInfo
        self.extra = {}          # cfg, key, ppdb, snap, preview, texto -> (ZipInfo, extensao)
        folder = self.base + "/"
        strangers = []
        for name, info in entries:
            rel = name[len(prefix):] if name.startswith(prefix) else None
            if rel in ("", folder):
                continue
            if rel is not None and rel.startswith(folder):
                inner = rel[len(folder):]
                if not info.is_dir() and not name.endswith("/"):
                    self.files[inner] = info
                continue
            if rel is None or "/" in rel.rstrip("/") or rel.endswith("/"):
                if rel is None or not name.endswith("/"):
                    strangers.append(info.filename)
                continue
            stem, dot, ext = rel.rpartition(".")
            ext = ext.lower()
            kind = {"cfg": "cfg", "key": "key", "ppdb": "ppdb", "txt": "texto"}.get(ext)
            kind = kind or ("snap" if ext in IMAGE_EXTS else "preview" if ext in VIDEO_EXTS else None)
            if not dot or stem != self.base or not kind:
                if not (kind == "cfg" and len(cfgs) > 1):
                    strangers.append(info.filename)
                continue
            if kind in self.extra:
                bad("two_files", kind, "two %s files in the zip (%s)" % (kind, info.filename))
                continue
            self.extra[kind] = (info, ext)
        for name in strangers[:5]:
            bad("stranger", name, "unexpected file in the zip: %s (the files are %s.* and the folder %s)"
                % (name, self.base, folder))
        if len(strangers) > 5:
            bad("strangers_more", len(strangers) - 5, "and %d more unexpected files" % (len(strangers) - 5))
        if not self.files:
            bad("folder_missing", folder, "the folder %s is missing or empty in the zip" % folder)
        self.cfg = {}
        if "cfg" in self.extra:
            try:
                raw = self.read("cfg").decode("utf-8")
            except UnicodeDecodeError:
                bad("cfg_text", self.base + ".cfg", "%s.cfg is not text (UTF-8)" % self.base)
            else:
                self.cfg = check_cfg(parse_cfg(raw), self.base, self.files, problems)
        if problems:
            raise Bad(problems=problems, looks=looks)
        self.bytes = sum(i.file_size for i in self.files.values())

    def read(self, kind):
        info, _ = self.extra[kind]
        if info.file_size > (1 << 26) and kind in ("cfg", "key", "ppdb", "texto"):
            raise Bad("%s is too big" % info.filename)
        return self.zf.read(info)

    def summary(self):
        lines = ["%s=%s" % (k, v) for k, v in self.cfg.items()]
        lines += ["base=%s" % self.base, "bytes=%d" % self.bytes,
                  "media=%s" % ",".join(k for k, _ in MEDIA if k in self.extra),
                  "key=%d" % ("key" in self.extra), "ppdb=%d" % ("ppdb" in self.extra)]
        return "\n".join(lines)


# ── A lista dos que faltam instalar ──

def packages(folder, misnamed=False):
    """Os pacotes da pasta deles (~/roms/custom-packages), em ordem; com
    misnamed, os outros .zip de la (um pacote com o nome errado, ou um zip
    qualquer)."""
    out = []
    try:
        names = sorted(os.listdir(folder), key=str.lower)
    except OSError:
        return out
    for n in names:
        low = n.lower()
        path = os.path.join(folder, n)
        if low.endswith(".zip") and low.endswith(SUFFIX) != misnamed and not n.startswith(".") and os.path.isfile(path):
            out.append(path)
    return out


def installed(roms):
    """{zip: (stamp, grupo, nome)} dos jogos instalados de um pacote."""
    out = {}
    for group in os.listdir(roms) if os.path.isdir(roms) else ():
        folder = os.path.join(roms, group)
        if group.startswith(".") or not os.path.isdir(folder):
            continue
        for n in os.listdir(folder):
            if not n.endswith(".cfg"):
                continue
            try:
                cfg = read_cfg(os.path.join(folder, n))
            except OSError:
                continue
            if cfg.get("package"):
                out[cfg["package"]] = (cfg.get("package_stamp", ""), group, n[:-4])
    return out


def cmd_pending(args):
    done = installed(args.roms)
    for path in packages(args.packages):
        try:
            current = stamp(path)
        except OSError:
            continue
        stamped, group, name = done.get(path, ("", "", ""))
        try:
            pkg = Package(path)
        except Bad as exc:
            print_bad(path, os.path.basename(path)[:-len(SUFFIX)], exc.problems)
            continue
        # Instalado dele: installed (o mesmo zip) ou update (o zip mudou).
        state = ("installed" if stamped == current else "update") if group else "new"
        print("|".join((path, group, name or pkg.cfg["name"], pkg.cfg["platform"], state, "", "")))
    # Um pacote com outro nome (Pang.zip): a lista diz o nome certo, e os
    # outros problemas dele. Um zip sem .cfg nenhum fica de fora (pode ser de
    # outra coisa).
    for path in packages(args.packages, misnamed=True):
        stem = os.path.basename(path).rsplit(".", 1)[0]
        stem = stem[:-len(".fliperos-customgame")] if stem.lower().endswith(".fliperos-customgame") else stem
        rename = ("misnamed", stem + SUFFIX, "rename it to %s%s (packages always end in %s)" % (stem, SUFFIX, SUFFIX))
        try:
            pkg = Package(path)
        except Bad as exc:
            if exc.looks:
                print_bad(path, stem, [rename] + exc.problems)
            continue
        print_bad(path, pkg.cfg["name"], [rename], pkg.cfg["platform"])
    return 0


def package_info(path, done):
    """Tudo de um pacote para os cartoes do painel (Instalar pacotes): o
    estado, o grupo, o cfg, os tamanhos, os arquivos de midia dentro do zip
    (o painel os mostra) e os problemas. None: um .zip que nao e pacote."""
    st = os.stat(path)
    base = os.path.basename(path)
    misnamed = not base.lower().endswith(SUFFIX)
    stem = base.rsplit(".", 1)[0]
    stem = stem[:-len(".fliperos-customgame")] if stem.lower().endswith(".fliperos-customgame") else stem
    if not misnamed:
        stem = base[:-len(SUFFIX)]
    row = {"zip": path, "file": base, "size": st.st_size, "mtime": int(st.st_mtime), "state": "", "group": "",
           "name": stem, "platform": "", "mode": "", "category": "", "controls": "", "buttons": "", "players": "",
           "bytes": 0, "media": {}, "key": False, "ppdb": False, "problems": []}
    problems = []
    if misnamed:
        problems.append(("misnamed", stem + SUFFIX, "rename it to %s%s (packages always end in %s)" % (stem, SUFFIX, SUFFIX)))
    try:
        pkg = Package(path)
    except Bad as exc:
        if misnamed and not exc.looks:
            return None
        problems += exc.problems
    else:
        row.update({k: pkg.cfg.get(k, "") for k in ("name", "platform", "mode", "category", "controls", "buttons", "players")})
        row.update(bytes=pkg.bytes, key="key" in pkg.extra, ppdb="ppdb" in pkg.extra,
                   media={kind: pkg.extra[kind][0].filename for kind, _ in MEDIA if kind in pkg.extra})
        stamped, group, name = done.get(path, ("", "", ""))
        row["state"] = ("installed" if stamped == stamp(path) else "update") if group else "new"
        row["group"] = group
    if problems:
        row["state"] = "bad"
        row["problems"] = [{"code": c, "arg": str(a), "text": t} for c, a, t in problems]
    return row


