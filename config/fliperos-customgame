# ── Pacotes em partes ──
# Um pacote maior que o arquivo do plano gratuito do Telegram (2 GB) anda em partes, GAME.fliperos-customgame.zip.001,
# .002... (o painel web as faz, config/fliperos-web; o robo do grupo as le como um pacote so). Aqui elas voltam a ser o zip:
# a partir de qualquer uma, o duplo clique no desktop e o envio pelo painel.

PART_RE = re.compile(r"^(.+" + re.escape(SUFFIX) + r")\.(\d{3})$", re.I)


def part_set(path):
    """As partes do pacote a que PATH pertence, achadas na pasta dele: (nome do zip, [(numero, caminho, tamanho)] em ordem,
    problemas em ingles). Bad: PATH nao e uma parte. Os problemas: numeracao com furo, ou partes de tamanhos diferentes (todas,
    menos a ultima, tem o mesmo tamanho, e a ultima nao e maior); quem nao tem a ultima parte so se sabe ao juntar (o
    resultado nao e um zip)."""
    folder, name = os.path.split(os.path.abspath(path))
    match = PART_RE.match(name)
    if not match:
        raise Bad("%s is not a part of a package (parts end in %s.001, .002...)" % (name, SUFFIX))
    base, found = match.group(1), {}
    try:
        names = os.listdir(folder)
    except OSError as exc:
        raise Bad("cannot read %s: %s" % (folder, exc))
    for other in names:
        m = PART_RE.match(other)
        full = os.path.join(folder, other)
        if m and m.group(1).lower() == base.lower() and os.path.isfile(full):
            found[int(m.group(2))] = full
    count = max(found)
    parts = [(n, found[n], os.path.getsize(found[n])) for n in sorted(found)]
    problems = []
    missing = [n for n in range(1, count + 1) if n not in found]
    if missing:
        problems.append("part%s %s %s missing" % ("s" if len(missing) > 1 else "", ", ".join("%03d" % n for n in missing),
                                                  "are" if len(missing) > 1 else "is"))
    else:
        sizes = [size for _, _, size in parts]
        if any(size != sizes[0] for size in sizes[:-1]) or sizes[-1] > sizes[0]:
            problems.append("the parts, except the last one, must have the same size")
    return base, parts, problems


def cmd_parts(args):
    """parts PARTE: base=, out= (o zip na pasta dos pacotes), count=, bytes=, uma linha "part|N|caminho|tamanho" por parte
    e uma "problem|texto" por problema. Status 1: com problemas (ou nao e uma parte)."""
    try:
        base, parts, problems = part_set(args.part)
    except Bad as exc:
        print(str(exc), file=sys.stderr)
        return 1
    print("base=%s" % base)
    print("out=%s" % os.path.join(args.packages, base))
    print("count=%d" % len(parts))
    print("bytes=%d" % sum(size for _, _, size in parts))
    for number, path, size in parts:
        print("part|%d|%s|%d" % (number, path, size))
    for text in problems:
        print("problem|%s" % text)
    return 1 if problems else 0


def cmd_join(args):
    """join PARTE: as partes viram o zip da pasta dos pacotes (com --progress, os eventos). A parte pode ser qualquer uma delas.
    --remove-parts: as partes que estao na pasta dos pacotes saem depois (as de fora, um pendrive, ficam). Imprime out=. Status
    3: o zip ja existe (sem --replace); 1: erro, e nada fica pela metade."""
    progress = Progress(args.progress is not None, *(args.progress or (0, 100)))
    progress.step(0, "Checking the parts")
    tmp = ""
    try:
        base, parts, problems = part_set(args.part)
        if problems:
            raise Bad("; ".join(problems))
        total = sum(size for _, _, size in parts)
        out = os.path.join(args.packages, base)
        if os.path.exists(out) and not args.replace:
            print("%s is already in the packages folder" % base, file=sys.stderr)
            return 3
        makedirs(args.packages)
        if free_bytes(args.packages) < total + (64 << 20):
            raise Bad("not enough free space: joining the parts needs %d MB" % ((total + (64 << 20)) >> 20))
        tmp = os.path.join(args.packages, ".%s.joining" % base)
        progress.step(0.02, "Joining %d parts" % len(parts))
        ticks = Progress(progress.on, progress.pct(0.02), progress.pct(0.97))
        done = 0
        with open(tmp, "wb") as dst:
            for _, path, _ in parts:
                with open(path, "rb") as src:
                    while True:
                        chunk = src.read(CHUNK)
                        if not chunk:
                            break
                        dst.write(chunk)
                        done += len(chunk)
                        ticks.tick(done / max(1, total))
        if not zipfile.is_zipfile(tmp):
            raise Bad("the parts do not make a zip file: a part may be missing (the last one has the end of the zip) or damaged")
        os.chmod(tmp, 0o644)
        give(tmp)
        os.replace(tmp, out)
        tmp = ""
        if args.remove_parts:
            inside = os.path.realpath(args.packages)
            for _, path, _ in parts:
                if os.path.realpath(os.path.dirname(path)) == inside:
                    try:
                        os.remove(path)
                    except OSError:
                        pass
    except (Bad, OSError) as exc:
        if tmp:
            try:
                os.remove(tmp)
            except OSError:
                pass
        if progress.on:
            print("@fail Joining|%s" % exc, flush=True)
        print(str(exc), file=sys.stderr)
        return 1
    print("out=%s" % out)
    progress.step(1, "%s joined" % base)
    return 0


# ── Fazer um pacote ──

def cmd_pack(args):
    progress = Progress(args.progress is not None, *(args.progress or (0, 100)))
    progress.step(0, "Checking the game")
    try:
        if not valid_name(args.name):
            raise Bad("invalid game name: %r" % args.name)
        folder = os.path.realpath(args.folder)
        if not os.path.isdir(folder):
            raise Bad("not a folder: %s" % args.folder)
        files = []
        for top, dirs, names in os.walk(folder):
            dirs.sort()
            for n in sorted(names):
                path = os.path.join(top, n)
                if os.path.islink(path) or not os.path.isfile(path):
                    continue
                files.append((path, os.path.relpath(path, folder).replace(os.sep, "/")))
        if not files:
            raise Bad("the folder %s is empty" % folder)
        base = re.sub(r"[^A-Za-z0-9 ._()&'+,-]+", "_", args.name).strip(" .") or "game"
        cfg = {"name": args.name, "platform": args.platform, "mode": args.mode, "category": args.category or "",
               "controls": args.controls or "", "buttons": args.buttons or "", "players": args.players or "",
               "year": args.year or "", "developer": args.developer or "", "crop169": "1" if args.crop169 else ""}
        if args.platform == "windows":
            exe = os.path.realpath(os.path.join(folder, args.exe or ""))
            if not exe.startswith(folder + os.sep) or not os.path.isfile(exe):
                raise Bad("the .exe must be inside the game folder: %s" % args.exe)
            cfg["exe"] = os.path.relpath(exe, folder).replace(os.sep, "/")
            cfg["runner"] = args.runner or ""
        else:
            cfg["command"] = args.command or ""
        rels = {r for _, r in files}
        cfg = check_cfg(cfg, base, rels)
        extras = []
        # --joystick: o jogo ja aceita o joystick, o pacote leva um .key vazio (escrito abaixo) no lugar de
        # qualquer --key.
        for opt, kind, exts in ((args.snap, "snap", IMAGE_EXTS), (args.video, "preview", VIDEO_EXTS),
                                (args.text, "texto", ("txt",)), (args.logo, "logo", LOGO_EXTS),
                                (args.icon, "icon", ICON_EXTS),
                                (None if args.joystick else args.key, "key", ("key",)), (args.ppdb, "ppdb", ("ppdb",))):
            if not opt:
                continue
            ext = opt.rsplit(".", 1)[-1].lower() if kind in ("snap", "preview", "logo", "icon") else exts[0]
            if ext not in exts or not os.path.isfile(opt):
                raise Bad("not a %s file: %s" % (kind, opt))
            extras.append((opt, "%s%s.%s" % (base, ".%s" % kind if kind in ("logo", "icon") else "", ext)))
        out = os.path.abspath(args.out)
        if not out.endswith(SUFFIX):
            raise Bad("the package name must end in %s" % SUFFIX)
        total = sum(os.path.getsize(p) for p, _ in files) + sum(os.path.getsize(p) for p, _ in extras)
        if free_bytes(os.path.dirname(out)) < total + (64 << 20):
            raise Bad("not enough free space for the package (%d MB)" % (total >> 20))
        tmp = out + ".part"
        done = 0
        progress.step(0.02, "Packing %s" % args.name)
        tick = Progress(progress.on, progress.pct(0.02), progress.pct(0.98))
        try:
            with zipfile.ZipFile(tmp, "w", allowZip64=True) as zf:
                zf.writestr(base + ".cfg", cfg_text(cfg), zipfile.ZIP_DEFLATED)
                if args.text_string:
                    zf.writestr(base + ".txt", args.text_string.replace("\\n", "\n") + "\n", zipfile.ZIP_DEFLATED)
                if args.joystick:
                    zf.writestr(base + ".key", "\n".join(KEY_HEADER) + "\n", zipfile.ZIP_DEFLATED)
                for path, arc in extras + [(p, base + "/" + r) for p, r in files]:
                    ext = path.rsplit(".", 1)[-1].lower() if "." in os.path.basename(path) else ""
                    method = zipfile.ZIP_STORED if ext in STORED_EXTS else zipfile.ZIP_DEFLATED
                    info = zipfile.ZipInfo.from_file(path, arc)
                    info.compress_type = method
                    with open(path, "rb") as src, zf.open(info, "w", force_zip64=True) as dst:
                        while True:
                            chunk = src.read(CHUNK)
                            if not chunk:
                                break
                            dst.write(chunk)
                            done += len(chunk)
                            tick.tick(done / max(1, total))
            give(tmp)
            os.replace(tmp, out)
        except BaseException:
            try:
                os.remove(tmp)
            except OSError:
                pass
            raise
    except (Bad, OSError, ValueError) as exc:
        if progress.on:
            print("@fail Packing|%s" % exc, flush=True)
        print(str(exc), file=sys.stderr)
        return 1
    progress.step(1, "%s packed" % args.name)
    print(out if not progress.on else "@msg %s" % out, flush=True)
    return 0


# ── Adicionar de uma pasta (o painel web) ──
# A pasta de um jogo (subida pelo painel, num disco externo...) copiada para
# ~/games/GRUPO/NOME, como a de um pacote instalado, com o cfg sem package=.

def tree_files(folder):
    """[(caminho, relativo)] dos arquivos da pasta, e os atalhos que ficam
    dentro dela (os .so de um jogo do Linux) como (caminho, relativo, alvo)."""
    files, links = [], []
    root = os.path.realpath(folder)
    for top, dirs, names in os.walk(folder):
        dirs.sort()
        for n in sorted(names) + [d for d in dirs if os.path.islink(os.path.join(top, d))]:
            path = os.path.join(top, n)
            rel = os.path.relpath(path, folder).replace(os.sep, "/")
            if os.path.islink(path):
                target = os.readlink(path)
                real = os.path.realpath(path)
                if not os.path.isabs(target) and (real == root or real.startswith(root + os.sep)):
                    links.append((path, rel, target))
                continue
            if os.path.isfile(path):
                files.append((path, rel))
    return files, links


def copy_tree(folder, target, progress):
    files, links = tree_files(folder)
    total = max(1, sum(os.path.getsize(p) for p, _ in files))
    done = 0
    for path, rel in files:
        dest = os.path.join(target, *rel.split("/"))
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with open(path, "rb") as src, open(dest, "wb") as out:
            while True:
                chunk = src.read(CHUNK)
                if not chunk:
                    break
                out.write(chunk)
                done += len(chunk)
                progress.tick(done / total)
        os.chmod(dest, 0o755 if os.stat(path).st_mode & 0o111 else 0o644)
    for _, rel, link in links:
        dest = os.path.join(target, *rel.split("/"))
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        os.symlink(link, dest)
    for top, dirs, _ in os.walk(target):
        for d in dirs:
            if not os.path.islink(os.path.join(top, d)):
                os.chmod(os.path.join(top, d), 0o755)


def cmd_add(args):
    progress = Progress(args.progress is not None, *(args.progress or (0, 100)))
    progress.step(0, "Checking %s" % args.name)
    try:
        group, name = args.group, args.name
        if not valid_name(group):
            raise Bad("invalid group name: %r" % group)
        if not valid_name(name):
            raise Bad("invalid game name: %r" % name)
        source = os.path.realpath(args.folder)
        if not os.path.isdir(source):
            raise Bad("not a folder: %s" % args.folder)
        gdir = os.path.join(args.roms, group)
        folder = os.path.join(args.games, group, name)
        real = os.path.realpath(folder)
        if source == real or source.startswith(real + os.sep) or real.startswith(source + os.sep):
            raise Bad("the game folder cannot be copied into itself: %s" % args.folder)
        exists = any(os.path.exists(os.path.join(gdir, name + ext)) for ext in (".sh", ".cfg")) \
            or os.path.lexists(folder)
        if exists and not args.replace:
            print("%s is already in %s" % (name, group), file=sys.stderr)
            return 3
        if os.path.ismount(folder):
            raise Bad("%s is a packed folder: remove it first" % folder)
        files, _ = tree_files(source)
        if not files:
            raise Bad("the folder %s is empty" % args.folder)
        cfg = {"name": name, "platform": args.platform, "mode": args.mode, "category": args.category or "",
               "controls": args.controls or "", "buttons": args.buttons or "", "players": args.players or "",
               "year": args.year or "", "developer": args.developer or "", "crop169": "1" if args.crop169 else ""}
        rels = {r for _, r in files}
        if args.platform == "windows":
            cfg["exe"] = rel_path(args.exe or "")
            cfg["runner"] = args.runner or ""
            if cfg["exe"] not in rels:
                raise Bad("the .exe %s is not in the folder %s" % (args.exe or "(none)", args.folder))
        else:
            cfg["command"] = args.command or ""
            if not cfg["command"].strip():
                raise Bad("no command (what opens the game, run in its folder)")
        cfg = check_cfg(cfg, name, rels)
        media = media_files(args.snap, args.video, args.text, args.logo, args.icon)
        # --joystick: o jogo ja aceita o joystick; o .key fica vazio (so o cabecalho), no lugar de qualquer --key.
        keys = b"" if args.joystick else side_text(args.key, "key")
        ppdb = side_text(args.ppdb, "ppdb") if args.platform == "windows" else None
        size = sum(os.path.getsize(p) for p, _ in files)
        if free_bytes(args.games) < size + (64 << 20):
            raise Bad("not enough free space: the game needs %d MB" % (size >> 20))
        makedirs(os.path.join(args.games, group))
        makedirs(gdir)
        tmp = os.path.join(args.games, group, ".%s.installing" % name)
        shutil.rmtree(tmp, ignore_errors=True)
        os.mkdir(tmp)
        progress.step(0.01, "Copying %s" % name)
        try:
            copy_tree(source, tmp, Progress(progress.on, progress.pct(0.01), progress.pct(0.95)))
            if ppdb is not None:
                # O do PortProton ao lado do .exe, como o de um pacote.
                write_file(os.path.join(tmp, *(cfg["exe"] + ".ppdb").split("/")), ppdb)
            give_tree(tmp)
            if os.path.lexists(folder):
                shutil.rmtree(folder)
            os.rename(tmp, folder)
        except BaseException:
            shutil.rmtree(tmp, ignore_errors=True)
            raise
        progress.step(0.96, "Pictures and settings")
        for kind, ext, path in media:
            put_media(args.media, group, name, kind, ext, lambda path=path: open(path, "rb"))
        if args.text_string:
            put_text(args.media, group, name, args.text_string)
        write_file(os.path.join(gdir, name + ".cfg"), cfg_text(dict(cfg, folder=folder)))
        if keys is not None:
            lines = key_lines(keys.decode("utf-8", "replace"))
            write_file(os.path.join(gdir, name + ".key"), "\n".join(KEY_HEADER + lines) + "\n")
    except (Bad, OSError) as exc:
        if progress.on:
            print("@fail Copying|%s" % exc, flush=True)
        print(str(exc), file=sys.stderr)
        return 1
    progress.step(1, "%s added" % name)
    return 0


def cmd_media(args):
