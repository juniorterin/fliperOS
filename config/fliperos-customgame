def put_media(media, group, name, kind, ext, opener):
    """Grava uma midia do jogo em ~/media/TIPO/custom/GRUPO/NOME.ext; opener()
    abre o conteudo (do zip ou de um arquivo solto)."""
    exts = dict(MEDIA)[kind]
    folder = os.path.join(media, kind, "custom", group)
    makedirs(folder)
    # A nova vale: as outras extensoes do mesmo tipo (a de exemplo, uma
    # antiga) sairiam na frente dela.
    for other in exts:
        old = os.path.join(folder, "%s.%s" % (name, other))
        if os.path.isfile(old):
            os.remove(old)
            unmark_sample(media, old)
    dest = os.path.join(folder, "%s.%s" % (name, ext))
    with opener() as src, open(dest + ".tmp", "wb") as out:
        shutil.copyfileobj(src, out, CHUNK)
    os.chmod(dest + ".tmp", 0o644)
    give(dest + ".tmp")
    os.replace(dest + ".tmp", dest)


