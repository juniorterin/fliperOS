def file_sha(opener):
    import hashlib
    digest = hashlib.sha256()
    with opener() as src:
        while True:
            chunk = src.read(CHUNK)
            if not chunk:
                return digest.hexdigest()
            digest.update(chunk)


def is_sample(media, path):
    """A midia de exemplo que o Setup fez (~/media/.custom-samples: a linha do
    sha256sum, "HASH  CAMINHO"); a pessoa trocando a imagem, deixa de ser."""
    try:
        with open(os.path.join(media, ".custom-samples"), encoding="utf-8", errors="replace") as f:
            lines = f.read().splitlines()
    except OSError:
        return False
    return "%s  %s" % (file_sha(lambda: open(path, "rb")), path) in lines


def real_media(media, kind, group, name):
    """A midia de verdade (a que a pessoa pos, ou veio do pacote; nao a de
    exemplo) de um jogo instalado, em ~/media/TIPO/custom/GRUPO, ou None."""
    for ext in dict(MEDIA)[kind]:
        path = os.path.join(media, kind, "custom", group, "%s.%s" % (name, ext))
        if os.path.isfile(path) and not is_sample(media, path):
            return path
    return None


def package_in_sync(args, group, name):
    """O pacote de um jogo instalado (o package= do cfg dele) existe e leva o
    mesmo que o jogo tem agora: as configuracoes (as que a pessoa mudou
    depois de instalar), o .key (o que ela definiu no menu na tela), a arte e o
    .ppdb. Os arquivos do jogo nao entram (so mudam jogando). Assim baixar o
    pacote de um jogo que nada mudou nao o refaz, e um que mudou, sim."""
    cfgfile = os.path.join(args.roms, group, name + ".cfg")
    try:
        cfg = read_cfg(cfgfile)
        zip_path = cfg.get("package", "")
        if not zip_path or not os.path.isfile(zip_path) or stamp(zip_path) != cfg.get("package_stamp"):
            return False
        pkg = Package(zip_path)
        if pkg.cfg != check_cfg(cfg, name, set()):
            return False
        keyfile = os.path.join(args.roms, group, name + ".key")
        has_key = os.path.isfile(keyfile)
        if has_key != ("key" in pkg.extra):
            return False
        if has_key and key_lines(open(keyfile, encoding="utf-8", errors="replace").read()) != \
                key_lines(pkg.read("key").decode("utf-8", "replace")):
            return False
        for kind, _ in MEDIA:
            current = real_media(args.media, kind, group, name)
            if (current is None) != (kind not in pkg.extra):
                return False
            if current and file_sha(lambda: open(current, "rb")) != file_sha(lambda: pkg.zf.open(pkg.extra[kind][0])):
                return False
        ppdb = os.path.join(cfg.get("folder", ""), cfg.get("exe", "") + ".ppdb") if cfg.get("platform") == "windows" else ""
        if ppdb and os.path.isfile(ppdb) != ("ppdb" in pkg.extra):
            return False
        if ppdb and os.path.isfile(ppdb) and open(ppdb, "rb").read() != pkg.read("ppdb"):
            return False
    except (Bad, OSError, ValueError):
        return False
    return True


def cmd_synced(args):
    """Status 0: o pacote do jogo esta em dia (package_in_sync); 1: nao."""
    return 0 if package_in_sync(args, args.group, args.name) else 1


