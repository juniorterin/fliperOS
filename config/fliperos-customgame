def mapper(cfg_path):
    """O mapa do controle para o teclado enquanto o jogo roda (fliperos-buttons
    gamekeys): sobe sempre, mesmo sem o .key (a OSD o edita com o jogo
    aberto). None sem ele."""
    tool = os.path.join(BIN, "fliperos-buttons")
    if not os.access(tool, os.X_OK) or ENV("FLIPEROS_CUSTOMGAME_KEYS") == "off":
        return None
    keyfile = cfg_path[:-4] + ".key"
    try:
        return subprocess.Popen([tool, "gamekeys", keyfile, "--parent", str(os.getpid())],
                                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
    except OSError:
        return None


def windows_command(exe):
    """O .exe pelo PortProton (instalado pelo Setup na hora do primeiro jogo
    do Windows); sem ele, pelo Wine do sistema."""
    portproton = os.path.join(BIN, "fliperos-portproton")
    if os.access(portproton, os.X_OK) and subprocess.run([portproton, "check"], stdout=subprocess.DEVNULL,
                                                         stderr=subprocess.DEVNULL).returncode == 0:
        return [portproton, "run", exe]
    wine = shutil.which("wine")
    if wine:
        print("fliperos-customgame: PortProton is not installed, opening %s with %s" % (exe, wine), file=sys.stderr)
        return [wine, exe]
    return None


def cmd_run(args):
    path = os.path.abspath(args.cfg)
    try:
        cfg = read_cfg(path)
    except OSError as exc:
        print("fliperos-customgame: %s" % exc, file=sys.stderr)
        return 1
    platform = cfg.get("platform", "")
    folder = cfg.get("folder", "")
    if platform == "command":
        argv, cwd = ["bash", "-c", cfg.get("command", "")], player_home()
    elif platform in PLATFORMS:
        if not os.path.isdir(folder):
            print("fliperos-customgame: the game folder is missing: %s" % folder, file=sys.stderr)
            return 1
        if platform == "native":
            argv, cwd = ["bash", "-c", cfg.get("command", "")], folder
        else:
            exe = os.path.join(folder, *cfg.get("exe", "").split("/"))
            argv, cwd = windows_command(exe), os.path.dirname(exe)
            if not argv:
                print("fliperos-customgame: neither PortProton nor Wine is installed", file=sys.stderr)
                return 1
    else:
        print("fliperos-customgame: unknown platform %r in %s" % (platform, path), file=sys.stderr)
        return 1
    keys = mapper(path)
    try:
        game = subprocess.Popen(argv, cwd=cwd)
    except OSError as exc:
        print("fliperos-customgame: %s" % exc, file=sys.stderr)
        if keys:
            keys.terminate()
        return 1

    def stop(sig, _frame):
        try:
            game.send_signal(sig)
        except OSError:
            pass

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, stop)
    rc = game.wait()
    if keys:
        keys.terminate()
        try:
            keys.wait(3)
        except subprocess.TimeoutExpired:
            keys.kill()
    return rc


def main():
    home = player_home()
    p = argparse.ArgumentParser(prog="fliperos-customgame")
    p.add_argument("--roms", default=ENV("FLIPEROS_CUSTOMGAME_ROMS", os.path.join(home, "roms", "custom")))
    p.add_argument("--games", default=ENV("FLIPEROS_CUSTOMGAME_GAMES", os.path.join(home, "games")))
    p.add_argument("--media", default=ENV("FLIPEROS_CUSTOMGAME_MEDIA", os.path.join(home, "media")))
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("inspect")
    s.add_argument("zip")
    sub.add_parser("pending")
    s = sub.add_parser("install")
    s.add_argument("zip")
    s.add_argument("--group", required=True)
    s.add_argument("--replace", action="store_true")
    s.add_argument("--progress", nargs="*", type=int)
    s = sub.add_parser("pack")
    s.add_argument("--out", required=True)
    s.add_argument("--name", required=True)
    s.add_argument("--platform", choices=PLATFORMS, required=True)
    s.add_argument("--folder", required=True)
    s.add_argument("--exe")
    s.add_argument("--command")
    s.add_argument("--mode", default="640x240@60")
    for opt in ("category", "controls", "buttons", "players", "snap", "video", "text", "text-string", "key", "ppdb"):
        s.add_argument("--" + opt)
    s.add_argument("--progress", nargs="*", type=int)
    s = sub.add_parser("run")
    s.add_argument("cfg")
    args = p.parse_args()
    for name in ("progress",):
        value = getattr(args, name, None)
        if value is not None and len(value) not in (0, 2):
            p.error("--progress takes no value or START END")
    return {"inspect": cmd_inspect, "pending": cmd_pending, "install": cmd_install, "pack": cmd_pack,
            "run": cmd_run}[args.cmd](args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(1)
