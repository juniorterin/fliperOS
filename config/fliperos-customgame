# O renderizador pelo driver da placa do CRT (config/fliperos-wine-renderer:
# "vulkan" ou "opengl"). No PortProton ele e o PW_VULKAN_USE do .ppdb de cada
# .exe: 0 = WineD3D (OpenGL, "para placas sem Vulkan") e 2 = DXVK e VKD3D
# estaveis (Vulkan 1.3+); 1 e 6 sao o Sarek e o mais novo (os valores do
# start.sh do PortWINE; 3 a 5 ele descarta). No Wine do sistema e no Staging,
# o fliperos-x11-client escolhe pelas sobreposicoes de DLL.
PORTPROTON_VULKAN = {"opengl": "0", "vulkan": "2"}
PORTPROTON_VULKAN_ON = ("1", "2", "6")


def gpu_renderer():
    """vulkan ou opengl pelo driver da placa do CRT; "" se o seletor falta."""
    picker = ENV("FLIPEROS_WINE_RENDERER_BIN") or os.path.join(BIN, "fliperos-wine-renderer")
    if not os.access(picker, os.X_OK):
        return ""
    try:
        out = subprocess.run([picker], capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""
    return out if out in PORTPROTON_VULKAN else ""


def ppdb_value(exe, key):
    """O valor de CHAVE no EXE.ppdb do PortProton (export CHAVE=valor), ou ""."""
    try:
        with open(exe + ".ppdb", encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return ""
    found = re.findall(r"(?m)^\s*(?:export\s+)?%s=[\"']?([^\"'\s]*)" % re.escape(key), text)
    return found[-1] if found else ""


def portproton_renderer(argv, exe):
    """Antes de abrir um .exe pelo PortProton, o PW_VULKAN_USE dele de acordo
    com a placa: sem Vulkan (radeon, nouveau, Intel antiga) vai sempre para o
    OpenGL (0), porque o DXVK nem abriria; com Vulkan vai para o DXVK e o VKD3D
    (2) quando o .ppdb nao tem um deles (um 1 ou 6 do pacote fica). So grava
    (um start do PortProton, alguns segundos) quando o valor muda."""
    if not argv or os.path.basename(argv[0]) != "fliperos-portproton":
        return
    renderer = gpu_renderer()
    if not renderer:
        return
    now = ppdb_value(exe, "PW_VULKAN_USE")
    if renderer == "opengl" and now == "0":
        return
    if renderer == "vulkan" and now in PORTPROTON_VULKAN_ON:
        return
    value = PORTPROTON_VULKAN[renderer]
    print("fliperos-customgame: %s: PW_VULKAN_USE=%s (%s)" % (os.path.basename(exe), value, renderer), file=sys.stderr)
    try:
        subprocess.run([argv[0], "edit-db", exe, "PW_VULKAN_USE=" + value], stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=600)
    except (OSError, subprocess.SubprocessError):
        pass


# Os carregadores de mods que entram no jogo por uma DLL ao lado do .exe, no
# lugar de uma do Windows: o Unity Doorstop (BepInEx, MelonLoader) e o Ultimate
# ASI Loader. No Wine a DLL do proprio Wine vem antes da pasta do jogo, e o mod
# nao carregava: o ArcadeMod do The House of the Dead Remake (BepInEx, pela
# winhttp.dll), que faz a mira seguir a pistola de luz, nunca abria (visto no
# gabinete de um usuario em 2026-11-28; com winhttp=n,b ele abriu e a mira foi
# para onde a pistola apontava). A DLL vai como n,b: a da pasta, e sem ela a do Wine.
MOD_LOADER_DLLS = ("winhttp", "version", "winmm", "dinput8", "dsound")


def mod_loader_dlls(folder):
    """As DLLs de carregador de mods da pasta do .exe (MOD_LOADER_DLLS, sem o
    .dll), so quando um carregador esta la: o doorstop_config.ini ou o
    .doorstop_version do Doorstop, a pasta MelonLoader, ou um .asi na pasta ou
    em scripts/ ou plugins/. Sem nada disso, uma DLL do jogo fica com o Wine."""
    def names(path):
        try:
            return {name.lower(): name for name in os.listdir(path)}
        except OSError:
            return {}
    here = names(folder)
    loader = "doorstop_config.ini" in here or ".doorstop_version" in here or \
        ("melonloader" in here and os.path.isdir(os.path.join(folder, here["melonloader"])))
    if not loader:
        loader = any(name.endswith(".asi") for name in here) or any(
            any(name.endswith(".asi") for name in names(os.path.join(folder, here[sub])))
            for sub in ("scripts", "plugins") if sub in here)
    return [dll for dll in MOD_LOADER_DLLS if dll + ".dll" in here] if loader else []


def dll_overrides(current, dlls):
    """O WINEDLLOVERRIDES (current, "a,b=n;c=d") com cada DLL de dlls em n,b; uma
    que ja esta nele fica como a pessoa pos."""
    entries = [entry.strip() for entry in (current or "").split(";") if entry.strip()]
    have = {name.strip().lower() for entry in entries for name in entry.split("=", 1)[0].split(",")}
    add = [dll for dll in dlls if dll not in have]
    return ";".join(entries + [",".join(add) + "=n,b"]) if add else (current or "")


def portproton_mod_loaders(argv, exe, dlls):
    """No PortProton, as DLLs de carregador de mods no WINEDLLOVERRIDES do .ppdb
    do .exe: o start.sh do PortProton apaga o WINEDLLOVERRIDES de fora e so le o
    do .ppdb. So grava (um start do PortProton) quando muda."""
    if not dlls or not argv or os.path.basename(argv[0]) != "fliperos-portproton":
        return
    now = ppdb_value(exe, "WINEDLLOVERRIDES")
    value = dll_overrides(now, dlls)
    if value == now:
        return
    print("fliperos-customgame: %s: WINEDLLOVERRIDES=%s (mod loader)" % (os.path.basename(exe), value), file=sys.stderr)
    try:
        subprocess.run([argv[0], "edit-db", exe, "WINEDLLOVERRIDES=" + value], stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=600)
    except (OSError, subprocess.SubprocessError):
        pass


# O Wine e o 16:9 crop. O fliperos-x11-client poe um monitor de 1280x720 (xrandr
# --setmonitor) no lugar do que o tubo mostra, e o Xinerama o diz a quem
# pergunta; o Wine pergunta ao RandR, que diz 960x720 (o que o tubo mostra), e o
# jogo abria numa tela 4:3, com barras. Com UseXRandR=N o Wine usa o Xinerama:
# 1280x720 (medido no gabinete, 2026-11-26). Vale para o prefixo todo (um jogo
# que abre outro .exe, um launcher, ve o mesmo) e so enquanto o jogo roda com o
# crop: FLIPEROS_CROP169 desligado tira o que esta linha pos (a marca
# FliperosCrop169 diz que foi daqui; um UseXRandR que a pessoa pos fica).
# Sem o XRandR o Wine passa a trocar o modo pelo XVidMode, e o do PortProton
# (Proton LG 10-28) aborta logo ao abrir (xf86vm_free_modes: Assertion
# 'modes[0].dmDriverExtra == ...' failed): o X do jogo fechava antes da
# primeira imagem (visto no gabinete com o Darkula, 2026-11-26). UseXVidMode=N
# tambem: sem nenhum dos dois, o Wine diz o tamanho da tela do X (1280x720).
WINE_X11_SECTION = "[Software\\\\Wine\\\\X11 Driver]"
WINE_CROP_MARK = '"FliperosCrop169"="1"'
# Na ordem em que o Wine grava (os valores vao em ordem de nome).
WINE_CROP_VALUES = (WINE_CROP_MARK, '"UseXRandR"="N"', '"UseXVidMode"="N"')
WINE_CROP_NAMES = ('"usexrandr"=', '"usexvidmode"=')


def reg_crop_xrandr(text, crop, now=None):
    """O texto do user.reg com (crop) ou sem as duas linhas do 16:9 crop na
    secao X11 Driver. O que nao e dessa secao fica como esta."""
    lines = text.split("\n")
    start = next((i for i, line in enumerate(lines) if line.lower().startswith(WINE_X11_SECTION.lower())), None)
    end = len(lines)
    if start is not None:
        end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("[")), len(lines))
    if crop:
        if start is None:
            now = int(time.time() if now is None else now)
            block = [WINE_X11_SECTION + " %d" % now, "#time=%x" % ((now + 11644473600) * 10000000),
                     *WINE_CROP_VALUES]
            # Uma linha em branco depois de cada secao, a ultima tambem (como o Wine grava).
            return text.rstrip("\n") + "\n\n" + "\n".join(block) + "\n\n"
        body = lines[start + 1:end]
        if all(value in body for value in WINE_CROP_VALUES):
            return text
        # A "UseXRandR" e a "UseXVidMode" que a pessoa pos tambem sao trocadas
        # (o crop precisa do N). Um prefixo do crop de antes (so UseXRandR) ganha a que falta.
        body = [line for line in body if not line.lower().startswith(WINE_CROP_NAMES) and line != WINE_CROP_MARK]
        meta = 0
        while meta < len(body) and body[meta].startswith("#"):
            meta += 1
        body[meta:meta] = list(WINE_CROP_VALUES)
        return "\n".join(lines[:start + 1] + body + lines[end:])
    if start is None:
        return text
    body = lines[start + 1:end]
    if WINE_CROP_MARK not in body:
        return text
    body = [line for line in body if line not in WINE_CROP_VALUES]
    if any(line.startswith(('"', "@")) for line in body):
        return "\n".join(lines[:start + 1] + body + lines[end:])
    # Sem mais nada na secao: ela sai inteira (com a linha em branco no fim dela).
    # Sendo a ultima, o fim do arquivo (a quebra de linha) fica.
    last = [""] if end == len(lines) and lines[-1] == "" else []
    return "\n".join(lines[:start] + last + lines[end:])


def wine_prefix(argv, exe):
    """O prefixo do Wine que abre o .exe: o do PortProton e o PW_PREFIX_NAME do
    .ppdb do .exe (ou DEFAULT); o Wine do sistema e o Staging, o WINEPREFIX ou
    o ~/.wine do jogador."""
    home = player_home()
    if argv and os.path.basename(argv[0]) == "fliperos-portproton":
        name = ppdb_value(exe, "PW_PREFIX_NAME")
        if not re.match(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$", name):
            name = "DEFAULT"
        return os.path.join(ENV("FLIPEROS_PORTPROTON_HOME") or home, "PortProton", "data", "prefixes", name)
    return ENV("WINEPREFIX") or os.path.join(home, ".wine")


def wine_crop_registry(argv, exe):
    """Antes de abrir um .exe: liga o UseXRandR=N do prefixo dele se o jogo roda
    com o 16:9 crop, e tira se nao. So escreve (o user.reg, de uma vez) quando
    muda; sem o user.reg (o prefixo ainda nao foi feito) nao faz nada: o jogo
    abre como antes e o crop vale da proxima vez. True se gravou."""
    path = os.path.join(wine_prefix(argv, exe), "user.reg")
    try:
        with open(path, encoding="utf-8", errors="surrogateescape", newline="") as f:
            text = f.read()
        if "\r\n" in text:
            return False
        new = reg_crop_xrandr(text, ENV("FLIPEROS_CROP169") == "1")
        if new == text:
            return False
        tmp = path + ".fliperos-tmp"
        with open(tmp, "w", encoding="utf-8", errors="surrogateescape", newline="") as f:
            f.write(new)
        shutil.copymode(path, tmp)
        os.replace(tmp, path)
    except OSError:
        return False
    return True


def windows_command(exe, runner=""):
    """O .exe pelo runner do jogo (runner= no cfg; sem ele, o PortProton, que o
    Setup instala na hora do primeiro jogo do Windows). Sem o escolhido, o
    primeiro instalado dos outros, com o aviso no log."""
    runner = runner if runner in RUNNERS else DEFAULT_RUNNER
    for name in (runner,) + tuple(r for r in RUNNERS if r != runner):
        argv = runner_command(name, exe)
        if argv:
            if name != runner:
                print("fliperos-customgame: %s is not installed, opening %s with %s" % (runner, exe, name),
                      file=sys.stderr)
            return argv
    return None


# O que sobra do jogo. O frontend fecha o jogo com SIGTERM em toda a arvore
# e SIGKILL 4 s depois nos que ainda estao abaixo dele; um processo que sai
# da arvore antes disso (o pai morreu: vai para o init) escapa dos dois. O
# PortProton deixava um pv-adverb e um winedevice.exe a cada jogo fechado
# (o srt-bwrap morria com o SIGTERM, o pv-adverb esperava o winedevice, que
# nunca saia: visto num gabinete em 2026-11-17). Como subreaper, o executor
# adota esses orfaos (eles seguem na arvore do frontend) e, quando o jogo
# acaba, fecha o que restou: SIGTERM, LEFTOVER_GRACE s, SIGKILL.
PR_SET_CHILD_SUBREAPER = 36
LEFTOVER_GRACE = 3.0
LEFTOVER_KILL_WAIT = 2.0


def become_subreaper():
    """Os orfaos dos processos do jogo passam a ser filhos deste."""
    try:
        import ctypes
        libc = ctypes.CDLL(None, use_errno=True)
        return libc.prctl(PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) == 0
    except (OSError, AttributeError):
        return False


def descendants(pid, proc="/proc"):
    """Os PIDs abaixo de pid (filhos, netos...), pelo PPID do /proc/N/stat."""
    children = {}
    try:
        entries = os.listdir(proc)
    except OSError:
        return []
    for entry in entries:
        if not entry.isdigit():
            continue
        try:
            with open(os.path.join(proc, entry, "stat"), encoding="ascii", errors="replace") as f:
                # O nome vem entre parenteses e pode ter espacos: o resto
                # comeca depois do ultimo ")" (estado, PPID...).
                ppid = int(f.read().rpartition(")")[2].split()[1])
        except (OSError, IndexError, ValueError):
            continue
        children.setdefault(ppid, []).append(int(entry))
    out, todo = [], [pid]
    while todo:
        for child in children.get(todo.pop(), ()):
            out.append(child)
            todo.append(child)
    return out


def reap():
    """Recolhe os filhos (adotados) que ja sairam: zumbis tambem contam como
    descendentes."""
    while True:
        try:
            pid, _ = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            return
        if not pid:
            return


def end_leftovers(grace=LEFTOVER_GRACE, kill_wait=LEFTOVER_KILL_WAIT):
    """O jogo saiu: os processos dele que ainda rodam levam SIGTERM e, os que
    nao saem em grace s, SIGKILL (de novo enquanto aparecerem netos adotados,
    ate kill_wait s). Devolve quantos havia."""
    me = os.getpid()
    reap()
    first = descendants(me)
    for sig, wait in ((signal.SIGTERM, grace), (signal.SIGKILL, kill_wait)):
        deadline = time.monotonic() + wait
        sent = set()
        while True:
            reap()
            left = descendants(me)
            if not left:
                return len(first)
            for pid in left:
                # No SIGKILL, cada um que aparecer (o filho de um morto vem
                # para ca); no SIGTERM, uma vez cada.
                if sig == signal.SIGKILL or pid not in sent:
                    try:
                        os.kill(pid, sig)
                    except OSError:
                        pass
                    sent.add(pid)
            if time.monotonic() >= deadline:
                break
            time.sleep(0.1)
    reap()
    return len(first)


def cmd_run(args):
    path = os.path.abspath(args.cfg)
    try:
        cfg = read_cfg(path)
    except OSError as exc:
        print("fliperos-customgame: %s" % exc, file=sys.stderr)
        return 1
    platform = cfg.get("platform", "")
    folder = cfg.get("folder", "")
    if platform == "command":
        argv, cwd = ["bash", "-c", cfg.get("command", "")], player_home()
    elif platform in PLATFORMS:
        if not os.path.isdir(folder):
            print("fliperos-customgame: the game folder is missing: %s" % folder, file=sys.stderr)
            return 1
        if platform == "native":
            argv, cwd = ["bash", "-c", cfg.get("command", "")], folder
        else:
            exe = os.path.join(folder, *cfg.get("exe", "").split("/"))
            argv, cwd = windows_command(exe, cfg.get("runner", "")), os.path.dirname(exe)
            if not argv:
                print("fliperos-customgame: neither PortProton nor Wine nor Wine Staging is installed", file=sys.stderr)
                return 1
            portproton_renderer(argv, exe)
            wine_crop_registry(argv, exe)
    else:
        print("fliperos-customgame: unknown platform %r in %s" % (platform, path), file=sys.stderr)
        return 1
    env = None
    # Um carregador de mods ao lado do .exe (mod_loader_dlls): no PortProton pelo
    # .ppdb, no Wine e no Staging pelo WINEDLLOVERRIDES (o do x11-client vai junto).
    dlls = mod_loader_dlls(cwd) if platform == "windows" else []
    if dlls and os.path.basename(argv[0]) == "fliperos-portproton":
        portproton_mod_loaders(argv, exe, dlls)
    elif dlls:
        env = dict(os.environ, WINEDLLOVERRIDES=dll_overrides(os.environ.get("WINEDLLOVERRIDES", ""), dlls))
    if has_keymap(path) and ENV("FLIPEROS_CUSTOMGAME_HIDE_PAD") != "off":
        argv = hide_pad_wrapper() + argv
        env = dict(env or os.environ, **HIDE_PAD_ENV)
    keys = mapper(path)
    become_subreaper()
    crop = crop_mark()
    try:
        game = subprocess.Popen(argv, cwd=cwd, env=env)
    except OSError as exc:
        print("fliperos-customgame: %s" % exc, file=sys.stderr)
        if keys:
            keys.terminate()
        crop_unmark(crop)
        return 1

    def stop(sig, _frame):
        try:
            game.send_signal(sig)
        except OSError:
            pass

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, stop)
    rc = game.wait()
    if keys:
        keys.terminate()
        try:
            keys.wait(3)
        except subprocess.TimeoutExpired:
            keys.kill()
    crop_unmark(crop)
    end_leftovers()
    return rc


