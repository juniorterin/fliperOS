[Unit]
Description=FliperOS: web panel (http://fliperos.local, port 8081; Setup > System > Services)
After=network.target

[Service]
# Root: confere a senha no /etc/shadow e le o DRM (config/fliperos-web).
ExecStart=/usr/bin/python3 /opt/fliperos/bin/fliperos-web
# O painel nao pode roubar a CPU de quem esta jogando.
Nice=15
IOSchedulingClass=idle
Restart=on-failure
RestartSec=10
# Nada do painel precisa de tempo para sair: um filho preso (o watch dos
# botoes) nao segura o desligar por 90 s.
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
