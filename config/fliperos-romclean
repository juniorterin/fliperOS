def open_xml(src):
    if src == '-':
        return sys.stdin.buffer
    if src.endswith('.xz'):
        return lzma.open(src)
    return open(src, 'rb')


def control_family(ctrl):
    """A familia de painel de um <control> do XML (None: so botoes)."""
    kind = ctrl.get('type', '').lower()
    old = re.match(r'^v?(double|triple)?joy(\d+)way$', kind)
    if old:
        twin, ways = old.group(1), old.group(2)
    elif kind in ('joy', 'doublejoy', 'triplejoy'):
        twin, ways = kind != 'joy', ctrl.get('ways', '8')
    else:
        return CONTROL_FAMILIES.get(kind) if kind != 'only_buttons' else None
    if twin:
        return 'twin'
    # ways: 1, 2, vertical2, strange2, 4, 3 (half4), 8, 5 (half8), 16.
    first = re.match(r'\d+', ways)
    count = int(first.group()) if first else 2
    return 'joy8' if count in (5, 8, 16) else 'joy4' if count in (3, 4) else 'joy2'


def regions_of(desc):
    found = set()
    for group in re.findall(r'\(([^)]*)\)', desc):
        for part in re.split(r'[,/]', group):
            words = part.strip().lower()
            for key, region in REGION_WORDS.items():
                if re.search(r'\b%s\b' % re.escape(key), words):
                    found.add(region)
    return found


def scan_rate(display):
    """A frequencia horizontal do jogo: '15', '25' ou '31' kHz (None: nao e
    raster ou o XML nao diz). Pelo pixclock/htotal; sem eles, pelas linhas
    visiveis e uns 10% de retraco."""
    if display is None or display.get('type', 'raster') != 'raster':
        return None
    try:
        pixclock, htotal = float(display.get('pixclock') or 0), float(display.get('htotal') or 0)
        if pixclock and htotal:
            hz = pixclock / htotal
        else:
            lines = int(display.get('height') or 0)
            if not lines:
                return None
            hz = lines * 1.1 * float(display.get('refresh') or 60)
    except ValueError:
        return None
    return '15' if hz < 20000 else '25' if hz < 28500 else '31'


def read_machines(stream):
    """Os jogos do XML (<machine> do MAME atual, <game> do 0.139 e antes)."""
    machines = {}
    events = ET.iterparse(stream, events=('start', 'end'))
    _, root = next(events)
    for event, el in events:
        if event != 'end' or el.tag not in ('machine', 'game'):
            continue
        a = el.attrib
        display = el.find('display')
        driver = el.find('driver')
        inp = el.find('input')
        desc = (el.findtext('description') or '').strip()
        buttons, controls = 0, set()
        if inp is not None:
            buttons = int(inp.get('buttons', '0') or 0)
            for ctrl in inp.iter('control'):
                family = control_family(ctrl)
                if family:
                    controls.add(family)
                buttons = max(buttons, int(ctrl.get('buttons', '0') or 0))
        year = (el.findtext('year') or '').strip()
        source = os.path.splitext(os.path.basename(a.get('sourcefile', '')))[0].lower()
        machines[a['name'].lower()] = {
            'description': desc,
            'cloneof': a.get('cloneof', '').lower(),
            'romof': a.get('romof', '').lower(),
            'isbios': a.get('isbios') == 'yes',
            'isdevice': a.get('isdevice') == 'yes' or a.get('runnable') == 'no',
            'ismechanical': a.get('ismechanical') == 'yes',
            'source': source,
            'status': driver.get('status', '') if driver is not None else '',
            'display': display.get('type', 'raster') if display is not None else None,
            'rotate': int(display.get('rotate', '0')) if display is not None else 0,
            'scan': scan_rate(display),
            'disk': el.find('disk') is not None,
            # Os discos com dump: o CHD de cada um e <nome>.chd.
            'disks': [d.get('name') for d in el.iter('disk') if d.get('name') and d.get('status') != 'nodump'],
            'cpus': [c.get('name', '') for c in el.iter('chip') if c.get('type') == 'cpu'],
            'devices': [d.get('name', '').lower() for d in el.iter('device_ref')],
            'coins': int(inp.get('coins', '0') or 0) if inp is not None else 0,
            'players': int(inp.get('players', '0') or 0) if inp is not None else 0,
            'buttons': buttons,
            'controls': sorted(controls),
            'decade': int(year[:3]) * 10 if year[:3].isdigit() else None,
            'regions': sorted(regions_of(desc)),
            'bootleg': bool(BOOTLEG.search(desc)),
            'prototype': bool(PROTOTYPE.search(desc)),
        }
        root.clear()
    return machines


def load_machines(args):
    """Os jogos do XML: do cache, se houver um deste formato, senao do
    arquivo, da entrada padrao ou do comando (e o cache e gravado)."""
    if args.cache and os.path.isfile(args.cache):
        try:
            with open(args.cache, encoding='utf-8') as f:
                data = json.load(f)
            if data.get('format') == CACHE_FORMAT and data.get('machines'):
                return data['machines']
        except (OSError, ValueError):
            pass
    proc = None
    try:
        if args.xml_command:
            proc = subprocess.Popen(shlex.split(args.xml_command), stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL)
            machines = read_machines(proc.stdout)
        elif args.xml:
            machines = read_machines(open_xml(args.xml))
        else:
            sys.exit('no MAME XML: use --xml FILE or --xml-command COMMAND')
    except (ET.ParseError, StopIteration, OSError) as e:
        sys.exit('could not read the MAME XML: %s' % e)
    finally:
        if proc is not None:
            proc.wait()
    if not machines:
        sys.exit('the MAME XML has no games (is the emulator of this romset installed?)')
    if args.cache:
        try:
            os.makedirs(os.path.dirname(os.path.abspath(args.cache)), exist_ok=True)
            tmp = '%s.%d.tmp' % (args.cache, os.getpid())
            with open(tmp, 'w', encoding='utf-8') as f:
                json.dump({'format': CACHE_FORMAT, 'machines': machines}, f, separators=(',', ':'))
            os.chmod(tmp, 0o644)
            os.replace(tmp, args.cache)
        except OSError:
            pass
    return machines


def read_ini(path, section):
    """{set: valor} de uma secao de um .ini do MAME (catver.ini, nplayers.ini)."""
    values, current = {}, None
    with open(path, encoding='utf-8', errors='replace') as f:
        for line in f:
            line = line.strip()
            if line.startswith('['):
                current = line.strip('[]').lower()
            elif current == section and '=' in line and not line.startswith(';'):
                key, value = line.split('=', 1)
                values[key.strip().lower()] = value.strip()
    return values


def file_version(path, pattern):
    """A versao escrita no comeco do arquivo ("catver.ini 0.289")."""
    try:
        with open(path, encoding='utf-8', errors='replace') as f:
            found = re.search(pattern, f.read(8192), re.I)
    except OSError:
        return ''
    return found.group(1) if found else '?'


def read_catver(path):
    """{set: (genero, adulto)}: "Fighter / Versus * Mature *" -> (Fighter, True)."""
    out = {}
    for name, value in read_ini(path, 'category').items():
        genre = MATURE.sub('', value.split(' / ')[0]).strip()
        out[name] = (genre or 'Unknown', bool(MATURE.search(value)))
    return out


def play_modes(value):
    """"4P alt / 2P sim" -> {alt, sim}; "1P" -> {single}; "???", "Device",
    "Pinball" e o que nao esta no nplayers.ini -> {unknown}."""
    modes = set()
    for part in (value or '').split('/'):
        found = re.match(r'(\d+)p(?:\s+(alt|sim))?$', part.strip().lower())
        if found:
            modes.add('single' if found.group(1) == '1' else found.group(2) or 'sim')
    return modes or {'unknown'}


def read_controls(path):
    """{set: botoes do jogador 1} do controls.xml (Controls.dat)."""
    out = {}
    for _, el in ET.iterparse(path):
        if el.tag != 'game':
            continue
        for player in el.findall('player'):
            if player.get('number') == '1' and (player.get('numButtons') or '').isdigit():
                out[(el.get('romname') or '').lower()] = int(player.get('numButtons'))
        el.clear()
    return out


def annotate(machines, catver, nplayers, buttons):
    """O que depende da cadeia de romof e dos arquivos de dados: a placa, o
    sistema do Flycast, o genero, o modo de jogo e os botoes do Controls.dat
    (o clone sem dado proprio fica com o do pai)."""
    for name, m in machines.items():
        m['controls'] = set(m['controls'])
        m['regions'] = set(m['regions'])
        roots, parent = [], m['romof']
        while parent and parent not in roots and len(roots) < 8:
            roots.append(parent)
            parent = machines.get(parent, {}).get('romof')
        m['roots'] = roots
        m['system'] = next((FLYCAST_BIOS[n] for n in [name] + roots if n in FLYCAST_BIOS), None)
        m['genre'], m['mature'] = catver.get(name) or catver.get(m['cloneof']) or (None, False)
        m['modes'] = play_modes(nplayers.get(name) or nplayers.get(m['cloneof']))
        if name in buttons or m['cloneof'] in buttons:
            m['buttons'] = buttons.get(name, buttons.get(m['cloneof']))


def sets_in(folder):
    """{nome do set: [(arquivo, tamanho)]}: os .zip/.7z e as pastas (CHD, set
    solto; tamanho None, medido so se preciso). O tamanho vem da propria
    listagem: numa pasta da rede, um stat por arquivo levaria minutos."""
    sets = {}
    with os.scandir(folder) as entries:
        for entry in entries:
            if entry.is_dir(follow_symlinks=False):
                name, size = entry.name, None
            else:
                name, ext = os.path.splitext(entry.name)
                if ext.lower() not in SET_EXTENSIONS:
                    continue
                try:
                    size = entry.stat(follow_symlinks=False).st_size
                except OSError:
                    size = 0
            sets.setdefault(name.lower(), []).append((entry.name, size))
    return sets


def size_of(path):
    if os.path.isdir(path) and not os.path.islink(path):
        return sum(size_of(os.path.join(path, f)) for f in os.listdir(path))
    return os.lstat(path).st_size


def csv(value):
    return [v.strip() for v in (value or '').split(',') if v.strip()]


def passes(m, f):
    """O jogo passa nos filtros f (o dicionario do argparse)?"""
    if f.arcade_only and (m['coins'] == 0 or m['isbios'] or m['isdevice'] or m['ismechanical']):
        return False
    allowed = {'working': ('good', ''), 'imperfect': ('good', 'imperfect', '')}.get(f.status)
    if allowed and m['status'] not in allowed:
        return False
    if f.orientation == 'horizontal' and m['rotate'] in (90, 270):
        return False
    if f.orientation == 'vertical' and m['rotate'] not in (90, 270):
        return False
    if f.max_players and m['players'] > f.max_players:
        return False
    if f.max_buttons and m['buttons'] > f.max_buttons:
        return False
    if f.controls is not None and not m['controls'] <= f.controls:
        return False
    if f.categories is not None and m['genre'] is not None and m['genre'] not in f.categories:
        return False
    if f.no_mature and m['mature']:
        return False
    if f.play_modes is not None and not m['modes'] & f.play_modes:
        return False
    if f.scan_rates is not None and m['scan'] is not None and m['scan'] not in f.scan_rates:
        return False
    if f.clones == 'none' and m['cloneof']:
        return False
    if (f.no_bootlegs and m['bootleg']) or (f.no_prototypes and m['prototype']):
        return False
    if f.years:
        first, last = (int(y) for y in f.years.split('-'))
        if m['decade'] is None or not first // 10 * 10 <= m['decade'] <= last:
            return False
    if f.decades is not None and m['decade'] not in f.decades:
        return False
    if f.systems is not None and m['system'] not in f.systems:
        return False
    if f.hardware and not any(RULES[h](m) for h in f.hardware):
        return False
    return all(RULES[r](m) for r in f.only) and not any(RULES[r](m) for r in f.exclude)


def root_of(machines, name):
    for _ in range(8):
        parent = machines.get(name, {}).get('cloneof')
        if not parent:
            break
        name = parent
    return name


def best_of_each_game(machines, names, regions):
    """1g1r: de cada familia (pai e clones), a versao da regiao preferida;
    no empate, a que nao e bootleg e depois o pai."""
    order = {r: i for i, r in enumerate(regions)}
    unknown = order.get('Unknown', len(order))
    families = {}
    for n in names:
        families.setdefault(root_of(machines, n), []).append(n)

    def score(n):
        m = machines[n]
        rank = min((order.get(r, unknown) for r in m['regions']), default=unknown)
        return (rank, m['bootleg'], bool(m['cloneof']), n)
    return {min(members, key=score) for members in families.values()}


def plan(machines, present, f, kept=()):
    """(vao, so como dependencia, sobram na origem, do Flycast que ficam)
    entre os sets da pasta. kept: os sets que ja estao no destino (outra
    pasta); o que eles usam tambem vai, nunca sobra para apagar."""
    games = {n for n, m in machines.items() if not m['isbios'] and not m['isdevice'] and passes(m, f)}
    # Os que existem na pasta, e os clones que, num romset merged, estao no
    # zip do pai que existe.
    games = {n for n in games if n in present or machines[n]['cloneof'] in present}
    if f.clones == '1g1r':
        games = best_of_each_game(machines, games, f.regions.split(','))
    # O pai, a BIOS e os dispositivos dos jogos escolhidos e dos que ja estao
    # no destino (de uma limpeza anterior ou postos a mao): sem eles o jogo
    # nao abre.
    needed, todo = set(), list(games | {n for n in kept if n in machines})
    while todo:
        m = machines.get(todo.pop())
        if m is None:
            continue
        for dep in [m['romof'], m['cloneof']] + ([] if f.no_devices else m['devices']):
            if dep and dep not in needed and dep not in games:
                needed.add(dep)
                todo.append(dep)
    known = {n for n in present if n in machines}
    move = known & (games | needed)
    # Os do Flycast nunca sobram para apagar.
    flycast = {n for n in known if machines[n]['system']}
    return move, move & needed - games, known - move - flycast, flycast - move


def free_bytes(path):
    """O espaco livre onde a pasta fica (ou vai ficar)."""
    path = os.path.abspath(path)
    while not os.path.isdir(path) and path != os.path.dirname(path):
        path = os.path.dirname(path)
    try:
        return shutil.disk_usage(path).free
    except OSError:
        return 0


def cmd_scan(args):
    folder = os.path.abspath(args.roms)
    for rule in args.only + args.exclude + args.hardware:
        if rule not in RULES:
            sys.exit('unknown rule: %s (use %s)' % (rule, ', '.join(RULES)))
    if args.controls is not None:
        families = set()
        for family in args.controls:
            if family not in FAMILIES and family not in CONTROL_ALIASES:
                sys.exit('unknown control: %s (use any or %s)' % (family, ', '.join(FAMILIES)))
            families.update(CONTROL_ALIASES.get(family, (family,)))
        args.controls = families
    routes = {}
    for route in args.route:
        system, _, target = route.partition('=')
        if system not in FLYCAST_SYSTEMS or not target:
            sys.exit('use --route SYSTEM=FOLDER (%s)' % ', '.join(FLYCAST_SYSTEMS))
        routes[system] = os.path.abspath(target)
    dest = os.path.abspath(args.dest)
    bios_dest = os.path.abspath(args.bios_dest) if args.bios_dest else None
    machines = load_machines(args)
    annotate(machines,
             read_catver(args.catver) if args.catver else {},
             read_ini(args.nplayers, 'nplayers') if args.nplayers else {},
             read_controls(args.controls_xml) if args.controls_xml else {})
    try:
        present = sets_in(folder)
    except OSError as e:
        sys.exit('could not read the romset folder: %s' % e)
    kept = set()
    for target in {dest, bios_dest, *routes.values()} - {None}:
        if os.path.isdir(target) and os.path.realpath(target) != os.path.realpath(folder):
            kept.update(sets_in(target))
    move, needed, rest, flycast = plan(machines, present, args, kept)

    def dest_of(name):
        m = machines[name]
        if bios_dest and (m['isbios'] or m['isdevice']):
            return bios_dest
        return routes.get(m['system'], dest)
    sizes = {'move': 0, 'rest': 0}
    with open(args.plan, 'w', encoding='utf-8') as out:
        out.write('# roms\t%s\n# dest\t%s\n' % (folder, dest))
        for kind, names in (('move', move), ('rest', rest)):
            for name in sorted(names):
                for filename, size in sorted(present[name]):
                    if size is None:
                        size = size_of(os.path.join(folder, filename))
                    sizes[kind] += size
                    desc = machines[name]['description'].replace('\t', ' ').replace('\n', ' ')
                    out.write('%s\t%s\t%s\t%d\t%s\t%s\n' % (kind, name, filename, size, desc,
                                                          dest_of(name) if kind == 'move' else ''))
    print('machines=%d' % len(machines))
    print('sets=%d' % len([n for n in present if n in machines]))
    print('move=%d' % len(move))
    print('needed=%d' % len(needed))
    print('move_bytes=%d' % sizes['move'])
    print('rest=%d' % len(rest))
    print('rest_bytes=%d' % sizes['rest'])
    print('unknown=%d' % len([n for n in present if n not in machines]))
    print('flycast=%d' % len(flycast))
    print('free_bytes=%d' % free_bytes(dest))


def cmd_chds(args):
    source = os.path.abspath(args.chds)
    machines = load_machines(args)
    annotate(machines, {}, {}, {})
    try:
        with os.scandir(source) as entries:
            available = {e.name.lower(): e.name for e in entries if e.is_dir()}
    except OSError as e:
        sys.exit('could not read the CHD folder: %s' % e)
    folders = [os.path.abspath(f) for f in args.roms]
    copies, missing, sets, games = {}, [], 0, 0
    for folder in folders:
        try:
            names = {n for n in sets_in(folder) if n in machines}
        except OSError:
            continue
        sets += len(names)
        if args.clones:
            names |= {n for n, m in machines.items() if m['cloneof'] in names}
        for name in sorted(names):
            m = machines[name]
            if not m['disks']:
                continue
            games += 1
            # A pasta do proprio jogo e as dos pais, nessa ordem.
            chain = [n for n in dict.fromkeys([name, m['cloneof']] + m['roots']) if n]
            lost = []
            for disk in m['disks']:
                for owner in chain:
                    folder_name = available.get(owner)
                    if folder_name and os.path.isfile(os.path.join(source, folder_name, disk + '.chd')):
                        copies.setdefault((folder_name, folder), owner)
                        break
                else:
                    lost.append(disk)
            if lost:
                missing.append((name, lost))
    total = 0
    with open(args.plan, 'w', encoding='utf-8') as out:
        out.write('# roms\t%s\n# dest\t%s\n' % (source, folders[0]))
        for (folder_name, folder), owner in sorted(copies.items()):
            size = size_of(os.path.join(source, folder_name))
            total += size
            desc = machines[owner]['description'].replace('\t', ' ').replace('\n', ' ')
            out.write('move\t%s\t%s\t%d\t%s\t%s\n' % (owner, folder_name, size, desc, folder))
        for name, lost in missing:
            desc = machines[name]['description'].replace('\t', ' ').replace('\n', ' ')
            out.write('missing\t%s\t%s\t0\t%s\t\n' % (name, ','.join(d + '.chd' for d in lost), desc))
    print('machines=%d' % len(machines))
    print('sets=%d' % sets)
    print('games=%d' % games)
    print('move=%d' % len(copies))
    print('move_bytes=%d' % total)
    print('missing=%d' % len(missing))
    print('free_bytes=%d' % free_bytes(folders[0]))


def read_plan(path):
    """(origem, destino, {move|rest: [(arquivo, pasta de destino, bytes)]})."""
    header, files = {}, {'move': [], 'rest': []}
    with open(path, encoding='utf-8') as f:
        for line in f:
            line = line.rstrip('\n')
            if line.startswith('# '):
                key, _, value = line[2:].partition('\t')
                header[key] = value
            elif line:
                fields = line.split('\t')
                target = fields[5] if len(fields) > 5 and fields[5] else header.get('dest', '')
                size = int(fields[3]) if len(fields) > 3 and fields[3].isdigit() else 0
                files.setdefault(fields[0], []).append((fields[2], target, size))
    if not header.get('roms') or not header.get('dest'):
        sys.exit('plan without the ROM folder or the destination: %s' % path)
    return header['roms'], header['dest'], files


def chown_like(path, st):
    """O que chegou fica do dono da pasta do emulador (o Setup roda como root)."""
    try:
        os.chown(path, st.st_uid, st.st_gid, follow_symlinks=False)
        if os.path.isdir(path) and not os.path.islink(path):
            for top, dirs, files in os.walk(path):
                for name in dirs + files:
                    os.chown(os.path.join(top, name), st.st_uid, st.st_gid, follow_symlinks=False)
    except OSError:
        pass


class Progress:
    """Os eventos da tela de progresso do Setup (lib/progress.sh), no maximo
    tres por segundo: a tela e redesenhada a cada um."""

    def __init__(self, enabled, total_bytes, total_files):
        self.enabled, self.total, self.files = enabled, max(total_bytes, 1), total_files
        self.done = self.index = 0
        self.last = 0.0
        self.name = ''

    def start(self, name):
        self.index += 1
        self.name = name
        self.emit()

    def add(self, count):
        self.done += count
        self.emit()

    def emit(self, force=False):
        now = time.monotonic()
        if not self.enabled or (not force and now - self.last < 0.33):
            return
        self.last = now
        # 99 no maximo: o 100 e o fim, depois de tudo conferido.
        print('@step %d %d of %d: %s' % (min(99, self.done * 100 // self.total), self.index, self.files,
                                         self.name), flush=True)


def copy_path(src, dst, st, progress):
    """Copia um arquivo ou uma pasta (CHD) para dst. O que ja esta la com o
    mesmo tamanho fica; cada arquivo chega como .part e so entao ganha o
    nome, para uma copia cortada no meio nao passar por inteira. Devolve
    (copiados, ja estavam)."""
    if os.path.isdir(src):
        os.makedirs(dst, exist_ok=True)
        chown_like(dst, st)
        copied = skipped = 0
        for name in sorted(os.listdir(src)):
            c, s = copy_path(os.path.join(src, name), os.path.join(dst, name), st, progress)
            copied, skipped = copied + c, skipped + s
        return copied, skipped
    size = os.path.getsize(src)
    if os.path.isfile(dst) and os.path.getsize(dst) == size:
        progress.add(size)
        return 0, 1
    part = dst + '.part'
    try:
        with open(src, 'rb') as fin, open(part, 'wb') as fout:
            while True:
                chunk = fin.read(1 << 20)
                if not chunk:
                    break
                fout.write(chunk)
                progress.add(len(chunk))
        os.replace(part, dst)
    except BaseException:
        if os.path.exists(part):
            os.remove(part)
        raise
    chown_like(dst, st)
    return 1, 0


def cmd_apply(args):
    folder, _, files = read_plan(args.plan)
    transfer = args.action in ('copy', 'move')
    todo = files['move' if transfer else 'rest']
    progress = Progress(args.progress and transfer, sum(size for _, _, size in todo), len(todo))
    done = skipped = errors = 0
    stats = {}
    for filename, target_dir, _ in todo:
        # So um arquivo da propria pasta, nunca um caminho.
        path = os.path.join(folder, filename)
        if '/' in filename or filename in ('.', '..') or not os.path.lexists(path):
            skipped += 1
            continue
        try:
            if not transfer:
                if os.path.isdir(path) and not os.path.islink(path):
                    shutil.rmtree(path)
                else:
                    os.remove(path)
                done += 1
                continue
            if target_dir not in stats:
                os.makedirs(target_dir, exist_ok=True)
                stats[target_dir] = os.stat(target_dir)
            target = os.path.join(target_dir, filename)
            progress.start(filename)
            if args.action == 'copy':
                copied, _ = copy_path(path, target, stats[target_dir], progress)
                done, skipped = done + bool(copied), skipped + (not copied)
            elif os.path.lexists(target):
                # Ja esta la (ou a origem e a propria pasta do emulador): fica.
                skipped += 1
            else:
                shutil.move(path, target)
                chown_like(target, stats[target_dir])
                done += 1
        except OSError as e:
            errors += 1
            print('fliperos-romclean: %s: %s' % (filename, e), file=sys.stderr)
            # A origem sumiu (a pasta da rede caiu, o pendrive saiu): para.
            if not os.path.isdir(folder):
                break
    lines = ['%s=%d' % ({'copy': 'copied', 'move': 'moved'}.get(args.action, 'deleted'), done),
             'skipped=%d' % skipped, 'errors=%d' % errors]
    if args.result:
        with open(args.result, 'w', encoding='utf-8') as f:
            f.write('\n'.join(lines) + '\n')
    print('\n'.join(lines))
    if progress.enabled:
        if errors:
            print('@fail Copying|%d sets could not be copied (details in the log)' % errors, flush=True)
        else:
            print('@step 100 Done', flush=True)
    sys.exit(1 if errors else 0)


def cmd_options(args):
    """O que os arquivos de dados oferecem a tela: a versao de cada um
    ("# catver<TAB>0.289") e os generos do catver.ini, os de jogo primeiro e
    cada grupo do mais comum ao mais raro
    ("genre<TAB>nome<TAB>quantos<TAB>marcado")."""
    if args.catver:
        counts = {}
        for genre, _ in read_catver(args.catver).values():
            counts[genre] = counts.get(genre, 0) + 1
        print('# catver\t%s' % file_version(args.catver, r'catver\.ini\s+([0-9][0-9.]*)'))
        for genre in sorted(counts, key=lambda g: (g in GENRES_OFF, -counts[g], g)):
            print('genre\t%s\t%d\t%d' % (genre, counts[genre], genre not in GENRES_OFF))
    if args.nplayers:
        print('# nplayers\t%s' % file_version(args.nplayers, r'NPlayers\s+([0-9][0-9.]*)'))
    if args.controls_xml:
        print('# controls\t%s' % file_version(args.controls_xml, r'<version\s+name="([^"]*)"'))


def cmd_fetch_mame2010(args):
    if os.path.exists(args.dest):
        print('ok %s' % args.dest)
        return
    os.makedirs(os.path.dirname(os.path.abspath(args.dest)), exist_ok=True)
    digest = hashlib.sha256()
    tmp = tempfile.NamedTemporaryFile(dir=os.path.dirname(os.path.abspath(args.dest)), delete=False)
    try:
        with urllib.request.urlopen(MAME2010_URL, timeout=120) as resp, lzma.open(tmp, 'wb', preset=9) as out:
            while True:
                chunk = resp.read(1 << 20)
                if not chunk:
                    break
                digest.update(chunk)
                out.write(chunk)
        tmp.close()
        if digest.hexdigest() != MAME2010_SHA256:
            sys.exit('mame2010.xml: hash diferente do fixado')
        os.chmod(tmp.name, 0o644)
        os.replace(tmp.name, args.dest)
    finally:
        if os.path.exists(tmp.name):
            os.remove(tmp.name)
    print('ok %s' % args.dest)


def data_arguments(p):
    p.add_argument('--catver')
    p.add_argument('--nplayers')
    p.add_argument('--controls-xml', '--controls-file', dest='controls_xml')


def main():
    parser = argparse.ArgumentParser(prog='fliperos-romclean')
    sub = parser.add_subparsers(dest='command', required=True)

    def choices_of(allowed, name):
        def parse(value):
            values = csv(value)
            for v in values:
                if v not in allowed:
                    parser.error('%s: %s (use %s)' % (name, v, ', '.join(allowed)))
            return set(values)
        return parse

    p = sub.add_parser('scan')
    p.add_argument('--xml')
    p.add_argument('--xml-command')
    p.add_argument('--cache')
    p.add_argument('--roms', required=True)
    p.add_argument('--dest', required=True)
    p.add_argument('--bios-dest')
    p.add_argument('--route', action='append', default=[])
    p.add_argument('--no-devices', action='store_true')
    p.add_argument('--plan', required=True)
    data_arguments(p)
    p.add_argument('--arcade-only', action='store_true')
    p.add_argument('--status', choices=('working', 'imperfect', 'all'), default='all')
    p.add_argument('--orientation', choices=('any', 'horizontal', 'vertical'), default='any')
    p.add_argument('--max-players', type=int, default=0)
    p.add_argument('--max-buttons', type=int, default=0)
    p.add_argument('--controls', type=lambda v: None if v == 'any' else csv(v))
    p.add_argument('--categories', type=lambda v: set(csv(v)))
    p.add_argument('--no-mature', action='store_true')
    p.add_argument('--play-modes', type=choices_of(PLAY_MODES, '--play-modes'))
    p.add_argument('--scan-rates', type=choices_of(SCAN_RATES, '--scan-rates'))
    p.add_argument('--clones', choices=('keep', 'none', '1g1r'), default='keep')
    p.add_argument('--regions', default=','.join(REGION_ORDER))
    p.add_argument('--no-bootlegs', action='store_true')
    p.add_argument('--no-prototypes', action='store_true')
    p.add_argument('--years', type=lambda v: v if re.fullmatch(r'\d{4}-\d{4}', v) else
                   parser.error('use --years 1980-1999'))
    p.add_argument('--decades', type=lambda v: {int(d) for d in csv(v)})
    p.add_argument('--systems', type=choices_of(FLYCAST_SYSTEMS, '--systems'))
    p.add_argument('--hardware', type=csv, default=[])
    p.add_argument('--only', action='append', default=[])
    p.add_argument('--exclude', action='append', default=[])
    p.set_defaults(func=cmd_scan)
    p = sub.add_parser('chds')
    p.add_argument('--xml')
    p.add_argument('--xml-command')
    p.add_argument('--cache')
    p.add_argument('--chds', required=True)
    p.add_argument('--roms', action='append', required=True)
    p.add_argument('--plan', required=True)
    p.add_argument('--clones', action='store_true')
    p.set_defaults(func=cmd_chds)
    p = sub.add_parser('apply')
    p.add_argument('plan')
    p.add_argument('action', choices=('copy', 'move', 'delete-rest'))
    p.add_argument('--progress', action='store_true')
    p.add_argument('--result')
    p.set_defaults(func=cmd_apply)
    p = sub.add_parser('options')
    data_arguments(p)
    p.set_defaults(func=cmd_options)
    p = sub.add_parser('fetch-mame2010')
    p.add_argument('dest')
    p.set_defaults(func=cmd_fetch_mame2010)
    args = parser.parse_args()
    args.func(args)


if __name__ == '__main__':
    main()
