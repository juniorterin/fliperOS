# Teclas de volume do teclado (ou de um encoder de painel programado para
# manda-las) em qualquer tela: emulador em KMS, X ou console. O triggerhappy
# le o /dev/input direto; o fliperos-setup --volume ajusta a placa do Setup >
# Audio Setup. Instalado em /etc/triggerhappy/triggers.d/.
#
# EVENTO           VALOR  COMANDO  (1 = apertou, 2 = segurando)
KEY_VOLUMEUP       1      /usr/local/bin/fliperos-setup --volume up
KEY_VOLUMEUP       2      /usr/local/bin/fliperos-setup --volume up
KEY_VOLUMEDOWN     1      /usr/local/bin/fliperos-setup --volume down
KEY_VOLUMEDOWN     2      /usr/local/bin/fliperos-setup --volume down
KEY_MUTE           1      /usr/local/bin/fliperos-setup --volume mute
