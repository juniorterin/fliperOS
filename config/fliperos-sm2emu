#!/usr/bin/env bash
# SM2-Emu (Sega Model 2, Linux nativo). Nao entra compilado na imagem: a
# primeira abertura clona, compila e so entao lista os jogos. O binario fica
# em ~/.local/src/sm2-emu, do usuario.
#
#   fliperos-sm2emu --pick ARQUIVO
#     a lista no Gum; o .zip escolhido vai para ARQUIVO (vazio = cancelou).
set -euo pipefail

src=${FLIPEROS_SM2_SRC:-$HOME/.local/src/sm2-emu}
bin=$src/build/bin/sm2-emu
roms=${FLIPEROS_MODEL2_DIR:-$HOME/roms/model2}
games_xml=$src/build/bin/games.xml
repo=${FLIPEROS_SM2_REPO:-https://github.com/dmanlfc/sm2-emu.git}

# theme: os mesmos indices da paleta Dracula do Setup. O Alacritty do
# desktop ja usa essa paleta, entao aqui so se pintam os papeis do Gum.
theme() {
  export GUM_CHOOSE_CURSOR="> "
  export GUM_CHOOSE_CURSOR_FOREGROUND=5
  export GUM_CHOOSE_HEADER_FOREGROUND=4
  export GUM_CHOOSE_ITEM_FOREGROUND=7
  export GUM_CHOOSE_SELECTED_FOREGROUND=5
  export GUM_CONFIRM_PROMPT_FOREGROUND=7
  export GUM_CONFIRM_PROMPT_BOLD=false
  export GUM_CONFIRM_SELECTED_FOREGROUND=0
  export GUM_CONFIRM_SELECTED_BACKGROUND=5
  export GUM_CONFIRM_UNSELECTED_FOREGROUND=7
  export GUM_CONFIRM_UNSELECTED_BACKGROUND=0
}

pause() {
  printf '\nPress Enter to close.'
  read -r _
}

# deps_missing: o que o build pede e a imagem pode nao ter (o glslc, o
# ninja, os cabecalhos do X e do ALSA para o SDL3 vendido).
deps_missing() {
  local tool
  for tool in git cmake ninja g++ glslc pkg-config; do
    command -v "$tool" > /dev/null || return 0
  done
  [[ -f /usr/include/X11/Xlib.h && -f /usr/include/alsa/asoundlib.h ]] || return 0
  return 1
}

install_deps() {
  local script
  script=$(mktemp)
  cat > "$script" << 'EOF'
#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y --no-install-recommends \
  cmake ninja-build build-essential glslc git ca-certificates pkg-config \
  libgl-dev libegl-dev libpugixml-dev libcurl4-openssl-dev \
  libx11-dev libxext-dev libxrandr-dev libxcursor-dev \
  libxi-dev libxfixes-dev libxss-dev libxrender-dev libxtst-dev \
  libasound2-dev libpulse-dev libudev-dev \
  libwayland-dev libwayland-bin libxkbcommon-dev libdecor-0-dev
EOF
  chmod +x "$script"
  sudo bash "$script"
  local rc=$?
  rm -f "$script"
  return "$rc"
}

# build_tree clona (raso, com os submodulos) ou atualiza, e compila em
# Release. Cada passo que falha volta na hora: chamado num "||", o set -e
# de dentro nao valeria.
build_tree() {
  mkdir -p "${src%/*}" || return 1
  if [[ ! -d $src/.git ]]; then
    rm -rf "$src"
    GIT_TERMINAL_PROMPT=0 git clone --depth 1 --recurse-submodules --shallow-submodules \
      "$repo" "$src" || return 1
  else
    GIT_TERMINAL_PROMPT=0 git -C "$src" pull --ff-only || return 1
    git -C "$src" submodule update --init --recursive --depth 1 || return 1
  fi
  cmake -S "$src" -B "$src/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DSM2_BUILD_TESTS=OFF || return 1
  nice -n 5 cmake --build "$src/build" -j "$(nproc)" || return 1
}

# game_rows: "titulo<TAB>arquivo" dos .zip de ~/roms/model2, pelo nome no
# games.xml (o .zip que ele nao conhece fica pelo nome do arquivo).
game_rows() {
  python3 - "$roms" "$games_xml" << 'PY'
import os
import sys
import xml.etree.ElementTree as ET

folder, games_xml = sys.argv[1:3]
names = {}
try:
    for game in ET.parse(games_xml).getroot().iter('game'):
        title = game.findtext('title', '') or game.get('name') or ''
        version = (game.findtext('version', '') or '').strip()
        names[game.get('name')] = '%s (%s)' % (title, version) if version else title
except (OSError, ET.ParseError):
    pass
try:
    files = [f for f in os.listdir(folder) if f.lower().endswith('.zip')]
except OSError:
    files = []
rows = sorted(
    ((names.get(f[:-4], f[:-4]), os.path.join(folder, f)) for f in files),
    key=lambda r: r[0].lower())
for label, path in rows:
    print('%s\t%s' % (label, path))
PY
}

if [[ ${1:-} != --pick ]]; then
  echo "Usage: fliperos-sm2emu --pick FILE" >&2
  exit 2
fi
dest=${2:?}
: > "$dest"
theme

if [[ ! -x $bin ]]; then
  gum confirm "Clone and build SM2-Emu now? Needs the network and takes a few minutes." || exit 0
  if deps_missing; then
    printf 'Installing build tools. sudo may ask for the password.\n'
    if ! install_deps; then
      printf 'Could not install the build tools.\n'
      pause
      exit 1
    fi
  fi
  printf 'Cloning and building. This takes a few minutes.\n'
  if ! build_tree; then
    printf 'Build failed.\n'
    pause
    exit 1
  fi
fi

while :; do
  rows=$(game_rows)
  if [[ -z $rows ]]; then
    printf 'No Model 2 games in %s.\nCopy the MAME .zip files there.\n' "$roms"
    pause
    exit 0
  fi
  list=$(printf '%s\nUpdate sm2-emu\tUPDATE\n' "$rows")
  choice=$(gum choose --header "SM2-Emu - choose a game (Esc cancels)" \
    --height "$(($(tput lines 2> /dev/null || echo 24) - 2))" \
    --label-delimiter $'\t' <<< "$list") || exit 0
  if [[ $choice == UPDATE ]]; then
    if deps_missing; then
      printf 'Installing build tools. sudo may ask for the password.\n'
      if ! install_deps; then
        printf 'Could not install the build tools.\n'
        pause
        continue
      fi
    fi
    printf 'Updating and building.\n'
    if ! build_tree; then
      printf 'Build failed.\n'
      pause
    fi
    continue
  fi
  [[ -n $choice ]] || exit 0
  printf '%s\n' "$choice" > "$dest"
  exit 0
done
