#!/usr/bin/env bash
# Keisho (Sega Model 2 e Model 3; ate novembro de 2026 se chamava SM2-Emu, e
# o Model 3 era o Supermodel): a lista dos jogos do menu do desktop, e a
# mudanca das pastas do SM2-Emu para as do Keisho. O emulador vem no pacote
# fliperos-keisho (packaging/packages); o mais novo do projeto e o Setup >
# Games > Emulators & Games que compila (config/fliperos-emulators edge).
#
#   fliperos-sm2emu --pick ARQUIVO [model2|model3]
#     a lista no Gum; o .zip escolhido vai para ARQUIVO (vazio = cancelou).
#   fliperos-sm2emu --migrate
#     so leva as pastas do SM2-Emu para as do Keisho (feito tambem pela
#     outra).
set -euo pipefail

bin=${FLIPEROS_KEISHO_BIN:-/usr/local/bin/keisho}
games_xml=${FLIPEROS_KEISHO_GAMES:-/usr/local/share/keisho/games.xml}
# O Keisho que o Model 2 compilava no gabinete, antes do pacote: um gabinete
# que ainda nao recebeu o pacote usa esse.
src=${FLIPEROS_SM2_SRC:-$HOME/.local/src/keisho}
if [[ ! -x $bin && -x $src/build/bin/keisho ]]; then
  bin=$src/build/bin/keisho
  games_xml=$src/build/bin/games.xml
fi
repo=https://github.com/Keisho-Emu/Keisho.git

# migrate: o SM2-Emu virou Keisho (executavel keisho, keisho.ini em
# ~/.config/keisho, dados em ~/.local/share/keisho). Leva o fonte que o
# gabinete compilava, a configuracao e os dados das pastas antigas para as
# novas, uma vez.
migrate() {
  local config=${XDG_CONFIG_HOME:-$HOME/.config} data=${XDG_DATA_HOME:-$HOME/.local/share}
  local old_src=${FLIPEROS_SM2_OLD_SRC:-$HOME/.local/src/sm2-emu}
  if [[ -d $old_src/.git && ! -e $src ]]; then
    mkdir -p "${src%/*}"
    mv "$old_src" "$src"
  fi
  if [[ -d $src/.git ]] && [[ $(git -C "$src" remote get-url origin 2> /dev/null) == *dmanlfc/sm2-emu* ]]; then
    git -C "$src" remote set-url origin "$repo"
  fi
  if [[ -d $config/sm2-emu && ! -e $config/keisho ]]; then
    mv "$config/sm2-emu" "$config/keisho"
    [[ -f $config/keisho/sm2-emu.ini && ! -e $config/keisho/keisho.ini ]] &&
      mv "$config/keisho/sm2-emu.ini" "$config/keisho/keisho.ini"
  fi
  if [[ -d $data/sm2-emu && ! -L $data/sm2-emu && ! -e $data/keisho ]]; then
    mv "$data/sm2-emu" "$data/keisho"
  fi
  return 0
}
migrate

# theme: os mesmos indices da paleta Dracula do Setup. O Alacritty do
# desktop ja usa essa paleta, entao aqui so se pintam os papeis do Gum.
theme() {
  export GUM_CHOOSE_CURSOR="> "
  export GUM_CHOOSE_CURSOR_FOREGROUND=5
  export GUM_CHOOSE_HEADER_FOREGROUND=4
  export GUM_CHOOSE_ITEM_FOREGROUND=7
  export GUM_CHOOSE_SELECTED_FOREGROUND=5
}

pause() {
  printf '\nPress Enter to close.'
  read -r _
}

# game_rows: "titulo<TAB>arquivo" dos .zip da pasta, pelo nome no games.xml
# (o .zip que ele nao conhece fica pelo nome do arquivo). Os zips de
# dispositivo (model1io.zip: a placa de I/O, lida ao lado do jogo) nao sao
# jogos e ficam de fora.
game_rows() {
  python3 - "$roms" "$games_xml" << 'PY'
import os
import sys
import xml.etree.ElementTree as ET

folder, games_xml = sys.argv[1:3]
names, devices = {}, set()
try:
    root = ET.parse(games_xml).getroot()
    for game in root.iter('game'):
        title = game.findtext('title', '') or game.get('name') or ''
        version = (game.findtext('version', '') or '').strip()
        names[game.get('name')] = '%s (%s)' % (title, version) if version else title
    devices = {d.get('name') for d in root.iter('device')} - set(names)
except (OSError, ET.ParseError):
    pass
try:
    files = [f for f in os.listdir(folder) if f.lower().endswith('.zip') and f[:-4] not in devices]
except OSError:
    files = []
rows = sorted(
    ((names.get(f[:-4], f[:-4]), os.path.join(folder, f)) for f in files),
    key=lambda r: r[0].lower())
for label, path in rows:
    print('%s\t%s' % (label, path))
PY
}

case ${1:-} in
  --migrate) exit 0 ;;
  --pick) ;;
  *)
    echo "Usage: fliperos-sm2emu --pick FILE [model2|model3] | --migrate" >&2
    exit 2
    ;;
esac
dest=${2:?}
system=${3:-model2}
case $system in
  model3) roms=${FLIPEROS_MODEL3_DIR:-$HOME/roms/model3} label="Model 3" ;;
  *) roms=${FLIPEROS_MODEL2_DIR:-$HOME/roms/model2} label="Model 2" ;;
esac
: > "$dest"
theme

if [[ ! -x $bin ]]; then
  printf 'Keisho (Model 2 and 3) is not installed.\nInstall it in Setup > Games > Emulators & Games.\n'
  pause
  exit 0
fi

header="$label - choose a game (Esc cancels)"
while :; do
  rows=$(game_rows)
  if [[ -z $rows ]]; then
    printf 'No %s games in %s.\nCopy the MAME .zip files there.\n' "$label" "$roms"
    pause
    exit 0
  fi
  choice=$(gum choose --header "$header" \
    --height "$(($(tput lines 2> /dev/null || echo 24) - 2))" \
    --label-delimiter $'\t' <<< "$rows") || exit 0
  [[ -n $choice ]] || exit 0
  # Um zip incompleto faz o emulador sair na hora, e o desktop volta sem
  # dizer o que faltou. Aqui a falha fica nesta lista. NVRAM descartavel:
  # o teste grava a dele ao sair, por cima da do jogo.
  nv=$(mktemp -d)
  ok=0
  err=$("$bin" --boot-test 1 --log-level error --nvram "$nv" \
    --model2-rom-dir "${FLIPEROS_MODEL2_DIR:-$HOME/roms/model2}" \
    --model3-rom-dir "${FLIPEROS_MODEL3_DIR:-$HOME/roms/model3}" "$choice" 2>&1 > /dev/null) && ok=1
  rm -rf "$nv"
  if ((ok)); then
    printf '%s\n' "$choice" > "$dest"
    exit 0
  fi
  header=$(printf '%s\n' "$err" | sed -n 's/^\[ERROR\] //p')
  header=${header%%$'\n'*}
  [[ -n $header ]] || header="This set could not be loaded."
done
