#!/usr/bin/env python3
"""O botao de desligar do gabinete.

    fliperos-powerkey

Com um jogo aberto, fecha o jogo e a tela volta ao frontend (ou ao desktop,
se o emulador foi aberto pelo menu dele); sem jogo aberto, desliga a
maquina. Roda como root a cada KEY_POWER, pelo triggerhappy
(config/fliperos-power.triggers); o logind deixa o botao em paz
(fliperos-rootfs.sh).

O que e jogo quem diz e a variavel FLIPEROS_POWERKEY dos filhos do
fliperos-session:

    frontend     o filho e um frontend: o jogo sao os processos abaixo dele
    game         o filho e o proprio jogo (emulador aberto pelo desktop)
    games:ARQ    os PIDs dos jogos estao em ARQ, e o jogo e eles e o que
                 esta abaixo deles (o Fightcade, cujos emuladores nao sao
                 filhos dele; o frontend do FliperOS, que tem outros filhos,
                 o video e o scrape, que nao sao jogo). "hold" no ARQ: o
                 jogo esta aberto e o botao nao faz nada (Frontend options >
                 Power button, desligado)

Sem a variavel (o menu do Setup, o desktop, o RetroArch e o GroovyMAME como
launcher) nao ha jogo a fechar: desliga.

O jogo recebe o SIGTERM, para sair gravando o que tem a gravar. Se ele
seguir aberto, o proximo aperto manda o SIGKILL, e sem aperto nenhum ele vai
sozinho depois de KILL_AFTER segundos: no KMS nao ha Xorg para matar junto, e
o GroovyMAME ficava aberto depois do SIGTERM (o MAME 0.289 ignora o SDL_QUIT;
hoje o config/fliperos-sdl-audio.c o troca pelo fechar da janela e ele sai
na hora, gravando a nvram). Quem espera e um processo a parte: os apertos repetidos que o
triggerhappy enfileira chegariam com o jogo ja fechado e desligariam a
maquina. Por uns segundos depois de
um aperto os outros nao contam: um aperto, uma acao (e ha placa que manda o
mesmo aperto por dois dispositivos).
"""
import fcntl
import glob
import os
import shlex
import signal
import subprocess
import time

GRACE = float(os.environ.get('FLIPEROS_POWERKEY_GRACE', '3'))
STATE = os.environ.get('FLIPEROS_POWERKEY_STATE', '/run/fliperos-powerkey')
OFF = shlex.split(os.environ.get('FLIPEROS_POWERKEY_OFF', 'systemctl poweroff'))
KILL_AFTER = float(os.environ.get('FLIPEROS_POWERKEY_KILL_AFTER', '5'))


def alive(pid):
    try:
        with open('/proc/%d/stat' % pid) as f:
            return f.read().rsplit(')', 1)[1].split()[0] != 'Z'
    except (OSError, IndexError):
        return False


def children(pid):
    found = []
    for path in glob.glob('/proc/%d/task/*/children' % pid):
        try:
            with open(path) as f:
                found += [int(child) for child in f.read().split()]
        except (OSError, ValueError):
            pass
    return [child for child in found if alive(child)]


def descendants(pid):
    found = []
    for child in children(pid):
        found += [child] + descendants(child)
    return found


def sessions():
    """Os PIDs dos fliperos-session abertos e do fliperos-tty1: o jogo pedido
    pelo painel web abre direto debaixo dele (com FLIPEROS_POWERKEY=game),
    sem fliperos-session no meio; sem ele aqui, o botao desligava a maquina
    no lugar de fechar o jogo."""
    found = []
    for path in glob.glob('/proc/[0-9]*/cmdline'):
        try:
            with open(path, 'rb') as f:
                argv = f.read().split(b'\0')
        except OSError:
            continue
        if any(os.path.basename(arg) in (b'fliperos-session', b'fliperos-tty1') for arg in argv[:2]):
            found.append(int(path.split('/')[2]))
    return found


def role(pid):
    try:
        with open('/proc/%d/environ' % pid, 'rb') as f:
            for entry in f.read().split(b'\0'):
                if entry.startswith(b'FLIPEROS_POWERKEY='):
                    return entry.split(b'=', 1)[1].decode(errors='replace')
    except OSError:
        pass
    return ''


HOLD = 'hold'


def listed(path):
    """Os PIDs de ARQ que estao vivos, e o que esta abaixo deles; HOLD se o
    arquivo pede que o botao nao faca nada."""
    try:
        with open(path) as f:
            words = f.read().split()
    except OSError:
        return []
    if HOLD in words:
        return HOLD
    found = []
    for pid in (int(word) for word in words if word.isdigit()):
        if alive(pid):
            found += [pid] + descendants(pid)
    return found


def games():
    """Os PIDs do jogo aberto; nenhum, se a tela e a de um frontend; HOLD, se
    o jogo esta aberto e o botao foi desligado para ele."""
    found = []
    for session in sessions():
        for child in children(session):
            what = role(child)
            if what == 'game':
                found.append(child)
            elif what == 'frontend':
                found += descendants(child)
            elif what.startswith('games:'):
                pids = listed(what[len('games:'):])
                if pids == HOLD:
                    return HOLD
                found += pids
    return found


def main():
    with open(STATE, 'a+') as state:
        fcntl.flock(state, fcntl.LOCK_EX)
        state.seek(0)
        last = state.read().split()
        now = time.monotonic()
        try:
            if now - float(last[0]) < GRACE:
                return
        except (IndexError, ValueError):
            pass
        pids = games()
        if pids == HOLD:
            return
        for pid in pids:
            try:
                os.kill(pid, signal.SIGKILL if str(pid) in last[1:] else signal.SIGTERM)
            except OSError:
                pass
        state.seek(0)
        state.truncate()
        state.write(' '.join([repr(now)] + [str(pid) for pid in pids]) + '\n')
        state.flush()
        if not pids:
            subprocess.call(OFF)
            return
    kill_later([(pid, started(pid)) for pid in pids])


def started(pid):
    """O instante em que o processo comecou (campo 22 do stat): um PID
    reaproveitado depois nao e o jogo."""
    try:
        with open('/proc/%d/stat' % pid) as f:
            return f.read().rsplit(')', 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def kill_later(procs):
    """Num processo a parte, depois de KILL_AFTER: SIGKILL no que do jogo
    seguir aberto."""
    if KILL_AFTER <= 0 or not procs or os.fork():
        return
    os.setsid()
    if os.fork():
        os._exit(0)
    # Sem as saidas de quem chamou: o triggerhappy nao fica esperando.
    null = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(null, fd)
    time.sleep(KILL_AFTER)
    for pid, start in procs:
        if start is not None and alive(pid) and started(pid) == start:
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
    os._exit(0)


if __name__ == '__main__':
    main()
