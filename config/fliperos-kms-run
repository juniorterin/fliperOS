#!/usr/bin/env bash
# Abre um emulador ou frontend direto no KMS/DRM, sem Xorg (RetroArch,
# Flycast, os frontends KMS da tabela de sessoes), como o launch_KMS do
# startfe.sh do galauncher. O modo inicial e o do boot (a linha do kernel que
# o fliperos-setup grava); o RetroArch troca de modo sozinho por jogo (CRT
# SwitchRes).
set -euo pipefail
[[ $# -gt 0 ]] || { echo "Usage: fliperos-kms-run program [arguments]" >&2; exit 2; }
[[ -z "${DISPLAY:-}" ]] || { echo "Run on the console (TTY), outside an X session." >&2; exit 2; }
command -v "$1" > /dev/null || [[ -x $1 ]] || { echo "Not installed: $1" >&2; exit 127; }
# 0 se a placa cria um contexto OpenGL 3.2 core no KMS (GBM), o que o driver
# de video "glcore" do RetroArch pede. Quem responde e o Mesa, pelo eglinfo;
# sem o eglinfo, ou sem o EGL abrir, nao da para saber e vale o glcore.
gl_core_ok() {
  local out
  out=$(timeout 5 eglinfo -B -p gbm -a glcore 2> /dev/null) || return 0
  [[ $out == *"EGL client APIs"* ]] || return 0
  [[ $out =~ OpenGL\ core\ profile\ version:\ ([0-9]+)\.([0-9]+) ]] || return 1
  ((BASH_REMATCH[1] > 3 || (BASH_REMATCH[1] == 3 && BASH_REMATCH[2] >= 2)))
}
# O driver do kernel da placa do CRT: a do primeiro conector ligado (vazio se
# nenhum responde).
crt_card_driver() {
  local sysfs=${FLIPEROS_DRM_SYSFS:-/sys/class/drm} status card link
  for status in "$sysfs"/card[0-9]*-*/status; do
    [[ $(cat "$status" 2> /dev/null) == connected ]] || continue
    card=${status%/status}
    card=${card##*/}
    link=$(readlink -f "$sysfs/${card%%-*}/device/driver" 2> /dev/null) || return 0
    printf '%s\n' "${link##*/}"
    return 0
  done
}
# O jogo da linha de comando no marquee do Pixelcade (config/fliperos-pixelcade;
# sem o Pixelcade instalado, nada). Em segundo plano: a abertura nao espera.
pixelcade=${FLIPEROS_PIXELCADE:-/opt/fliperos/bin/fliperos-pixelcade}
[[ -x $pixelcade ]] && { "$pixelcade" launch "$@" < /dev/null > /dev/null 2>&1 & }
# As saidas do jogo para placas e LEDs (config/fliperos-outputs; sem o
# Hook Of The Reaper e o LEDSpicer instalados, nada).
outputs=${FLIPEROS_OUTPUTS:-/opt/fliperos/bin/fliperos-outputs}
[[ -x $outputs ]] && { "$outputs" launch "$@" < /dev/null > /dev/null 2>&1 & }
# A config do FliperOS entra por cima da do usuario (ver o cabecalho de
# config/retroarch.cfg). Fica aqui, e nao em quem chama, porque a sessao de
# boot so passa o nome do binario.
if [[ "$(basename -- "$1")" == retroarch ]]; then
  mkdir -p /opt/fliperos/saves/retroarch 2> /dev/null || true
  appendconfig=${FLIPEROS_RA_CFG:-/etc/fliperos/retroarch/retroarch.cfg}
  # O glcore do retroarch.cfg nao abre em placa que so tem OpenGL 2.x (Radeon
  # X300 a X1950, Intel ate o Core de 1a geracao, GeForce FX/6/7) e o
  # RetroArch fecha com "Cannot open video driver": nela entra o "gl".
  gl=${FLIPEROS_RA_GL:-/etc/fliperos/retroarch/retroarch-gl.cfg}
  if [[ -f $gl ]] && grep -q '^video_driver = "glcore"' "$appendconfig" 2> /dev/null && ! gl_core_ok; then
    appendconfig+="|$gl"
  fi
  # No amdgpu, o Vulkan. So com o RetroArch do patch do khr_display
  # (config/retroarch-patches, a marca vem do build): sem ele o Vulkan nao
  # troca o modo do CRT e todo jogo ficaria no modo do boot. Em outro driver
  # ou outra placa, o glcore; e decidido a cada abertura, nada fica gravado.
  vulkan=${FLIPEROS_RA_VULKAN:-/etc/fliperos/retroarch/retroarch-vulkan.cfg}
  vulkan_crt=${FLIPEROS_RA_VULKAN_CRT:-/usr/local/share/fliperos/retroarch-vulkan-crt}
  if [[ -f $vulkan && -f $vulkan_crt ]] && grep -q '^video_driver = "glcore"' "${appendconfig%%|*}" 2> /dev/null &&
    [[ $(crt_card_driver) == amdgpu ]]; then
    appendconfig+="|$vulkan"
  fi
  # Os botoes de cada jogador do Setup > Joysticks > Button mapping
  # (config/fliperos-buttons), por cima do perfil automatico do controle.
  buttons=${FLIPEROS_RA_BUTTONS:-/etc/fliperos/retroarch/buttons.cfg}
  [[ -f $buttons ]] && appendconfig+="|$buttons"
  # O DOFLinx (Setup > Games > Extras) le o jogo aberto pelo Network Command
  # Interface: o arquivo so existe com ele instalado.
  doflinx=${FLIPEROS_RA_DOFLINX:-/etc/fliperos/retroarch/doflinx.cfg}
  [[ -f $doflinx ]] && appendconfig+="|$doflinx"
  # O placar de uma partida versus no LED do gabinete (config/fliperos-versus)
  # e lido da memoria do jogo pelo mesmo Network Command Interface: so num
  # jogo que tem placar naquele core (os detectores do Fightcade valem no
  # FBNeo), com um painel instalado.
  versus=${FLIPEROS_VERSUS:-/opt/fliperos/bin/fliperos-versus}
  versus_cfg=${FLIPEROS_RA_VERSUS:-/etc/fliperos/retroarch/versus.cfg}
  game=${*: -1}
  game=${game##*/}
  core=""
  for ((i = 2; i < $#; i++)); do
    if [[ ${!i} == -L || ${!i} == --libretro ]]; then next=$((i + 1)) core=${!next}; fi
  done
  # O core da pasta (~/roms/retroarch/<core>) ainda nao instalado: baixado do
  # buildbot antes de abrir (config/fliperos-core). O frontend do FliperOS ja
  # o baixa com a barra; aqui e para os outros frontends.
  fetch_core=${FLIPEROS_CORE_FETCH:-/opt/fliperos/bin/fliperos-core}
  if [[ $core == */*_libretro.so && ! -f $core && -x $fetch_core ]]; then
    core_name=${core##*/}
    FLIPEROS_RA_CORES=${core%/*} "$fetch_core" fetch "${core_name%_libretro.so}" || true
  fi
  # Setup > Joysticks > Buttons layout: nos cores MAME (o botao N do painel e
  # o botao N do jogo, config/retroarch-remaps), os binds do numero de botoes
  # deste jogo, por cima do buttons.cfg. O mame2010 (MAME 0.139) numera os
  # botoes de alguns jogos de outro jeito e tem a tabela dele.
  game_buttons=${FLIPEROS_GAME_BUTTONS:-/var/lib/fliperos/game-buttons.txt}
  [[ ${core##*/} != mame2010_libretro.so || ! -f ${game_buttons%.txt}-mame2010.txt ]] ||
    game_buttons=${game_buttons%.txt}-mame2010.txt
  case ${core##*/} in
    mame_libretro.so | mame2010_libretro.so)
      if [[ -f $buttons && -f $game_buttons ]]; then
        count=$(awk -v g="${game%.*}" '$1 == g { print $2; exit }' "$game_buttons")
        [[ -n $count && -f ${buttons%.cfg}-$count.cfg ]] && appendconfig+="|${buttons%.cfg}-$count.cfg"
      fi
      ;;
  esac
  # O core do FBNeo so abre um set de console (Mega Drive, Master System...)
  # numa pasta com o nome do sistema; solto na pasta dos arcades, como na do
  # Fightcade, fechava em "romset is unknown". O config/fliperos-fbneo acha
  # o sistema do set e devolve um link para ele numa pasta com esse nome.
  fbneo=${FLIPEROS_FBNEO:-/opt/fliperos/bin/fliperos-fbneo}
  if [[ ${core##*/} == fbneo*_libretro.so && -x $fbneo && $# -gt 1 && -f ${*: -1} ]]; then
    rom=$("$fbneo" path "${*: -1}" 2> /dev/null) || rom=""
    [[ -n $rom && -f $rom ]] && set -- "${@:1:$#-1}" "$rom"
  fi
  # Uma pistola de luz num jogo de pistola (MAME 2010, FBNeo, PS1, SNES, Mega
  # Drive, Master System, NES): o driver udev, a pistola como mouse e a
  # pistola do console na porta do jogador, so nesse jogo
  # (config/fliperos-lightgun).
  lightgun=${FLIPEROS_LIGHTGUN:-/opt/fliperos/bin/fliperos-lightgun}
  if [[ -n $core && $# -gt 1 && -x $lightgun ]]; then
    gun_cfg=$("$lightgun" retroarch "$core" "${*: -1}" 2> /dev/null) || gun_cfg=""
    [[ -n $gun_cfg && -f $gun_cfg ]] && appendconfig+="|$gun_cfg"
  fi
  # O linuxraw conta os controles pelo /dev/input/jsN, e a pistola de luz
  # (GunCon 2, que tambem e mouse) tem um jsN; o Button mapping guarda o
  # indice do SDL, que nao a conta. Com a pistola no js0, o jogador 1 caia
  # nela e o controle 1 do painel virava o jogador 2. Aqui o indice de cada
  # jogador (o do buttons.cfg, ou o padrao: jogador N, controle N-1) vira o
  # jsN desse controle; um controle que nao esta ligado, um jsN que nao existe.
  mapfile -t js < <(awk '/^H: Handlers=/ && /[= ]js[0-9]+/ && !/[= ]mouse[0-9]+/ {
    match($0, /[= ]js[0-9]+/); print substr($0, RSTART + 3, RLENGTH - 3) }' \
    "${FLIPEROS_INPUT_DEVICES:-/proc/bus/input/devices}" 2> /dev/null)
  shifted=0
  for i in "${!js[@]}"; do [[ ${js[i]} == "$i" ]] || shifted=1; done
  if ((shifted)); then
    joypads=${XDG_RUNTIME_DIR:-/tmp}/fliperos-retroarch-joypads.cfg
    last=$(printf '%s\n' "${js[@]}" | sort -n | tail -1)
    # Os arquivos da lista que existem; o ultimo vale, como no RetroArch.
    cfgs=()
    IFS='|' read -r -a listed <<< "$appendconfig"
    for f in "${listed[@]}"; do [[ -f $f ]] && cfgs+=("$f"); done
    {
      echo "# fliperos-kms-run: os jogadores nos /dev/input/js dos controles (sem a pistola)."
      for player in 1 2 3 4 5 6 7 8; do
        index=$(awk -v k="input_player${player}_joypad_index" -F' = ' \
          '$1 == k { gsub(/"/, "", $2); v = $2 } END { print v }' "${cfgs[@]}" /dev/null)
        index=${index:-$((player - 1))}
        if ((index < ${#js[@]})); then
          echo "input_player${player}_joypad_index = \"${js[index]}\""
        else
          echo "input_player${player}_joypad_index = \"$((last + 1 + index - ${#js[@]}))\""
        fi
      done
    } > "$joypads" 2> /dev/null && appendconfig+="|$joypads"
  fi
  if [[ -f $versus_cfg && -x $versus && -x $pixelcade ]] && "$pixelcade" panel &&
    "$versus" has retroarch "${game%.*}" "$core"; then
    appendconfig+="|$versus_cfg"
  fi
  # Um --appendconfig de quem chama (o net play do frontend) vai para o fim
  # da lista: o RetroArch so fica com o ultimo, e os daqui se perdiam.
  args=()
  for ((i = 2; i <= $#; i++)); do
    case ${!i} in
      --appendconfig) next=$((i + 1)) && appendconfig+="|${!next}" && i=$next ;;
      --appendconfig=*) appendconfig+="|${!i#--appendconfig=}" ;;
      *) args+=("${!i}") ;;
    esac
  done
  set -- "$1" --appendconfig "$appendconfig" "${args[@]}"
  # As conquistas (RetroAchievements) no marquee: o fliperos-pixelcade as le
  # do log, onde o RetroArch so as escreve com --verbose.
  if [[ -x $pixelcade ]] && "$pixelcade" cheevos; then
    set -- "$1" --verbose "${@:2}"
  fi
fi
# Monitores extras (Setup > Video Setup > Multiple Monitors): no KMS so o
# principal fica ligado. RetroArch, SDL e Qt abrem na primeira saida
# conectada, que pode ser um extra; o X os liga de novo.
if grep -q '^screens=.*,' "${FLIPEROS_CONF:-/etc/fliperos/fliperos.conf}" 2> /dev/null; then
  sudo -n /usr/local/bin/fliperos-setup --outputs main > /dev/null 2>&1 || true
fi
# SDL_VIDEODRIVER vale para quem usa SDL2 (Flycast); o RetroArch foi
# compilado so com KMS. Audio SDL (GroovyMAME, Flycast) direto no ALSA: sem
# servidor de som, tentar PipeWire e PulseAudio antes so atrasa a abertura.
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-kmsdrm}"
export SDL_AUDIODRIVER="${SDL_AUDIODRIVER:-alsa}"
# Qt no console (o Pegasus): eglfs no KMS, sem cursor, como o
# "pegasus-fe -platform eglfs" do GroovyArcade.
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-eglfs}"
export QT_QPA_EGLFS_INTEGRATION="${QT_QPA_EGLFS_INTEGRATION:-eglfs_kms}"
export QT_QPA_EGLFS_HIDECURSOR=1
# Quem roda abaixo daqui (um frontend e os jogos que ele abre) ja tem este
# ambiente: o groovymame (config/fliperos-groovymame) abre direto no KMS, sem
# passar por aqui de novo.
export FLIPEROS_KMS_RUN=1
# O ES-DE num modo de pixel largo (640x240 num tubo 4:3): desenha em 4:3
# (320x240) e estica na horizontal (packaging/patches/emulationstation), como
# o Arcadeflow (fliperos-arcadeflow screen). O fator e quantas vezes a tela e
# mais larga que 4:3, arredondado.
case $(basename -- "$1") in
  es-de | emulationstation)
    if [[ -z ${ESDE_STRETCH_X:-} ]] && IFS=', ' read -r fb_w fb_h _ < "${FLIPEROS_FB_SIZE:-/sys/class/graphics/fb0/virtual_size}" 2> /dev/null &&
      [[ $fb_w =~ ^[1-9][0-9]*$ && $fb_h =~ ^[1-9][0-9]*$ ]] && (((3 * fb_w + 2 * fb_h) / (4 * fb_h) >= 2)); then
      export ESDE_STRETCH_X=$(((3 * fb_w + 2 * fb_h) / (4 * fb_h)))
    fi
    ;;
esac
# Mapeamentos de controle do SDL (fliperos-rootfs.sh).
export SDL_GAMECONTROLLERCONFIG_FILE="${SDL_GAMECONTROLLERCONFIG_FILE:-/var/lib/fliperos/gamecontrollerdb.txt}"
# O filtro de flicker do entrelacado (config/fliperos-deflicker.c, Setup > Video
# Setup > Interlaced hacks): o programa carrega a camada, que so mexe na imagem
# com o modo da tela entrelacado (ou com a saturacao/matiz por software da
# calibracao de cor).
deflicker=${FLIPEROS_DEFLICKER_LIB:-/usr/local/lib/fliperos/libfliperos-deflicker.so}
[[ -f $deflicker ]] && export LD_PRELOAD="$deflicker${LD_PRELOAD:+:$LD_PRELOAD}"
# Um programa em Vulkan: a camada do Vulkan (config/fliperos-vkfps.c) conta
# os quadros para o painel web e faz o filtro de flicker, o que a do OpenGL nao
# alcanca.
export FLIPEROS_VK_FPS=1
# A calibracao de cor na placa antes do programa virar o dono do video (um
# X que fechou devolve a tabela de gama que achou).
color=${FLIPEROS_COLOR:-/usr/local/bin/fliperos-color}
# Sem a calibracao (outro programa dono da tela) o programa abre assim mesmo:
# no fim do "&&", a falha encerrava o script pelo set -e.
[[ -x $color ]] && { "$color" apply > /dev/null 2>&1 || true; }
# A saida do programa vai para /opt/fliperos/logs/<programa>.log, nao para a
# tela; no modo debug (Setup > System > Debug mode) ela aparece. Sem como gravar o
# log, o programa abre assim mesmo.
log="${FLIPEROS_LOGS:-/opt/fliperos/logs}/$(basename -- "$1").log"
# Um frontend que espera o jogo lendo a saida do comando (o ES-DE: popen ate
# o fim do arquivo) veria o pipe fechar ja na troca para o log e retomaria a
# tela com o jogo aberto. Uma copia do pipe fica com o programa ate ele sair.
[[ ! -p /dev/stdout ]] || exec 9>&1
# O mesmo "comando &" do ES-DE da /dev/null como entrada ao programa (o sh
# faz isso com o que roda em segundo plano). O RetroArch le o teclado do
# console pela entrada (linuxraw): sem terminal nela ele fecha em "Cannot
# initialize input driver", e o frontend volta sem abrir o jogo. A entrada
# passa a ser o terminal da sessao, se houver um.
if [[ ! -t 0 ]] && { : < /dev/tty; } 2> /dev/null; then
  exec < /dev/tty
fi
if [[ ! -f ${FLIPEROS_DEBUG_FLAG:-/etc/fliperos/debug} ]] && { : > "$log"; } 2> /dev/null; then
  exec "$@" >> "$log" 2>&1
fi
exec "$@"
