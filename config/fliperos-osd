def ease_out(f):
    """0..1 que desacelera no fim (a barra saindo do circulo)."""
    f = max(0.0, min(1.0, f))
    return 1 - (1 - f) ** 3


def lerp_color(a, b, f):
    f = max(0.0, min(1.0, f))
    return tuple(round(a[i] + (b[i] - a[i]) * f) for i in range(3))


def ring_color(t, behind):
    """A cor do aro a behind graus atras da cabeca do cometa: branco, rosa,
    roxo e o azul do resto do aro."""
    if behind < 15:
        return lerp_color(t.FG, t.PINK, behind / 15)
    if behind < 110:
        return lerp_color(t.PINK, t.PURPLE, (behind - 15) / 95)
    if behind < 230:
        return lerp_color(t.PURPLE, t.COMMENT, (behind - 110) / 120)
    return t.COMMENT


class Painter:
    """A pagina numa imagem de 320x240, com as cores e a letra da interface
    grafica. O pygame so entra na primeira vez que o menu abre."""

    VISIBLE = 7     # as linhas que cabem sem cobrir a imagem que se esta ajustando
    ROW = 11
    # A linha dos botoes (Save e Close): mais alta e afastada das de cima.
    BUTTONS_GAP, BUTTONS_ROW = 5, 17

    def __init__(self):
        if GUI not in sys.path:
            sys.path.insert(0, GUI)
        os.environ.setdefault("SDL_VIDEODRIVER", "dummy")
        import pygame
        import theme
        pygame.font.init()
        self.pg, self.theme = pygame, theme
        self.font = theme.font()

    def text(self, surface, text, color, x, y):
        surface.blit(self.font.render(text, False, color), (x, y))

    # ── O tamanho do quadro do jogo ──
    # A camada estica a imagem de 320x240 no quadro do jogo pegando o pixel mais
    # perto. Num quadro menor (os 224 linhas do arcade, os 256 de largura de um
    # console) ela pularia linhas e colunas, e a letra se desfazia. Entao o
    # desenho e feito no tamanho do quadro (ate 320x240) e espalhado na imagem
    # exatamente nas linhas e colunas que a camada le: todo pixel chega a tela.
    size = None     # (largura, altura) logicos do desenho; None: a tela

    def area(self):
        t = self.theme
        return self.size or (t.WIDTH, t.HEIGHT)

    @staticmethod
    def frame_size(mode):
        """O quadro do jogo (o modo de video), ou a tela inteira sem modo."""
        if not mode:
            return WIDTH, HEIGHT
        return max(1, mode["h"][0]), max(1, mode["v"][0])

    @staticmethod
    def sources(frame, size):
        """Para cada pixel da imagem (size), o do desenho (frame menor que
        size) que a camada vai mostrar: a camada le o pixel
        floor((i + 0.5) * size / frame) da imagem para o pixel i do quadro."""
        out = [None] * size
        for i in range(frame):
            out[min(size - 1, int((i + 0.5) * size / frame))] = i
        for k in range(size):
            if out[k] is None:
                out[k] = min(frame - 1, int(k * frame / size))
        return out

    def fit(self, draw, mode):
        """O desenho (draw(), na tela logica) pronto para a camada: no tamanho
        do quadro do jogo quando ele e menor que a imagem, espalhado nela."""
        pg, t = self.pg, self.theme
        fw, fh = self.frame_size(mode)
        w, h = min(WIDTH, fw), min(HEIGHT, fh)
        if (w, h) == (WIDTH, HEIGHT):
            self.size = None
            return t.upright(draw())
        # Em pe, a tela logica e a deitada girada.
        self.size = (h, w) if t.VERTICAL else (w, h)
        try:
            small = t.upright(draw())
        finally:
            self.size = None
        rows = pg.Surface((w, HEIGHT), pg.SRCALPHA)
        for y, src in enumerate(self.sources(h, HEIGHT)):
            rows.blit(small, (0, y), (0, src, w, 1), special_flags=pg.BLEND_RGBA_ADD)
        out = pg.Surface((WIDTH, HEIGHT), pg.SRCALPHA)
        for x, src in enumerate(self.sources(w, WIDTH)):
            out.blit(rows, (x, 0), (src, 0, 1, HEIGHT), special_flags=pg.BLEND_RGBA_ADD)
        return out

    def row_text(self, surface, label, value, color, value_color, x, top, width):
        """Uma linha do menu: o rotulo a esquerda e o valor a direita. Se nao
        cabem na letra do menu (um quadro estreito), a letra pequena."""
        import tiny
        need = self.font.size(label)[0] + (self.font.size(value)[0] + 8 if value else 0) + 12 + (8 if value == "" else 0)
        if need <= width:
            self.text(surface, label, color, x + 6, top + 2)
            if value:
                image = self.font.render(value, False, value_color)
                surface.blit(image, (x + width - 6 - image.get_width(), top + 2))
            return
        if value:
            right = tiny.fit(value, width // 2 - 8)
            tiny.text(surface, right, value_color, x + width - 6, top + 3, right=True)
            left = tiny.fit(label, width - 18 - tiny.width(right))
        else:
            left = tiny.fit(label, width - 12)
        tiny.text(surface, left, color, x + 6, top + 3)

    def keyboard(self, menu):
        """Controller configuration: o teclado na tela (as teclas com botao
        acesas, o cursor em rosa), embaixo o que a tecla do cursor tem (ou o
        pedido do botao) e os botoes Clear, Save e Back. Cabe em todo
        quadro: as teclas dividem a largura, e a letra e a pequena."""
        pg, t = self.pg, self.theme
        import tiny
        W, H = self.area()
        surface = pg.Surface((W, H), pg.SRCALPHA)
        osk = menu.osk
        rows = menu.osk_rows()
        keys, buttons = rows[:-1], rows[-1]
        safe_x, safe_y = min(t.SAFE_X, W // 20), min(t.SAFE_Y, H // 24)
        width = W - 2 * safe_x
        sub = menu.subtitle()
        head = 18 + (7 if sub else 0)
        info_h, bh = 9, self.BUTTONS_ROW
        key_h = max(7, min(12, (H - 2 * safe_y - head - 6 - info_h - self.BUTTONS_GAP - bh) // len(keys)))
        height = head + len(keys) * key_h + 2 + info_h + self.BUTTONS_GAP + bh + 4
        x, y = (W - width) // 2, H - safe_y - height
        pg.draw.rect(surface, t.BG_DEEP + (232,), (x, y, width, height))
        pg.draw.rect(surface, t.PURPLE + (255,), (x, y, width, height), 1)
        self.text(surface, menu.title(), t.PINK, x + 6, y + 5)
        if sub:
            room = width - 12 - (tiny.width(menu.status) + 8 if menu.status else 0)
            tiny.text(surface, tiny.fit(sub, max(8, room)), t.COMMENT, x + 6, y + 15)
            if menu.status:
                tiny.text(surface, tiny.fit(menu.status, width // 2), t.CYAN, x + width - 6, y + 15, right=True)
        elif menu.status:
            tiny.text(surface, tiny.fit(menu.status, width // 2), t.CYAN, x + width - 6, y + 6, right=True)
        inner = width - 8
        top = y + head
        bound = set(osk["map"].values())
        for r, row in enumerate(keys):
            total = sum(w for _, _, w in row)
            at = 0.0
            for c, (name, label, w) in enumerate(row):
                kx = x + 4 + round(inner * at / total)
                kw = x + 4 + round(inner * (at + w) / total) - kx - 1
                at += w
                cursor = (r, c) == (osk["row"], osk["col"])
                lit = name in bound
                waiting = cursor and menu.capture_request is not None
                fill = t.YELLOW if waiting else t.PURPLE if lit else t.BG_DEEP
                pg.draw.rect(surface, fill + (255,), (kx, top, kw, key_h - 1))
                pg.draw.rect(surface, (t.PINK if cursor else t.LINE) + (255,), (kx, top, kw, key_h - 1), 1)
                color = t.BG_DEEP if waiting else t.FG if lit or cursor else t.COMMENT
                cx, cy = kx + kw // 2, top + (key_h - 1) // 2
                if label in ("UP", "DOWN", "LEFT", "RIGHT"):
                    # As setas desenhadas: a letra nao tem.
                    d = 2
                    points = {"UP": [(cx - d, cy + 1), (cx + d, cy + 1), (cx, cy - d + 1)],
                              "DOWN": [(cx - d, cy - 1), (cx + d, cy - 1), (cx, cy + d - 1)],
                              "LEFT": [(cx + 1, cy - d), (cx + 1, cy + d), (cx - d + 1, cy)],
                              "RIGHT": [(cx - 1, cy - d), (cx - 1, cy + d), (cx + d - 1, cy)]}[label]
                    pg.draw.polygon(surface, color + (255,), points)
                else:
                    text = tiny.fit(label, max(3, kw - 2))
                    tiny.text(surface, text, color, cx - tiny.width(text) // 2, cy - 2)
            top += key_h
        # A tecla do cursor: os botoes dela, ou o pedido do botao.
        top += 2
        current = menu.osk_current() if osk["row"] < len(keys) else ""
        label = next((lab for row in keys for n, lab, _ in row if n == current), current)
        if menu.capture_request is not None:
            line, color = "PRESS A BUTTON FOR %s (%dS)" % (label, CAPTURE_SECONDS), t.YELLOW
        elif current:
            names = [control_name(pc) for pc in menu.osk_bound(current)]
            line, color = "%s: %s" % (label, ", ".join(names) if names else "NOT SET"), t.CYAN if names else t.COMMENT
        else:
            line, color = "%d BUTTONS SET" % len(osk["map"]), t.COMMENT
        tiny.text(surface, tiny.fit(line, width - 12), color, x + 6, top + 1)
        top += info_h + self.BUTTONS_GAP
        # Os botoes Clear, Save e Back, como os da Configuration.
        n = len(buttons)
        gap = max(6, width // 12)
        bw = (width - (n + 1) * gap) // n
        for k, (value, text, _) in enumerate(buttons):
            bx = x + gap + k * (bw + gap)
            on = osk["row"] == len(keys) and osk["col"] == k
            pg.draw.rect(surface, (t.PURPLE if on else t.BG_DEEP) + (255,), (bx, top, bw, bh))
            pg.draw.rect(surface, (t.PINK if on else t.COMMENT) + (255,), (bx, top, bw, bh), 2 if on else 1)
            icon, icon_color = self.BUTTON_ICONS.get(value, ("close", "RED"))
            image = self.font.render(text, False, t.FG if on else t.COMMENT)
            iy = top + (bh - 8) // 2
            if image.get_width() + 12 <= bw - 6:
                ix = bx + (bw - image.get_width() - 12) // 2
                surface.blit(image, (ix + 12, iy))
            else:
                small = tiny.fit(text, bw - 18)
                ix = bx + (bw - tiny.width(small) - 12) // 2
                tiny.text(surface, small, t.FG if on else t.COMMENT, ix + 12, iy + 1)
            self.icon(surface, icon, ix, iy, getattr(t, icon_color) if on else t.COMMENT)
        return surface

    def panel(self, menu):
        pg, t = self.pg, self.theme
        if menu.page["name"] == "keys" and menu.osk is not None:
            return self.keyboard(menu)
        W, H = self.area()
        surface = pg.Surface((W, H), pg.SRCALPHA)
        page = menu.page
        rows = page["rows"]
        if page["name"] == "geometry":
            self.frame(surface)
        # A edge band da GunCon 2 enquanto se ajusta: as faixas da borda.
        current = rows[page["cursor"]] if rows else None
        if current is not None and getattr(current, "key", "") == "gun.edge_pct":
            self.edge_band(surface, current.value)
        sub = menu.subtitle()
        safe_x, safe_y = min(t.SAFE_X, W // 20), min(t.SAFE_Y, H // 24)
        head = 18 + (7 if sub else 0)
        # As linhas que cabem: ate VISIBLE, menos num quadro baixo. Cada linha
        # de botoes e mais alta, e a primeira se afasta das de cima.
        def extra_of(some):
            n = sum(1 for r in some if r.kind == "buttons")
            return self.BUTTONS_GAP + n * (self.BUTTONS_ROW + 2 - self.ROW) if n else 0
        visible = max(1, min(self.VISIBLE, (H - 2 * safe_y - head - 4 - extra_of(rows)) // self.ROW))
        # O cursor sempre a vista.
        if page["cursor"] < page["top"]:
            page["top"] = page["cursor"]
        elif page["cursor"] >= page["top"] + visible:
            page["top"] = page["cursor"] - visible + 1
        shown = rows[page["top"]:page["top"] + visible]
        extra = extra_of(shown)
        width, height = W - 2 * safe_x, head + len(shown) * self.ROW + 4 + extra
        x, y = (W - width) // 2, H - safe_y - height
        pg.draw.rect(surface, t.BG_DEEP + (232,), (x, y, width, height))
        pg.draw.rect(surface, t.PURPLE + (255,), (x, y, width, height), 1)
        import tiny
        main = page["name"] == "main"
        if main:
            # FliperOS, o OS em outra cor; a direita, o perfil escolhido.
            self.text(surface, "Fliper", t.PINK, x + 6, y + 5)
            self.text(surface, "OS", t.PURPLE, x + 6 + self.font.size("Fliper")[0], y + 5)
            title_w = self.font.size("FliperOS")[0]
            label = menu.profile_label(menu.profile)
            image = self.font.render(label, False, t.CYAN)
            if image.get_width() + title_w + 18 <= width:
                surface.blit(image, (x + width - 6 - image.get_width(), y + 5))
            else:
                tiny.text(surface, tiny.fit(label, width - title_w - 18), t.CYAN, x + width - 6, y + 6, right=True)
        else:
            self.text(surface, menu.title(), t.PINK, x + 6, y + 5)
            title_w = self.font.size(menu.title())[0]
        if sub:
            # A resolucao com as frequencias e o FPS, na letra pequena; o aviso
            # (SAVED...) a direita dela.
            room = width - 12 - (tiny.width(menu.status) + 8 if menu.status else 0)
            tiny.text(surface, tiny.fit(sub, max(8, room)), t.COMMENT, x + 6, y + 15)
            if menu.status:
                tiny.text(surface, tiny.fit(menu.status, width // 2), t.CYAN, x + width - 6, y + 15, right=True)
        elif menu.status:
            status = self.font.render(menu.status, False, t.CYAN)
            if status.get_width() + title_w + 18 <= width:
                surface.blit(status, (x + width - 6 - status.get_width(), y + 5))
            else:
                tiny.text(surface, tiny.fit(menu.status, width // 2), t.CYAN, x + width - 6, y + 6, right=True)
        top = y + head - 1
        gapped = False
        for i, row in enumerate(shown):
            chosen = page["top"] + i == page["cursor"]
            if row.kind == "buttons":
                # Os botoes lado a lado, com folga em volta e entre eles; o
                # escolhido aceso quando a linha e a do cursor.
                if not gapped:
                    top += self.BUTTONS_GAP
                    gapped = True
                n = max(1, len(row.options))
                gap = max(6, width // 12)
                bw = (width - (n + 1) * gap) // n
                bh = self.BUTTONS_ROW
                for k, (value, label) in enumerate(row.options):
                    bx = x + gap + k * (bw + gap)
                    on = chosen and row.value == value
                    pg.draw.rect(surface, (t.PURPLE if on else t.BG_DEEP) + (255,), (bx, top, bw, bh))
                    pg.draw.rect(surface, (t.PINK if on else t.COMMENT) + (255,), (bx, top, bw, bh), 2 if on else 1)
                    # O icone na frente (BUTTON_ICONS: o check no Save, o X no
                    # Close...); o rotulo que nao cabe vai na letra pequena.
                    icon, color = self.BUTTON_ICONS.get(value, ("close", "RED"))
                    image = self.font.render(label, False, t.FG if on else t.COMMENT)
                    iy = top + (bh - 8) // 2
                    if image.get_width() + 12 <= bw - 6:
                        ix = bx + (bw - image.get_width() - 12) // 2
                        surface.blit(image, (ix + 12, iy))
                    else:
                        text = tiny.fit(label, bw - 18)
                        ix = bx + (bw - tiny.width(text) - 12) // 2
                        tiny.text(surface, text, t.FG if on else t.COMMENT, ix + 12, iy + 1)
                    self.icon(surface, icon, ix, iy, getattr(t, color) if on else t.COMMENT)
                top += bh + 2
                continue
            if chosen:
                pg.draw.rect(surface, t.LINE + (255,), (x + 2, top, width - 4, self.ROW))
            value = row.text()
            # O icone na frente: a seta para a esquerda no Back; os itens da
            # pagina principal (Emulator menu, Close, Quit) com o deles.
            shift = 0
            icon = getattr(row, "icon", None)
            if icon:
                self.icon(surface, icon[0], x + 6, top + 2, getattr(t, icon[1]))
                shift = 11
            elif row.label == "Back":
                self.icon(surface, "back", x + 6, top + 2, t.PINK if chosen else t.FG)
                shift = 11
            self.row_text(surface, row.label, value, t.PINK if chosen else t.FG, t.CYAN, x + shift, top,
                          width - shift - (10 if row.kind == "page" else 0))
            if row.kind == "page":
                self.text(surface, ">", t.COMMENT, x + width - 14, top + 2)
            fraction = row.fraction()
            if fraction is not None and len(row.label) <= 10 and width > 240:
                bar_x, bar_w = x + 6 + 88, width - 6 - 88 - 6 - 8 * 7
                pg.draw.rect(surface, t.COMMENT + (255,), (bar_x, top + 3, bar_w, 5), 1)
                pg.draw.rect(surface, t.GREEN + (255,), (bar_x + 1, top + 4, round((bar_w - 2) * fraction), 3))
            top += self.ROW
        # Ha mais linhas acima ou abaixo.
        if page["top"] > 0:
            pg.draw.polygon(surface, t.COMMENT + (255,), [(x + width // 2 - 3, y + head - 3), (x + width // 2 + 3, y + head - 3), (x + width // 2, y + head - 6)])
        if page["top"] + visible < len(rows):
            bottom = y + height - 2
            pg.draw.polygon(surface, t.COMMENT + (255,), [(x + width // 2 - 3, bottom - 2), (x + width // 2 + 3, bottom - 2), (x + width // 2, bottom + 1)])
        return surface

    def volume_bar(self, percent, muted):
        """A barra das teclas de volume, no lugar do menu, em RGBA."""
        pg, t = self.pg, self.theme
        W, H = self.area()
        surface = pg.Surface((W, H), pg.SRCALPHA)
        width, height = W - 2 * min(t.SAFE_X, W // 20), 16
        x, y = (W - width) // 2, H - min(t.SAFE_Y, H // 24) - height
        pg.draw.rect(surface, t.BG_DEEP + (232,), (x, y, width, height))
        pg.draw.rect(surface, t.PURPLE + (255,), (x, y, width, height), 1)
        self.text(surface, "Volume", t.PINK, x + 6, y + 4)
        value = self.font.render("Mute" if muted else "%d%%" % percent, False, t.ORANGE if muted else t.CYAN)
        surface.blit(value, (x + width - 6 - value.get_width(), y + 4))
        bar_x, bar_w = x + 6 + 56, width - 6 - 56 - 6 - 8 * 5
        if bar_w > 8:
            pg.draw.rect(surface, t.COMMENT + (255,), (bar_x, y + 5, bar_w, 6), 1)
            fill = t.COMMENT if muted else t.GREEN
            pg.draw.rect(surface, fill + (255,), (bar_x + 1, y + 6, round((bar_w - 2) * percent / 100), 4))
        return surface

    # ── A barra de uma conquista ──
    # Como a do volume (o fundo, a borda roxa, a letra), mais alta: o circulo
    # da esquerda tem a taca e um aro com um cometa que gira. Responde ao
    # quadro do jogo: area() e o quadro ate 320x240 (240x320 em pe); com menos
    # de 200 pixels de largura ou de altura, a barra baixa (16 px, a taca de
    # 8x8 e o titulo na letra pequena). O circulo sai redondo no tubo: a tela
    # logica ocupa o tubo inteiro (4:3, 3:4 em pe), e o pixel dela nem sempre
    # e quadrado (256x224, por exemplo).
    _badge_cache = None

    def achievement_bar(self, title, now):
        """A barra da conquista now segundos depois de aparecer, em RGBA."""
        pg, t = self.pg, self.theme
        import tiny
        W, H = self.area()
        surface = pg.Surface((W, H), pg.SRCALPHA)
        if now >= CHEEVO_SECONDS + CHEEVO_LEAVE:
            return surface
        par = (3 / 4 if t.VERTICAL else 4 / 3) / (W / H)
        small = W < 200 or H < 200
        safe_x, safe_y = min(t.SAFE_X, W // 20), min(t.SAFE_Y, H // 24)
        height = 16 if small else 24
        rx = height / 2 / par
        x0, width = safe_x, W - 2 * safe_x
        y0 = H - safe_y - height
        cx, cy = x0 + rx, y0 + height / 2
        right_full = x0 + width
        if now < CHEEVO_ENTER:
            sweep, grow = ease_out(now / 0.2), ease_out((now - 0.15) / 0.3)
        elif now >= CHEEVO_SECONDS:
            back = (now - CHEEVO_SECONDS) / CHEEVO_LEAVE
            grow, sweep = 1 - ease_out(back / 0.6), 1 - ease_out((back - 0.5) / 0.5)
        else:
            sweep = grow = 1.0
        right = round(cx + (right_full - cx) * grow)
        if right - round(cx) > 2:
            bar = pg.Rect(round(cx), y0, right - round(cx), height)
            pg.draw.rect(surface, t.BG_DEEP + (232,), bar)
            pg.draw.rect(surface, t.PURPLE + (255,), bar, 1)
            tx = round(cx + rx) + (4 if small else 6)
            aw = right_full - 6 - tx
            clip = pg.Rect(tx, y0 + 1, max(0, min(aw, right - 2 - tx)), height - 2)
            surface.set_clip(clip)
            head = next((h for h in ("ACHIEVEMENT UNLOCKED", "ACHIEVEMENT", "UNLOCKED") if tiny.width(h) <= aw),
                        tiny.fit("UNLOCKED", max(0, aw)))
            tiny.text(surface, head, t.PINK, tx, y0 + (2 if small else 4))
            if small:
                image = pg.Surface((tiny.width(title) + 1, 6), pg.SRCALPHA)
                tiny.text(image, title, t.FG, 0, 0)
                ty = y0 + 8
            else:
                image = self.font.render(title, False, t.FG)
                ty = y0 + 12
            travel = image.get_width() - aw
            offset = 0.0
            if travel > 0:
                room = CHEEVO_SECONDS - CHEEVO_ENTER - CHEEVO_HOLD_START - CHEEVO_HOLD_END
                speed = max(CHEEVO_MIN_SPEED, travel / room)
                offset = min(travel, max(0.0, now - CHEEVO_ENTER - CHEEVO_HOLD_START) * speed)
            surface.blit(image, (tx - round(offset), ty))
            # Os 5 s: a linha que se esvazia, verde como a da barra de volume.
            left = max(0.0, CHEEVO_SECONDS - now)
            ly = y0 + height - 3
            surface.fill(t.LINE + (255,), (tx, ly, max(0, aw), 1))
            surface.fill(t.GREEN + (255,), (tx, ly, max(0, round(aw * left / CHEEVO_SECONDS)), 1))
            surface.set_clip(None)
        self.achievement_badge(surface, (cx, cy, rx, height / 2, par, small), now, sweep)
        return surface

    def badge_pixels(self, cx, cy, rx, outer, par, small):
        """Os pixels do circulo: o fundo e os do aro com o angulo de cada um
        (guardados: a geometria so muda com o quadro do jogo)."""
        key = (cx, cy, rx, outer, par, small)
        if self._badge_cache and self._badge_cache[0] == key:
            return self._badge_cache[1]
        inner = outer - (2 if small else 2.5)
        disc, ring = [], []
        for py in range(math.floor(cy - outer), math.ceil(cy + outer)):
            for px in range(math.floor(cx - rx), math.ceil(cx + rx)):
                dx, dy = (px + 0.5 - cx) * par, py + 0.5 - cy
                d = math.hypot(dx, dy)
                if d >= outer:
                    continue
                if d < inner:
                    disc.append((px, py))
                else:
                    ring.append((px, py, math.degrees(math.atan2(dy, dx))))
        self._badge_cache = (key, (disc, ring))
        return disc, ring

    def achievement_badge(self, surface, geometry, now, sweep):
        """O circulo da esquerda: o fundo, o aro (um cometa que gira; na
        entrada ele se desenha, na saida se apaga) e a taca, com um brilho
        branco que passa por ela ao chegar."""
        t = self.theme
        cx, cy, rx, outer, par, small = geometry
        disc, ring = self.badge_pixels(cx, cy, rx, outer, par, small)
        if sweep <= 0:
            return
        for px, py in disc:
            surface.fill(t.BG_DEEP + (240,), (px, py, 1, 1))
        head = (-90 + 360 * now / CHEEVO_RING_PERIOD) % 360
        for px, py, ang in ring:
            if ((ang + 90) % 360) / 360 > sweep:
                continue
            color = t.PINK if sweep < 1 else ring_color(t, (head - ang) % 360)
            surface.fill(color + (255,), (px, py, 1, 1))
        if sweep < 1:
            return
        icon = MINI_TROPHY if small else t.ICONS["achievements"].strip("\n").split("\n")
        n = len(icon)
        glint = (now - CHEEVO_ENTER) * (20 if small else 40) - 4
        ox, oy = round(cx - n / 2), round(cy - n / 2)
        for j, line in enumerate(icon):
            for i, c in enumerate(line):
                if c == ".":
                    continue
                color = t.ICON_COLORS[c]
                if c in "YO" and abs((i + j) / 2 - glint) < 1.2:
                    color = t.FG
                surface.fill(color + (255,), (ox + i, oy + j, 1, 1))

    def frame(self, surface):
        """A moldura e a cruz do meio: para ver os cantos enquanto ajusta."""
        pg, t = self.pg, self.theme
        color = t.FG + (255,)
        w, h = surface.get_size()
        pg.draw.rect(surface, color, (0, 0, w, h), 1)
        pg.draw.rect(surface, t.CYAN + (255,), (t.SAFE_X, t.SAFE_Y, w - 2 * t.SAFE_X, h - 2 * t.SAFE_Y), 1)
        pg.draw.line(surface, color, (w // 2, 0), (w // 2, h - 1))
        pg.draw.line(surface, color, (0, h // 2), (w - 1, h // 2))

    # Os icones de 8x8 das linhas e dos botoes, em pixel como a letra.
    ICONS = {
        "back": ("...#....", "..##....", ".#######", "########", ".#######", "..##....", "...#....", "........"),
        "close": ("##....##", ".##..##.", "..####..", "...##...", "..####..", ".##..##.", "##....##", "........"),
        "save": (".......#", "......##", ".....##.", "#...##..", "##.##...", ".###....", "..#.....", "........"),
        # As tres linhas de um menu (Emulator menu) e o simbolo de ligar (Quit).
        "menu": ("........", "########", "........", "########", "........", "########", "........", "........"),
        "quit": ("...##...", ".#.##.#.", "#..##..#", "#......#", "#......#", ".#....#.", "..####..", "........"),
        # Um controle (Controller configuration): a cruz e dois botoes.
        "pad": ("........", ".######.", "#.#####.", "...#.#.#", "#.#####.", "#.####.#", ".#....#.", "........"),
    }
    # O icone e a cor (do tema) de cada botao.
    BUTTON_ICONS = {"save": ("save", "GREEN"), "close": ("close", "RED"), "back": ("back", "PINK"),
                    "emulator": ("menu", "CYAN"), "quit": ("quit", "ORANGE"), "clear": ("close", "ORANGE")}

    def icon(self, surface, name, x, y, color):
        for j, line in enumerate(self.ICONS[name]):
            for i, c in enumerate(line):
                if c == "#":
                    surface.fill(color, (x + i, y + j, 1, 1))

    def edge_band(self, surface, percent):
        """A edge band da GunCon 2 na tela: perder a luz dentro dessas faixas
        da borda (percent da largura e da altura, de cada lado) conta como
        tiro fora da tela (a recarga). Por baixo do menu."""
        pg, t = self.pg, self.theme
        w, h = surface.get_size()
        bx, by = round(w * percent / 100), round(h * percent / 100)
        if bx <= 0 and by <= 0:
            return
        band = t.ORANGE + (110,)
        for rect in ((0, 0, w, by), (0, h - by, w, by), (0, by, bx, h - 2 * by), (w - bx, by, bx, h - 2 * by)):
            if rect[2] > 0 and rect[3] > 0:
                pg.draw.rect(surface, band, rect)
        # A linha de dentro, onde a tela "de verdade" comeca.
        pg.draw.rect(surface, t.ORANGE + (255,), (bx, by, max(1, w - 2 * bx), max(1, h - 2 * by)), 1)
        import tiny
        tiny.text(surface, "EDGE BAND %d%%" % percent, t.ORANGE, bx + 3, by + 3)

    def rgba(self, menu):
        self.theme.set_orientation(read_conf().get("orientation", ""))
        return self.pg.image.tobytes(self.fit(lambda: self.panel(menu), menu.mode), "RGBA")

    def bar_rgba(self, percent, muted, mode):
        self.theme.set_orientation(read_conf().get("orientation", ""))
        return self.pg.image.tobytes(self.fit(lambda: self.volume_bar(percent, muted), mode), "RGBA")

    def achievement_rgba(self, title, now, mode):
        """Um quadro da animacao (a orientacao e posta uma vez, ao comecar)."""
        return self.pg.image.tobytes(self.fit(lambda: self.achievement_bar(title, now), mode), "RGBA")


class Screen:
    """O arquivo que as camadas leem. Aberto, existe; fechado, nao."""

    def __init__(self, path):
        self.path = path
        # Sempre subindo, mesmo entre aberturas e depois de reiniciar o servico: a
        # camada so copia a imagem quando o numero muda. Par: nao esta gravando.
        self.seq = (int(time.time()) & 0x3FFFFFFF) * 2
        self.fd = None

    def show(self, pixels):
        """Grava a imagem, com seq impar durante a gravacao. Um arquivo novo a cada
        abertura: as camadas reconhecem pelo numero dele."""
        if self.fd is None:
            tmp = self.path + ".tmp"
            self.fd = os.open(tmp, os.O_RDWR | os.O_CREAT | os.O_TRUNC, 0o644)
            os.fchmod(self.fd, 0o644)
            self.seq += 2
            os.pwrite(self.fd, HEADER.pack(MAGIC, self.seq, 1, WIDTH, HEIGHT) + pixels, 0)
            os.rename(tmp, self.path)
            return
        os.pwrite(self.fd, struct.pack("<I", self.seq + 1), 4)
        os.pwrite(self.fd, pixels, HEADER.size)
        self.seq += 2
        os.pwrite(self.fd, struct.pack("<I", self.seq), 4)

    def hide(self):
        if self.fd is None:
            return
        # O aviso primeiro: as camadas param no quadro seguinte.
        os.pwrite(self.fd, struct.pack("<I", 0), 8)
        os.close(self.fd)
        self.fd = None
        try:
            os.unlink(self.path)
        except OSError:
            pass


# ── Os controles ───────────────────────────────────────────────────

class Inputs:
    """Os controles e os teclados: primeiro espera soltarem tudo, depois os toma
    (EVIOCGRAB) e traduz para as teclas do menu."""

    EVIOCGRAB = None

    def __init__(self, padkeys, emit):
        self.pk = padkeys
        self.keys = padkeys.Keys(emit)
        self.devices = {}
        self.grabbed = False
        self.since = time.monotonic()
        Inputs.EVIOCGRAB = padkeys._ioc(1, "E", 0x90, 4)
        self.scan()

    def is_keyboard(self, keys):
        return KEY_ENTER in keys and KEY_ESC in keys and self.pk.BTN_LEFT not in keys

    def scan(self):
        for path in sorted(glob.glob(os.environ.get("FLIPEROS_INPUT_EVENTS", "/dev/input/event*"))):
            if path in self.devices:
                continue
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                continue
            try:
                name = bytearray(256)
                fcntl.ioctl(fd, self.pk.EVIOCGNAME, name)
                name = bytes(name).split(b"\0")[0]
                keys = self.pk.bits(fd, EV_KEY, 0x300)
                pad = self.pk.is_pad(name, keys)
                keyboard = name not in (self.pk.NAME, EMULATOR_KEYS, GAME_KEYS_NAME) and self.is_keyboard(keys)
                if not pad and not keyboard:
                    os.close(fd)
                    continue
                ranges = {}
                for axis in self.pk.bits(fd, EV_ABS, 0x40) & {self.pk.ABS_X, self.pk.ABS_Y}:
                    info = bytearray(24)
                    fcntl.ioctl(fd, self.pk.eviocgabs(axis), info)
                    _value, low, high = struct.unpack("6i", info)[:3]
                    ranges[axis] = (low, high)
                self.devices[path] = {"fd": fd, "mapper": self.pk.Mapper(ranges), "keyboard": keyboard, "pad": pad}
                if self.grabbed:
                    self.grab(self.devices[path])
            except OSError:
                os.close(fd)

    def held(self, device):
        """Tem alguma coisa apertada neste aparelho?"""
        fd, mapper = device["fd"], device["mapper"]
        buf = bytearray(0x300 // 8)
        fcntl.ioctl(fd, self.pk._ioc(2, "E", 0x18, len(buf)), buf)
        if any(buf):
            return True
        for axis in self.pk.bits(fd, EV_ABS, 0x40) & set(self.pk.AXES):
            info = bytearray(24)
            fcntl.ioctl(fd, self.pk.eviocgabs(axis), info)
            if mapper.direction(axis, struct.unpack("6i", info)[0]):
                return True
        return False

    def all_released(self):
        try:
            return not any(self.held(d) for d in self.devices.values())
        except OSError:
            return True

    def grab(self, device):
        try:
            fcntl.ioctl(device["fd"], Inputs.EVIOCGRAB, 1)
        except OSError:
            pass

    def poll_grab(self):
        """Toma os controles quando soltarem o atalho (ou passado o tempo)."""
        if self.grabbed:
            return
        if self.all_released() or time.monotonic() - self.since > RELEASE_WAIT:
            for device in self.devices.values():
                self.grab(device)
            self.grabbed = True

    def fds(self):
        return [d["fd"] for d in self.devices.values()]

    def read(self, ready):
        now = time.monotonic()
        for path, device in list(self.devices.items()):
            if device["fd"] not in ready:
                continue
            try:
                data = os.read(device["fd"], self.pk.EVENT.size * 64)
            except BlockingIOError:
                continue
            except OSError:
                data = b""
            if not data:
                for key, value in device["mapper"].release():
                    self.keys.apply(key, value, now)
                os.close(device["fd"])
                del self.devices[path]
                continue
            if not self.grabbed:
                continue
            for i in range(0, len(data) - self.pk.EVENT.size + 1, self.pk.EVENT.size):
                etype, code, value = self.pk.EVENT.unpack_from(data, i)[2:]
                if device["keyboard"] and etype == EV_KEY and code in KEYBOARD:
                    if value in (0, 1):
                        self.keys.apply(KEYBOARD[code], value, now)
                    continue
                for key, pressed in device["mapper"].event(etype, code, value):
                    # O Page Up/Down e o Espaco dos menus do Setup nao fazem nada aqui.
                    if key in (KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT, KEY_ENTER, KEY_ESC):
                        self.keys.apply(key, pressed, now)

    def close(self):
        for device in self.devices.values():
            try:
                os.close(device["fd"])  # fechar solta o EVIOCGRAB
            except OSError:
                pass
        self.devices.clear()


# ── O servico ──────────────────────────────────────────────────────

class Service:
    def __init__(self):
        self.padkeys = load_padkeys()
        self.worker = Worker()
        self.painter = None
        self.hotkey = None
        self.hotkey_args = None
        self.running = True
        self.bar_until = 0.0
        # As conquistas: as que esperam [(hora, titulo)], a da tela
        # {"title", "born", "start", "last", "mode"} e quando se olhou a pasta.
        self.cheevo_queue = []
        self.cheevo = None
        self.cheevo_polled = 0.0
        # (programa, resolucao) cuja geometria ja foi posta, e quando se olhou.
        self.geometry_seen = None
        self.geometry_polled = 0.0
        # Os perfis: (jogo, resolucao) ja visto, quando se olhou e o que esta posto.
        self.profile_seen = None
        self.profile_polled = 0.0
        self.profile_applied = {}
        # O Emulator menu: a tecla de cada emulador (o fliperos-buttons) e o
        # teclado virtual por onde ela sai, criado aqui, antes de qualquer
        # jogo: o X e o SDL de cada um ja o conhecem.
        self.buttons, self.keys = None, None
        try:
            self.buttons = load_buttons()
            self.keys = self.buttons.KeySender(sorted(set(self.buttons.KEY_CODES.values())))
        except (OSError, ImportError, SyntaxError, AttributeError) as exc:
            print("fliperos-osd: no emulator menu key: %s" % exc, file=sys.stderr)
        os.makedirs(RUN_DIR, exist_ok=True)
        self.screen_file = Screen(os.path.join(RUN_DIR, "screen"))
        self.control = self.open_control()
        try:
            os.unlink(self.screen_file.path)
        except OSError:
            pass

    def open_control(self):
        path = os.path.join(RUN_DIR, "control")
        try:
            os.unlink(path)
        except OSError:
            pass
        os.mkfifo(path, 0o600)
        # O+W: o FIFO nao "fecha" quando quem escreveu sai.
        return os.open(path, os.O_RDWR | os.O_NONBLOCK)

    def read_control(self):
        try:
            data = os.read(self.control, 4096)
        except OSError:
            return []
        return data.decode("ascii", "replace").split()

    # O atalho.
    def allowed(self, screen):
        conf = read_conf()
        if conf.get("osd") == "off" or not screen or os.path.exists(SETUP_FLAG):
            return False
        return not commercial(screen["uid"])

    def hotkey_command(self):
        conf = read_conf()
        combo = conf.get("osd_combo", DEFAULT_COMBO)
        args = [BUTTONS, "hotkey"]
        for key in conf.get("osd_key", DEFAULT_KEYS).split(","):
            if key.strip().isdigit() and int(key):
                args += ["--key", key.strip()]
        if combo:
            args += ["--combo", combo, "--hold", conf.get("osd_hold", str(DEFAULT_HOLD))]
        return args

    def stop_hotkey(self):
        if self.hotkey:
            try:
                self.hotkey.terminate()
                self.hotkey.wait(timeout=2)
            except (OSError, subprocess.SubprocessError):
                self.hotkey.kill()
            self.hotkey = None

    def watch_hotkey(self, screen):
        wanted = self.allowed(screen)
        command = self.hotkey_command() if wanted else None
        if self.hotkey and (not wanted or command != self.hotkey_args or self.hotkey.poll() is not None):
            self.stop_hotkey()
        if wanted and not self.hotkey:
            try:
                self.hotkey = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                               stderr=subprocess.DEVNULL)
                self.hotkey_args = command
            except OSError:
                self.hotkey = None

    def hotkey_fired(self):
        """O fliperos-buttons hotkey imprimiu "exit" (e sai)? Ele imprime
        tambem "ready" ao comecar: isso nao e o atalho, e ele segue (parado a
        cada linha, ele recomecava sem fim e o segurar do atalho nunca
        completava). Sem nada (ele saiu), para, e o laco o abre de novo."""
        try:
            data = os.read(self.hotkey.stdout.fileno(), 256)
        except OSError:
            data = b""
        if b"exit" in data or not data:
            self.stop_hotkey()
        return b"exit" in data

    # A geometria de cada resolucao.
    def apply_saved_geometry(self, screen):
        """O jogo abriu (ou trocou de resolucao) num modo com geometria guardada: ela
        vai para a placa. O emulador so conhece o crt_range de todas as resolucoes,
        e o modo dele sai desse; aqui o ajuste da resolucao entra por cima, uma vez
        por jogo e resolucao."""
        now = time.monotonic()
        if not screen:
            self.geometry_seen = None
            return
        if now - self.geometry_polled < GEOMETRY_POLL:
            return
        self.geometry_polled = now
        conf = read_conf()
        if not any(key.startswith("geometry_") for key in conf):
            return
        mode = current_mode()
        if not mode:
            return
        seen = (screen["pid"], resolution_key(mode))
        if seen == self.geometry_seen:
            return
        self.geometry_seen = seen
        if saved_geometry(conf, seen[1]):
            geometry = Geometry(screen, mode)
            if geometry.valid():
                geometry.apply()

    # Os perfis.
    def apply_profiles(self, screen):
        """Um jogo abriu, trocou de resolucao ou fechou: os ajustes dos perfis
        que valem agora (o default por baixo, o jogo por cima) vao para o
        sistema; so os que mudam."""
        now = time.monotonic()
        if now - self.profile_polled < GEOMETRY_POLL:
            return
        self.profile_polled = now
        profiles = Profiles()
        if not profiles.data:
            return
        mode = current_mode() if screen else None
        seen = (screen["pid"], resolution_key(mode) if mode else "") if screen else None
        if seen == self.profile_seen:
            return
        self.profile_seen = seen
        wanted = profiles.effective(profile_scopes(screen, mode) if screen else {"default": "default"})
        for key, value in sorted(wanted.items()):
            if self.profile_applied.get(key) != value:
                self.worker.put("profile-" + key, lambda key=key, value=value: apply_setting(key, value))
                self.profile_applied[key] = value

    # A barra das teclas de volume.
    def bar_allowed(self, screen):
        """So o volume, sem tomar nada: vale tambem no modo comercial."""
        return bool(screen) and read_conf().get("osd") != "off" and not os.path.exists(SETUP_FLAG)

    def show_bar(self):
        if not self.bar_allowed(on_screen()):
            return
        state = volume_state()
        if not state:
            return
        if self.painter is None:
            self.painter = Painter()
        self.screen_file.show(self.painter.bar_rgba(*state, current_mode()))
        self.bar_until = time.monotonic() + BAR_SECONDS

    def tick_bar(self):
        if self.bar_until and time.monotonic() >= self.bar_until:
            self.bar_until = 0.0
            self.screen_file.hide()

    # A barra das conquistas.
    def collect_achievements(self):
        now = time.monotonic()
        if now - self.cheevo_polled < 0.25:
            return
        self.cheevo_polled = now
        self.cheevo_queue += take_achievements()
        old = time.time() - CHEEVO_STALE
        self.cheevo_queue = [item for item in self.cheevo_queue if item[0] >= old]

    def tick_achievement(self):
        """Um quadro da conquista na tela, ou a proxima da fila. Com a barra do
        volume por cima, a conquista espera (o tempo dela para)."""
        now = time.monotonic()
        if self.cheevo is None:
            if not self.cheevo_queue or self.bar_until or not self.bar_allowed(on_screen()):
                return
            born, title = self.cheevo_queue.pop(0)
            if self.painter is None:
                self.painter = Painter()
            self.painter.theme.set_orientation(read_conf().get("orientation", ""))
            self.cheevo = {"title": title, "born": born, "start": now, "last": now, "mode": current_mode()}
        cheevo = self.cheevo
        if self.bar_until:
            cheevo["start"] += now - cheevo["last"]
            cheevo["last"] = now
            return
        cheevo["last"] = now
        elapsed = now - cheevo["start"]
        if elapsed >= CHEEVO_SECONDS + CHEEVO_LEAVE:
            self.cheevo = None
            self.screen_file.hide()
            return
        self.screen_file.show(self.painter.achievement_rgba(cheevo["title"], elapsed, cheevo["mode"]))

    # O menu.
    def open_menu(self):
        screen = on_screen()
        if not self.allowed(screen):
            return
        self.stop_hotkey()
        self.bar_until = 0.0
        # A conquista na tela volta para a frente da fila: aparece de novo,
        # inteira, depois do menu.
        if self.cheevo is not None:
            self.cheevo_queue.insert(0, (self.cheevo["born"], self.cheevo["title"]))
            self.cheevo = None
        try:
            os.unlink(os.path.join(screen["runtime"], "fliperos-osd-refused"))
        except OSError:
            pass
        if self.painter is None:
            self.painter = Painter()
        gamekeys = self.gamekeys(screen)
        menu = Menu(screen, current_mode(), self.worker, self.emulator_key(screen), gamekeys)
        pressed = []
        inputs = Inputs(self.padkeys, lambda key, value: pressed.append(key) if value else None)
        last = time.monotonic()
        scanned = polled = last
        # O mapa do controle do jogo custom fica calado com o menu aberto.
        if gamekeys:
            self.buttons.gamekeys_call(gamekeys["folder"], "mute")
        try:
            while self.running and not menu.closing:
                now = time.monotonic()
                if menu.capture_request is not None:
                    # Controller configuration: o pedido do botao na tela, os
                    # controles soltos (o gamekeys le pelo SDL, que o EVIOCGRAB
                    # daqui calaria) e, com a resposta, tomados de novo depois
                    # de soltar o botao.
                    self.screen_file.show(self.painter.rgba(menu))
                    inputs.close()
                    answer = self.buttons.gamekeys_call(gamekeys["folder"], "capture %d" % CAPTURE_SECONDS,
                                                        timeout=CAPTURE_SECONDS + 2)
                    menu.capture_done(answer)
                    del pressed[:]
                    inputs = Inputs(self.padkeys, lambda key, value: pressed.append(key) if value else None)
                    last = scanned = time.monotonic()
                    continue
                inputs.poll_grab()
                if now - scanned >= 2:
                    scanned = now
                    inputs.scan()
                # O jogo fechou, ou a camada dele nao consegue desenhar: os
                # controles voltam na hora.
                current = on_screen()
                if not current or current["pid"] != screen["pid"] or refused(screen):
                    menu.close()
                    break
                if now - last > IDLE_CLOSE:
                    menu.close()
                    break
                # A resolucao e o FPS de agora (o jogo trocou de modo, a
                # geometria mudou o modo).
                if now - polled >= LIVE_POLL:
                    polled = now
                    menu.live(current_mode(), current.get("fps"))
                if menu.dirty:
                    menu.dirty = False
                    self.screen_file.show(self.painter.rgba(menu))
                timeout = inputs.keys.timeout(now, 0.1)
                ready = select.select(inputs.fds() + [self.control], [], [], timeout)[0]
                inputs.read(ready)
                if self.control in ready:
                    for word in self.read_control():
                        if word == "close":
                            menu.close()
                        elif word in COMMANDS:
                            pressed.append(COMMANDS[word])
                inputs.keys.tick(time.monotonic())
                for key in pressed:
                    menu.key(key)
                    last = time.monotonic()
                del pressed[:]
        finally:
            menu.leave_geometry()
            self.screen_file.hide()
            inputs.close()
            if gamekeys:
                self.buttons.gamekeys_call(gamekeys["folder"], "unmute")
        # Com os controles de volta ao jogo: o Emulator menu ou o Quit.
        if menu.after == "emulator":
            self.press_emulator_key(menu.emulator_key)
        elif menu.after == "quit":
            self.quit_game(screen)

    def gamekeys(self, screen):
        """O mapa do controle de um jogo custom (custom_GRUPO_NOME, o --app
        dele) rodando: {"folder", "keyfile", "buttons"}, ou None."""
        if not self.buttons or not is_game(screen) or not screen.get("program", "").startswith("custom_"):
            return None
        try:
            folder = self.buttons.gamekeys_run_dir(screen["uid"], RUN_USER)
            keyfile = self.buttons.gamekeys_current(folder)
        except (AttributeError, KeyError, TypeError):
            return None
        return {"folder": folder, "keyfile": keyfile, "buttons": self.buttons} if keyfile else None

    def emulator_key(self, screen):
        """A tecla do menu do emulador na tela (None: um frontend, ou um
        emulador sem menu proprio, ou sem o teclado virtual)."""
        if not self.keys or not self.buttons or not is_game(screen):
            return None
        try:
            home = pwd.getpwuid(screen["uid"]).pw_dir
        except (KeyError, TypeError):
            home = None
        return self.buttons.menu_key(screen["program"], home)

    def press_emulator_key(self, code):
        # O jogo ve os controles soltos antes da tecla.
        time.sleep(0.15)
        try:
            self.keys.press(code)
        except OSError:
            pass

    def quit_game(self, screen):
        """Quit: o SIGTERM no jogo (ele grava o que tem de gravar e o
        frontend volta); se nao sair em QUIT_KILL segundos, o SIGKILL."""
        pid = screen["pid"]

        def started(p):
            try:
                with open("/proc/%d/stat" % p) as f:
                    return f.read().rsplit(")", 1)[1].split()[19]
            except (OSError, IndexError):
                return None
        start = started(pid)
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            return

        def kill():
            end = time.monotonic() + QUIT_KILL
            while time.monotonic() < end:
                if started(pid) != start:
                    return
                time.sleep(0.2)
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        threading.Thread(target=kill, daemon=True).start()

    def loop(self):
        while self.running:
            screen = on_screen()
            self.watch_hotkey(screen)
            self.apply_saved_geometry(screen)
            self.apply_profiles(screen)
            fds = [self.control]
            if self.hotkey:
                fds.append(self.hotkey.stdout.fileno())
            self.collect_achievements()
            timeout = 1.0 / CHEEVO_FPS if self.cheevo else 0.1 if self.bar_until or self.cheevo_queue else 0.5
            ready = select.select(fds, [], [], timeout)[0]
            words = self.read_control() if self.control in ready else []
            if "volume" in words:
                self.show_bar()
            self.tick_bar()
            self.tick_achievement()
            if "open" in words:
                self.open_menu()
            elif self.hotkey and self.hotkey.stdout.fileno() in ready and self.hotkey_fired():
                self.open_menu()

    def stop(self, *_):
        self.running = False


def layer_view(pg, canvas, frame):
    """O que a camada mostra num quadro de frame (largura, altura): o pixel
    floor((i + 0.5) * 320 / largura) da imagem para cada pixel i (os testes)."""
    fw, fh = frame
    out = pg.Surface((fw, fh), pg.SRCALPHA)
    rows = pg.Surface((WIDTH, fh), pg.SRCALPHA)
    for y in range(fh):
        rows.blit(canvas, (0, y), (0, min(HEIGHT - 1, int((y + 0.5) * HEIGHT / fh)), WIDTH, 1),
                  special_flags=pg.BLEND_RGBA_ADD)
    for x in range(fw):
        out.blit(rows, (x, 0), (min(WIDTH - 1, int((x + 0.5) * WIDTH / fw)), 0, 1, fh),
                 special_flags=pg.BLEND_RGBA_ADD)
    return out


def shot(page, path):
    """A imagem de uma pagina, sem jogo e sem controle (os testes do desenho).
    FLIPEROS_OSD_SHOT_FRAME=LARGURAxALTURA: como a camada a mostra num quadro
    desse tamanho (sem: 640x480i)."""
    os.environ.setdefault("SDL_VIDEODRIVER", "dummy")
    painter = Painter()
    pg = painter.pg
    mode = {"clock": 13038, "h": [640, 666, 727, 831], "v": [480, 483, 489, 523], "interlace": True}
    size = re.fullmatch(r"(\d+)x(\d+)", os.environ.get("FLIPEROS_OSD_SHOT_FRAME", ""))
    if size:
        fw, fh = int(size.group(1)), int(size.group(2))
        mode = {"clock": 6700, "h": [fw, fw + 16, fw + 48, fw + 96], "v": [fh, fh + 3, fh + 6, fh + 20],
                "interlace": False}
    menu = Menu({"program": "pcsx2", "core": "", "fps": 59.9}, mode, Worker(), emulator_key=1)
    painter.theme.set_orientation(read_conf().get("orientation", ""))
    if page in ("volume", "mute"):
        canvas = painter.fit(lambda: painter.volume_bar(60, page == "mute"), mode)
    elif page in ("keys", "keys-capture"):
        # Controller configuration de um jogo custom: um .key de exemplo
        # (FLIPEROS_OSD_SHOT_KEYS, ou o de dentro) e, em keys-capture, a
        # tecla esperando o botao.
        import tempfile
        buttons = load_buttons()
        keyfile = os.environ.get("FLIPEROS_OSD_SHOT_KEYS")
        if not keyfile:
            keyfile = os.path.join(tempfile.mkdtemp(prefix="fliperos-osd-shot-"), "Game.key")
            with open(keyfile, "w", encoding="utf-8") as f:
                f.write("p1_up=UP\np1_down=DOWN\np1_left=LEFT\np1_right=RIGHT\np1_b1=Z\np1_b2=X\n"
                        "p1_b3=LEFTCTRL\np2_b3=LEFTCTRL\np1_start=ENTER\np1_coin=5\np1_b4=SPACE\n")
        menu = Menu({"program": "custom_pc_games_pang", "core": "", "fps": 59.9}, mode, Worker(),
                    gamekeys={"folder": "/nonexistent", "keyfile": keyfile, "buttons": buttons})
        menu.open_keys()
        for key in os.environ.get("FLIPEROS_OSD_SHOT_MOVES", "down down right right right").split():
            menu.key({"up": KEY_UP, "down": KEY_DOWN, "left": KEY_LEFT, "right": KEY_RIGHT}[key])
        if page == "keys-capture":
            menu.capture_request = menu.osk_current()
        canvas = painter.fit(lambda: painter.panel(menu), mode)
    elif page == "achievement":
        # FLIPEROS_OSD_SHOT_TIME: os segundos da animacao (sem: 2,6, com o
        # titulo correndo); FLIPEROS_OSD_SHOT_TITLE, o titulo.
        title = os.environ.get("FLIPEROS_OSD_SHOT_TITLE", "Hungry Wolf : Beat Kim Dong Hwan with Rock Howard")
        when = float(os.environ.get("FLIPEROS_OSD_SHOT_TIME", "2.6"))
        canvas = painter.fit(lambda: painter.achievement_bar(title, when), mode)
    else:
        if page != "main":
            menu.open_page(page)
        canvas = painter.fit(lambda: painter.panel(menu), mode)
    frame = Painter.frame_size(mode)
    view = layer_view(pg, canvas, frame)
    backdrop = pg.Surface(frame)
    backdrop.fill((40, 80, 160))
    backdrop.blit(view, (0, 0))
    # Na proporcao de um tubo 4:3, 640x480 no arquivo.
    pg.image.save(pg.transform.scale(backdrop, (WIDTH * 2, HEIGHT * 2)), path)


def main():
    if len(sys.argv) == 4 and sys.argv[1] == "--shot":
        shot(sys.argv[2], sys.argv[3])
        return 0
    service = Service()
    signal.signal(signal.SIGTERM, service.stop)
    signal.signal(signal.SIGINT, service.stop)
    try:
        service.loop()
    except KeyboardInterrupt:
        pass
    finally:
        service.stop_hotkey()
        service.screen_file.hide()
    return 0


if __name__ == "__main__":
    sys.exit(main())
