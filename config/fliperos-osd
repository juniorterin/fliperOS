# ── O fliperos.conf ────────────────────────────────────────────────

def read_conf(path=None):
    values = {}
    try:
        with open(path or CONF, encoding="utf-8", errors="replace") as f:
            for line in f:
                key, sep, value = line.strip().partition("=")
                if sep:
                    values[key] = value
    except OSError:
        pass
    return values


def filter_level(conf, program, core):
    """O nivel que a camada usa: o do core, o do programa, o de todos, medium."""
    for key in ("deflicker_" + core if core else "", "deflicker_" + program if program else "", "deflicker"):
        if key and key in conf:
            value = conf[key].lower()
            return value if value in FILTER_LEVELS else "medium"
    return "medium"


# ── O que esta na tela ─────────────────────────────────────────────

def guncon_present():
    """Uma GunCon 2 ligada (o id USB de um input do kernel)."""
    for ident in glob.glob(os.path.join(SYS_INPUT, "input*", "id")):
        try:
            with open(os.path.join(ident, "vendor")) as f:
                vendor = f.read().strip().lower()
            with open(os.path.join(ident, "product")) as f:
                product = f.read().strip().lower()
        except OSError:
            continue
        if (vendor, product) == GUNCON2:
            return True
    return False


def on_screen():
    """{"pid", "program", "core", "uid", "runtime"} do programa cuja camada gravou
    o FPS agora ha pouco; None sem nenhum."""
    best = None
    for path in glob.glob(os.path.join(RUN_USER, "*", "fliperos-fps")):
        try:
            age = time.time() - os.path.getmtime(path)
            with open(path, encoding="utf-8", errors="replace") as f:
                fields = f.read().split()
        except OSError:
            continue
        if len(fields) < 4 or age > FPS_FRESH or not fields[0].isdigit() or not os.path.exists("/proc/" + fields[0]):
            continue
        if best is None or age < best[0]:
            runtime = os.path.dirname(path)
            try:
                fps = float(fields[1])
            except ValueError:
                fps = None
            best = (age, {"pid": int(fields[0]), "fps": fps, "program": fields[2], "core": "" if fields[3] == "-" else fields[3],
                          "runtime": runtime, "uid": int(os.path.basename(runtime)) if os.path.basename(runtime).isdigit() else 0})
    return best[1] if best else None


def take_achievements():
    """As conquistas que o fliperos-cheevos watch deixou em
    /run/user/<uid>/fliperos-osd-achievements, uma por arquivo: [(hora,
    titulo)], as mais velhas primeiro; cada arquivo lido e apagado. A pasta e
    do usuario e o servico e root: nada de link (nem a pasta, nem o arquivo) e
    so o que e do dono de /run/user/<uid>."""
    out = []
    for runtime in glob.glob(os.path.join(RUN_USER, "*")):
        try:
            owner = os.stat(runtime).st_uid
            dfd = os.open(os.path.join(runtime, ACHIEVEMENTS_DIR), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        except OSError:
            continue
        try:
            if os.fstat(dfd).st_uid != owner:
                continue
            for name in sorted(os.listdir(dfd)):
                if name.startswith("."):
                    continue
                try:
                    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dfd)
                except OSError:
                    fd = None
                data, when = b"", 0.0
                if fd is not None:
                    try:
                        st = os.fstat(fd)
                        if stat.S_ISREG(st.st_mode) and st.st_uid == owner:
                            data, when = os.read(fd, 1024), st.st_mtime
                    finally:
                        os.close(fd)
                # Lido ou nao (um link, outro dono), o arquivo sai.
                try:
                    os.unlink(name, dir_fd=dfd)
                except OSError:
                    pass
                title = data.decode("utf-8", "replace").split("\n")[0]
                title = "".join(c for c in title if c.isprintable()).strip()[:200]
                if title:
                    out.append((when, name, title))
        except OSError:
            pass
        finally:
            os.close(dfd)
    # Pela hora; na mesma hora, pelo nome (o watch o comeca pelos nanossegundos).
    return [(when, title) for when, name, title in sorted(out)]


def commercial(uid):
    """O modo comercial do frontend: quem joga nao mexe no gabinete."""
    try:
        home = pwd.getpwuid(uid).pw_dir
        with open(os.path.join(home, ".config", "fliperos", "frontend.json"), encoding="utf-8") as f:
            return json.load(f).get("commercial") is True
    except (OSError, KeyError, ValueError):
        return False


def refused(screen):
    """A camada do programa disse que nao consegue desenhar?"""
    try:
        with open(os.path.join(screen["runtime"], "fliperos-osd-refused"), encoding="utf-8") as f:
            return f.read().strip() == str(screen["pid"])
    except OSError:
        return False


def run(args, timeout=30, env=None):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout, env=env)
    except (OSError, subprocess.SubprocessError):
        return None


def process_env(pid):
    """As variaveis do programa aberto."""
    try:
        with open("/proc/%d/environ" % pid, "rb") as f:
            items = f.read().split(b"\0")
    except OSError:
        return {}
    pairs = (item.decode("utf-8", "replace").partition("=") for item in items)
    return {key: value for key, sep, value in pairs if sep}


# ── O modo de video e a geometria ──────────────────────────────────

def parse_mode(text):
    """A saida do fliperos-color mode: {"clock", "h": [4], "v": [4], "interlace"}."""
    fields = text.split()
    if len(fields) != 10 or not all(f.isdigit() for f in fields):
        return None
    n = [int(f) for f in fields]
    return {"clock": n[0], "h": n[1:5], "v": n[5:9], "interlace": bool(n[9])}


def current_mode():
    out = run([COLOR, "mode"], timeout=5)
    return parse_mode(out.stdout) if out and out.returncode == 0 else None


def mode_refresh(mode):
    rate = mode["clock"] * 1000.0 / (mode["h"][3] * mode["v"][3])
    return rate * 2 if mode["interlace"] else rate


def mode_line(mode, fps=None):
    """A linha embaixo do titulo: a resolucao, a frequencia horizontal e a
    vertical, e o FPS do jogo no fim ("640x480i 15.69kHz 60.00Hz  59.9 FPS")."""
    parts = []
    if mode:
        htotal = mode["h"][3] or 1
        parts.append("%s %.2fkHz %.2fHz" % (resolution_key(mode), mode["clock"] / htotal, mode_refresh(mode)))
    if fps is not None:
        parts.append("%.1f FPS" % fps)
    return "  ".join(parts)


def game_name(pid):
    """O jogo do processo: o ultimo argumento que nao e opcao, sem a pasta nem
    a extensao (o set do MAME, o arquivo da ROM). "" sem um."""
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            args = [a.decode("utf-8", "replace") for a in f.read().split(b"\0") if a]
    except (OSError, TypeError):
        return ""
    for arg in reversed(args[1:]):
        if arg.startswith("-") or "=" in arg:
            continue
        name = os.path.basename(arg.rstrip("/"))
        name = re.sub(r"\.(zip|7z|chd|iso|cue|bin|gdi|cdi|rvz|gcz|wbfs|elf|pak|lst|m3u|zst|gz)$", "", name, flags=re.I)
        if name:
            return name
    return ""


def profile_scopes(screen, mode, game=None):
    """{tipo: escopo} dos perfis que valem para este jogo e este modo."""
    screen = screen or {}
    program, core = screen.get("program") or "", screen.get("core") or ""
    scopes = {"default": "default"}
    if mode:
        scopes["resolution"] = "res:" + resolution_key(mode)
    if program:
        scopes["emulator"] = "emu:" + program
    if core:
        scopes["core"] = "core:" + core
    if core or program:
        game = game if game is not None else game_name(screen.get("pid") or 0)
        if game:
            scopes["game"] = "game:%s/%s" % (core or program, game)
    return scopes


class Profiles:
    """O arquivo dos perfis (PROFILES)."""

    def __init__(self, path=None):
        self.path = path or PROFILES
        self.data = {}
        try:
            with open(self.path, encoding="utf-8", errors="replace") as f:
                for line in f:
                    parts = line.rstrip("\n").split("\t")
                    if len(parts) == 3 and parts[1] not in NOT_PROFILED:
                        self.data.setdefault(parts[0], {})[parts[1]] = parts[2]
        except OSError:
            pass

    def keys(self):
        return {key for values in self.data.values() for key in values}

    def delete(self, scope):
        """Apaga um perfil; devolve as chaves que ele tinha."""
        keys = list(self.data.pop(scope, {}))
        self.save()
        return keys

    def set(self, scope, key, value, before=None):
        """O ajuste num escopo. Fora do default, o default guarda o valor de
        antes (before) se ainda nao o tem: e para ele que se volta."""
        if scope != "default" and before is not None and key not in self.data.get("default", {}):
            self.data.setdefault("default", {})[key] = str(before)
        self.data.setdefault(scope, {})[key] = str(value)
        self.save()

    def save(self):
        lines = ["%s\t%s\t%s\n" % (scope, key, value) for scope in sorted(self.data)
                 for key, value in sorted(self.data[scope].items())]
        try:
            os.makedirs(os.path.dirname(self.path) or ".", exist_ok=True)
            with open(self.path + ".new", "w", encoding="utf-8") as f:
                f.writelines(lines)
            os.replace(self.path + ".new", self.path)
        except OSError:
            pass

    def effective(self, scopes):
        """{chave: valor} do default com os escopos de cima por cima (a
        resolucao, depois o emulador, depois o jogo)."""
        out = {}
        for kind in PROFILE_KINDS:
            scope = scopes.get(kind)
            if scope:
                out.update(self.data.get(scope, {}))
        return out

    def chosen(self, scopes):
        """O perfil que se abre: o mais especifico que ja tem ajustes."""
        for kind in reversed(PROFILE_KINDS):
            if kind in scopes and self.data.get(scopes[kind]):
                return kind
        return "default"


def apply_setting(key, value):
    """Um ajuste dos perfis no sistema, pelo Setup."""
    return run([SETUP, "--setting", key, str(value)], timeout=20)


def resolution_key(mode):
    """A resolucao de um modo, como a geometria a guarda: 640x480i, 320x240p."""
    return "%dx%d%s" % (mode["h"][0], mode["v"][0], "i" if mode["interlace"] else "p")


def saved_geometry(conf, key):
    """Os ajustes (h_size, h_shift, v_shift) guardados para a resolucao, ou None.
    O Setup grava geometry_<resolucao>=H_SIZE:H_SHIFT:V_SHIFT."""
    m = re.fullmatch(r"(\d+(?:\.\d+)?):(-?\d+):(-?\d+)", conf.get("geometry_" + key, ""))
    return (float(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None


def timing_args(mode):
    return [str(mode["clock"])] + [str(v) for v in mode["h"] + mode["v"]]


def parse_xrandr(text):
    """A saida do xrandr --current: (a saida ligada, o nome do modo dela na tela)."""
    output = None
    for line in text.splitlines():
        m = re.match(r"(\S+) connected", line)
        if m:
            output = m.group(1)
        elif output and "*" in line and line.startswith(" "):
            return output, line.split()[0]
    return None


class X11Modes:
    """Os modos da geometria num Xorg aberto: o xrandr cria cada um e o poe na
    tela, como o Switchres faz ao abrir o jogo. O nome do modo antigo fica guardado
    para voltar."""

    PREFIX = "FliperOS-OSD-"
    # Um numero por modo criado no servico: cada jogo abre um X11Modes novo, e um
    # nome repetido faria o --newmode falhar com o modo antigo ainda em uso.
    counter = itertools.count(1)

    def __init__(self, env):
        self.env = dict(os.environ, DISPLAY=env["DISPLAY"])
        if env.get("XAUTHORITY"):
            self.env["XAUTHORITY"] = env["XAUTHORITY"]
        out = self.xrandr("--current")
        found = parse_xrandr(out.stdout) if out and out.returncode == 0 else None
        self.output, self.original = found if found else (None, None)
        self.current = None

    def xrandr(self, *args):
        return run([XRANDR] + list(args), timeout=10, env=self.env)

    def valid(self):
        return self.output is not None

    def apply(self, mode):
        name = "%s%d-%d" % (self.PREFIX, os.getpid(), next(self.counter))
        timings = ["%.3f" % (mode["clock"] / 1000)] + [str(v) for v in mode["h"] + mode["v"]]
        flags = (["Interlace"] if mode["interlace"] else []) + mode.get("sync", ["-HSync", "-VSync"])
        for args in (["--newmode", name] + timings + flags, ["--addmode", self.output, name],
                     ["--output", self.output, "--mode", name]):
            out = self.xrandr(*args)
            if not out or out.returncode != 0:
                self.remove(name)
                return False
        self.remove(self.current)
        self.current = name
        return True

    def remove(self, name):
        if name:
            self.xrandr("--delmode", self.output, name)
            self.xrandr("--rmmode", name)

    def keep(self):
        """O modo salvo fica: o proximo Voltar vem para ele, nao o de antes."""
        self.original, self.current = self.current, None

    def restore(self):
        if self.output and self.original and self.current:
            self.xrandr("--output", self.output, "--mode", self.original)
            self.remove(self.current)
            self.current = None


def parse_switchres(text):
    """A saida do switchres -c -v -g: a temporizacao (como o fliperos-color mode),
    a geometria que ele aceitou e o crt_range final, a mesma conta do geometry.py
    do Switchres (as faixas do monitor com os tempos ajustados)."""
    mode = adjusted = monitor = None
    for line in text.splitlines():
        m = re.search(r'Modeline "[^"]*"\s+([\d.]+)\s+(\d+) (\d+) (\d+) (\d+)\s+(\d+) (\d+) (\d+) (\d+)(.*)', line)
        if m and mode is None:
            tail = m.group(10)
            mode = {"clock": round(float(m.group(1)) * 1000), "h": [int(m.group(i)) for i in range(2, 6)],
                    "v": [int(m.group(i)) for i in range(6, 10)], "interlace": "interlace" in tail,
                    "sync": ["+HSync" if "+hsync" in tail else "-HSync", "+VSync" if "+vsync" in tail else "-VSync"]}
        m = re.search(r"Monitor range (\S+)", line)
        if m and monitor is None:
            monitor = m.group(1)
        m = re.match(r"(?:Switchres: )?Adjusted geometry \(([\d.]+):(-?\d+):(-?\d+)\) H: ([\d.]+), ([\d.]+), ([\d.]+) "
                     r"V: ([\d.]+), ([\d.]+), ([\d.]+)", line)
        if m:
            adjusted = m.groups()
    if not mode:
        return None
    # Sem ajuste (1.000:0:0) o Switchres pode nao imprimir a geometria: o modo e o
    # do monitor como esta.
    result = {"mode": mode, "geometry": None, "range": None}
    parts = monitor.split(",") if monitor else []
    if adjusted:
        result["geometry"] = (float(adjusted[0]), int(adjusted[1]), int(adjusted[2]))
        if len(parts) == 14:
            parts[2:8] = list(adjusted[3:9])
            result["range"] = ",".join(parts)
    return result


class Geometry:
    """A geometria da resolucao em uso: vale na hora e so fica se for salva. Cada
    resolucao (640x480i, 320x240p...) tem a sua; sem uma salva vale o crt_range de
    todas. Sair sem salvar volta o modo como estava."""

    NEUTRAL = (1.0, 0, 0)

    def __init__(self, screen=None, mode=None):
        self.base = mode or current_mode()
        self.key = resolution_key(self.base) if self.base else None
        self.value = (saved_geometry(read_conf(), self.key) if self.key else None) or self.NEUTRAL
        self.result = None
        self.saved = False
        self.touched = False
        # Um jogo no X: quem troca o modo e o proprio X.
        env = process_env(screen["pid"]) if screen and screen.get("pid") else {}
        self.x11 = X11Modes(env) if env.get("DISPLAY") else None

    def valid(self):
        return self.base is not None and (self.x11 is None or self.x11.valid())

    def compute(self):
        """O modelo do Switchres para a geometria pedida; ele reduz ao que o
        monitor aceita, e essa e a que fica."""
        base = self.base
        command = [SWITCHRES, str(base["h"][0]), str(base["v"][0]), "%.6f" % mode_refresh(base), "-c", "-v",
                   "-g", "%.3f:%d:%d" % self.value]
        out = run(command, timeout=10)
        return parse_switchres(out.stdout + "\n" + out.stderr) if out else None

    def apply(self):
        """Na placa, com o jogo aberto. Devolve a geometria que o Switchres aceitou
        (None se o modo nao serve aqui: outro tamanho ou o progressivo trocado)."""
        result = self.compute()
        base = self.base
        if not result or result["mode"]["h"][0] != base["h"][0] or result["mode"]["v"][0] != base["v"][0] \
                or result["mode"]["interlace"] != base["interlace"]:
            return None
        if self.x11:
            if not self.x11.apply(result["mode"]):
                return None
        else:
            out = run([COLOR, "timing"] + timing_args(result["mode"]), timeout=5)
            if not out or out.returncode != 0:
                return None
        self.result = result
        self.touched = True
        return result["geometry"] or self.value

    def restore(self):
        """O modo de quando a pagina abriu."""
        if self.x11:
            self.x11.restore()
        elif self.base and self.touched and not self.saved:
            run([COLOR, "timing"] + timing_args(self.base), timeout=5)

    def save(self):
        """Guarda os ajustes desta resolucao (os da tela: o Switchres ja os reduziu
        ao que o monitor aceita). Sem ajuste nenhum, a resolucao volta a seguir o
        crt_range de todas."""
        if not self.result or not self.key:
            return False
        if self.value == self.NEUTRAL:
            command = ["reset-res", self.key]
        else:
            command = ["set-res", self.key, "%.3f:%d:%d" % self.value]
        out = run([SETUP, "--geometry"] + command, timeout=20)
        self.saved = bool(out and out.returncode == 0)
        if self.saved:
            # Sair sem salvar volta para este modo.
            self.base = self.result["mode"]
            if self.x11:
                self.x11.keep()
        return self.saved


# ── A fila dos ajustes ─────────────────────────────────────────────

class Worker:
    """Um ajuste por vez, sem travar o menu: de cada chave vale o ultimo pedido."""

    def __init__(self):
        self.lock = threading.Condition()
        self.pending = {}
        self.order = []
        self.busy = False
        thread = threading.Thread(target=self.loop, daemon=True)
        thread.start()

    def put(self, key, action):
        with self.lock:
            if key not in self.pending:
                self.order.append(key)
            self.pending[key] = action
            self.lock.notify_all()

    def loop(self):
        while True:
            with self.lock:
                while not self.order:
                    self.lock.wait()
                key = self.order.pop(0)
                action = self.pending.pop(key)
                self.busy = True
            try:
                action()
            except Exception as exc:  # um ajuste que falha nao derruba o servico
                print("fliperos-osd: %s: %s" % (key, exc), file=sys.stderr, flush=True)
            with self.lock:
                self.busy = False
                self.lock.notify_all()

    def wait(self, timeout=8.0):
        """Espera a fila acabar (antes de voltar o modo, de ler os valores de novo)."""
        end = time.monotonic() + timeout
        with self.lock:
            while self.order or self.busy:
                left = end - time.monotonic()
                if left <= 0:
                    return
                self.lock.wait(left)


def volume_state():
    """(porcentagem, mudo) do --volume state; None sem mixer."""
    out = run([SETUP, "--volume", "state"], timeout=5)
    fields = out.stdout.split() if out and out.returncode == 0 else []
    if not fields or not fields[0].isdigit():
        return None
    return int(fields[0]), fields[-1] == "off"


