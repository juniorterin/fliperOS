class Painter:
    """A pagina numa imagem de 320x240, com as cores e a letra da interface
    grafica. O pygame so entra na primeira vez que o menu abre."""

    VISIBLE = 7     # as linhas que cabem sem cobrir a imagem que se esta ajustando
    ROW = 11

    def __init__(self):
        if GUI not in sys.path:
            sys.path.insert(0, GUI)
        os.environ.setdefault("SDL_VIDEODRIVER", "dummy")
        import pygame
        import theme
        pygame.font.init()
        self.pg, self.theme = pygame, theme
        self.font = theme.font()

    def text(self, surface, text, color, x, y):
        surface.blit(self.font.render(text, False, color), (x, y))

    def panel(self, menu):
        pg, t = self.pg, self.theme
        t.set_orientation(read_conf().get("orientation", ""))
        surface = pg.Surface((t.WIDTH, t.HEIGHT), pg.SRCALPHA)
        page = menu.page
        rows = page["rows"]
        if page["name"] == "geometry":
            self.frame(surface)
        # O cursor sempre a vista.
        if page["cursor"] < page["top"]:
            page["top"] = page["cursor"]
        elif page["cursor"] >= page["top"] + self.VISIBLE:
            page["top"] = page["cursor"] - self.VISIBLE + 1
        shown = rows[page["top"]:page["top"] + self.VISIBLE]
        width, height = t.WIDTH - 2 * t.SAFE_X, 18 + len(shown) * self.ROW + 4
        x, y = (t.WIDTH - width) // 2, t.HEIGHT - t.SAFE_Y - height
        pg.draw.rect(surface, t.BG_DEEP + (232,), (x, y, width, height))
        pg.draw.rect(surface, t.PURPLE + (255,), (x, y, width, height), 1)
        self.text(surface, menu.title(), t.PINK, x + 6, y + 5)
        if menu.status:
            status = self.font.render(menu.status, False, t.CYAN)
            surface.blit(status, (x + width - 6 - status.get_width(), y + 5))
        for i, row in enumerate(shown):
            top = y + 17 + i * self.ROW
            chosen = page["top"] + i == page["cursor"]
            if chosen:
                pg.draw.rect(surface, t.LINE + (255,), (x + 2, top, width - 4, self.ROW))
            self.text(surface, row.label, t.PINK if chosen else t.FG, x + 6, top + 2)
            if row.kind == "page":
                self.text(surface, ">", t.COMMENT, x + width - 14, top + 2)
            value = row.text()
            if value:
                image = self.font.render(value, False, t.CYAN)
                surface.blit(image, (x + width - 6 - image.get_width(), top + 2))
            fraction = row.fraction()
            if fraction is not None and len(row.label) <= 10 and width > 240:
                bar_x, bar_w = x + 6 + 88, width - 6 - 88 - 6 - 8 * 7
                pg.draw.rect(surface, t.COMMENT + (255,), (bar_x, top + 3, bar_w, 5), 1)
                pg.draw.rect(surface, t.GREEN + (255,), (bar_x + 1, top + 4, round((bar_w - 2) * fraction), 3))
        # Ha mais linhas acima ou abaixo.
        if page["top"] > 0:
            pg.draw.polygon(surface, t.COMMENT + (255,), [(x + width // 2 - 3, y + 15), (x + width // 2 + 3, y + 15), (x + width // 2, y + 12)])
        if page["top"] + self.VISIBLE < len(rows):
            bottom = y + height - 2
            pg.draw.polygon(surface, t.COMMENT + (255,), [(x + width // 2 - 3, bottom - 2), (x + width // 2 + 3, bottom - 2), (x + width // 2, bottom + 1)])
        return surface

    def frame(self, surface):
        """A moldura e a cruz do meio: para ver os cantos enquanto ajusta."""
        pg, t = self.pg, self.theme
        color = t.FG + (255,)
        w, h = t.WIDTH, t.HEIGHT
        pg.draw.rect(surface, color, (0, 0, w, h), 1)
        pg.draw.rect(surface, t.CYAN + (255,), (t.SAFE_X, t.SAFE_Y, w - 2 * t.SAFE_X, h - 2 * t.SAFE_Y), 1)
        pg.draw.line(surface, color, (w // 2, 0), (w // 2, h - 1))
        pg.draw.line(surface, color, (0, h // 2), (w - 1, h // 2))

    def rgba(self, menu):
        return self.pg.image.tobytes(self.theme.upright(self.panel(menu)), "RGBA")


class Screen:
    """O arquivo que as camadas leem. Aberto, existe; fechado, nao."""

    def __init__(self, path):
        self.path = path
        # Sempre subindo, mesmo entre aberturas e depois de reiniciar o servico: a
        # camada so copia a imagem quando o numero muda. Par: nao esta gravando.
        self.seq = (int(time.time()) & 0x3FFFFFFF) * 2
        self.fd = None

    def show(self, pixels):
        """Grava a imagem, com seq impar durante a gravacao. Um arquivo novo a cada
        abertura: as camadas reconhecem pelo numero dele."""
        if self.fd is None:
            tmp = self.path + ".tmp"
            self.fd = os.open(tmp, os.O_RDWR | os.O_CREAT | os.O_TRUNC, 0o644)
            os.fchmod(self.fd, 0o644)
            self.seq += 2
            os.pwrite(self.fd, HEADER.pack(MAGIC, self.seq, 1, WIDTH, HEIGHT) + pixels, 0)
            os.rename(tmp, self.path)
            return
        os.pwrite(self.fd, struct.pack("<I", self.seq + 1), 4)
        os.pwrite(self.fd, pixels, HEADER.size)
        self.seq += 2
        os.pwrite(self.fd, struct.pack("<I", self.seq), 4)

    def hide(self):
        if self.fd is None:
            return
        # O aviso primeiro: as camadas param no quadro seguinte.
        os.pwrite(self.fd, struct.pack("<I", 0), 8)
        os.close(self.fd)
        self.fd = None
        try:
            os.unlink(self.path)
        except OSError:
            pass


# ── Os controles ───────────────────────────────────────────────────

class Inputs:
    """Os controles e os teclados: primeiro espera soltarem tudo, depois os toma
    (EVIOCGRAB) e traduz para as teclas do menu."""

    EVIOCGRAB = None

    def __init__(self, padkeys, emit):
        self.pk = padkeys
        self.keys = padkeys.Keys(emit)
        self.devices = {}
        self.grabbed = False
        self.since = time.monotonic()
        Inputs.EVIOCGRAB = padkeys._ioc(1, "E", 0x90, 4)
        self.scan()

    def is_keyboard(self, keys):
        return KEY_ENTER in keys and KEY_ESC in keys and self.pk.BTN_LEFT not in keys

    def scan(self):
        for path in sorted(glob.glob(os.environ.get("FLIPEROS_INPUT_EVENTS", "/dev/input/event*"))):
            if path in self.devices:
                continue
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                continue
            try:
                name = bytearray(256)
                fcntl.ioctl(fd, self.pk.EVIOCGNAME, name)
                name = bytes(name).split(b"\0")[0]
                keys = self.pk.bits(fd, EV_KEY, 0x300)
                pad, keyboard = self.pk.is_pad(name, keys), name != self.pk.NAME and self.is_keyboard(keys)
                if not pad and not keyboard:
                    os.close(fd)
                    continue
                ranges = {}
                for axis in self.pk.bits(fd, EV_ABS, 0x40) & {self.pk.ABS_X, self.pk.ABS_Y}:
                    info = bytearray(24)
                    fcntl.ioctl(fd, self.pk.eviocgabs(axis), info)
                    _value, low, high = struct.unpack("6i", info)[:3]
                    ranges[axis] = (low, high)
                self.devices[path] = {"fd": fd, "mapper": self.pk.Mapper(ranges), "keyboard": keyboard, "pad": pad}
                if self.grabbed:
                    self.grab(self.devices[path])
            except OSError:
                os.close(fd)

    def held(self, device):
        """Tem alguma coisa apertada neste aparelho?"""
        fd, mapper = device["fd"], device["mapper"]
        buf = bytearray(0x300 // 8)
        fcntl.ioctl(fd, self.pk._ioc(2, "E", 0x18, len(buf)), buf)
        if any(buf):
            return True
        for axis in self.pk.bits(fd, EV_ABS, 0x40) & set(self.pk.AXES):
            info = bytearray(24)
            fcntl.ioctl(fd, self.pk.eviocgabs(axis), info)
            if mapper.direction(axis, struct.unpack("6i", info)[0]):
                return True
        return False

    def all_released(self):
        try:
            return not any(self.held(d) for d in self.devices.values())
        except OSError:
            return True

    def grab(self, device):
        try:
            fcntl.ioctl(device["fd"], Inputs.EVIOCGRAB, 1)
        except OSError:
            pass

    def poll_grab(self):
        """Toma os controles quando soltarem o atalho (ou passado o tempo)."""
        if self.grabbed:
            return
        if self.all_released() or time.monotonic() - self.since > RELEASE_WAIT:
            for device in self.devices.values():
                self.grab(device)
            self.grabbed = True

    def fds(self):
        return [d["fd"] for d in self.devices.values()]

    def read(self, ready):
        now = time.monotonic()
        for path, device in list(self.devices.items()):
            if device["fd"] not in ready:
                continue
            try:
                data = os.read(device["fd"], self.pk.EVENT.size * 64)
            except BlockingIOError:
                continue
            except OSError:
                data = b""
            if not data:
                for key, value in device["mapper"].release():
                    self.keys.apply(key, value, now)
                os.close(device["fd"])
                del self.devices[path]
                continue
            if not self.grabbed:
                continue
            for i in range(0, len(data) - self.pk.EVENT.size + 1, self.pk.EVENT.size):
                etype, code, value = self.pk.EVENT.unpack_from(data, i)[2:]
                if device["keyboard"] and etype == EV_KEY and code in KEYBOARD:
                    if value in (0, 1):
                        self.keys.apply(KEYBOARD[code], value, now)
                    continue
                for key, pressed in device["mapper"].event(etype, code, value):
                    # O Page Up/Down e o Espaco dos menus do Setup nao fazem nada aqui.
                    if key in (KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT, KEY_ENTER, KEY_ESC):
                        self.keys.apply(key, pressed, now)

    def close(self):
        for device in self.devices.values():
            try:
                os.close(device["fd"])  # fechar solta o EVIOCGRAB
            except OSError:
                pass
        self.devices.clear()


