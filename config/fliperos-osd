class Service:
    def __init__(self):
        self.padkeys = load_padkeys()
        self.worker = Worker()
        self.painter = None
        self.hotkey = None
        self.hotkey_args = None
        self.running = True
        os.makedirs(RUN_DIR, exist_ok=True)
        self.screen_file = Screen(os.path.join(RUN_DIR, "screen"))
        self.control = self.open_control()
        try:
            os.unlink(self.screen_file.path)
        except OSError:
            pass

    def open_control(self):
        path = os.path.join(RUN_DIR, "control")
        try:
            os.unlink(path)
        except OSError:
            pass
        os.mkfifo(path, 0o600)
        # O+W: o FIFO nao "fecha" quando quem escreveu sai.
        return os.open(path, os.O_RDWR | os.O_NONBLOCK)

    def read_control(self):
        try:
            data = os.read(self.control, 4096)
        except OSError:
            return []
        return data.decode("ascii", "replace").split()

    # O atalho.
    def allowed(self, screen):
        conf = read_conf()
        if conf.get("osd") == "off" or not screen or os.path.exists(SETUP_FLAG):
            return False
        return not commercial(screen["uid"])

    def hotkey_command(self):
        conf = read_conf()
        combo = conf.get("osd_combo", DEFAULT_COMBO)
        args = [BUTTONS, "hotkey"]
        key = conf.get("osd_key", str(DEFAULT_KEY))
        if key.isdigit() and int(key):
            args += ["--key", key]
        if combo:
            args += ["--combo", combo, "--hold", conf.get("osd_hold", str(DEFAULT_HOLD))]
        return args

    def stop_hotkey(self):
        if self.hotkey:
            try:
                self.hotkey.terminate()
                self.hotkey.wait(timeout=2)
            except (OSError, subprocess.SubprocessError):
                self.hotkey.kill()
            self.hotkey = None

    def watch_hotkey(self, screen):
        wanted = self.allowed(screen)
        command = self.hotkey_command() if wanted else None
        if self.hotkey and (not wanted or command != self.hotkey_args or self.hotkey.poll() is not None):
            self.stop_hotkey()
        if wanted and not self.hotkey:
            try:
                self.hotkey = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                               stderr=subprocess.DEVNULL)
                self.hotkey_args = command
            except OSError:
                self.hotkey = None

    def hotkey_fired(self):
        """O fliperos-buttons hotkey imprimiu "exit" e saiu."""
        try:
            data = os.read(self.hotkey.stdout.fileno(), 256)
        except OSError:
            data = b""
        self.stop_hotkey()
        return b"exit" in data

    # O menu.
    def open_menu(self):
        screen = on_screen()
        if not self.allowed(screen):
            return
        self.stop_hotkey()
        try:
            os.unlink(os.path.join(screen["runtime"], "fliperos-osd-refused"))
        except OSError:
            pass
        if self.painter is None:
            self.painter = Painter()
        menu = Menu(screen, current_mode(), self.worker)
        pressed = []
        inputs = Inputs(self.padkeys, lambda key, value: pressed.append(key) if value else None)
        last = time.monotonic()
        scanned = last
        try:
            while self.running and not menu.closing:
                now = time.monotonic()
                inputs.poll_grab()
                if now - scanned >= 2:
                    scanned = now
                    inputs.scan()
                # O jogo fechou, ou a camada dele nao consegue desenhar: os
                # controles voltam na hora.
                current = on_screen()
                if not current or current["pid"] != screen["pid"] or refused(screen):
                    menu.close()
                    break
                if now - last > IDLE_CLOSE:
                    menu.close()
                    break
                if menu.dirty:
                    menu.dirty = False
                    self.screen_file.show(self.painter.rgba(menu))
                timeout = inputs.keys.timeout(now, 0.1)
                ready = select.select(inputs.fds() + [self.control], [], [], timeout)[0]
                inputs.read(ready)
                if self.control in ready:
                    for word in self.read_control():
                        if word == "close":
                            menu.close()
                        elif word in COMMANDS:
                            pressed.append(COMMANDS[word])
                inputs.keys.tick(time.monotonic())
                for key in pressed:
                    menu.key(key)
                    last = time.monotonic()
                del pressed[:]
        finally:
            menu.leave_geometry()
            self.screen_file.hide()
            inputs.close()

    def loop(self):
        while self.running:
            screen = on_screen()
            self.watch_hotkey(screen)
            fds = [self.control]
            if self.hotkey:
                fds.append(self.hotkey.stdout.fileno())
            ready = select.select(fds, [], [], 0.5)[0]
            if self.control in ready and "open" in self.read_control():
                self.open_menu()
            elif self.hotkey and self.hotkey.stdout.fileno() in ready and self.hotkey_fired():
                self.open_menu()

    def stop(self, *_):
        self.running = False


def shot(page, path):
    """A imagem de uma pagina, sem jogo e sem controle (os testes do desenho)."""
    os.environ.setdefault("SDL_VIDEODRIVER", "dummy")
    painter = Painter()
    mode = {"clock": 13038, "h": [640, 666, 727, 831], "v": [480, 483, 489, 523], "interlace": True}
    menu = Menu({"program": "pcsx2", "core": ""}, mode, Worker())
    if page != "main":
        menu.open_page(page)
    surface = painter.theme.upright(painter.panel(menu))
    backdrop = painter.pg.Surface((WIDTH, HEIGHT))
    backdrop.fill((40, 80, 160))
    backdrop.blit(surface, (0, 0))
    painter.pg.image.save(painter.pg.transform.scale(backdrop, (WIDTH * 2, HEIGHT * 2)), path)


def main():
    if len(sys.argv) == 4 and sys.argv[1] == "--shot":
        shot(sys.argv[2], sys.argv[3])
        return 0
    service = Service()
    signal.signal(signal.SIGTERM, service.stop)
    signal.signal(signal.SIGINT, service.stop)
    try:
        service.loop()
    except KeyboardInterrupt:
        pass
    finally:
        service.stop_hotkey()
        service.screen_file.hide()
    return 0


if __name__ == "__main__":
    sys.exit(main())
