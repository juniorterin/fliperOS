class Row:
    """Uma linha: kind number (minimo, maximo, passo), choice (options), page ou
    action (Enter). change(valor) aplica."""

    def __init__(self, kind, label, value=None, low=0, high=0, step=1, options=(), pretty=str, change=None, action=None):
        self.kind, self.label, self.value = kind, label, value
        self.low, self.high, self.step = low, high, step
        self.options, self.pretty, self.change, self.action = options, pretty, change, action
        self.previous = None

    def text(self):
        if self.kind == "action" and self.value:
            return str(self.value)
        if self.kind == "choice":
            for value, label in self.options:
                if value == self.value:
                    return label
            return str(self.value)
        if self.kind == "number":
            return self.pretty(self.value)
        return ""

    def fraction(self):
        if self.kind != "number" or self.high <= self.low:
            return None
        return max(0.0, min(1.0, (self.value - self.low) / (self.high - self.low)))

    def move(self, direction):
        """Muda o valor pela seta; True se mudou."""
        if self.kind == "number":
            value = round(max(self.low, min(self.high, self.value + direction * self.step)), 4)
        elif self.kind in ("choice", "buttons") and self.options:
            values = [v for v, _ in self.options]
            where = values.index(self.value) if self.value in values else 0
            value = values[max(0, min(len(values) - 1, where + direction))]
        else:
            return False
        if value == self.value:
            return False
        self.previous = self.value
        self.value = value
        if self.change:
            self.change(value)
        return True


def signed(value):
    return "%+d" % value if value else "0"


def pretty_color(key):
    """O valor como o Setup mostra (color_pretty em lib/video.sh)."""
    if key.endswith("gamma"):
        return lambda v: "%.2f" % (v / 100)
    if key.endswith("temperature"):
        return lambda v: "%d K" % v
    if key.endswith(("contrast", "gain", "saturation")):
        return lambda v: "%d%%" % v
    if key.endswith("hue"):
        return lambda v: "%d deg" % v
    return signed


def parse_settings(text):
    """As linhas do fliperos-setup --settings: chave|grupo|rotulo|tipo|valor|opcoes|ajuda."""
    rows = {}
    for line in text.splitlines():
        parts = line.split("|", 6)
        if len(parts) == 7:
            rows[parts[0]] = {"key": parts[0], "group": parts[1], "label": parts[2], "type": parts[3],
                              "value": parts[4], "options": parts[5]}
    return rows


def number_options(text):
    """"MIN..MAX:PASSO" -> (minimo, maximo, passo)."""
    m = re.fullmatch(r"(-?[\d.]+)\.\.(-?[\d.]+):([\d.]+)", text)
    return tuple(float(g) for g in m.groups()) if m else None


def choice_options(text):
    return [tuple(item.split("=", 1)) for item in text.split(";") if "=" in item]


class Menu:
    """As paginas do menu e o que cada linha faz."""

    def __init__(self, screen, mode, worker, emulator_key=None, gamekeys=None):
        self.screen, self.mode, self.worker = screen or {}, mode, worker
        # A tecla do menu do emulador na tela (None: sem o botao Emulator
        # menu) e o que fazer depois de fechar: "emulator" (apertar a tecla)
        # ou "quit" (fechar o jogo).
        self.emulator_key = emulator_key if is_game(self.screen) else None
        # Um jogo custom com o mapa do controle rodando (fliperos-buttons
        # gamekeys): {"folder", "keyfile", "buttons"}; o Controller
        # configuration no lugar do Emulator menu. osk: o teclado na tela
        # dele; capture_request: a tecla que espera o botao (o servico
        # pergunta ao gamekeys e chama capture_done).
        self.gamekeys = gamekeys if is_game(self.screen) else None
        self.osk = None
        self.capture_request = None
        self.after = None
        self.stack = []
        self.geometry = None
        self.status = ""
        self.closing = False
        self.dirty = True
        self.profiles = Profiles()
        self.scopes = profile_scopes(self.screen, mode)
        self.profile = self.profiles.chosen(self.scopes)
        # chave -> [valor de antes, valor novo] dos ajustes ainda nao salvos.
        self.pending = {}
        self.open_page("main")

    # O que aparece.
    def open_page(self, name):
        self.stack.append({"name": name, "rows": self.rows_of(name), "cursor": 0, "top": 0})
        self.status = ""
        self.dirty = True

    @property
    def page(self):
        return self.stack[-1]

    def title(self):
        name = self.page["name"]
        if name == "geometry" and self.geometry and self.geometry.key:
            # A geometria e de uma resolucao: qual, fica a vista enquanto se ajusta.
            return "GEOMETRY " + self.geometry.key
        return {"main": "FLIPEROS", "config": "CONFIGURATION", "colour": "COLOUR", "geometry": "GEOMETRY",
                "guncon": "GUNCON 2", "scanlines": "SCANLINES", "keys": "CONTROLLER"}.get(name, "")

    def rows_of(self, name):
        return getattr(self, "rows_" + name)()

    def subtitle(self):
        """A resolucao, as frequencias e o FPS, em letra menor embaixo do
        titulo de todas as paginas (relidos com o menu aberto, live)."""
        return mode_line(self.mode, self.screen.get("fps"))

    def live(self, mode, fps):
        """O modo e o FPS de agora (o servico os rele a cada LIVE_POLL s com
        o menu aberto): mudou o que se ve, desenha de novo. A geometria sendo
        ajustada guarda o modo dela (Geometry), e os perfis o da abertura."""
        before = self.subtitle()
        if mode:
            self.mode = mode
        self.screen["fps"] = fps
        if self.subtitle() != before:
            self.dirty = True

    def profile_label(self, kind):
        return kind + ".cfg"

    def rows_main(self):
        """A Configuration e os botoes: Emulator menu (o do proprio emulador,
        quando ele tem um), Close e Quit (so num jogo). O volume nao: e das
        teclas de volume e do painel web."""
        rows = []
        rows.append(Row("page", "Configuration", action=lambda: self.open_page("config")))
        # Itens do menu, cada um com o icone dele (Painter.ICONS e a cor do tema).
        items = []
        if self.emulator_key is not None:
            items.append(("Emulator menu", ("menu", "CYAN"), lambda: self.leave("emulator")))
        elif self.gamekeys:
            # Um jogo custom: o controle como teclado (os jogos sem joystick).
            items.append(("Controller configuration", ("pad", "CYAN"), self.open_keys))
        items.append(("Close", ("close", "RED"), self.close))
        if is_game(self.screen):
            items.append(("Quit", ("quit", "ORANGE"), lambda: self.leave("quit")))
        for label, icon, action in items:
            row = Row("action", label, action=action)
            row.icon = icon
            rows.append(row)
        return rows

    def rows_config(self):
        """Configuration: o perfil, o filtro do entrelacado, as paginas dos
        ajustes e, na base, Save (grava no perfil) e Back."""
        rows = []
        # Para onde o Save grava (e o que o Delete profile apaga): tudo, esta resolucao, este emulador, este
        # core ou este jogo (as setas trocam).
        rows.append(Row("choice", "Save profile as", self.profile,
                        options=[(kind, self.profile_label(kind)) for kind in PROFILE_KINDS if kind in self.scopes],
                        change=self.set_profile))
        # Apagar o perfil escolhido acima (o Enter duas vezes).
        rows.append(Row("action", "Delete profile", self.delete_label(self.profile), action=self.delete_profile))
        if self.mode and self.mode["interlace"]:
            conf = read_conf()
            program, core = self.screen.get("program", ""), self.screen.get("core", "")
            rows.append(Row("choice", "Interlaced filter", filter_level(conf, program, core),
                            options=[(v, LABELS[v]) for v in FILTER_LEVELS], change=self.set_filter))
        # As scanlines de um monitor de 31 kHz (Setup > Video Setup > Scanlines,
        # scanlines_available em lib/video.sh): as camadas releem o fliperos.conf
        # e a troca vale com o jogo aberto, para todos os jogos.
        conf = read_conf()
        if conf.get("frequency", "") == "31k":
            # A pagina das scanlines: ligar e cada ajuste, na hora.
            rows.append(Row("page", "Scanlines", action=self.open_scanlines))
        if conf.get("monitor", "") != "lcd" and self.mode:
            rows.append(Row("page", "Geometry", action=lambda: self.open_page("geometry")))
        rows.append(Row("page", "Colour", action=self.open_colour))
        # A GunCon 2 ligada: os ajustes dela com o jogo aberto, para acertar a
        # mira e o flash atirando (Setup > Joysticks > GunCon 2).
        if guncon_present():
            rows.append(Row("page", "GunCon 2", action=self.open_guncon))
        # Na base, lado a lado: Save (grava no perfil) e Back.
        buttons = Row("buttons", "Save|Back", "save", options=[("save", "Save"), ("back", "Back")])
        buttons.action = lambda: self.save_profile() if buttons.value == "save" else self.back()
        rows.append(buttons)
        return rows

    # ── Controller configuration (os jogos custom) ──
    # O teclado na tela: Enter numa tecla espera um botao do controle (o
    # gamekeys diz qual, pN_CONTROLE), que passa a mandar essa tecla; o mesmo
    # botao de novo na mesma tecla a limpa. As teclas com botao ficam acesas.
    # Save grava o .key do jogo e o gamekeys o rele; Back sai sem gravar.

    def rows_keys(self):
        return []

    def open_keys(self):
        buttons = self.gamekeys["buttons"]
        names = {code: name for name, code in buttons.GAME_KEYS.items()}
        current = buttons.read_gamekeys(self.gamekeys["keyfile"])
        self.osk = {"map": {pc: names[code] for pc, code in current.items() if code in names},
                    "row": 1, "col": 1, "button": 1, "changed": False}
        self.open_page("keys")

    def osk_rows(self):
        """As linhas do teclado; a ultima, os botoes (com peso 1 cada)."""
        return [list(row) for row in OSK_ROWS] + [[(v, label, 1) for v, label in OSK_BUTTONS]]

    @staticmethod
    def osk_centers(row):
        total, at, out = sum(w for _, _, w in row), 0.0, []
        for _, _, w in row:
            out.append((at + w / 2) / total)
            at += w
        return out

    def osk_current(self):
        rows = self.osk_rows()
        return rows[self.osk["row"]][self.osk["col"]][0]

    def osk_bound(self, key):
        """Os controles que mandam a tecla key, em ordem."""
        return sorted((pc for pc, name in self.osk["map"].items() if name == key),
                      key=lambda pc: (pc[0], CONTROL_ORDER.index(pc[1]) if pc[1] in CONTROL_ORDER else 99))

    def osk_key(self, key):
        osk = self.osk
        rows = self.osk_rows()
        if key == KEY_ESC:
            self.back()
        elif key in (KEY_UP, KEY_DOWN):
            # A tecla da outra linha mais perto da de agora.
            here = self.osk_centers(rows[osk["row"]])[osk["col"]]
            osk["row"] = max(0, min(len(rows) - 1, osk["row"] + (1 if key == KEY_DOWN else -1)))
            centers = self.osk_centers(rows[osk["row"]])
            osk["col"] = min(range(len(centers)), key=lambda i: abs(centers[i] - here))
        elif key in (KEY_LEFT, KEY_RIGHT):
            osk["col"] = max(0, min(len(rows[osk["row"]]) - 1, osk["col"] + (1 if key == KEY_RIGHT else -1)))
        elif key == KEY_ENTER:
            current = self.osk_current()
            if osk["row"] == len(rows) - 1:
                if current == "clear":
                    osk["map"] = {}
                    osk["changed"] = True
                    self.status = "CLEARED"
                elif current == "save":
                    self.save_keys()
                else:
                    self.back()
            else:
                self.capture_request = current
                self.status = ""
        self.dirty = True

    def capture_done(self, answer):
        """A resposta do gamekeys a tecla capture_request: pN_CONTROLE, none
        (ninguem apertou) ou None (o gamekeys nao respondeu)."""
        key, self.capture_request = self.capture_request, None
        self.dirty = True
        found = re.fullmatch(r"p([1-8])_([a-z0-9]+)", answer or "")
        if not found:
            self.status = "NO BUTTON" if answer == "none" else "NO CONTROLLER MAPPER"
            return
        control = (int(found.group(1)), found.group(2))
        if self.osk["map"].get(control) == key:
            del self.osk["map"][control]
            self.status = "%s CLEARED" % key
        else:
            self.osk["map"][control] = key
            self.status = "%s SET" % key
        self.osk["changed"] = True

    def save_keys(self):
        buttons = self.gamekeys["buttons"]
        try:
            buttons.save_gamekeys(self.gamekeys["keyfile"],
                                  {pc: buttons.GAME_KEYS[name] for pc, name in self.osk["map"].items()})
        except OSError as exc:
            print("fliperos-osd: could not save %s: %s" % (self.gamekeys["keyfile"], exc), file=sys.stderr)
            self.status = "NOT SAVED"
            return
        buttons.gamekeys_call(self.gamekeys["folder"], "reload")
        self.osk["changed"] = False
        self.status = "SAVED"

    def leave(self, what):
        """Emulator menu ou Quit: a OSD fecha (o que nao foi salvo volta) e o
        servico aperta a tecla do menu do emulador ou fecha o jogo."""
        self.after = what
        self.close()

    def find_row(self, label):
        """A linha de rotulo label nas paginas abertas (a de cima primeiro)."""
        for page in reversed(self.stack):
            for row in page["rows"]:
                if row.label == label:
                    return row
        return None

    def open_colour(self):
        # Os valores de agora: o que estava na fila tem de chegar antes.
        self.worker.wait()
        self.open_page("colour")

    def open_scanlines(self):
        self.worker.wait()
        self.open_page("scanlines")

    def rows_scanlines(self):
        """Ligadas ou nao e os ajustes do Setup > Video Setup > Scanlines (o
        escuro, a espessura, a altura da linha e o brilho): as camadas releem o
        fliperos.conf, e a mudanca aparece no jogo aberto."""
        def pretty(key):
            if key == "scanline.height":
                return lambda v: "Auto" if v == 0 else "%d" % v
            if key in ("scanline.strength", "scanline.thickness", "scanline.brightness"):
                return lambda v: "%d%%" % v
            return str
        rows = self.settings_rows(lambda key: key == "scanlines" or key.startswith("scanline."), pretty)
        rows.append(Row("action", "Back to the defaults", action=self.reset_scanlines))
        rows.append(Row("action", "Back", action=self.back))
        return rows

    def reset_scanlines(self):
        def apply():
            run([SETUP, "--setting", "scanline.reset", "1"], timeout=20)
            if self.page["name"] == "scanlines":
                self.page["rows"] = self.rows_scanlines()
            self.dirty = True
        self.worker.put("scanlines-reset", apply)

    def open_guncon(self):
        self.worker.wait()
        self.open_page("guncon")

    def settings_rows(self, wanted, pretty=lambda key: str):
        """As linhas de numero e de escolha do --settings cujas chaves passam
        em wanted(chave); cada mudanca vale na hora (fliperos-setup --setting)."""
        rows = []
        settings = parse_settings(self.settings_text())
        for key, row in settings.items():
            if not wanted(key) or row["type"] == "action":
                continue
            if row["type"] == "number":
                limits = number_options(row["options"])
                if limits:
                    low, high, step = limits
                    rows.append(Row("number", row["label"], int(float(row["value"] or 0)), int(low), int(high),
                                    int(step), pretty=pretty(key), change=self.setter(key)))
                    rows[-1].key = key
            elif row["type"] == "choice":
                rows.append(Row("choice", row["label"], row["value"], options=choice_options(row["options"]),
                                change=self.setter(key)))
        return rows

    def rows_colour(self):
        rows = self.settings_rows(lambda key: key.startswith("color."), pretty_color)
        rows.append(Row("action", "Back to the defaults", action=self.reset_colour))
        rows.append(Row("action", "Back", action=self.back))
        return rows

    def rows_guncon(self):
        """O flash da tela, os numeros do driver e a recarga fora da tela: o
        fliperos-guncon2-calibrate --params os passa a pistola na hora, e o
        tiro seguinte ja sai com eles. A calibracao (os alvos) fica no Setup."""
        rows = self.settings_rows(lambda key: key == "gun_flash" or key == "gun_offscreen_reload"
                                  or key.startswith("gun."))
        if not rows:
            self.status = "NO GUNCON 2 SETTINGS"
        rows.append(Row("action", "Back to the defaults", action=self.reset_guncon))
        rows.append(Row("action", "Back", action=self.back))
        return rows

    def rows_geometry(self):
        self.geometry = Geometry(self.screen, self.mode)
        if not self.geometry.valid():
            self.status = "NO VIDEO MODE TO ADJUST"
            return [Row("action", "Back", action=self.back)]
        h_size, h_shift, v_shift = self.geometry.value
        return [
            Row("number", "H size", h_size, H_SIZE[0], H_SIZE[1], H_SIZE[2], pretty=lambda v: "%.2f" % v,
                change=lambda v: self.set_geometry(0, v)),
            Row("number", "H position", h_shift, H_SHIFT[0], H_SHIFT[1], H_SHIFT[2], pretty=signed,
                change=lambda v: self.set_geometry(1, v)),
            Row("number", "V position", v_shift, V_SHIFT[0], V_SHIFT[1], V_SHIFT[2], pretty=signed,
                change=lambda v: self.set_geometry(2, v)),
            Row("action", "Save", action=self.save_geometry),
            Row("action", "Use the default", action=self.reset_geometry),
            Row("action", "Back", action=self.back),
        ]

    def settings_text(self):
        """Os ajustes do Setup, os mesmos do painel web."""
        out = run([SETUP, "--settings"], timeout=20)
        return out.stdout if out else ""

    # O que as linhas fazem.
    def set_profile(self, kind):
        self.profile = kind
        self.confirm_delete = None
        row = self.find_row("Delete profile")
        if row:
            row.value = self.delete_label(kind)

    def delete_label(self, kind):
        """O que o Delete profile apaga: o perfil escolhido; o default, que e o
        padrao de tudo, nao se apaga."""
        return "-" if kind == "default" else self.profile_label(kind)

    def delete_profile(self):
        """Delete profile: o perfil escolhido em Save profile as sai (o
        segundo Enter confirma), e o que ele mudava volta ao que vale sem ele."""
        scope = self.scopes.get(self.profile, "default")
        name = self.profile_label(self.profile).upper()
        if scope == "default":
            self.status = "DEFAULT.CFG STAYS"
            return
        if not self.profiles.data.get(scope):
            self.status = "NO " + name
            return
        if getattr(self, "confirm_delete", None) != scope:
            self.confirm_delete = scope
            self.status = "ENTER AGAIN: DELETE " + name
            return
        self.confirm_delete = None
        keys = self.profiles.delete(scope)
        wanted = self.profiles.effective(self.scopes)
        for key in keys:
            if key in wanted:
                self.worker.put("profile-" + key, lambda key=key, value=wanted[key]: apply_setting(key, value))
        self.status = "DELETED " + name

    def store(self, key, value, before):
        """Um ajuste: posto no sistema agora e guardado no perfil so com o Save."""
        if key in self.pending:
            self.pending[key][1] = value
        else:
            self.pending[key] = [before, value]
        self.worker.put(key, lambda: apply_setting(key, value))

    def save_profile(self):
        """Save: os ajustes feitos vao para o perfil escolhido."""
        scope = self.scopes.get(self.profile, "default")
        for key, (before, value) in sorted(self.pending.items()):
            self.profiles.set(scope, key, value, before)
        self.pending.clear()
        self.status = "SAVED " + self.profile_label(self.profile).upper()

    def discard(self):
        """Close sem Save: o que nao foi salvo volta como estava."""
        for key, (before, value) in sorted(self.pending.items()):
            if before is not None and str(before) != str(value):
                self.worker.put("undo-" + key, lambda key=key, before=before: apply_setting(key, before))
        self.pending.clear()

    def setter(self, key):
        def change(value):
            before = next((r.previous for r in self.page["rows"] if r.change is change), None)
            self.store(key, value, before)
        return change

    def set_filter(self, value):
        program = self.screen.get("core") or self.screen.get("program", "")
        row = self.find_row("Interlaced filter")
        before = row.previous if row else None
        self.store("level." + program, value, before)

    def set_geometry(self, index, value):
        geometry = self.geometry
        current = list(geometry.value)
        current[index] = value
        geometry.value = tuple(current)
        geometry.saved = False

        def apply():
            accepted = geometry.apply()
            if accepted is None:
                self.status = "THE CARD REFUSED THIS MODE"
            else:
                self.status = ""
                # O limite do monitor: o valor na tela volta ao que vale.
                geometry.value = accepted
                rows = self.page["rows"] if self.page["name"] == "geometry" else []
                for row, value_now in zip(rows[:3], accepted):
                    row.value = value_now
            self.dirty = True
        self.worker.put("geometry", apply)

    def save_geometry(self):
        geometry = self.geometry

        def apply():
            saved = geometry.save()
            self.status = "SAVED" if saved else "NOT SAVED"
            rows = self.page["rows"] if self.page["name"] == "geometry" else []
            if saved:
                for row, value_now in zip(rows[:3], geometry.value):
                    row.value = value_now
            self.dirty = True
        self.worker.wait()
        self.status = "SAVING"
        self.dirty = True
        self.worker.put("geometry-save", apply)

    def reset_geometry(self):
        """Esta resolucao volta a seguir o crt_range de todas: na placa e no Setup."""
        geometry = self.geometry
        geometry.value = geometry.NEUTRAL
        geometry.saved = False

        def apply():
            accepted = geometry.apply()
            if accepted is None:
                self.status = "THE CARD REFUSED THIS MODE"
            else:
                saved = geometry.save()
                self.status = "DEFAULT" if saved else "NOT SAVED"
                rows = self.page["rows"] if self.page["name"] == "geometry" else []
                for row, value_now in zip(rows[:3], geometry.value):
                    row.value = value_now
            self.dirty = True
        self.worker.wait()
        self.status = "SAVING"
        self.dirty = True
        self.worker.put("geometry-save", apply)

    def reset_guncon(self):
        def apply():
            run([SETUP, "--setting", "gun.reset", "1"], timeout=20)
            if self.page["name"] == "guncon":
                self.page["rows"] = self.rows_guncon()
            self.status = "DEFAULT"
            self.dirty = True
        self.worker.put("guncon-reset", apply)

    def reset_colour(self):
        def apply():
            run([SETUP, "--setting", "color.reset", "1"], timeout=20)
            if self.page["name"] == "colour":
                self.page["rows"] = self.rows_colour()
            self.dirty = True
        self.worker.put("colour-reset", apply)

    def leave_geometry(self):
        if self.geometry:
            self.worker.wait()
            self.geometry.restore()
            self.geometry = None

    def back(self):
        if self.page["name"] == "geometry":
            self.leave_geometry()
        if len(self.stack) == 1:
            self.close()
            return
        self.stack.pop()
        self.status = ""
        # Um ajuste de outra pagina pode ter mudado o que esta aqui.
        self.dirty = True

    def close(self):
        self.leave_geometry()
        self.discard()
        self.closing = True

    def key(self, key):
        """Uma tecla do menu (os codigos do evdev)."""
        page = self.page
        rows = page["rows"]
        if page["name"] == "keys":
            if self.capture_request is None:
                self.osk_key(key)
            return
        if key == KEY_ESC:
            self.back()
        elif not rows:
            pass
        elif key in (KEY_UP, KEY_DOWN):
            page["cursor"] = (page["cursor"] + (1 if key == KEY_DOWN else -1)) % len(rows)
            self.dirty = True
        elif key in (KEY_LEFT, KEY_RIGHT):
            if rows[page["cursor"]].move(1 if key == KEY_RIGHT else -1):
                self.dirty = True
        elif key == KEY_ENTER:
            row = rows[page["cursor"]]
            if row.action:
                row.action()
            elif row.kind in ("number", "choice"):
                pass
            self.dirty = True


