#!/usr/bin/env python3
"""OSD de teste: a resolucao e a frequencia da tela, num canto, por cima do
programa aberto num Xorg do fliperos-x11-run.

    FLIPEROS_OSD=1 fliperos-x11-run programa      (o fliperos-x11-client o abre)

O que mostra e o modo em que a saida esta agora, lido do XRandR (pelo GDK,
com a frequencia em milesimos de Hz, do relogio de pixel e dos totais do
modeline), e acompanha as trocas de modo: serve para conferir se a tela
esta na frequencia em que o emulador roda o jogo. Sem o GTK 3 do Python
(python3-gi, gir1.2-gtk-3.0), nao abre nada.
"""
import sys

POLL_MS = 500


def text(width, height, millihertz):
    """384x224 59.637 Hz; sem a frequencia (0 no GDK), so o tamanho."""
    if millihertz <= 0:
        return '%dx%d' % (width, height)
    return '%dx%d %d.%03d Hz' % (width, height, millihertz // 1000, millihertz % 1000)


def font_px(height):
    """Legivel em 240 linhas sem tomar a tela; cresce com o modo."""
    return max(8, height // 28)


def main():
    try:
        import gi
        gi.require_version('Gtk', '3.0')
        gi.require_version('Gdk', '3.0')
        from gi.repository import Gdk, GLib, Gtk
    except (ImportError, ValueError) as error:
        print('fliperos-osd: no GTK 3 for Python (%s)' % error, file=sys.stderr)
        return 1
    if not Gtk.init_check()[0]:
        print('fliperos-osd: no X display', file=sys.stderr)
        return 1

    window = Gtk.Window(type=Gtk.WindowType.POPUP)
    window.set_accept_focus(False)
    window.set_keep_above(True)
    label = Gtk.Label()
    window.add(label)
    css = Gtk.CssProvider()
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    shown = [None]

    def refresh():
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() or display.get_monitor(0)
        if monitor is not None:
            area = monitor.get_geometry()
            state = (area.x, area.y, area.width, area.height, monitor.get_refresh_rate())
            if state != shown[0]:
                shown[0] = state
                css.load_from_data(('window { background: #000; } label { color: #ff0; padding: 1px 3px; '
                                    'font: bold %dpx monospace; }' % font_px(area.height)).encode())
                label.set_text(text(area.width, area.height, state[4]))
                window.resize(1, 1)
                # Fora da borda que o tubo come (overscan).
                window.move(area.x + area.width * 6 // 100, area.y + area.height * 6 // 100)
                window.show_all()
        # Uma tela cheia aberta depois ficaria por cima.
        if window.get_window() is not None:
            window.get_window().raise_()
        return True

    refresh()
    GLib.timeout_add(POLL_MS, refresh)
    Gtk.main()
    return 0


if __name__ == '__main__':
    sys.exit(main())
