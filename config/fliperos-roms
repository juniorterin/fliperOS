#!/usr/bin/env bash
# As pastas do usuario em ~ (docs/wiki/ROMs.md), cada uma com um
# _info.txt do que vai nela:
#   ~/roms    o acervo: uma por emulador e uma por core do RetroArch em
#             ~/roms/retroarch/<core>. Os cores vem das informacoes que o
#             proprio RetroArch usa (/opt/fliperos/retroarch/info): um core
#             novo do Online Updater ganha pasta no login seguinte.
#   ~/bios    a pasta "system" do RetroArch e uma subpasta por emulador que
#             procura em outro lugar.
#   ~/media   a arte e os textos dos frontends (lib/scraper.sh do Setup): uma
#             pasta por tipo e, dentro, as mesmas pastas de ~/roms.
#   ~/nvram   o que os arcades lembram sem energia: uma pasta por emulador e
#             uma por core do RetroArch que grava isso, como em ~/roms.
#   ~/save    os saves e os estados: uma pasta por emulador (retroarch, mame,
#             ps2).
#   ~/config  links para as configuracoes de cada emulador e frontend
#             instalado (os que ja criaram a sua).
#   ~/splashscreen  os temas do splash (Plymouth), um por pasta.
# So cria o que falta; roda a cada login (fliperos-tty1) e no build da imagem.
set -u
roms=${FLIPEROS_ROMS:-$HOME/roms}
bios=${FLIPEROS_BIOS:-$HOME/bios}
media=${FLIPEROS_MEDIA:-$HOME/media}
config=${FLIPEROS_CONFIG_LINKS:-$HOME/config}
info=${FLIPEROS_CORE_INFO:-/opt/fliperos/retroarch/info}
etc=${FLIPEROS_ETC:-/etc/fliperos}
splash=${FLIPEROS_SPLASH:-$HOME/splashscreen}

# Setup > Games > Folders (lib/folders.sh) faz de qualquer uma destas pastas um link
# para a "custom folder" da pessoa (um disco externo) e guarda a de antes ao
# lado, com "old-" no nome (~/old-roms, ~/roms/old-mame). Com o link apagado a
# mao, a de antes volta para o lugar em vez de nascer uma pasta nova e vazia.
restore() {
  local old=${1%/*}/old-${1##*/}
  [[ -e $1 || -L $1 ]] && return 0
  [[ -d $old && ! -L $old ]] && mv "$old" "$1" 2> /dev/null
  return 0
}
restore "$roms"
restore "$roms/retroarch"

# Um link para um disco que nao esta ligado: essa pasta fica como esta (nada
# e criado nela) e as outras seguem.
mkdir -p "$roms/retroarch" 2> /dev/null || [[ -L $roms || -L $roms/retroarch ]] || exit 0

# folder PASTA TEXTO
folder() {
  restore "$1"
  [[ -d $1 ]] || mkdir -p "$1" 2> /dev/null || return 0
  [[ -e $1/_info.txt ]] || printf '%s
' "$2" > "$1/_info.txt" 2> /dev/null
  return 0
}

folder "$roms/mame" "GroovyMAME: ROM sets (.zip/.7z, without unzipping) and CHD folders."
folder "$roms/ps2" "PCSX2 (PlayStation 2): .iso .chd .cso .bin/.cue. The BIOS goes in ~/bios/ps2."
# O DuckStation nao vem na imagem (Setup > Games > Emulators & Games): a pasta
# so com ele instalado, senao seria uma segunda pasta de PS1 ao lado da do
# core do RetroArch. Com o nome do sistema, como a ~/roms/ps2; antes era
# ~/roms/psx e depois ~/roms/duckstation: o que tem nelas (e nas pastas da
# arte em ~/media) vai para a nova sem sobrescrever, e a velha sai se ficar
# vazia. Uma pasta que e um link (custom folder, Setup > Games > Folders)
# passa a ter o nome novo, com a "old-" dela.
moveto() {
  [[ -d $1 && ! -L $1 ]] || return 0
  mkdir -p "$2" 2> /dev/null || return 0
  find "$1" -mindepth 1 -maxdepth 1 -exec mv -n -t "$2" {} + 2> /dev/null
  rmdir "$1" 2> /dev/null
  return 0
}
# merge_old ANTIGA NOVA: o que tem numa pasta de antes (so os arquivos: o
# _info.txt e nosso) vai para a nova, sem sobrescrever nada.
merge_old() {
  [[ -d $1 && ! -L $1 ]] || return 0
  rm -f "$1/_info.txt"
  moveto "$1" "$2"
}
renameto() {
  if [[ -L $1 ]]; then
    [[ -e $2 || -L $2 ]] && return 0
    mv -n "$1" "$2" 2> /dev/null || return 0
    [[ -d ${1%/*}/old-${1##*/} ]] && mv -n "${1%/*}/old-${1##*/}" "${2%/*}/old-${2##*/}" 2> /dev/null
  else
    moveto "$1" "$2"
  fi
  return 0
}
if [[ -d $roms/psx && ! -L $roms/psx ]] && grep -qs DuckStation "$roms/psx/_info.txt"; then
  rm -f "$roms/psx/_info.txt"
  renameto "$roms/psx" "$roms/ps1"
  for dir in "$media"/*/psx; do
    renameto "$dir" "${dir%/psx}/ps1"
  done
fi
if [[ -e $roms/duckstation || -L $roms/duckstation ]]; then
  grep -qs DuckStation "$roms/duckstation/_info.txt" && rm -f "$roms/duckstation/_info.txt"
  renameto "$roms/duckstation" "$roms/ps1"
  for dir in "$media"/*/duckstation; do
    renameto "$dir" "${dir%/duckstation}/ps1"
  done
fi
[[ ! -x ${FLIPEROS_DUCKSTATION_BIN:-/usr/local/bin/duckstation} ]] ||
  folder "$roms/ps1" "DuckStation (PlayStation): .cue/.bin .chd .pbp .m3u .iso. It also lists the games in ~/roms/retroarch/pcsx_rearmed. The BIOS (scph5501.bin...) goes in ~/bios."
# PCSX2x6, o fork do PCSX2 dos arcades Namco System 246, 256 e Super 256: uma
# pasta so, e so ela abre nele (o PCSX2 oficial fica com a ~/roms/ps2). As
# pastas por placa de antes (namco246, namco256) entram nela, sem sobrescrever
# nada, e os caminhos do registro dos pacotes acompanham.
merge_old "$roms/namco246" "$roms/namco2x6"
merge_old "$roms/namco256" "$roms/namco2x6"
[[ ! -f $roms/namco2x6/.fliperos-namco.json ]] ||
  sed -i -E 's#/(roms|save)/namco2(46|56)/#/\1/namco2x6/#g' "$roms/namco2x6/.fliperos-namco.json" 2> /dev/null
folder "$roms/namco2x6" "PCSX2x6: Namco System 246, 256 and Super 256 (Tekken 4 and 5, Soul Calibur II and III, Time Crisis 3 and 4...). A game is a NM00000.acgame text file plus a folder holding its boot.elf and its image, and its dongle in ~/save/namco2x6. The .acgame lines: gameid=NM00000 (the only one required), platform=246, 256 or super256, subdir=the folder, elf=boot.elf, mediasrc=the image, media=CD, DVD or HDD, dongle=the dongle file. The image: a .chd (a MAME CHD works as it is, and is the best copy of a CD game), a .iso of 2048-byte sectors, or the hard disk .img. The dongle is an 8,650,752-byte memory card image named .ps2 (a dongle .bin from the archive.org item or a MAME set, renamed). Or just drop a folder of the archive.org \"Namco System 2X6\" .gz files here and choose the game in the frontend: it extracts what it needs. The arcade BIOS is 256.BIN in ~/bios/namco2x6. More in the wiki: Emulators, Namco System 246 and 256."
folder "$roms/dreamcast" "Flycast: Dreamcast (.gdi .cdi .chd). BIOS in ~/bios/dc."
folder "$roms/naomi" "Flycast: Sega Naomi (MAME .zip sets; a GD-ROM game also needs its CHD folder). BIOS (naomi.zip) in ~/bios/dc."
folder "$roms/naomi2" "Flycast: Sega Naomi 2 (MAME .zip sets). BIOS (naomi2.zip) in ~/bios/dc."
folder "$roms/atomiswave" "Flycast: Sammy Atomiswave (MAME .zip sets). BIOS (awbios.zip) in ~/bios/dc."
folder "$roms/model3" "Supermodel (Sega Model 3): MAME .zip sets."
folder "$roms/dolphin" "Dolphin: GameCube and Wii (.iso .gcm .rvz .wbfs .ciso)."
folder "$roms/openbor/Paks" "OpenBOR: .pak games."
folder "$roms/hypseus" "Hypseus Singe (laserdisc): roms/, vldp/<game>/ and singe/<game>/."
# O Model 2 Emulator (Wine) saiu: o Model 2 e o SM2-Emu. Numa instalacao
# antiga ~/roms/model2 era um link para as ROMs dentro da pasta dele; elas
# vao para uma ~/roms/model2 comum (sem sobrescrever nada), e a pasta do
# emulador sai. Se algum arquivo nao saiu (o mesmo nome ja estava la), a
# pasta do emulador fica, com ele.
old_model2=${FLIPEROS_OLD_MODEL2:-/opt/fliperos/model2}
if [[ -L $roms/model2 && $(readlink -- "$roms/model2") == "$old_model2/roms" ]]; then
  rm -f -- "$roms/model2"
  mkdir -p "$roms/model2" 2> /dev/null &&
    find "$old_model2/roms" -mindepth 1 -maxdepth 1 -exec mv -n -t "$roms/model2" {} + 2> /dev/null
fi
[[ ! -d $old_model2 || -n $(ls -A "$old_model2/roms" 2> /dev/null) ]] || rm -rf -- "$old_model2" 2> /dev/null
[[ -L $config/model2 && $(readlink -- "$config/model2") == "$old_model2" ]] && rm -f -- "$config/model2"
restore "$roms/model2"
folder "$roms/model2" "SM2-Emu (Sega Model 2): MAME .zip sets."
# Fightcade 2 (Setup > Games > Frontend): uma pasta por emulador dele. Os romsets
# sao os que cada um pede, nao os do MAME atual.
folder "$roms/fightcade" "Fightcade 2: one folder per emulator it uses. They work once Fightcade is installed (Setup > Games > Frontend)."
folder "$roms/fightcade/fbneo" "Fightcade 2, FBNeo: arcade .zip sets of FBNeo (romset 0.2.97.44), neogeo.zip included. Console games go in subfolders: megadrive, nes, sms, pce, tg16, msx, coleco, gamegear, sg1000, spectrum..."
folder "$roms/fightcade/flycast" "Fightcade 2, Flycast: Naomi and Atomiswave .zip sets, Dreamcast games (.chd .gdi .cdi)."
folder "$roms/fightcade/snes9x" "Fightcade 2, SNES9x: Super Nintendo games in .zip."
folder "$roms/fightcade/fc1" "Fightcade 1 games (FBA): .zip sets of FB Alpha 0.2.96.74. They do not work in FBNeo, and FBNeo sets do not work here."

# As ROMs do Fightcade sao so do Fightcade: os frontends nao as listam. A
# pasta do core FBNeo do RetroArch ja foi um link para ~/roms/fightcade/fbneo
# (o FliperOS o criava sozinho), e por ele o ES-DE e o Attract-Mode mostravam
# o acervo inteiro do Fightcade. Esse link sai e a pasta volta a ser uma pasta
# comum, vazia; um link que a pessoa fez para outro lugar fica.
fbneo="$roms/retroarch/fbneo"
if [[ -L $fbneo && $(readlink "$fbneo") == ../fightcade/fbneo ]]; then
  rm -f "$fbneo"
fi

# Um core por .info: "core|nome|.ext .ext".
while IFS='|' read -r core name exts; do
  [[ -n $core ]] || continue
  note=""
  # O MAME 2010 e o "MAME 3D": os jogos de arcade baseados no PlayStation.
  [[ $core == mame2010 ]] &&
    note=". This is the MAME 3D: MAME 0.139 sets of the PlayStation-based (PSX) arcade games (ZN-1/ZN-2, Namco System 11/12: Tekken 3, Soul Calibur, Street Fighter EX...)."
  folder "$roms/retroarch/$core" "RetroArch, core ${core}: ${name:-$core}${exts:+ ($exts)}$note"
done < <(awk -F' = ' '
  FNR == 1 {
    if (core != "") print core "|" name "|" ext
    core = FILENAME; sub(/.*\//, "", core); sub(/_libretro\.info$/, "", core); name = ""; ext = ""
  }
  $1 == "display_name" { name = $2; gsub(/"/, "", name) }
  $1 == "supported_extensions" { ext = $2; gsub(/"/, "", ext); if (ext != "") { gsub(/\|/, " .", ext); ext = "." ext } }
  END { if (core != "") print core "|" name "|" ext }' "$info"/*_libretro.info 2> /dev/null)
# ── ~/bios ──────────────────────────────────────────────────────────
# A propria ~/bios e o system_directory do RetroArch (config/retroarch.cfg):
# os arquivos soltos nela, e as subpastas que os cores procuram (dc/ do
# Flycast). O Flycast le a dc (Dreamcast.BiosPath), o GroovyMAME a mame
# (rompath, config/mame.ini) e o PCSX2 a ps2 (a pasta bios dele e um link).
folder "$bios" "BIOS. RetroArch reads the files placed right here (its system folder) and the subfolders its cores use; the other emulators read their own subfolder."
folder "$bios/dc" "Flycast and the RetroArch Flycast core: dc_boot.bin, dc_flash.bin, naomi.zip, naomi2.zip, awbios.zip..."
folder "$bios/ps2" "PCSX2: the PlayStation 2 BIOS (.bin)."
merge_old "$bios/namco246" "$bios/namco2x6"
merge_old "$bios/namco256" "$bios/namco2x6"
folder "$bios/namco2x6" "PCSX2x6: the Namco System 246, 256 and Super 256 arcade BIOS: 256.BIN, with its .nvm and .mec, serves all three boards."
folder "$bios/mame" "GroovyMAME: BIOS and device sets (neogeo.zip, qsound.zip...). They also work from ~/roms/mame."

# link_dir LINK PASTA faz de LINK um link para PASTA. Se LINK era uma pasta,
# o que tem nela vai para PASTA (sem sobrescrever) antes; se sobrar algo,
# ela fica como esta.
link_dir() {
  [[ -L $1 ]] && return 0
  mkdir -p "$2" "$(dirname "$1")" 2> /dev/null || return 0
  if [[ -d $1 ]]; then
    find "$1" -mindepth 1 -maxdepth 1 -exec mv -n -t "$2" {} + 2> /dev/null
    rmdir "$1" 2> /dev/null || return 0
  fi
  ln -s "$2" "$1" 2> /dev/null
  return 0
}
if command -v pcsx2 > /dev/null 2>&1 || [[ -d $HOME/.config/PCSX2 ]]; then
  link_dir "$HOME/.config/PCSX2/bios" "$bios/ps2"
fi
# O Fightcade procura as ROMs dentro da pasta de cada emulador dele: cada
# uma vira um link para ~/roms/fightcade (o que ja estava nela vai junto).
fightcade=${FIGHTCADE_DIR:-/opt/fliperos/fightcade}
if [[ -d $fightcade/emulator ]]; then
  for pair in fbneo:fbneo flycast:flycast snes9x:snes9x ggpofba:fc1; do
    [[ -d $fightcade/emulator/${pair%%:*} ]] && link_dir "$fightcade/emulator/${pair%%:*}/ROMs" "$roms/fightcade/${pair#*:}"
  done
fi

# ── ~/media ─────────────────────────────────────────────────────────
folder "$media" "Art and texts of the frontends, one folder per type and, inside it, the same folders as ~/roms (mame, model2, retroarch/snes9x...): the art of ~/roms/mame/sf2.zip is in <type>/mame. Setup > Games > Scraper saves here; Attract-Mode, ES-DE, Pegasus and the GroovyMAME game list read from here."
folder "$media/snap" "Screenshots (.png), the same folders as ~/roms: snap/mame/sf2.png"
folder "$media/preview" "Videos (.mp4), the same folders as ~/roms: preview/mame/sf2.mp4"
folder "$media/logo" "Logos (wheel art, .png), the same folders as ~/roms: logo/mame/sf2.png"
folder "$media/box" "Box art and flyers (.png), the same folders as ~/roms: box/mame/sf2.png"
folder "$media/marquee" "Marquees (.png), the same folders as ~/roms: marquee/mame/sf2.png"
folder "$media/dmd" "Art for 128x32 LED displays (ZeDMD), .png or animated .gif, the same folders as ~/roms: dmd/mame/sf2.gif. Without it the display shows the marquee, the logo or the game name."
folder "$media/texto" "Game descriptions (.txt), the same folders as ~/roms: texto/mame/sf2.txt"
# Dentro de cada tipo, as pastas de ~/roms que os frontends mostram (a de
# cada emulador e a de cada core): a arte de uma pasta de jogos fica na de
# mesmo nome, e cada uma aceita a custom folder dela (Setup > Games > Folders).
for type in snap preview logo box marquee dmd texto; do
  merge_old "$media/$type/namco246" "$media/$type/namco2x6"
  merge_old "$media/$type/namco256" "$media/$type/namco2x6"
done
for type in snap preview logo box marquee dmd texto; do
  [[ -d $media/$type ]] || continue
  for dir in "$roms"/*/ "$roms"/retroarch/*/; do
    [[ -d $dir ]] || continue
    dir=${dir%/}
    name=${dir#"$roms"/}
    case ${name##*/} in old-* | old[0-9]*-*) continue ;; esac
    case $name in retroarch | fightcade | openbor | hypseus) continue ;; esac
    restore "$media/$type/$name"
    [[ -e $media/$type/$name || -L $media/$type/$name ]] || mkdir -p "$media/$type/$name" 2> /dev/null
  done
done

# ── ~/nvram e ~/save ────────────────────────────────────────────────
# ~/nvram guarda o que os arcades lembram sem a energia (as configuracoes de
# dip, os creditos, os recordes e o que o jogo destravou), uma pasta por
# emulador e por core, e ~/save o que o jogador salva: os saves e os estados
# do RetroArch, os estados do MAME e os cartoes de memoria do PCSX2. As pastas
# de antes (~/.mame/nvram, ~/.mame/sta, /opt/fliperos/saves/retroarch,
# ~/.config/PCSX2/memcards) viram links para as novas, com o que tinham dentro,
# e os caminhos antigos (mame.ini, retroarch.cfg, Pixelcade, MAME 2010)
# continuam valendo. Cada emulador continua gravando no caminho dele, que vira
# um link para a pasta dele aqui.
nvram=${FLIPEROS_NVRAM:-$HOME/nvram}
save=${FLIPEROS_SAVE:-$HOME/save}
mame_home=${FLIPEROS_MAME_HOME:-$HOME/.mame}
saves_old=${FLIPEROS_SAVES_OLD:-/opt/fliperos/saves}
data=${XDG_DATA_HOME:-$HOME/.local/share}
# ~/nvram era so do MAME, com um conjunto por pasta na raiz: eles vao para
# ~/nvram/mame, sem sobrescrever. A barra faz o find entrar numa custom folder.
if [[ -d $nvram && ! -e $nvram/mame ]]; then
  rm -f "$nvram/_info.txt"
  mkdir -p "$nvram/mame" 2> /dev/null &&
    find "$nvram/" -mindepth 1 -maxdepth 1 -type d ! -name mame ! -name flycast ! -name model2 ! -name model3 \
      ! -name hypseus ! -name retroarch ! -name fightcade ! -name 'namco2*' ! -name '.*' ! -name 'old-*' ! -name 'old[0-9]*-*' \
      -exec mv -n -t "$nvram/mame" {} + 2> /dev/null
fi
[[ -L $mame_home/nvram && $(readlink -- "$mame_home/nvram") == "$nvram" ]] && rm -f -- "$mame_home/nvram"
folder "$nvram" "Arcade memory kept without power (dip settings, credits, scores, what a game has unlocked): one folder per emulator and RetroArch core, as in ~/roms."
folder "$nvram/mame" "GroovyMAME: one folder per game set. To start a game from zero, delete its folder."
folder "$nvram/flycast" "Flycast: Naomi and Atomiswave memory (<set>.zip.nvmem, .nvmem2, .eeprom) and the Dreamcast memory cards (vmu_save_*.bin)."
folder "$nvram/model2" "SM2-Emu (Sega Model 2): the NVRAM and EEPROM of each game, and its save states in states/."
merge_old "$nvram/namco246" "$nvram/namco2x6"
merge_old "$nvram/namco256" "$nvram/namco2x6"
folder "$nvram/namco2x6" "PCSX2x6, Namco System 246/256: the memory of each game (32 KB, NM00000.bin: settings, credits, scores). To start a game from zero, delete its file."
folder "$nvram/model3" "Supermodel (Sega Model 3): one <set>.nv per game."
folder "$nvram/hypseus" "Hypseus Singe (laserdisc): the memory of each game."
folder "$nvram/fightcade" "Fightcade 2: one folder per emulator that keeps arcade memory here."
folder "$nvram/fightcade/flycast" "Fightcade 2, Flycast Dojo: the memory its package brings for each game (the .net files are the ones used online). Separate from ~/nvram/flycast."
folder "$nvram/retroarch" "RetroArch: one folder per core that keeps arcade memory. Other MAME cores get theirs at the login after their first game."
folder "$nvram/retroarch/mame2010" "RetroArch, core mame2010: one <set>.nv per game."
folder "$nvram/retroarch/fbneo" "RetroArch, core fbneo: the memory of its games."
folder "$save" "What you save while you play, one folder per emulator: RetroArch saves and states, MAME states, PlayStation 2 memory cards."
folder "$save/retroarch" "RetroArch: the game saves (.srm) and the save states (.state), also the MAME 2010 settings."
folder "$save/mame" "GroovyMAME: the save states (F7 saves, F8 loads), one folder per game set."
folder "$save/ps2" "PCSX2: the memory cards (.ps2) and their folders."
merge_old "$save/namco246" "$save/namco2x6"
merge_old "$save/namco256" "$save/namco2x6"
folder "$save/namco2x6" "PCSX2x6, Namco System 246/256: the dongle of each game (NM00000.ps2, a memory card image; the game rewrites it, so keep an original copy: the frontend leaves one in originals/) and the save cards some games use (card= in the .acgame)."
link_dir "$mame_home/nvram" "$nvram/mame"
link_dir "$mame_home/sta" "$save/mame"
[[ -d $saves_old/retroarch ]] && link_dir "$saves_old/retroarch" "$save/retroarch"
if command -v pcsx2 > /dev/null 2>&1 || [[ -d $HOME/.config/PCSX2 ]]; then
  link_dir "$HOME/.config/PCSX2/memcards" "$save/ps2"
fi
link_dir "$data/flycast" "$nvram/flycast"
link_dir "$data/sm2-emu/saves" "$nvram/model2"
link_dir "$data/supermodel/NVRAM" "$nvram/model3"
link_dir "$roms/hypseus/ram" "$nvram/hypseus"
[[ -d $fightcade/emulator/flycast/data ]] && link_dir "$fightcade/emulator/flycast/data" "$nvram/fightcade/flycast"
# Os cores gravam no savefile_directory, numa pasta com o nome que o proprio
# core da a si mesmo (MAME 2010, nao o "MAME 2010 (0.139)" do .info).
link_dir "$save/retroarch/MAME 2010/mame2010/nvram" "$nvram/retroarch/mame2010"
link_dir "$save/retroarch/FinalBurn Neo/fbneo" "$nvram/retroarch/fbneo"
# Os outros da familia do MAME criam <nome>/<core>/nvram ao abrir o primeiro
# jogo: a pasta do core nasce no login seguinte, com o que ele ja gravou.
for dir in "$save"/retroarch/*/*/nvram; do
  [[ -d $dir && ! -L $dir ]] || continue
  core=${dir%/nvram}
  core=${core##*/}
  core=${core//-/_}
  folder "$nvram/retroarch/$core" "RetroArch, core $core: one <set>.nv per game."
  link_dir "$dir" "$nvram/retroarch/$core"
done
# A memoria que vem na imagem (config/nvram/SOURCES.md), com o que os jogos
# destravam ja destravado. Cada jogo vem uma vez so, e so se a pasta ainda nao
# tem a dele: o que a pessoa jogou fica, e os arquivos de um jogo nao se
# misturam com os de outra origem. O .bundled anota os jogos ja vistos, entao
# um apagado para comecar do zero nao volta; um que uma versao nova da imagem
# trouxer entra no login seguinte.
nvram_bundled=${FLIPEROS_NVRAM_BUNDLED:-/usr/share/fliperos/nvram}
for emu in mame flycast; do
  [[ -d $nvram_bundled/$emu && -d $nvram/$emu ]] || continue
  seen=$nvram/$emu/.bundled
  for item in "$nvram_bundled/$emu"/*; do
    [[ -e $item ]] || continue
    game=${item##*/}
    # No MAME um jogo e uma pasta; no Flycast, os arquivos <set>.zip.*.
    [[ $emu == mame ]] || game=${game%.*}
    grep -qxF -- "$game" "$seen" 2> /dev/null && continue
    if [[ $emu == mame ]]; then
      [[ -e $nvram/$emu/$game ]] || cp -r -- "$item" "$nvram/$emu/" 2> /dev/null
    elif ! compgen -G "$nvram/$emu/$game.*" > /dev/null; then
      cp -- "$nvram_bundled/$emu/$game".* "$nvram/$emu/" 2> /dev/null
    fi
    printf '%s\n' "$game" >> "$seen" 2> /dev/null
  done
done

# ── ~/splashscreen ──────────────────────────────────────────────────
# Os temas do Plymouth, um por pasta. Os da imagem entram se faltam (um
# apagado volta) e acompanham as versoes novas da imagem enquanto ninguem
# mexer neles: o .bundled guarda a soma da copia; um mudado aqui fica como a
# pessoa deixou.
splash_bundled=${FLIPEROS_SPLASH_BUNDLED:-/usr/share/fliperos/splashscreen}
folder "$splash" "Boot splash themes (Plymouth), one folder per theme with its .plymouth file. Setup > System > Splash screen shows a preview and sets the one used at boot. To change a bundled theme, copy its folder with a new name: the bundled ones come back as they were. More themes: https://www.gnome-look.org/browse?cat=108&ord=latest"
splash_sum() { (cd "$1" && find . -type f ! -name .bundled -exec cksum {} + | sort | cksum); }
for theme in "$splash_bundled"/*/; do
  [[ -d $theme ]] || continue
  dest=$splash/$(basename "$theme")
  if [[ -e $dest ]]; then
    [[ -f $dest/.bundled ]] || continue
    sum=$(splash_sum "$dest")
    [[ $(< "$dest/.bundled") == "$sum" && $sum != "$(splash_sum "$theme")" ]] || continue
    rm -rf "$dest"
  fi
  cp -r "${theme%/}" "$splash/" 2> /dev/null && splash_sum "$dest" > "$dest/.bundled"
done

# ── ~/config ────────────────────────────────────────────────────────
folder "$config" "Shortcuts to the settings of each installed emulator and frontend. They appear at login once the program has created its settings; a deleted one comes back."
# cfglink NOME ALVO: o link, se o ALVO existe; um link nosso que ficou sem
# alvo (o programa saiu) vai embora.
cfglink() {
  local link="$config/$1"
  if [[ -e $2 ]]; then
    [[ -e $link || -L $link ]] || ln -s "$2" "$link" 2> /dev/null
  elif [[ -L $link && ! -e $link ]]; then
    rm -f "$link"
  fi
  return 0
}
cfglink retroarch "$HOME/.config/retroarch"
cfglink groovymame "$etc/mame"
cfglink flycast "$HOME/.config/flycast"
cfglink pcsx2 "$HOME/.config/PCSX2"
cfglink pcsx2x6 "$HOME/.config/PCSX2x6"
cfglink dolphin "$HOME/.config/dolphin-emu"
cfglink supermodel "$HOME/.config/supermodel"
cfglink openbor "$roms/openbor/Saves"
cfglink hypseus "$HOME/.hypseus"
cfglink model2 "$HOME/.config/sm2-emu"
cfglink attractmode "$HOME/.attract"
cfglink es-de "$HOME/ES-DE"
cfglink pegasus "$HOME/.config/pegasus-frontend"
cfglink skyscraper "$HOME/.skyscraper"
# Hook Of The Reaper: as configuracoes, os arquivos de jogo e os .ini do
# MAMEHooker (config/fliperos-outputs).
cfglink hotr "$HOME/hotr"
# QMamehook: os .ini dos jogos.
cfglink qmamehook "$HOME/qmamehook"
exit 0
