[Unit]
Description=FliperOS: light gun Start and Select as the player's keys in games
# Sem /dev/uinput nao ha o que fazer: depois de 5 falhas em 1 minuto, para.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStartPre=-/sbin/modprobe uinput
ExecStart=/usr/bin/python3 /opt/fliperos/bin/fliperos-gunkeys
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
