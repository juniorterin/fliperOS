#!/usr/bin/env bash
# Sessao LXDE no monitor do gabinete: o .xinitrc do GroovyArcade (sem descanso
# de tela, sem DPMS) mais a orientacao escolhida no Video Setup.
xset -dpms
xset s off
xset s noblank
xsetroot -cursor_name left_ptr

# O Alacritty (winit) calcula a escala pelo tamanho em mm que o EDID informa;
# num CRT de 15 kHz isso da 50 DPI ou menos e letra pela metade.
export WINIT_X11_SCALE_FACTOR=1
# Mapeamentos de controle do SDL (AntiMicroX): fliperos-rootfs.sh.
export SDL_GAMECONTROLLERCONFIG_FILE=${SDL_GAMECONTROLLERCONFIG_FILE:-/var/lib/fliperos/gamecontrollerdb.txt}

orientation=$(sed -n 's/^orientation=//p' /etc/fliperos/fliperos.conf 2> /dev/null)
case $orientation in
  vertical-cw) xrandr -o right ;;
  vertical-ccw) xrandr -o left ;;
esac

# Resolucao guardada pelo Screen Resolution (fliperos-resolution).
/opt/fliperos/bin/fliperos-resolution --apply-saved > /dev/null 2>&1
# A tabela de gama da calibracao de cor (Setup > Video Setup > Colour
# calibration): o Xorg abre com a dele, linear.
[[ -x /usr/local/bin/fliperos-color ]] && /usr/local/bin/fliperos-color x11 > /dev/null 2>&1

# Janela maior que a tela: o desktop cresce e rola com o mouse na borda
# (config/fliperos-panning). Sai junto com o X.
/opt/fliperos/bin/fliperos-panning < /dev/null > /dev/null 2>&1 &
# O filtro de flicker do 480i no desktop (o picom com o shader), so com o
# modo entrelacado, acompanhando o Screen Resolution. Sai junto com o X.
# O picom.desktop do pacote, no autostart do Ubuntu, subia antes sem o
# shader e ficava com a tela (so um compositor por vez): o do
# /etc/fliperos/xdg/autostart, com Hidden=true, vem primeiro e o esconde.
export XDG_CONFIG_DIRS=/etc/fliperos/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}
/opt/fliperos/bin/fliperos-desktop-deflicker --watch < /dev/null > /dev/null 2>&1 &

# Servicos do systemd --user e do D-Bus (o blueman-applet que o blueman-manager
# chama quando ha um adaptador Bluetooth) nao herdam o DISPLAY deste X: sem ele
# o applet cai e o gerenciador fecha junto.
if command -v systemctl > /dev/null; then
  vars=()
  for name in DISPLAY XAUTHORITY; do [[ -n ${!name:-} ]] && vars+=("$name"); done
  if ((${#vars[@]})); then
    systemctl --user import-environment "${vars[@]}" > /dev/null 2>&1
    dbus-update-activation-environment "${vars[@]}" > /dev/null 2>&1
  fi
fi

exec startlxde
