# Perifericos de gabinete: light gun e volantes.

# GunCon 2 (Namco, USB 0b9a:016a). A calibracao nao persiste no dispositivo e
# se perde a cada reconexao, entao e reaplicada aqui — e o mesmo contorno que
# o README do driver sugere. Os valores ficam em /etc/fliperos/guncon2.conf.
SUBSYSTEM=="input", ATTRS{idVendor}=="0b9a", ATTRS{idProduct}=="016a", \
  ACTION=="add", ENV{DEVNAME}!="", \
  RUN+="/usr/local/bin/fliperos-guncon2-calibrate %E{DEVNAME}"
# Marcada como pistola (ID_INPUT_GUN, a marca das regras de light gun do
# Batocera): sem ela o udev a ve so como mouse, e o SM2-Emu le a mira pelo
# ponteiro do X, que pula para o canto a cada quadro em que a arma nao ve o
# feixe (tiro vira reload). Em todo evento, nao so no add: um change sem a
# marca a apagaria.
SUBSYSTEM=="input", ATTRS{idVendor}=="0b9a", ATTRS{idProduct}=="016a", \
  ENV{ID_INPUT_GUN}="1"
# Duas pistolas: o X junta os mouses num ponteiro so, de onde o GroovyMAME, o
# Supermodel e o Flycast leem a mira, entao so a primeira (a do jogador 1,
# config/fliperos-lightgun) fica no X; a do jogador 2 puxaria a mira dele.
# Quando uma chega ou sai, as outras sao reavaliadas.
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_GUN}=="1", \
  IMPORT{program}="/opt/fliperos/bin/fliperos-lightgun udev-x %S%p"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_GUN}=="1", ACTION=="add|remove", \
  RUN+="/opt/fliperos/bin/fliperos-lightgun udev-retrigger %S%p"

# Controle ligado: o fliperos-controllers completa o mapeamento automatico do
# SDL (botoes que sobram, direcional digital mandado como eixos).
SUBSYSTEM=="input", KERNEL=="event*", ACTION=="add", ENV{ID_INPUT_JOYSTICK}=="1", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}+="fliperos-controllers.service"
# Controle tirado: os controles Bluetooth do Button mapping tomam os
# jogadores de novo pela ordem de conexao (o fliperos-controllers chama o
# fliperos-buttons save). O SYSTEMD_WANTS so vale no add.
SUBSYSTEM=="input", KERNEL=="event*", ACTION=="remove", ENV{ID_INPUT_JOYSTICK}=="1", \
  RUN+="/bin/systemctl --no-block restart fliperos-controllers.service"

# Volantes, pedais e analogicos calibrados em Setup > Joysticks
# (fliperos-calibrate): o evdev tambem esquece essa calibracao a cada conexao.
SUBSYSTEM=="input", KERNEL=="event*", ACTION=="add", ENV{ID_INPUT_JOYSTICK}=="1", \
  RUN+="/opt/fliperos/bin/fliperos-calibrate apply $env{DEVNAME}"

# Volantes: acesso ao no de event sem precisar de root, pro emulador que abre
# /dev/input/event* direto em vez de passar pelo SDL.
# Logitech: G25, G27, G29, Driving Force GT, Momo, G920.
SUBSYSTEM=="input", ATTRS{idVendor}=="046d", \
  ATTRS{idProduct}=="c294|c295|c298|c299|c29a|c29b|c24f|c260|c262", \
  MODE="0660", GROUP="input"
# Thrustmaster: T150, T300, TX, T248, TMX e o modo inicial "bootloader" que
# alguns expoem antes do hid-tminit chavear pro modo real.
SUBSYSTEM=="input", ATTRS{idVendor}=="044f", MODE="0660", GROUP="input"
