        shot = x11_capture()
        if shot:
            return png(*shot), "x11"
    user = pwd.getpwnam(PLAYER)
    runtime = os.path.join(RUN_USER, str(user.pw_uid))
    request = os.path.join(runtime, "fliperos-shot-request")
    out = os.path.join(runtime, "fliperos-shot.ppm")
    try:
        os.unlink(out)
    except OSError:
        pass
    with open(request, "w"):
        pass
    os.chown(request, user.pw_uid, user.pw_gid)
    end = time.monotonic() + 3
    while time.monotonic() < end:
        if os.path.exists(out) and not os.path.exists(request):
