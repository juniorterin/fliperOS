WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"


class WebSocket:
    """O minimo do RFC 6455 para o terminal: quadros de texto, binarios,
    ping/pong e fechamento, sem extensoes."""

    def __init__(self, rfile, wfile):
        self.rfile, self.wfile = rfile, wfile
        self.lock = threading.Lock()

    def send(self, opcode, data=b""):
        size = len(data)
        head = bytes([0x80 | opcode])
        if size < 126:
            head += bytes([size])
        elif size < 1 << 16:
            head += bytes([126]) + struct.pack(">H", size)
        else:
            head += bytes([127]) + struct.pack(">Q", size)
        with self.lock:
            self.wfile.write(head + data)
            self.wfile.flush()

    def _read(self, n):
        data = self.rfile.read(n)
        if len(data) < n:
            raise EOFError
        return data

    def receive(self):
        """(opcode, dados) de uma mensagem inteira (junta os pedacos)."""
        message, first = b"", None
        while True:
            b0, b1 = self._read(2)
            opcode, size = b0 & 0x0F, b1 & 0x7F
            if size == 126:
                size = struct.unpack(">H", self._read(2))[0]
            elif size == 127:
                size = struct.unpack(">Q", self._read(8))[0]
            if size > 1 << 20:
                raise EOFError
            mask = self._read(4) if b1 & 0x80 else b"\0\0\0\0"
            data = bytes(c ^ mask[i % 4] for i, c in enumerate(self._read(size)))
            if opcode >= 8:
                # Controle no meio de uma mensagem: responde e segue.
                if opcode == 9:
                    self.send(10, data)
                if opcode == 8:
                    return 8, data
                continue
            if first is None:
                first = opcode
            message += data
            if b0 & 0x80:
                return first, message


def terminal(ws):
    """Um shell de login do usuario do FliperOS num pty (o zsh dele; o
    .zprofile so abre o fluxo do tty1 no /dev/tty1). Do navegador: binario =
    teclas, texto = {"resize": [colunas, linhas]}."""
    user = pwd.getpwnam(PLAYER)
    shell = user.pw_shell if os.path.exists(user.pw_shell or "") else "/bin/bash"
    env = {"HOME": user.pw_dir, "USER": user.pw_name, "LOGNAME": user.pw_name, "SHELL": shell,
           "TERM": "xterm-256color", "LANG": ENV("LANG", "C.UTF-8"), "COLORTERM": "truecolor",
           "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
           "XDG_RUNTIME_DIR": os.path.join(RUN_USER, str(user.pw_uid))}
    # O subprocess troca de usuario no proprio C (um fork num servidor com
    # threads nao pode chamar o NSS do initgroups); o setsid -c faz do pty o
    # terminal do shell (Ctrl+C, job control); o shell de login le o
    # .zprofile, que so abre o fluxo do tty1 no /dev/tty1.
    fd, slave = os.openpty()
    try:
        child = subprocess.Popen(["setsid", "-c", shell, "-l"], stdin=slave, stdout=slave, stderr=slave,
                                 cwd=user.pw_dir, env=env, user=user.pw_uid, group=user.pw_gid,
                                 extra_groups=os.getgrouplist(user.pw_name, user.pw_gid))
    finally:
        os.close(slave)
    pid = child.pid
    # Sem o Nice=15 do servico: o shell e de quem esta mexendo (os filhos
    # dele herdam).
    try:
        os.setpriority(os.PRIO_PROCESS, pid, 0)
    except OSError:
        pass

    def pump():
        try:
            while True:
                data = os.read(fd, 65536)
                if not data:
                    break
                ws.send(2, data)
        except OSError:
            pass
        try:
            ws.send(8, struct.pack(">H", 1000))
        except OSError:
            pass

    reader = threading.Thread(target=pump, daemon=True)
    reader.start()
    try:
        while True:
            opcode, data = ws.receive()
            if opcode == 8:
                break
            if opcode == 2:
                os.write(fd, data)
            elif opcode == 1:
                try:
                    msg = json.loads(data.decode())
                    cols, rows = (int(v) for v in msg.get("resize", [0, 0]))
                except (ValueError, TypeError, AttributeError):
                    continue
                if 0 < cols < 1000 and 0 < rows < 1000:
                    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
    except (EOFError, OSError):
        pass
    finally:
        # O SIGHUP vai ao grupo do shell (o setsid o fez lider de sessao).
        try:
            os.killpg(pid, signal.SIGHUP)
        except OSError:
            pass
        try:
            child.wait(timeout=5)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()
        os.close(fd)


# ── O trackball de toque (fase 5b): um mouse virtual no uinput ─────

class VirtualMouse:
    """Um mouse comum (X, Y, roda, tres botoes) no /dev/uinput, criado na
    primeira vez e mantido enquanto o painel roda: os emuladores (o
    trackball e o spinner do MAME), os frontends e o desktop o leem como um
    mouse USB."""

    UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_RELBIT, UI_DEV_CREATE = 0x40045564, 0x40045565, 0x40045566, 0x5501
    EV_SYN, EV_KEY, EV_REL = 0, 1, 2
    REL_X, REL_Y, REL_WHEEL = 0, 1, 8
    BUTTONS = {"left": 0x110, "right": 0x111, "middle": 0x112}

    def __init__(self, path=None):
        self.path = path or ENV("FLIPEROS_UINPUT", "/dev/uinput")
        self.fd = None
        self.lock = threading.Lock()

    def open(self):
        if self.fd is not None:
            return
        fd = os.open(self.path, os.O_WRONLY | os.O_NONBLOCK)
        try:
            for bit in (self.EV_KEY, self.EV_REL, self.EV_SYN):
                fcntl.ioctl(fd, self.UI_SET_EVBIT, bit)
            for code in (self.REL_X, self.REL_Y, self.REL_WHEEL):
                fcntl.ioctl(fd, self.UI_SET_RELBIT, code)
            for code in self.BUTTONS.values():
                fcntl.ioctl(fd, self.UI_SET_KEYBIT, code)
            # struct uinput_user_dev: o nome, o id (USB) e as faixas dos eixos
            # absolutos (nenhum).
            dev = struct.pack("80sHHHHi", b"FliperOS web trackball", 0x03, 0x1209, 0xF110, 1, 0) + b"\0" * (4 * 64 * 4)
            os.write(fd, dev)
            fcntl.ioctl(fd, self.UI_DEV_CREATE)
        except OSError:
            os.close(fd)
            raise
        self.fd = fd

    def emit(self, events):
        """Os eventos (tipo, codigo, valor) e o SYN no fim."""
        now = time.time()
        sec, usec = int(now), int((now % 1) * 1e6)
        data = b"".join(struct.pack("llHHi", sec, usec, t, c, v) for t, c, v in events)
        data += struct.pack("llHHi", sec, usec, self.EV_SYN, 0, 0)
        with self.lock:
            self.open()
            os.write(self.fd, data)

    def move(self, dx, dy, wheel=0):
        events = [(self.EV_REL, self.REL_X, dx)] if dx else []
        if dy:
            events.append((self.EV_REL, self.REL_Y, dy))
        if wheel:
            events.append((self.EV_REL, self.REL_WHEEL, wheel))
        if events:
            self.emit(events)

    def button(self, name, down):
        if name in self.BUTTONS:
            self.emit([(self.EV_KEY, self.BUTTONS[name], 1 if down else 0)])


def trackball(ws, mouse):
    """Do navegador, texto JSON: {"m": [dx, dy]} (com "w": roda) e
    {"b": ["left"|"right"|"middle", 1|0]}. Os botoes apertados soltam quando
    a conexao cai (nao fica um clique preso)."""
    held = set()
    try:
        while True:
            opcode, data = ws.receive()
            if opcode == 8:
                break
            if opcode != 1:
                continue
            try:
                msg = json.loads(data.decode())
            except ValueError:
                continue
            if not isinstance(msg, dict):
                continue
            if "m" in msg:
                try:
                    dx, dy = (max(-2000, min(2000, int(v))) for v in msg["m"])
                    wheel = max(-50, min(50, int(msg.get("w", 0))))
                except (TypeError, ValueError):
                    continue
                mouse.move(dx, dy, wheel)
            if "b" in msg:
                try:
                    name, down = msg["b"][0], bool(msg["b"][1])
                except (TypeError, IndexError, KeyError):
                    continue
                if name in mouse.BUTTONS:
                    mouse.button(name, down)
                    (held.add if down else held.discard)(name)
    except (EOFError, OSError):
        pass
    finally:
        for name in held:
            try:
                mouse.button(name, False)
            except OSError:
                pass


