    def do_POST(self):
        url = urlparse(self.path)
        if self.headers.get("X-FliperOS") != "1":
            return self.send(403, {"error": "missing X-FliperOS header"})
        ip = self.client_address[0]
        # A tela ao vivo para o OBS (/overlay/live): a oferta pela chave do
        # endereco, sem login, como os dados do marquee.
        if url.path == "/api/overlay/offer":
            if not overlay_allowed(parse_qs(url.query)):
                return self.send(403, {"error": "wrong or missing key"})
            return self.stream_offer(self.body())
        if url.path == "/api/login":
            if self.panel.sessions.blocked(ip):
                return self.send(429, {"error": "too many attempts, wait a minute"})
            data = self.body()
            user, password = str(data.get("user", "")), str(data.get("password", ""))
            if not check_password(user, password):
                self.panel.sessions.failed(ip)
                return self.send(401, {"error": "wrong user or password"})
            token = self.panel.sessions.create(user)
            cookie = "fliperos_session=%s; HttpOnly; SameSite=Strict; Path=/; Max-Age=%d" % (
                token, SESSION_HOURS * 3600)
            return self.send(200, {"user": user}, headers={"Set-Cookie": cookie})
        user = self.panel.sessions.user(self.token())
        if not user:
            return self.send(401, {"error": "login"})
        if url.path == "/api/logout":
            self.panel.sessions.drop(self.token())
            return self.send(200, {}, headers={"Set-Cookie": "fliperos_session=; Path=/; Max-Age=0"})
        if url.path == "/api/volume":
            data = self.body()
            if data.get("action") in ("up", "down", "mute"):
                args = [data["action"]]
            elif isinstance(data.get("set"), int) and 0 <= data["set"] <= 100:
                args = ["set", str(data["set"])]
            else:
                return self.send(400, {"error": "action up|down|mute or set 0..100"})
            try:
                subprocess.run([SETUP, "--volume", *args], capture_output=True, timeout=15)
            except (OSError, subprocess.SubprocessError) as exc:
                return self.send(500, {"error": str(exc)})
            self.panel.volume.when = None
            return self.send(200, self.panel.volume.get())
        if url.path == "/api/launch":
            data = self.body()
            system = self.panel.system(str(data.get("system", "")))
            argv = game_command(system, str(data.get("game", ""))) if system else None
            if not argv:
                return self.send(400, {"error": "no such game, or this system does not open from the panel"})
            return self.send(200, self.panel.launch(argv))
        if url.path == "/api/favourite":
            data = self.body()
            system = self.panel.system(str(data.get("system", "")))
            entry = game_entry(system, str(data.get("game", ""))) if system else None
            if not entry or not isinstance(data.get("on"), bool):
                return self.send(400, {"error": "no such game, or no on: true|false"})
            try:
                on = set_favourite(self.panel.systems.get(), system, entry["Name"], data["on"])
            except OSError as exc:
                return self.send(500, {"error": str(exc)})
            return self.send(200, {"game": entry["Name"], "favourite": on})
        if url.path == "/api/close":
            return self.send(200, self.panel.close_game())
        if url.path == "/api/upload":
            return self.upload(parse_qs(url.query))
        if url.path == "/api/task/cancel":
            data = self.body()
            task = self.panel.tasks.get(data.get("id") if isinstance(data.get("id"), int) else -1)
            if not task:
                return self.send(404, {"error": "no such task"})
            task.cancel()
            return self.send(200, task.info())
        if url.path == "/api/downloader":
            return self.downloader_action(self.body())
        if url.path.startswith("/api/romfilter/"):
            return self.romfilter_action(url.path.rsplit("/", 1)[1], self.body())
        if url.path == "/api/stream/offer":
            return self.stream_offer(self.body())
        if url.path == "/api/stream/install":
            task = self.panel.tasks.start("Install the live screen (go2rtc + ffmpeg)",
                                          [EXTRAS, "install", "stream", "--progress"], "extras")
            if not task:
                return self.send(409, {"error": "another installation is running"})
            self.panel.stream.when = None
            return self.send(200, task.info())
        if url.path == "/api/overlay":
            if self.body().get("action") != "newkey":
                return self.send(400, {"error": "action newkey"})
            return self.send(200, overlay_paths(overlay_key(new=True)))
        if url.path == "/api/overlay/input/style":
            data = self.body()
            css = None if data.get("reset") is True else data.get("css")
            # Sem "css" nem "reset" (um corpo grande demais chega cortado): nada muda.
            if (css is None and data.get("reset") is not True) or (
                    css is not None and (not isinstance(css, str) or len(css.encode()) > INPUT_CSS_MAX)):
                return self.send(400, {"error": "css: text up to %d bytes" % INPUT_CSS_MAX})
            try:
                save_input_css(css)
            except OSError as exc:
                return self.send(500, {"error": str(exc)})
            self.panel.input.css_changed()
            return self.send(200, {"css": input_css(), "custom": os.path.isfile(INPUT_CSS)})
        if url.path == "/api/settings":
            data = self.body()
            key, value = str(data.get("key", "")), str(data.get("value", ""))
            if not re.fullmatch(r"[a-z0-9_.-]{1,64}", key) or not re.fullmatch(r"[A-Za-z0-9_.-]{0,64}", value):
                return self.send(400, {"error": "bad key or value"})
            try:
                done = subprocess.run([SETUP, "--setting", key, value], capture_output=True, text=True, timeout=120)
            except (OSError, subprocess.SubprocessError) as exc:
                return self.send(500, {"error": str(exc)})
            if done.returncode == 2:
                return self.send(400, {"error": "no such setting or value"})
            if done.returncode != 0:
                return self.send(500, {"error": (done.stderr or done.stdout).strip()[-300:] or "failed"})
            # O que depende disso (o volume do nivelador, o estado do que esta na tela).
            self.panel.volume.when = None
            row = next((s for s in settings() if s["key"] == key), None)
            return self.send(200, {"setting": row})
        if url.path in ("/api/mkdir", "/api/delete"):
            data = self.body()
            path = file_path(str(data.get("root", "")), str(data.get("path", "")))
            if not path:
                return self.send(400, {"error": "bad path"})
            if url.path == "/api/mkdir":
                name = str(data.get("name", ""))
                if not valid_name(name) or not os.path.isdir(path):
                    return self.send(400, {"error": "bad folder name"})
                try:
                    os.mkdir(os.path.join(path, name))
                except FileExistsError:
                    return self.send(409, {"error": "already exists"})
                give_to_player(os.path.join(path, name))
                return self.send(200, {})
            # Apagar: um arquivo, ou uma pasta vazia; nunca a pasta de cima.
            if not str(data.get("path", "")).strip("/"):
                return self.send(400, {"error": "the top folder is not deleted"})
            try:
                if os.path.isdir(path) and not os.path.islink(path):
                    os.rmdir(path)
                else:
                    os.unlink(path)
            except FileNotFoundError:
                return self.send(404, {"error": "no such file"})
            except OSError as exc:
                return self.send(409, {"error": "folder not empty" if os.path.isdir(path) else str(exc)})
            return self.send(200, {})
        return self.send(404, {"error": "not found"})

    def websocket(self):
        """Aceita o WebSocket (o terminal, o trackball) ou responde o erro e
        devolve None. So da propria pagina: o Origin tem de ser este
        endereco (outro site com o cookie no navegador nao abre)."""
        origin = urlparse(self.headers.get("Origin", "")).netloc
        key = self.headers.get("Sec-WebSocket-Key", "")
        if self.headers.get("Upgrade", "").lower() != "websocket" or not key:
            self.send(400, {"error": "websocket only"})
            return None
        if origin != self.headers.get("Host", ""):
            self.send(403, {"error": "wrong origin"})
            return None
        accept = base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()
        # O 101 tem de ser HTTP/1.1 (o Chrome recusa um HTTP/1.0 101).
        self.protocol_version = "HTTP/1.1"
        self.send_response(101)
        self.send_header("Upgrade", "websocket")
        self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", accept)
        self.end_headers()
        self.wfile.flush()
        self.close_connection = True
        return WebSocket(self.rfile, self.wfile)

    def open_terminal(self):
        ws = self.websocket()
        if ws:
            terminal(ws)

    def open_trackball(self):
        # Desligado por enquanto: so com FLIPEROS_WEB_TRACKBALL=1 (nenhum
        # mouse virtual aparece no gabinete sem isso).
        if ENV("FLIPEROS_WEB_TRACKBALL", "0") != "1":
            return self.send(404, {"error": "the trackball is turned off"})
        # O mouse antes do 101: sem /dev/uinput, um erro que a pagina mostra.
        try:
            self.panel.mouse.open()
        except OSError as exc:
            return self.send(503, {"error": "no virtual mouse: %s" % exc})
        ws = self.websocket()
        if ws:
            trackball(ws, self.panel.mouse)

    def downloader_action(self, data):
        """O Downloader do Setup (Setup > Games > Downloader) pelas mesmas
        funcoes dele: cadastrar o link (add) e aplicar o filtro (start), como
        tarefas; remover um link, na hora."""
        action, kind = data.get("action"), data.get("kind")
        if action == "add" and kind in ("roms", "chds"):
            magnet = str(data.get("magnet") or "").strip()
            if not magnet:
                magnet = self.panel.downloader.get().get("default_" + kind, "")
            if not magnet.startswith("magnet:?"):
                return self.send(400, {"error": "a magnet link (magnet:?...) is needed"})
            task = self.panel.tasks.start("Downloader: %s link" % ("ROM" if kind == "roms" else "CHD"),
                                          [SETUP, "--downloader", "add", kind, magnet], "downloader")
        elif action == "start":
            task = self.panel.tasks.start("Downloader: apply the filter and start",
                                          [SETUP, "--downloader", "start"], "downloader")
        elif action == "remove" and kind in ("roms", "chds"):
            args = [SETUP, "--downloader", "remove", kind] + (["--delete-files"] if data.get("delete") else [])
            try:
                subprocess.run(args, capture_output=True, timeout=120)
            except (OSError, subprocess.SubprocessError) as exc:
                return self.send(500, {"error": str(exc)})
            self.panel.downloader.when = None
            return self.send(200, self.panel.downloader.get())
        else:
            return self.send(400, {"error": "action add (kind roms|chds, magnet), start, or remove (kind)"})
        if not task:
            return self.send(409, {"error": "the downloader is already busy with another task"})
        self.panel.downloader.when = None
        return self.send(200, task.info())

    def stream_offer(self, data):
        """A oferta WebRTC do navegador (o painel ou o OBS) para o go2rtc."""
        fps, offer = data.get("fps"), data.get("sdp")
        if fps not in STREAM_RATES or not isinstance(offer, str) or not offer.startswith("v=0"):
            return self.send(400, {"error": "fps 15, 30 or 60 and an SDP offer"})
        if not self.panel.stream.get().get("active"):
            return self.send(409, {"error": "the live screen is not running (Setup > System > Services)"})
        # O go2rtc so responde quando a captura manda o primeiro quadro, ou
        # desiste depois de uns 20 s. Enquanto isso, a cada segundo, o erro
        # da captura (se ela nao consegue ler a tela) responde na hora.
        result, since = {}, int(time.time())

        def ask():
            try:
                result["sdp"] = stream_answer(fps, offer)
            except (OSError, ValueError) as exc:
                result["error"] = exc

        thread = threading.Thread(target=ask, daemon=True)
        thread.start()
        deadline = time.monotonic() + 25
        while thread.is_alive() and time.monotonic() < deadline:
            thread.join(1)
            problem = None if not thread.is_alive() else capture_problem(stream_status(), since)
            if problem:
                return self.send(502, problem)
        if "sdp" in result:
            return self.send(200, {"sdp": result["sdp"]})
        problem = capture_problem(stream_status(), since)
        return self.send(502, problem or {"error": "go2rtc: %s" % result.get("error", "no answer"), "code": "go2rtc"})

    def input_events(self):
        """Os comandos apertados para a pagina do controle (Server-Sent
        Events): o estado na hora e a cada mudanca; um comentario a cada 15 s
        mostra se a pagina fechou."""
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.close_connection = True
        watch = self.panel.input
        watch.join()
        try:
            version, sent, css = None, None, None
            while True:
                version, state, now = watch.wait(version, 15)
                out = b""
                # O CSS mudou no painel: a pagina o pede de novo (event: css).
                if css is not None and now != css:
                    out += b"event: css\ndata: %d\n\n" % now
                css = now
                if state != sent:
                    out += b"data: " + state.encode() + b"\n\n"
                    sent = state
                self.wfile.write(out or b": ping\n\n")
                self.wfile.flush()
        except OSError:
            pass
        finally:
            watch.leave()

    def overlay_data(self, url):
        """O marquee para o OBS, pela chave do endereco: o estado (state) e
        a imagem do jogo que esta nele (art; so ela, pelo id)."""
        query = parse_qs(url.query)
        if not overlay_allowed(query):
            return self.send(403, {"error": "wrong or missing key"})
        state = marquee_state() if overlay_enabled() else {}
        path = None
        if state.get("system") or state.get("rom"):
            path = self.panel.art.find(state.get("system", ""), state.get("rom", ""))
        if url.path == "/api/overlay/art":
            if not path or (query.get("id") or [""])[0] != art_id(path):
                return self.send(404, {"error": "no such image"})
            try:
                with open(path, "rb") as f:
                    data = f.read(16 << 20)
            except OSError:
                return self.send(404, {"error": "no such image"})
            return self.send(200, data, ART_TYPES[os.path.splitext(path)[1].lower()])
        out = {"enabled": overlay_enabled(), "state": state}
        if path:
            out["art"] = "/api/overlay/art?key=%s&id=%s" % (quote((query.get("key") or [""])[0]), art_id(path))
        return self.send(200, out)

    def romfilter_action(self, action, data):
        """ROM filter: count (o que passa), save (o filtro do Downloader),
        scan (a previa do romset) e run (copiar ou mover, como tarefa)."""
        values = romfilter_values(data.get("values"))
        folder = romfilter_folder(data.get("folder"))
        target = str(data.get("target", ""))
        if values is None or folder is None or action not in ("count", "save", "scan", "run"):
            return self.send(400, {"error": "bad filter, folder or action"})
        if action == "count":
            out, rc = self.panel.romcount.run([SETUP, "--romfilter", "count", target, folder] + values)
            if rc == "replaced":
                return self.send(409, {"error": "replaced by a newer count"})
            if rc != 0:
                return self.send(400 if rc == 2 else 502, {"error": "could not count (%s)" % (
                    "bad filter" if rc == 2 else "timeout" if rc == "timeout"
                    else "no ROM list: add the ROM torrent in Downloads first" if not folder else "see the Setup log")})
            return self.send(200, summary_values(out))
        if action == "save":
            argv = [SETUP, "--romfilter", "save", target, str(data.get("preset", "custom"))] + values
            try:
                done = subprocess.run(argv, capture_output=True, text=True, timeout=300)
            except (OSError, subprocess.SubprocessError) as exc:
                return self.send(500, {"error": str(exc)})
            if done.returncode != 0:
                return self.send(400 if done.returncode == 2 else 500, {"error": "the filter was not saved"})
            self.panel.downloader.when = None
            return self.send(200, summary_values(done.stdout))
        if not folder:
            return self.send(400, {"error": "choose the romset folder"})
        if action == "scan":
            out, rc = self.panel.romscan.run([SETUP, "--romfilter", "scan", folder, target] + values)
            if rc == "replaced":
                return self.send(409, {"error": "replaced by a newer count"})
            if rc != 0:
                return self.send(400 if rc == 2 else 502, {"error": "the romset could not be read (Setup log)"})
            items = []
            for line in out.splitlines():
                if line.startswith("item\t"):
                    _, name, title = (line.split("\t", 2) + [""])[:3]
                    items.append({"name": name, "title": title})
            return self.send(200, {"summary": summary_values(out), "items": items})
        transfer = str(data.get("transfer", ""))
        if transfer not in ("copy", "move"):
            return self.send(400, {"error": "transfer copy or move"})
        task = self.panel.tasks.start("ROM filter: %s %s" % ("copy from" if transfer == "copy" else "move from", folder),
                                      [SETUP, "--romfilter", "run", folder, target, transfer] + values, "romclean")
        if not task:
            return self.send(409, {"error": "the ROM filter is already copying"})
        return self.send(200, task.info())

    def upload(self, query):
        """O corpo do pedido e o arquivo: gravado aos pedacos num .part na
        mesma pasta e renomeado no fim (um envio cortado nao deixa meio
        arquivo com o nome certo)."""
        folder = file_path((query.get("root") or [""])[0], (query.get("path") or [""])[0])
        name = (query.get("name") or [""])[0]
        try:
            size = int(self.headers.get("Content-Length") or -1)
        except ValueError:
            size = -1
        if not folder or not os.path.isdir(folder) or not valid_name(name) or size < 0:
            self.close_connection = True
            return self.send(400, {"error": "bad folder, name or size"})
        target = os.path.join(folder, name)
        if os.path.exists(target) and (query.get("overwrite") or ["0"])[0] != "1":
            # O corpo nao lido fica na conexao: ela fecha.
            self.close_connection = True
            return self.send(409, {"error": "already exists"})
        part = os.path.join(folder, ".%s.part-%s" % (name, secrets.token_hex(4)))
        try:
            with open(part, "wb") as f:
                left = size
                while left > 0:
                    chunk = self.rfile.read(min(left, 1 << 20))
                    if not chunk:
                        raise OSError("the upload was cut")
                    f.write(chunk)
                    left -= len(chunk)
            os.replace(part, target)
        except OSError as exc:
            try:
                os.unlink(part)
            except OSError:
                pass
            self.close_connection = True
            return self.send(500, {"error": str(exc)})
        give_to_player(target)
        return self.send(200, {"name": name, "size": size})

    def send_file(self, path):
        size = os.path.getsize(path)
        name = os.path.basename(path)
        self.send_response(200)
        self.send_header("Content-Type", "application/octet-stream")
        self.send_header("Content-Length", str(size))
        self.send_header("Content-Disposition", "attachment; filename*=UTF-8''" + quote(name))
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        with open(path, "rb") as f:
            while True:
                chunk = f.read(1 << 20)
                if not chunk:
                    break
                self.wfile.write(chunk)


class Redirect(BaseHTTPRequestHandler):
    """A porta 80: http://fliperos.local (sem a porta) leva ao painel, no
    mesmo nome e no mesmo caminho."""
    port = 8081

    def do_GET(self):
        # O nome que o navegador usou (fliperos.local, o IP), sem a porta.
        m = re.fullmatch(r"(\[[0-9A-Fa-f:.]{2,45}\]|[A-Za-z0-9.\-]{1,253})(:\d+)?", self.headers.get("Host") or "")
        host = m.group(1) if m else "fliperos.local"
        self.send_response(HTTPStatus.FOUND)
        self.send_header("Location", "http://%s:%d%s" % (host, self.port, self.path if self.path.startswith("/") else "/"))
        self.send_header("Content-Length", "0")
        self.end_headers()

    do_HEAD = do_GET

    def log_message(self, *args):
        pass


def redirect_from(bind, port, to):
    """O redirecionamento da porta PORT (80) para a TO, em segundo plano. Com
    a porta ocupada (outro servidor web), o painel segue so na dele."""
    if not port or port == to:
        return
    Redirect.port = to
    try:
        server = ThreadingHTTPServer((bind, port), Redirect)
    except OSError as exc:
        print("fliperos-web: port %d not used (%s)" % (port, exc), flush=True)
        return
    server.daemon_threads = True
    threading.Thread(target=server.serve_forever, daemon=True).start()


def main():
    parser = argparse.ArgumentParser(description="FliperOS web panel")
    parser.add_argument("--port", type=int, default=int(ENV("FLIPEROS_WEB_PORT", "8081")))
    parser.add_argument("--bind", default=ENV("FLIPEROS_WEB_BIND", "0.0.0.0"))
    # http://fliperos.local, sem a porta: a 80 so redireciona (0 desliga).
    parser.add_argument("--redirect-port", type=int, default=int(ENV("FLIPEROS_WEB_REDIRECT_PORT", "80")))
    args = parser.parse_args()
    Handler.panel = Panel()
    server = ThreadingHTTPServer((args.bind, args.port), Handler)
    server.daemon_threads = True
    redirect_from(args.bind, args.redirect_port, args.port)
    server.serve_forever()


if __name__ == "__main__":
    main()
