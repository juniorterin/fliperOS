            names[os.path.basename(path)] = path
    return names


def tail(path, lines):
    with open(path, "rb") as f:
        f.seek(0, os.SEEK_END)
        size = f.tell()
        f.seek(max(0, size - 256 * 1024))
        text = f.read().decode(errors="replace")
    return "\n".join(text.splitlines()[-lines:])


# ── O servidor ─────────────────────────────────────────────────────

class Panel:
    def __init__(self):
        self.sessions = Sessions()
        self.sampler = Sampler()
        self.sampler.start()
        self.video = Cached(2, video)
        self.gpus = Cached(2, gpus)
        self.addresses = Cached(10, addresses)
        self.wifi = Cached(10, wifi)
        self.volume = Cached(2, volume)
        self.disks = Cached(10, disks)
        self.systems = Cached(60, systems)
        self.launch_lock = threading.Lock()
        # O que volta depois de um jogo aberto daqui, para o proximo pedido
        # feito com ele ainda na tela (sem fliperos-session no meio).
        self.last_back = "menu"

    def system(self, key):
        rows = self.systems.get()
        return next((s for s in rows if s["key"] == key), None) if isinstance(rows, list) else None

    def launch(self, argv):
        """Pede ao fliperos-tty1 que abra o jogo (o arquivo fliperos-web-launch
        do usuario: o que volta depois e o comando) e fecha o que esta na
        tela para ele chegar la. Com so o desktop aberto, o caminho e o do
        menu Jogos do desktop (fliperos-next)."""
        with self.launch_lock:
            user = pwd.getpwnam(PLAYER)
            runtime = os.path.join(RUN_USER, str(user.pw_uid))
            state = on_screen()
            session = state["session"]
            if session and session not in ("setup", "game"):
                back = session
            elif state["games"] and not state["menu"]:
                back = self.last_back
            else:
                back = "menu"
            self.last_back = back
            only_desktop = state["desktop"] and not state["games"]
            path = os.path.join(runtime, "fliperos-next" if only_desktop else "fliperos-web-launch")
            lines = argv if only_desktop else ["return=" + back] + argv
            tmp = path + ".tmp"
            with open(tmp, "w") as f:
                f.write("\n".join(lines) + "\n")
            os.chown(tmp, user.pw_uid, user.pw_gid)
            os.replace(tmp, path)
            # O jogo primeiro (grava e sai), depois quem esta por tras dele.
            stop(state["games"])
            stop(state["frontends"] + state["desktop"] + state["menu"], wait=4)
            return {"back": back, "via": "desktop" if only_desktop else "tty1"}

    def close_game(self):
        state = on_screen()
        stop(state["games"])
        return {"closed": len(state["games"])}

    def status(self):
        cpu, net, procs = self.sampler.snapshot()
        addrs = self.addresses.get()
        for name, row in net.items():
            row["ipv4"] = addrs.get(name, []) if isinstance(addrs, dict) else []
        load = read(os.path.join(PROC, "loadavg")).split()
        uptime = read(os.path.join(PROC, "uptime")).split()
        return {
            "host": socket.gethostname(), "version": version(), "time": time.time(),
            "uptime": float(uptime[0]) if uptime else None, "load": [float(x) for x in load[:3]],
            "cpu": cpu, "memory": memory(), "temperatures": temperatures(), "gpus": self.gpus.get(),
            "video": self.video.get(), "disks": self.disks.get(), "network": net, "wifi": self.wifi.get(),
            # Todos: o painel ordena pela coluna escolhida e mostra os primeiros.
            "processes": procs, "fps": fps(), "running": running(), "volume": self.volume.get(),
        }


class Handler(BaseHTTPRequestHandler):
    panel = None
    server_version = "fliperos-web"
    sys_version = ""

    def log_message(self, fmt, *args):
        pass

    def send(self, code, body, ctype="application/json", headers=None):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy", "default-src 'self'; img-src 'self' data:")
        for key, value in (headers or {}).items():
            self.send_header(key, value)
        self.end_headers()
        self.wfile.write(data)

    def token(self):
        cookie = SimpleCookie(self.headers.get("Cookie", ""))
        return cookie["fliperos_session"].value if "fliperos_session" in cookie else None

    def body(self):
        size = min(int(self.headers.get("Content-Length") or 0), 65536)
        try:
            return json.loads(self.rfile.read(size) or b"{}")
        except ValueError:
            return {}

    def do_GET(self):
        url = urlparse(self.path)
        if url.path in STATIC_FILES:
            name = STATIC_FILES[url.path]
            try:
                with open(os.path.join(STATIC, name), "rb") as f:
                    data = f.read()
            except OSError:
                return self.send(404, {"error": "not found"})
            return self.send(200, data, TYPES[os.path.splitext(name)[1]])
        if not url.path.startswith("/api/"):
            return self.send(404, {"error": "not found"})
        user = self.panel.sessions.user(self.token())
        if not user:
            return self.send(401, {"error": "login"})
        if url.path == "/api/me":
            return self.send(200, {"user": user})
        if url.path == "/api/status":
            return self.send(200, self.panel.status())
        if url.path == "/api/logs":
            return self.send(200, {"logs": sorted(log_names())})
        if url.path == "/api/log":
            query = parse_qs(url.query)
            path = log_names().get((query.get("name") or [""])[0])
            if not path:
                return self.send(404, {"error": "no such log"})
            try:
                lines = max(10, min(2000, int((query.get("lines") or ["300"])[0])))
            except ValueError:
                lines = 300
            return self.send(200, {"text": tail(path, lines)})
        if url.path == "/api/volume":
            return self.send(200, self.panel.volume.get())
        if url.path == "/api/systems":
            rows = self.panel.systems.get()
            if not isinstance(rows, list):
                return self.send(500, rows)
            return self.send(200, {"systems": [{"key": s["key"], "name": s["name"], "platform": s["platform"],
                                                 "games": len(games(s))} for s in rows]})
        if url.path == "/api/games":
            system = self.panel.system((parse_qs(url.query).get("system") or [""])[0])
            if not system:
                return self.send(404, {"error": "no such system"})
            return self.send(200, {"system": system["key"], "games": games(system)})
        return self.send(404, {"error": "not found"})

    def do_POST(self):
        url = urlparse(self.path)
        if self.headers.get("X-FliperOS") != "1":
            return self.send(403, {"error": "missing X-FliperOS header"})
        ip = self.client_address[0]
        if url.path == "/api/login":
            if self.panel.sessions.blocked(ip):
                return self.send(429, {"error": "too many attempts, wait a minute"})
            data = self.body()
            user, password = str(data.get("user", "")), str(data.get("password", ""))
            if not check_password(user, password):
                self.panel.sessions.failed(ip)
                return self.send(401, {"error": "wrong user or password"})
            token = self.panel.sessions.create(user)
            cookie = "fliperos_session=%s; HttpOnly; SameSite=Strict; Path=/; Max-Age=%d" % (
                token, SESSION_HOURS * 3600)
            return self.send(200, {"user": user}, headers={"Set-Cookie": cookie})
        user = self.panel.sessions.user(self.token())
        if not user:
            return self.send(401, {"error": "login"})
        if url.path == "/api/logout":
            self.panel.sessions.drop(self.token())
            return self.send(200, {}, headers={"Set-Cookie": "fliperos_session=; Path=/; Max-Age=0"})
        if url.path == "/api/volume":
            data = self.body()
            if data.get("action") in ("up", "down", "mute"):
                args = [data["action"]]
            elif isinstance(data.get("set"), int) and 0 <= data["set"] <= 100:
                args = ["set", str(data["set"])]
            else:
                return self.send(400, {"error": "action up|down|mute or set 0..100"})
            try:
                subprocess.run([SETUP, "--volume", *args], capture_output=True, timeout=15)
            except (OSError, subprocess.SubprocessError) as exc:
                return self.send(500, {"error": str(exc)})
            self.panel.volume.when = None
            return self.send(200, self.panel.volume.get())
        if url.path == "/api/launch":
            data = self.body()
            system = self.panel.system(str(data.get("system", "")))
            argv = game_command(system, str(data.get("game", ""))) if system else None
            if not argv:
                return self.send(400, {"error": "no such game, or this system does not open from the panel"})
            return self.send(200, self.panel.launch(argv))
        if url.path == "/api/close":
            return self.send(200, self.panel.close_game())
        return self.send(404, {"error": "not found"})


def main():
    parser = argparse.ArgumentParser(description="FliperOS web panel")
    parser.add_argument("--port", type=int, default=int(ENV("FLIPEROS_WEB_PORT", "8080")))
    parser.add_argument("--bind", default=ENV("FLIPEROS_WEB_BIND", "0.0.0.0"))
    args = parser.parse_args()
    Handler.panel = Panel()
    server = ThreadingHTTPServer((args.bind, args.port), Handler)
    server.daemon_threads = True
    server.serve_forever()


if __name__ == "__main__":
    main()
