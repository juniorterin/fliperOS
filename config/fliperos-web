def romfilter_describe(target, folder):
    out = subprocess.run([SETUP, "--romfilter", "describe", target] + ([folder] if folder else []),
                         capture_output=True, text=True, timeout=120)
    if out.returncode == 2:
        return None
    info = {"targets": [], "presets": [], "params": [], "saved": None, "saved_label": "", "data": "",
            "dest": None, "default_target": None, "writable": False}
    presets, params = {}, {}
    for line in out.stdout.splitlines():
        kind, _, rest = line.partition("|")
        if kind == "target":
            value, _, label = rest.partition("|")
            info["targets"].append({"value": value, "label": label})
        elif kind == "preset":
            value, _, label = rest.partition("|")
            presets[value] = {"value": value, "label": label, "values": {}}
            info["presets"].append(presets[value])
        elif kind == "value":
            preset, _, kv = rest.partition("|")
            key, _, value = kv.partition("=")
            if preset in presets:
                presets[preset]["values"][key] = value
        elif kind == "param":
            parts = rest.split("|", 4)
            if len(parts) == 5:
                key, ptype, title, about, visible = parts
                params[key] = {"key": key, "type": ptype, "title": title, "help": about, "visible": visible == "1",
                               "options": []}
                info["params"].append(params[key])
        elif kind == "option":
            key, _, option = rest.partition("|")
            value, _, label = option.partition("|")
            if key in params:
                params[key]["options"].append({"value": value, "label": label})
        elif kind == "saved":
            key, _, value = rest.partition("=")
            info["saved"] = info["saved"] or {}
            info["saved"][key] = value
        elif kind == "saved_label":
            info["saved_label"] = rest
        elif kind == "data":
            info["data"] = rest
        elif kind == "dest":
            path, _, label = rest.partition("|")
            info["dest"] = {"path": path, "label": label}
        elif kind == "default_target":
            info["default_target"] = rest
        elif kind == "writable":
            info["writable"] = rest == "1"
    return info


