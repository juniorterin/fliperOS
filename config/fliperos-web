def processes():
    """(pid, uid, nome, argumentos) de cada processo; o nome de um script
    Python e o do script."""
    rows = []
    for cmdline in glob.glob(os.path.join(PROC, "[0-9]*/cmdline")):
        args = [a for a in read(cmdline).split("\0") if a]
        if not args:
            continue
        pid = int(cmdline.split("/")[-2])
        try:
            uid = os.stat(os.path.dirname(cmdline)).st_uid
        except OSError:
            continue
        name = os.path.basename(args[0])
        if (name.startswith("python") or name in ("bash", "sh", "env")) and len(args) > 1:
            first = next((a for a in args[1:] if not a.startswith("-") and a not in ("bash", "sh")), args[1])
            name = os.path.basename(first)
        rows.append((pid, uid, name, args))
    return rows


def systems():
    """As pastas com jogos e o comando de cada uma, as mesmas dos frontends
    (fliperos-setup --systems, lib/frontends.sh)."""
    out = subprocess.run([SETUP, "--systems"], capture_output=True, text=True, timeout=120).stdout
    rows = []
    for line in out.splitlines():
        parts = line.split("|")
        if len(parts) >= 7:
            key, folder, platform, name, exe, args, exts = parts[:7]
            rows.append({"key": key, "folder": folder, "platform": platform, "name": name, "exe": exe,
                         "args": args, "extensions": [e.lower() for e in exts.split(";") if e]})
    return rows


def games(system):
    """Os arquivos de jogo da pasta do sistema (so o primeiro nivel)."""
    try:
        names = os.listdir(system["folder"])
    except OSError:
        return []
    exts = tuple(system["extensions"])
    return sorted((n for n in names if not n.startswith(".") and n.lower().endswith(exts)
                   and os.path.isfile(os.path.join(system["folder"], n))), key=str.lower)


def game_command(system, name):
    """O comando do jogo, como o frontend o montaria ([romfilename] e [name]
    do Attract-Mode). None: o arquivo nao e da pasta, ou o comando nao e um
    dos lancadores do FliperOS."""
    if name != os.path.basename(name) or name not in games(system):
        return None
    path = os.path.join(system["folder"], name)
    stem = os.path.splitext(name)[0]
    try:
        argv = shlex.split(system["exe"]) + shlex.split(system["args"])
    except ValueError:
        return None
    argv = [a.replace("[romfilename]", path).replace("[name]", stem) for a in argv]
    return argv if argv and argv[0] in LAUNCHERS else None


def on_screen():
    """O que esta na tela agora: os jogos abertos, o frontend, o desktop, o
    menu do Setup e a sessao do fliperos-session (o que volta depois)."""
    state = {"games": [], "frontends": [], "desktop": [], "menu": [], "session": None}
    for pid, uid, name, args in processes():
        if name in EMULATORS:
            state["games"].append(pid)
        elif name in FRONTENDS and name != "fliperos-gui":
            state["frontends"].append(pid)
        elif name == "lxsession":
            state["desktop"].append(pid)
        elif name == "fliperos-setup" and "--menu" in args and "--remote" not in args:
            state["menu"].append(pid)
        elif name == "fliperos-session":
            rest = [a for a in args if not a.endswith("fliperos-session") and a not in ("bash", "/usr/bin/env")]
            state["session"] = rest[0] if rest else read(SESSION_FILE).strip() or "setup"
    return state


def stop(pids, wait=8):
    """SIGTERM (o jogo grava o que tem de gravar, como no botao de desligar)
    e, para quem nao sair, SIGKILL."""
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    end = time.monotonic() + wait
    while time.monotonic() < end and any(os.path.exists(os.path.join(PROC, str(p))) for p in pids):
        time.sleep(0.2)
    for pid in pids:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass


def version():
    m = re.search(r"^FLIPEROS_SETUP_VERSION=(\S+)", read(SETUP_SCRIPT), re.M)
    return m.group(1).strip("\"'") if m else ""


def volume():
