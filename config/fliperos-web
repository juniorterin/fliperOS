# /overlay/input desenha o direcional e os botoes de um jogador, acesos
# enquanto apertados: o fliperos-buttons watch le os controles do Button
# mapping (e as teclas de um encoder) e o painel os manda por Server-Sent
# Events, pela mesma chave do marquee. O CSS da pagina muda pelo painel
# (INPUT_CSS; sem ele, o input.css de fabrica).
BUTTONS_TOOL = ENV("FLIPEROS_BUTTONS_TOOL", BIN + "/fliperos-buttons")
BUTTONS_MAP = ENV("FLIPEROS_BUTTONS_MAP", "/etc/fliperos/buttons.map")
INPUT_CSS = ENV("FLIPEROS_INPUT_CSS", "/etc/fliperos/input-overlay.css")
INPUT_CSS_MAX = 32768


class InputWatch:
    """Um fliperos-buttons watch so para todas as paginas abertas: comeca
    com a primeira, para com a ultima e volta sozinho se cair."""

    def __init__(self):
        self.cond = threading.Condition()
        self.clients = 0
        self.proc = None
        self.state = "{}"
        self.version = 0
        # O CSS salvo no painel: cada pagina aberta o pede de novo na hora.
        self.css = 0

    def css_changed(self):
        with self.cond:
            self.css += 1
            self.version += 1
            self.cond.notify_all()

    def join(self):
        with self.cond:
            self.clients += 1
            if self.proc is None:
                self.start()

    def leave(self):
        with self.cond:
            self.clients -= 1
            if self.clients <= 0 and self.proc:
                self.proc.terminate()
                self.proc = None

    def start(self):
        try:
            proc = subprocess.Popen([BUTTONS_TOOL, "watch", BUTTONS_MAP], stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL, text=True)
        except OSError:
            return
        self.proc = proc
        threading.Thread(target=self.read, args=(proc,), daemon=True).start()

    def read(self, proc):
        for line in proc.stdout:
            line = line.strip()
            if line.startswith("{"):
                with self.cond:
                    self.state = line
                    self.version += 1
                    self.cond.notify_all()
        proc.wait()
        with self.cond:
            # Caiu (o SDL, um erro): tudo solto, e de novo em 2 s se ainda
            # ha pagina aberta.
            self.state = "{}"
            self.version += 1
            self.cond.notify_all()
            if self.proc is not proc:
                return
            self.proc = None
        time.sleep(2)
        with self.cond:
            if self.clients > 0 and self.proc is None:
                self.start()

    def wait(self, version, timeout):
        """(versao, JSON do estado, versao do CSS) quando mudar da versao
        dada, ou os mesmos depois de timeout segundos."""
        with self.cond:
            self.cond.wait_for(lambda: self.version != version, timeout)
            return self.version, self.state, self.css


def input_css():
    """O CSS da pagina do controle: o do usuario ou o de fabrica."""
    return read(INPUT_CSS) or read(os.path.join(STATIC, "input.css"))


def save_input_css(css):
    """Grava o CSS do usuario (None volta ao de fabrica)."""
    if css is None:
        try:
            os.remove(INPUT_CSS)
        except FileNotFoundError:
            pass
        return
    os.makedirs(os.path.dirname(INPUT_CSS), exist_ok=True)
    tmp = "%s.%d.tmp" % (INPUT_CSS, os.getpid())
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(css)
    os.replace(tmp, INPUT_CSS)


def downloader_status():
    """O andamento do Downloader (fliperos-setup --downloader status)."""
    out = subprocess.run([SETUP, "--downloader", "status"], capture_output=True, text=True, timeout=30).stdout
    values = {}
    for line in out.splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            values[key] = value
    return values


