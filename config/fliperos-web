def read(path, default=""):
    try:
        with open(path, errors="replace") as f:
            return f.read()
    except OSError:
        return default


def read_int(path):
    try:
        return int(read(path).strip())
    except ValueError:
        return None


def conf_values():
    values = {}
    for line in read(CONF).splitlines():
        if "=" in line and not line.startswith("#"):
            key, value = line.split("=", 1)
            values[key.strip()] = value.strip()
    return values


