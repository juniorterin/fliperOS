class Task:
    """Um comando em segundo plano (o Downloader aplicando o filtro, lendo um
    link...): a saida guardada e os eventos de progresso do Setup
    (lib/progress.sh: @step PCT TEXTO, @pct PCT, @msg TEXTO, @fail ETAPA|ERRO)."""

    def __init__(self, task_id, name, argv, kind):
        self.id, self.name, self.kind = task_id, name, kind
        self.started, self.ended, self.rc = time.time(), None, None
        self.pct, self.step, self.error = None, "", ""
        self.lines = collections.deque(maxlen=400)
        self.lock = threading.Lock()
        self.proc = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                     text=True, errors="replace", start_new_session=True)
        threading.Thread(target=self.read, daemon=True).start()

    def read(self):
        for line in self.proc.stdout:
            line = line.rstrip("\n")
            with self.lock:
                self.lines.append(line)
                word, _, rest = line.partition(" ")
                if word == "@step":
                    pct, _, text = rest.partition(" ")
                    self.pct, self.step = self.number(pct), text
                elif word == "@pct":
                    self.pct = self.number(rest)
                elif word == "@msg":
                    self.step = rest
                elif word == "@fail":
                    self.error = rest.partition("|")[2] or rest
        rc = self.proc.wait()
        with self.lock:
            self.rc, self.ended = rc, time.time()

    @staticmethod
    def number(text):
        try:
            return max(0, min(100, int(float(text))))
        except ValueError:
            return None

    def info(self, log=False):
        with self.lock:
            last = next((l for l in reversed(self.lines) if not l.startswith("@")), "")
            row = {"id": self.id, "name": self.name, "kind": self.kind, "started": self.started, "ended": self.ended,
                   "running": self.rc is None, "rc": self.rc, "pct": self.pct, "step": self.step,
                   "error": self.error, "last": last}
            if log:
                row["log"] = "\n".join(self.lines)
            return row

    def cancel(self):
        if self.rc is None:
            try:
                os.killpg(self.proc.pid, signal.SIGTERM)
            except OSError:
                pass


class Tasks:
    """As tarefas do painel (as 20 ultimas). De cada tipo (kind), uma por vez."""

    def __init__(self):
        self.lock = threading.Lock()
        self.items = collections.OrderedDict()
        self.next = 1

    def start(self, name, argv, kind):
        with self.lock:
            if any(t.kind == kind and t.rc is None for t in self.items.values()):
                return None
            task = Task(self.next, name, argv, kind)
            self.items[task.id] = task
            self.next += 1
            while len(self.items) > 20:
                oldest = next(iter(self.items))
                if self.items[oldest].rc is None:
                    break
                del self.items[oldest]
            return task

    def get(self, task_id):
        with self.lock:
            return self.items.get(task_id)

    def all(self):
        with self.lock:
            return [t.info() for t in reversed(self.items.values())]


def settings():
    """Os ajustes do Setup que o painel muda (fliperos-setup --settings,
    lib/system.sh): "chave|grupo|rotulo|tipo|valor|opcoes|ajuda"."""
    out = subprocess.run([SETUP, "--settings"], capture_output=True, text=True, timeout=60).stdout
    rows = []
    for line in out.splitlines():
        parts = line.split("|", 6)
        if len(parts) < 7:
            continue
        key, group, label, kind, value, options, about = parts
        row = {"key": key, "group": group, "label": label, "type": kind, "value": value, "help": about}
        if kind == "choice":
            row["options"] = [dict(zip(("value", "label"), o.split("=", 1))) for o in options.split(";") if "=" in o]
        elif kind == "number" and ".." in options:
            span, _, step = options.partition(":")
            low, high = span.split("..", 1)
            row["min"], row["max"], row["step"] = int(low), int(high), int(step or 1)
        rows.append(row)
    return rows


