def romfilter_values(values):
    """Os filtros {chave: valor} como CHAVE=VALOR para o Setup, ou None."""
    if not isinstance(values, dict):
        return None
    out = []
    for key, value in values.items():
        value = str(value)
        if not re.fullmatch(r"[a-z]{1,20}", str(key)) or len(value) > 4000 or any(c in value for c in "\n\r\0"):
            return None
        out.append("%s=%s" % (key, value))
    return out


