def png(width, height, rows):
    """Um PNG RGB de 8 bits das linhas (de cima para baixo), so com zlib."""
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    raw = b"".join(b"\0" + row for row in rows)
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))


def read_ppm(path):
    """(largura, altura, linhas) de um PPM P6 de 8 bits (o da camada)."""
    with open(path, "rb") as f:
        data = f.read()
    fields, pos = [], 0
    while len(fields) < 4:
        while data[pos:pos + 1].isspace():
            pos += 1
        start = pos
        while not data[pos:pos + 1].isspace():
            pos += 1
        fields.append(data[start:pos])
    if fields[0] != b"P6" or fields[3] != b"255":
        raise ValueError("not an 8-bit PPM")
    width, height = int(fields[1]), int(fields[2])
    body = data[pos + 1:]
    stride = width * 3
    if len(body) < stride * height:
        raise ValueError("short PPM")
    return width, height, [body[y * stride:(y + 1) * stride] for y in range(height)]


class XImage(ctypes.Structure):
    _fields_ = [("width", ctypes.c_int), ("height", ctypes.c_int), ("xoffset", ctypes.c_int),
                ("format", ctypes.c_int), ("data", ctypes.c_void_p), ("byte_order", ctypes.c_int),
                ("bitmap_unit", ctypes.c_int), ("bitmap_bit_order", ctypes.c_int), ("bitmap_pad", ctypes.c_int),
                ("depth", ctypes.c_int), ("bytes_per_line", ctypes.c_int), ("bits_per_pixel", ctypes.c_int)]


def x11_capture(display=":0"):
    """A tela inteira do X (o desktop, que desenha sem OpenGL) pelo XGetImage.
    None: sem X, ou num formato que nao seja 32 bits por pixel."""
    try:
        x = ctypes.CDLL("libX11.so.6")
    except OSError:
        return None
    # O cookie do X da pessoa (o xinit grava em ~/.Xauthority, quando ha).
    cookie = os.path.join(ENV("FLIPEROS_HOME") or pwd.getpwnam(PLAYER).pw_dir, ".Xauthority")
    if os.path.exists(cookie):
        os.environ["XAUTHORITY"] = cookie
    x.XOpenDisplay.restype, x.XOpenDisplay.argtypes = ctypes.c_void_p, [ctypes.c_char_p]
    x.XDefaultScreen.argtypes = [ctypes.c_void_p]
    x.XRootWindow.restype, x.XRootWindow.argtypes = ctypes.c_ulong, [ctypes.c_void_p, ctypes.c_int]
    x.XDisplayWidth.argtypes = x.XDisplayHeight.argtypes = [ctypes.c_void_p, ctypes.c_int]
    x.XGetImage.restype = ctypes.POINTER(XImage)
    x.XGetImage.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_int, ctypes.c_uint,
                            ctypes.c_uint, ctypes.c_ulong, ctypes.c_int]
    x.XFree.argtypes = [ctypes.c_void_p]
    x.XCloseDisplay.argtypes = [ctypes.c_void_p]
    dpy = x.XOpenDisplay(display.encode())
    if not dpy:
        return None
    try:
        screen = x.XDefaultScreen(dpy)
        width, height = x.XDisplayWidth(dpy, screen), x.XDisplayHeight(dpy, screen)
        img = x.XGetImage(dpy, x.XRootWindow(dpy, screen), 0, 0, width, height, 0xFFFFFFFFFFFFFFFF, 2)
        if not img:
            return None
        im = img.contents
        try:
            if im.bits_per_pixel != 32:
                return None
            data = ctypes.string_at(im.data, im.bytes_per_line * im.height)
            rows = []
            for y in range(im.height):
                line = data[y * im.bytes_per_line:y * im.bytes_per_line + im.width * 4]
                out = bytearray(im.width * 3)
                out[0::3], out[1::3], out[2::3] = line[2::4], line[1::4], line[0::4]
                rows.append(bytes(out))
            return im.width, im.height, rows
        finally:
            x.XFree(im.data)
            x.XFree(img)
    finally:
        x.XCloseDisplay(dpy)


def screenshot():
    """(PNG, de onde veio). O desktop pelo X; o resto (jogos, frontends, o
    menu grafico) pela camada OpenGL, que grava o quadro pedido em
    $XDG_RUNTIME_DIR/fliperos-shot.ppm. None: nada que de para fotografar
    (o console de texto, um programa sem OpenGL)."""
    state = on_screen()
