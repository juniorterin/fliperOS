def player_home():
    return ENV("FLIPEROS_HOME") or pwd.getpwnam(PLAYER).pw_dir


def attract_dir():
    return ENV("FLIPEROS_ATTRACT_DIR") or os.path.join(player_home(), ".attract")


def lists_dir():
    return ENV("FLIPEROS_LISTS") or os.path.join(player_home(), ".local", "share", "fliperos", "lists")


def stats_dir():
    return ENV("FLIPEROS_STATS") or os.path.join(player_home(), ".local", "share", "fliperos", "stats")


def romlist_path(system, ext=".txt"):
    return os.path.join(lists_dir(), system["name"].replace("/", "-") + ext)


def attract_romlist_path(system, ext=".txt"):
    return os.path.join(attract_dir(), "romlists", system["name"].replace("/", "-") + ext)


def read_romlist(system):
    """({Name: {campo: valor}} na ordem da lista, a lista tem os nomes de
    verdade?, quando foi gravada)."""
    path = romlist_path(system)
    rows, fields, real = {}, ROMLIST_FIELDS, False
    try:
        mtime = os.stat(path).st_mtime
    except OSError:
        return rows, False, 0
    for line in read(path).splitlines():
        if line.startswith("#"):
            if not rows:
                fields = tuple(line[1:].split(";"))
            continue
        values = line.split(";")
        if len(values) < 2 or not values[0]:
            continue
        row = {k: v for k, v in zip(fields, values) if v}
        rows[values[0]] = row
        real = real or values[1] != values[0]
    return rows, real, mtime


def attract_favourites(system):
    """Os favoritos do Attract-Mode: as linhas "nome;emulador" (ou so o nome,
    o formato antigo) do .tag ao lado da romlist."""
    out = set()
    for line in read(attract_romlist_path(system, ".tag")).splitlines():
        name, _, emulator = line.strip().partition(";")
        if name and emulator in ("", system["name"]):
            out.add(name)
    return out


FAVOURITES_LOCK = threading.Lock()


def favourites_path():
    return ENV("FLIPEROS_FAVOURITES") or os.path.join(player_home(), ".config", "fliperos", "favourites")


def write_favourites(rows):
    """Grava os favoritos ("chave<TAB>nome" por linha), do usuario."""
    path = favourites_path()
    folder = os.path.dirname(path)
    if not os.path.isdir(folder):
        os.makedirs(folder)
        give_to_player(folder)
    tmp = "%s.%d.tmp" % (path, os.getpid())
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("".join("%s\t%s\n" % row for row in sorted(rows)))
    give_to_player(tmp)
    os.replace(tmp, path)


def read_favourites(all_systems):
    """{(chave da pasta, nome)}. Sem o arquivo ainda, os do Attract-Mode sao
    copiados para ele; dali em diante o Attract-Mode nao conta mais."""
    path = favourites_path()
    if not os.path.exists(path):
        if not isinstance(all_systems, list):
            return set()            # a lista das pastas falhou: copia depois
        rows = {(s["key"], n) for s in all_systems for n in attract_favourites(s)}
        write_favourites(rows)
        return rows
    return {tuple(line.split("\t", 1)) for line in read(path).splitlines() if "\t" in line}


def favourite_set(all_systems):
    with FAVOURITES_LOCK:
        return read_favourites(all_systems)


def set_favourite(all_systems, system, name, on):
    with FAVOURITES_LOCK:
        rows = read_favourites(all_systems)
        rows.discard((system["key"], name))
        if on:
            rows.add((system["key"], name))
        write_favourites(rows)
        return (system["key"], name) in rows


def stats_folder(system):
    """A pasta das partidas do sistema (stats_dir()/EMULADOR, um NOME.stat
    por jogo, "vezes\nsegundos" como no Attract-Mode). Sem ela ainda, as do
    Attract-Mode sao copiadas uma vez; dali em diante ele nao conta mais."""
    folder = os.path.join(stats_dir(), system["name"])
    if not os.path.isdir(folder):
        old = os.path.join(attract_dir(), "stats", system["name"])
        if os.path.isdir(old):
            try:
                shutil.copytree(old, folder)
                for top, _, names in os.walk(stats_dir()):
                    for path in [top] + [os.path.join(top, n) for n in names]:
                        give_to_player(path)
            except (OSError, KeyError):
                pass
    return folder


def play_stats(system):
    """{nome: (vezes, segundos)} das partidas (stats_folder)."""
    out = {}
    folder = stats_folder(system)
    try:
        names = os.listdir(folder)
    except OSError:
        return out
    for n in names:
        if n.endswith(".stat"):
            lines = read(os.path.join(folder, n)).splitlines()
            count, played = (lines + ["0", "0"])[:2]
            out[n[:-5]] = (int(count) if count.strip().isdigit() else 0, int(played) if played.strip().isdigit() else 0)
    return out


def game_files(system):
    """{nome sem extensao: arquivo} dos jogos da pasta (so o primeiro
    nivel; de dois arquivos com o mesmo nome vale a primeira extensao)."""
    try:
        names = os.listdir(system["folder"])
    except OSError:
        return {}
    exts = system["extensions"]
    out = {}
    for ext in exts:
        for n in sorted(names, key=str.lower):
            if not n.startswith(".") and n.lower().endswith(ext) and len(n) > len(ext):
                stem = n[:-len(ext)]
                if stem not in out and os.path.isfile(os.path.join(system["folder"], n)):
                    out[stem] = n
    return out


def games(system, favs=frozenset()):
    """Os jogos do sistema: as linhas da romlist do Attract-Mode com o
    arquivo na pasta (a romlist de arcade nao tem as BIOS nem os jogos de
    outro sistema do Flycast que estao na mesma pasta), os clones sem
    arquivo de um romset merged (so onde o jogo abre pelo nome) e os
    arquivos que a romlist nao tem. Da lista de arcade com os nomes de
    verdade, so os arquivos postos depois dela."""
    files = game_files(system)
    rows, real, mtime = read_romlist(system)
    by_name = "[romfilename]" not in system["args"]
    out, seen = [], set()
    for name, row in rows.items():
        file = files.get(name)
        if file or (real and by_name and row.get("CloneOf")):
            entry = dict(row, Name=name)
            entry.pop("Emulator", None)
            if file:
                entry["file"] = file
            out.append(entry)
            seen.add(name)
    for name, file in files.items():
        if name in seen:
            continue
        if real and rows:
            try:
                if os.stat(os.path.join(system["folder"], file)).st_mtime <= mtime:
                    continue
            except OSError:
                continue
        out.append({"Name": name, "Title": name, "file": file})
    stats = play_stats(system)
    for entry in out:
        name = entry["Name"]
        if (system["key"], name) in favs:
            entry["Favourite"] = "1"
        if name in stats:
            entry["PlayedCount"], entry["PlayedTime"] = stats[name]
    out.sort(key=lambda e: (e.get("Title") or e["Name"]).lower())
    return out


def parse_filters(text):
    """Os filtros no formato do Attract-Mode (filter "NOME", e dentro rule
    CAMPO COMPARACAO VALOR, exception, sort_by, reverse_order, list_limit):
    cada um com as regras, a ordem e o limite."""
    filters, current = [], None
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        key, value = (line.split(None, 1) + [""])[:2]
        value = value.strip()
        if key == "filter":
            current = {"name": value.strip('"'), "rules": [], "sort_by": "", "reverse": False, "limit": 0}
            filters.append(current)
        elif current is not None and key in ("rule", "exception"):
            parts = value.split(None, 2)
            if len(parts) >= 2:
                current["rules"].append({"field": parts[0], "op": parts[1], "what": parts[2] if len(parts) > 2 else "",
                                         "exception": key == "exception"})
        elif current is not None and key == "sort_by":
            current["sort_by"] = value
        elif current is not None and key == "reverse_order":
            current["reverse"] = value == "true"
        elif current is not None and key == "list_limit":
            try:
                current["limit"] = int(value)
            except ValueError:
                pass
    return filters


def setup_filters():
    """Os filtros do FliperOS: os mesmos que o Setup poe em cada tela do
    Attract-Mode (scraper_attract_filters, lib/scraper.sh)."""
    out = subprocess.run([SETUP, "--filters"], capture_output=True, text=True, timeout=60).stdout
    return parse_filters(out)


def game_entry(system, name):
    """A linha do jogo NAME (o nome do set ou o arquivo) do sistema."""
    if not name or name != os.path.basename(name):
        return None
    return next((g for g in games(system) if g["Name"] == name or g.get("file") == name), None)


def game_command(system, name):
    """O comando do jogo, como o frontend o montaria ([romfilename] e [name]
    do Attract-Mode). None: o jogo nao e da pasta, ou o comando nao e um
    dos lancadores do FliperOS."""
    entry = game_entry(system, name)
    if not entry:
        return None
    path = os.path.join(system["folder"], entry.get("file") or entry["Name"] + (system["extensions"] or [""])[0])
    try:
        argv = shlex.split(system["exe"]) + shlex.split(system["args"])
    except ValueError:
        return None
    argv = [a.replace("[romfilename]", path).replace("[name]", entry["Name"]) for a in argv]
    return argv if argv and argv[0] in LAUNCHERS else None


