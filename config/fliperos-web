_crypt_lock = threading.Lock()
_crypt = None


def crypt(password, salt):
    """A crypt(3) da libcrypt (a mesma do login: yescrypt, SHA-512...)."""
    global _crypt
    with _crypt_lock:
        if _crypt is None:
            lib = ctypes.CDLL(ctypes.util.find_library("crypt") or "libcrypt.so.1")
            lib.crypt.restype = ctypes.c_char_p
            lib.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
            _crypt = lib
        out = _crypt.crypt(password.encode(), salt.encode())
        return out.decode() if out else None


def check_password(user, password):
    if user not in USERS or not password:
        return False
    for line in read(SHADOW).splitlines():
        fields = line.split(":")
        if len(fields) > 1 and fields[0] == user:
            stored = fields[1]
            if not stored or stored[0] in "!*":
                return False
            out = crypt(password, stored)
            return out is not None and hmac.compare_digest(out, stored)
    return False


class Sessions:
    """Sessoes na memoria (reiniciar o servico desloga) e o limite de
    tentativas: 5 senhas erradas num minuto travam aquele endereco."""

    def __init__(self):
        self.lock = threading.Lock()
        self.tokens = {}
        self.failures = collections.defaultdict(collections.deque)

    def blocked(self, ip):
        with self.lock:
            fails = self.failures[ip]
            while fails and fails[0] < time.monotonic() - 60:
                fails.popleft()
            return len(fails) >= 5

    def failed(self, ip):
        with self.lock:
            self.failures[ip].append(time.monotonic())

    def create(self, user):
        token = secrets.token_urlsafe(32)
        with self.lock:
            self.tokens[token] = (user, time.monotonic() + SESSION_HOURS * 3600)
        return token

    def user(self, token):
        with self.lock:
            entry = self.tokens.get(token or "")
            if not entry:
                return None
            if entry[1] < time.monotonic():
                del self.tokens[token]
                return None
            return entry[0]

    def drop(self, token):
        with self.lock:
            self.tokens.pop(token or "", None)


