# O que veio da internet fica salvo no gabinete, junto da outra midia
# (~/media/<tipo>/<pasta de jogos>): ~/media/info/mame/samsho.en.json. Um jogo
# buscado uma vez nao e buscado de novo, abre sem internet e serve a qualquer
# frontend do FliperOS. Um jogo que o Arcade Database nao conhece e
# perguntado de novo so depois de MISS_DAYS.
MISS_DAYS = 30


class GameInfo:
    """As respostas do Arcade Database: salvas em ~/media/info (save) e, a
    frente delas, em memoria."""

    def __init__(self, root=None, size=500):
        self.root = root or ENV("FLIPEROS_GAMEINFO_DIR") or os.path.join(player_home(), "media", "info")
        self.size = size
        self.lock = threading.Lock()
        self.cache = collections.OrderedDict()

    def path(self, folder, name, lang):
        """O arquivo do jogo: a pasta de jogos (mame, retroarch/fbneo) e o
        nome do set, sem sair de ~/media/info."""
        parts = [p for p in folder.split("/") if p not in ("", ".", "..")]
        base = re.sub(r"[^A-Za-z0-9._-]", "_", name)
        if not parts or not base.strip("._"):
            return None
        return os.path.join(self.root, *parts, "%s.%s.json" % (base, lang))

    def load(self, path):
        try:
            with open(path, encoding="utf-8") as f:
                saved = json.load(f)
        except (OSError, ValueError):
            return None
        if saved.get("info") is None and time.time() - saved.get("saved", 0) > MISS_DAYS * 86400:
            return None
        return saved

    def save(self, path, saved):
        """Grava do dono de ~/media (o usuario fliperos), como o resto dela."""
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            tmp = "%s.%d.tmp" % (path, os.getpid())
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(saved, f, ensure_ascii=False, indent=1)
            os.replace(tmp, path)
            if os.geteuid() == 0:
                owner = os.stat(os.path.dirname(self.root))
                d = path
                while d != self.root and d.startswith(self.root):
                    os.chown(d, owner.st_uid, owner.st_gid)
                    d = os.path.dirname(d)
                os.chown(self.root, owner.st_uid, owner.st_gid)
        except OSError:
            pass

    def arcade(self, folder, name, lang):
        """(info, quando foi salvo): do disco, ou do Arcade Database e entao
        salvo."""
        key = (folder, name, lang)
        with self.lock:
            hit = self.cache.get(key)
            if hit:
                return hit
        path = self.path(folder, name, lang)
        saved = self.load(path) if path else None
        if saved is None:
            url = "%s?ajax=query_mame&game_name=%s&lang=%s" % (ADB_URL, quote(name), lang)
            request = urllib.request.Request(url, headers={"User-Agent": "FliperOS web panel"})
            with urllib.request.urlopen(request, timeout=10) as res:
                data = json.loads(res.read(2 << 20).decode("utf-8", "replace"))
            rows = data.get("result") or []
            info = None
            if rows:
                info = {k: rows[0][k] for k in ADB_FIELDS if rows[0].get(k) not in (None, "")}
            saved = {"source": "Arcade Database", "game": name, "lang": lang, "saved": int(time.time()), "info": info}
            if path:
                self.save(path, saved)
        result = (saved["info"], saved["saved"])
        with self.lock:
            self.cache[key] = result
            while len(self.cache) > self.size:
                self.cache.popitem(last=False)
        return result


# ── Os botoes e a descricao de um jogo (painel web e frontend) ──────
# O Setup > Joysticks > Buttons layout grava onde ficam no painel os botoes
# dos jogos de N botoes: "4 1 4 2 5" (o botao 1 na posicao 1, o 2 na 4...;
# 1 2 3 em cima, 4 5 6 embaixo). Sem linha, o botao N na posicao N.
BUTTONS_LAYOUT = ENV("FLIPEROS_BUTTONS_LAYOUT", "/etc/fliperos/buttons.layout")
PANEL_SIZE = 6
# As secoes do arcade-history que nao sao sobre o jogo.
HISTORY_SKIP = ("CONTRIBUTE", "SOURCES")


def button_layout(count):
    """A posicao no painel (1 a 6) de cada botao dos jogos de COUNT botoes."""
    try:
        with open(BUTTONS_LAYOUT, encoding="utf-8") as f:
            for line in f:
                parts = line.split()
                if parts and parts[0] == str(count):
                    pos = [int(p) for p in parts[1:] if p.isdigit()]
                    if len(pos) == count and len(set(pos)) == count and all(1 <= p <= PANEL_SIZE for p in pos):
                        return pos
    except OSError:
        pass
    return list(range(1, min(count, PANEL_SIZE) + 1))


def game_buttons(info):
    """Os botoes do jogador 1 do Arcade Database, sem o direcional: [(numero,
    cor, funcao)], do 1 ao ultimo que o jogo usa."""
    found = {}
    for part in (info.get("buttons_colors") or "").split(";"):
        bits = part.split(":")
        m = re.fullmatch(r"P1_BUTTON(\d+)", bits[0]) if len(bits) >= 2 else None
        if m:
            found[int(m.group(1))] = (bits[1], bits[2] if len(bits) > 2 else "")
    try:
        count = int(info.get("input_buttons") or 0)
    except (TypeError, ValueError):
        count = 0
    count = min(PANEL_SIZE, max([count, *found]))
    return [(n, *found.get(n, ("", ""))) for n in range(1, count + 1)]


def button_panel(info):
    """O painel de 6 posicoes com os botoes do jogo onde o Buttons layout os
    poe: uma lista de 6, cada uma None ou {button, color, label}. Vazia: o
    jogo nao tem botoes conhecidos."""
    buttons = game_buttons(info)
    if not buttons:
        return []
    cells = [None] * PANEL_SIZE
    for (n, color, label), pos in zip(buttons, button_layout(len(buttons))):
        cells[pos - 1] = {"button": n, "color": color, "label": label}
    return cells


def history_parts(text):
    """A historia do arcade-history em (descricao, [(secao, texto)]): a
    descricao e o comeco, sem o cabecalho ("... published 26 years ago:" e a
    linha do (c)); as secoes sao as "- TECHNICAL -", "- TRIVIA -"..., sem as
    que nao falam do jogo."""
    blocks, title, lines = [], "", []
    for line in (text or "").replace("\r", "").split("\n"):
        m = re.fullmatch(r"-\s+([A-Z0-9][A-Z0-9 '&/.,()-]*?)\s+-", line.strip())
        if m:
            blocks.append((title, lines))
            title, lines = m.group(1), []
        else:
            lines.append(line)
    blocks.append((title, lines))

    def clean(rows):
        return re.sub(r"\n{3,}", "\n\n", "\n".join(rows)).strip()

    intro = clean(blocks[0][1]).split("\n")
    if intro and intro[0].rstrip().endswith(":"):
        intro = intro[1:]
    while intro and not intro[0].strip():
        intro = intro[1:]
    if intro and "(c)" in intro[0].lower():
        intro = intro[1:]
    sections = [(name.title(), clean(rows)) for name, rows in blocks[1:] if name not in HISTORY_SKIP and clean(rows)]
    return clean(intro), sections


def thumbnails(system, entry):
    """As imagens do libretro-thumbnails do jogo (capa, tela, titulo), pelo
    nome do arquivo, como o RetroArch procura."""
    playlist = THUMB_SYSTEMS.get(system["platform"])
    if not playlist:
        return []
    name = re.sub(r'[&*/:`<>?\\|"]', "_", os.path.splitext(entry.get("file") or entry["Name"])[0])
    return [{"kind": kind, "url": "%s/%s/%s/%s.png" % (THUMBS_URL, quote(playlist), folder, quote(name))}
