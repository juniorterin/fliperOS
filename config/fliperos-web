def stream_link():
    """"wifi" ou "wired": a interface da rota padrao, que leva a transmissao.
    No Wi-Fi (o USB do gabinete) a imagem engasgava com pacotes perdidos; a
    pagina recomenda o cabo. Com o cabo e o Wi-Fi ligados vale a de menor
    metrica (a que o kernel usa). None sem rota padrao."""
    routes = []
    for line in read(os.path.join(PROC, "net/route")).splitlines()[1:]:
        fields = line.split()
        if len(fields) > 7 and fields[1] == "00000000" and fields[7] == "00000000" and fields[6].isdigit():
            routes.append((int(fields[6]), fields[0]))
    if not routes:
        return None
    wireless = os.path.isdir(os.path.join(SYS, "class/net", min(routes)[1], "wireless"))
    return "wifi" if wireless else "wired"


def stream_status():
