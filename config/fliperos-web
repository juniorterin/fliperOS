def capture_problem(status, since=0):
    """O erro da captura da tela (fliperos-stream grab) desde o tempo dado,
    para o painel: {"error", "code"}; None sem erro. no_vaapi: o amdgpu nao
    deixa mapear o framebuffer (EPERM no hwdownload) e falta o VA-API, que
    copia o quadro pela placa."""
    error = status.get("error")
    if not error or (status.get("error_at") or 0) < since:
        return None
    if status.get("copy") == "mmap" and re.search(r"map DRM object|download frame", error):
        return {"error": "the video card only lets the screen be read through VA-API, which is missing "
                         "(mesa-va-drivers): install the live screen again under Streaming (%s)" % error,
                "code": "no_vaapi"}
    return {"error": "the cabinet could not capture the screen: %s" % error, "code": "capture"}


def stream_answer(fps, offer):
