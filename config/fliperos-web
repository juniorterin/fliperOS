class Sampler(threading.Thread):
    """A cada segundo: o uso de CPU (total e por nucleo), a taxa da rede e o
    CPU de cada processo, que precisam de duas leituras."""

    def __init__(self):
        super().__init__(daemon=True)
        self.lock = threading.Lock()
        self.cpu = {"total": 0.0, "cores": []}
        self.net = {}
        self.procs = []
        self._cpu = None
        self._net = None
        self._proc = {}
        self._time = None

    def run(self):
        while True:
            try:
                self.sample()
            except Exception:  # um /proc estranho nao derruba o painel
                pass
            time.sleep(1)

    def sample(self):
        now = time.monotonic()
        cpu = {}
        for line in read(os.path.join(PROC, "stat")).splitlines():
            if line.startswith("cpu"):
                name, *values = line.split()
                values = [int(v) for v in values[:8]]
                cpu[name] = (sum(values), values[3] + values[4])
        net = {}
        for line in read(os.path.join(PROC, "net/dev")).splitlines()[2:]:
            if ":" in line:
                name, data = line.split(":", 1)
                fields = data.split()
                if len(fields) >= 9 and name.strip() != "lo":
                    net[name.strip()] = (int(fields[0]), int(fields[8]))
        procs = {}
        for stat in glob.glob(os.path.join(PROC, "[0-9]*/stat")):
            text = read(stat)
            if ")" not in text:
                continue
            pid = int(stat.split("/")[-2])
            comm = text[text.index("(") + 1:text.rindex(")")]
            rest = text[text.rindex(")") + 2:].split()
            if len(rest) < 22:
                continue
            procs[pid] = (comm, int(rest[11]) + int(rest[12]), int(rest[21]))
        with self.lock:
            if self._cpu:
                def usage(name):
                    total, idle = cpu[name]
                    t0, i0 = self._cpu.get(name, (total, idle))
                    return round(100.0 * (1 - (idle - i0) / max(1, total - t0)), 1)
                self.cpu = {"total": usage("cpu"),
                            "cores": [usage(n) for n in sorted((k for k in cpu if k != "cpu"),
                                                               key=lambda k: int(k[3:]))]}
            if self._net and self._time:
                span = max(0.001, now - self._time)
                self.net = {name: {"rx_bps": round((rx - self._net.get(name, (rx, tx))[0]) / span),
                                   "tx_bps": round((tx - self._net.get(name, (rx, tx))[1]) / span),
                                   "rx_total": rx, "tx_total": tx}
                            for name, (rx, tx) in net.items()}
            if self._time:
                span = max(0.001, now - self._time)
                hz = os.sysconf("SC_CLK_TCK")
                page = os.sysconf("SC_PAGE_SIZE")
                rows = []
                for pid, (comm, ticks, rss) in procs.items():
                    before = self._proc.get(pid, (comm, ticks, rss))[1]
                    rows.append({"pid": pid, "name": comm, "cpu": round(100.0 * (ticks - before) / hz / span, 1),
                                 "mem_mb": round(rss * page / 1048576, 1)})
                rows.sort(key=lambda r: (-r["cpu"], -r["mem_mb"]))
                self.procs = rows
            self._cpu, self._net, self._proc, self._time = cpu, net, procs, now

    def snapshot(self):
        with self.lock:
            return dict(self.cpu), dict(self.net), list(self.procs)


class Cached:
    """O resultado de uma leitura cara (o DRM, o nmcli, o lspci) por alguns
    segundos."""

    def __init__(self, seconds, fn):
        self.seconds, self.fn = seconds, fn
        self.lock = threading.Lock()
        self.value, self.when = None, None

    def get(self):
        with self.lock:
            if self.when is None or time.monotonic() - self.when > self.seconds:
                try:
                    self.value = self.fn()
                except Exception as exc:
                    self.value = {"error": str(exc)}
                self.when = time.monotonic()
            return self.value


def memory():
    info = {}
    for line in read(os.path.join(PROC, "meminfo")).splitlines():
        key, _, value = line.partition(":")
        if value.strip().endswith("kB"):
            info[key] = int(value.split()[0]) * 1024
    total = info.get("MemTotal", 0)
    return {"total": total, "used": total - info.get("MemAvailable", total),
            "swap_total": info.get("SwapTotal", 0),
            "swap_used": info.get("SwapTotal", 0) - info.get("SwapFree", 0)}


def temperatures():
    """Os sensores do hwmon: o da CPU (k10temp, coretemp...), da GPU, do
    disco."""
    rows = []
    for mon in sorted(glob.glob(os.path.join(SYS, "class/hwmon/hwmon*"))):
        name = read(os.path.join(mon, "name")).strip()
        for temp in sorted(glob.glob(os.path.join(mon, "temp*_input"))):
            value = read_int(temp)
            if value is None:
                continue
            label = read(temp.replace("_input", "_label")).strip()
            rows.append({"sensor": name, "label": label, "celsius": round(value / 1000, 1)})
    return rows


def pci_name(slot):
    try:
        out = subprocess.run(["lspci", "-mm", "-s", slot], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    fields = re.findall(r'"([^"]*)"', out)
    return " ".join(fields[1:3]) if len(fields) >= 3 else out.strip()


def gpus():
    rows = []
    for card in sorted(glob.glob(os.path.join(SYS, "class/drm/card[0-9]"))):
        dev = os.path.join(card, "device")
        slot = os.path.basename(os.path.realpath(dev))
        driver = os.path.basename(os.path.realpath(os.path.join(dev, "driver")))
        row = {"card": os.path.basename(card), "slot": slot, "driver": driver, "name": pci_name(slot)}
        busy = read_int(os.path.join(dev, "gpu_busy_percent"))
        if busy is not None:
            row["busy"] = busy
        used, total = read_int(os.path.join(dev, "mem_info_vram_used")), read_int(os.path.join(dev, "mem_info_vram_total"))
        if used is not None and total:
            row["vram_used"], row["vram_total"] = used, total
        for line in read(os.path.join(dev, "pp_dpm_sclk")).splitlines():
            if line.strip().endswith("*"):
                row["clock"] = line.split(":", 1)[-1].replace("*", "").strip()
        freq = read_int(os.path.join(card, "gt_cur_freq_mhz"))
        if freq is not None:
            row["clock"] = "%d Mhz" % freq
        for mon in glob.glob(os.path.join(dev, "hwmon/hwmon*")):
            temp = read_int(os.path.join(mon, "temp1_input"))
            if temp is not None:
                row["celsius"] = round(temp / 1000, 1)
            power = read_int(os.path.join(mon, "power1_average"))
            if power is not None:
                row["watts"] = round(power / 1e6, 1)
        rows.append(row)
    return rows


_video_check = None


def modeline(row):
    flags = row.get("flags", 0)
    parts = ["+hsync" if flags & 1 else "-hsync" if flags & 2 else "",
             "+vsync" if flags & 4 else "-vsync" if flags & 8 else "",
             "interlace" if flags & 16 else "", "doublescan" if flags & 32 else ""]
    return '"%dx%d" %.3f %d %d %d %d %d %d %d %d %s' % (
        row["width"], row["height"], row["clock_khz"] / 1000.0, row["width"], row.get("hsync_start", 0),
        row.get("hsync_end", 0), row["htotal"], row["height"], row.get("vsync_start", 0), row.get("vsync_end", 0),
        row["vtotal"], " ".join(p for p in parts if p))


def video():
    """O pedido no Setup e o que o DRM mostra agora (o fliperos-video-check)."""
    global _video_check
    conf = conf_values()
    wanted = {k: conf.get(k, "") for k in ("monitor", "frequency", "boot_resolution", "connector", "orientation")}
    outputs, errors = [], []
    if os.path.exists(VIDEO_CHECK):
        if _video_check is None:
            loader = SourceFileLoader("fliperos_video_check", VIDEO_CHECK)
            module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
            loader.exec_module(module)
            _video_check = module
        rows, errors = _video_check.read_active()
        for row in rows:
            if row.get("active"):
                row = dict(row)
                row["modeline"] = modeline(row)
                row["horizontal_khz"] = round(row["horizontal_khz"], 3)
                row["vertical_hz"] = round(row["vertical_hz"], 3)
            outputs.append(row)
    fb = read(os.path.join(SYS, "class/graphics/fb0/virtual_size")).strip().replace(",", "x")
    return {"wanted": wanted, "outputs": outputs, "errors": errors, "framebuffer": fb}


def disks():
    rows, seen = [], set()
    real = {"ext4", "ext3", "ext2", "vfat", "exfat", "ntfs", "ntfs3", "fuseblk", "btrfs", "xfs", "cifs", "f2fs"}
    for line in read(os.path.join(PROC, "mounts")).splitlines():
        fields = line.split()
        if len(fields) < 3 or fields[2] not in real or fields[0] in seen:
            continue
        mount = fields[1].replace("\\040", " ")
        try:
            st = os.statvfs(mount)
        except OSError:
            continue
        seen.add(fields[0])
        total = st.f_blocks * st.f_frsize
        rows.append({"device": fields[0], "mount": mount, "type": fields[2], "total": total,
                     "used": total - st.f_bavail * st.f_frsize})
    return rows


def addresses():
    try:
        out = subprocess.run(["ip", "-j", "addr"], capture_output=True, text=True, timeout=5).stdout
        data = json.loads(out or "[]")
    except (OSError, subprocess.SubprocessError, ValueError):
        return {}
    return {i["ifname"]: [a["local"] for a in i.get("addr_info", []) if a.get("family") == "inet"]
            for i in data if i.get("ifname") != "lo"}


def wifi():
    try:
        out = subprocess.run(["nmcli", "-t", "-f", "ACTIVE,SSID,SIGNAL", "device", "wifi", "list", "--rescan", "no"],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    for line in out.splitlines():
        parts = line.split(":")
        if len(parts) >= 3 and parts[0] == "yes":
            return {"ssid": ":".join(parts[1:-1]), "signal": int(parts[-1] or 0)}
    return None


def fps():
    """O FPS gravado pela camada (fliperos-deflicker.c) de um programa ainda
    aberto: o arquivo mais novo de /run/user/*/fliperos-fps."""
    best = None
    for path in glob.glob(os.path.join(RUN_USER, "*/fliperos-fps")):
        try:
            age = time.time() - os.path.getmtime(path)
            fields = read(path).split()
        except OSError:
            continue
        if len(fields) < 5 or age > 3 or not os.path.exists(os.path.join(PROC, fields[0])):
            continue
        row = {"pid": int(fields[0]), "fps": float(fields[1]), "program": fields[2],
               "core": None if fields[3] == "-" else fields[3], "filtering": fields[4] == "1"}
        if best is None or age < best[0]:
            best = (age, row)
    return best[1] if best else None


def running():
    """O jogo e o frontend abertos: o processo, o comando e o arquivo."""
    found = {"game": None, "frontend": None}
    for cmdline in glob.glob(os.path.join(PROC, "[0-9]*/cmdline")):
        args = [a for a in read(cmdline).split("\0") if a]
        if not args:
            continue
        name = os.path.basename(args[0])
        if name.startswith("python") and len(args) > 1:
            name = os.path.basename(args[1])
        kind = "game" if name in EMULATORS else "frontend" if name in FRONTENDS else None
        if not kind or found[kind]:
            continue
        files = [a for a in args[1:] if not a.startswith("-") and "." in os.path.basename(a)]
        found[kind] = {"pid": int(cmdline.split("/")[-2]), "program": name,
                       "file": os.path.basename(files[-1]) if files else None, "command": " ".join(args)[:400]}
    return found


