        out = subprocess.run([SETUP, "--volume", "get"], capture_output=True, text=True, timeout=10).stdout
        return {"percent": int(out.strip().split()[-1])}
    except (OSError, subprocess.SubprocessError, ValueError, IndexError):
        return {"percent": None}


