DMD = ENV("FLIPEROS_DMD", BIN + "/fliperos-dmd")
ART_TYPES = {".png": "image/png", ".gif": "image/gif", ".webp": "image/webp", ".jpg": "image/jpeg",
             ".jpeg": "image/jpeg"}


def overlay_key(new=False):
    """A chave do endereco do overlay (criada na primeira vez)."""
    key = read(OVERLAY_KEY).strip()
    if key and not new:
        return key
    key = secrets.token_urlsafe(18)
    os.makedirs(os.path.dirname(OVERLAY_KEY), exist_ok=True)
    tmp = "%s.%d.tmp" % (OVERLAY_KEY, os.getpid())
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        f.write(key + "\n")
    os.replace(tmp, OVERLAY_KEY)
    return key


def overlay_allowed(query):
    key = read(OVERLAY_KEY).strip()
    given = (query.get("key") or [""])[0]
    return bool(key) and hmac.compare_digest(key.encode(), given.encode())


def overlay_enabled():
    return conf_values().get("marquee_overlay") == "on"


def overlay_paths(key):
    """Os enderecos para o OBS com a chave: o marquee, a tela e o controle."""
    key = quote(key)
    return {"enabled": overlay_enabled(), "path": "/overlay/marquee?key=" + key, "live": "/overlay/live?key=" + key,
            "input": "/overlay/input?key=" + key}


def marquee_state():
    """O ultimo estado do marquee (o mais novo dos usuarios), como dict."""
    files = glob.glob(os.path.join(RUN_USER, "*", "fliperos-marquee"))
    if not files:
        return {}
    newest = max(files, key=lambda p: os.stat(p).st_mtime if os.path.exists(p) else 0)
    state = {}
    for line in read(newest).splitlines():
        key, sep, value = line.partition("=")
        if sep and re.fullmatch(r"[a-z_]{1,20}", key):
            state[key] = value
    return state


class ArtCache:
    """O arquivo da arte de cada (sistema, jogo), pelo fliperos-dmd art (as
    mesmas regras do ZeDMD: ~/media/dmd, marquee, logo)."""

    def __init__(self):
        self.lock = threading.Lock()
        self.items = collections.OrderedDict()

    def find(self, system, rom):
        key = (system, rom)
        with self.lock:
            hit = self.items.get(key)
            if hit and time.monotonic() - hit[0] < 60:
                return hit[1]
        env = dict(os.environ, MEDIA_DIR=os.path.join(player_home(), "media"),
                   ATTRACT_DIR=attract_dir())
        try:
            out = subprocess.run([DMD, "art", system] + ([rom] if rom else []), capture_output=True, text=True,
                                 timeout=20, env=env).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            out = ""
        path = out if out and os.path.isfile(out) and os.path.splitext(out)[1].lower() in ART_TYPES else None
        with self.lock:
            self.items[key] = (time.monotonic(), path)
            while len(self.items) > 200:
                self.items.popitem(last=False)
        return path


def art_id(path):
    st = os.stat(path)
    return hashlib.sha1(("%s:%d:%d" % (path, st.st_mtime, st.st_size)).encode()).hexdigest()[:16]


