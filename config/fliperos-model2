#!/usr/bin/env bash
# Sega Model 2 pelo SM2-Emu. O Model 2 Emulator (Wine) saiu: este comando
# so repassa para o binario compilado em ~/.local/src/sm2-emu. Aberto por um
# frontend, via fliperos-x11-run. Pelo menu, o fliperos-launch escolhe o jogo
# antes (config/fliperos-sm2emu).
#
#   fliperos-model2 [jogo]      (nome sem .zip, ou o caminho do .zip)
set -euo pipefail
src=${FLIPEROS_SM2_SRC:-$HOME/.local/src/sm2-emu}
bin=$src/build/bin/sm2-emu
roms=${FLIPEROS_MODEL2_DIR:-$HOME/roms/model2}
if [[ ! -x $bin ]]; then
  echo "Model 2 is not built yet. Open it from the desktop menu once to clone and build it." >&2
  exit 1
fi
args=()
for arg in "$@"; do
  if [[ $arg != -* && ! -e $arg && -f $roms/$arg.zip ]]; then
    args+=("$roms/$arg.zip")
  else
    args+=("$arg")
  fi
done
exec "$bin" "${args[@]}"
