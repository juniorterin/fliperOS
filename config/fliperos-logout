#!/usr/bin/env bash
# O "Back to the menu" do LXDE (o item do menu, o botao do painel e o
# quit_manager do lxsession): fecha o desktop e volta direto ao menu do
# FliperOS, sem perguntar. Desligar e reiniciar ficam no proprio menu
# (Shutdown / Reboot).
#
# Fechar o lxsession fecha o desktop; o fliperos-session volta ao menu.
kill -TERM "${_LXSESSION_PID:-0}" 2> /dev/null || pkill -u "$(id -u)" -x lxsession
exit 0
