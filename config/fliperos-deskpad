#!/usr/bin/env python3
"""O controle como mouse no desktop (a sessao LXDE).

O analogico esquerdo move o ponteiro (mais longe do centro, mais rapido), o
direcional e o hat tambem (acelerando segurando), o analogico direito e o L/R
rolam. O botao de aceitar (o Enter do Setup) e o clique esquerdo, o de voltar
(o Esc) e o direito.

O teclado na tela e o Onboard do Ubuntu (config/fliperos-onboard.gschema.override):
ele abre sozinho, encaixado embaixo, quando um campo de texto ganha o foco, e
tecla-se apontando com o analogico e clicando com o aceitar. Daqui ele recebe,
pelo D-Bus: o botao 3 (X/Y num joypad, o Espaco do Setup) o abre e fecha em
qualquer programa; um clique de aceitar fora dele o fecha (o campo continua com
o foco, e o Onboard sozinho nao fecharia); um jogo em tela cheia o esconde.

Os botoes de aceitar e voltar sao os do Setup > Joysticks > Button mapping, os
mesmos dos menus (o mapa do fliperos-padkeys). Com uma janela em tela cheia (um
jogo aberto do desktop) o controle e so dela: nada aqui reage.

Roda como o usuario, aberto pelo config/fliperos-lxde, e sai com o X.
"""
import fcntl
import glob
import importlib.machinery
import importlib.util
import os
import select
import signal
import shutil
import struct
import subprocess
import sys
import time

PADKEYS = os.environ.get('FLIPEROS_PADKEYS', '/opt/fliperos/bin/fliperos-padkeys')
EVENTS = os.environ.get('FLIPEROS_INPUT_EVENTS', '/dev/input/event*')

EV_KEY, EV_ABS = 0x01, 0x03
ABS_X, ABS_Y, ABS_RX, ABS_RY = 0x00, 0x01, 0x03, 0x04
KEY_ESC, KEY_ENTER, KEY_SPACE = 1, 28, 57
KEY_UP, KEY_PAGEUP, KEY_LEFT, KEY_RIGHT, KEY_DOWN, KEY_PAGEDOWN = 103, 104, 105, 106, 108, 109
ARROWS = {KEY_UP: (0, -1), KEY_DOWN: (0, 1), KEY_LEFT: (-1, 0), KEY_RIGHT: (1, 0)}

# Os botoes do X: aceitar e o clique esquerdo, voltar o direito; a rodinha e
# 4 (cima) e 5 (baixo).
CLICK_ACCEPT, CLICK_BACK = 1, 3
WHEEL_UP, WHEEL_DOWN = 4, 5

# A velocidade do ponteiro, em larguras de tela por segundo: o analogico no
# fim vai a MAX; o direcional comeca em DIGITAL_START e chega a MAX em
# DIGITAL_RAMP segundos. DEAD e a folga do analogico parado.
MAX_SPEED = 0.9
DIGITAL_START, DIGITAL_RAMP = 0.2, 1.2
DEAD = 0.15
# Rolagem: linhas por segundo com o analogico direito no fim, e a repeticao
# do L/R segurado.
SCROLL_SPEED = 12.0
TICK = 1 / 60


def load_padkeys(path=None):
    """O fliperos-padkeys como modulo: o mapa dos botoes e o Mapper."""
    path = path or PADKEYS
    loader = importlib.machinery.SourceFileLoader('fliperos_padkeys', path)
    spec = importlib.util.spec_from_loader('fliperos_padkeys', loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


# ── O ponteiro ─────────────────────────────────────────────────────

def stick(value, low, high):
    """O eixo em -1..1, com a folga do meio e uma curva (devagar perto do
    centro, para acertar um botao pequeno)."""
    if high <= low:
        return 0.0
    v = (2.0 * (value - low) / (high - low)) - 1.0
    v = max(-1.0, min(1.0, v))
    if abs(v) < DEAD:
        return 0.0
    v = (abs(v) - DEAD) / (1 - DEAD) * (1 if v > 0 else -1)
    return v * abs(v)


class Pointer:
    """As contas do movimento: o analogico (x, y), o direcional (dx, dy e
    desde quando) e a rolagem. step(dt, largura) -> (dx, dy, rolagem) em
    pixels e linhas inteiros; as fracoes ficam para o passo seguinte."""

    def __init__(self):
        self.analog = [0.0, 0.0]
        self.scroll_axis = 0.0
        self.digital = {}          # tecla -> desde quando
        self.rest = [0.0, 0.0, 0.0]

    def press(self, key, now):
        self.digital.setdefault(key, now)

    def release(self, key):
        self.digital.pop(key, None)

    def clear(self):
        self.analog = [0.0, 0.0]
        self.scroll_axis = 0.0
        self.digital.clear()
        self.rest = [0.0, 0.0, 0.0]

    def moving(self):
        return bool(self.digital) or any(self.analog) or bool(self.scroll_axis)

    def step(self, dt, width, now):
        vx, vy = self.analog
        if self.digital:
            held = now - min(self.digital.values())
            speed = DIGITAL_START + (1 - DIGITAL_START) * min(1.0, held / DIGITAL_RAMP)
            for key in self.digital:
                ax, ay = ARROWS.get(key, (0, 0))
                vx += ax * speed
                vy += ay * speed
        vx, vy = max(-1.0, min(1.0, vx)), max(-1.0, min(1.0, vy))
        pixels = MAX_SPEED * width * dt
        self.rest[0] += vx * pixels
        self.rest[1] += vy * pixels
        self.rest[2] += self.scroll_axis * SCROLL_SPEED * dt
        out = []
        for i in range(3):
            whole = int(self.rest[i])
            self.rest[i] -= whole
            out.append(whole)
        return tuple(out)


# ── O X ────────────────────────────────────────────────────────────

class X:
    """O ponteiro e os cliques pelo XTest (python3-xlib); sem ele, pelo
    xdotool."""

    def __init__(self):
        self.d = None
        try:
            from Xlib import X as XC, display
            from Xlib.ext import xtest
            self.d, self.XC, self.xtest = display.Display(), XC, xtest
            root = self.d.screen().root
            self.root = root
            self.atoms = {name: self.d.intern_atom(name) for name in
                          ('_NET_ACTIVE_WINDOW', '_NET_WM_STATE', '_NET_WM_STATE_FULLSCREEN')}
        except Exception:  # noqa: BLE001 - sem Xlib, sem X: o xdotool
            self.d = None
        self.xdotool = shutil.which('xdotool')
        self.osk_win = None

    def width(self):
        if self.d is not None:
            return self.d.screen().width_in_pixels
        return 640

    def move(self, dx, dy):
        if not (dx or dy):
            return
        if self.d is not None:
            self.xtest.fake_input(self.d, self.XC.MotionNotify, detail=True, x=dx, y=dy)
            self.d.flush()
        elif self.xdotool:
            subprocess.run([self.xdotool, 'mousemove_relative', '--', str(dx), str(dy)])

    def button(self, number, down):
        if self.d is not None:
            self.xtest.fake_input(self.d, self.XC.ButtonPress if down else self.XC.ButtonRelease, number)
            self.d.flush()
        elif self.xdotool:
            subprocess.run([self.xdotool, 'mousedown' if down else 'mouseup', str(number)])

    def scroll(self, lines):
        number = WHEEL_DOWN if lines > 0 else WHEEL_UP
        for _ in range(abs(lines)):
            self.button(number, True)
            self.button(number, False)

    def pointer(self):
        """Onde esta o ponteiro (x, y), ou None."""
        if self.d is None:
            return None
        try:
            p = self.root.query_pointer()
            return p.root_x, p.root_y
        except Exception:  # noqa: BLE001
            return None

    def osk_rect(self):
        """O retangulo (x, y, w, h) do teclado do Onboard quando esta na tela,
        ou None. A janela do teclado e a "Onboard" do WM_CLASS onboard; escondida
        e encaixada, ela fica mapeada fora da tela. O openbox a poe dentro da
        moldura dele: procura tambem um nivel abaixo da raiz."""
        if self.d is None:
            return None
        try:
            if self.osk_win is None:
                for top in self.root.query_tree().children:
                    for win in [top] + list(top.query_tree().children):
                        cls = win.get_wm_class()
                        if cls and cls[0] == 'onboard' and win.get_wm_name() == 'Onboard':
                            self.osk_win = win
                            break
                    if self.osk_win is not None:
                        break
                else:
                    return None
            if self.osk_win.get_attributes().map_state != self.XC.IsViewable:
                return None
            geo = self.osk_win.get_geometry()
            pos = self.osk_win.translate_coords(self.root, 0, 0)
            x, y = -pos.x, -pos.y
            screen = self.d.screen()
            if y >= screen.height_in_pixels or y + geo.height <= 0:
                return None
            return x, y, geo.width, geo.height
        except Exception:  # noqa: BLE001 - o Onboard fechou: procura de novo
            self.osk_win = None
            return None

    def fullscreen(self):
        """A janela ativa esta em tela cheia (um jogo aberto do desktop)?"""
        if self.d is None:
            return False
        try:
            prop = self.root.get_full_property(self.atoms['_NET_ACTIVE_WINDOW'], self.XC.AnyPropertyType)
            if not prop or not prop.value or not prop.value[0]:
                return False
            win = self.d.create_resource_object('window', prop.value[0])
            state = win.get_full_property(self.atoms['_NET_WM_STATE'], self.XC.AnyPropertyType)
            return bool(state) and self.atoms['_NET_WM_STATE_FULLSCREEN'] in state.value
        except Exception as e:  # noqa: BLE001 - janela que fechou no meio
            # O X fechou (saiu do desktop): sai junto.
            if 'ConnectionClosed' in type(e).__name__:
                os._exit(0)
            return False


# ── O teclado na tela (Onboard) ────────────────────────────────────

class Onboard:
    """Mostrar e esconder o Onboard pelo D-Bus dele. Sem o Onboard no ar a
    chamada so falha, calada."""

    DEST = 'org.onboard.Onboard'
    PATH = '/org/onboard/Onboard/Keyboard'
    IFACE = 'org.onboard.Onboard.Keyboard'

    def call(self, method):
        try:
            subprocess.Popen(['dbus-send', '--session', '--type=method_call', '--dest=' + self.DEST,
                              self.PATH, '%s.%s' % (self.IFACE, method)],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass

    def toggle(self):
        self.call('ToggleVisible')

    def hide(self):
        self.call('Hide')


# ── O laco ─────────────────────────────────────────────────────────

class Desk:
    """O que cada botao faz (sem os aparelhos: os testes chamam key() e
    tick() direto)."""

    def __init__(self, x, osk):
        self.x, self.osk = x, osk
        self.pointer = Pointer()
        self.down = set()          # botoes do X apertados agora

    def release_mouse(self):
        for number in list(self.down):
            self.x.button(number, False)
        self.down.clear()
        self.pointer.clear()

    def outside_osk(self):
        """O ponteiro esta fora do teclado na tela aberto?"""
        rect = self.x.osk_rect()
        where = self.x.pointer()
        if rect is None or where is None:
            return False
        x, y, w, h = rect
        return not (x <= where[0] < x + w and y <= where[1] < y + h)

    def key(self, key, pressed, now, analog=False):
        """Uma tecla do Mapper do padkeys (1 apertou, 0 soltou). analog: a
        seta veio do analogico, que ja anda pelo eixo."""
        if key in ARROWS:
            if analog:
                return
            if pressed:
                self.pointer.press(key, now)
            else:
                self.pointer.release(key)
        elif key in (KEY_ENTER, KEY_ESC):
            number = CLICK_ACCEPT if key == KEY_ENTER else CLICK_BACK
            if pressed and number not in self.down:
                # Aceitar fora do teclado na tela o fecha; o clique segue.
                if number == CLICK_ACCEPT and self.outside_osk():
                    self.osk.hide()
                self.down.add(number)
                self.x.button(number, True)
            elif not pressed and number in self.down:
                self.down.discard(number)
                self.x.button(number, False)
        elif key == KEY_SPACE and pressed:
            self.osk.toggle()
        elif key in (KEY_PAGEUP, KEY_PAGEDOWN) and pressed:
            self.x.scroll(-3 if key == KEY_PAGEUP else 3)

    def analog(self, axis, value):
        if axis in (ABS_X, ABS_Y):
            self.pointer.analog[axis] = value
        elif axis == ABS_RY:
            self.pointer.scroll_axis = value

    def tick(self, dt, now):
        dx, dy, lines = self.pointer.step(dt, self.x.width(), now)
        self.x.move(dx, dy)
        if lines:
            self.x.scroll(lines)

    def busy(self):
        return self.pointer.moving()


def single(display):
    """Um so por tela: uma segunda copia (o desktop aberto de novo sem a
    primeira ter saido) leria os mesmos controles e cada botao valeria duas
    vezes. O lock fica com o processo; None se outro ja o tem."""
    folder = os.environ.get('XDG_RUNTIME_DIR') or '/tmp'
    path = os.path.join(folder, 'fliperos-deskpad%s.lock' % display.replace('/', '_'))
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    return fd


def main():
    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, lambda *_: os._exit(0))
    lock = single(os.environ.get('DISPLAY', ''))
    if lock is None:
        sys.exit('fliperos-deskpad: already running on this display')
    pk = load_padkeys()
    x = X()
    if x.d is None and not x.xdotool:
        sys.exit('fliperos-deskpad: no X connection (python3-xlib) and no xdotool')
    osk = Onboard()
    desk = Desk(x, osk)
    pads, ranges = {}, {}
    scanned, checked, paused = 0.0, 0.0, False
    last = time.monotonic()
    while True:
        now = time.monotonic()
        if now - scanned >= 2:
            scanned = now
            players = None
            for path in sorted(glob.glob(EVENTS)):
                if path in pads:
                    continue
                if players is None:
                    players = pk.read_players()
                try:
                    pad = pk.Pad(path, players)
                except (OSError, ValueError):
                    continue
                pads[path] = pad
                axes = {}
                for axis in pk.bits(pad.fd, EV_ABS, 0x40) & {ABS_X, ABS_Y, ABS_RX, ABS_RY}:
                    info = bytearray(24)
                    try:
                        fcntl.ioctl(pad.fd, pk.eviocgabs(axis), info)
                        axes[axis] = struct.unpack('6i', info)[1:3]
                    except OSError:
                        pass
                ranges[path] = axes
        # Com um jogo em tela cheia o controle e dele, e o teclado na tela sai.
        if now - checked >= 0.5:
            checked = now
            full = x.fullscreen()
            if full and not paused:
                desk.release_mouse()
                osk.hide()
            paused = full
        timeout = TICK if desk.busy() else 0.25
        ready, _, _ = select.select([p.fd for p in pads.values()], [], [], timeout)
        now = time.monotonic()
        for path, pad in list(pads.items()):
            if pad.fd not in ready:
                continue
            try:
                events = pad.read()
            except OSError:
                events = None
            if events is None:
                for key, value in pad.mapper.release():
                    desk.key(key, value, now)
                pad.close()
                del pads[path]
                ranges.pop(path, None)
                desk.release_mouse()
                continue
            if paused:
                continue
            for etype, code, value in events:
                if etype == EV_ABS and code in ranges.get(path, {}):
                    low, high = ranges[path][code]
                    desk.analog(code, stick(value, low, high))
                for key, pressed in pad.mapper.event(etype, code, value):
                    desk.key(key, pressed, now, analog=etype == EV_ABS and code in (ABS_X, ABS_Y))
        dt, last = now - last, now
        if not paused:
            desk.tick(min(dt, 0.1), now)


if __name__ == '__main__':
    main()
