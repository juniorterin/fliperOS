#!/usr/bin/env python3
"""Controle no lugar do teclado nos menus do FliperOS (o joy2key do
RetroPie, para o fliperos-setup no console).

    direcional, hat ou analogico esquerdo  setas (repetem segurando)
    botao 1 / A / Start                    Enter
    botao 2 / B / Select                   Esc
    botao 3 / X / Y                        Espaco (marca nas listas de marcar)
    L / R                                  Page Up / Page Down

Um controle do Setup > Joysticks > Button mapping usa os botoes do mapa
(mapped_buttons): num joypad o de sul e o Enter e o de leste o Esc; num
painel, o botao 1 e o Enter e o 2 o Esc.

Roda como servico (root, por causa do /dev/uinput), mas so traduz enquanto
/run/fliperos/padkeys existe: o fliperos-setup cria o arquivo ao abrir o
menu e o apaga ao sair, inclusive para abrir um frontend, emulador ou o
desktop, que leem o controle sozinhos (senao cada botao valeria duas
vezes). Fora disso os controles ficam fechados.

As teclas saem por um teclado virtual (uinput): o console recebe a seta
inteira (ESC [ A) de uma vez, o que o TIOCSTI do joy2key nao garante.
Sem dependencias: o evdev e o uinput sao lidos e escritos com struct.
"""
import errno
import fcntl
import glob
import os
import select
import struct
import time

FLAG = os.environ.get('FLIPEROS_PADKEYS_FLAG', '/run/fliperos/padkeys')
NAME = b'FliperOS pad keys'


def flag_on():
    """O arquivo existe e o PID dentro dele (o Setup, o navegador do
    Downloader) esta vivo. Um dono que morreu sem apagar o arquivo (o tty1
    reiniciado com o Setup aberto) o deixava para tras, e no frontend e nos
    jogos cada botao saia tambem como tecla: o botao 2 era um Esc, que
    fechava o Flycast, o Dolphin e o MAME. Esse arquivo e apagado aqui."""
    try:
        with open(FLAG) as f:
            text = f.read().strip()
    except OSError:
        return False
    if text.isdigit():
        try:
            with open('/proc/%s/stat' % text) as f:
                if f.read().rsplit(')', 1)[1].split()[0] != 'Z':
                    return True
        except (OSError, IndexError):
            pass
    try:
        os.remove(FLAG)
    except OSError:
        pass
    return False

EV_SYN, EV_KEY, EV_ABS = 0x00, 0x01, 0x03
ABS_X, ABS_Y, ABS_HAT0X, ABS_HAT0Y = 0x00, 0x01, 0x10, 0x11

KEY_ESC, KEY_ENTER, KEY_SPACE = 1, 28, 57
KEY_UP, KEY_PAGEUP, KEY_LEFT, KEY_RIGHT, KEY_DOWN, KEY_PAGEDOWN = 103, 104, 105, 106, 108, 109

BUTTONS = {
    0x120: KEY_ENTER,     # BTN_TRIGGER: botao 1 de joystick e de encoder de fliperama
    0x121: KEY_ESC,       # BTN_THUMB: botao 2
    0x122: KEY_SPACE,     # BTN_THUMB2: botao 3
    0x130: KEY_ENTER,     # BTN_SOUTH (A)
    0x131: KEY_ESC,       # BTN_EAST (B)
    0x133: KEY_SPACE,     # BTN_NORTH (X)
    0x134: KEY_SPACE,     # BTN_WEST (Y)
    0x136: KEY_PAGEUP,    # BTN_TL
    0x137: KEY_PAGEDOWN,  # BTN_TR
    0x13a: KEY_ESC,       # BTN_SELECT
    0x13b: KEY_ENTER,     # BTN_START
    0x220: KEY_UP, 0x221: KEY_DOWN, 0x222: KEY_LEFT, 0x223: KEY_RIGHT,  # BTN_DPAD_*
    # xpad com o direcional como botoes (BTN_TRIGGER_HAPPY1-4).
    0x2c0: KEY_LEFT, 0x2c1: KEY_RIGHT, 0x2c2: KEY_UP, 0x2c3: KEY_DOWN,
}
KEYS = sorted(set(BUTTONS.values()))
REPEAT = {KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT, KEY_PAGEUP, KEY_PAGEDOWN}
# Mais lento que o teclado: num modo entrelacado o menu redesenha devagar.
# Um toque rapido no direcional anda um item so; a repeticao so comeca
# depois de meio segundo segurando.
REPEAT_DELAY, REPEAT_RATE = 0.50, 0.12
# O microswitch de um direcional de fliperama repica: ao fechar e ao abrir,
# o contato solta e volta em poucos milissegundos, e cada volta seria mais um
# item. Uma tecla solta so sai depois desse tempo sem voltar.
DEBOUNCE = 0.06
AXES = {ABS_X: (KEY_LEFT, KEY_RIGHT), ABS_Y: (KEY_UP, KEY_DOWN),
        ABS_HAT0X: (KEY_LEFT, KEY_RIGHT), ABS_HAT0Y: (KEY_UP, KEY_DOWN)}
# Controle e quem tem botao de joystick ou de gamepad (BTN_JOYSTICK e
# BTN_GAMEPAD): teclado, mouse e touchpad nao tem. Pistola de luz (GunCon 2)
# tem, mas mira pelos eixos X/Y e tem botao de mouse (BTN_LEFT): mirar
# andaria pelo menu.
PAD_BUTTONS = range(0x120, 0x140)
BTN_LEFT = 0x110


def is_pad(name, keys):
    return name != NAME and BTN_LEFT not in keys and bool(keys.intersection(PAD_BUTTONS))


# ── O Button mapping (Setup > Joysticks) ────────────────────────────
# Um controle do mapa usa os botoes dele, nao os codigos do kernel: num
# joypad o de sul confirma e o de leste volta, como em todo console; num
# painel, o botao 1 confirma e o 2 volta. Os codigos do kernel so acertam nos
# controles que seguem a regra dele (BTN_SOUTH embaixo: Xbox, Nintendo); num
# HID generico, como o 8BitDo SNES30, o BTN_SOUTH e o A, de leste.
BUTTONS_MAP = os.environ.get('FLIPEROS_BUTTONS_MAP', '/etc/fliperos/buttons.map')
ROLES = {
    'arcade': {'b1': KEY_ENTER, 'b2': KEY_ESC, 'b3': KEY_SPACE, 'start': KEY_ENTER, 'coin': KEY_ESC},
    'pad': {'b4': KEY_ENTER, 'b5': KEY_ESC, 'b1': KEY_SPACE, 'b2': KEY_SPACE, 'b3': KEY_PAGEUP,
            'b6': KEY_PAGEDOWN, 'start': KEY_ENTER, 'coin': KEY_ESC},
}


def read_players(path=None):
    """[{kind, port, ids, binds}] do buttons.map: a porta de um com fio (a
    linha usb), o barramento, fabricante e produto de um Bluetooth (o GUID da
    linha bt) e os botoes de cada comando."""
    players = {}
    try:
        with open(path or BUTTONS_MAP, encoding='utf-8', errors='replace') as f:
            lines = [line.split(None, 4) for line in f]
    except OSError:
        return []
    for parts in lines:
        if len(parts) < 4 or not parts[0].isdigit():
            continue
        p = players.setdefault(parts[0], {'kind': 'arcade', 'port': '', 'ids': None, 'binds': {}})
        if parts[1] == 'kind':
            p['kind'] = parts[3] if parts[3] in ROLES else 'arcade'
        elif parts[1] == 'usb':
            p['port'] = parts[3]
        elif parts[1] == 'bt':
            p['ids'] = guid_ids(parts[3])
        elif parts[3].startswith('b') and parts[3][1:].isdigit():
            p['binds'][parts[1]] = int(parts[3][1:])
    return list(players.values())


def guid_ids(guid):
    """(barramento, fabricante, produto) de um GUID do SDL (16 bits, little
    endian, nos bytes 0, 4 e 8); None se nao e um."""
    try:
        word = lambda at: int(guid[at + 2:at + 4] + guid[at:at + 2], 16)
        return word(0), word(8), word(16)
    except ValueError:
        return None


def sdl_buttons(keys):
    """Os codigos do kernel na ordem dos botoes do SDL: de BTN_JOYSTICK em
    diante, depois os de antes (src/joystick/linux, ConfigJoystick)."""
    return sorted(k for k in keys if k >= 0x120) + sorted(k for k in keys if k < 0x120)


def mapped_buttons(keys, port, ids, players):
    """{codigo: tecla} do jogador do mapa que e este controle (pela porta ou,
    Bluetooth, pelo fabricante e produto); None se o mapa nao o tem."""
    for p in players:
        if (p['port'] and p['port'] == port) or (p['ids'] and ids and p['ids'] == ids):
            order = sdl_buttons(keys)
            table = {}
            for control, key in ROLES[p['kind']].items():
                n = p['binds'].get(control)
                if n is not None and n < len(order):
                    table[order[n]] = key
            # O aceitar e o voltar escolhidos no Button mapping (o passo dos
            # botoes da interface): so eles sao o Enter e o Esc dos botoes de
            # acao; o Start e o Select continuam.
            for control, key, keep in (('accept', KEY_ENTER, 'start'), ('cancel', KEY_ESC, 'coin')):
                n = p['binds'].get(control)
                if n is None or n >= len(order):
                    continue
                spare = p['binds'].get(keep)
                for code in [c for c, k in table.items() if k == key]:
                    if spare is None or spare >= len(order) or code != order[spare]:
                        del table[code]
                table[order[n]] = key
            # O direcional que o controle manda como botoes continua.
            table.update({c: k for c, k in BUTTONS.items() if c >= 0x220 and c in keys})
            return table
    return None


class Mapper:
    """Eventos de um controle -> [(tecla, 1 apertou / 0 soltou)]; buttons e
    {codigo: tecla} (o do Button mapping, ou BUTTONS)."""

    def __init__(self, ranges, buttons=None):
        self.ranges = ranges  # eixo -> (minimo, maximo), do EVIOCGABS
        self.held = {}        # eixo -> tecla que ele segura agora
        self.buttons = buttons or BUTTONS

    def direction(self, axis, value):
        if axis in (ABS_HAT0X, ABS_HAT0Y):
            return (value > 0) - (value < 0)
        low, high = self.ranges.get(axis, (-32768, 32767))
        if high <= low:
            return 0
        center = (low + high) / 2
        # Metade do curso para cada lado: o analogico em repouso, mesmo
        # gasto, nao anda sozinho; o encoder digital (0/127/255) vai ao fim.
        dead = (high - low) / 4
        if value < center - dead:
            return -1
        if value > center + dead:
            return 1
        return 0

    def event(self, etype, code, value):
        if etype == EV_KEY and code in self.buttons:
            # 2 e a repeticao do proprio controle: a nossa vem de Keys.
            return [(self.buttons[code], value)] if value in (0, 1) else []
        if etype == EV_ABS and code in AXES:
            negative, positive = AXES[code]
            new = {-1: negative, 0: None, 1: positive}[self.direction(code, value)]
            old = self.held.get(code)
            if new == old:
                return []
            self.held[code] = new
            out = [(old, 0)] if old else []
            return out + ([(new, 1)] if new else [])
        return []

    def release(self):
        out = [(key, 0) for key in self.held.values() if key]
        self.held.clear()
        return out


class Keys:
    """Teclas do teclado virtual: conta quem segura cada uma (o hat e o
    analogico podem segurar a mesma seta) e repete as de mover. A tecla solta
    espera DEBOUNCE: se voltar antes (o repique da chave), nada sai."""

    def __init__(self, emit):
        self.emit = emit   # emit(tecla, valor): 1 aperta, 0 solta, 2 repete
        self.count = {}
        self.due = {}      # tecla -> hora da proxima repeticao
        self.loose = {}    # tecla solta -> hora em que a soltura sai

    def apply(self, key, value, now):
        n = self.count.get(key, 0)
        if value:
            self.count[key] = n + 1
            if n == 0:
                if self.loose.pop(key, None) is None:
                    self.emit(key, 1)
                # Um repique conta como um toque novo para a repeticao.
                if key in REPEAT:
                    self.due[key] = now + REPEAT_DELAY
        elif n == 1:
            del self.count[key]
            self.due.pop(key, None)
            self.loose[key] = now + DEBOUNCE
        elif n > 1:
            self.count[key] = n - 1

    def tick(self, now):
        for key, when in list(self.loose.items()):
            if now >= when:
                del self.loose[key]
                self.emit(key, 0)
        for key, when in list(self.due.items()):
            if now >= when:
                self.emit(key, 2)
                self.due[key] = now + REPEAT_RATE

    def timeout(self, now, idle):
        times = list(self.due.values()) + list(self.loose.values())
        if not times:
            return idle
        return max(0.0, min(min(times) - now, idle))

    def release_all(self):
        for key in list(self.count) + list(self.loose):
            self.emit(key, 0)
        self.count.clear()
        self.due.clear()
        self.loose.clear()


# ── evdev e uinput (linux/input.h, linux/uinput.h) ──────────────────

def _ioc(direction, kind, nr, size):
    return (direction << 30) | (size << 16) | (ord(kind) << 8) | nr


def eviocgbit(ev, length):
    return _ioc(2, 'E', 0x20 + ev, length)


def eviocgabs(axis):
    return _ioc(2, 'E', 0x40 + axis, 24)


EVIOCGNAME = _ioc(2, 'E', 0x06, 256)
EVIOCGID = _ioc(2, 'E', 0x02, 8)
UI_DEV_CREATE = _ioc(0, 'U', 1, 0)
UI_DEV_SETUP = _ioc(1, 'U', 3, 92)
UI_SET_EVBIT = _ioc(1, 'U', 100, 4)
UI_SET_KEYBIT = _ioc(1, 'U', 101, 4)
EVENT = struct.Struct('llHHi')


def bits(fd, ev, count):
    buf = bytearray((count + 7) // 8)
    fcntl.ioctl(fd, eviocgbit(ev, len(buf)), buf)
    return {i for i in range(count) if buf[i // 8] >> (i % 8) & 1}


def device_port(path):
    """A porta do controle no sysfs, como o fliperos-buttons a guarda (o
    caminho do aparelho sem o "input/inputN" do fim)."""
    real = os.path.realpath('/sys/class/input/%s/device' % os.path.basename(path))
    real = real[:real.rfind('/input/input')] if '/input/input' in real else real
    return real.split('/sys/devices/', 1)[-1] if '/sys/devices/' in real else ''


class Pad:
    def __init__(self, path, players=()):
        self.path = path
        self.fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        try:
            name = bytearray(256)
            fcntl.ioctl(self.fd, EVIOCGNAME, name)
            keys = bits(self.fd, EV_KEY, 0x300)
            if not is_pad(bytes(name).split(b'\0')[0], keys):
                raise ValueError('nao e controle')
            ranges = {}
            for axis in bits(self.fd, EV_ABS, 0x40) & {ABS_X, ABS_Y}:
                info = bytearray(24)
                fcntl.ioctl(self.fd, eviocgabs(axis), info)
                _value, low, high = struct.unpack('6i', info)[:3]
                ranges[axis] = (low, high)
            ident = bytearray(8)
            fcntl.ioctl(self.fd, EVIOCGID, ident)
            ids = struct.unpack('4H', ident)[:3]
        except (OSError, ValueError):
            os.close(self.fd)
            raise
        self.mapper = Mapper(ranges, mapped_buttons(keys, device_port(path), ids, players))

    def read(self):
        """Eventos pendentes; OSError quando o controle foi desligado."""
        try:
            data = os.read(self.fd, EVENT.size * 64)
        except BlockingIOError:
            return []
        if not data:
            raise OSError(errno.ENODEV, 'desligado')
        return [EVENT.unpack_from(data, i)[2:] for i in range(0, len(data) - EVENT.size + 1, EVENT.size)]

    def close(self):
        os.close(self.fd)


def uinput_open():
    fd = os.open('/dev/uinput', os.O_WRONLY | os.O_NONBLOCK)
    fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
    for key in KEYS:
        fcntl.ioctl(fd, UI_SET_KEYBIT, key)
    # BUS_VIRTUAL; vendor/produto sem significado.
    fcntl.ioctl(fd, UI_DEV_SETUP, struct.pack('HHHH80sI', 0x06, 0x1209, 0x0001, 1, NAME, 0))
    fcntl.ioctl(fd, UI_DEV_CREATE)
    return fd


def main():
    out = uinput_open()

    def emit(key, value):
        os.write(out, EVENT.pack(0, 0, EV_KEY, key, value) + EVENT.pack(0, 0, EV_SYN, 0, 0))

    keys = Keys(emit)
    pads = {}
    scanned = 0.0
    while True:
        if not flag_on():
            if pads:
                for pad in pads.values():
                    pad.close()
                pads.clear()
                keys.release_all()
            time.sleep(0.5)
            continue
        now = time.monotonic()
        if now - scanned >= 2:
            scanned = now
            players = None
            for path in sorted(glob.glob('/dev/input/event*')):
                if path not in pads:
                    if players is None:
                        players = read_players()
                    try:
                        pads[path] = Pad(path, players)
                    except (OSError, ValueError):
                        pass
        ready, _, _ = select.select([p.fd for p in pads.values()], [], [], keys.timeout(now, 0.5))
        for pad in list(pads.values()):
            if pad.fd not in ready:
                continue
            try:
                events = pad.read()
            except OSError:
                events = None
            now = time.monotonic()
            if events is None:
                for key, value in pad.mapper.release():
                    keys.apply(key, value, now)
                pad.close()
                del pads[pad.path]
                continue
            for etype, code, value in events:
                for key, pressed in pad.mapper.event(etype, code, value):
                    keys.apply(key, pressed, now)
        keys.tick(time.monotonic())


if __name__ == '__main__':
    main()
