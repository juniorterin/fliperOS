def make_plans(tmp):
    """Os planos de agora (o filtro sobre a lista de cada torrent), em TMP.
    {tipo: (arquivo do plano, [entradas])}. Os CHDs sao os dos jogos que as
    ROMs vao trazer e dos que ja estao nas pastas."""
    plans = {}
    for kind in registered():
        meta = meta_of(kind)
        names = os.path.join(tmp, kind + '.list')
        with open(names, 'w', encoding='utf-8') as f:
            f.writelines('%s\t%d\n' % (rel, length) for _, rel, length in relative(meta))
        out = os.path.join(tmp, kind + '.plan')
        if kind == 'roms':
            cmd = [ROMCLEAN, 'scan', *read_args('filter.scan'), '--roms', folder_of(kind, meta),
                   '--names', names, '--plan', out]
        else:
            cmd = [ROMCLEAN, 'chds', *read_args('filter.chds'), '--chds', folder_of(kind, meta),
                   '--names', names, '--plan', out]
            if 'roms' in plans:
                coming = os.path.join(tmp, 'coming')
                with open(coming, 'w', encoding='utf-8') as f:
                    f.writelines('%s\t%s\n' % (e[0], e[4]) for e in plans['roms'][1])
                cmd += ['--with', coming, '--with-only']
        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode != 0:
            last = [line for line in proc.stderr.splitlines() if line.strip()]
            raise OSError('the ROM cleaner filter failed: %s' % (last[-1] if last else proc.returncode))
        plans[kind] = (out, read_plan(out))
    return plans


def files_of(kind, entry, rels):
    """Os arquivos do torrent de uma entrada do plano e onde cada um fica:
    [(indice, caminho na pasta do torrent, destino, bytes)]. Uma ROM e um
    arquivo; um CHD e a pasta do jogo, com os discos."""
    name, filename, _, _, dest = entry
    out = []
    for index, rel, length in rels:
        if kind == 'roms' and rel == filename:
            out.append((index, rel, os.path.join(dest, filename), length))
        elif kind == 'chds' and rel.startswith(filename + '/'):
            out.append((index, rel, os.path.join(dest, rel), length))
    return out


def arrived(target, length):
    try:
        return os.path.getsize(target) == length
    except OSError:
        return False


def fetch_metadata(rpc, kind, magnet, progress, timeout):
    """Poe o link no Transmission (pausado) e espera a lista de arquivos."""
    got = rpc.call('torrent-add', filename=magnet, paused=True, **{'download-dir': os.path.join(STAGING, kind)})
    added = got.get('torrent-added') or got.get('torrent-duplicate')
    if not added:
        raise OSError('Transmission did not take the magnet link')
    hash_ = added['hashString']
    end = time.monotonic() + timeout
    while True:
        t = rpc.torrent(hash_, ['name', 'files', 'metadataPercentComplete', 'peersConnected',
                                'error', 'errorString'])
        if t and t.get('files'):
            return hash_, t
        if time.monotonic() > end:
            rpc.remove(hash_)
            raise OSError('no peer sent the file list in %d minutes (is the link alive?)' % (timeout // 60))
        pct = int(90 * float((t or {}).get('metadataPercentComplete') or 0))
        say(progress, '@step %d Asking the peers for the file list (%d connected)'
            % (pct, (t or {}).get('peersConnected') or 0))
        time.sleep(2)


