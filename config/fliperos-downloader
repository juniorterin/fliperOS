def say(progress, line):
    if progress:
        print(line, flush=True)


def human(n):
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if n < 1024 or unit == 'TB':
            return ('%d %s' if unit == 'B' else '%.1f %s') % (n, unit)
        n /= 1024


def duration(seconds):
    if seconds < 0:
        return 'unknown time'
    hours, minutes = seconds // 3600, seconds % 3600 // 60
    return '%d h %02d min' % (hours, minutes) if hours else '%d min' % max(minutes, 1)


class Rpc:
    """A RPC do transmission-daemon (JSON por HTTP, com o X-Transmission-Session-Id)."""

    def __init__(self, url=RPC):
        self.url, self.session = url, ''

    def call(self, method, **arguments):
        body = json.dumps({'method': method, 'arguments': arguments}).encode()
        for _ in range(3):
            req = urllib.request.Request(self.url, data=body, headers={
                'X-Transmission-Session-Id': self.session, 'Content-Type': 'application/json'})
            try:
                with urllib.request.urlopen(req, timeout=60) as resp:
                    data = json.load(resp)
            except urllib.error.HTTPError as e:
                if e.code == 409:
                    self.session = e.headers.get('X-Transmission-Session-Id', '')
                    continue
                raise OSError('Transmission answered HTTP %d' % e.code)
            if data.get('result') != 'success':
                raise OSError('Transmission: %s' % data.get('result'))
            return data.get('arguments', {})
        raise OSError('Transmission refused the session')

    def wait(self, seconds=30):
        end = time.monotonic() + seconds
        while True:
            try:
                return self.call('session-get', fields=['version'])
            except OSError as e:
                if time.monotonic() > end:
                    raise OSError('the download service (fliperos-transmission) does not answer: %s' % e)
                time.sleep(1)

    def torrent(self, hash_, fields):
        found = self.call('torrent-get', ids=[hash_], fields=fields).get('torrents', [])
        return found[0] if found else None

    def remove(self, hash_, delete=False):
        self.call('torrent-remove', ids=[hash_], **{'delete-local-data': delete})


