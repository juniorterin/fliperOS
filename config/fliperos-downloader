def state(name):
    return os.path.join(STATE, name)


def give_to_owner(path):
    """O que o Setup (root) grava fica do dono da pasta do estado: o servico
    roda como o usuario e escreve ali no fim do download."""
    if os.geteuid() == 0:
        st = os.stat(STATE)
        try:
            os.chown(path, st.st_uid, st.st_gid)
        except OSError:
            pass


def write_state(name, text):
    os.makedirs(STATE, exist_ok=True)
    tmp = state('.%s.%d.tmp' % (name, os.getpid()))
    with open(tmp, 'w', encoding='utf-8') as f:
        f.write(text)
    give_to_owner(tmp)
    os.replace(tmp, state(name))


def read_state(name):
    try:
        with open(state(name), encoding='utf-8') as f:
            return f.read()
    except OSError:
        return None


def meta_of(kind):
    text = read_state(kind + '.json')
    if not text:
        return None
    meta = json.loads(text)
    if 'sets' not in meta:
        meta['root'], meta['sets'] = find_base(kind, meta['files'])
    return meta


def registered():
    return [k for k in KINDS if meta_of(k)]


def lock():
    os.makedirs(STATE, exist_ok=True)
    f = open(state('.lock'), 'a')
    give_to_owner(state('.lock'))
    fcntl.flock(f, fcntl.LOCK_EX)
    return f


def folder_of(kind, meta):
    """A pasta onde o Transmission poe os sets (a pasta dos sets no torrent)."""
    base = os.path.join(STAGING, kind)
    return os.path.join(base, meta['root']) if meta['root'] else base


def clean_staging(kind):
    """O que sobrou do torrent na pasta dele (cada tipo tem a sua, com um
    torrent so): extras que nao baixaram inteiros e as pastas de cima."""
    base = os.path.join(STAGING, kind)
    if os.path.realpath(base).startswith(os.path.realpath(STAGING) + '/'):
        shutil.rmtree(base, ignore_errors=True)


def find_base(kind, files):
    """(pasta, quantos sets) da pasta do torrent onde estao os sets: na raiz
    ou em qualquer subpasta. ROMs sao .zip/.7z soltos na pasta; CHDs ficam em
    pasta/jogo/disco.chd. Com mais de uma (ROMs e Software Lists, readme,
    extras), vale a que tem mais sets; empate, a mais rasa."""
    count = {}
    for name, _ in files:
        parts = name.split('/')
        if kind == 'roms' and parts[-1].lower().endswith(('.zip', '.7z')):
            base, owner = '/'.join(parts[:-1]), parts[-1]
        elif kind == 'chds' and len(parts) >= 2 and parts[-1].lower().endswith('.chd'):
            base, owner = '/'.join(parts[:-2]), parts[-2]
        else:
            continue
        count.setdefault(base, set()).add(owner.lower())
    if not count:
        return '', 0
    best = min(count, key=lambda b: (-len(count[b]), b.count('/') if b else -1, b))
    return best, len(count[best])


def relative(meta):
    """[(indice, caminho dentro da pasta dos sets, bytes)] dos arquivos do
    torrent que estao nela; o resto do torrent nunca e baixado."""
    prefix = meta['root'] + '/' if meta['root'] else ''
    return [(i, name[len(prefix):], length) for i, (name, length) in enumerate(meta['files'])
            if name.startswith(prefix)]


def read_plan(path):
    """[(set, arquivo, bytes, descricao, pasta de destino)] do que o plano move."""
    out = []
    try:
        with open(path, encoding='utf-8') as f:
            for line in f:
                fields = line.rstrip('\n').split('\t')
                if len(fields) >= 6 and fields[0] == 'move':
                    out.append((fields[1], fields[2], int(fields[3] or 0), fields[4], fields[5]))
    except OSError:
        pass
    return out


def read_args(name):
    text = read_state(name)
    if text is None:
        raise OSError('no filter yet: choose it in Setup > Downloader > Filter')
    return [line for line in text.split('\n') if line]


