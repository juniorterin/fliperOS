def cmd_config(args):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    path = os.path.join(CONFIG_DIR, 'settings.json')
    try:
        with open(path, encoding='utf-8') as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = {}
    data.update(SETTINGS)
    data['download-dir'] = STAGING
    data['script-torrent-done-filename'] = SELF
    with open(path + '.tmp', 'w', encoding='utf-8') as f:
        json.dump(data, f, indent=4, sort_keys=True)
    os.replace(path + '.tmp', path)


def cmd_add(args):
    magnet = args.magnet.strip()
    if not MAGNET.match(magnet):
        sys.exit('fliperos-downloader: not a magnet link (magnet:?xt=urn:btih:...)')
    say(args.progress, '@step 0 Connecting to the download service')
    rpc = Rpc()
    try:
        rpc.wait()
        with lock():
            old = meta_of(args.kind)
            if old:
                try:
                    rpc.remove(old['hash'], delete=True)
                except OSError:
                    pass
            hash_, t = fetch_metadata(rpc, args.kind, magnet, args.progress, args.timeout)
            files = [[f['name'], f['length']] for f in t['files']]
            root, sets = find_base(args.kind, files)
            if not sets:
                rpc.remove(hash_, delete=True)
                raise OSError({'roms': 'this torrent has no ROM sets (.zip or .7z files): is it the CHD link?',
                               'chds': 'this torrent has no CHDs in game folders (game/disk.chd)'}[args.kind])
            meta = {'hash': hash_, 'name': t.get('name') or hash_, 'root': root, 'sets': sets, 'files': files}
            write_state(args.kind + '.json', json.dumps(meta))
            write_state(args.kind + '.magnet', magnet + '\n')
            for stale in (args.kind + '.plan',):
                if os.path.exists(state(stale)):
                    os.remove(state(stale))
    except OSError as e:
        say(args.progress, '@fail Reading the magnet link|%s' % e)
        sys.exit('fliperos-downloader: %s' % e)
    say(args.progress, '@step 100 %d %s found in %s' % (sets, 'sets' if args.kind == 'roms' else 'games',
                                                       root or 'the top of the torrent'))


def cmd_start(args):
    """Aplica o filtro: marca para baixar os arquivos do plano que ainda nao
    estao nas pastas dos emuladores e comeca."""
    say(args.progress, '@step 5 Applying the ROM cleaner filter')
    rpc = Rpc()
    result = []
    try:
        rpc.wait()
        with lock(), tempfile.TemporaryDirectory() as tmp:
            plans = make_plans(tmp)
            for n, kind in enumerate(plans):
                meta = meta_of(kind)
                plan, entries = plans[kind]
                rels = relative(meta)
                wanted, size = [], 0
                for entry in entries:
                    for index, _, target, length in files_of(kind, entry, rels):
                        if not arrived(target, length):
                            wanted.append(index)
                            size += length
                say(args.progress, '@step %d %s: %d files to download (%s)'
                    % (40 + 50 * n // len(plans), LABEL[kind], len(wanted), human(size)))
                t = rpc.torrent(meta['hash'], ['hashString'])
                if wanted and t is None:
                    magnet = (read_state(kind + '.magnet') or '').strip()
                    fetch_metadata(rpc, kind, magnet, args.progress, args.timeout)
                    t = True
                if t is not None:
                    chosen = set(wanted)
                    unwanted = [i for i in range(len(meta['files'])) if i not in chosen]
                    settings = {'files-unwanted': unwanted} if unwanted else {}
                    if wanted:
                        settings['files-wanted'] = wanted
                    rpc.call('torrent-set', ids=[meta['hash']], **settings)
                    if wanted:
                        rpc.call('torrent-start', ids=[meta['hash']])
                    else:
                        rpc.remove(meta['hash'], delete=True)
                shutil.copyfile(plan, state(kind + '.plan'))
                give_to_owner(state(kind + '.plan'))
                result.append('%s\twanted\t%d\t%d\n' % (kind, len(wanted), size))
    except OSError as e:
        say(args.progress, '@fail Starting the download|%s' % e)
        sys.exit('fliperos-downloader: %s' % e)
    if args.result:
        with open(args.result, 'w', encoding='utf-8') as f:
            f.writelines(result)
    else:
        sys.stdout.writelines(result)
    say(args.progress, '@step 100 Downloading')


def plan_sets(entries):
    sizes = {}
    for name, _, size, desc, _ in entries:
        old = sizes.get(name, (0, desc))
        sizes[name] = (old[0] + size, desc)
    return sizes


def installed(kind):
    out = []
    for line in (read_state(kind + '.installed') or '').splitlines():
        name, _, path = line.partition('\t')
        if name and path:
            out.append((name, path))
    return out


def cmd_diff(args):
    """O que o filtro de agora muda no que foi aplicado (KIND.plan): os sets
    que entrariam e os baixados que sairiam. "tipo<TAB>add|remove<TAB>N<TAB>bytes"."""
    try:
        with tempfile.TemporaryDirectory() as tmp:
            plans = make_plans(tmp)
    except OSError as e:
        sys.exit('fliperos-downloader: %s' % e)
    listing = []
    for kind, (_, entries) in plans.items():
        new = plan_sets(entries)
        old = plan_sets(read_plan(state(kind + '.plan'))) if read_state(kind + '.plan') is not None else None
        if old is None:
            continue
        add = sorted(n for n in new if n not in old)
        have = {}
        for name, path in installed(kind):
            have.setdefault(name, []).append(path)
        remove = sorted(n for n in have if n not in new)
        removed_bytes = 0
        for n in remove:
            for path in have[n]:
                try:
                    removed_bytes += os.path.getsize(path)
                except OSError:
                    pass
        print('%s\tadd\t%d\t%d' % (kind, len(add), sum(new[n][0] for n in add)))
        print('%s\tremove\t%d\t%d' % (kind, len(remove), removed_bytes))
        listing += ['+ %-4s %-16s %s' % (LABEL[kind][:-1], n, new[n][1][:52]) for n in add]
        listing += ['- %-4s %-16s %s' % (LABEL[kind][:-1], n, old.get(n, (0, ''))[1][:52]) for n in remove]
    if args.list:
        with open(args.list, 'w', encoding='utf-8') as f:
            f.write('\n'.join(listing) + ('\n' if listing else ''))


def delete_path(path):
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path, ignore_errors=True)
    elif os.path.lexists(path):
        os.remove(path)
    parent = os.path.dirname(path)
    # A pasta do CHD que ficou vazia.
    try:
        if not os.listdir(parent):
            os.rmdir(parent)
    except OSError:
        pass


def cmd_prune(args):
    """Apaga das pastas dos emuladores o que o downloader trouxe e o plano
    aplicado nao escolhe mais."""
    with lock():
        for kind in KINDS:
            keep = plan_sets(read_plan(state(kind + '.plan')))
            left, deleted = [], 0
            for name, path in installed(kind):
                if name in keep:
                    left.append('%s\t%s\n' % (name, path))
                else:
                    delete_path(path)
                    deleted += 1
            if read_state(kind + '.installed') is not None:
                write_state(kind + '.installed', ''.join(left))
            print('%s\tdeleted\t%d' % (kind, deleted))


def cmd_status(args):
    """O andamento, "chave=valor": pct, line (uma linha para a tela), state
    (none, waiting, downloading, done) e o nome de cada torrent."""
    kinds = registered()
    out = {'pct': 0, 'state': 'none', 'line': 'No magnet link yet'}
    for kind in kinds:
        meta = meta_of(kind)
        out['%s_name' % kind] = meta['name']
        out['%s_folder' % kind] = meta['root'] or '/'
        out['%s_sets' % kind] = meta['sets']
    if kinds:
        rpc = Rpc()
        try:
            rpc.wait(3)
        except OSError:
            out.update(state='waiting', line='The download service is not running')
            kinds = []
        total = left = rate = 0
        eta = -1
        parts = []
        active = False
        for kind in kinds:
            t = rpc.torrent(meta_of(kind)['hash'], ['status', 'sizeWhenDone', 'leftUntilDone', 'rateDownload',
                                                    'eta', 'peersConnected', 'errorString'])
            if t is None:
                done = read_state(kind + '.installed') is not None
                parts.append('%s %s' % (LABEL[kind], 'done' if done else 'not started'))
                continue
            active = True
            total += t['sizeWhenDone']
            left += t['leftUntilDone']
            rate += t['rateDownload']
            eta = max(eta, t['eta'])
            text = '%s %s of %s' % (LABEL[kind], human(t['sizeWhenDone'] - t['leftUntilDone']),
                                    human(t['sizeWhenDone']))
            if t.get('errorString'):
                text += ' (%s)' % t['errorString'][:40]
            elif t['status'] == 0:
                text += ' (paused)'
            else:
                text += ', %d peers' % t['peersConnected']
            parts.append(text)
        if kinds:
            out['pct'] = (total - left) * 100 // total if total else 100
            if active:
                out['state'] = 'downloading'
                parts.append('%s/s, %s left' % (human(rate), duration(eta)))
            else:
                out['state'] = 'done' if any(read_state(k + '.installed') is not None for k in kinds) else 'waiting'
                out['pct'] = 100 if out['state'] == 'done' else 0
            out['line'] = '; '.join(parts)
    for key, value in out.items():
        print('%s=%s' % (key, value))


def cmd_finish(args):
    """O fim de um torrent (script-torrent-done do Transmission, ou o Setup):
    cada arquivo completo do plano vai para a pasta do emulador, e o torrent
    que terminou sai do Transmission com o que sobrou na pasta dele."""
    rpc = Rpc()
    try:
        rpc.wait(10)
    except OSError as e:
        sys.exit('fliperos-downloader: %s' % e)
    with lock():
        for kind in KINDS:
            meta = meta_of(kind)
            if not meta:
                continue
            t = rpc.torrent(meta['hash'], ['fileStats', 'leftUntilDone'])
            if t is None:
                continue
            stats = t['fileStats']
            rels = relative(meta)
            folder = folder_of(kind, meta)
            moved = []
            for entry in read_plan(state(kind + '.plan')):
                for index, rel, target, length in files_of(kind, entry, rels):
                    src = os.path.join(folder, rel)
                    if stats[index]['bytesCompleted'] != length or not os.path.isfile(src):
                        continue
                    os.makedirs(os.path.dirname(target), exist_ok=True)
                    if arrived(target, length):
                        os.remove(src)
                    else:
                        shutil.move(src, target)
                        top = os.stat(os.path.dirname(target))
                        try:
                            os.chown(target, top.st_uid, top.st_gid)
                        except OSError:
                            pass
                    moved.append('%s\t%s\n' % (entry[0], target))
            if moved or read_state(kind + '.installed') is None:
                write_state(kind + '.installed', (read_state(kind + '.installed') or '') + ''.join(moved))
            if t['leftUntilDone'] == 0:
                rpc.remove(meta['hash'], delete=True)
                clean_staging(kind)
            with open(state('finish.log'), 'a', encoding='utf-8') as log:
                log.write('%s %s: %d files moved\n' % (time.strftime('%Y-%m-%d %H:%M:%S'), kind, len(moved)))


def cmd_remove(args):
    meta = meta_of(args.kind)
    with lock():
        if meta:
            try:
                rpc = Rpc()
                rpc.wait(5)
                rpc.remove(meta['hash'], delete=True)
            except OSError:
                pass
            clean_staging(args.kind)
        deleted = 0
        if args.delete_files:
            for _, path in installed(args.kind):
                delete_path(path)
                deleted += 1
        for suffix in ('.json', '.magnet', '.plan', '.installed'):
            if os.path.exists(state(args.kind + suffix)):
                os.remove(state(args.kind + suffix))
    print('deleted=%d' % deleted)


def main():
    # O Transmission chama o script do fim do torrent sem argumentos.
    if len(sys.argv) == 1 and os.environ.get('TR_TORRENT_HASH'):
        sys.argv.append('finish')
    parser = argparse.ArgumentParser(prog='fliperos-downloader')
    sub = parser.add_subparsers(dest='cmd', required=True)
    sub.add_parser('config').set_defaults(func=cmd_config)
    p = sub.add_parser('add')
    p.add_argument('kind', choices=KINDS)
    p.add_argument('magnet')
    p.add_argument('--progress', action='store_true')
    p.add_argument('--timeout', type=int, default=600)
    p.set_defaults(func=cmd_add)
    p = sub.add_parser('start')
    p.add_argument('--progress', action='store_true')
    p.add_argument('--result')
    p.add_argument('--timeout', type=int, default=600)
    p.set_defaults(func=cmd_start)
    p = sub.add_parser('diff')
    p.add_argument('--list')
    p.set_defaults(func=cmd_diff)
    sub.add_parser('prune').set_defaults(func=cmd_prune)
    sub.add_parser('status').set_defaults(func=cmd_status)
    sub.add_parser('finish').set_defaults(func=cmd_finish)
    p = sub.add_parser('remove')
    p.add_argument('kind', choices=KINDS)
    p.add_argument('--delete-files', action='store_true')
    p.set_defaults(func=cmd_remove)
    args = parser.parse_args()
    args.func(args)


if __name__ == '__main__':
    main()
