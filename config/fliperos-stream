#!/usr/bin/env bash
# A tela do gabinete ao vivo no painel web (fase 5c): o que esta no tubo
# (jogo, frontend, menu, desktop, console) capturado do DRM pelo ffmpeg
# (kmsgrab), em H.264 e Opus, e entregue ao navegador por WebRTC pelo go2rtc
# (github.com/AlexxIT/go2rtc, MIT). O go2rtc so abre o ffmpeg enquanto alguem
# assiste. A API dele fica so no proprio gabinete: quem conversa com o
# navegador (a oferta do WebRTC) e o config/fliperos-web, com o login do
# painel; o video vai direto ao navegador pela porta 8555 da rede local.
#
# O H.264 e do hardware (VA-API) quando a placa tem o codificador; senao do
# x264 (a R7 240 nao tem: o chip Oland ficou sem o VCE). Em 640x480 o x264 em
# ultrafast quase nao pesa. O som (Setup > Audio Setup > Live screen sound, ou
# o painel) vem de uma copia da saida num loopback do ALSA (lib/audio.sh).
#
#   fliperos-stream fetch [--progress]     baixa o go2rtc (versao fixa, sha256)
#   fliperos-stream installed              status 0 se o go2rtc e o ffmpeg estao la
#   fliperos-stream encoder                vaapi ou x264 (o que a placa faz)
#   fliperos-stream capture FPS SAIDA      o ffmpeg que o go2rtc abre (RTSP em SAIDA)
#   fliperos-stream config                 o go2rtc.yaml
#   fliperos-stream daemon                 o servico (fliperos-stream.service)
#   fliperos-stream status                 installed=, active=, encoder=, audio=
set -uo pipefail

GO2RTC_VERSION=${GO2RTC_VERSION:-1.9.14}
GO2RTC_SHA256=${GO2RTC_SHA256:-32d616af226bd731678ffde328b94cfb94e30339bfefc469cfb76323144615a6}
GO2RTC_URL=${GO2RTC_URL:-https://github.com/AlexxIT/go2rtc/releases/download/v${GO2RTC_VERSION}/go2rtc_linux_amd64}
dir=${FLIPEROS_STREAM_DIR:-/opt/fliperos/go2rtc}
run=${FLIPEROS_STREAM_RUN:-/run/fliperos-stream}
ffmpeg=${FLIPEROS_FFMPEG:-ffmpeg}
sys=${FLIPEROS_SYS:-/sys}
dri=${FLIPEROS_DRI:-/dev/dri}
conf=${FLIPEROS_CONF:-/etc/fliperos/fliperos.conf}
# A biblioteca que faz o ffmpeg devolver a tela logo depois de abrir a placa
# (config/fliperos-dropmaster.c): sem ela, o ffmpeg aberto num momento sem
# dono da tela ficava com ela, e o X e o menu nao abriam mais. Sem a
# biblioteca a captura nao abre.
dropmaster=${FLIPEROS_DROPMASTER:-/usr/local/lib/fliperos/libfliperos-dropmaster.so}
self=$(readlink -f "$0")
# O loopback do ALSA que recebe a copia do som (lib/audio.sh, o id da placa).
AUDIO_LOOP=${FLIPEROS_STREAM_LOOP:-FliperOSLoop}
# Os quadros por segundo de cada stream (o painel escolhe).
RATES="15 30 60"
API=${FLIPEROS_STREAM_API:-127.0.0.1:1984}
WEBRTC_PORT=${FLIPEROS_STREAM_PORT:-8555}

progress=0 label="Live screen"
say() {
  if ((progress)); then printf '@step %s %s\n' "$1" "$2"; else printf '%s\n' "$2"; fi
}
fail() {
  if ((progress)); then printf '@fail %s|%s\n' "$label" "$1"; else printf 'fliperos-stream: %s\n' "$1" >&2; fi
  exit 1
}

installed() {
  [[ -x $dir/go2rtc ]] && command -v "$ffmpeg" > /dev/null
}

fetch() {
  local tmp
  [[ ${1:-} == --progress ]] && progress=1
  mkdir -p "$dir" || fail "could not create $dir"
  tmp=$(mktemp "$dir/go2rtc.XXXXXX") || fail "no space in $dir"
  say 60 "Downloading go2rtc $GO2RTC_VERSION"
  if ! curl -sSfL --retry 3 --max-time 600 -o "$tmp" "$GO2RTC_URL" >&2; then
    rm -f "$tmp"
    fail "the download failed (no network?)"
  fi
  if ! echo "$GO2RTC_SHA256  $tmp" | sha256sum -c --quiet - >&2; then
    rm -f "$tmp"
    fail "the downloaded file is not go2rtc $GO2RTC_VERSION"
  fi
  chmod 755 "$tmp" && mv -f "$tmp" "$dir/go2rtc" || fail "could not install go2rtc"
  say 95 "go2rtc $GO2RTC_VERSION installed"
}

# card: o /dev/dri/cardN da saida que esta ligada (a do tubo).
card() {
  local status name
  for status in "$sys"/class/drm/card[0-9]*-*/status; do
    [[ -f $status && $(cat "$status" 2> /dev/null) == connected ]] || continue
    [[ $(cat "${status%/status}/enabled" 2> /dev/null) == enabled ]] || continue
    name=${status#"$sys"/class/drm/}
    printf '%s/%s\n' "$dri" "${name%%-*}"
    return 0
  done
  printf '%s/card0\n' "$dri"
}

# render: o /dev/dri/renderD* da mesma placa (o VA-API abre por ele).
render() {
  local c=${1##*/} node
  for node in "$sys"/class/drm/"$c"/device/drm/renderD*; do
    [[ -e $node ]] && printf '%s/%s\n' "$dri" "${node##*/}" && return 0
  done
  printf '%s/renderD128\n' "$dri"
}

# encoder: vaapi se a placa codifica H.264 (um quadro de teste), senao x264.
# Fica guardado ate o proximo boot (o /run).
encoder() {
  local cache=$run/encoder node
  if [[ -s $cache ]]; then
    cat "$cache"
    return 0
  fi
  node=$(render "$(card)")
  local enc=x264
  if [[ -e $node ]] && "$ffmpeg" -hide_banner -loglevel error -init_hw_device "vaapi=va:$node" \
    -f lavfi -i color=black:s=256x144:d=0.2 -vf format=nv12,hwupload -c:v h264_vaapi -frames:v 1 -f null - \
    > /dev/null 2>&1; then
    enc=vaapi
  fi
  # Sem poder gravar no /run (fora do root), so nao fica guardado.
  { mkdir -p "$run" && echo "$enc" > "$cache"; } 2> /dev/null
  echo "$enc"
}

# vpp: a placa faz o processamento de video do VA-API (copiar e escalar uma
# superficie). E por ele que o quadro do kmsgrab chega a memoria: o radeon e
# o amdgpu nao deixam mapear o buffer do DRM (o hwdownload direto falha com
# EPERM; visto no gabinete, R7 240). A R7 240 tem o processamento, mesmo sem
# o codificador. Guardado ate o proximo boot.
vpp() {
  local cache=$run/vpp node ok=0
  if [[ -s $cache ]]; then
    [[ $(cat "$cache") == 1 ]]
    return
  fi
  node=$(render "$(card)")
  # Em RGB (bgr0): a copia sai com a cor de cada pixel, para os pixels
  # nitidos (o capture os aumenta depois).
  if [[ -e $node ]] && "$ffmpeg" -hide_banner -loglevel error -init_hw_device "vaapi=va:$node" \
    -f lavfi -i nullsrc=s=64x64:d=0.1 -vf format=nv12,hwupload,scale_vaapi=w=32:h=32:format=bgr0 -f null - \
    > /dev/null 2>&1; then
    ok=1
  fi
  { mkdir -p "$run" && echo "$ok" > "$cache"; } 2> /dev/null
  ((ok))
}

# audio_on: o som da transmissao ligado e o loopback aberto.
audio_on() {
  [[ $(sed -n 's/^stream_audio=//p' "$conf" 2> /dev/null | tail -n 1) == on ]] &&
    grep -q "\[$AUDIO_LOOP *\]" "${FLIPEROS_ASOUND_CARDS:-/proc/asound/cards}" 2> /dev/null
}

# capture FPS SAIDA: o ffmpeg que o go2rtc abre (exec, transporte RTSP). A
# imagem: no maximo 640x480, sempre 4:3. O quadro (640x240, 480i, a super
# resolucao de 2560x240) vai a 640x480 no vizinho mais proximo (no 640x240
# cada linha dobra), em RGB ate ai, e so depois e codificado. A pagina e o OBS
# aumentam o video sem suavizar (image-rendering: pixelated), entao os pixels
# ficam nitidos. Um keyframe por segundo (uma perda no Wi-Fi para a imagem
# no maximo ate ele), sem quadros B (a latencia), no perfil
# que todo navegador decodifica.
#
# A taxa: 1,5 Mbit/s a 15 fps, 2 a 30, 3 a 60, com buffer de meio segundo
# (o keyframe sai com a mesma qualidade dos outros quadros). O WebRTC vai por
# TCP (config): o Wi-Fi USB do gabinete perdia pacotes no UDP e, como o go2rtc
# nao pede keyframe ao ffmpeg, cada perda parava a imagem ate o keyframe
# seguinte (as "engasgadas"; visto no gabinete em 2026-10-23). Um buffer de
# 2 quadros escondia isso, mas o keyframe saia borrado a cada 2 s.
SIZE=640x480
SHARP="scale=640:480:flags=neighbor"
# rate FPS: as opcoes de taxa do codificador.
rate() {
  local kbps=$((1000 + $1 * 1000 / 30))
  echo "-b:v ${kbps}k -maxrate ${kbps}k -bufsize $((kbps / 2))k"
}

# grab FPS PAI: os quadros da tela, ja em 640x480 RGB cru, na saida. O
# kmsgrab para quando o framebuffer muda de tamanho ("framebuffer dimensions
# changed": todo jogo que abre ou fecha num CRT de 15 kHz troca o modo), e o
# go2rtc nao reabre a captura para quem ja assiste: ficava o ultimo quadro do
# frontend parado (visto no gabinete em 2026-10-23). Aqui ele volta a abrir
# no tamanho novo, e a saida segue sempre do mesmo tamanho para o codificador
# (capture), que nao para. Termina quando o PAI (o codificador) sai.
grab() {
  local fps=$1 parent=$2 dev copy
  dev=$(card)
  # O quadro em RGB: copiado pela placa (VA-API) e lido dali; sem o VA-API,
  # mapeado direto (o hwdownload, nas placas que deixam). O VA-API sai do
  # proprio dispositivo DRM do kmsgrab (hwmap derive_device).
  if vpp; then
    copy="hwmap=derive_device=vaapi,scale_vaapi=format=bgr0,hwdownload,format=bgr0"
  else
    copy="hwdownload,format=bgr0"
  fi
  local started
  while :; do
    started=$SECONDS
    LD_PRELOAD=$dropmaster${LD_PRELOAD:+:$LD_PRELOAD} "$ffmpeg" -hide_banner -loglevel error -nostdin \
      -fflags nobuffer -device "$dev" -framerate "$fps" -f kmsgrab -i - \
      -vf "$copy,$SHARP,format=bgr0" -f rawvideo -pix_fmt bgr0 pipe:1 2> "$run/grab.new"
    # Saiu sem chegar a mandar quadros (em ate 1 s): o erro fica para o
    # status (o painel o mostra em vez de esperar o go2rtc desistir). A saida
    # de uma troca de modo, depois de rodar um tempo, nao conta.
    if ((SECONDS - started <= 1)) && [[ -s $run/grab.new ]]; then
      mv -f "$run/grab.new" "$run/grab.err" 2> /dev/null
    else
      rm -f "$run/grab.new" "$run/grab.err" 2> /dev/null
    fi
    # O codificador saiu (um zumbi, ainda sem o wait de quem o abriu, conta
    # como saido: o kill -0 nele ainda da certo).
    kill -0 "$parent" 2> /dev/null || return 0
    grep -q '^State:[[:space:]]*Z' "/proc/$parent/status" 2> /dev/null && return 0
    sleep 0.5
  done
}

capture() {
  local fps=${1:-30} out=${2:-} dev enc
  local -a args bitrate
  [[ $fps =~ ^[0-9]+$ ]] && ((fps >= 5 && fps <= 60)) || fail "frame rate 5 to 60"
  [[ -n $out ]] || fail "no output"
  [[ -f $dropmaster ]] || fail "$dropmaster is missing: the capture could take the screen from X and the menu"
  dev=$(card)
  enc=$(encoder)
  vpp > /dev/null
  # Os quadros do grab pelo fd 3. Os tempos sao os do relogio: a pausa de
  # quando a tela troca de modo nao atrasa a imagem em relacao ao som.
  exec 3< <(grab "$fps" "$$")
  args=(-hide_banner -loglevel warning -nostdin -fflags nobuffer)
  args+=(-f rawvideo -pix_fmt bgr0 -video_size "$SIZE" -framerate "$fps" -use_wallclock_as_timestamps 1 -i pipe:3)
  if audio_on; then
    # O lado de gravacao do loopback pelo dsnoop do asound.conf (lib/audio.sh:
    # o hw so aceita um leitor, e o go2rtc pode abrir mais de um ffmpeg).
    args+=(-thread_queue_size 1024 -f alsa -ac 2 -ar 48000 -i "plug:fliperos_loopcap")
  fi
  args+=(-map 0:v)
  read -r -a bitrate <<< "$(rate "$fps")"
  if [[ $enc == vaapi ]]; then
    # Enviado de volta a placa, que codifica.
    args=(-init_hw_device "vaapi=va:$(render "$dev")" -filter_hw_device va "${args[@]}")
    args+=(-vf "format=nv12,hwupload"
      -c:v h264_vaapi -profile:v constrained_baseline -bf 0 -g "$fps" "${bitrate[@]}")
  else
    args+=(-vf "format=yuv420p"
      -c:v libx264 -preset ultrafast -tune zerolatency -profile:v baseline -bf 0 -g "$fps"
      "${bitrate[@]}")
  fi
  if audio_on; then
    # Os tempos do som contados pelas amostras: os do ALSA chegam aos trancos
    # do loopback, e o Opus jogava fora os pedacos "voltando no tempo" (o som
    # picotado; visto no gabinete, ~90 avisos em 10 s, nenhum com isto).
    args+=(-map 1:a -af "asetpts=N/SR/TB+STARTPTS" -c:a libopus -b:a 96k -application lowdelay -frame_duration 10)
  fi
  args+=(-rtsp_transport tcp -f rtsp "$out")
  exec "$ffmpeg" "${args[@]}"
}

# config: o go2rtc.yaml. A API e o RTSP so no proprio gabinete; o WebRTC na
# rede local, sem STUN de fora (o painel e da rede local), so por TCP: o que
# o Wi-Fi perde volta reenviado em vez de parar a imagem ate o keyframe. Um
# stream por taxa de quadros, cada um aberto so enquanto alguem assiste.
config() {
  local fps
  mkdir -p "$run" || fail "could not create $run"
  # O VA-API e testado de novo a cada inicio: o driver pode ter chegado
  # depois (fliperos-extras, update 23), e o "0" guardado ficava ate o boot.
  rm -f "$run/vpp" "$run/grab.err"
  {
    echo "# Gerado pelo fliperos-stream (config/fliperos-stream)."
    echo "api:"
    echo "  listen: \"$API\""
    echo "  origin: \"\""
    echo "rtsp:"
    echo "  listen: \"127.0.0.1:8554\""
    echo "webrtc:"
    echo "  listen: \":$WEBRTC_PORT/tcp\""
    echo "  ice_servers: []"
    echo "log:"
    echo "  level: warn"
    echo "streams:"
    for fps in $RATES; do
      echo "  cabinet$fps: exec:$self capture $fps {output}#killsignal=15#killtimeout=3"
    done
  } > "$run/go2rtc.yaml"
  printf '%s\n' "$run/go2rtc.yaml"
}

status() {
  local active=0
  installed && echo installed=1 || echo installed=0
  systemctl is-active --quiet fliperos-stream.service 2> /dev/null && active=1
  echo "active=$active"
  installed && echo "encoder=$(encoder)"
  installed && { vpp && echo copy=vaapi || echo copy=mmap; }
  audio_on && echo audio=1 || echo audio=0
  echo "rates=$RATES"
  # O ultimo erro da captura (grab), dos ultimos 10 s, e quando foi.
  if [[ -n $(find "$run/grab.err" -newermt '-10 seconds' 2> /dev/null) ]]; then
    echo "error=$(grep -v -e '^[[:space:]]*$' -e '^ERROR: ld.so:' "$run/grab.err" | head -n 1 | tr -d '\r' | cut -c1-200)"
    echo "error_at=$(stat -c %Y "$run/grab.err" 2> /dev/null)"
  fi
}

case ${1:-} in
  fetch) fetch "${@:2}" ;;
  installed)
    installed
    exit $?
    ;;
  encoder) encoder ;;
  capture) capture "${@:2}" ;;
  config) config > /dev/null ;;
  status) status ;;
  daemon)
    installed || fail "go2rtc or ffmpeg is not installed (Setup > Games > Extras > Live screen)"
    yaml=$(config) || exit 1
    exec "$dir/go2rtc" -config "$yaml"
    ;;
  *)
    sed -n '/^#   fliperos-stream /p' "$0" | sed 's/^# *//' >&2
    exit 1
    ;;
esac
