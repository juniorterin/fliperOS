#!/usr/bin/env bash
# Programas que nao vem na imagem e o Setup > System > Extras instala pela rede: o
# Wine (Model 2 Emulator e os emuladores do Fightcade 2), o Steam e o Heroic
# (GOG). Juntos passavam de 1,5 GB na ISO, e o GitHub aceita ate 2 GiB por
# arquivo. O Steam e o Heroic ja precisam de rede para servir; o Fightcade
# tambem (o fliperos-fightcade fetch instala o Wine junto). A configuracao
# deles (prefixos do Wine, lancadores, atalhos) ja vem na imagem. O
# Pixelcade (marquee de LED/LCD) e codigo fechado: o config/fliperos-pixelcade
# baixa o pixelweb e a arte do GitHub do Pixelcade. O ZeDMD (DMD de LED open
# source) usa o dmdserver do libdmdutil, baixado pelo mesmo helper, e o
# DOFLinx (efeitos no marquee durante o jogo) vem do GitHub dele. O Java do
# apt entra com o Pixelcade: o hi2txt, que le os recordes, e feito nele.
#
#   fliperos-extras list                         nome|instalado (0 ou 1)|descricao
#   fliperos-extras installed NOME               status 0 se instalado
#   fliperos-extras install NOME [--progress]    instala (como root)
#
# Com --progress, as etapas saem no formato da tela de progresso do Setup
# (lib/progress.sh); a saida do apt vai para o stderr (o log do Setup).
set -uo pipefail
# Heroic Games Launcher: o .deb oficial, fixado por hash.
HEROIC_VERSION="2.22.3"
HEROIC_SHA256="f89eed7e0eb900fbe3051edfedbe7532db14328241cbf8c1fb766462dfc0b849"
HEROIC_URL="https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher/releases/download/v${HEROIC_VERSION}/Heroic-${HEROIC_VERSION}-linux-amd64.deb"
# O OpenGL de 32 bits vai junto do Wine: o Direct3D do Wine desenha por ele,
# e sem ele o FBNeo do Fightcade para em "Couldn't initialise DirectX9
# Alternate video output".
WINE_PACKAGES="wine wine64 wine32:i386 libgl1:i386 libgl1-mesa-dri:i386 libglx-mesa0:i386"
# O steam-libs:i386 recomenda "xterm | x-terminal-emulator", e o Alacritty
# (amd64) nao vale para um pacote i386: sem as duas arquiteturas do xterm de
# fora, o apt o trazia de volta.
STEAM_PACKAGES="steam-installer xterm- xterm:i386-"

wine_bin=${FLIPEROS_WINE:-/usr/bin/wine}
steam_bin=${FLIPEROS_STEAM:-/usr/games/steam}
heroic_bin=${FLIPEROS_HEROIC:-/opt/Heroic/heroic}
pixelcade=${FLIPEROS_PIXELCADE:-/opt/fliperos/bin/fliperos-pixelcade}
# As saidas dos jogos para pistolas, placas e LEDs (config/fliperos-outputs):
# o Hook Of The Reaper e um programa de Windows, baixado do site dele pelo
# helper e aberto pelo Wine de 64 bits numa tela virtual (xvfb); o LEDSpicer
# vem do PPA do autor, com a chave dele (fixada, em /usr/local/share/fliperos)
# e um pacote por tipo de placa.
HOTR_PACKAGES="wine wine64 xvfb xauth"
# O QMamehook e compilado na instalacao (o autor so publica o binario de
# Windows): o compilador e o Qt 6 com a porta serial.
QMAMEHOOK_PACKAGES="cmake make g++ qt6-base-dev libqt6serialport6-dev"
outputs=${FLIPEROS_OUTPUTS:-/opt/fliperos/bin/fliperos-outputs}
LEDSPICER_KEY=${FLIPEROS_LEDSPICER_KEY:-/usr/local/share/fliperos/ledspicer-ppa.asc}
LEDSPICER_PPA="https://ppa.launchpadcontent.net/meduzapat/ledspicer/ubuntu"
LEDSPICER_PACKAGES="ledspicer ledspicer-pacled64 ledspicer-pacdrive ledspicer-ultimateio ledspicer-nanoled ledspicer-ledwiz32 ledspicer-howler ledspicer-adalight"

progress=0 label=""
say() {
  if ((progress)); then printf '@step %s %s\n' "$1" "$2"; else printf '%s\n' "$2"; fi
}
fail() {
  if ((progress)); then printf '@fail %s|%s\n' "$label" "$1"; else printf 'fliperos-extras: %s\n' "$1" >&2; fi
  exit 1
}

extras_label() {
  case $1 in
    wine) echo "Wine" ;;
    steam) echo "Steam" ;;
    heroic) echo "Heroic" ;;
    pixelcade) echo "Pixelcade" ;;
    zedmd) echo "ZeDMD" ;;
    doflinx) echo "DOFLinx" ;;
    hotr) echo "Hook Of The Reaper" ;;
    qmamehook) echo "QMamehook" ;;
    ledspicer) echo "LEDSpicer" ;;
  esac
}

extras_installed() {
  case $1 in
    wine) [[ -x $wine_bin ]] ;;
    steam) [[ -x $steam_bin ]] ;;
    heroic) [[ -x $heroic_bin ]] ;;
    pixelcade) [[ -x $pixelcade ]] && "$pixelcade" installed ;;
    zedmd) [[ -x $pixelcade ]] && "$pixelcade" zedmd-installed ;;
    doflinx) [[ -x $pixelcade ]] && "$pixelcade" doflinx-installed ;;
    hotr | qmamehook | ledspicer) [[ -x $outputs ]] && "$outputs" installed "$1" ;;
    *) return 2 ;;
  esac
}

extras_list() {
  local name desc
  while IFS='|' read -r name desc; do
    if extras_installed "$name"; then echo "$name|1|$desc"; else echo "$name|0|$desc"; fi
  done << 'LIST'
wine|Wine (Model 2, Fightcade 2 emulators)
steam|Steam
heroic|Heroic (GOG, Epic, Amazon)
pixelcade|Pixelcade (LED/LCD marquee)
zedmd|ZeDMD (open-source LED DMD)
doflinx|DOFLinx (Pixelcade in-game effects)
hotr|Hook Of The Reaper (game outputs: light guns, boards)
qmamehook|QMamehook (game outputs: serial light guns, native)
ledspicer|LEDSpicer (button LEDs: Ultimarc, LED-Wiz...)
LIST
}

# apt_progress: as linhas do APT::Status-Fd viram etapas, de 10% a
# $apt_end (99%; menos quando o extra ainda baixa algo depois do apt).
apt_end=99
apt_progress() {
  local kind pkg pct text last=-1 p
  while IFS=: read -r kind pkg pct text; do
    case $kind in
      dlstatus) p=$(awk -v x="$pct" -v e="$apt_end" 'BEGIN { printf "%d", 10 + x * (e - 10) * 0.45 / 100 }') ;;
      pmstatus) p=$(awk -v x="$pct" -v e="$apt_end" 'BEGIN { printf "%d", 10 + (e - 10) * 0.45 + x * (e - 10) * 0.55 / 100 }') ;;
      *) continue ;;
    esac
    if ((p != last)); then
      last=$p
      say "$p" "${text:-$pkg}"
    fi
  done
}

# apt_install OPCAO_OU_PACOTE...: apt-get install com o progresso real. A
# arquitetura i386 so entra para quem a usa (o Wine de 32 bits e o Steam).
apt_install() {
  local rc
  export DEBIAN_FRONTEND=noninteractive
  if [[ $label == Steam || " $* " == *:i386* ]] && ! dpkg --print-foreign-architectures | grep -qx i386; then
    dpkg --add-architecture i386 >&2 || fail "could not enable the i386 architecture"
  fi
  say 2 "Updating the package lists"
  apt-get -o DPkg::Lock::Timeout=300 update >&2 || fail "apt-get update failed (no network?)"
  say 10 "Downloading $label"
  apt-get -y -o DPkg::Lock::Timeout=300 -o APT::Status-Fd=3 install "$@" 3>&1 1>&2 | apt_progress
  rc=${PIPESTATUS[0]}
  ((rc == 0)) || fail "apt-get install exited with status $rc (details in the log)"
}

install_heroic() {
  local deb
  deb=$(mktemp /tmp/heroic.XXXXXX.deb) || fail "no space in /tmp"
  say 3 "Downloading Heroic $HEROIC_VERSION"
  if ! curl -sSfL --retry 3 --max-time 900 -o "$deb" "$HEROIC_URL" >&2; then
    rm -f "$deb"
    fail "the download failed (no network?)"
  fi
  if ! echo "$HEROIC_SHA256  $deb" | sha256sum -c --quiet - >&2; then
    rm -f "$deb"
    fail "the downloaded file is not the Heroic $HEROIC_VERSION package"
  fi
  chmod 644 "$deb"
  apt_install --no-install-recommends "$deb"
  rm -f "$deb"
}

extras_install() {
  local name=$1
  label=$(extras_label "$name")
  [[ -n $label ]] || fail "unknown extra: $name (wine, steam, heroic, pixelcade, zedmd, doflinx, hotr, qmamehook or ledspicer)"
  ((EUID == 0)) || fail "installing $label needs root (Setup > System > Extras)"
  case $name in
    # shellcheck disable=SC2086 # um pacote por palavra
    wine) apt_install --no-install-recommends $WINE_PACKAGES ;;
    # shellcheck disable=SC2086
    steam) apt_install $STEAM_PACKAGES ;;
    heroic) install_heroic ;;
    # O Java (o hi2txt le com ele os recordes que rolam no marquee) do apt,
    # ate 15%; o pixelweb, a arte e o hi2txt pelo fetch, dali a 100%.
    pixelcade)
      [[ -x $pixelcade ]] || fail "$pixelcade is missing"
      if ! command -v java > /dev/null; then
        apt_end=15
        apt_install --no-install-recommends default-jre-headless
        export PIXELCADE_PROGRESS_FROM=15
      fi
      if ((progress)); then "$pixelcade" fetch --progress || exit 1; else "$pixelcade" fetch || exit 1; fi
      ;;
    doflinx)
      [[ -x $pixelcade ]] || fail "$pixelcade is missing"
      if ((progress)); then "$pixelcade" fetch-doflinx --progress || exit 1; else "$pixelcade" fetch-doflinx || exit 1; fi
      ;;
    # O dmdserver vem do release do libdmdutil (fetch-zedmd, de 60% a 100%);
    # o Pillow, que desenha a imagem do painel, do apt.
    zedmd)
      [[ -x $pixelcade ]] || fail "$pixelcade is missing"
      if ! python3 -c 'import PIL' 2> /dev/null; then
        apt_end=55
        apt_install --no-install-recommends python3-pil
      fi
      if ((progress)); then "$pixelcade" fetch-zedmd --progress || exit 1; else "$pixelcade" fetch-zedmd || exit 1; fi
      ;;
    # O Wine e a tela virtual do apt, ate 55%; o programa pelo fetch-hotr,
    # dali a 100%. As pistolas e placas USB HID (/dev/hidraw*) passam ao grupo
    # input, o do usuario, que ja le os controles: o Wine as abre por ali.
    hotr)
      [[ -x $outputs ]] || fail "$outputs is missing"
      if [[ ! -x $wine_bin ]] || ! command -v xvfb-run > /dev/null; then
        apt_end=55
        # shellcheck disable=SC2086
        apt_install --no-install-recommends $HOTR_PACKAGES
      fi
      printf '%s\n' '# FliperOS: Hook Of The Reaper (Setup > System > Extras) fala com as pistolas e placas' \
        '# USB HID por aqui.' 'KERNEL=="hidraw*", SUBSYSTEM=="hidraw", GROUP="input", MODE="0660"' \
        > /etc/udev/rules.d/99-fliperos-hotr.rules || fail "could not write the udev rule"
      udevadm control --reload 2> /dev/null && udevadm trigger --subsystem-match=hidraw 2> /dev/null
      if ((progress)); then "$outputs" fetch-hotr --progress || exit 1; else "$outputs" fetch-hotr || exit 1; fi
      ;;
    # O compilador e o Qt do apt, ate 55%; o fonte baixado e compilado pelo
    # fetch-qmamehook, dali a 100%. As pistolas sao portas seriais, do grupo
    # dialout, em que o usuario ja esta.
    qmamehook)
      [[ -x $outputs ]] || fail "$outputs is missing"
      apt_end=55
      # shellcheck disable=SC2086
      apt_install --no-install-recommends $QMAMEHOOK_PACKAGES
      if ((progress)); then "$outputs" fetch-qmamehook --progress || exit 1; else "$outputs" fetch-qmamehook || exit 1; fi
      ;;
    # O servico (ledspicerd) nao e ligado aqui: sem o /etc/ledspicer.conf com
    # as placas e os LEDs do gabinete ele nao abre.
    ledspicer)
      [[ -f $LEDSPICER_KEY ]] || fail "$LEDSPICER_KEY is missing"
      install -Dm644 "$LEDSPICER_KEY" /etc/apt/keyrings/ledspicer.asc &&
        printf 'deb [signed-by=/etc/apt/keyrings/ledspicer.asc] %s %s main\n' "$LEDSPICER_PPA" \
          "$(. /etc/os-release && echo "$VERSION_CODENAME")" > /etc/apt/sources.list.d/ledspicer.list ||
        fail "could not add the LEDSpicer repository"
      # shellcheck disable=SC2086
      apt_install --no-install-recommends $LEDSPICER_PACKAGES
      ;;
  esac
  extras_installed "$name" || fail "$label was installed, but it was not found afterwards"
  say 100 "$label installed"
}

case ${1:-} in
  list) extras_list ;;
  installed)
    extras_installed "${2:-}"
    exit $?
    ;;
  install)
    [[ ${3:-} == --progress ]] && progress=1
    extras_install "${2:-}"
    ;;
  *)
    sed -n '12,14p' "$0" | sed 's/^# *//' >&2
    exit 1
    ;;
esac
