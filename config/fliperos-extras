#!/usr/bin/env bash
# Programas que nao vem na imagem e o Setup > Extras instala pela rede: o
# Wine (Model 2 Emulator e os emuladores do Fightcade 2), o Steam e o Heroic
# (GOG). Juntos passavam de 1,5 GB na ISO, e o GitHub aceita ate 2 GiB por
# arquivo. O Steam e o Heroic ja precisam de rede para servir; o Fightcade
# tambem (o fliperos-fightcade fetch instala o Wine junto). A configuracao
# deles (prefixos do Wine, lancadores, atalhos) ja vem na imagem.
#
#   fliperos-extras list                         nome|instalado (0 ou 1)|descricao
#   fliperos-extras installed NOME               status 0 se instalado
#   fliperos-extras install NOME [--progress]    instala (como root)
#
# Com --progress, as etapas saem no formato da tela de progresso do Setup
# (lib/progress.sh); a saida do apt vai para o stderr (o log do Setup).
set -uo pipefail
# Heroic Games Launcher: o .deb oficial, fixado por hash.
HEROIC_VERSION="2.22.3"
HEROIC_SHA256="f89eed7e0eb900fbe3051edfedbe7532db14328241cbf8c1fb766462dfc0b849"
HEROIC_URL="https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher/releases/download/v${HEROIC_VERSION}/Heroic-${HEROIC_VERSION}-linux-amd64.deb"
# O OpenGL de 32 bits vai junto do Wine: o Direct3D do Wine desenha por ele,
# e sem ele o FBNeo do Fightcade para em "Couldn't initialise DirectX9
# Alternate video output".
WINE_PACKAGES="wine wine64 wine32:i386 libgl1:i386 libgl1-mesa-dri:i386 libglx-mesa0:i386"
# O steam-libs:i386 recomenda "xterm | x-terminal-emulator", e o Alacritty
# (amd64) nao vale para um pacote i386: sem as duas arquiteturas do xterm de
# fora, o apt o trazia de volta.
STEAM_PACKAGES="steam-installer xterm- xterm:i386-"

wine_bin=${FLIPEROS_WINE:-/usr/bin/wine}
steam_bin=${FLIPEROS_STEAM:-/usr/games/steam}
heroic_bin=${FLIPEROS_HEROIC:-/opt/Heroic/heroic}

progress=0 label=""
say() {
  if ((progress)); then printf '@step %s %s\n' "$1" "$2"; else printf '%s\n' "$2"; fi
}
fail() {
  if ((progress)); then printf '@fail %s|%s\n' "$label" "$1"; else printf 'fliperos-extras: %s\n' "$1" >&2; fi
  exit 1
}

extras_label() {
  case $1 in
    wine) echo "Wine" ;;
    steam) echo "Steam" ;;
    heroic) echo "Heroic" ;;
  esac
}

extras_installed() {
  case $1 in
    wine) [[ -x $wine_bin ]] ;;
    steam) [[ -x $steam_bin ]] ;;
    heroic) [[ -x $heroic_bin ]] ;;
    *) return 2 ;;
  esac
}

extras_list() {
  local name desc
  while IFS='|' read -r name desc; do
    if extras_installed "$name"; then echo "$name|1|$desc"; else echo "$name|0|$desc"; fi
  done << 'LIST'
wine|Wine (Model 2, Fightcade 2 emulators)
steam|Steam
heroic|Heroic (GOG, Epic, Amazon)
LIST
}

# apt_progress: as linhas do APT::Status-Fd viram etapas, de 10% a 99%.
apt_progress() {
  local kind pkg pct text last=-1 p
  while IFS=: read -r kind pkg pct text; do
    case $kind in
      dlstatus) p=$(awk -v x="$pct" 'BEGIN { printf "%d", 10 + x * 40 / 100 }') ;;
      pmstatus) p=$(awk -v x="$pct" 'BEGIN { printf "%d", 50 + x * 49 / 100 }') ;;
      *) continue ;;
    esac
    if ((p != last)); then
      last=$p
      say "$p" "${text:-$pkg}"
    fi
  done
}

# apt_install OPCAO_OU_PACOTE...: apt-get install com o progresso real.
apt_install() {
  local rc
  export DEBIAN_FRONTEND=noninteractive
  if ! dpkg --print-foreign-architectures | grep -qx i386; then
    dpkg --add-architecture i386 >&2 || fail "could not enable the i386 architecture"
  fi
  say 2 "Updating the package lists"
  apt-get -o DPkg::Lock::Timeout=300 update >&2 || fail "apt-get update failed (no network?)"
  say 10 "Downloading $label"
  apt-get -y -o DPkg::Lock::Timeout=300 -o APT::Status-Fd=3 install "$@" 3>&1 1>&2 | apt_progress
  rc=${PIPESTATUS[0]}
  ((rc == 0)) || fail "apt-get install exited with status $rc (details in the log)"
}

install_heroic() {
  local deb
  deb=$(mktemp /tmp/heroic.XXXXXX.deb) || fail "no space in /tmp"
  say 3 "Downloading Heroic $HEROIC_VERSION"
  if ! curl -sSfL --retry 3 --max-time 900 -o "$deb" "$HEROIC_URL" >&2; then
    rm -f "$deb"
    fail "the download failed (no network?)"
  fi
  if ! echo "$HEROIC_SHA256  $deb" | sha256sum -c --quiet - >&2; then
    rm -f "$deb"
    fail "the downloaded file is not the Heroic $HEROIC_VERSION package"
  fi
  chmod 644 "$deb"
  apt_install --no-install-recommends "$deb"
  rm -f "$deb"
}

extras_install() {
  local name=$1
  label=$(extras_label "$name")
  [[ -n $label ]] || fail "unknown extra: $name (wine, steam or heroic)"
  ((EUID == 0)) || fail "installing $label needs root (Setup > Extras)"
  case $name in
    # shellcheck disable=SC2086 # um pacote por palavra
    wine) apt_install --no-install-recommends $WINE_PACKAGES ;;
    # shellcheck disable=SC2086
    steam) apt_install $STEAM_PACKAGES ;;
    heroic) install_heroic ;;
  esac
  extras_installed "$name" || fail "$label was installed, but it was not found afterwards"
  say 100 "$label installed"
}

case ${1:-} in
  list) extras_list ;;
  installed)
    extras_installed "${2:-}"
    exit $?
    ;;
  install)
    [[ ${3:-} == --progress ]] && progress=1
    extras_install "${2:-}"
    ;;
  *)
    sed -n '9,11p' "$0" | sed 's/^# *//' >&2
    exit 1
    ;;
esac
