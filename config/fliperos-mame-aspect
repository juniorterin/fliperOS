#!/usr/bin/env bash
# Gera um .ini por jogo com a proporcao certa no CRT de 15 kHz (README,
# "GroovyMAME na resolucao nativa"):
#
#   fliperos-mame-aspect [PASTA]        (padrao: /etc/fliperos/mame/aspect)
#
# A tela e ajustada para 240 linhas encherem a altura; um jogo de 224 (CPS2,
# Neo Geo...) fica 7% mais baixo com a mesma largura e parece esticado na
# horizontal. Para cada jogo de menos de 240 linhas (horizontal, raster) do
# XML do proprio GroovyMAME (-listxml) vai um <jogo>.ini com
#   aspect 320:LINHAS   (a tela "mais larga" na mesma proporcao: 4:3 x 240/linhas)
#   keepaspect 1        (o MAME mantem o 4:3 do jogo)
# O Switchres faz o modo um pouco mais largo (411x224 para 384x224) e o jogo
# ocupa nele os mesmos pontos, 1 para 1, com uma faixa preta fina dos lados.
# Vale tambem para o jogo escolhido na lista do proprio GroovyMAME: o comando
# groovymame poe esta pasta no inipath, depois da principal (um .ini do
# usuario la vale mais). Roda no build e a cada atualizacao do sistema.
set -euo pipefail
out=${1:-/etc/fliperos/mame/aspect}
bin=${FLIPEROS_GROOVYMAME_BIN:-/usr/local/libexec/groovymame}
[[ -x $bin ]] || { echo "GroovyMAME nao instalado: $bin" >&2; exit 1; }
tmp=$(mktemp -d "${out%/}.new.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
"$bin" -listxml 2> /dev/null | awk -v dir="$tmp" '
  /<machine / {
    name = ""; seen = 0
    # Dispositivos (som, CPU...) nao abrem como jogo.
    if ($0 !~ /isdevice="yes"/ && match($0, /name="[^"]*"/)) name = substr($0, RSTART + 6, RLENGTH - 7)
  }
  /<display / && !seen && name != "" {
    seen = 1
    t = ""; r = ""; h = ""
    if (match($0, / type="[^"]*"/)) t = substr($0, RSTART + 7, RLENGTH - 8)
    if (match($0, / rotate="[^"]*"/)) r = substr($0, RSTART + 9, RLENGTH - 10)
    if (match($0, / height="[^"]*"/)) h = substr($0, RSTART + 9, RLENGTH - 10)
    # Acima de 288 linhas e entrelacado: cada campo tem a metade.
    l = h + 0
    if (l > 288) l = int(l / 2)
    if (t == "raster" && (r == "0" || r == "180") && l >= 120 && l < 240 && name ~ /^[a-z0-9_]+$/) {
      f = dir "/" name ".ini"
      printf "# fliperos-mame-aspect: %d linhas, 4:3 no CRT de 15 kHz.\naspect                    320:%d\nkeepaspect                1\n", l, l > f
      close(f)
      n++
    }
  }
  END { print n + 0 }'
[[ -n $(ls -A "$tmp") ]] || { echo "Nenhum jogo no XML do GroovyMAME" >&2; exit 1; }
chmod 755 "$tmp"
rm -rf "$out"
mv "$tmp" "$out"
trap - EXIT
chown -R 1000:1000 "$out" 2> /dev/null || true
