#!/usr/bin/env bash
# Abre um emulador pelo menu do LXDE (Jogos). Os emuladores do FliperOS nao
# rodam dentro do X do desktop: o RetroArch usa o KMS (e troca de modo
# sozinho por jogo); os outros sobem um Xorg proprio no modo da tabela
# /etc/fliperos/emulator-modes.conf (o GroovyMAME troca de modo nele, pelo
# XRandR). Por isso o pedido fica gravado,
# o desktop fecha, o fliperos-session abre o emulador e, quando ele fecha,
# volta para o desktop.
#
#   fliperos-launch retroarch|groovymame|flycast|pcsx2|supermodel|dolphin|openbor|model2|fightcade
#   fliperos-launch --mode 640x240@60 programa [argumentos]   (qualquer programa)
set -euo pipefail

usage() {
  echo "Uso: fliperos-launch retroarch|groovymame|flycast|pcsx2|supermodel|dolphin|openbor|model2|fightcade" >&2
  echo "     fliperos-launch --mode LARGURAxALTURA@HZ programa [argumentos]" >&2
  exit 2
}

x11=/opt/fliperos/bin/fliperos-x11-run
case ${1:-} in
  retroarch) label=RetroArch run=(/opt/fliperos/bin/fliperos-kms-run retroarch) ;;
  groovymame) label=GroovyMAME run=("$x11" groovymame) ;;
  flycast) label=Flycast run=("$x11" flycast) ;;
  pcsx2) label=PCSX2 run=("$x11" pcsx2) ;;
  supermodel) label=Supermodel run=("$x11" supermodel)
    # Sem tela propria, sem jogo o Supermodel fecha na hora: pelo menu, o
    # jogo (o .zip do MAME) se escolhe aqui.
    if [[ $# -ge 2 ]]; then
      run+=("${@:2}")
    else
      rom=$(zenity --file-selection --title="Supermodel - choose a Model 3 game" \
        --filename="$HOME/roms/model3/" --file-filter="Model 3 (zip) | *.zip" 2> /dev/null) || exit 0
      run+=("$rom")
    fi
    ;;
  dolphin) label=Dolphin run=("$x11" dolphin-emu) ;;
  openbor) label=OpenBOR run=("$x11" openbor) ;;
  model2) label="Model 2" run=("$x11" fliperos-model2) ;;
  # O Fightcade se abre no Xorg dele sozinho, como na sessao de boot
  # (config/fliperos-fightcade).
  fightcade) label=Fightcade run=(/opt/fliperos/bin/fliperos-kms-run /opt/fliperos/fightcade/fightcade) ;;
  --mode)
    [[ $# -ge 3 ]] || usage
    label=$(basename -- "$3")
    run=("$x11" --mode "$2" "${@:3}")
    ;;
  *) usage ;;
esac

# open_windows conta as janelas abertas no desktop, fora o proprio desktop
# (pcmanfm) e o painel (lxpanel).
open_windows() {
  local id type n=0
  for id in $(xprop -root _NET_CLIENT_LIST 2> /dev/null | sed -n 's/.*# //p' | tr ',' ' '); do
    type=$(xprop -id "$id" _NET_WM_WINDOW_TYPE 2> /dev/null) || continue
    case $type in
      *_NET_WM_WINDOW_TYPE_DESKTOP* | *_NET_WM_WINDOW_TYPE_DOCK*) continue ;;
    esac
    n=$((n + 1))
  done
  printf '%s\n' "$n"
}

# Com algo aberto, confirma antes: fechar o desktop fecha essas janelas, e o
# que nao foi salvo nelas se perde.
if (($(open_windows) > 0)); then
  # -wrap e o tamanho fixo: sem eles o texto passa da largura de uma tela
  # de 640x480 e fica cortado.
  gxmessage -center -wrap -geometry 520x220 -title "FliperOS" -buttons "Continue:0,Cancel:1" -default "Cancel" \
    "The desktop will close to open $label on the CRT. It comes back when $label closes.

The open windows will be closed, and unsaved work in them will be lost.

Continue?" || exit 0
fi

request="${XDG_RUNTIME_DIR:-/tmp}/fliperos-next"
printf '%s\n' "${run[@]}" > "$request"
# Fecha a sessao do LXDE sem perguntar (o lxsession exporta o proprio PID).
if [[ -n ${_LXSESSION_PID:-} ]]; then
  kill -TERM "$_LXSESSION_PID"
else
  openbox --exit
fi
