#!/usr/bin/env bash
# Abre um emulador pelo menu do LXDE (Jogos). Os emuladores do FliperOS nao
# rodam dentro do X do desktop: o RetroArch usa o KMS (e troca de modo
# sozinho por jogo); os outros sobem um Xorg proprio no modo da tabela
# /etc/fliperos/emulator-modes.conf (o GroovyMAME troca de modo nele, pelo
# XRandR). Por isso o pedido fica gravado,
# o desktop fecha, o fliperos-session abre o emulador e, quando ele fecha,
# volta para o desktop.
#
#   fliperos-launch retroarch|groovymame|flycast|pcsx2|supermodel|dolphin|openbor|model2|sm2emu|fightcade
#   fliperos-launch --mode 640x240@60 programa [argumentos]   (qualquer programa)
set -euo pipefail

usage() {
  echo "Usage: fliperos-launch retroarch|groovymame|flycast|pcsx2|supermodel|dolphin|openbor|model2|sm2emu|fightcade" >&2
  echo "       fliperos-launch --mode WIDTHxHEIGHT@HZ program [arguments]" >&2
  exit 2
}

x11=/opt/fliperos/bin/fliperos-x11-run
model3=${FLIPEROS_MODEL3_DIR:-$HOME/roms/model3}
games_xml=${FLIPEROS_SUPERMODEL_GAMES:-/usr/local/share/supermodel/Config/Games.xml}

# supermodel_games: "nome<TAB>arquivo" dos .zip de ~/roms/model3, pelo nome
# do Games.xml do Supermodel (o .zip que ele nao conhece fica pelo nome).
supermodel_games() {
  python3 - "$model3" "$games_xml" << 'PY'
import os
import sys
import xml.etree.ElementTree as ET

folder, games_xml = sys.argv[1:3]
names = {}
try:
    for game in ET.parse(games_xml).getroot().iter('game'):
        identity = game.find('identity')
        if identity is None:
            continue
        title, version = identity.findtext('title', ''), identity.findtext('version', '')
        names[game.get('name')] = '%s (%s)' % (title, version) if version else title
except (OSError, ET.ParseError):
    pass
try:
    files = [f for f in os.listdir(folder) if f.lower().endswith('.zip')]
except OSError:
    files = []
rows = sorted(((names.get(f[:-4], f[:-4]), os.path.join(folder, f)) for f in files), key=lambda r: r[0].lower())
for label, path in rows:
    print('%s\t%s' % (label, path))
PY
}

# --pick-supermodel ARQUIVO: roda no terminal; a lista dos jogos, e o
# escolhido (o caminho do .zip) vai para ARQUIVO.
if [[ ${1:-} == --pick-supermodel ]]; then
  games=$(supermodel_games)
  if [[ -z $games ]]; then
    printf 'No Model 3 games in %s.\nCopy the MAME .zip files there.\n\nPress Enter to close.' "$model3"
    read -r _
    exit 0
  fi
  gum choose --header "Supermodel - choose a game (Esc cancels)" --height "$(($(tput lines 2> /dev/null || echo 24) - 2))" \
    --label-delimiter $'\t' <<< "$games" > "$2" || true
  exit 0
fi

case ${1:-} in
  retroarch) label=RetroArch run=(/opt/fliperos/bin/fliperos-kms-run retroarch) ;;
  groovymame) label=GroovyMAME run=("$x11" groovymame) ;;
  flycast) label=Flycast run=("$x11" flycast) ;;
  pcsx2) label=PCSX2 run=("$x11" pcsx2) ;;
  supermodel) label=Supermodel run=("$x11" supermodel)
    # Sem tela propria, sem jogo o Supermodel fecha na hora: pelo menu, o
    # jogo (o .zip do MAME) se escolhe aqui, numa lista no terminal.
    if [[ $# -ge 2 ]]; then
      run+=("${@:2}")
    else
      pick=$(mktemp)
      ${FLIPEROS_TERMINAL:-alacritty} -T Supermodel -e bash "$(readlink -f -- "${BASH_SOURCE[0]}")" \
        --pick-supermodel "$pick" || true
      rom=$(< "$pick")
      rm -f "$pick"
      [[ -n $rom ]] || exit 0
      run+=("$rom")
    fi
    ;;
  dolphin) label=Dolphin run=("$x11" dolphin-emu) ;;
  openbor) label=OpenBOR run=("$x11" openbor) ;;
  model2) label="Model 2" run=("$x11" fliperos-model2) ;;
  # O SM2-Emu nao vem compilado: o --pick clona e compila na primeira vez,
  # e a lista dos .zip de ~/roms/model2 sai antes de fechar o desktop.
  sm2emu) label="SM2-Emu"
    bin=${FLIPEROS_SM2_BIN:-$HOME/.local/src/sm2-emu/build/bin/sm2-emu}
    if [[ $# -ge 2 ]]; then
      run=("$x11" "$bin" "${@:2}")
    else
      pick=$(mktemp)
      ${FLIPEROS_TERMINAL:-alacritty} -T "SM2-Emu" -e /usr/local/bin/fliperos-sm2emu --pick "$pick" || true
      rom=$(< "$pick")
      rm -f "$pick"
      [[ -n $rom ]] || exit 0
      run=("$x11" "$bin" "$rom")
    fi
    ;;
  # O Fightcade se abre no Xorg dele sozinho, como na sessao de boot
  # (config/fliperos-fightcade).
  fightcade) label=Fightcade run=(/opt/fliperos/bin/fliperos-kms-run /opt/fliperos/fightcade/fightcade) ;;
  --mode)
    [[ $# -ge 3 ]] || usage
    label=$(basename -- "$3")
    run=("$x11" --mode "$2" "${@:3}")
    ;;
  *) usage ;;
esac

# open_windows conta as janelas abertas no desktop, fora o proprio desktop
# (pcmanfm) e o painel (lxpanel).
open_windows() {
  local id type n=0
  for id in $(xprop -root _NET_CLIENT_LIST 2> /dev/null | sed -n 's/.*# //p' | tr ',' ' '); do
    type=$(xprop -id "$id" _NET_WM_WINDOW_TYPE 2> /dev/null) || continue
    case $type in
      *_NET_WM_WINDOW_TYPE_DESKTOP* | *_NET_WM_WINDOW_TYPE_DOCK*) continue ;;
    esac
    n=$((n + 1))
  done
  printf '%s\n' "$n"
}

# Com algo aberto, confirma antes: fechar o desktop fecha essas janelas, e o
# que nao foi salvo nelas se perde.
if (($(open_windows) > 0)); then
  # -wrap e o tamanho fixo: sem eles o texto passa da largura de uma tela
  # de 640x480 e fica cortado.
  gxmessage -center -wrap -geometry 520x220 -title "FliperOS" -buttons "Continue:0,Cancel:1" -default "Cancel" \
    "The desktop will close to open $label on the CRT. It comes back when $label closes.

The open windows will be closed, and unsaved work in them will be lost.

Continue?" || exit 0
fi

request="${XDG_RUNTIME_DIR:-/tmp}/fliperos-next"
printf '%s\n' "${run[@]}" > "$request"
# Fecha a sessao do LXDE sem perguntar (o lxsession exporta o proprio PID).
if [[ -n ${_LXSESSION_PID:-} ]]; then
  kill -TERM "$_LXSESSION_PID"
else
  openbox --exit
fi
