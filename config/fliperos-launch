#!/usr/bin/env bash
# Abre um emulador pelo menu do LXDE (Jogos). Os emuladores do FliperOS nao
# rodam dentro do X do desktop: o RetroArch e o GroovyMAME usam o KMS (e
# trocam de modo sozinhos por jogo); os outros sobem um Xorg proprio no modo
# da tabela /etc/fliperos/emulator-modes.conf. Por isso o pedido fica gravado,
# o desktop fecha, o fliperos-session abre o emulador e, quando ele fecha,
# volta para o desktop.
#
#   fliperos-launch retroarch|groovymame|flycast|pcsx2|pcsx2x6|duckstation|dolphin|openbor|model2|model3|fightcade|kof
#   fliperos-launch --mode 640x240@60 programa [argumentos]   (qualquer programa)
#   fliperos-launch custom ~/roms/custom/GRUPO/NOME.sh        (um jogo custom)
set -euo pipefail

usage() {
  echo "Usage: fliperos-launch retroarch|groovymame|flycast|pcsx2|pcsx2x6|duckstation|dolphin|openbor|model2|model3|fightcade|kof" >&2
  echo "       fliperos-launch --mode WIDTHxHEIGHT@HZ program [arguments]" >&2
  echo "       fliperos-launch custom GAME.sh" >&2
  exit 2
}

x11=/opt/fliperos/bin/fliperos-x11-run

case ${1:-} in
  retroarch) label=RetroArch run=(/opt/fliperos/bin/fliperos-kms-run retroarch) ;;
  groovymame) label=GroovyMAME run=(/opt/fliperos/bin/fliperos-kms-run groovymame) ;;
  flycast) label=Flycast run=("$x11" flycast) ;;
  pcsx2) label=PCSX2 run=("$x11" pcsx2) ;;
  pcsx2x6) label="PCSX2x6 (Namco)" run=("$x11" pcsx2x6) ;;
  duckstation) label=DuckStation run=("$x11" duckstation) ;;
  dolphin) label=Dolphin run=("$x11" dolphin-emu) ;;
  openbor) label=OpenBOR run=("$x11" openbor) ;;
  # Model 2 e Model 3 no Keisho (o Supermodel saiu). Sem tela propria, sem
  # jogo ele fecha: pelo menu, o .zip se escolhe antes de fechar o desktop,
  # numa lista no terminal (config/fliperos-sm2emu). sm2emu e supermodel sao
  # os atalhos de antes.
  sm2emu) set -- model2 "${@:2}" ;&
  supermodel) [[ $1 == supermodel ]] && set -- model3 "${@:2}" ;&
  model2 | model3)
    system=$1
    label="Model ${system#model}"
    if [[ $# -ge 2 ]]; then
      run=("$x11" "fliperos-$system" "${@:2}")
    else
      pick=$(mktemp)
      ${FLIPEROS_TERMINAL:-alacritty} -T "$label" -e /usr/local/bin/fliperos-sm2emu --pick "$pick" "$system" || true
      rom=$(< "$pick")
      rm -f "$pick"
      [[ -n $rom ]] || exit 0
      run=("$x11" "fliperos-$system" "$rom")
    fi
    ;;
  # O Fightcade se abre no Xorg dele sozinho, como na sessao de boot
  # (config/fliperos-fightcade).
  fightcade) label=Fightcade run=(/opt/fliperos/bin/fliperos-kms-run /opt/fliperos/fightcade/fightcade) ;;
  # O KOF Final Attack no Ikemen GO (Setup > Games > Emulators & Games,
  # config/fliperos-kof), em 320x240.
  kof) label="KOF Final Attack" run=("$x11" /usr/local/bin/fliperos-kof run) ;;
  --mode)
    [[ $# -ge 3 ]] || usage
    label=$(basename -- "$3")
    run=("$x11" --mode "$2" "${@:3}")
    ;;
  # Um jogo custom (o submenu Games > Custom games, lib/customgames.sh
  # customgames_desktop): o comando da ultima linha do NOME.sh dele, o
  # fliperos-x11-run no modo do jogo. Um .sh feito a mao, sem ela, abre pelo
  # sh em 640x480i.
  custom)
    [[ $# -ge 2 && -f $2 ]] || usage
    label=$(basename -- "$2" .sh)
    line=$(grep -m1 '^exec ' -- "$2" || true)
    run=()
    [[ -n $line ]] && eval "run=(${line#exec })"
    [[ ${run[0]:-} == "$x11" ]] || run=("$x11" --mode 640x480@60 /bin/sh "$2")
    ;;
  *) usage ;;
esac

# open_windows conta as janelas abertas no desktop, fora o proprio desktop
# (pcmanfm) e o painel (lxpanel).
open_windows() {
  local id type n=0
  for id in $(xprop -root _NET_CLIENT_LIST 2> /dev/null | sed -n 's/.*# //p' | tr ',' ' '); do
    type=$(xprop -id "$id" _NET_WM_WINDOW_TYPE 2> /dev/null) || continue
    case $type in
      *_NET_WM_WINDOW_TYPE_DESKTOP* | *_NET_WM_WINDOW_TYPE_DOCK*) continue ;;
    esac
    n=$((n + 1))
  done
  printf '%s\n' "$n"
}

# Com algo aberto, confirma antes: fechar o desktop fecha essas janelas, e o
# que nao foi salvo nelas se perde.
if (($(open_windows) > 0)); then
  # -wrap e o tamanho fixo: sem eles o texto passa da largura de uma tela
  # de 640x480 e fica cortado.
  gxmessage -center -wrap -geometry 520x220 -title "FliperOS" -buttons "Continue:0,Cancel:1" -default "Cancel" \
    "The desktop will close to open $label on the CRT. It comes back when $label closes.

The open windows will be closed, and unsaved work in them will be lost.

Continue?" || exit 0
fi

request="${XDG_RUNTIME_DIR:-/tmp}/fliperos-next"
printf '%s\n' "${run[@]}" > "$request"
# Fecha a sessao do LXDE sem perguntar (o lxsession exporta o proprio PID).
if [[ -n ${_LXSESSION_PID:-} ]]; then
  kill -TERM "$_LXSESSION_PID"
else
  openbox --exit
fi
