def core_info(core):
    """(nome, [firmware], nome curto, systemid) do .info do core: o
    display_name, os firmwareN_path (a partir de ~/bios, o system_directory),
    o corename (o "Mesen-S" do nome do console nos frontends) e o systemid
    (mame, fb_alpha: um core de arcade)."""
    name, firmware, short, systemid = core, [], core, ""
    try:
        with open(os.path.join(CORE_INFO, core + "_libretro.info"), encoding="utf-8", errors="replace") as f:
            for line in f:
                key, _, value = line.partition("=")
                key, value = key.strip(), value.strip().strip('"')
                if key == "display_name" and value:
                    name = value
                elif key == "corename" and value:
                    short = value
                elif key == "systemid":
                    systemid = value
                elif key == "supported_extensions":
                    CORE_EXTS[core] = {"." + e.lower() for e in value.split("|") if e}
                elif re.match(r"^firmware\d+_path$", key) and value and ".." not in value.split("/"):
                    firmware.append(value)
    except OSError:
        pass
    return name, firmware, short, systemid


