def retroarch_target(home, core):
    name, firmware, _, _ = core_info(core)
    roms = "roms/retroarch/" + core
    # O OpenBOR (core AnyBOR): os jogos em Paks/, o que o motor grava em Saves/.
    if os.path.isdir(os.path.join(home, roms, "Paks")):
        roms += "/Paks"
    deps = "mame2010" if core == "mame2010" else ("groovymame" if re.match(r"^(mame|fbneo|fbalpha)", core) else "")
    return target("retroarch-" + core, "RetroArch: " + name, [roms],
                  bios=["bios/mame"] if deps else [], bios_files=["bios/" + f for f in firmware], deps=deps,
                  nvram=["nvram/retroarch/" + core], save=["save/retroarch"],
                  save_extra=["roms/retroarch/anybor/Saves"] if core == "anybor" else [],
                  cheats=["cheats/retroarch"], config=[".config/retroarch/config"], depth=2)


