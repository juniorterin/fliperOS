def player_home():
    try:
        return pwd.getpwnam(USER).pw_dir
    except KeyError:
        return os.path.expanduser("~")


def owner():
    try:
        p = pwd.getpwnam(USER)
        return p.pw_uid, p.pw_gid
    except KeyError:
        return None


def give(path):
    """O arquivo do jogador (o Setup e o painel rodam como root)."""
    who = owner()
    if who and os.geteuid() == 0:
        try:
            os.lchown(path, *who)
        except OSError:
            pass


def makedirs(path):
    missing = []
    while path and not os.path.isdir(path):
        missing.append(path)
        path = os.path.dirname(path)
    for p in reversed(missing):
        os.mkdir(p)
        give(p)


class Progress:
    def __init__(self, on, start=0, end=100):
        self.on, self.start, self.end, self.last = on, start, end, None

    def pct(self, frac):
        return int(self.start + (self.end - self.start) * max(0.0, min(1.0, frac)))

    def step(self, frac, text):
        if self.on:
            print("@step %d %s" % (self.pct(frac), text), flush=True)

    def tick(self, frac):
        p = self.pct(frac)
        if self.on and p != self.last:
            self.last = p
            print("@pct %d" % p, flush=True)

    def fail(self, title, why):
        if self.on:
            print("@fail %s|%s" % (title, why), flush=True)


