def batocera_table():
    """{nome: rotulo} dos consoles que o FliperOS conhece num Batocera
    (config/batocera-systems.list: nome|rotulo|plataforma|padrao|tambem)."""
    out = {}
    try:
        with open(BATOCERA_TABLE, encoding="utf-8", errors="replace") as f:
            for line in f:
                cols = line.rstrip("\n").split("|")
                if len(cols) >= 4 and cols[0] and not cols[0].startswith("#") and cols[3]:
                    out[cols[0]] = cols[1] or cols[0]
    except OSError:
        pass
    return out


def unescape_mount(text):
    """O caminho de uma linha do /proc/mounts (o espaco vem como \\040)."""
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), text)


class NetShares:
    """As pastas da rede guardadas (lib/netshare.sh, um .mount + .automount
    cada). Com o servidor desligado, cada acesso a uma delas espera a montagem
    desistir (uns 10 s, de novo a cada console): quem passa pelos consoles
    pergunta antes, como o netshare_offline. Montada, nunca esta desligada; a
    resposta vale para o processo todo."""

    def __init__(self):
        self.hosts, self.state = {}, {}
        for unit in sorted(glob.glob(os.path.join(NETSHARE_UNITS, "*.mount"))):
            try:
                with open(unit, encoding="utf-8", errors="replace") as f:
                    lines = [ln.strip() for ln in f]
            except OSError:
                continue
            if NETSHARE_MARK not in lines:
                continue
            fields = dict(ln.split("=", 1) for ln in lines if "=" in ln and not ln.startswith("#"))
            what, where = fields.get("What", ""), fields.get("Where", "").rstrip("/")
            if what.startswith("//") and where:
                self.hosts[where] = what[2:].split("/", 1)[0]

    @staticmethod
    def mounted(where):
        try:
            with open("/proc/self/mounts", encoding="utf-8", errors="replace") as f:
                for line in f:
                    cols = line.split()
                    if len(cols) > 2 and cols[2] in ("cifs", "smb3") and unescape_mount(cols[1]) == where:
                        return True
        except OSError:
            pass
        return False

    @staticmethod
    def reachable(host):
        import socket
        for port in (445, 139):
            try:
                socket.create_connection((host, port), timeout=2).close()
                return True
            except socket.timeout:
                return False
            except OSError:
                continue
        return False

    def offline(self, path):
        for where, host in self.hosts.items():
            if path == where or path.startswith(where + "/"):
                if where not in self.state:
                    self.state[where] = not self.mounted(where) and not self.reachable(host)
                return self.state[where]
        return False


def batocera_targets(home, base):
    """Os consoles do Batocera filesystem em uso (lib/batocera.sh:
    SISTEMA<tab>PASTA<tab>ESCOLHA no batocera.list), um alvo cada. Os jogos
    ficam onde estao; no pacote, cada caminho e o de quem os abre (src: o
    caminho do pacote -> o de verdade): o snes com retroarch/mesen-s e
    roms/retroarch/mesen-s, e a arte da chave batocera/snes vai como
    media/<tipo>/retroarch/mesen-s. A escolha que nenhum alvo abre fica de fora."""
    table = batocera_table()
    try:
        with open(os.path.join(home, BATOCERA_LIST), encoding="utf-8", errors="replace") as f:
            rows = [ln.rstrip("\n").split("\t") for ln in f]
    except OSError:
        return []
    shares, out, seen = NetShares(), [], set()
    media = media_types(home)
    for row in rows:
        if len(row) != 3:
            continue
        system, folder, choice = row
        folder = folder.rstrip("/")
        if system not in table or system in seen or not folder.startswith("/") or not choice \
                or choice.startswith("batocera/") or ".." in choice.split("/"):
            continue
        if choice == "openbor":
            choice = "retroarch/anybor"
        # O que conta como jogo, como no frontend (batocera_count): so arquivos, com
        # as extensoes do core e o .zip/.7z (batocera_zip); com um emulador do
        # FliperOS, tudo menos os documentos que acompanham os jogos.
        exts = None
        if choice.startswith("retroarch/"):
            core = choice[len("retroarch/"):]
            if not re.match(r"^[A-Za-z0-9_.+-]+$", core):
                continue
            base_t, detail = retroarch_target(home, core), core_info(core)[2]
            rdir = "roms/retroarch/anybor/Paks" if core == "anybor" else "roms/retroarch/" + core
            if CORE_EXTS.get(core):
                exts = CORE_EXTS[core] | {".zip", ".7z"}
        else:
            rdir = "roms/" + choice
            base_t = next((t for t in base if rdir in t["roms"]), None)
            if base_t is None:
                continue
            detail = base_t["label"].split(" (")[0]
        # Com o servidor da rede desligado, cada pasta esperaria a montagem desistir.
        if shares.offline(folder) or not os.path.isdir(folder):
            continue
        seen.add(system)
        key = "batocera/" + system
        t = dict(base_t)
        # A arte de ~/media/TIPO/batocera/CONSOLE; depois do batocera_refresh, a dos
        # atalhos (a daqui e, onde ela falta, a que o Batocera guarda ao lado dos jogos).
        t.update(id="batocera-" + re.sub(r"[^a-z0-9-]+", "-", system.lower()),
                 label="%s (%s)" % (table[system], detail), pkg=base_t["id"], pkg_label=base_t["label"],
                 roms=[rdir], companions=[], shown=[folder], keys={media_key(rdir): key}, files_only=True, exts=exts,
                 batocera=(key, folder),
                 src=[(rdir, folder)] + [("media/%s/%s" % (m, media_key(rdir)), os.path.join(home, "media", m, key))
                                         for m in media])
        # Os saves que o Batocera fez (saves/CONSOLE/JOGO.srm, .state...): no pacote, onde o
        # RetroArch do FliperOS os le (save/retroarch, sem pasta por core).
        if base_t["id"].startswith("retroarch-"):
            t["saves_from"] = (os.path.join(os.path.dirname(os.path.dirname(folder)), "saves", system),
                               "save/retroarch")
        out.append(t)
    return out


def batocera_media_root(home):
    return ENV("FLIPEROS_BATOCERA_MEDIA") or os.path.join(home, ".local", "share", "fliperos", "batocera-media")


def batocera_tool_env(home):
    return dict(os.environ, FLIPEROS_HOME=home, FLIPEROS_BATOCERA_MEDIA=batocera_media_root(home))


def batocera_refresh(home, t):
    """Num console do Batocera filesystem: os atalhos para a arte do Batocera e
    as descricoes do gamelist.xml em dia (config/fliperos-batocera-media), e a
    arte do pacote passa a vir dos atalhos, que tem a daqui por cima (sem eles,
    fica a de ~/media)."""
    if not t.get("batocera"):
        return
    key, folder = t["batocera"]
    try:
        subprocess.run(["python3", BATOCERA_MEDIA_TOOL, "refresh", key, folder, "-", "-"], env=batocera_tool_env(home),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=600)
    except (OSError, subprocess.SubprocessError):
        return
    # Os tipos de agora: a atualizacao pode ter criado pastas (a das descricoes).
    pkg_key = media_key(t["roms"][0])
    src = [(p, s) for p, s in t["src"] if not p.startswith("media/")]
    for m in media_types(home):
        farm = os.path.join(batocera_media_root(home), m, key)
        own = os.path.join(home, "media", m, key)
        src.append(("media/%s/%s" % (m, pkg_key), farm if m in BATOCERA_MEDIA_TYPES and os.path.isdir(farm) else own))
    t["src"] = src


def batocera_save_names(t):
    """Os arquivos da pasta de saves do Batocera do console (saves/CONSOLE),
    lidos uma vez."""
    if "_save_names" not in t:
        src = (t.get("saves_from") or ("", ""))[0]
        t["_save_names"] = sorted(e.name for e in listdir(src) if not e.name.startswith(".") and e.is_file()) \
            if src else []
    return t["_save_names"]


def batocera_meta(home, t, stems):
    """{jogo: {campo: valor}} do gamelist.xml de um console do Batocera filesystem."""
    if not t.get("batocera") or not stems:
        return {}
    key, folder = t["batocera"]
    try:
        done = subprocess.run(["python3", BATOCERA_MEDIA_TOOL, "meta", key, folder] + list(stems),
                              env=batocera_tool_env(home), capture_output=True, text=True, timeout=300)
        data = json.loads(done.stdout) if done.returncode == 0 else {}
    except (OSError, subprocess.SubprocessError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def real(home, t, rel):
    """O caminho de verdade de um caminho do pacote (a partir da home): o de um
    console do Batocera filesystem esta no disco dele (t["src"]); um arquivo
    que vai noutro lugar no pacote (t["map"]: os saves do Batocera), o dele."""
    hit = (t or {}).get("map", {}).get(rel)
    if hit:
        return hit
    for pkg, src in (t or {}).get("src", ()):
        if rel == pkg or rel.startswith(pkg + "/"):
            return src + rel[len(pkg):]
    return os.path.join(home, rel)


def system_key(t, rdir):
    """A chave do sistema nos frontends (as listas, a arte, os metadados) de uma
    pasta do alvo: a do pacote, ou batocera/<console>."""
    key = media_key(rdir)
    return t.get("keys", {}).get(key, key)


def find_target(home, tid):
    for t in all_targets(home):
        if t["id"] == tid:
            return t
    raise Bad("no such emulator or core: %s" % tid)


def media_key(roms_dir):
    """A pasta de ~/media/<tipo> de uma pasta de ROMs (roms/mame -> mame; o
    Paks/ do OpenBOR nao conta)."""
    key = roms_dir[len("roms/"):] if roms_dir.startswith("roms/") else roms_dir
    for tail in ("/Paks", "/roms"):
        if key.endswith(tail):
            key = key[: -len(tail)]
    return key


def media_types(home):
    """Os tipos de arte: as pastas de ~/media e as dos atalhos para a arte do
    Batocera (batocera_media_root)."""
    out = set()
    for root in (os.path.join(home, "media"), batocera_media_root(home)):
        try:
            out |= {e.name for e in os.scandir(root) if e.is_dir() and not e.name.startswith(".")}
        except OSError:
            pass
    return sorted(out)


# ── Os jogos de uma pasta ──

def listdir(path):
    try:
        return list(os.scandir(path))
    except OSError:
        return []


def stem_of(name, is_dir):
    if is_dir:
        return name
    root, ext = os.path.splitext(name)
    return root if ext else name


def referenced(full):
    """Os arquivos que um .cue, .gdi, .m3u ou .acgame chama (nomes relativos
    a pasta dele)."""
    ext = os.path.splitext(full)[1].lower()
    out = []
    # So esses tipos chamam outros arquivos: os outros (uma ROM .zip de
    # megabytes) nem sao abertos.
    if ext not in (".cue", ".gdi", ".m3u", ".acgame"):
        return out
    try:
        with open(full, encoding="utf-8", errors="replace") as f:
            text = f.read(1 << 20)
    except OSError:
        return out
    if ext == ".cue":
        out = re.findall(r'^\s*FILE\s+"([^"]+)"', text, re.M | re.I) or \
            re.findall(r"^\s*FILE\s+(\S+)", text, re.M | re.I)
    elif ext == ".gdi":
        for line in text.splitlines()[1:]:
            m = re.match(r'^\s*\d+\s+\d+\s+\d+\s+\d+\s+(?:"([^"]+)"|(\S+))', line)
            if m:
                out.append(m.group(1) or m.group(2))
    elif ext == ".m3u":
        out = [ln.strip() for ln in text.splitlines() if ln.strip() and not ln.startswith("#")]
    elif ext == ".acgame":
        m = re.search(r"^\s*subdir\s*=\s*(.+?)\s*$", text, re.M)
        if m:
            out.append(m.group(1))
    return [r for r in (x.replace("\\", "/") for x in out) if r and ".." not in r.split("/") and not r.startswith("/")]


def not_a_game(name):
    """O que fica numa pasta de ROMs sem ser jogo: o _info.txt, o download pela
    metade, a lista e a arte que o Batocera poe ao lado dos jogos (images/,
    videos/, gamelist.xml), numa pasta dele ou num atalho para ela."""
    return name in SKIP_NAMES or name.startswith(".") or name.lower().endswith(PARTIAL_EXTS) \
        or name in BATOCERA_NOT_GAMES or bool(BATOCERA_NOT_GAMES_RE.match(name))


def scan_games(home, t):
    """{nome: {"dir": pasta, "entries": [nomes]}}: os jogos das pastas do
    alvo. O nome e o da ROM sem a extensao (sf2), ou o arquivo inteiro
    quando dois jogos dariam o mesmo nome em pastas diferentes."""
    games = {}
    for rdir in t["roms"]:
        entries = [e for e in listdir(real(home, t, rdir)) if not not_a_game(e.name)]
        by_stem = {}
        for e in entries:
            try:
                is_dir = e.is_dir()
            except OSError:
                continue
            # Um console do Batocera filesystem: o que o frontend mostra dele.
            if t.get("files_only"):
                ext = os.path.splitext(e.name)[1].lower()
                if is_dir or (t["exts"] is not None and ext not in t["exts"]) or ext in DOC_EXTS:
                    continue
            by_stem.setdefault(stem_of(e.name, is_dir), []).append(e.name)
        # O que um .cue/.gdi/.m3u/.acgame chama nao e um jogo a parte.
        used = set()
        for e in entries:
            if os.path.splitext(e.name)[1].lower() in (".cue", ".gdi", ".m3u", ".acgame"):
                for r in referenced(e.path):
                    used.add(r.split("/")[0])
        for stem, names in by_stem.items():
            if all(n in used for n in names):
                continue
            key = stem
            if key in games:
                key = "%s (%s)" % (stem, media_key(rdir))
            games[key] = {"dir": rdir, "stem": stem, "entries": sorted(names)}
    return games


def tree(home, rel, t=None):
    """[(caminho a partir da home, tamanho)] de um arquivo ou de uma pasta
    inteira (sem seguir os atalhos de dentro dela). O caminho e o do pacote;
    o arquivo, o de verdade (real: o console do Batocera filesystem)."""
    full = real(home, t, rel)
    out = []
    if os.path.isdir(full):
        for top, dirs, files in os.walk(full):
            dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(top, d))]
            for n in files:
                p = os.path.join(top, n)
                try:
                    st = os.stat(p)
                except OSError:
                    continue
                if stat.S_ISREG(st.st_mode):
                    out.append((rel + "/" + os.path.relpath(p, full).replace(os.sep, "/"), st.st_size))
    else:
        try:
            st = os.stat(full)
            if stat.S_ISREG(st.st_mode):
                out.append((rel, st.st_size))
        except OSError:
            pass
    return out


def game_rom_files(home, t, game):
    """Os arquivos da ROM de um jogo: as entradas dele na pasta, o que elas
    chamam (as faixas de um .cue) e as pastas irmas (vldp/ do Hypseus)."""
    rdir, files = game["dir"], []
    for n in game["entries"]:
        files += tree(home, rdir + "/" + n, t)
        for r in referenced(real(home, t, rdir + "/" + n)):
            files += tree(home, rdir + "/" + r, t)
    for c in t["companions"]:
        files += tree(home, c + "/" + game["stem"], t)
    return files


class Index:
    """Os nomes de uma pasta por nome de jogo: o arquivo sf2.png, o
    sf2.zip.nvmem e a pasta sf2/ sao do jogo sf2. Com depth 2, tambem os das
    subpastas (os saves do RetroArch ficam numa pasta por core)."""

    def __init__(self, home, rel, depth=1, t=None):
        self.map = {}
        dirs = [rel]
        if depth > 1:
            dirs += [rel + "/" + e.name for e in listdir(real(home, t, rel))
                     if e.is_dir(follow_symlinks=False) and not e.name.startswith(".")]
        for d in dirs:
            for e in listdir(real(home, t, d)):
                if e.name in SKIP_NAMES:
                    continue
                n = e.name
                keys = {n}
                i = n.find(".")
                while i > 0:
                    keys.add(n[:i])
                    i = n.find(".", i + 1)
                for k in keys:
                    self.map.setdefault(k, []).append(d + "/" + n)

    def get(self, stem):
        return self.map.get(stem, [])


def related_dirs(home, t):
    """{tipo: [(pasta, profundidade)]} das pastas onde ha arquivos com o nome
    do jogo."""
    out = {"nvram": [(d, 1) for d in t["nvram"]], "save": [(d, t["depth"]) for d in t["save"]] +
           [(d, 1) for d in t.get("save_extra", [])], "cheats": [(d, t["depth"]) for d in t["cheats"]],
           "config": [(d, t["depth"]) for d in t["config"]]}
    out["media"] = [("media/%s/%s" % (m, media_key(r)), 1) for m in media_types(home) for r in t["roms"]]
    return out


def indexes(home, t):
    return {kind: [(d, Index(home, d, depth, t)) for d, depth in dirs] for kind, dirs in related_dirs(home, t).items()}


def shared_bios(home, t):
    """Os arquivos de BIOS do alvo que nao dependem do jogo: as pastas
    inteiras (bios/dc do Flycast), os firmware do .info do core e os nomes de
    BIOS do PlayStation."""
    files = []
    for d in t["bios_files"]:
        files += [(p, s) for p, s in tree(home, d) if not p.endswith("/_info.txt")]
    for g in t["bios_globs"]:
        for p in sorted(glob.glob(os.path.join(home, g))):
            files += tree(home, os.path.relpath(p, home).replace(os.sep, "/"))
    return files


def shared_saves(home, t):
    files = []
    for d in t["save_all"]:
        files += [(p, s) for p, s in tree(home, d) if not p.endswith("/_info.txt")]
    return files


# ── As dependencias dos sets do MAME ──

def romclean():
    loader = importlib.machinery.SourceFileLoader("fliperos_romclean", ROMCLEAN)
    spec = importlib.util.spec_from_loader("fliperos_romclean", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def mame_dependencies(kind, names, progress):
    """Os sets de que os jogos precisam (o pai, a BIOS e os dispositivos),
    pelo XML do MAME do alvo (o do cache do ROM cleaner; sem ele, o -listxml,
    que leva um minuto). None: nao deu para saber."""
    if not names or not os.path.exists(ROMCLEAN):
        return None
    try:
        mod = romclean()
    except Exception:  # noqa: BLE001 - um romclean quebrado nao para o pacote
        return None
    a = argparse.Namespace(xml=None, xml_command=None, cache=None)
    if kind == "mame2010":
        if not os.path.exists(MAME2010_XML):
            return None
        a.xml, a.cache = MAME2010_XML, os.path.join(ROMCLEAN_CACHE, "romclean-mame2010.json")
    else:
        caches = sorted(glob.glob(os.path.join(ROMCLEAN_CACHE, "romclean-groovymame-*.json")), key=os.path.getmtime)
        if caches:
            a.cache = caches[-1]
        else:
            progress.step(0.03, "Reading the MAME game list (about a minute)")
            a.xml_command = GROOVYMAME + " -listxml"
            if not any(os.access(os.path.join(p, GROOVYMAME), os.X_OK) for p in os.environ.get("PATH", "").split(":")) \
                    and not os.access(GROOVYMAME, os.X_OK):
                return None
    try:
        machines = mod.load_machines(a)
    except SystemExit:
        return None
    except Exception:  # noqa: BLE001
        return None
    lower = {n.lower() for n in names}
    return {d for d in mod.dependencies(machines, lower) if d not in lower}


def dependency_files(home, t, deps):
    """Onde cada set dependente esta: nas pastas de ROMs do alvo (o pai de um
    clone vai como ROM) ou nas de BIOS (vai como BIOS)."""
    roms, bios = [], []
    places = [(d, roms) for d in t["roms"]] + [(d, bios) for d in t["bios"] + ["roms/mame"]]
    for dep in sorted(deps):
        for d, where in places:
            hit = [e.name for e in listdir(real(home, t, d))
                   if e.name.lower() in (dep, dep + ".zip", dep + ".7z")]
            if hit:
                for n in hit:
                    where.extend(tree(home, d + "/" + n, t))
                break
    return roms, bios


# ── Listar ──

def cmd_targets(args):
    home = args.home
    out = []
    for t in all_targets(home):
        games = scan_games(home, t)
        if not games and not args.all:
            continue
        out.append({"id": t["id"], "label": t["label"], "folders": t.get("shown", t["roms"]), "games": len(games),
                    "name": "%s.fliperos-%s.zip" % ("TITLE", t.get("pkg", t["id"])),
                    "arcade": any(is_arcade(r) for r in t["roms"])})
    if args.text:
        for row in out:
            print("%s|%s|%d" % (row["id"], row["label"].replace("|", "/"), row["games"]))
        return 0
    json.dump(out, sys.stdout, ensure_ascii=False)
    print()
    return 0


def game_summary(home, t, name, game, idx, has_bios):
    files = game_rom_files(home, t, game)
    have = {}
    for kind, lst in idx.items():
        hits = [p for _, ix in lst for p in ix.get(game["stem"])]
        if kind == "media":
            have["media"] = sorted({p.split("/")[1] for p in hits})
        else:
            have[kind] = bool(hits)
    if not have.get("save") and t.get("saves_from"):
        stem = game["stem"]
        have["save"] = any(n == stem or n.startswith(stem + ".") for n in batocera_save_names(t))
    have["bios"] = has_bios
    return {"name": name, "stem": game["stem"], "key": system_key(t, game["dir"]), "files": game["entries"],
            "folder": game["dir"], "bytes": sum(s for _, s in files), "has": have,
            "group_ok": launch_argv(media_key(game["dir"]), game["stem"], "x") is not None}


def cmd_games(args):
    home = args.home
    try:
        t = find_target(home, args.target)
    except Bad as exc:
        print(str(exc), file=sys.stderr)
        return 1
    batocera_refresh(home, t)
    games = scan_games(home, t)
    if args.media_types:
        # Os tipos de arte (as pastas de ~/media) que algum jogo do alvo tem, um por linha.
        found = {p.split("/")[1] for _, ix in indexes(home, t)["media"] for g in games.values() for p in ix.get(g["stem"])}
        order = ["snap", "preview", "logo", "box", "marquee", "dmd", "texto"]
        for m in [m for m in order if m in found] + sorted(found - set(order)):
            print(m)
        return 0
    if args.text:
        # NOME|BYTES (o Setup no gabinete: so o nome e o tamanho da ROM).
        for n, g in sorted(games.items(), key=lambda kv: kv[0].lower()):
            print("%s|%d" % (n.replace("|", "/"), sum(s for _, s in game_rom_files(home, t, g))))
        return 0
    idx = indexes(home, t)
    has_bios = bool(t["bios"] and t["deps"]) or bool(shared_bios(home, t))
    out = [game_summary(home, t, n, g, idx, has_bios) for n, g in sorted(games.items(), key=lambda kv: kv[0].lower())]
    # Os tipos de arte que os jogos deste alvo tem (cada um uma escolha na tela).
    found = {m for g in out for m in g["has"].get("media", [])}
    order = ["snap", "preview", "logo", "box", "marquee", "dmd", "texto"]
    media = [m for m in order if m in found] + sorted(found - set(order))
    json.dump({"target": t["id"], "label": t["label"], "folders": t.get("shown", t["roms"]), "games": out,
               "arcade": any(is_arcade(r) for r in t["roms"]), "media_types": media,
               "kinds": list(KINDS), "shared_save": bool(shared_saves(home, t))}, sys.stdout, ensure_ascii=False)
    print()
    return 0


# ── O grupo proprio ──
# Um pacote pode trazer um grupo (group=): nos frontends, um sistema com o nome
# dele e o logotipo de sistema escolhido. E um grupo do Game Packages
# (~/roms/custom/GRUPO, o mesmo dos jogos de PC, lib/customgames.sh): um
# TITULO.sh por jogo que abre a ROM no emulador dela, com o mesmo comando que o
# frontend usa na pasta do emulador (scraper_attract_emulator); o
# GRUPO/.logo.png (fliperos-syslogo) e a arte ligada em
# ~/media/TIPO/custom/GRUPO. A ROM fica na pasta do emulador.

X11 = ENV("FLIPEROS_X11_RUN", os.path.join(BIN, "fliperos-x11-run"))
KMS = ENV("FLIPEROS_KMS_RUN", os.path.join(BIN, "fliperos-kms-run"))
RA_CORES = ENV("RA_CORES_DIR", "/opt/fliperos/retroarch/cores")
SYSLOGO = ENV("FLIPEROS_SYSLOGO", os.path.join(BIN, "fliperos-syslogo"))
GROUP_HEAD = "# FliperOS ROM package group (Game Packages > ROMs)."
# O arquivo que abre um jogo de muitos (o .cue das faixas, o .m3u dos discos).
MAIN_EXTS = (".m3u", ".cue", ".gdi", ".acgame", ".chd", ".iso", ".zip", ".7z")


def launch_argv(key, stem, path):
    """O comando que abre o jogo (o de scraper_attract_emulator para a pasta
    KEY), ou None (o Hypseus, sem um comando por jogo)."""
    by_name = {"mame": "groovymame", "hbmame": "hbgroovymame", "model2": "fliperos-model2", "odin": "fliperos-odin"}
    by_file = {"dreamcast": ["flycast"], "naomi": ["flycast"], "naomi2": ["flycast"], "atomiswave": ["flycast"],
               "model3": ["fliperos-model3"], "chihiro": ["fliperos-chihiro"], "ps2": ["pcsx2"], "namco2x6": ["pcsx2x6"],
               "ps1": ["duckstation"], "dolphin": ["dolphin-emu", "-e"]}
    if key in by_name:
        return [X11, by_name[key], stem]
    if key in by_file:
        return [X11] + by_file[key] + [path]
    if key.startswith("retroarch/"):
        return [KMS, "retroarch", "-L", os.path.join(RA_CORES, key[len("retroarch/"):] + "_libretro.so"), path]
    return None


def main_entry(game):
    """O arquivo da pasta que abre o jogo (a pasta de um CHD ou de um set solto
    so se nao ha outro)."""
    names = sorted(game["entries"], key=lambda n: (os.path.splitext(n)[1].lower() not in MAIN_EXTS,
                                                    MAIN_EXTS.index(os.path.splitext(n)[1].lower())
                                                    if os.path.splitext(n)[1].lower() in MAIN_EXTS else 99, n))
    return game["dir"] + "/" + names[0]


def list_titles(home):
    """{rom: titulo} das listas do FliperOS (~/.local/share/fliperos/lists: o
    titulo do XML do MAME, o do Scraper)."""
    out = {}
    for path in sorted(glob.glob(os.path.join(home, ".local/share/fliperos/lists/*.txt"))):
        try:
            with open(path, encoding="utf-8", errors="replace") as f:
                for line in f:
                    if line.startswith("#"):
                        continue
                    cols = line.rstrip("\n").split(";")
                    if len(cols) > 1 and cols[0] and cols[1] and cols[0] not in out:
                        out[cols[0]] = cols[1]
        except OSError:
            pass
    return out


def entry_name(title):
    """O titulo como nome de arquivo (o .sh do grupo)."""
    name = re.sub(r'[/\\:*?"<>|\x00-\x1f]', " ", title).strip().strip(".")
    return re.sub(r"\s+", " ", name)[:120] or "game"


def valid_group(name):
    return bool(name and name.strip() and not any(c in name for c in "/|\n\r\\") and not name.startswith(".")
                and len(name) <= 80)


def make_logo(out, logo_file=None, logo_system=None):
    """O GRUPO/.logo.png: o desenho de uma imagem ou um logotipo da lista do
    FliperOS (fliperos-syslogo). Falso: sem logotipo."""
    if not (logo_file or logo_system) or not os.path.exists(SYSLOGO):
        return False
    argv = ["python3", SYSLOGO] + (["import", logo_file, out] if logo_file else ["copy", logo_system, out])
    try:
        import subprocess
        return subprocess.run(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60).returncode == 0 \
            and os.path.isfile(out)
    except OSError:
        return False


def group_entries(home, t, chosen, games):
    """[(rom, pasta, arquivo que abre, titulo)] dos jogos do grupo."""
    titles = list_titles(home)
    out = []
    for n in chosen:
        g = games[n]
        key = media_key(g["dir"])
        if launch_argv(key, g["stem"], "x") is None:
            continue
        out.append((g["stem"], key, main_entry(g), titles.get(g["stem"], g["stem"])))
    return out


def install_group(home, group, entries, t=None):
    """Monta o grupo: um TITULO.sh por jogo e a arte ligada. Devolve quantos.
    Com o alvo (quem faz o pacote), a ROM e a arte de onde estao de verdade:
    o console do Batocera filesystem fica no disco dele."""
    folder = os.path.join(home, "roms", "custom", group)
    makedirs(folder)
    used, count = set(), 0
    media = media_types(home)
    for stem, key, rel, title in entries:
        argv = launch_argv(key, stem, real(home, t, rel))
        if argv is None:
            continue
        name = entry_name(title)
        base, n = name, 2
        while name.lower() in used:
            name, n = "%s (%d)" % (base, n), n + 1
        used.add(name.lower())
        path = os.path.join(folder, name + ".sh")
        with open(path + ".new", "w", encoding="utf-8") as f:
            f.write("#!/bin/sh\n%s\n# rom: %s (%s)\nexec %s\n" % (GROUP_HEAD, stem, key, " ".join(shquote(a) for a in argv)))
        os.chmod(path + ".new", 0o755)
        give(path + ".new")
        os.replace(path + ".new", path)
        count += 1
        # A arte do jogo, ligada com o nome do .sh (o frontend a procura assim).
        for m in media:
            src_dir = real(home, t, "media/%s/%s" % (m, key))
            for e in listdir(src_dir):
                if e.name == stem or e.name.startswith(stem + "."):
                    dst_dir = os.path.join(home, "media", m, "custom", group)
                    makedirs(dst_dir)
                    dst = os.path.join(dst_dir, name + e.name[len(stem):])
                    if os.path.lexists(dst):
                        if not os.path.islink(dst):
                            continue
                        os.remove(dst)
                    # Dos atalhos para a arte do Batocera (refeitos quando ela muda): o arquivo de verdade.
                    target = e.path
                    if e.is_symlink() and src_dir.startswith(batocera_media_root(home) + os.sep):
                        target = os.readlink(e.path)
                    os.symlink(target, dst)
                    try:
                        os.lchown(dst, *(owner() or (-1, -1)))
                    except OSError:
                        pass
    return count


def refresh_frontends():
    """O grupo novo nos frontends e no menu do desktop (o Setup, como root;
    o Setup no gabinete faz isso ele mesmo: FLIPEROS_ROMPACK_NO_REFRESH)."""
    setup = ENV("FLIPEROS_SETUP_CMD", "/usr/local/bin/fliperos-setup")
    if ENV("FLIPEROS_ROMPACK_NO_REFRESH") or os.geteuid() != 0 or not os.access(setup, os.X_OK):
        return
    try:
        import subprocess
        subprocess.run([setup, "--customgames", "refresh-frontends"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=300)
    except (OSError, ValueError):
        pass
    except Exception:  # noqa: BLE001 - o pacote ja esta feito; os frontends se acertam depois
        pass


def shquote(s):
    return "'" + s.replace("'", "'\"'\"'") + "'" if re.search(r"[^A-Za-z0-9_./=:+-]", s) else s


# ── Fazer o pacote ──

def clean_title(title):
    title = TITLE_BAD.sub("", title or "").strip().strip(".")
    return title[:120]


def package_name(title, tid):
    return "%s.fliperos-%s.zip" % (title, tid)


def parse_kinds(text):
    """(tipos, tipos de arte) do --kinds: "media" e toda a arte; "media:snap",
    "media:preview"... so esses tipos de ~/media (None: todos). Sem --kinds,
    tudo."""
    if text is None:
        return ["roms"] + list(OPTIONAL), None
    words = [w.strip() for w in text.split(",") if w.strip()]
    media_sel = None if "media" in words else {w[6:] for w in words if w.startswith("media:") and w[6:]}
    kinds = ["roms"] + [k for k in OPTIONAL if k in words or (k == "media" and media_sel)]
    return kinds, media_sel


def collect(home, t, chosen, kinds, progress, media_sel=None):
    """[(caminho a partir da home, tamanho, tipo)] de tudo o que vai no
    pacote, sem repetir; e os avisos. media_sel: os tipos de arte que vao
    (None: todos)."""
    games = scan_games(home, t)
    missing = [n for n in chosen if n not in games]
    if missing:
        raise Bad("not in %s: %s" % (", ".join(t.get("shown", t["roms"])), ", ".join(missing[:5])))
    files, seen, notes = [], set(), []

    def add(lst, kind):
        for p, s in lst:
            if p not in seen and not p.endswith("/_info.txt"):
                seen.add(p)
                files.append((p, s, kind))

    for n in chosen:
        add(game_rom_files(home, t, games[n]), "roms")
    if "bios" in kinds:
        if t["deps"]:
            deps = mame_dependencies(t["deps"], [games[n]["stem"] for n in chosen], progress)
            if deps is None:
                notes.append("the BIOS and parent sets could not be found out (no MAME game list here)")
            elif deps:
                roms, bios = dependency_files(home, t, deps)
                add(roms, "roms")
                add(bios, "bios")
        add(shared_bios(home, t), "bios")
    if "save" in kinds:
        add(shared_saves(home, t), "save")
    idx = indexes(home, t)
    for kind in OPTIONAL:
        if kind not in kinds or kind == "bios":
            continue
        for _, ix in idx.get(kind, []):
            for n in chosen:
                for p in ix.get(games[n]["stem"]):
                    if kind == "media" and media_sel is not None and p.split("/")[1] not in media_sel:
                        continue
                    add(tree(home, p, t), kind)
    # Os saves que o Batocera fez, depois dos daqui (o mesmo nome no pacote: vale o daqui).
    if "save" in kinds and t.get("saves_from"):
        src, dest = t["saves_from"]
        names = batocera_save_names(t)
        for n in chosen:
            stem = games[n]["stem"]
            for name in names:
                if name == stem or name.startswith(stem + "."):
                    pkg = dest + "/" + name
                    t.setdefault("map", {})[pkg] = os.path.join(src, name)
                    add(tree(home, pkg, t), "save")
    return files, notes


def meta_store(home):
    """O arquivo dos metadados editados (config/fliperos-gamemeta)."""
    return os.path.join(home, ".config", "fliperos", "game-meta.tsv")


def meta_lines(home, t, games, chosen):
    """As edicoes de metadados dos jogos do pacote: "PASTA<TAB>ROM<TAB>CAMPO<TAB>VALOR".
    A de um console do Batocera filesystem (batocera/snes) vai com a pasta de
    quem instala (retroarch/mesen-s)."""
    want = {(system_key(t, games[n]["dir"]), games[n]["stem"]): media_key(games[n]["dir"]) for n in chosen}
    out = []
    # Os dados do gamelist.xml de um console do Batocera filesystem (o titulo, o
    # ano...), antes das edicoes (quem instala junta as linhas na ordem: a edicao vale).
    stems = {games[n]["stem"]: media_key(games[n]["dir"]) for n in chosen}
    for stem, fields in sorted(batocera_meta(home, t, sorted(stems)).items()):
        if stem in stems and isinstance(fields, dict):
            for field, value in sorted(fields.items()):
                if isinstance(value, str) and value and "\t" not in value and "\n" not in value:
                    out.append("\t".join([stems[stem], stem, field, value]))
    try:
        with open(meta_store(home), encoding="utf-8", errors="replace") as f:
            for line in f:
                cols = line.rstrip("\n").split("\t")
                if len(cols) == 4 and (cols[0], cols[1]) in want:
                    out.append("\t".join([want[(cols[0], cols[1])]] + cols[1:]))
    except OSError:
        pass
    return out


def merge_meta(home, lines):
    """Junta as edicoes de um pacote as daqui (as do pacote valem). Quantas."""
    path = meta_store(home)
    data = {}
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                cols = line.rstrip("\n").split("\t")
                if len(cols) == 4:
                    data[(cols[0], cols[1], cols[2])] = cols[3]
    except OSError:
        pass
    n = 0
    for line in lines:
        cols = line.split("\t")
        if len(cols) == 4 and cols[0] and cols[1] and cols[2] and ".." not in cols[0].split("/") and "/" not in cols[1]:
            data[(cols[0], cols[1], cols[2])] = cols[3]
            n += 1
    if n:
        makedirs(os.path.dirname(path))
        with open(path + ".new", "w", encoding="utf-8") as f:
            f.writelines("%s\t%s\t%s\t%s\n" % (k[0], k[1], k[2], v) for k, v in sorted(data.items()))
        give(path + ".new")
        os.replace(path + ".new", path)
    return n


def refresh_lists():
    """As listas de jogos refeitas com as edicoes que chegaram (como root)."""
    setup = ENV("FLIPEROS_SETUP_CMD", "/usr/local/bin/fliperos-setup")
    if ENV("FLIPEROS_ROMPACK_NO_REFRESH") or os.geteuid() != 0 or not os.access(setup, os.X_OK):
        return
    try:
        import subprocess
        subprocess.run([setup, "--romlists"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=600)
    except Exception:  # noqa: BLE001 - as listas se acertam na proxima abertura do frontend
        pass


def manifest_text(t, title, chosen, kinds, group="", entries=(), meta=()):
    lines = ["# FliperOS ROM package (Game Packages > ROMs).", "format=" + FORMAT, "type=roms", "title=" + title,
             "target=" + t.get("pkg", t["id"]), "label=" + t.get("pkg_label", t["label"]), "kinds=" + ",".join(kinds),
             "created=" + datetime.date.today().isoformat()]
    if group:
        # O grupo e, de cada jogo dele, a rom, a pasta, o arquivo que abre e o titulo.
        lines.append("group=" + group)
        lines += ["entry=" + "\t".join(e) for e in entries]
    # Os metadados que a pessoa editou (o "+" de cada jogo): titulo, ano, categoria...
    lines += ["meta=" + m for m in meta]
    lines += ["game=" + n for n in chosen]
    return "\n".join(lines) + "\n"


def free_bytes(path):
    try:
        st = os.statvfs(path)
        return st.f_bavail * st.f_frsize
    except OSError:
        return 1 << 62


def cmd_create(args):
    home = args.home
    progress = Progress(args.progress is not None, *(args.progress or (0, 100)))
    tmp = ""
    try:
        t = find_target(home, args.target)
        batocera_refresh(home, t)
        title = clean_title(args.title)
        if not title:
            raise Bad("the package needs a title")
        chosen = list(dict.fromkeys(args.games))
        if not chosen:
            raise Bad("choose at least one game")
        kinds, media_sel = parse_kinds(args.kinds)
        out = os.path.join(args.packages, package_name(title, t.get("pkg", t["id"])))
        if os.path.exists(out) and not args.replace:
            print("%s is already in the packages folder" % os.path.basename(out), file=sys.stderr)
            return 3
        progress.step(0, "Finding the files of %d game%s" % (len(chosen), "" if len(chosen) == 1 else "s"))
        files, notes = collect(home, t, chosen, kinds, progress, media_sel)
        group, entries, logo = (args.group or "").strip(), [], ""
        if group:
            if not valid_group(group):
                raise Bad("bad group name: %s" % group)
            entries = [tuple(x.replace("\t", " ") for x in e) for e in group_entries(home, t, chosen, scan_games(home, t))]
            if not entries:
                raise Bad("%s has no command per game: it cannot have a group" % t["label"])
            # O logotipo: o que ja esta no grupo, ou o novo pedido (que tambem fica aqui).
            logo = os.path.join(home, "roms", "custom", group, ".logo.png")
            if args.logo_file or args.logo_system:
                makedirs(os.path.dirname(logo))
                if make_logo(logo + ".new", args.logo_file, args.logo_system):
                    give(logo + ".new")
                    os.replace(logo + ".new", logo)
                else:
                    notes.append("the logo could not be made from that picture")
            if os.path.isfile(logo):
                rel = "roms/custom/%s/.logo.png" % group
                files.append((rel, os.path.getsize(logo), "roms"))
            # O grupo tambem aqui, como vai ficar em quem instalar.
            install_group(home, group, entries, t)
            refresh_frontends()
        total = sum(s for _, s, _ in files)
        makedirs(args.packages)
        if free_bytes(args.packages) < total + (64 << 20):
            raise Bad("not enough free space: the package needs %d MB" % ((total + (64 << 20)) >> 20))
        tmp = os.path.join(args.packages, ".%s.making" % os.path.basename(out))
        progress.step(0.05, "Packing %d files" % len(files))
        ticks = Progress(progress.on, progress.pct(0.05), progress.pct(0.98))
        done = 0
        with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED, allowZip64=True) as zf:
            zf.writestr(MANIFEST, manifest_text(t, title, chosen, kinds, group, entries,
                                                meta_lines(home, t, scan_games(home, t), chosen)))
            for rel, size, _ in files:
                ext = os.path.splitext(rel)[1].lower().lstrip(".")
                kind = zipfile.ZIP_STORED if ext in STORED_EXTS else zipfile.ZIP_DEFLATED
                info = zipfile.ZipInfo.from_file(real(home, t, rel), rel)
                info.compress_type = kind
                with open(real(home, t, rel), "rb") as src, zf.open(info, "w", force_zip64=size > (1 << 31)) as dst:
                    while True:
                        chunk = src.read(CHUNK)
                        if not chunk:
                            break
                        dst.write(chunk)
                        done += len(chunk)
                        ticks.tick(done / max(1, total))
        os.chmod(tmp, 0o644)
        give(tmp)
        os.replace(tmp, out)
        tmp = ""
    except (Bad, OSError) as exc:
        if tmp:
            try:
                os.remove(tmp)
            except OSError:
                pass
        progress.fail("Create package", exc)
        print(str(exc), file=sys.stderr)
        return 1
    for n in notes:
        print("note=%s" % n)
    counts = {}
    for _, _, kind in files:
        counts[kind] = counts.get(kind, 0) + 1
    print("out=%s" % out)
    print("files=%d" % len(files))
    print("bytes=%d" % total)
    print("kinds=%s" % ",".join("%s:%d" % (k, counts[k]) for k in KINDS if k in counts))
    progress.step(1, "%s is ready" % os.path.basename(out))
    return 0


# ── Conferir e instalar ──

def kind_of(rel):
    for prefix, kind in PREFIXES:
        if rel.startswith(prefix):
            return kind
    return ""


class Package:
    """Um TITULO.fliperos-ALVO.zip conferido."""

    def __init__(self, path):
        self.path = path
        m = NAME_RE.match(os.path.basename(path))
        if not m or m.group("target") == CUSTOMGAME:
            raise Bad("%s is not named like a ROM package (TITLE.fliperos-EMULATOR.zip)" % os.path.basename(path))
        try:
            self.zf = zipfile.ZipFile(path)
        except (OSError, zipfile.BadZipFile) as exc:
            raise Bad("not a zip file: %s" % exc)
        self.files, cfg = {}, None
        for info in self.zf.infolist():
            name = info.filename.replace("\\", "/")
            parts = name.rstrip("/").split("/")
            if name.startswith("/") or re.match(r"^[A-Za-z]:", name) or ".." in parts:
                raise Bad("unsafe path in the zip: %s" % info.filename)
            if info.flag_bits & 1:
                raise Bad("the zip is encrypted: %s" % info.filename)
            ftype = stat.S_IFMT(info.external_attr >> 16) if info.create_system == 3 else 0
            if ftype not in (0, stat.S_IFREG, stat.S_IFDIR):
                raise Bad("link or special file in the zip: %s" % info.filename)
            if name.endswith("/"):
                continue
            if name == MANIFEST:
                cfg = info
                continue
            if not kind_of(name):
                raise Bad("%s is outside the folders a ROM package can fill" % info.filename)
            self.files[name] = info
        if cfg is None:
            raise Bad("%s is missing: not a FliperOS ROM package" % MANIFEST)
        self.cfg, self.games, self.entries, self.meta = {}, [], [], []
        for line in self.zf.read(cfg).decode("utf-8", "replace").splitlines():
            key, sep, value = line.partition("=")
            if not sep or line.startswith("#"):
                continue
            if key.strip() == "game":
                self.games.append(value.strip())
            elif key.strip() == "meta":
                self.meta.append(value)
            elif key.strip() == "entry":
                cols = value.split("\t")
                # rom, pasta, arquivo que abre (dentro de roms/) e titulo.
                if len(cols) == 4 and cols[2].startswith("roms/") and ".." not in cols[2].split("/") \
                        and launch_argv(cols[1], cols[0], "x") is not None:
                    self.entries.append(tuple(cols))
            else:
                self.cfg[key.strip()] = value.strip()
        self.group = self.cfg.get("group", "")
        if self.group and not valid_group(self.group):
            raise Bad("bad group name in the package: %s" % self.group)
        if self.cfg.get("type") != "roms":
            raise Bad("%s is not a ROM package (type=%s)" % (os.path.basename(path), self.cfg.get("type", "")))
        if not any(kind_of(n) == "roms" for n in self.files):
            raise Bad("the package has no ROM")
        self.target = self.cfg.get("target") or m.group("target")
        self.title = self.cfg.get("title") or m.group("title")
        self.bytes = sum(i.file_size for i in self.files.values())

    def compare(self, home):
        """(novos, iguais, diferentes): os arquivos do pacote contra os do
        gabinete (o tamanho e, se igual, o CRC do zip)."""
        new, same, differ = [], [], []
        for name, info in self.files.items():
            full = os.path.join(home, name)
            try:
                st = os.stat(full)
            except OSError:
                new.append(name)
                continue
            if st.st_size != info.file_size:
                differ.append(name)
            elif crc_of(full) == info.CRC:
                same.append(name)
            else:
                differ.append(name)
        return new, same, differ

    def quick_state(self, home):
        """O estado pela lista (so o tamanho, sem ler os arquivos)."""
        present = 0
        for name, info in self.files.items():
            try:
                if os.path.getsize(os.path.join(home, name)) == info.file_size:
                    present += 1
            except OSError:
                pass
        if present == len(self.files):
            return "installed"
        return "partial" if present else "new"


def crc_of(path):
    crc = 0
    with open(path, "rb") as f:
        while True:
            chunk = f.read(CHUNK)
            if not chunk:
                return crc & 0xFFFFFFFF
            crc = zlib.crc32(chunk, crc)


def cmd_inspect(args):
    try:
        pkg = Package(args.zip)
    except Bad as exc:
        print(str(exc), file=sys.stderr)
        return 1
    counts = {}
    for n in pkg.files:
        counts[kind_of(n)] = counts.get(kind_of(n), 0) + 1
    print("title=%s" % pkg.title)
    print("target=%s" % pkg.target)
    print("label=%s" % pkg.cfg.get("label", pkg.target))
    print("created=%s" % pkg.cfg.get("created", ""))
    print("group=%s" % pkg.group)
    print("games=%d" % len(pkg.games))
    print("files=%d" % len(pkg.files))
    print("bytes=%d" % pkg.bytes)
    print("kinds=%s" % ",".join("%s:%d" % (k, counts[k]) for k in KINDS if k in counts))
    if args.compare:
        new, same, differ = pkg.compare(args.home)
        print("new=%d" % len(new))
        print("same=%d" % len(same))
        print("differ=%d" % len(differ))
    for g in pkg.games:
        print("game=%s" % g)
    return 0


def is_rompack(name):
    m = NAME_RE.match(os.path.basename(name))
    return bool(m and m.group("target") != CUSTOMGAME)


def cmd_packages(args):
    out = []
    for e in sorted(listdir(args.packages), key=lambda e: e.name.lower()):
        if not e.is_file() or not is_rompack(e.name):
            continue
        row = {"zip": e.path, "file": e.name, "size": e.stat().st_size}
        try:
            pkg = Package(e.path)
            counts = {}
            for n in pkg.files:
                counts[kind_of(n)] = counts.get(kind_of(n), 0) + 1
            row.update({"title": pkg.title, "target": pkg.target, "label": pkg.cfg.get("label", pkg.target),
                        "created": pkg.cfg.get("created", ""), "games": pkg.games, "files": len(pkg.files),
                        "group": pkg.group,
                        "bytes": pkg.bytes, "kinds": counts, "state": pkg.quick_state(args.home)})
            # A arte do cartao: a primeira imagem, video e logotipo de dentro do pacote.
            for key, kind, exts in (("snap", "snap", (".png", ".jpg", ".jpeg", ".webp", ".gif")),
                                    ("video", "preview", (".mp4", ".webm", ".mkv")),
                                    ("logo", "logo", (".png", ".jpg", ".jpeg", ".webp"))):
                row[key] = next((n for n in sorted(pkg.files) if n.startswith("media/%s/" % kind)
                                 and n.lower().endswith(exts)), "")
        except Bad as exc:
            row.update({"state": "bad", "why": str(exc)})
        out.append(row)
    if args.text:
        # ZIP|TITULO|EMULADOR|JOGOS|ESTADO|BYTES|MOTIVO (o Setup no gabinete).
        clean = lambda s: str(s).replace("|", "/").replace("\n", " ")
        for r in out:
            print("|".join(clean(x) for x in (r["zip"], r.get("title", r["file"]), r.get("label", ""),
                                              len(r.get("games", [])), r["state"], r.get("bytes", r["size"]),
                                              r.get("why", ""))))
        return 0
    json.dump(out, sys.stdout, ensure_ascii=False)
    print()
    return 0


def cmd_install(args):
    home = args.home
    progress = Progress(args.progress is not None, *(args.progress or (0, 100)))
    try:
        pkg = Package(args.zip)
        progress.step(0, "Checking %s" % os.path.basename(args.zip))
        new, same, differ = pkg.compare(home)
        write = new + (differ if args.replace else [])
        need = sum(pkg.files[n].file_size for n in write)
        if write and free_bytes(home) < need + (64 << 20):
            raise Bad("not enough free space: the games need %d MB" % ((need + (64 << 20)) >> 20))
        progress.step(0.05, "Installing %d files" % len(write))
        ticks = Progress(progress.on, progress.pct(0.05), progress.pct(0.99))
        done = 0
        for name in sorted(write):
            info = pkg.files[name]
            dest = os.path.join(home, *name.split("/"))
            makedirs(os.path.dirname(dest))
            if os.path.islink(dest):
                os.remove(dest)
            tmp = dest + ".fliperos-new"
            with pkg.zf.open(info) as src, open(tmp, "wb") as out:
                while True:
                    chunk = src.read(CHUNK)
                    if not chunk:
                        break
                    out.write(chunk)
                    done += len(chunk)
                    ticks.tick(done / max(1, need))
            os.chmod(tmp, 0o644)
            give(tmp)
            os.replace(tmp, dest)
        # O grupo do pacote: um sistema nos frontends, com o logotipo que veio.
        grouped = install_group(home, pkg.group, pkg.entries) if pkg.group and pkg.entries else 0
        if grouped:
            refresh_frontends()
        # Os metadados editados que vieram no pacote, e as listas com eles.
        metas = merge_meta(home, pkg.meta)
        if metas:
            refresh_lists()
    except (Bad, OSError, zipfile.BadZipFile) as exc:
        progress.fail("Install package", exc)
        print(str(exc), file=sys.stderr)
        return 1
    print("title=%s" % pkg.title)
    print("installed=%d" % len(write))
    print("same=%d" % len(same))
    print("kept=%d" % (0 if args.replace else len(differ)))
    if grouped:
        print("group=%s" % pkg.group)
        print("grouped=%d" % grouped)
    if metas:
        print("meta=%d" % metas)
    progress.step(1, "%s is installed" % pkg.title)
    return 0


def cmd_is_package(args):
    return 0 if is_rompack(args.file) else 1


def main():
    home = player_home()
    p = argparse.ArgumentParser(prog="fliperos-rompack")
    p.add_argument("--home", default=ENV("FLIPEROS_ROMPACK_HOME", home))
    p.add_argument("--packages", default=ENV("FLIPEROS_CUSTOMGAME_PACKAGES", os.path.join(home, "roms", "custom-packages")))
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("targets")
    s.add_argument("--all", action="store_true")
    s.add_argument("--text", action="store_true")
    s = sub.add_parser("games")
    s.add_argument("target")
    s.add_argument("--text", action="store_true")
    s.add_argument("--media-types", action="store_true")
    s = sub.add_parser("create")
    s.add_argument("--target", required=True)
    s.add_argument("--title", required=True)
    s.add_argument("--kinds")
    s.add_argument("--group")
    s.add_argument("--logo-file")
    s.add_argument("--logo-system")
    s.add_argument("--replace", action="store_true")
    s.add_argument("--progress", nargs="*", type=int)
    s.add_argument("--game", dest="games", action="append", default=[])
    s.add_argument("--games-file")
    s = sub.add_parser("inspect")
    s.add_argument("zip")
    s.add_argument("--compare", action="store_true")
    s = sub.add_parser("packages")
    s.add_argument("--text", action="store_true")
    s = sub.add_parser("install")
    s.add_argument("zip")
    s.add_argument("--replace", action="store_true")
