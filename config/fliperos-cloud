#!/usr/bin/env bash
# fliperos-cloud: os hi-scores, os saves e as configuracoes do jogador numa
# nuvem pelo rclone (Google Drive, Dropbox, WebDAV/Nextcloud, SFTP, Mega),
# do painel web (Settings > Cloud backup). Roda como o usuario: o rclone le
# ~/.config/rclone/rclone.conf, o remoto "fliperos".
#
#   fliperos-cloud status                 chave=valor: installed, remote, kind, auto, what, last, result
#   fliperos-cloud remote TIPO            grava o remoto; os campos pela entrada padrao, um "chave=valor"
#                                         por linha (a senha nunca na linha de comando):
#                                           webdav  url user pass      sftp  host port user pass
#                                           mega    user pass          dropbox  token (o JSON do rclone; o Google Drive so por "google start")
#   fliperos-cloud forget                 tira o remoto (o que esta na nuvem fica la)
#   fliperos-cloud auto on|off            sincroniza sozinho ao fechar cada jogo
#   fliperos-cloud what LISTA             o que sincronizar: hiscores,saves,config
#   fliperos-cloud sync [push|pull|both]  agora (o padrao e both: os dois lados, o mais novo vence)
#   fliperos-cloud watch PID              (fliperos-kms-run/x11-run) espera o jogo fechar e, com o
#                                         automatico ligado, sincroniza os hi-scores e os saves; as
#                                         configuracoes uma vez por dia
#   fliperos-cloud google start           "Entrar com o Google", como numa smart TV: comeca (ou
#                                         continua) a espera em segundo plano e imprime o estado
#                                         (status 3: sem o cliente OAuth em /etc/fliperos/google-oauth.conf)
#   fliperos-cloud google status          o estado: state=waiting|syncing|ok|denied|error|stopped,
#                                         code=, url=, account=, error=
#   fliperos-cloud google cancel          para a espera
#
# "Entrar com o Google" e o "OAuth 2.0 for TV and Limited-Input Devices": um
# cliente do tipo "TVs and Limited Input devices" do projeto do FliperOS, com o
# escopo drive.file (o rclone so ve o que ele mesmo criou: a pasta FliperOS). O
# client_secret desse tipo de cliente vai junto do aplicativo (o Google nao o
# trata como segredo). O rclone renova o token com o mesmo cliente
# (client_id/client_secret no remoto).
#
# A espera fica aqui, num processo solto (google-run), e nao em quem mostra a
# tela: o painel web e o Setup so leem o estado ($XDG_RUNTIME_DIR). Ele
# respeita o interval e o slow_down do Google e, se o codigo expira antes da
# aprovacao, pede outro sozinho. Aprovado: grava o remoto, confere o acesso
# criando a pasta FliperOS, guarda o e-mail da conta (Drive about) e roda a
# primeira sincronizacao. Sem ninguem olhando o estado por 10 minutos (a tela
# fechada), desiste. "forget" revoga o token no Google.
#
# Na nuvem, tudo fica em FliperOS/ (hiscores/, saves/, config/), o mesmo para
# todos os gabinetes da pessoa: um recorde feito num aparece no outro. Nada e
# apagado de nenhum lado (rclone copy --update, nunca sync): um arquivo so
# e trocado por um mais novo.
set -uo pipefail
RCLONE=${FLIPEROS_RCLONE:-rclone}
HOME_DIR=${FLIPEROS_CLOUD_HOME:-$HOME}
STATE=${FLIPEROS_CLOUD_STATE:-$HOME_DIR/.config/fliperos/cloud.conf}
RCLONE_CONF=${RCLONE_CONFIG:-$HOME_DIR/.config/rclone/rclone.conf}
LOG=${FLIPEROS_CLOUD_LOG:-/opt/fliperos/logs/cloud.log}
REMOTE=fliperos
ROOT_DIR=FliperOS
# O intervalo minimo entre duas sincronizacoes automaticas (s), e o das
# configuracoes.
AUTO_GAP=${FLIPEROS_CLOUD_GAP:-120}
CONFIG_GAP=${FLIPEROS_CLOUD_CONFIG_GAP:-86400}
export RCLONE_CONFIG=$RCLONE_CONF
GOOGLE_OAUTH=${FLIPEROS_GOOGLE_OAUTH:-/etc/fliperos/google-oauth.conf}
GOOGLE_DEVICE_URL=${FLIPEROS_GOOGLE_DEVICE_URL:-https://oauth2.googleapis.com/device/code}
GOOGLE_TOKEN_URL=${FLIPEROS_GOOGLE_TOKEN_URL:-https://oauth2.googleapis.com/token}
GOOGLE_SCOPE=https://www.googleapis.com/auth/drive.file
GOOGLE_ABOUT_URL=${FLIPEROS_GOOGLE_ABOUT_URL:-https://www.googleapis.com/drive/v3/about?fields=user(emailAddress)}
GOOGLE_REVOKE_URL=${FLIPEROS_GOOGLE_REVOKE_URL:-https://oauth2.googleapis.com/revoke}
GOOGLE_RUN=${XDG_RUNTIME_DIR:-/tmp}/fliperos-cloud-google
# Sem ninguem olhando o estado por tanto tempo (s), a espera desiste.
GOOGLE_IDLE=${FLIPEROS_GOOGLE_IDLE:-600}

# As pastas de cada grupo: "local<TAB>na nuvem".
pairs() {
  case $1 in
    hiscores)
      printf '%s\t%s\n' "$HOME_DIR/.mame/hiscore" hiscores/hiscore "$HOME_DIR/nvram" hiscores/nvram
      ;;
    saves) printf '%s\t%s\n' "$HOME_DIR/save" saves ;;
    config)
      printf '%s\t%s\n' "$HOME_DIR/.mame/cfg" config/mame-cfg "$HOME_DIR/.config/fliperos" config/fliperos \
        "$HOME_DIR/.local/share/fliperos/stats" config/stats "$HOME_DIR/.config/retroarch/remaps" config/retroarch-remaps \
        "$HOME_DIR/.config/retroarch/config" config/retroarch-overrides
      ;;
  esac
}

state_get() { sed -n "s/^$1=//p" "$STATE" 2> /dev/null | tail -1; }
state_set() {
  local tmp
  mkdir -p "${STATE%/*}"
  tmp=$(mktemp "$STATE.XXXXXX") || return 1
  { grep -v "^$1=" "$STATE" 2> /dev/null; printf '%s=%s\n' "$1" "$2"; } > "$tmp"
  mv -f "$tmp" "$STATE"
}

installed() { command -v "$RCLONE" > /dev/null 2>&1; }
remote_kind() { awk -v s="[$REMOTE]" '$0 == s { f = 1; next } /^\[/ { f = 0 } f && $1 == "type" { print $3; exit }' "$RCLONE_CONF" 2> /dev/null; }

log() {
  local dir=${LOG%/*}
  [[ -w $dir || -w $LOG ]] || LOG=$HOME_DIR/.cache/fliperos-cloud.log
  mkdir -p "${LOG%/*}" 2> /dev/null
  printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG" 2> /dev/null
}

# write_remote TIPO LINHAS: troca a secao [fliperos] do rclone.conf.
write_remote() {
  local tmp
  mkdir -p "${RCLONE_CONF%/*}"
  chmod 700 "${RCLONE_CONF%/*}" 2> /dev/null
  tmp=$(umask 077 && mktemp "$RCLONE_CONF.XXXXXX") || return 1
  {
    awk -v s="[$REMOTE]" '$0 == s { skip = 1; next } /^\[/ { skip = 0 } !skip' "$RCLONE_CONF" 2> /dev/null
    [[ -z $1 ]] || printf '[%s]\ntype = %s\n%s\n' "$REMOTE" "$1" "$2"
  } > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$RCLONE_CONF"
}

obscure() { printf '%s' "$1" | "$RCLONE" obscure - 2> /dev/null; }

cmd_remote() {
  local kind=$1 line key value body="" pass="" token=""
  local -A f=()
  while IFS= read -r line; do
    [[ $line == *=* ]] || continue
    key=${line%%=*} value=${line#*=}
    [[ $key =~ ^[a-z]+$ && $value != *$'\r'* ]] || return 2
    f[$key]=$value
  done
  installed || { echo "rclone is not installed."; return 1; }
  case $kind in
    webdav)
      [[ ${f[url]:-} =~ ^https?://[^[:space:]]+$ && -n ${f[user]:-} && -n ${f[pass]:-} ]] || return 2
      pass=$(obscure "${f[pass]}") || return 1
      body=$(printf 'url = %s\nvendor = other\nuser = %s\npass = %s' "${f[url]}" "${f[user]}" "$pass")
      ;;
    sftp)
      [[ ${f[host]:-} =~ ^[A-Za-z0-9.:-]+$ && -n ${f[user]:-} && -n ${f[pass]:-} && ${f[port]:-22} =~ ^[0-9]+$ ]] || return 2
      pass=$(obscure "${f[pass]}") || return 1
      body=$(printf 'host = %s\nport = %s\nuser = %s\npass = %s' "${f[host]}" "${f[port]:-22}" "${f[user]}" "$pass")
      ;;
    mega)
      [[ -n ${f[user]:-} && -n ${f[pass]:-} ]] || return 2
      pass=$(obscure "${f[pass]}") || return 1
      body=$(printf 'user = %s\npass = %s' "${f[user]}" "$pass")
      ;;
    dropbox)
      token=${f[token]:-}
      [[ $token == \{*access_token*\} && $token != *$'\n'* ]] || return 2
      body="token = $token"
      ;;
    *) return 2 ;;
  esac
  [[ -n $pass || -n $token ]] || return 1
  [[ ${f[user]:-} != *$'\n'* ]] || return 2
  write_remote "$kind" "$body" || return 1
  # Confere ja: a pasta FliperOS na nuvem (cria se falta).
  if ! out=$("$RCLONE" mkdir "$REMOTE:$ROOT_DIR" 2>&1); then
    log "remote $kind: $out"
    write_remote "" ""
    echo "The cloud did not accept the account: $(tail -1 <<< "$out")"
    return 1
  fi
  log "remote $kind saved"
}

# sync_group GRUPO push|pull|both
sync_group() {
  local group=$1 dir=$2 local_dir far rc=0
  while IFS=$'\t' read -r local_dir far; do
    if [[ $dir != pull && -d $local_dir ]]; then
      "$RCLONE" copy --update --exclude 'cloud.conf' --exclude '*.part' "$local_dir" "$REMOTE:$ROOT_DIR/$far" \
        >> "$LOG" 2>&1 || rc=1
    fi
    if [[ $dir != push ]]; then
      mkdir -p "$local_dir" 2> /dev/null
      "$RCLONE" copy --update --exclude 'cloud.conf' "$REMOTE:$ROOT_DIR/$far" "$local_dir" >> "$LOG" 2>&1 || rc=1
    fi
  done < <(pairs "$group")
  return $rc
}

cmd_sync() {
  local dir=${1:-both} groups=${2:-} group rc=0 lock
  [[ $dir =~ ^(push|pull|both)$ ]] || return 2
  installed || { echo "rclone is not installed."; return 1; }
  [[ -n $(remote_kind) ]] || { echo "No cloud account yet."; return 1; }
  groups=${groups:-$(state_get what)}
  groups=${groups:-hiscores,saves,config}
  log "sync $dir $groups"
  # Uma de cada vez (o automatico e o botao do painel).
  lock=${XDG_RUNTIME_DIR:-/tmp}/fliperos-cloud.lock
  exec 8> "$lock"
  flock -w 600 8 || { echo "Another sync is running."; return 1; }
  [[ -w ${LOG%/*} || -w $LOG ]] || LOG=$HOME_DIR/.cache/fliperos-cloud.log
  mkdir -p "${LOG%/*}" 2> /dev/null
  echo "@step 0 Syncing with the cloud"
  for group in ${groups//,/ }; do
    [[ $group =~ ^(hiscores|saves|config)$ ]] || continue
    echo "@msg $group"
    sync_group "$group" "$dir" || rc=1
    [[ $group == config ]] && state_set last_config "$(date +%s)"
  done
  state_set last "$(date +%s)"
  state_set result "$([[ $rc == 0 ]] && echo ok || echo failed)"
  log "sync done: $([[ $rc == 0 ]] && echo ok || echo failed)"
  if ((rc == 0)); then
    echo "@step 100 Synced with the cloud"
  else
    echo "@fail Syncing with the cloud|Some files did not sync (details in $LOG)"
  fi
  return $rc
}

cmd_watch() {
  local pid=$1 now groups last_config
  [[ $pid =~ ^[0-9]+$ ]] || return 2
  [[ $(state_get auto) == on ]] && installed && [[ -n $(remote_kind) ]] || return 0
  # Um vigia por jogo: o fliperos-kms-run e o fliperos-x11-run de um mesmo
  # jogo (o GroovyMAME passa pelos dois) tem o mesmo PID.
  # (global: o trap do EXIT roda depois da funcao)
  mark=${XDG_RUNTIME_DIR:-/tmp}/fliperos-cloud-watch-$pid
  mkdir "$mark" 2> /dev/null || return 0
  trap 'rmdir "$mark" 2> /dev/null' EXIT
  # Ate o jogo fechar (um zumbi, ainda nao recolhido, ja fechou).
  while kill -0 "$pid" 2> /dev/null && [[ $(awk '{ print $3 }' "/proc/$pid/stat" 2> /dev/null) != Z ]]; do
    sleep "${FLIPEROS_CLOUD_POLL:-5}"
  done
  now=$(date +%s)
  (($(state_get last || echo 0) + AUTO_GAP <= now)) || return 0
  groups=$(state_get what)
  groups=${groups:-hiscores,saves,config}
  last_config=$(state_get last_config || echo 0)
  # As configuracoes uma vez por dia; os hi-scores e os saves a cada jogo.
  if [[ ,$groups, == *,config,* ]] && ((${last_config:-0} + CONFIG_GAP > now)); then
    groups=$(tr ',' '\n' <<< "$groups" | grep -vx config | paste -sd,)
  fi
  [[ -n $groups ]] || return 0
  cmd_sync both "$groups" > /dev/null
}

# google_client: client_id e client_secret do cliente OAuth do FliperOS
# (vazio sem ele: o login por codigo nao existe nesta maquina).
google_client() {
  local id secret
  id=$(sed -n 's/^client_id=//p' "$GOOGLE_OAUTH" 2> /dev/null | head -1)
  secret=$(sed -n 's/^client_secret=//p' "$GOOGLE_OAUTH" 2> /dev/null | head -1)
  [[ $id == *.apps.googleusercontent.com && -n $secret ]] || return 1
  printf '%s\n%s\n' "$id" "$secret"
}

# ── Entrar com o Google ───────────────────────────────────────────

# gstate_write CHAVE=VALOR...: o estado da espera, inteiro de uma vez.
gstate_write() {
  local tmp
  tmp=$(mktemp "$GOOGLE_RUN.XXXXXX") || return 1
  printf '%s\n' "$@" > "$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$GOOGLE_RUN"
}
gstate_get() { sed -n "s/^$1=//p" "$GOOGLE_RUN" 2> /dev/null | head -1; }
google_pid() {
  local pid
  pid=$(cat "$GOOGLE_RUN.pid" 2> /dev/null)
  [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2> /dev/null && echo "$pid"
}

# google_device_code: um codigo novo (USER_CODE, VER_URL, DEV_CODE, INTERVAL,
# EXPIRES); status 1 com o motivo em GERR.
google_device_code() {
  local reply
  reply=$(curl -sS --max-time 20 --data-urlencode "client_id=$GID" --data-urlencode "scope=$GOOGLE_SCOPE" \
    "$GOOGLE_DEVICE_URL" 2>&1) || { log "google: $reply"; GERR="No answer from Google (no network?)."; return 1; }
  if ! jq -e '.user_code and .device_code' <<< "$reply" > /dev/null 2>&1; then
    log "google: $reply"
    GERR="Google refused: $(jq -r '.error_description // .error // "unexpected answer"' <<< "$reply" 2> /dev/null)"
    return 1
  fi
  USER_CODE=$(jq -r .user_code <<< "$reply")
  VER_URL=$(jq -r '.verification_url // .verification_uri // "https://www.google.com/device"' <<< "$reply")
  DEV_CODE=$(jq -r .device_code <<< "$reply")
  INTERVAL=$(jq -r '.interval // 5' <<< "$reply")
  EXPIRES=$(jq -r '.expires_in // 1800' <<< "$reply")
  [[ $INTERVAL =~ ^[0-9]+$ ]] || INTERVAL=5
  [[ $EXPIRES =~ ^[0-9]+$ ]] || EXPIRES=1800
}

# google_poll DEVICE: 0 aprovado (a resposta em REPLY), 4 pendente, 5 mais
# devagar (slow_down), 6 o codigo expirou, 1 negado ou outro erro (GERR).
google_poll() {
  local error
  REPLY=$(curl -sS --max-time 20 --data-urlencode "client_id=$GID" --data-urlencode "client_secret=$GSECRET" \
    --data-urlencode "device_code=$1" --data-urlencode "grant_type=urn:ietf:params:oauth:grant-type:device_code" \
    "$GOOGLE_TOKEN_URL" 2>&1) || return 4
  error=$(jq -r '.error // empty' <<< "$REPLY" 2> /dev/null)
  case $error in
    authorization_pending) return 4 ;;
    slow_down) return 5 ;;
    expired_token) return 6 ;;
    access_denied) GERR="Access was not allowed on the Google page."; return 1 ;;
    "") jq -e .access_token <<< "$REPLY" > /dev/null 2>&1 && return 0; return 4 ;;
    *) log "google: $REPLY"; GERR="Google refused: $error"; return 1 ;;
  esac
}

# google_save: o remoto com o token aprovado, a pasta FliperOS (confere o
# acesso) e o e-mail da conta (ACCOUNT).
google_save() {
  local token access out
  token=$(jq -c '{access_token, token_type: (.token_type // "Bearer"), refresh_token,
    expiry: ((now + (.expires_in // 3600)) | todate)}' <<< "$REPLY" 2> /dev/null)
  [[ $token == *access_token* && $token == *refresh_token* ]] || { log "google: $REPLY"; GERR="Google gave no token."; return 1; }
  write_remote drive "$(printf 'client_id = %s\nclient_secret = %s\nscope = drive.file\ntoken = %s' "$GID" "$GSECRET" "$token")" ||
    { GERR="Could not save the account."; return 1; }
  if ! out=$("$RCLONE" mkdir "$REMOTE:$ROOT_DIR" 2>&1); then
    log "google: $out"
    write_remote "" ""
    GERR="Google Drive did not accept the account: $(tail -1 <<< "$out")"
    return 1
  fi
  access=$(jq -r .access_token <<< "$REPLY")
  ACCOUNT=$(curl -sS --max-time 20 -H "Authorization: Bearer $access" "$GOOGLE_ABOUT_URL" 2> /dev/null |
    jq -r '.user.emailAddress // empty' 2> /dev/null)
  state_set account "${ACCOUNT:-Google Drive}"
  ACCOUNT=${ACCOUNT:-Google Drive}
  log "google: signed in as $ACCOUNT"
}

# google_run: a espera, solta (google start a abre).
cmd_google_run() {
  local deadline interval rc client renew=0
  client=$(google_client) || return 3
  GID=${client%%$'\n'*} GSECRET=${client#*$'\n'}
  echo $$ > "$GOOGLE_RUN.pid"
  trap 'rm -f "$GOOGLE_RUN.pid"' EXIT
  while true; do
    if ! google_device_code; then
      gstate_write state=error "error=$GERR"
      return 1
    fi
    gstate_write state=waiting "code=$USER_CODE" "url=$VER_URL"
    deadline=$((SECONDS + EXPIRES))
    interval=${FLIPEROS_GOOGLE_INTERVAL:-$INTERVAL}
    while ((SECONDS < deadline)); do
      sleep "$interval"
      if (($(date +%s) - $(stat -c %Y "$GOOGLE_RUN.seen" 2> /dev/null || echo 0) > GOOGLE_IDLE)); then
        log "google: nobody watching, stopped"
        gstate_write state=stopped
        return 0
      fi
      google_poll "$DEV_CODE"
      rc=$?
      case $rc in
        0) break 2 ;;
        4) ;;
        5) interval=$(awk -v i="$interval" -v s="${FLIPEROS_GOOGLE_SLOWDOWN:-5}" 'BEGIN { print i + s }') ;;
        6) break ;;
        *)
          gstate_write state=denied "error=$GERR"
          return 1
          ;;
      esac
    done
    renew=$((renew + 1))
    log "google: the code expired before the approval, new code ($renew)"
  done
  gstate_write state=syncing
  if ! google_save; then
    gstate_write state=error "error=$GERR"
    return 1
  fi
  gstate_write state=syncing "account=$ACCOUNT"
  cmd_sync both > /dev/null 2>&1
  gstate_write state=ok "account=$ACCOUNT" "result=$(state_get result)"
}

cmd_google() {
  local i
  case ${1:-} in
    start)
      google_client > /dev/null || { echo "The FliperOS Google sign-in is not set up on this system."; return 3; }
      touch "$GOOGLE_RUN.seen"
      if [[ -z $(google_pid) ]]; then
        gstate_write state=starting
        setsid bash "$0" google-run < /dev/null > /dev/null 2>&1 &
        for ((i = 0; i < 150; i++)); do
          [[ $(gstate_get state) != starting ]] && break
          sleep 0.1
        done
      fi
      cmd_google status
      ;;
    status)
      touch "$GOOGLE_RUN.seen" 2> /dev/null
      [[ -f $GOOGLE_RUN ]] || { echo "state=none"; return 0; }
      # A espera morreu sem dizer (o gabinete reiniciou o servico).
      if [[ $(gstate_get state) =~ ^(starting|waiting|syncing)$ && -z $(google_pid) ]]; then
        gstate_write state=stopped
      fi
      cat "$GOOGLE_RUN"
      ;;
    cancel)
      i=$(google_pid) && kill "$i" 2> /dev/null
      rm -f "$GOOGLE_RUN" "$GOOGLE_RUN.pid"
      ;;
    *) return 2 ;;
  esac
}

# google_revoke: o token do remoto do Google Drive revogado no Google (Tirar a
# conta); sem rede, so apaga daqui.
google_revoke() {
  local token
  token=$(awk -v s="[$REMOTE]" '$0 == s { f = 1; next } /^\[/ { f = 0 } f && $1 == "token" { sub(/^token *= */, ""); print; exit }' \
    "$RCLONE_CONF" 2> /dev/null | jq -r '.refresh_token // .access_token // empty' 2> /dev/null)
  [[ -n $token ]] || return 0
  if curl -sS --max-time 15 --data-urlencode "token=$token" "$GOOGLE_REVOKE_URL" > /dev/null 2>&1; then
    log "google: token revoked"
  else
    log "google: could not revoke the token (no network?)"
  fi
}

case ${1:-} in
  status)
    printf 'installed=%s\nremote=%s\nauto=%s\nwhat=%s\nlast=%s\nresult=%s\n' "$(installed && echo 1 || echo 0)" \
      "$(remote_kind)" "$(state_get auto || echo off)" "$(state_get what)" "$(state_get last)" "$(state_get result)"
    printf 'device=%s\naccount=%s\n' "$(google_client > /dev/null && echo 1 || echo 0)" "$(state_get account)"
    ;;
  remote) cmd_remote "${2:-}" ;;
  google) cmd_google "${2:-}" ;;
  google-run) cmd_google_run ;;
  forget)
    [[ $(remote_kind) == drive ]] && google_revoke
    write_remote "" ""
    state_set account ""
    log "remote removed"
    ;;
  auto)
    [[ ${2:-} == on || ${2:-} == off ]] || exit 2
    state_set auto "$2"
    ;;
  what)
    [[ ${2:-} =~ ^((hiscores|saves|config)(,(hiscores|saves|config))*)?$ ]] || exit 2
    state_set what "${2:-none}"
    ;;
  sync) cmd_sync "${2:-both}" "${3:-}" ;;
  watch) cmd_watch "${2:-}" ;;
  *)
    sed -n '/^#   fliperos-cloud /p' "$0" | sed 's/^# *//' >&2
    exit 2
    ;;
esac
