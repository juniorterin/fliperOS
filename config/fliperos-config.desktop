[Desktop Entry]
Type=Application
Name=Configuração do FliperOS
Name[en]=FliperOS Configuration
Comment=Vídeo, rede, áudio, compartilhamento e componentes
Comment[en]=Video, network, audio, sharing and components
# Terminal=true porque a interface e whiptail: o ambiente grafico abre um
# terminal pra ela. O sudo funciona sem senha via /etc/sudoers.d/fliperos.
Exec=sudo /usr/local/bin/fliperos-config
Terminal=true
Icon=preferences-system
# Apenas System: incluir Settings tambem faria o item aparecer DUAS vezes no
# menu, porque as duas sao categorias principais.
Categories=System;
Keywords=fliperos;arcade;crt;configuracao;
