#!/usr/bin/env bash
# Fightcade 2 (fightcade.com): partidas online de jogos de arcade e console,
# com os emuladores dele (FBNeo, SNES9x e o FBA antigo no Wine, Flycast
# nativo).
#
# E freeware de codigo fechado, sem permissao clara de redistribuicao: nao
# vem na imagem nem no repositorio do FliperOS. O Setup > Frontend baixa o
# pacote oficial para Linux do site dele (fetch), para /opt/fliperos/fightcade
# - pasta do usuario, porque o Fightcade se atualiza sozinho gravando nela.
# As ROMs ficam em ~/roms/fightcade (config/fliperos-roms).
#
#   fliperos-fightcade fetch [--progress]   baixa e instala (de novo: repara)
#   fliperos-fightcade [argumentos]         abre
#
# Instalado, /opt/fliperos/fightcade/fightcade e um link para este script: e
# o "binario" da tabela de sessoes, que so existe depois do download. Aberto
# no console, sobe num Xorg so para ele (fliperos-x11-run) no modo da tabela
# emulator-modes.conf: 640x480, que num monitor de 15 kHz sai entrelacado - a
# sala de jogos e uma pagina de desktop e nao cabe em 240 linhas. Esc na
# sala, ou Ctrl+W (Window > Close), fecha; Alt+Tab troca entre a sala e o
# emulador (config/openbox-fightcade.xml).
#
# Cada partida abre no modo do emulador dela, tambem da tabela (as linhas
# fightcade-fbneo, fightcade-fc1, fightcade-snes9x e fightcade-flycast): no
# 15 kHz, 320x240 nos do Wine e 640x240 no Flycast, esticado a 200% como o
# Flycast do sistema. Enquanto o emulador esta aberto a tela fica nesse modo
# (o Switchres calcula o modeline e o xrandr troca); fechado, volta ao da
# sala.
set -uo pipefail
dir=${FIGHTCADE_DIR:-/opt/fliperos/fightcade}
url=${FIGHTCADE_URL:-https://www.fightcade.com/download/linux}
user=${FLIPEROS_USER:-fliperos}
x11run=${FLIPEROS_X11_RUN:-/opt/fliperos/bin/fliperos-x11-run}
folders=${FLIPEROS_ROMS_SCRIPT:-/opt/fliperos/bin/fliperos-roms}
modes=${FLIPEROS_MODES:-/etc/fliperos/emulator-modes.conf}
conf=${FLIPEROS_CONF:-/etc/fliperos/fliperos.conf}
switchres_ini=${SWITCHRES_INI:-/etc/switchres.ini}
flycast_maps=${FLIPEROS_FLYCAST_MAPPINGS:-/home/fliperos/.config/flycast/mappings}
extras=${FLIPEROS_EXTRAS:-/opt/fliperos/bin/fliperos-extras}
flycast_cfg=${FLIPEROS_FLYCAST_CFG:-/home/fliperos/.config/flycast/emu.cfg}
ini_set=${FLIPEROS_INI_SET:-/opt/fliperos/bin/fliperos-ini-set}
escquit=${FLIPEROS_ESCQUIT:-/opt/fliperos/bin/fliperos-escquit}
self=$(readlink -f -- "${BASH_SOURCE[0]}")

# say PORCENTAGEM TEXTO: uma etapa para a tela de progresso do Setup
# (lib/progress.sh), ou so o texto.
progress=0
say() {
  if ((progress)); then printf '@step %s %s\n' "$1" "$2"; else printf '%s\n' "$2"; fi
}
# fail TEXTO: sai com erro, avisando a tela de progresso.
fail() {
  if ((progress)); then printf '@fail Fightcade|%s\n' "$1"; else printf 'fliperos-fightcade: %s\n' "$1" >&2; fi
  exit 1
}

fetch() {
  local part="$dir/.download.part" link keep=()
  [[ ${1:-} == --progress ]] && progress=1
  # Pelo Setup (root): a pasta e do usuario, e o download roda como ele. Os
  # emuladores dele rodam no Wine, que nao vem na imagem: vai junto.
  if ((EUID == 0)) && [[ $user != root ]]; then
    if ! "$extras" installed wine; then
      if ((progress)); then "$extras" install wine --progress || exit 1; else "$extras" install wine || exit 1; fi
    fi
    if ! mkdir -p "$dir" || ! chown "$user:" "$dir"; then
      fail "could not create $dir"
    fi
    exec runuser -u "$user" -- "$self" fetch "$@"
  fi
  mkdir -p "$dir" 2> /dev/null && [[ -w $dir ]] || fail "$dir is not writable"
  say 0 "Downloading Fightcade from fightcade.com"
  # De 0 a 85%: o download (uns 160 MB), para um arquivo temporario.
  python3 - "$url" "$part" "$progress" << 'PY' || { rm -f "$part"; fail "the download failed (no network?)"; }
import sys
import urllib.request

url, part, progress = sys.argv[1], sys.argv[2], sys.argv[3] == '1'
last = -1
for attempt in range(3):
    try:
        req = urllib.request.Request(url, headers={'User-Agent': 'fliperos-fightcade'})
        with urllib.request.urlopen(req, timeout=60) as resp, open(part, 'wb') as out:
            total = int(resp.headers.get('Content-Length') or 0)
            done = 0
            while True:
                chunk = resp.read(1 << 18)
                if not chunk:
                    break
                out.write(chunk)
                done += len(chunk)
                pct = done * 85 // total if total else 0
                if progress and pct != last:
                    last = pct
                    print('@step %d Downloading Fightcade (%d of %d MB)' % (pct, done >> 20, total >> 20), flush=True)
            if total and done != total:
                raise OSError('incomplete download')
        break
    except OSError as e:
        print('fliperos-fightcade: %s' % e, file=sys.stderr)
        if attempt == 2:
            sys.exit(1)
PY
  say 88 "Unpacking"
  # O pacote traz tudo dentro de Fightcade/. Num reparo, as pastas de ROMs
  # que ja sao links para ~/roms/fightcade ficam (--keep-directory-symlink)
  # e o que o pacote traz dentro delas fica de fora: o tar nao grava por um
  # link que sai da pasta ("Invalid cross-device link").
  for link in "$dir"/emulator/*/ROMs; do
    [[ -L $link ]] && keep+=("--exclude=*/emulator/$(basename "$(dirname "$link")")/ROMs/*")
  done
  if ! tar -xzf "$part" -C "$dir" --strip-components=1 --keep-directory-symlink --no-same-owner "${keep[@]}" \
    2> /dev/null ||
    [[ ! -x $dir/Fightcade2.sh || ! -x $dir/fc2-electron/fc2-electron ]]; then
    rm -f "$part"
    fail "the downloaded file is not the Fightcade package"
  fi
  rm -f "$part"
  # Os botoes do Setup > Joysticks > Button mapping no Flycast Dojo: os
  # mesmos mapeamentos do Flycast (fliperos-buttons os grava nos dois).
  for map in "$flycast_maps"/SDL_*.cfg; do
    [[ -f $map ]] && mkdir -p "$dir/emulator/flycast/mappings" && cp -f "$map" "$dir/emulator/flycast/mappings/"
  done
  ln -sfn "$self" "$dir/fightcade"
  say 96 "ROM folders in ~/roms/fightcade"
  [[ -x $folders ]] && "$folders"
  say 100 "Fightcade $(tr -d '[:space:]' < "$dir/VERSION.txt" 2> /dev/null) installed"
}

if [[ ${1:-} == fetch ]]; then
  shift
  fetch "$@"
  exit 0
fi

if [[ ! -x $dir/Fightcade2.sh ]]; then
  echo "Fightcade is not installed. Setup > Frontend > Fightcade 2 downloads it." >&2
  exit 1
fi
# Sem o Wine a sala abre, mas so as partidas do Flycast rodam.
command -v wine > /dev/null || echo "Wine is not installed: Setup > Extras installs it (FBNeo and SNES9x need it)." >&2

# Fora do X (a sessao de boot, o fliperos-launch): num Xorg so para ele. O
# nome do comando (fightcade) e a linha da tabela de modos.
if [[ -z ${DISPLAY:-} ]]; then
  export FLIPEROS_OPENBOX_RC="${FLIPEROS_OPENBOX_RC:-/etc/fliperos/openbox-fightcade.xml}"
  exec "$x11run" "$dir/fightcade" "$@"
fi

cd "$dir" || exit 1
# Um prefixo do Wine so para ele, como o Model 2. Sem o Mono e o Gecko: os
# emuladores nao os usam, e sem isto o Wine abre uma janela pedindo para
# baixa-los na primeira vez.
export WINEPREFIX="${WINEPREFIX:-$HOME/.local/share/fliperos/wine-fightcade}"
export WINEDEBUG=-all
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree,mshtml=}"
mkdir -p "$(dirname "$WINEPREFIX")"
# Na primeira vez o Wine leva uns 15 s criando o prefixo: ja comeca agora,
# com a sala abrindo, e nao na primeira partida.
if [[ ! -d $WINEPREFIX ]] && command -v wineboot > /dev/null; then
  wineboot --init > /dev/null 2>&1 &
fi

# A pagina e desenhada para um desktop (janela de 1280x800): numa tela
# menor ela encolhe na proporcao da altura, ate a metade. FIGHTCADE_SCALE
# fixa outro valor; na janela, Text > Zoom In/Out (Ctrl+= e Ctrl+-) ajusta
# na hora.
scale=${FIGHTCADE_SCALE:-}
if [[ -z $scale ]]; then
  height=${FLIPEROS_RES_H:-$(xrandr --current 2> /dev/null | awk '/\*/ { split($1, a, "x"); print a[2] + 0; exit }')}
  # LC_ALL=C: com o sistema em portugues o awk escreveria "0,67".
  scale=$(LC_ALL=C awk -v h="${height:-720}" 'BEGIN { s = h / 720; if (s > 1) s = 1; if (s < 0.5) s = 0.5; printf "%.2f", s }')
fi

# ── O modo de cada emulador ───────────────────────────────────────
# table_mode NOME: o modo de NOME na tabela (LARGURAxALTURA@HZ), na coluna
# do monitor escolhido no Setup, como o fliperos-x11-run.
table_mode() {
  local column=3
  [[ $(sed -n 's/^frequency=//p' "$conf" 2> /dev/null) == 15* ]] && column=2
  awk -v p="$1" -v c="$column" '!/^[[:space:]]*#/ && $1 == p { print $c; exit }' "$modes" 2> /dev/null
}

# A saida com imagem e o modo em que a sala abriu (o id do xrandr, para
# voltar a ele depois de uma partida), como o fliperos-resolution.
output=$(xrandr --query 2> /dev/null |
  awk '$2 == "connected" && / [0-9]+x[0-9]+\+[0-9]+\+[0-9]+ / { print $1; exit }')
lobby_id=$(xrandr --verbose 2> /dev/null | awk -v o="$output" '
  /^[^ \t]/ { inside = ($1 == o) }
  inside && /\*current/ { gsub(/[()]/, "", $2); print $2; exit }')
lobby_mode=$(table_mode fightcade)

# mode_add MODO cria o modo na saida (uma vez) e imprime o nome dele. O
# Switchres calcula o modeline para o monitor do switchres.ini:
#   Switchres: Modeline "320x240_60 15.660000KHz 60.000000Hz" 6.7 320 ... -hsync -vsync
mode_add() {
  local line name
  [[ -n $output && $1 =~ ^([0-9]+)x([0-9]+)@([0-9.]+)$ ]] || return 1
  name="fliperos-$1"
  if ! xrandr --query 2> /dev/null | grep -q "^ *$name "; then
    line=$(switchres "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" --ini "$switchres_ini" --calc 2>&1 |
      grep -m1 'Modeline "') || return 1
    # shellcheck disable=SC2086 # os campos do modeline, um por argumento
    xrandr --newmode "$name" ${line##*\" } 2> /dev/null
    xrandr --addmode "$output" "$name" 2> /dev/null || return 1
  fi
  printf '%s\n' "$name"
}

# mode_game MODO troca a tela para o modo do emulador; mode_lobby volta ao
# da sala.
mode_game() {
  local name
  name=$(mode_add "$1") && xrandr --output "$output" --mode "$name"
}
mode_lobby() {
  [[ -n $output && -n $lobby_id ]] && xrandr --output "$output" --mode "$lobby_id"
}

# idle_close: o FBNeo (e o FBA, do mesmo codigo) que nao acha a ROM mostra o
# erro e, no OK, fica aberto sem jogo ("[no game loaded]" no titulo): a tela
# ficaria no modo da partida, sem como fechar pelo controle. Parado assim
# por uns segundos seguidos (no erro o titulo ainda e outro), fecha.
declare -A idle=()
idle_close() {
  local id pid
  local -A seen=()
  while read -r id _; do
    pid=$(xprop -id "$id" _NET_WM_PID 2> /dev/null | awk '{ print $3 }')
    [[ $pid =~ ^[0-9]+$ ]] || continue
    seen[$pid]=1
    idle[$pid]=$((${idle[$pid]:-0} + 1))
    if ((idle[$pid] >= ${FIGHTCADE_IDLE_WAIT:-3})); then
      echo "fliperos-fightcade: closing an emulator with no game loaded" >&2
      kill "$pid" 2> /dev/null
    fi
  done < <(xwininfo -root -tree 2> /dev/null | grep -F '[no game loaded]' |
    grep -E '\("(fcadefbneo|fcv39|ggpofba-ng)\.exe"')
  for pid in "${!idle[@]}"; do
    [[ -n ${seen[$pid]:-} ]] || unset "idle[$pid]"
  done
}

# ── A configuracao dos emuladores ─────────────────────────────────
# once NOME: verdadeiro so na primeira vez (o que e padrao do FliperOS e a
# pessoa pode mudar depois no proprio emulador fica anotado em .fliperos).
once() {
  grep -qx "$1" .fliperos 2> /dev/null && return 1
  printf '%s\n' "$1" >> .fliperos
}
# keyval_set ARQUIVO CHAVE VALOR troca "CHAVE valor" (os ini do FBNeo e do
# FBA, com fim de linha do Windows), se a chave existe no arquivo.
keyval_set() {
  sed -i -E "s/^($2)[[:space:]]+[^\r]*(\r?)\$/\1 $3\2/" "$1"
}
# cfg_set ARQUIVO CHAVE VALOR troca "CHAVE = valor" (o emu.cfg do Flycast).
cfg_set() {
  sed -i -E "s/^($2) = .*\$/\1 = $3/" "$1"
}

# As opcoes do Flycast do sistema que valem tambem no Flycast Dojo: a imagem
# sem interpolacao linear, a transparencia por pixel e os dois controles nas
# portas A e B (config/flycast-emu.cfg, ou o que a pessoa mudou depois).
FLYCAST_SHARED="config:rend.LinearInterpolation config:pvr.rend input:device1 input:device1.1 input:device1.2
  input:device2 input:device2.1 input:device2.2 input:maple_sdl_joystick_0 input:maple_sdl_joystick_1"

# flycast_sync ARQUIVO copia as FLYCAST_SHARED do emu.cfg do Flycast do
# sistema para o do Dojo, a cada abertura: o do sistema e a referencia.
flycast_sync() {
  local dojo=$1 entry section key value
  [[ -f $flycast_cfg && -f $ini_set ]] || return 0
  for entry in $FLYCAST_SHARED; do
    section=${entry%%:*} key=${entry#*:}
    value=$(awk -v s="[$section]" -v k="$key" '
      { l = $0; sub(/\r$/, "", l) }
      l ~ /^\[.*\]$/ { in_s = (l == s); next }
      in_s && index(l, "=") {
        n = substr(l, 1, index(l, "=") - 1); gsub(/^[ \t]+|[ \t]+$/, "", n)
        if (n == k) { v = substr(l, index(l, "=") + 1); gsub(/^[ \t]+|[ \t]+$/, "", v); print v; exit }
      }' "$flycast_cfg")
    [[ -n $value ]] && bash "$ini_set" "$dojo" "$section" "$key" "$value"
  done
  return 0
}

# emulators_setup: a tela cheia de cada emulador no modo da tabela. Cada um
# le o proprio arquivo, criado do "default" que vem no pacote (como o
# Fightcade faz na primeira partida).
emulators_setup() {
  local row ini mode name wkey hkey stretch crt=0
  [[ $(sed -n 's/^frequency=//p' "$conf" 2> /dev/null) == 15* ]] && crt=1
  # FBNeo e FBA (o do Fightcade 1): "nome:arquivo:chave da largura:da altura".
  for row in fightcade-fbneo:emulator/fbneo/config/fcadefbneo:nVidHorWidth:nVidHorHeight \
    fightcade-fc1:emulator/ggpofba/config/ggpofba-ng:nVidWidth:nVidHeight; do
    IFS=: read -r name ini wkey hkey <<< "$row"
    [[ -f $ini.ini ]] || cp "$ini.default.ini" "$ini.ini" 2> /dev/null || continue
    mode=$(table_mode "$name")
    [[ $mode =~ ^([0-9]+)x([0-9]+)@ ]] || continue
    keyval_set "$ini.ini" "$wkey" "${BASH_REMATCH[1]}"
    keyval_set "$ini.ini" "$hkey" "${BASH_REMATCH[2]}"
    # So na primeira vez: o jogo ja abre em tela cheia e, num tubo, o
    # formato do monitor e 4:3 (o padrao do pacote e 16:9).
    if once "$name"; then
      keyval_set "$ini.ini" bVidAutoSwitchFull 1
      ((crt)) && keyval_set "$ini.ini" nVidScrnAspectX 4 && keyval_set "$ini.ini" nVidScrnAspectY 3
    fi
  done
  # Flycast: quanto esticar na horizontal para o 4:3 encher o modo (640x240
  # tem pixels 8:3: 200%), como o fliperos-x11-run faz no Flycast do sistema.
  ini=emulator/flycast/emu
  if [[ -f $ini.cfg ]] || cp "$ini.default.cfg" "$ini.cfg" 2> /dev/null; then
    mode=$(table_mode fightcade-flycast)
    if [[ $mode =~ ^([0-9]+)x([0-9]+)@ ]]; then
      stretch=$((300 * BASH_REMATCH[1] / (4 * BASH_REMATCH[2])))
      ((stretch < 100)) && stretch=100
      ((stretch > 250)) && stretch=250
      cfg_set "$ini.cfg" rend.ScreenStretching "$stretch"
    fi
    once fightcade-flycast && cfg_set "$ini.cfg" fullscreen yes
    flycast_sync "$ini.cfg"
  fi
  return 0
}
emulators_setup
# O Flycast do Fightcade e um AppImage, que pede o FUSE (a imagem nao o tem):
# assim ele se extrai em /tmp a cada abertura e roda de la.
export APPIMAGE_EXTRACT_AND_RUN=1
# Os modos ja ficam na lista da saida: o Wine os enxerga, e um emulador que
# entre em tela cheia antes da troca abaixo acha o modo dele.
for name in fightcade-fbneo fightcade-fc1 fightcade-snes9x fightcade-flycast; do
  mode=$(table_mode "$name")
  [[ -n $mode && $mode != "$lobby_mode" ]] && mode_add "$mode" > /dev/null
done

# O Fightcade2.sh prepara a configuracao do FBNeo, registra o fcade:// (por
# onde o cliente abre os emuladores), deixa o cliente em segundo plano e sai.
./Fightcade2.sh "--force-device-scale-factor=$scale" "$@"

# Esc na sala (nenhum emulador aberto) fecha o Fightcade
# (config/fliperos-escquit): o SIGTERM dele para este script, que fecha o
# cliente. Os emuladores nao sao filhos daqui; o arquivo busy diz quando ha
# um aberto.
busy="${XDG_RUNTIME_DIR:-/tmp}/fliperos-fightcade.busy"
rm -f "$busy"
quit=0
trap 'quit=1' TERM
esc_pid=""
if [[ -x $escquit ]]; then
  "$escquit" --busy-file "$busy" --ignore-children $$ < /dev/null > /dev/null 2>&1 &
  esc_pid=$!
fi

# A sessao fica ate o cliente fechar. Numa atualizacao automatica ele fecha e
# reabre sozinho (fcade-upd): so vale como fechado depois de uns segundos sem
# nenhum dos dois. Enquanto isso, a cada segundo: com um emulador aberto a
# tela vai para o modo dele; sem nenhum, volta ao da sala.
gone=0 current=""
while ((gone < ${FIGHTCADE_QUIT_WAIT:-5})); do
  sleep 1
  if ((quit)); then
    pkill -u "$(id -u)" -f '[f]c2-electron/fc2-electron'
    break
  fi
  running=$(pgrep -u "$(id -u)" -af 'fc2-electron/fc2-electron|fcade-upd|flycast\.elf|fcadefbneo\.exe|fcv39\.exe|ggpofba-ng\.exe|fcadesnes9x\.exe')
  case $running in
    *fc2-electron/fc2-electron* | *fcade-upd*) gone=0 ;;
    *) gone=$((gone + 1)) ;;
  esac
  case $running in
    *flycast.elf* | *.exe*) touch "$busy" ;;
    *) rm -f "$busy" ;;
  esac
  case $running in
    *fcadefbneo.exe* | *fcv39.exe* | *ggpofba-ng.exe*) idle_close ;;
    *) idle=() ;;
  esac
  case $running in
    *flycast.elf*) want=$(table_mode fightcade-flycast) ;;
    *fcadefbneo.exe* | *fcv39.exe*) want=$(table_mode fightcade-fbneo) ;;
    *ggpofba-ng.exe*) want=$(table_mode fightcade-fc1) ;;
    *fcadesnes9x.exe*) want=$(table_mode fightcade-snes9x) ;;
    *) want="" ;;
  esac
  [[ $want == "$lobby_mode" ]] && want=""
  [[ $want == "$current" ]] && continue
  if [[ -z $want ]]; then
    mode_lobby
  elif ! mode_game "$want"; then
    echo "fliperos-fightcade: could not switch to $want" >&2
  fi
  # Trocou ou nao, e o estado pedido: sem nova tentativa a cada segundo.
  current=$want
done
[[ -n $current ]] && mode_lobby
[[ -n $esc_pid ]] && kill "$esc_pid" 2> /dev/null
rm -f "$busy"
exit 0
