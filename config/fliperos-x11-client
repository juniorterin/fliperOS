#!/usr/bin/env bash
# Cliente do fliperos-x11-run: o Switchres cria o modo do jogo (monitor e
# faixas do /etc/switchres.ini, que o fliperos-setup mantem) e abre o
# emulador nele.
set -euo pipefail
connector=$(sed -n 's/^connector=//p' /etc/fliperos/fliperos.conf 2> /dev/null)
# --scale LxA programa...: o passo que o Switchres abre ja no modo do jogo
# (FLIPEROS_X11_SCREEN, abaixo): a tela do X fica maior que o modo (xrandr
# --scale) e o tubo continua nele; o picom com vsync por cima (o MUGEN em
# RenderMode = System desenha pelo X, sem OpenGL, e sem compositor rasgava a
# imagem no tubo: visto no gabinete, sumiu com ele); depois, o programa. Um
# picom que ja esta na tela (o filtro do fliperos-desktop-deflicker) fica.
if [[ ${1:-} == --scale ]]; then
  output=$connector
  [[ -n $output ]] || output=$(xrandr --current 2> /dev/null | awk '$2 == "connected" { print $1; exit }')
  [[ -z $output ]] || xrandr --output "$output" --scale "$2" > /dev/null 2>&1 || true
  if command -v picom > /dev/null && ! pgrep -u "$(id -u)" -x picom > /dev/null 2>&1; then
    env -u LD_PRELOAD picom --backend glx --vsync < /dev/null > /dev/null 2>&1 &
  fi
  shift 2
  exec "$@"
fi
# Com cursor (fliperos-x11-run): a seta normal fora das janelas, nao o "X"
# do Xorg sem gerenciador de janelas.
if [[ ${FLIPEROS_X11_CURSOR:-0} == 1 ]]; then
  xsetroot -cursor_name left_ptr 2> /dev/null || true
fi
# Gerenciador de janelas, como o galauncher.xinitrc do GroovyArcade: quando o
# programa troca de modo pelo XRandR (o Switchres do GroovyMAME, a cada
# jogo), o openbox encaixa a janela de tela cheia na tela nova. Sem ele a
# janela ficava no tamanho do modo em que abriu: no gabinete, a interface do
# GroovyMAME num quarto da tela de 640x480 e o jogo fora do lugar. O
# programa so abre com ele pronto (_NET_SUPPORTING_WM_CHECK na raiz).
# Fundo preto: o que aparece por tras das janelas na troca de modo.
xsetroot -solid black 2> /dev/null || true
if command -v openbox > /dev/null; then
  openbox --config-file "${FLIPEROS_OPENBOX_RC:-/etc/fliperos/openbox-x11-run.xml}" &
  for _ in $(seq 1 50); do
    xprop -root _NET_SUPPORTING_WM_CHECK 2> /dev/null | grep -q 'window id' && break
    sleep 0.1
  done
fi
# A OSD por cima de um jogo que a camada nao alcanca (config/fliperos-osd-x11:
# o que desenha pelo X sem OpenGL, como o MUGEN e o Fightcade, e os jogos do
# PortProton, cujo container tira a camada). Com a camada viva, ele fica quieto.
# O pid e o do xinit (o Quit da OSD o fecha, e o X leva o jogo junto).
osd_x11=${FLIPEROS_OSD_X11:-/opt/fliperos/bin/fliperos-osd-x11}
if [[ -x $osd_x11 ]]; then
  FLIPEROS_GAME_PID=$PPID env -u LD_PRELOAD "$osd_x11" < /dev/null > /dev/null 2>&1 &
fi
# A tabela de gama da calibracao de cor (Setup > Video Setup > Colour
# calibration): o Xorg abre com a dele, linear.
color=${FLIPEROS_COLOR:-/usr/local/bin/fliperos-color}
[[ -x $color ]] && { "$color" x11 > /dev/null 2>&1 || true; }
args=()
[[ -n $connector ]] && args+=(--display "$connector")
# Opcoes a mais do Switchres (as do switchres.ini, como opcao longa), de
# quem chamou: o groovymame na interface pede o modo dela sem entrelacar.
# shellcheck disable=SC2206 # uma opcao por palavra
args+=(${FLIPEROS_SWITCHRES_OPTS:-})
emulator_command=$(printf '%q ' "$@")
# O filtro de flicker do entrelacado (config/fliperos-deflicker.c): so no emulador,
# nao no Xorg nem no Switchres. Os programas do Wine sao quase sempre de 32
# bits: a camada de 32 bits (compilada quando o Wine e instalado, Setup >
# Games > Extras) vai junto da de 64 no LD_PRELOAD, e o carregador do Linux
# pula a que nao e da arquitetura do processo. Com ela, um jogo do Wine tem o
# filtro e a OSD como os emuladores; no Vulkan (DXVK), a camada do Vulkan de
# 32 bits, pelo manifesto dela (config/fliperos-vkfps-i386.json) e pelo
# FLIPEROS_VK_FPS=1 de baixo. O Electron da sala do Fightcade nao
# aceita a camada, e o Wine sem a de 32 bits nao a carrega: neles o filtro e
# o do picom, o mesmo do desktop, por cima da tela toda deste X
# (fliperos-desktop-deflicker, que acompanha o modo de cada jogo), sem a OSD.
deflicker=${FLIPEROS_DEFLICKER_LIB:-/usr/local/lib/fliperos/libfliperos-deflicker.so}
deflicker32=${FLIPEROS_DEFLICKER_LIB32:-/usr/local/lib/fliperos/i386/libfliperos-deflicker.so}
# O Wine no comando: o programa (wine, um .exe) ou dentro de um bash -c (um
# jogo custom: "wine ~/games/pang/pang.exe"). So nele vai a camada de 32
# bits: nos outros, cada processo de 64 bits deixaria um aviso no log.
wine_re='(^|[[:space:]/;&(])wine(64)?([[:space:]]|$)|\.[eE][xX][eE]([[:space:]"]|$)'
uses_wine=0
[[ $* =~ $wine_re ]] && uses_wine=1
# Um jogo custom do Windows (fliperos-x11-run --wine): o .exe esta no cfg
# dele, nao no comando. Sem a camada de 32 bits, o filtro e o do picom.
picom=0
if [[ ${FLIPEROS_USES_WINE:-} == 1 ]]; then
  uses_wine=1
  [[ -f $deflicker32 ]] || picom=1
fi
case $(basename -- "$1") in
  fightcade*) picom=1 ;;
  wine* | *.exe) [[ -f $deflicker32 ]] || picom=1 ;;
  # Um jogo custom do Windows pelo PortProton (o runner padrao, sem a linha
  # runner= no cfg: DEFAULT_RUNNER do fliperos-customgame): o container dele
  # (pressure-vessel) troca o LD_PRELOAD e o jogo nunca carrega a camada,
  # nem a de 64 nem a de 32 bits (visto no gabinete com o MARVEL Cosmic
  # Invasion em 854x480i: o wineserver com LD_PRELOAD vazio e a camada
  # mapeada so no bash do PortProton). Ali o filtro e o do picom, como no
  # Fightcade. O Wine do sistema e o Staging (runner=wine, wine-staging)
  # seguem com a camada: o processo deles herda o LD_PRELOAD.
  fliperos-customgame)
    if [[ ${FLIPEROS_USES_WINE:-} == 1 && ${2:-} == run && -f ${3:-} ]]; then
      platform="" runner=""
      while IFS= read -r line || [[ -n $line ]]; do
        case $line in
          platform=*) platform=${line#platform=} ;;
          runner=*) runner=${line#runner=} ;;
        esac
      done < "$3"
      if [[ $platform == windows && ( -z $runner || $runner == portproton ) ]]; then picom=1; fi
    fi
    ;;
esac
case $picom in
  1)
    compositor=${FLIPEROS_DESKTOP_DEFLICKER:-/opt/fliperos/bin/fliperos-desktop-deflicker}
    [[ ! -x $compositor ]] ||
      "$compositor" --app "${FLIPEROS_DEFLICKER_APP:-$(basename -- "$1")}" --watch < /dev/null > /dev/null 2>&1 &
    ;;
  *)
    layers=""
    [[ -f $deflicker ]] && layers=$deflicker
    ((uses_wine)) && [[ -f $deflicker32 ]] && layers+=${layers:+:}$deflicker32
    [[ -n $layers ]] &&
      emulator_command="env LD_PRELOAD=$(printf '%q' "$layers${LD_PRELOAD:+:$LD_PRELOAD}") $emulator_command"
    # Um emulador em Vulkan: a camada do Vulkan (config/fliperos-vkfps.c, o
    # FPS do painel web e o filtro de flicker) so entra com esta variavel.
    emulator_command="env FLIPEROS_VK_FPS=1 $emulator_command"
    ;;
esac
# O renderizador dos jogos do Wine pelo driver da placa do CRT
# (config/fliperos-wine-renderer): Vulkan (amdgpu, NVIDIA, Intel da Broadwell em
# diante) usa o DXVK e o VKD3D-Proton do prefixo ("n,b": sem eles no prefixo, o
# proprio Wine); OpenGL (radeon, nouveau, Intel antiga) fica com o WineD3D do
# Wine ("b"), mesmo com o DXVK no prefixo. O PortProton escolhe pelo
# PW_VULKAN_USE do jogo (fliperos-customgame run), nao por aqui.
if ((uses_wine)) || [[ $(basename -- "$1") == fightcade* ]]; then
  renderer_bin=${FLIPEROS_WINE_RENDERER_BIN:-/opt/fliperos/bin/fliperos-wine-renderer}
  if [[ -x $renderer_bin ]]; then
    overrides=""
    case $("$renderer_bin" 2> /dev/null) in
      vulkan) overrides="dxgi,d3d9,d3d10core,d3d11,d3d12=n,b" ;;
      opengl) overrides="dxgi,d3d9,d3d10core,d3d11,d3d12=b" ;;
    esac
    if [[ -n $overrides ]]; then
      base=${WINEDLLOVERRIDES:-}
      # A sala do Fightcade (config/fliperos-fightcade) so poe o dela sem o
      # WINEDLLOVERRIDES: o que ja era, vai junto.
      [[ $(basename -- "$1") == fightcade* ]] && base=${base:-mscoree,mshtml=}
      emulator_command="env WINEDLLOVERRIDES=$(printf '%q' "${base:+$base;}$overrides") $emulator_command"
    fi
  fi
fi
# Uma tela maior que o modo (fliperos-x11-run --mode 640x240@60/640x480, o
# "240p hack" dos jogos custom): o Wine do PortProton (Proton) so oferece ao
# jogo os modos do tamanho da tela ou menores, e um jogo que so abre em
# 640x480 (o MUGEN em tela cheia) fechava com erro em 240p. A tela do X fica
# com o tamanho pedido, reduzida no modo do Switchres (640x480 em 640x240:
# metade das linhas, 240p de verdade no tubo, sem entrelacar). Visto no
# gabinete com o KOF Zillion (MUGEN 1.0). A conta usa a largura do modo de
# verdade (a super resolucao de uma placa sem dotclock baixo).
if [[ ${FLIPEROS_X11_SCREEN:-} =~ ^([0-9]+)x([0-9]+)$ ]]; then
  scale=$(awk -v w="${FLIPEROS_RES_W:-0}" -v h="${FLIPEROS_RES_H:-0}" \
    -v sw="${BASH_REMATCH[1]}" -v sh="${BASH_REMATCH[2]}" \
    'BEGIN { if (w > 0 && h > 0 && sw > 0 && sh > 0) printf "%gx%g", sw / w, sh / h }')
  [[ -z $scale || $scale == 1x1 ]] || emulator_command="$(printf '%q' "$0") --scale $scale $emulator_command"
fi
# O stdin e o /dev/null: o programa roda fora do grupo da frente do tty1 (o
# xinit -keeptty), e um que le o terminal leva SIGTTIN e fica parado, tela
# preta e sem som (o Ikemen GO do KOF Final Attack, visto no gabinete).
exec /usr/local/bin/switchres "$FLIPEROS_RES_W" "$FLIPEROS_RES_H" "$FLIPEROS_RES_HZ" \
  --ini /etc/switchres.ini --api xrandr "${args[@]}" --switch --launch "$emulator_command" < /dev/null
