#!/usr/bin/env bash
# Cliente do fliperos-x11-run: o Switchres cria o modo do jogo (monitor e
# faixas do /etc/switchres.ini, que o fliperos-setup mantem) e abre o
# emulador nele.
set -euo pipefail
connector=$(sed -n 's/^connector=//p' /etc/fliperos/fliperos.conf 2> /dev/null)
# Com cursor (fliperos-x11-run): a seta normal fora das janelas, nao o "X"
# do Xorg sem gerenciador de janelas.
if [[ ${FLIPEROS_X11_CURSOR:-0} == 1 ]]; then
  xsetroot -cursor_name left_ptr 2> /dev/null || true
fi
# Gerenciador de janelas, como o galauncher.xinitrc do GroovyArcade: quando o
# programa troca de modo pelo XRandR (o Switchres do GroovyMAME, a cada
# jogo), o openbox encaixa a janela de tela cheia na tela nova. Sem ele a
# janela ficava no tamanho do modo em que abriu: no gabinete, a interface do
# GroovyMAME num quarto da tela de 640x480 e o jogo fora do lugar. O
# programa so abre com ele pronto (_NET_SUPPORTING_WM_CHECK na raiz).
# Fundo preto: o que aparece por tras das janelas na troca de modo.
xsetroot -solid black 2> /dev/null || true
if command -v openbox > /dev/null; then
  openbox --config-file "${FLIPEROS_OPENBOX_RC:-/etc/fliperos/openbox-x11-run.xml}" &
  for _ in $(seq 1 50); do
    xprop -root _NET_SUPPORTING_WM_CHECK 2> /dev/null | grep -q 'window id' && break
    sleep 0.1
  done
fi
args=()
[[ -n $connector ]] && args+=(--display "$connector")
emulator_command=$(printf '%q ' "$@")
exec /usr/local/bin/switchres "$FLIPEROS_RES_W" "$FLIPEROS_RES_H" "$FLIPEROS_RES_HZ" \
  --ini /etc/switchres.ini --api xrandr "${args[@]}" --switch --launch "$emulator_command"
