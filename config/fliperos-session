#!/usr/bin/env bash
# Abre o launcher padrao (/etc/fliperos/session) ou o passado como argumento,
# como o startfe.sh do galauncher do GroovyArcade. Volta quando ele fecha: o
# fliperos-tty1 abre o menu do setup em seguida.
set -uo pipefail

TABLE=${FLIPEROS_SESSIONS:-/etc/fliperos/sessions.conf}
# Os frontends que a pessoa cadastra no Setup > Games > Frontend (o comando roda
# num "bash -c"; ver fliperos-setup/lib/launcher.sh).
CUSTOM=${FLIPEROS_CUSTOM_SESSIONS:-/etc/fliperos/sessions.custom.conf}
CHOICE_FILE=${FLIPEROS_SESSION:-/etc/fliperos/session}
BIN=${FLIPEROS_BIN:-/opt/fliperos/bin}
LOGS=${FLIPEROS_LOGS:-/opt/fliperos/logs}

choice=${1:-}
if [[ -z $choice ]]; then
  choice=setup
  [[ -r $CHOICE_FILE ]] && choice=$(tr -d '[:space:]' < "$CHOICE_FILE")
  [[ -n $choice ]] || choice=setup
fi

row=$(cat "$TABLE" "$CUSTOM" 2> /dev/null | grep -v '^[[:space:]]*#' | grep "^${choice}|" | head -1)
if [[ -z $row ]]; then
  echo "Unknown launcher '$choice'; opening the setup menu." >&2
  exit 0
fi

IFS='|' read -r _name backend binary package _description <<< "$row"
[[ $backend == none ]] && exit 0

program=("$binary")
check=$binary
if [[ $package == custom ]]; then
  program=(bash -c "$binary")
  check=""
  read -ra words <<< "$binary"
  for word in "${words[@]}"; do
    [[ $word =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && continue
    check=${word/#\~/$HOME}
    break
  done
fi

if ! command -v "$check" > /dev/null 2>&1 && [[ ! -x $check ]]; then
  echo "'$choice' is selected, but '$check' is not installed." >&2
  echo "Choose another one in the setup: Setup > Games > Frontend." >&2
  sleep 3
  exit 0
fi

[[ $backend == kms || $backend == x ]] || {
  echo "Unknown backend for '$choice': $backend" >&2
  exit 0
}

# x_errors: as linhas de erro do X e do xinit, sem a hora do log e sem os
# (EE) de toda vez (os drivers ati/fbdev/vesa que o X procura e nao acha, o
# contador de vblank do amdgpu).
x_errors() {
  sed -E 's/^\[ *[0-9.]+\] //' |
    grep -E '^\(EE\) |^xinit:|^Fatal server error' |
    grep -v -E '^\(EE\) *$|module does not exist|cannot get last vblank counter' |
    tail -n 12
}

# O X caiu logo ao abrir: o motivo fica na tela (para uma foto) ate o Enter,
# em vez de o menu voltar sem explicacao. So vale o que esta tentativa
# escreveu (desde SINCE, a partir do byte OFFSET do desktop.log): a saida do
# X e do xinit, que traz o "Fatal server error" mesmo quando o X cai antes de
# abrir o log dele, e no modo debug o log do Xorg, se for desta vez. O
# /var/log/Xorg.0.log e de um X como root, nunca deste, que roda como a
# pessoa: numa foto de um usuario ele so mostrou erros velhos e inofensivos.
# Uma copia do log do Xorg vai para o $LOGS.
x_failed() {
  local rc=$1 since=$2 offset=$3 log errors=""
  log=${XDG_DATA_HOME:-$HOME/.local/share}/xorg/Xorg.0.log
  [[ -r $log ]] && (($(stat -c %Y "$log" 2> /dev/null || echo 0) >= since)) || log=""
  printf '\n\e[1;31mThe X server did not start (exit code %s).\e[0m\n' "$rc"
  [[ $xlog != /dev/stdout ]] && errors=$(tail -c "+$((offset + 1))" "$xlog" 2> /dev/null | x_errors)
  [[ -z $errors && -n $log ]] && errors=$(x_errors < "$log")
  if [[ -n $errors ]]; then
    printf 'Errors:\n\n%s\n' "$errors"
  else
    printf 'The X server gave no error message.\n'
  fi
  [[ $xlog != /dev/stdout ]] && printf '\nFull output: %s\n' "$xlog"
  [[ -n $log ]] && cp -f "$log" "$LOGS/Xorg-failed.log" 2> /dev/null
  printf '\nPress Enter to return to the menu.'
  read -r -t 600 _ || true
}

# O frontend em segundo plano fecha junto com este script, saia ele como
# sair. Em segundo plano o bash o deixa ignorando o SIGINT: um Ctrl+C no
# console (o frontend em KMS nao tira o teclado do terminal) fechava so este
# script e o fliperos-tty1, e o frontend seguia vivo e sem tela, com a placa
# de som aberta (o GroovyMAME, que a abre sozinho, ficava mudo), a CPU em
# 100% e o log crescendo. Quem nao sai com o SIGTERM leva o SIGKILL.
frontend_pid=""
esc_pid=""
stop_frontend() {
  local pid=$frontend_pid i
  frontend_pid=""
  [[ -n $esc_pid ]] && kill "$esc_pid" 2> /dev/null
  [[ -n $pid ]] || return 0
  kill "$pid" 2> /dev/null || return 0
  for ((i = 0; i < 30; i++)); do
    kill -0 "$pid" 2> /dev/null || return 0
    sleep 0.1
  done
  kill -KILL "$pid" 2> /dev/null
}
trap stop_frontend EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# CPU no governador "performance" enquanto o launcher roda, e de volta ao
# anterior quando ele fecha (o cpu_governor.sh do galauncher). No modo de
# baixa latencia a CPU ja fica em performance desde o boot.
# O nome do launcher vai junto: o jogo direto no boot pula o preparo dos
# frontends (listas e arte), que so atrasaria o jogo.
sudo -n /usr/local/bin/fliperos-setup --session-start "$choice" > /dev/null 2>&1 || true
# Tela limpa e sem cursor ate o launcher assumir o monitor.
printf '\e[H\e[2J\e[?25l'

case $backend in
  kms)
    case $_name in
      # Nos frontends (e nos da pessoa) o Esc fecha e volta ao menu
      # (config/fliperos-escquit). O RetroArch e o GroovyMAME ja saem pelo
      # Esc; o Fightcade liga o dele. <&0: em segundo plano o bash daria
      # /dev/null como entrada. O FLIPEROS_POWERKEY diz ao botao de desligar
      # (config/fliperos-powerkey) que este e um frontend: com um jogo aberto
      # por ele o botao fecha o jogo; sem jogo, desliga.
      attractplus | emulationstation | pegasus | custom-*)
        FLIPEROS_POWERKEY=frontend "$BIN/fliperos-kms-run" "${program[@]}" <&0 &
        pid=$!
        frontend_pid=$pid
        "$BIN/fliperos-escquit" "$pid" < /dev/null > /dev/null 2>&1 &
        esc_pid=$!
        wait "$pid"
        rc=$?
        frontend_pid=""
        # SIGTERM do Esc: fechou como pedido.
        ((rc == 143)) && rc=0
        ;;
      # O frontend do FliperOS: em primeiro plano e sem o fliperos-escquit (o
      # Esc e o botao 2 voltam dentro dele; na lista, ele pergunta se sai).
      # O jogo que ele abre fica no arquivo do FLIPEROS_POWERKEY: o botao de
      # desligar fecha o jogo e, sem jogo, desliga (os outros filhos dele, o
      # video e o scrape, nao contam como jogo).
      fliperos)
        FLIPEROS_POWERKEY="games:${XDG_RUNTIME_DIR:-/tmp}/fliperos-frontend.game" \
          "$BIN/fliperos-kms-run" "${program[@]}"
        rc=$?
        ;;
      # Um jogo direto no boot (config/fliperos-bootgame): o comando ja traz o
      # fliperos-kms-run ou o fliperos-x11-run. FLIPEROS_POWERKEY=game: o
      # botao de desligar fecha o jogo e o menu volta.
      game)
        FLIPEROS_POWERKEY=game "${program[@]}"
        rc=$?
        ;;
      *)
        "$BIN/fliperos-kms-run" "${program[@]}"
        rc=$?
        ;;
    esac
    # O que foi digitado no frontend e caiu no console nao vai para o menu.
    python3 -c 'import termios; termios.tcflush(0, termios.TCIFLUSH)' 2> /dev/null
    ;;
  x)
    # Sessao X no proprio terminal (tty1). A configuracao do monitor vem do
    # /etc/X11/xorg.conf.d/10-fliperos.conf que o fliperos-setup gera.
    vt=$(tty 2> /dev/null)
    vt=${vt#/dev/tty}
    [[ $vt =~ ^[0-9]+$ ]] || vt=1
    # Um emulador escolhido no menu do desktop (fliperos-launch) roda depois
    # que o X fecha, e o desktop volta quando ele termina.
    request="${XDG_RUNTIME_DIR:-/tmp}/fliperos-next"
    rm -f "$request"
    # Saida do X e da sessao: no log, nao na tela (o modo debug do Setup a
    # mostra; o x_failed le o log do proprio Xorg).
    xlog=/dev/stdout
    if [[ ! -f /etc/fliperos/debug ]] && { : > "$LOGS/desktop.log"; } 2> /dev/null; then
      xlog=$LOGS/desktop.log
    fi
    while true; do
      # Os monitores extras, que um programa em KMS pode ter desligado.
      if grep -q '^screens=.*,' /etc/fliperos/fliperos.conf 2> /dev/null; then
        sudo -n /usr/local/bin/fliperos-setup --outputs all > /dev/null 2>&1 || true
      fi
      # Um jogo pedido pelo painel web (config/fliperos-web): o fliperos-tty1
      # o abre, e o desktop volta depois dele.
      [[ -s ${FLIPEROS_WEB_LAUNCH:-${XDG_RUNTIME_DIR:-/tmp}/fliperos-web-launch} ]] && break
      started=$SECONDS
      printf -v since '%(%s)T' -1
      offset=$(stat -c %s "$xlog" 2> /dev/null) || offset=0
      xinit "$binary" -- :0 -nolisten tcp "vt$vt" -keeptty >> "$xlog" 2>&1
      rc=$?
      if ((rc != 0 && SECONDS - started < 20)); then
        x_failed "$rc" "$since" "$offset"
        break
      fi
      [[ -s $request ]] || break
      mapfile -t next < "$request"
      rm -f "$request"
      # Entre o desktop e o emulador, so a tela limpa.
      printf '\e[H\e[2J\e[?25l'
      case ${next[0]:-} in
        # FLIPEROS_POWERKEY=game: o botao de desligar fecha o emulador e o
        # desktop volta (config/fliperos-powerkey).
        /opt/fliperos/bin/fliperos-kms-run | /opt/fliperos/bin/fliperos-x11-run)
          FLIPEROS_POWERKEY=game "${next[@]}"
          ;;
        *) echo "Ignoring an unknown request: ${next[*]}" >&2 ;;
      esac
    done
    ;;
esac

sudo -n /usr/local/bin/fliperos-setup --session-end > /dev/null 2>&1 || true
exit "$rc"
