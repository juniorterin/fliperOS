#!/usr/bin/env bash
# Abre o launcher padrao (/etc/fliperos/session) ou o passado como argumento,
# como o startfe.sh do galauncher do GroovyArcade. Volta quando ele fecha: o
# .bash_profile chama o fliperos-setup em seguida.
set -uo pipefail

TABLE=/etc/fliperos/sessions.conf
CHOICE_FILE=/etc/fliperos/session

choice=${1:-}
if [[ -z $choice ]]; then
  choice=setup
  [[ -r $CHOICE_FILE ]] && choice=$(tr -d '[:space:]' < "$CHOICE_FILE")
  [[ -n $choice ]] || choice=setup
fi

row=""
[[ -r $TABLE ]] && row=$(grep -v '^[[:space:]]*#' "$TABLE" | grep "^${choice}|" | head -1)
if [[ -z $row ]]; then
  echo "Unknown launcher '$choice'; opening the setup menu." >&2
  exit 0
fi

IFS='|' read -r _name backend binary _package _description <<< "$row"
[[ $backend == none ]] && exit 0

if ! command -v "$binary" > /dev/null 2>&1 && [[ ! -x $binary ]]; then
  echo "'$choice' is selected, but '$binary' is not installed." >&2
  echo "Choose another one in the setup: Setup > Frontend." >&2
  sleep 3
  exit 0
fi

case $backend in
  kms)
    exec /opt/fliperos/bin/fliperos-kms-run "$binary"
    ;;
  x)
    # Sessao X no proprio terminal (tty1). A configuracao do monitor vem do
    # /etc/X11/xorg.conf.d/10-fliperos.conf que o fliperos-setup gera.
    vt=$(tty 2> /dev/null)
    vt=${vt#/dev/tty}
    [[ $vt =~ ^[0-9]+$ ]] || vt=1
    exec xinit "$binary" -- :0 -nolisten tcp "vt$vt" -keeptty
    ;;
  *)
    echo "Unknown backend for '$choice': $backend" >&2
    exit 0
    ;;
esac
