#!/usr/bin/env python3
"""Mapeamentos de controle que o SDL2 nao faz direito sozinho.

O SDL2 (AntiMicroX, PCSX2, Dolphin, Flycast...) usa o banco de mapeamentos
dele; um controle fora do banco ganha um mapeamento automatico que:

  - deixa de fora os botoes sem par num controle moderno (BTN_C, BTN_Z,
    botoes extras): no modo de controle do AntiMicroX eles nem aparecem;
  - poe no analogico um direcional digital que o aparelho manda como eixos
    (-1/0/+1, comum em encoders de fliperama e projetos V-USB): jogos que
    andam pelo direcional nao se mexem.

Este programa pergunta ao proprio SDL como ele ve cada controle ligado e,
so nos de mapeamento automatico (ou sem mapeamento, com direcional digital),
completa: botoes que sobraram vao para gatilhos, misc1 e paddles; eixos
digitais viram direcional. Controles do banco do SDL ficam como estao. O
resultado vai para /var/lib/fliperos/gamecontrollerdb.txt (acumulado: um
controle desligado continua la), que todo programa SDL le
(SDL_GAMECONTROLLERCONFIG_FILE).

O Flycast monta o mapeamento padrao dele a partir do SDL, mas nao entende
direcional ligado a meio eixo: para esses controles ele ganha tambem os
arquivos de mapeamento (Dreamcast e arcade, na convencao do proprio Flycast),
so se ainda nao houver um.

Roda no boot e a cada controle ligado (fliperos-controllers.service, regra do
udev). Sem dependencias alem do libSDL2 e do evdev (struct/ioctl).
"""
import ctypes
import ctypes.util
import fcntl
import os
import re
import struct
import sys

DB = os.environ.get('FLIPEROS_SDL_DB', '/var/lib/fliperos/gamecontrollerdb.txt')
FLYCAST_MAPPINGS = os.environ.get('FLIPEROS_FLYCAST_MAPPINGS', '/home/fliperos/.config/flycast/mappings')
USER_ID = 1000

# Para onde vao os botoes que o mapeamento automatico deixou de fora, nesta
# ordem; e, sem mapeamento nenhum, a ordem dos botoes do comeco ao fim.
EXTRA_SLOTS = ['lefttrigger', 'righttrigger', 'misc1', 'paddle1', 'paddle2', 'paddle3', 'paddle4',
               'back', 'start', 'guide', 'leftstick', 'rightstick']
SCRATCH_SLOTS = ['a', 'b', 'x', 'y', 'leftshoulder', 'rightshoulder', 'lefttrigger', 'righttrigger',
                 'back', 'start', 'leftstick', 'rightstick', 'guide', 'misc1',
                 'paddle1', 'paddle2', 'paddle3', 'paddle4']
DPAD = ('dpleft', 'dpright', 'dpup', 'dpdown')
BUTTON = re.compile(r'b\d+$')

# Convencao do Flycast (DefaultInputMapping em core/sdl/sdl_gamepad.cpp).
FLYCAST_STD = {'a': 'btn_a', 'b': 'btn_b', 'x': 'btn_x', 'y': 'btn_y', 'leftshoulder': 'btn_z',
               'rightshoulder': 'btn_c', 'start': 'btn_start', 'back': 'btn_menu', 'guide': 'btn_dpad2_up',
               'lefttrigger': 'btn_trigger_left', 'righttrigger': 'btn_trigger_right',
               'dpup': 'btn_dpad1_up', 'dpdown': 'btn_dpad1_down', 'dpleft': 'btn_dpad1_left',
               'dpright': 'btn_dpad1_right'}
FLYCAST_ARCADE = dict(FLYCAST_STD, x='btn_c', y='btn_x', rightshoulder='btn_y')
FLYCAST_STICKS = {'leftx': ('btn_analog_left', 'btn_analog_right'), 'lefty': ('btn_analog_up', 'btn_analog_down'),
                  'rightx': ('axis2_left', 'axis2_right'), 'righty': ('axis2_up', 'axis2_down')}


# ── Mapeamento (testado em tests/test_build.py) ─────────────────────

def parse_mapping(text):
    """{elemento: entrada} de um mapeamento SDL "guid,nome,a:b0,...,"."""
    binds = {}
    for field in (text or '').split(',')[2:]:
        if ':' in field:
            key, value = field.split(':', 1)
            if key not in ('platform', 'crc', 'hint', 'sdk>=', 'sdk<='):
                binds[key] = value
    return binds


def complete(binds, nbuttons, naxes, nhats, digital_axes, scratch):
    """Mapeamento completo. `binds` e o automatico do SDL (ou vazio, se o
    controle nao tem mapeamento: `scratch`); `digital_axes` sao os indices
    dos eixos que so vao de -1 a +1."""
    out = dict(binds)
    if scratch:
        for slot, n in zip(SCRATCH_SLOTS, range(nbuttons)):
            out[slot] = 'b%d' % n
        if nhats:
            out.update(dpup='h0.1', dpright='h0.2', dpdown='h0.4', dpleft='h0.8')
        elif naxes >= 2 and {0, 1} <= digital_axes:
            out.update(dpleft='-a0', dpright='+a0', dpup='-a1', dpdown='+a1')
        elif naxes >= 2:
            out.update(leftx='a0', lefty='a1')
        return out
    # Direcional digital mandado como eixos: direcional, nao analogico.
    for xkey, ykey in (('leftx', 'lefty'), ('rightx', 'righty')):
        x, y = out.get(xkey, ''), out.get(ykey, '')
        if (not any(k in out for k in DPAD) and re.fullmatch(r'a\d+', x) and re.fullmatch(r'a\d+', y)
                and int(x[1:]) in digital_axes and int(y[1:]) in digital_axes):
            del out[xkey], out[ykey]
            out.update(dpleft='-' + x, dpright='+' + x, dpup='-' + y, dpdown='+' + y)
    used = {v for v in out.values() if BUTTON.match(v)}
    free = [s for s in EXTRA_SLOTS if s not in out]
    for n in range(nbuttons):
        if 'b%d' % n not in used and free:
            out[free.pop(0)] = 'b%d' % n
    return out


def mapping_line(guid, name, binds):
    fields = ['%s:%s' % kv for kv in sorted(binds.items())]
    return ','.join([guid, name.replace(',', ' ')] + fields + ['platform:Linux']) + ','


def merge_db(lines, new):
    """Troca as linhas dos GUIDs de `new` ({guid: linha}), mantendo as demais."""
    keep = [l for l in lines if l and not l.startswith('#') and l.split(',', 1)[0] not in new]
    return keep + [new[g] for g in sorted(new)]


def flycast_filename(name, arcade):
    clean = re.sub(r'[/\\:*?"<>|]', '-', name)
    return 'SDL_%s%s.cfg' % (clean, '_arcade' if arcade else '')


def flycast_cfg(name, binds, arcade):
    """Arquivo de mapeamento do Flycast (formato versao 4) a partir do SDL."""
    table = FLYCAST_ARCADE if arcade else FLYCAST_STD
    digital, analog = [], []
    for slot, value in sorted(binds.items()):
        if slot in FLYCAST_STICKS and re.fullmatch(r'a\d+', value):
            neg, pos = FLYCAST_STICKS[slot]
            analog += ['%s-:%s' % (value[1:], neg), '%s+:%s' % (value[1:], pos)]
            continue
        key = table.get(slot)
        if not key:
            continue
        if BUTTON.match(value):
            digital.append('%s:%s' % (value[1:], key))
        elif re.fullmatch(r'[+-]a\d+', value):
            analog.append('%s%s:%s' % (value[2:], value[0], key))
        elif re.fullmatch(r'a\d+', value):          # gatilho num eixo inteiro
            analog.append('%s+:%s' % (value[1:], key))
    text = '[analog]\n' + ''.join('bind%d = %s\n' % (i, b) for i, b in enumerate(analog))
    text += '\n[digital]\n' + ''.join('bind%d = %s\n' % (i, b) for i, b in enumerate(digital))
    text += ('\n[emulator]\ndead_zone = 10\nmapping_name = %s\nrumble_power = 100\nsaturation = 100\n'
             'triggers = \nversion = 4\n' % name)
    return text


# ── evdev: quais eixos sao digitais ─────────────────────────────────

def _ioc(direction, nr, size):
    return (direction << 30) | (size << 16) | (ord('E') << 8) | nr


def digital_axes(path):
    """Indices (na ordem do SDL: eixos sem os hats) dos eixos de -1 a +1, e
    se o aparelho tem botao de mouse (pistola de luz: fica de fora)."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return set(), False
    try:
        bits = bytearray(8)
        fcntl.ioctl(fd, _ioc(2, 0x20 + 0x03, len(bits)), bits)
        keys = bytearray(96)
        fcntl.ioctl(fd, _ioc(2, 0x20 + 0x01, len(keys)), keys)
        gun = bool(keys[0x110 // 8] >> (0x110 % 8) & 1)
        out, index = set(), 0
        for code in range(0x40):
            if not bits[code // 8] >> (code % 8) & 1 or 0x10 <= code <= 0x17:
                continue
            info = bytearray(24)
            fcntl.ioctl(fd, _ioc(2, 0x40 + code, 24), info)
            _value, low, high = struct.unpack('6i', info)[:3]
            if high - low <= 2:
                out.add(index)
            index += 1
        return out, gun
    except OSError:
        return set(), False
    finally:
        os.close(fd)


# ── SDL ────────────────────────────────────────────────────────────

class GUID(ctypes.Structure):
    _fields_ = [('data', ctypes.c_uint8 * 16)]


def controllers():
    """(guid, nome, caminho, mapeamento do SDL ou None, botoes, eixos, hats)."""
    # O que se quer e o mapeamento do proprio SDL, sem o arquivo gerado aqui.
    for var in ('SDL_GAMECONTROLLERCONFIG', 'SDL_GAMECONTROLLERCONFIG_FILE'):
        os.environ.pop(var, None)
    sdl = ctypes.CDLL(ctypes.util.find_library('SDL2') or 'libSDL2-2.0.so.0')
    sdl.SDL_JoystickGetDeviceGUID.restype = GUID
    sdl.SDL_JoystickGetGUIDString.argtypes = [GUID, ctypes.c_char_p, ctypes.c_int]
    sdl.SDL_JoystickNameForIndex.restype = ctypes.c_char_p
    sdl.SDL_JoystickPathForIndex.restype = ctypes.c_char_p
    sdl.SDL_GameControllerMappingForDeviceIndex.restype = ctypes.c_void_p
    sdl.SDL_JoystickOpen.restype = ctypes.c_void_p
    for f in ('SDL_JoystickNumButtons', 'SDL_JoystickNumAxes', 'SDL_JoystickNumHats', 'SDL_JoystickClose'):
        getattr(sdl, f).argtypes = [ctypes.c_void_p]
    sdl.SDL_free.argtypes = [ctypes.c_void_p]
    if sdl.SDL_Init(0x200 | 0x2000) != 0:  # JOYSTICK | GAMECONTROLLER
        return
    try:
        for i in range(sdl.SDL_NumJoysticks()):
            buf = ctypes.create_string_buffer(33)
            sdl.SDL_JoystickGetGUIDString(sdl.SDL_JoystickGetDeviceGUID(i), buf, 33)
            name = (sdl.SDL_JoystickNameForIndex(i) or b'').decode(errors='replace')
            path = (sdl.SDL_JoystickPathForIndex(i) or b'').decode(errors='replace')
            mapping = None
            if sdl.SDL_IsGameController(i):
                p = sdl.SDL_GameControllerMappingForDeviceIndex(i)
                if p:
                    mapping = ctypes.string_at(p).decode(errors='replace')
                    sdl.SDL_free(p)
            js = sdl.SDL_JoystickOpen(i)
            if not js:
                continue
            counts = (sdl.SDL_JoystickNumButtons(js), sdl.SDL_JoystickNumAxes(js), sdl.SDL_JoystickNumHats(js))
            sdl.SDL_JoystickClose(js)
            yield (buf.value.decode(), name, path, mapping) + counts
    finally:
        sdl.SDL_Quit()


def main():
    new = {}
    flycast = []
    for guid, name, path, mapping, nbuttons, naxes, nhats in controllers():
        # Do banco do SDL (tem "platform:"): curado, fica como esta.
        if mapping and 'platform:' in mapping:
            continue
        digital, gun = digital_axes(path)
        if gun or nbuttons < 2:
            continue
        scratch = mapping is None
        if scratch and not (nhats or {0, 1} <= digital):
            continue  # sem mapeamento e com analogico de verdade: volante, manche
        base = parse_mapping(mapping)
        binds = complete(base, nbuttons, naxes, nhats, digital, scratch)
        if binds == base:
            continue
        new[guid] = mapping_line(guid, name, binds)
        if any(binds.get(k, '').startswith(('+', '-')) for k in DPAD):
            flycast.append((name, binds))
        print('%s: %s' % (name, new[guid]))
    try:
        lines = open(DB).read().splitlines()
    except OSError:
        lines = []
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    with open(DB + '.new', 'w') as f:
        f.write('# Gerado por fliperos-controllers (Setup e README, "Controles no SDL").\n')
        f.write(''.join(l + '\n' for l in merge_db(lines, new)))
    os.chmod(DB + '.new', 0o644)
    os.replace(DB + '.new', DB)
    for name, binds in flycast:
        for arcade in (False, True):
            target = os.path.join(FLYCAST_MAPPINGS, flycast_filename(name, arcade))
            if os.path.exists(target):
                continue
            os.makedirs(FLYCAST_MAPPINGS, exist_ok=True)
            with open(target, 'w') as f:
                f.write(flycast_cfg(name, binds, arcade))
            try:
                os.chown(FLYCAST_MAPPINGS, USER_ID, USER_ID)
                os.chown(target, USER_ID, USER_ID)
            except OSError:
                pass
    return 0


if __name__ == '__main__':
    sys.exit(main())
