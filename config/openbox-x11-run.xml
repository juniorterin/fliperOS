<?xml version="1.0" encoding="UTF-8"?>
<!--
  Openbox do fliperos-x11-run (/etc/fliperos/openbox-x11-run.xml), como o
  galauncher.xinitrc do GroovyArcade sobe o openbox antes do frontend: quando
  o programa troca de modo pelo XRandR (o Switchres do GroovyMAME, a cada
  jogo), o openbox encaixa a janela de tela cheia na tela nova. Sem bordas,
  as janelas normais maximizadas e nenhum atalho: so um programa por vez.
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <placement>
    <policy>Smart</policy>
  </placement>
  <!-- Tudo preto (config/openbox-black-themerc): no tema padrao a moldura,
       que aparece na troca de modo, e branca. -->
  <theme>
    <name>FliperOS-Black</name>
  </theme>
  <desktops>
    <number>1</number>
  </desktops>
  <margins>
    <top>0</top>
    <bottom>0</bottom>
    <left>0</left>
    <right>0</right>
  </margins>
  <keyboard/>
  <mouse>
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
    </context>
  </mouse>
  <applications>
    <application class="*">
      <decor>no</decor>
    </application>
    <application class="*" type="normal">
      <maximized>yes</maximized>
    </application>
  </applications>
</openbox_config>
