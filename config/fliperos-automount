#!/usr/bin/env bash
# Monta sozinho cada disco que aparece (no boot e ao ligar um pendrive), pelo
# udisks2 em nome do usuario: fica em /media/fliperos/<rotulo>, com o dono
# certo nos FAT, exFAT e NTFS, e o desktop (PCManFM, show_mounts) mostra um
# icone para cada um. Chamado pelo fliperos-automount@.service, que a regra
# 99-fliperos-disks.rules liga para cada sistema de arquivos.
#
#   fliperos-automount /dev/sdb1
#
# So no disco instalado: na midia de instalacao um disco montado nao seria
# apagado pelo instalador. Fica de fora o que ja esta montado, o que nao e
# para abrir (swap, LUKS, LVM, RAID) e as particoes de sistema (EFI, as de
# recuperacao e reservada do Windows).
set -u
dev=${1:?Uso: fliperos-automount /dev/DISPOSITIVO}
ETC=${FLIPEROS_ETC:-/etc/fliperos}
user=${FLIPEROS_AUTOMOUNT_USER:-fliperos}

[[ -f $ETC/installed && -b $dev ]] || exit 0
[[ -z $(findmnt -rno TARGET -S "$dev" 2> /dev/null) ]] || exit 0
udevadm info -q property -n "$dev" 2> /dev/null | grep -qx 'UDISKS_IGNORE=1' && exit 0

case $(lsblk -dno FSTYPE "$dev" 2> /dev/null) in
  '' | swap | crypto_LUKS | LVM2_member | linux_raid_member | zfs_member | bcache | squashfs) exit 0 ;;
esac
case $(lsblk -dno PARTTYPE "$dev" 2> /dev/null | tr 'A-F' 'a-f') in
  # EFI, recuperacao do Windows, reservada da Microsoft, BIOS boot (GPT e MBR).
  c12a7328-f81f-11d2-ba4b-00a0c93ec93b | de94bba4-06d1-4d40-a16a-bfd50179d6ac | \
    e3c9e316-0b5c-4db8-817d-f92df00215ae | 21686148-6449-6e6f-744e-656564454649 | 0xef | 0x27) exit 0 ;;
esac

exec runuser -u "$user" -- udisksctl mount --no-user-interaction -b "$dev"
