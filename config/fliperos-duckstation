#!/usr/bin/env bash
# DuckStation (github.com/stenzek/duckstation): emulador de PlayStation.
#
# A licenca dele (CC BY-NC-ND 4.0) nao deixa redistribuir: nao vem na imagem
# nem no repositorio do FliperOS. O Setup > Games > Emulators & Games baixa o
# AppImage oficial do GitHub dele (fetch, a versao "latest") e o extrai em
# /opt/duckstation, como o PCSX2 da imagem: extraido, roda sem FUSE e sem o
# atualizador e o atalho que o proprio DuckStation cria quando e AppImage.
# Instalar de novo atualiza.
#
#   fliperos-duckstation fetch [--progress]   baixa e instala (como root)
#
# O comando e /usr/local/bin/duckstation (o TryExec do atalho do desktop); o
# fliperos-x11-run o abre no modo da tabela emulator-modes.conf, em tela
# cheia, e grava a configuracao de partida (BIOS em ~/bios, jogos em
# ~/roms/duckstation, os controles pelo SDL).
# shellcheck disable=SC2015 # "a && b || fail": falhar em qualquer passo e o que se quer
set -uo pipefail
dir=${DUCKSTATION_DIR:-/opt/duckstation}
bin=${DUCKSTATION_BIN:-/usr/local/bin/duckstation}
icon=${DUCKSTATION_ICON:-/usr/local/share/pixmaps/duckstation.png}
url=${DUCKSTATION_URL:-https://github.com/stenzek/duckstation/releases/download/latest/DuckStation-x64.AppImage}
folders=${FLIPEROS_ROMS_SCRIPT:-/opt/fliperos/bin/fliperos-roms}
user=${FLIPEROS_USER:-fliperos}

progress=0
say() {
  if ((progress)); then printf '@step %s %s\n' "$1" "$2"; else printf '%s\n' "$2"; fi
}
fail() {
  if ((progress)); then printf '@fail DuckStation|%s\n' "$1"; else printf 'fliperos-duckstation: %s\n' "$1" >&2; fi
  exit 1
}

fetch() {
  local image
  [[ ${1:-} == --progress ]] && progress=1
  work=$(mktemp -d) || fail "could not create a temporary folder"
  # shellcheck disable=SC2064 # a pasta de agora
  trap "rm -rf '$work'" EXIT
  image=$work/DuckStation.AppImage
  say 0 "Downloading DuckStation from GitHub"
  # De 0 a 80%: o download (uns 50 MB).
  python3 - "$url" "$image" "$progress" << 'PY' || fail "the download failed (no network?)"
import sys
import urllib.request

url, part, progress = sys.argv[1], sys.argv[2], sys.argv[3] == '1'
last = -1
for attempt in range(3):
    try:
        req = urllib.request.Request(url, headers={'User-Agent': 'fliperos-duckstation'})
        with urllib.request.urlopen(req, timeout=60) as resp, open(part, 'wb') as out:
            total = int(resp.headers.get('Content-Length') or 0)
            done = 0
            while True:
                chunk = resp.read(1 << 18)
                if not chunk:
                    break
                out.write(chunk)
                done += len(chunk)
                pct = done * 80 // total if total else 0
                if progress and pct != last:
                    last = pct
                    print('@step %d Downloading DuckStation (%d of %d MB)' % (pct, done >> 20, total >> 20), flush=True)
            if total and done != total:
                raise OSError('incomplete download')
        break
    except OSError as e:
        print('fliperos-duckstation: %s' % e, file=sys.stderr)
        if attempt == 2:
            sys.exit(1)
PY
  say 85 "Unpacking"
  chmod 755 "$image"
  # O --appimage-extract do runtime do AppImage cria squashfs-root na pasta
  # atual, sem FUSE.
  (cd "$work" && "$image" --appimage-extract > /dev/null 2>&1)
  [[ -x $work/squashfs-root/AppRun ]] || fail "the downloaded file is not the DuckStation AppImage"
  mkdir -p "${dir%/*}" && rm -rf "$dir.new" && mv "$work/squashfs-root" "$dir.new" ||
    fail "could not write to ${dir%/*}"
  chmod -R a+rX "$dir.new"
  rm -rf "$dir" && mv "$dir.new" "$dir" || fail "could not write $dir"
  mkdir -p "${bin%/*}" && printf '#!/bin/sh\nexec %s/AppRun "$@"\n' "$dir" > "$bin" && chmod 755 "$bin" ||
    fail "could not write $bin"
  # O icone do menu do desktop (config/applications/fliperos-duckstation.desktop).
  local png
  png=$(find "$dir" -maxdepth 1 -name '*.png' -print -quit)
  [[ -z $png ]] || install -Dm644 "$(readlink -f "$png")" "$icon" 2> /dev/null || true
  say 95 "ROM folder in ~/roms/duckstation"
  if [[ -x $folders ]]; then
    if ((EUID == 0)) && [[ $user != root ]]; then
      runuser -u "$user" -- env HOME="$(getent passwd "$user" | cut -d: -f6)" "$folders"
    else
      "$folders"
    fi
  fi
  say 100 "DuckStation installed"
}

case ${1:-} in
  fetch)
    shift
    fetch "$@"
    ;;
  *)
    echo "Usage: fliperos-duckstation fetch [--progress]" >&2
    exit 2
    ;;
esac
