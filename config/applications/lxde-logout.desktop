[Desktop Entry]
# O botao de sair do painel do LXDE (o mesmo ID do lxde-logout.desktop do
# pacote, que /usr/local/share/applications passa na frente): fecha o desktop
# e volta direto ao menu do FliperOS (config/fliperos-logout), sem a janela
# do lxsession-logout.
Type=Application
Name=Back to the menu
Comment=Leave the desktop and go back to the FliperOS menu
Icon=gnome-logout
Exec=/opt/fliperos/bin/fliperos-logout
Categories=System;
NoDisplay=true
