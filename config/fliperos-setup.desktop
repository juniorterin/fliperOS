[Desktop Entry]
Type=Application
Name=FliperOS Setup
Comment=Video, audio, network, frontend, scraper and system update
# O Setup na interface grafica, numa janela sem borda do tamanho da tela: o
# --desktop leva o display (e o Xauthority) que o sudo tira do ambiente. O
# terminal (Terminal=true) e o caminho de volta para o texto, se a janela
# nao abrir. O sudo nao pede senha (/etc/sudoers.d/fliperos-setup).
# Categories=System poe o atalho em "System Tools" no menu do LXDE, como o
# gasetup.desktop do GroovyArcade.
Exec=sh -c 'sudo /usr/local/bin/fliperos-setup --desktop "$DISPLAY" "${XAUTHORITY:-$HOME/.Xauthority}"'
Terminal=true
Icon=preferences-system
Categories=System;
Keywords=fliperos;arcade;crt;setup;
