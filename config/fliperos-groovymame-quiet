#!/usr/bin/env python3
"""Tira os textos que o GroovyMAME mostra ao abrir o jogo.

    fliperos-groovymame-quiet [BINARIO]

O "Initializing..." e, durante a leitura das ROMs, o "Loading Machine (45%)",
o "Loading Complete" e o "Decrypting 45%". O MAME nao tem opcao para eles (o
skip_warnings e o skip_gameinfo tiram as outras telas; o "nonag" dos builds
proprios tira estas no codigo). O FliperOS usa o release oficial, sem
compilar: cada texto vira vazio no proprio binario (a primeira letra vira o
fim do texto, o tamanho do arquivo nao muda). O "%s (%d%%)" e o do
carregamento das ROMs: no binario ele fica junto dos outros e so aparece uma
vez. Um texto ja mudado, ou de uma versao sem ele, fica como esta. Roda no
build da imagem (fliperos-mkiso.sh) e a cada update (fliperos-rootfs.sh).
"""
import os
import sys

BINARY = '/usr/local/libexec/groovymame'
TEXTS = (b'\0Initializing...\0', b'\0Loading Software\0', b'\0Loading Machine\0', b'\0%s (%d%%)\0',
         b'\0Loading Complete\0', b'\0Decrypting %d%%\0')


def main():
    path = sys.argv[1] if len(sys.argv) > 1 else BINARY
    try:
        with open(path, 'rb') as f:
            data = f.read()
    except OSError as e:
        print('fliperos-groovymame-quiet: %s' % e, file=sys.stderr)
        return 1
    # 0: ja mudado (ou outra versao); mais de um: nao e o texto do MAME.
    spots = [data.index(t) + 1 for t in TEXTS if data.count(t) == 1]
    if not spots:
        print('unchanged')
        return 0
    with open(path, 'r+b') as f:
        for at in spots:
            f.seek(at)
            f.write(b'\0')
    os.utime(path)
    print('patched %d texts' % len(spots))
    return 0


if __name__ == '__main__':
    sys.exit(main())
