#!/usr/bin/env python3
"""Um EDID com os modos pedidos (ate dois), para o kernel oferecer todos.

    fliperos-edid-modes ARQUIVO < MODELINES

Cada linha da entrada e um modeline do Switchres ("640x240_60 ..." clock
hdisp hss hse htot vdisp vss vse vtot [interlace] [-+]hsync [-+]vsync), o
primeiro e o modo preferido. Com o monitor em pe o console vai em 640x480i
(60 colunas de texto) e o menu e o frontend trocam para o 640x240 deles:
sem EDID o kernel so conhece o modo do video= (lib/video.sh vertical_edid).
O EDID e um 1.3 analogico, com os modos, a faixa do monitor e o nome.
"""
import re
import sys

LINE = re.compile(r'"?[^"]*"?\s+([\d.]+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)(.*)$')


def parse(text):
    """(clock MHz, h..., v..., interlace, hsync+, vsync+) do modeline."""
    m = LINE.search(text.strip().replace("Modeline", ""))
    if not m:
        raise ValueError("not a modeline: " + text)
    clock = float(m.group(1))
    h = [int(m.group(i)) for i in range(2, 6)]
    v = [int(m.group(i)) for i in range(6, 10)]
    rest = m.group(10)
    return clock, h, v, "interlace" in rest, "+hsync" in rest, "+vsync" in rest


def dtd(mode, size=(485, 364)):
    clock, (ha, hss, hse, ht), (va, vss, vse, vt), interlace, hpos, vpos = mode
    pc = round(clock * 100)
    hb, hso, hsw = ht - ha, hss - ha, hse - hss
    if interlace:
        # Os valores de um campo: o kernel dobra e soma 1 ao total.
        va, vb, vso, vsw = va // 2, (vt - va) // 2, (vss - va) // 2, (vse - vss) // 2
    else:
        vb, vso, vsw = vt - va, vss - va, vse - vss
    w, h = size
    flags = 0x18 | (0x80 if interlace else 0) | (0x02 if hpos else 0) | (0x04 if vpos else 0)
    return bytes([
        pc & 0xFF, pc >> 8,
        ha & 0xFF, hb & 0xFF, ((ha >> 8) << 4) | (hb >> 8),
        va & 0xFF, vb & 0xFF, ((va >> 8) << 4) | (vb >> 8),
        hso & 0xFF, hsw & 0xFF, ((vso & 0x0F) << 4) | (vsw & 0x0F),
        ((hso >> 8) << 6) | ((hsw >> 8) << 4) | ((vso >> 4) << 2) | (vsw >> 4),
        w & 0xFF, h & 0xFF, ((w >> 8) << 4) | (h >> 8),
        0, 0, flags,
    ])


def text_descriptor(tag, text):
    data = text.encode("ascii")[:13]
    if len(data) < 13:
        data += b"\n" + b" " * (12 - len(data))
    return bytes([0, 0, 0, tag, 0]) + data


def range_descriptor(modes):
    hz = [m[0] * 1e6 / (m[1][3] * m[2][3]) * (2 if m[3] else 1) for m in modes]
    khz = [m[0] * 1000 / m[1][3] for m in modes]
    clock = max(m[0] for m in modes)
    return bytes([0, 0, 0, 0xFD, 0,
                  max(1, int(min(hz)) - 3), int(max(hz)) + 3,
                  max(1, int(min(khz)) - 1), int(max(khz)) + 1,
                  int(clock // 10) + 1, 0, 0x0A, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20])


def edid(modes):
    out = bytearray(b"\x00\xff\xff\xff\xff\xff\xff\x00")
    out += (((ord("F") - 64) << 10) | ((ord("O") - 64) << 5) | (ord("S") - 64)).to_bytes(2, "big")
    out += (1).to_bytes(2, "little") + bytes(4) + bytes([0, 36])     # 2026
    out += bytes([1, 3])                                             # EDID 1.3
    out += bytes([0x08, 48, 36, 120, 0x0A])                          # analogico, 48x36 cm, gama 2.2
    out += bytes([0xEE, 0x91, 0xA3, 0x54, 0x4C, 0x99, 0x26, 0x0F, 0x50, 0x54])
    out += bytes(3) + b"\x01\x01" * 8
    blocks = [dtd(m) for m in modes[:2]]
    blocks.append(range_descriptor(modes))
    blocks.append(text_descriptor(0xFC, "FliperOS"))
    while len(blocks) < 4:
        blocks.append(text_descriptor(0xFE, ""))
    for b in blocks[:4]:
        out += b
    out += bytes([0])
    out.append((256 - sum(out) % 256) % 256)
    assert len(out) == 128
    return bytes(out)


def main():
    if len(sys.argv) != 2:
        print(__doc__.strip().splitlines()[2].strip(), file=sys.stderr)
        return 2
    modes = [parse(line) for line in sys.stdin if line.strip()]
    if not modes:
        print("fliperos-edid-modes: no modeline", file=sys.stderr)
        return 1
    tmp = sys.argv[1] + ".tmp"
    with open(tmp, "wb") as f:
        f.write(edid(modes))
    import os
    os.replace(tmp, sys.argv[1])
    return 0


if __name__ == "__main__":
    sys.exit(main())
