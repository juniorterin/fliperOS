#!/usr/bin/env bash
# O fluxo do tty1, o do .bash_profile do GroovyArcade: no disco instalado,
# primeiro boot (launcher padrao), o launcher e, quando ele fecha, o menu
# do setup; na midia de instalacao, direto o setup (teste de saidas e o
# FliperOS Setup). Chamado pelo ~/.zprofile (o shell do usuario e o zsh) e
# pelo ~/.bash_profile; quando o setup sai para o shell, o shell segue.
#
#   fliperos-tty1          o boot: launcher padrao e depois o menu
#   fliperos-tty1 --menu   so o menu (o comando fliperos-menu do shell)
#
# O menu e um laco. "Start frontend" e "Start desktop" fazem o setup gravar
# o pedido em /run/fliperos/launch e sair com 20; o launcher abre aqui, no
# shell do login, com o tty1 como terminal de controle. De dentro do setup
# (root, no pty do sudo) o X nao consegue trocar de VT e nao abre.
ETC=${FLIPEROS_ETC:-/etc/fliperos}
BIN=${FLIPEROS_BIN:-/opt/fliperos/bin}
REQUEST=${FLIPEROS_LAUNCH_REQUEST:-/run/fliperos/launch}
PLYMOUTH_PID=${FLIPEROS_PLYMOUTH_PID:-/run/plymouth/pid}

# splash_off: tira o splash do boot logo antes do que aparece na tela. O
# systemd o deixa no ar ate aqui (o plymouth-quit do fliperos-rootfs.sh),
# para o login e a espera da rede do update nao ficarem com a tela preta.
splash_off() {
  [[ -e $PLYMOUTH_PID ]] && sudo -n /usr/bin/plymouth quit 2> /dev/null
  return 0
}

menu() {
  local rc name
  splash_off
  while true; do
    sudo /usr/local/bin/fliperos-setup --menu
    rc=$?
    ((rc == 20)) || return 0
    name=$(cat "$REQUEST" 2> /dev/null)
    [[ $name == default ]] && name=""
    "$BIN/fliperos-session" ${name:+"$name"}
  done
}

# net_expected: a rede ainda pode subir? Cabo ligado (a placa sem cabo fica
# "unavailable") ou Wi-Fi com uma rede salva.
net_expected() {
  local devs
  devs=$(nmcli -t -f TYPE,STATE device 2> /dev/null)
  grep -qE '^ethernet:(connecting|connected|disconnected)' <<< "$devs" && return 0
  grep -q '^wifi:' <<< "$devs" && nmcli -t -f TYPE connection show 2> /dev/null | grep -q '802-11-wireless'
}

# update_pending: com rede, ha um update do FliperOS (config/fliperos-update)?
# Espera o NetworkManager subir (ate 15 s) e, se ha cabo ou Wi-Fi salvo, a
# conexao (ate 30 s: o "startup complete" do NetworkManager vem antes do
# Wi-Fi conectar). Sem rede, ou com qualquer erro, o boot segue sem perguntar.
update_pending() {
  [[ -x $BIN/fliperos-update ]] || return 1
  if command -v nm-online > /dev/null; then
    nm-online -q -s -t 15 > /dev/null 2>&1
    if ! nm-online -q -t 5 > /dev/null 2>&1; then
      net_expected || return 1
      nm-online -q -t "${FLIPEROS_UPDATE_NET_WAIT:-30}" > /dev/null 2>&1 || return 1
    fi
  fi
  [[ -n $(FLIPEROS_UPDATE_LOG=/dev/null "$BIN/fliperos-update" check 2> /dev/null) ]]
}

if [[ ${1:-} != --menu ]]; then
  sudo setterm --blank 0 --powerdown 0 2> /dev/null
  # Pastas de ~/roms que faltarem (um core novo do RetroArch, por exemplo).
  "$BIN/fliperos-roms" > /dev/null 2>&1
  if [[ -f $ETC/installed ]]; then
    if [[ -f $ETC/firstboot ]]; then
      splash_off
      sudo /usr/local/bin/fliperos-setup --first-boot
    elif update_pending; then
      splash_off
      sudo /usr/local/bin/fliperos-setup --update-check
    fi
    splash_off
    "$BIN/fliperos-session"
  fi
fi
menu
