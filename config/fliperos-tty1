#!/usr/bin/env bash
# O fluxo do tty1, o do .bash_profile do GroovyArcade: no disco instalado,
# primeiro boot (launcher padrao), o launcher e, quando ele fecha, o menu
# do setup; na midia de instalacao, direto o setup (teste de saidas e o
# FliperOS Setup). Chamado pelo ~/.zprofile (o shell do usuario e o zsh) e
# pelo ~/.bash_profile; quando o setup sai para o shell, o shell segue.
#
#   fliperos-tty1          o boot: launcher padrao e depois o menu
#   fliperos-tty1 --menu   so o menu (o comando fliperos-menu do shell)
#
# O menu e um laco. "Start frontend" e "Start desktop" fazem o setup gravar
# o pedido em /run/fliperos/launch e sair com 20; o launcher abre aqui, no
# shell do login, com o tty1 como terminal de controle. De dentro do setup
# (root, no pty do sudo) o X nao consegue trocar de VT e nao abre.
ETC=${FLIPEROS_ETC:-/etc/fliperos}
BIN=${FLIPEROS_BIN:-/opt/fliperos/bin}
REQUEST=${FLIPEROS_LAUNCH_REQUEST:-/run/fliperos/launch}
PLYMOUTH_PID=${FLIPEROS_PLYMOUTH_PID:-/run/plymouth/pid}
SOUNDS_HELPER=${FLIPEROS_SOUNDS_HELPER:-/usr/local/lib/fliperos-setup/gui/fesound.py}

# menu_sound EVENTO: o som do menu do Setup (Audio > Menu sounds), o de abrir e
# o de fechar o que o menu abre (o frontend, o desktop, um jogo). O fesound
# toca com o aplay, em segundo plano, e volta na hora.
menu_sound() {
  [[ -f $SOUNDS_HELPER ]] && python3 -I "$SOUNDS_HELPER" play menu "$1" > /dev/null 2>&1
  return 0
}
# Este arquivo quando o tty1 subiu: o bash segue com o codigo que leu, e um
# update feito com um jogo ou o frontend na tela troca o arquivo sem reiniciar
# o tty1. O laco do menu ve a troca e continua no novo (tty1_reload).
TTY1_STAMP=$(stat -c '%Y:%s' "$0" 2> /dev/null)

# splash_off: tira o splash do boot logo antes do que aparece na tela. O
# systemd o deixa no ar ate aqui (o plymouth-quit do fliperos-rootfs.sh),
# para o login e a espera da rede do update nao ficarem com a tela preta.
services_screen=""
splash_off() {
  [[ -e $PLYMOUTH_PID ]] && sudo -n /usr/bin/plymouth quit 2> /dev/null
  # A primeira tela do boot (o menu, o frontend ou o jogo): os servicos em
  # "After boot" (Setup > System > Services) sobem daqui a uns 15 s, com
  # ela ja carregada. Volta na hora.
  if [[ -z $services_screen ]]; then
    services_screen=1
    sudo -n /usr/local/bin/fliperos-setup --services-screen > /dev/null 2>&1
  fi
  # A calibracao de cor (Setup > Video Setup > Colour calibration) na placa,
  # agora que o splash soltou o video.
  [[ -x ${FLIPEROS_COLOR:-/usr/local/bin/fliperos-color} ]] &&
    "${FLIPEROS_COLOR:-/usr/local/bin/fliperos-color}" apply > /dev/null 2>&1
  return 0
}

# O jogo pedido pelo painel web (config/fliperos-web, Games > Play): o painel
# grava o pedido e fecha o que estiver na tela (o jogo, o frontend, o desktop
# ou o menu). A primeira linha e o que volta depois ("return=" e um launcher
# do sessions.conf, ou "menu"); as outras, o comando.
WEB_LAUNCH=${FLIPEROS_WEB_LAUNCH:-${XDG_RUNTIME_DIR:-/tmp}/fliperos-web-launch}

# web_launch abre o pedido do painel, se houver, e depois o que estava na
# tela. Status 1: nenhum pedido.
web_launch() {
  local back
  local -a lines
  [[ -s $WEB_LAUNCH ]] || return 1
  mapfile -t lines < "$WEB_LAUNCH"
  rm -f "$WEB_LAUNCH"
  splash_off
  printf '\e[H\e[2J\e[?25l'
  case ${lines[1]:-} in
    # FLIPEROS_POWERKEY=game: o botao de desligar fecha o jogo.
    "$BIN/fliperos-kms-run" | "$BIN/fliperos-x11-run")
      FLIPEROS_POWERKEY=game "${lines[@]:1}"
      ;;
    # Abrir no gabinete (o Setup no painel): so uma tela do Setup, pelo nome
    # (o fliperos-setup confere a lista, screens/panel.sh).
    sudo)
      if [[ ${#lines[@]} -eq 6 && ${lines[*]:2:3} == "-n /usr/local/bin/fliperos-setup --screen" ]]; then
        sudo -n /usr/local/bin/fliperos-setup --screen "${lines[5]}"
      else
        echo "Ignoring an unknown request from the web panel: ${lines[*]:1}" >&2
      fi
      ;;
    *) echo "Ignoring an unknown request from the web panel: ${lines[*]:1}" >&2 ;;
  esac
  python3 -c 'import termios; termios.tcflush(0, termios.TCIFLUSH)' 2> /dev/null
  printf '\e[H\e[2J\e[?25l'
  # O painel fechou este jogo para abrir outro: o novo pedido vem antes (o
  # laco do menu o abre), e ele traz o que volta depois.
  [[ -s $WEB_LAUNCH ]] && return 0
  back=${lines[0]#return=}
  [[ -n $back && $back != menu ]] && "$BIN/fliperos-session" "$back"
  return 0
}

# A troca de tela pelo cabo (Setup > Video Setup > Screen switch,
# fliperos-setup/lib/screens.sh): o tubo de 15 kHz ou o monitor de 31 kHz no
# cabo. O vigia (fliperos-screen-watch.service) troca sozinho, fecha o que
# estava na tela e deixa aqui o pedido de reabrir.
SCREEN_RELAUNCH=${FLIPEROS_SCREEN_RELAUNCH:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/fliperos-screen-relaunch}

# screen_sync: a tela do cabo vira a do sistema antes do que abre (espera a
# troca que o vigia estiver fazendo). Sem a troca ligada, volta na hora.
screen_sync() {
  grep -q '^screen_switch=on' "$ETC/fliperos.conf" 2> /dev/null || return 0
  sudo -n /usr/local/bin/fliperos-setup --screen-sync > /dev/null 2>&1
  return 0
}

# screen_relaunch: o vigia trocou de tela e fechou o que estava aberto: a
# sessao (o frontend) abre de novo, ja no modo da tela nova. Status 1 sem
# pedido, ou quando era o menu (o laco o abre).
screen_relaunch() {
  local what
  [[ -e $SCREEN_RELAUNCH ]] || return 1
  what=$(head -n 1 "$SCREEN_RELAUNCH" 2> /dev/null)
  rm -f "$SCREEN_RELAUNCH"
  screen_sync
  [[ $what == session=* ]] || return 1
  what=${what#session=}
  "$BIN/fliperos-session" ${what:+"$what"}
  return 0
}

# tty1_reload: este arquivo mudou desde que o tty1 subiu (um update): o menu
# continua pelo arquivo novo, que traz o web_launch novo (as telas do Setup
# pedidas pelo painel). So a parte do menu: o boot ja passou.
tty1_reload() {
  [[ -n $TTY1_STAMP && $(stat -c '%Y:%s' "$0" 2> /dev/null) != "$TTY1_STAMP" ]] || return 0
  exec "$0" --menu
}

menu() {
  local rc name remote=()
  splash_off
  # Num terminal que nao e um VT do gabinete (o fliperos-menu digitado no
  # SSH), o menu e o de texto ali mesmo: a interface grafica abriria no
  # monitor do gabinete. O teste e aqui, antes do sudo, que sempre da um pty.
  [[ $(tty 2> /dev/null) == /dev/tty[0-9]* ]] || remote=(--remote)
  while true; do
    tty1_reload
    # No SSH (--remote) o pedido do painel nao e deste terminal.
    if ((${#remote[@]} == 0)) && web_launch; then
      continue
    fi
    # Uma troca de tela fechou o frontend: ele abre de novo, na tela nova.
    if ((${#remote[@]} == 0)) && screen_relaunch; then
      continue
    fi
    ((${#remote[@]} == 0)) && screen_sync
    sudo /usr/local/bin/fliperos-setup --menu "${remote[@]}"
    rc=$?
    # O que foi apertado no menu e caiu no console (setas, Enter do
    # controle) nao aparece nem vai para o que abre agora: a entrada
    # descartada e a tela limpa.
    python3 -c 'import termios; termios.tcflush(0, termios.TCIFLUSH)' 2> /dev/null
    printf '\e[H\e[2J\e[?25l'
    # O painel web fechou o menu para abrir um jogo: o laco o abre.
    [[ ${#remote[@]} -eq 0 && -s $WEB_LAUNCH ]] && continue
    # Uma troca de tela fechou o menu: o laco o abre de novo, na tela nova.
    [[ ${#remote[@]} -eq 0 && -e $SCREEN_RELAUNCH ]] && continue
    if ((rc != 20)); then
      # Exit to shell (10): o mesmo "Open game" do frontend e do desktop.
      ((rc == 10 && ${#remote[@]} == 0)) && menu_sound open
      return 0
    fi
    name=$(cat "$REQUEST" 2> /dev/null)
    # O navegador do Downloader (Setup > Games > Downloader): o Setup volta
    # depois, na tela do magnet link.
    if [[ $name == browser ]]; then
      # O endereco pedido pelo Setup (o cadastro do RetroAchievements); sem
      # ele, a busca do Downloader.
      url=$(head -n 1 "${FLIPEROS_BROWSER_URL_FILE:-/run/fliperos/browser-url}" 2> /dev/null)
      FLIPEROS_BROWSER_URL=${url:-${FLIPEROS_BROWSER_URL:-}} "$BIN/fliperos-browser"
      continue
    fi
    [[ $name == default ]] && name=""
    menu_sound open
    "$BIN/fliperos-session" ${name:+"$name"}
    menu_sound close
  done
}

# net_expected: a rede ainda pode subir? Cabo ligado (a placa sem cabo fica
# "unavailable") ou Wi-Fi com uma rede salva e o radio ligado. Com o Wi-Fi em
# "After boot" (Setup > System > Services) o radio so liga depois da primeira
# tela: espera-lo aqui era segurar o boot os 30 s inteiros.
net_expected() {
  local devs
  devs=$(nmcli -t -f TYPE,STATE device 2> /dev/null)
  grep -qE '^ethernet:(connecting|connected|disconnected)' <<< "$devs" && return 0
  grep -q '^wifi:' <<< "$devs" && [[ $(nmcli radio wifi 2> /dev/null) == enabled ]] &&
    nmcli -t -f TYPE connection show 2> /dev/null | grep -q '802-11-wireless'
}

# update_pending: ha um update do FliperOS (config/fliperos-update)? O boot
# nao procura: le o que o fliperos-update-check.service guardou num boot
# anterior, sem rede. So com um update ja conhecido ele espera a rede, que a
# tela do update usa: o NetworkManager (ate 15 s) e, se ha cabo ou Wi-Fi
# salvo, a conexao (ate 30 s: o "startup complete" do NetworkManager vem
# antes do Wi-Fi conectar). Sem rede, o boot segue sem perguntar, e o update
# entra ao desligar (fliperos-update-shutdown.service).
update_pending() {
  [[ -x $BIN/fliperos-update ]] || return 1
  [[ -n $("$BIN/fliperos-update" pending 2> /dev/null) ]] || return 1
  if command -v nm-online > /dev/null; then
    nm-online -q -s -t 15 > /dev/null 2>&1
    if ! nm-online -q -t 0 > /dev/null 2>&1; then
      net_expected || return 1
      nm-online -q -t "${FLIPEROS_UPDATE_NET_WAIT:-30}" > /dev/null 2>&1 || return 1
    fi
  fi
  return 0
}

# game_mode: o boot abre um jogo direto (Setup > Games > Frontend). Nada
# que espere a rede ou varra pastas fica antes dele.
game_mode() {
  [[ $(tr -d '[:space:]' < "$ETC/session" 2> /dev/null) == game ]]
}

# hw_maybe_changed: o fliperos.conf tem o ID da placa de video (gpu_id) e
# nenhuma placa do barramento PCI tem esse ID (com driver ou sem, como o
# video_hw_present): a placa foi trocada. So le o sysfs, sem subir o Setup.
# Sem gpu_id (instalacao antiga) quem decide e o servico de boot
# (video_hw_boot_check), que grava o ID na primeira vez.
hw_maybe_changed() {
  local id dev vendor device
  id=$(sed -n 's/^gpu_id=//p' "$ETC/fliperos.conf" 2> /dev/null | head -n 1)
  [[ -n $id ]] || return 1
  for dev in /sys/bus/pci/devices/*; do
    [[ -r $dev/vendor && -r $dev/device ]] || continue
    vendor=$(< "$dev/vendor")
    device=$(< "$dev/device")
    [[ ${vendor#0x}:${device#0x} == "$id" ]] && return 1
  done
  compgen -G '/sys/class/drm/card[0-9]*/device' > /dev/null
}

if [[ ${1:-} != --menu ]]; then
  sudo setterm --blank 0 --powerdown 0 2> /dev/null
  # Pastas de ~/roms que faltarem (um core novo do RetroArch, por exemplo).
  # No modo jogo, so quando o menu abrir.
  game_mode || "$BIN/fliperos-roms" > /dev/null 2>&1
  if [[ -f $ETC/installed ]]; then
    # A troca de tela pelo cabo: o boot sempre sobe no modo do tubo de 15 kHz,
    # e com o monitor de 31 kHz no cabo o video dele entra aqui, antes de
    # qualquer tela.
    screen_sync
    # A BIOS da placa recem-gravada (Setup > Video Setup > Card firmware):
    # confirmar antes de tudo, tambem no modo jogo. Sem resposta, volta a
    # original e reinicia.
    if grep -q '^atom15_trial=' "$ETC/fliperos.conf" 2> /dev/null; then
      splash_off
      sudo /usr/local/bin/fliperos-setup --atom15-confirm
    fi
    # Driver de video recem-trocado (Setup > Video Setup > Video driver, ou a
    # instalacao): confirmar a imagem antes de tudo, tambem no modo jogo.
    # Sem resposta em 15 s ele volta ao driver anterior e reinicia.
    if grep -q '^amd_driver_trial=' "$ETC/fliperos.conf" 2> /dev/null; then
      splash_off
      sudo /usr/local/bin/fliperos-setup --driver-confirm
    fi
    # Placa de video trocada (o boot gravou um modo seguro) ou o teste pedido no
    # Video Setup: o teste de saidas antes de tudo, tambem no modo jogo (com o
    # video errado o jogo nao adianta). Sem nada a fazer, sai em silencio.
    # lowdot_ask: o grid do conversor de uma DisplayPort, perguntado uma vez.
    if grep -q -E '^(hw_changed|hw_retest|lowdot_ask)=' "$ETC/fliperos.conf" 2> /dev/null || hw_maybe_changed; then
      splash_off
      sudo /usr/local/bin/fliperos-setup --hw-check
    fi
    if [[ -f $ETC/firstboot ]]; then
      splash_off
      sudo /usr/local/bin/fliperos-setup --first-boot
    elif ! game_mode && update_pending; then
      splash_off
      sudo /usr/local/bin/fliperos-setup --update-check
    fi
    splash_off
    "$BIN/fliperos-session"
    # No modo jogo o update e perguntado depois do jogo, a caminho do menu:
    # a rede ja teve tempo de subir, e sem ela nao se espera mais.
    if game_mode; then
      "$BIN/fliperos-roms" > /dev/null 2>&1
      FLIPEROS_UPDATE_NET_WAIT=0 update_pending && sudo /usr/local/bin/fliperos-setup --update-check
    fi
  fi
fi
menu
