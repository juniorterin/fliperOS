@@ -34,6 +40,53 @@ typedef struct
    unsigned refresh_rate_x1000;
 } khr_display_ctx_data_t;
 
+#ifdef HAVE_KHR_CRT_MODE
+/* The CRT SwitchRes timing on the display. VK_KHR_display offers only
+ * the modes the kernel lists for the connector, and Mesa's
+ * vkCreateDisplayModeKHR makes none of its own, while the kernel takes
+ * any timing on the CRTC (the KMS context sets them that way). So the
+ * timing goes onto the connector's list where Mesa reads it: these two
+ * stand in for libdrm's (Makefile.common exports them), and Mesa then
+ * sets exactly this mode. */
+static drmModeModeInfo khr_crt_mode;
+static bool khr_crt_mode_valid;
+
+typedef drmModeConnectorPtr (*khr_get_connector_t)(int, uint32_t);
+
+static drmModeConnectorPtr khr_crt_add_mode(drmModeConnectorPtr conn)
+{
+   drmModeModeInfo *modes;
+
+   if (     !conn
+         || !khr_crt_mode_valid
+         || conn->connection != DRM_MODE_CONNECTED)
+      return conn;
+   /* libdrm frees the list with free() */
+   if (!(modes = (drmModeModeInfo*)realloc(conn->modes,
+               (conn->count_modes + 1) * sizeof(*modes))))
+      return conn;
+   modes[conn->count_modes++] = khr_crt_mode;
+   conn->modes                = modes;
+   return conn;
+}
+
+drmModeConnectorPtr drmModeGetConnector(int fd, uint32_t connector_id)
+{
+   static khr_get_connector_t real;
+   if (!real)
+      real = (khr_get_connector_t)dlsym(RTLD_NEXT, "drmModeGetConnector");
+   return real ? khr_crt_add_mode(real(fd, connector_id)) : NULL;
+}
+
+drmModeConnectorPtr drmModeGetConnectorCurrent(int fd, uint32_t connector_id)
+{
+   static khr_get_connector_t real;
+   if (!real)
+      real = (khr_get_connector_t)dlsym(RTLD_NEXT, "drmModeGetConnectorCurrent");
+   return real ? khr_crt_add_mode(real(fd, connector_id)) : NULL;
+}
+#endif
