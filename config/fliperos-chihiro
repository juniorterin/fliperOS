#!/usr/bin/env bash
# Sega Chihiro (OutRun 2, The House of the Dead III, Virtua Cop 3, Ghost Squad,
# Wangan Midnight...) pelo FliperOS, no xemu do Tovarichtch. Aberto por um
# frontend, via fliperos-x11-run (que poe o modo de video do CRT). Pelo menu do
# desktop, o fliperos-launch abre a biblioteca do emulador.
#
#   fliperos-chihiro [jogo] [opcoes do xemu]   (o nome do jogo, sem a extensao, ou o caminho dele)
#   fliperos-chihiro --prepare-needed JOGO     status 0 se o disco ainda precisa virar imagem
#   fliperos-chihiro --prepare JOGO [--progress]   so converte (o frontend, com a barra)
#
# O xemu vem no pacote opcional fliperos-xemu-chihiro (/usr/local/bin/xemu-chihiro),
# baixado quando o primeiro jogo da pasta chihiro e aberto (config/fliperos-emulators,
# tipo package). Este comando vem com o sistema, e e ele que liga o xemu as pastas
# do FliperOS:
#   ~/roms/chihiro   os jogos: o disco (.7z do TOSEC, .cue, .gdi, .chd) ou a imagem de
#                    netboot (.bin). O disco vira imagem na primeira abertura, em
#                    .netboot/ (config/fliperos-chihiro-prepare: pede a chave do jogo
#                    ao romset do MAME e usa a ferramenta Tovarichtch/chihiro-netboot)
#   ~/bios/chihiro   a BIOS da placa: chihiro_xbox_bios.bin e, ao lado, os
#                    ic10_g24lc64.bin, ic11_24lc024.bin, pc20_g24lc64.bin e
#                    fpr21042_m29w160et.bin; o ver1305.bin (firmware da placa de
#                    rede, do seganetw.zip do MAME) so os jogos em rede o pedem
#   ~/save/chihiro   os save states (o qcow2 do xemu)
#   ~/.local/share/xemu-chihiro   a configuracao (xemu.toml), o EEPROM da placa e
#                    os cartoes (ligada em ~/config/chihiro)
set -euo pipefail
bin=${FLIPEROS_CHIHIRO_BIN:-/usr/local/bin/xemu-chihiro}
roms=${FLIPEROS_CHIHIRO_DIR:-$HOME/roms/chihiro}
bios=${FLIPEROS_CHIHIRO_BIOS:-$HOME/bios/chihiro}
states=${FLIPEROS_CHIHIRO_STATES:-$HOME/save/chihiro}
data=${FLIPEROS_CHIHIRO_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/xemu-chihiro}
iniset=${FLIPEROS_INI_SET:-/opt/fliperos/bin/fliperos-ini-set}
prepare=${FLIPEROS_CHIHIRO_PREPARE:-/opt/fliperos/bin/fliperos-chihiro-prepare}
# O preparo do disco a parte, para o frontend: antes de abrir o jogo ele pergunta se
# falta converter e, se falta, mostra a barra (fliperos-chihiro-prepare).
case ${1:-} in
  --prepare-needed) exec "$prepare" needed "${2:-}" ;;
  --prepare) shift && exec "$prepare" run "$@" ;;
esac
if [[ ! -x $bin ]]; then
  echo "xemu for the Sega Chihiro is not installed. Install it in Setup > Games > Emulators & Games." >&2
  exit 1
fi

# O jogo: o nome do .bin, ou o caminho dele (a pasta dele passa a ser a dos
# jogos). O resto vai ao xemu como veio.
game="" args=()
for arg in "$@"; do
  case $arg in
    -*) args+=("$arg") ;;
    *) game=$arg ;;
  esac
done
if [[ -n $game && ! -e $game ]]; then
  # So o nome: procura na pasta dos jogos, com a extensao que faltar (a imagem
  # de netboot antes do disco).
  for ext in .bin .7z .cue .gdi .chd ""; do
    if [[ -f $roms/$game$ext ]]; then
      game=$roms/$game$ext
      break
    fi
  done
fi
if [[ -n $game && ! -f $game ]]; then
  echo "Sega Chihiro game not found: $game (the games go in $roms: the disc as .7z, .cue, .gdi or .chd, or a .bin netboot image)" >&2
  exit 1
fi
[[ -z $game ]] || roms=$(dirname -- "$game")

# A BIOS e os arquivos da placa: sem a BIOS o xemu so mostraria um aviso no
# tubo, num tamanho que ninguem le; entao o aviso sai aqui, e o Download BIOS
# (Setup > Games > Downloader) traz os arquivos.
if [[ ! -f $bios/chihiro_xbox_bios.bin ]]; then
  echo "The Sega Chihiro BIOS is missing: $bios/chihiro_xbox_bios.bin" >&2
  echo "Use Setup > Games > Downloader > Download BIOS, or put the files of MAME's chihiro.zip there (not the zip itself)." >&2
  exit 1
fi

# O que o xemu abre: a imagem de netboot (o .bin) ou, de um disco, a que o preparo fez
# em .netboot/. O frontend ja converteu, com a barra; aberto por outro caminho (o menu do
# desktop, outro frontend), converte aqui, sem barra (o andamento vai para o log).
image=""
if [[ -n $game ]]; then
  if ! image=$("$prepare" path "$game" 2> /dev/null); then
    "$prepare" run "$game" >&2 || exit 1
    image=$("$prepare" path "$game") || exit 1
  fi
fi

mkdir -p "$data" "$states" 2> /dev/null || true
cfg=$data/xemu.toml
# As pastas de dados sao as do FliperOS: o que o menu do xemu muda aqui volta a
# ser o que o sistema diz na proxima abertura. O valor de um texto no TOML vai
# entre aspas.
if [[ -x $iniset ]]; then
  "$iniset" "$cfg" general show_welcome false
  "$iniset" "$cfg" general games_dir "\"$roms\""
  "$iniset" "$cfg" sys default_machine '"chihiro"'
  "$iniset" "$cfg" chihiro.roms bios_path "\"$bios/chihiro_xbox_bios.bin\""
  "$iniset" "$cfg" chihiro.roms snapshot_store_path "\"$states/chihiro_snapshots.qcow2\""
  # O firmware da placa de rede (OutRun 2 SP, Gundam, Maximum Tune): so se esta
  # na pasta; sem ele o xemu usa o 3.17, que esses jogos recusam.
  if [[ -f $bios/ver1305.bin ]]; then
    "$iniset" "$cfg" chihiro.roms net_firmware_path "\"$bios/ver1305.bin\""
  fi
  # O modo pistola, sempre: com ele desligado o botao direito do mouse abre o menu do xemu, e a GunCon 2 manda
  # o A/C e o tiro fora da tela (o gun_offscreen_reload aperta o botao de recarga do driver) como botao
  # direito, entao um tiro fora da tela abria o menu no meio do jogo. Ligado, o xemu esconde o cursor e deixa
  # os botoes do mouse para o jogo. So conta nos jogos de pistola (Virtua Cop 3, House of the Dead 3, Ghost
  # Squad); nos outros o botao direito segue abrindo o menu.
  "$iniset" "$cfg" chihiro.settings lightgun_mode true
  # O padrao do CRT, uma vez so (quem mudar no menu do xemu fica com a escolha):
  # tela cheia, sem a barra de menu, imagem 4:3 (o jogo e 640x480), VSync
  # ligado (sem ele a imagem rasga) e sem a procura de versao nova na rede (o
  # Setup e que atualiza o pacote).
  if [[ ! -e $data/.fliperos-defaults ]]; then
    "$iniset" "$cfg" display.window fullscreen_on_startup true
    "$iniset" "$cfg" display.window vsync true
    "$iniset" "$cfg" display.ui show_menubar false
    "$iniset" "$cfg" display.ui aspect_ratio '"4x3"'
    "$iniset" "$cfg" display.ui fit '"scale"'
    "$iniset" "$cfg" general.updates check false
    : > "$data/.fliperos-defaults"
  fi
  # O renderizador pelo driver da placa do CRT, como no Odin (e no Keisho, no Flycast...): Vulkan no
  # amdgpu, OpenGL nos outros. Numa R7 240 (Oland) o OpenGL da radeonsi trava a GPU nos primeiros quadros
  # do jogo (o kernel diz "ring gfx timeout" e o Xorg cai, o xemu aborta em gl_fence); o Vulkan (RADV)
  # roda o Virtua Cop 3. Na primeira abertura e a cada troca de driver; entre elas a escolha do menu do
  # xemu fica.
  drm=${FLIPEROS_DRM_SYSFS:-/sys/class/drm} driver=""
  for status in "$drm"/card[0-9]*-*/status; do
    [[ $(cat "$status" 2> /dev/null) == connected ]] || continue
    card=${status%/status}
    card=${card##*/}
    driver=$(readlink -f "$drm/${card%%-*}/device/driver" 2> /dev/null) || driver=""
    driver=${driver##*/}
    break
  done
  driver=${driver:-none}
  if [[ $(cat "$data/.fliperos-api" 2> /dev/null) != "$driver" ]]; then
    if [[ $driver == amdgpu ]]; then api='"VULKAN"'; else api='"OPENGL"'; fi
    "$iniset" "$cfg" display renderer "$api"
    printf '%s\n' "$driver" > "$data/.fliperos-api"
  fi
fi

# Os controles: o xemu guarda cada funcao de um jogo como uma tecla (ou botao de mouse), por jogo, e nao
# le o mapa do Setup > Joysticks. O fliperos-chihiro-input grava no xemu.toml a tecla de cada funcao
# (moeda, start, pedal, recarregar, acelerador, freio, marchas...) e cria o .key (botao do painel ->
# tecla); o fliperos-buttons gamekeys le o painel do mapa do Setup e aperta essas teclas por um
# teclado virtual enquanto o xemu roda (--parent: sai com ele, que e este mesmo processo depois do exec).
# O .key e da pessoa depois de criado. FLIPEROS_CHIHIRO_KEYS=off desliga o teclado virtual.
inputs=${FLIPEROS_CHIHIRO_INPUT:-/opt/fliperos/bin/fliperos-chihiro-input}
buttons=${FLIPEROS_BUTTONS:-/opt/fliperos/bin/fliperos-buttons}
keyfile=$data/chihiro.key
if [[ -x $inputs ]]; then
  "$inputs" apply "$cfg" "$keyfile" || true
  if [[ -x $buttons && ${FLIPEROS_CHIHIRO_KEYS:-on} != off && -f $keyfile ]]; then
    "$buttons" gamekeys "$keyfile" --parent $$ > /dev/null 2>&1 &
  fi
fi

opts=(-config_path "$cfg" -full-screen)
[[ -z $image ]] || opts+=(-dvd_path "$image")
exec "$bin" "${opts[@]}" "${args[@]}"
