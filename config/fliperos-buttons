def keyboard_map(players):
    """As linhas do mapa de um encoder que se diz teclado, no layout do MAME
    (o "controle" KEYBOARD_INDEX). Os comandos sem tecla padrao no MAME (o
    botao 6 do jogador 2, os botoes 4 a 6 dos jogadores 3 e 4) ficam de fora."""
    lines = []
    for player in range(1, players + 1):
        for control in CONTROLS:
            key = MAME_KEYS.get(player, {}).get(control)
            if key:
                lines.append('%d %s %d k:%s Keyboard' % (player, control, KEYBOARD_INDEX, key))
    return lines


def cmd_keyboard(args):
    keep = os.environ.get('FLIPEROS_BUTTONS_MAP', '/etc/fliperos/buttons.map')
    write(keep, ''.join(line + '\n' for line in keyboard_map(args.players)))
    args.map = keep
    return cmd_save(args)


# ── SDL: o proximo comando ──────────────────────────────────────

# Sem isto o SDL_Init troca o SIGTERM e o SIGINT por um SDL_QUIT que ninguem
# le: o watch do painel web nao saia no SIGTERM, e o desligar esperava os 90 s
# do systemd ate o SIGKILL. Vale para todo SDL_Init deste programa.
os.environ['SDL_NO_SIGNAL_HANDLERS'] = '1'


def sdl():
    lib = ctypes.CDLL(ctypes.util.find_library('SDL2') or 'libSDL2-2.0.so.0')
    lib.SDL_JoystickOpen.restype = ctypes.c_void_p
    lib.SDL_JoystickName.restype = ctypes.c_char_p
    for f in ('SDL_JoystickNumButtons', 'SDL_JoystickNumAxes', 'SDL_JoystickNumHats', 'SDL_JoystickName'):
        getattr(lib, f).argtypes = [ctypes.c_void_p]
    lib.SDL_JoystickGetButton.argtypes = [ctypes.c_void_p, ctypes.c_int]
    lib.SDL_JoystickGetAxis.argtypes = [ctypes.c_void_p, ctypes.c_int]
    lib.SDL_JoystickGetAxis.restype = ctypes.c_int16
    lib.SDL_JoystickGetHat.argtypes = [ctypes.c_void_p, ctypes.c_int]
    lib.SDL_JoystickGetHat.restype = ctypes.c_uint8
    return lib


def state(lib, js):
    return ([lib.SDL_JoystickGetButton(js, i) for i in range(lib.SDL_JoystickNumButtons(js))],
            [lib.SDL_JoystickGetAxis(js, i) for i in range(lib.SDL_JoystickNumAxes(js))],
            [lib.SDL_JoystickGetHat(js, i) for i in range(lib.SDL_JoystickNumHats(js))])


def pressed(rest, now):
    """O primeiro elemento apertado em relacao ao repouso, ou None."""
    for i, (r, n) in enumerate(zip(rest[0], now[0])):
        if n and not r:
            return 'b%d' % i
    for i, (r, n) in enumerate(zip(rest[1], now[1])):
        if n - r > AXIS_PRESS:
            return '+a%d' % i
        if r - n > AXIS_PRESS and not released_trigger(r, n):
            return '-a%d' % i
    for i, (r, n) in enumerate(zip(rest[2], now[2])):
        if n and n != r:
            for bit in (1, 2, 4, 8):
                if n & bit:
                    return 'h%d.%d' % (i, bit)
    return None


def released_trigger(rest, now):
    """Um gatilho que estava apertado quando a captura comecou e foi solto
    agora (de cima para -32768, onde ele repousa): nao e um comando."""
    return rest > AXIS_PRESS and now <= -TRIGGER_REST


def settle(rest, now):
    """O repouso depois que o que estava apertado no comeco foi solto: o botao
    solto, o eixo que voltou ao centro (um gatilho em -32768 nao volta e
    continua repouso), o gatilho solto e o hat solto passam a valer de novo."""
    buttons = [min(r, n) for r, n in zip(rest[0], now[0])]
    axes = [n if (abs(r) > AXIS_PRESS and abs(n) < 8000) or released_trigger(r, n) else r
            for r, n in zip(rest[1], now[1])]
    hats = [0 if r and not n else r for r, n in zip(rest[2], now[2])]
    return buttons, axes, hats


def cmd_capture(args):
    for var in ('SDL_GAMECONTROLLERCONFIG', 'SDL_GAMECONTROLLERCONFIG_FILE'):
        os.environ.pop(var, None)
    lib = sdl()
    if lib.SDL_Init(0x200) != 0:  # JOYSTICK
        sys.exit('SDL: no joystick')
    try:
        sticks = [lib.SDL_JoystickOpen(i) for i in range(lib.SDL_NumJoysticks())]
        lib.SDL_JoystickUpdate()
        time.sleep(0.05)
        lib.SDL_JoystickUpdate()
        # O repouso de cada controle: o que estiver apertado agora (o comando
        # anterior ainda segurado, um gatilho em -32768) nao conta.
        rest = [state(lib, js) if js else None for js in sticks]
        deadline = time.monotonic() + args.timeout
        while time.monotonic() < deadline:
            lib.SDL_JoystickUpdate()
            for index, js in enumerate(sticks):
                if not js:
                    continue
                now = state(lib, js)
                element = pressed(rest[index], now)
                if element:
                    name = (lib.SDL_JoystickName(js) or b'').decode(errors='replace')
                    print('%d %s %s' % (index, element, name))
                    return 0
                rest[index] = settle(rest[index], now)
            time.sleep(0.005)
        return 1
    finally:
        lib.SDL_Quit()


# ── watch: os comandos apertados agora ──────────────────────────
# As teclas do MAME no evdev (linux/input-event-codes.h).
EVDEV_KEYS = {'UP': 103, 'DOWN': 108, 'LEFT': 105, 'RIGHT': 106, 'LCONTROL': 29, 'LALT': 56, 'LSHIFT': 42,
              'SPACE': 57, 'RCONTROL': 97, 'RSHIFT': 54, 'ENTER': 28, '8_PAD': 72, '2_PAD': 80, '4_PAD': 75,
              '6_PAD': 77, '0_PAD': 82, 'DEL_PAD': 83, 'ENTER_PAD': 96}
EVDEV_KEYS.update(zip('QWERTYUIOP', range(16, 26)))
EVDEV_KEYS.update(zip('ASDFGHJKL', range(30, 39)))
EVDEV_KEYS.update(zip('ZXCVBNM', range(44, 51)))
EVDEV_KEYS.update({str(n): n + 1 for n in range(1, 10)})
INPUT_EVENT = struct.Struct('llHHi')
EV_KEY = 1
WATCH_HZ = 60


def held(element, now):
    """O elemento do SDL (b3, +a1, h0.4) esta apertado no estado now?"""
    buttons, axes, hats = now
    if element.startswith('b'):
        i = int(element[1:])
        return i < len(buttons) and bool(buttons[i])
    if element.startswith('h'):
        hat, bit = element[1:].split('.')
        return int(hat) < len(hats) and bool(hats[int(hat)] & int(bit))
    i = int(element[2:])
    if i >= len(axes):
        return False
    return axes[i] > AXIS_PRESS if element[0] == '+' else axes[i] < -AXIS_PRESS


class Keyboards:
    """As teclas apertadas em todos os /dev/input/event*, lidas junto com o
    jogo (sem EVIOCGRAB); os aparelhos ligados depois entram a cada 2 s."""

    def __init__(self, pattern=None):
        self.pattern = pattern or os.environ.get('FLIPEROS_INPUT_EVENTS', '/dev/input/event*')
        self.devices = {}
        self.scanned = None

    def scan(self):
        if self.scanned is not None and time.monotonic() - self.scanned < 2:
            return
        self.scanned = time.monotonic()
        known = {path for path, _ in self.devices.values()}
        for path in glob.glob(self.pattern):
            if path in known:
                continue
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                continue
            self.devices[fd] = (path, set())

    def read(self, timeout):
        self.scan()
        try:
            ready = select.select(list(self.devices), [], [], timeout)[0]
        except (OSError, ValueError):
            ready = list(self.devices)
        for fd in ready:
            try:
                data = os.read(fd, INPUT_EVENT.size * 64)
            except BlockingIOError:
                continue
            except OSError:
                data = b''
            if not data:
                # O aparelho saiu: as teclas dele soltam.
                os.close(fd)
                del self.devices[fd]
                continue
            keys = self.devices[fd][1]
            for i in range(0, len(data) - INPUT_EVENT.size + 1, INPUT_EVENT.size):
                _, _, kind, code, value = INPUT_EVENT.unpack_from(data, i)
                if kind == EV_KEY:
                    (keys.add if value else keys.discard)(code)

    def down(self):
        return set().union(*(keys for _, keys in self.devices.values()))


def watch_state(players, sticks, keys):
    """{"jogador": [os controles apertados, na ordem de CONTROLS]}; sticks e
    {indice: estado do SDL}, keys os codigos do evdev apertados."""
    out = {}
    for player in sorted(players):
        on = []
        for control in CONTROLS:
            if control not in players[player]:
                continue
            index, element = players[player][control]
            if is_key(element):
                if EVDEV_KEYS.get(element[2:]) in keys:
                    on.append(control)
            elif sticks.get(index) is not None and held(element, sticks[index]):
                on.append(control)
        out[str(player)] = on
    return out


def watch_players(path):
    """Os binds do mapa; sem ele, as teclas padrao do MAME dos jogadores 1 e 2."""
    players = read_map(path)[0] if path and os.path.exists(path) else {}
    if not players:
        for line in keyboard_map(2):
            player, control, index, element = line.split()[:4]
            players.setdefault(int(player), {})[control] = (int(index), element)
    return players


class Sticks:
    """Os controles pelo SDL (so o joystick, sem tela), lidos junto com o
    jogo: read() da {indice: estado} de cada um. Um controle ligado ou tirado
    muda os indices do SDL: abre todos de novo."""

    def __init__(self):
        for var in ('SDL_GAMECONTROLLERCONFIG', 'SDL_GAMECONTROLLERCONFIG_FILE'):
            os.environ.pop(var, None)
        self.lib = None
        try:
            lib = sdl()
            lib.SDL_JoystickClose.argtypes = [ctypes.c_void_p]
            if lib.SDL_Init(0x200) == 0:  # JOYSTICK
                self.lib = lib
        except OSError:
            pass
        self.sticks, self.count = {}, -1

    def read(self):
        lib = self.lib
        if not lib:
            return {}
        lib.SDL_JoystickUpdate()
        if lib.SDL_NumJoysticks() != self.count:
            for js in self.sticks.values():
                if js:
                    lib.SDL_JoystickClose(js)
            self.count = lib.SDL_NumJoysticks()
            self.sticks = {i: lib.SDL_JoystickOpen(i) for i in range(self.count)}
            lib.SDL_JoystickUpdate()
        return {i: state(lib, js) for i, js in self.sticks.items() if js}

    def close(self):
        if self.lib:
            self.lib.SDL_Quit()


def cmd_watch(args):
    # Roda junto com o jogo: abaixo dele na fila da CPU.
    try:
        os.nice(10)
    except OSError:
        pass
    players = watch_players(args.map)
    elements = [e for binds in players.values() for _, e in binds.values()]
    keyboards = Keyboards() if any(is_key(e) for e in elements) else None
    sticks = None if all(is_key(e) for e in elements) else Sticks()
    last = None
    try:
        while True:
            states = sticks.read() if sticks else {}
            if keyboards:
                keyboards.read(1 / WATCH_HZ)
            else:
                time.sleep(1 / WATCH_HZ)
            now = watch_state(players, states, keyboards.down() if keyboards else set())
            if now != last:
                print(json.dumps(now), flush=True)
                last = now
    except (BrokenPipeError, KeyboardInterrupt):
        return 0
    finally:
        if sticks:
            sticks.close()


def cmd_hotkey(args):
    """Junto com o jogo que o frontend do FliperOS abriu: o atalho que fecha o
    jogo imprime "exit" e sai. O atalho e uma tecla (--key, o codigo do evdev)
    ou os comandos do painel segurados juntos por --hold segundos (--combo
    start+b2, os do Button mapping, de um mesmo jogador). Com --coin, cada
    ficha imprime "coin" (o modo comercial soma o tempo). Nada e tomado do
    jogo: ele le os mesmos controles."""
    try:
        os.nice(10)
    except OSError:
        pass
    combo = set(c for c in (args.combo or '').split('+') if c in CONTROLS)
    players = watch_players(args.map)
    wanted = combo | ({'coin'} if args.coin else set())
    elements = [e for binds in players.values() for c, (_, e) in binds.items() if c in wanted]
    keyboards = Keyboards() if args.key or any(is_key(e) for e in elements) else None
    sticks = Sticks() if any(not is_key(e) for e in elements) else None
    since, coin, key_was = None, None, None
    try:
        while True:
            states = sticks.read() if sticks else {}
            if keyboards:
                keyboards.read(1 / WATCH_HZ)
            else:
                time.sleep(1 / WATCH_HZ)
            keys = keyboards.down() if keyboards else set()
            # A tecla vale ao ser apertada (segura desde a abertura, nao).
            key = args.key in keys
            if key and key_was is False:
                print('exit', flush=True)
                return 0
            key_was = key
            now = watch_state(players, states, keys)
            if combo and any(combo <= set(on) for on in now.values()):
                since = since or time.monotonic()
                if time.monotonic() - since >= args.hold:
                    print('exit', flush=True)
                    return 0
            else:
                since = None
            down = any('coin' in on for on in now.values())
            if args.coin and down and coin is False:
                print('coin', flush=True)
            coin = down
    except (BrokenPipeError, KeyboardInterrupt):
        return 0
    finally:
        if sticks:
            sticks.close()


def main():
    parser = argparse.ArgumentParser(prog='fliperos-buttons')
    sub = parser.add_subparsers(dest='command', required=True)
    p = sub.add_parser('capture')
    p.add_argument('--timeout', type=float, default=8)
    p.set_defaults(func=cmd_capture)
    p = sub.add_parser('save')
    p.add_argument('map')
    p.set_defaults(func=cmd_save)
    p = sub.add_parser('keyboard')
    p.add_argument('--players', type=int, choices=range(1, 5), default=2)
    p.set_defaults(func=cmd_keyboard)
    p = sub.add_parser('attract')
    p.add_argument('map')
    p.set_defaults(func=cmd_attract)
    p = sub.add_parser('watch')
    p.add_argument('map', nargs='?', default=os.environ.get('FLIPEROS_BUTTONS_MAP', '/etc/fliperos/buttons.map'))
    p.set_defaults(func=cmd_watch)
    p = sub.add_parser('hotkey')
    p.add_argument('--key', type=int, default=0)
    p.add_argument('--combo', default='')
    p.add_argument('--hold', type=float, default=1.0)
    p.add_argument('--coin', action='store_true')
    p.add_argument('map', nargs='?', default=os.environ.get('FLIPEROS_BUTTONS_MAP', '/etc/fliperos/buttons.map'))
    p.set_defaults(func=cmd_hotkey)
    p = sub.add_parser('fbneo')
    p.add_argument('map')
    p.add_argument('version')
    p.set_defaults(func=cmd_fbneo)
    args = parser.parse_args()
    sys.exit(args.func(args) or 0)


if __name__ == '__main__':
    main()
