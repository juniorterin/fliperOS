def is_key(element):
    """O elemento e uma tecla (k:TECLA, nome do MAME), nao um do SDL?"""
    return element.startswith('k:')


INPUT_DEVICES = os.environ.get('FLIPEROS_INPUT_DEVICES', '/proc/bus/input/devices')


def connected_joysticks(path=None):
    """Quantos joysticks estao ligados agora: os aparelhos do /proc/bus/input/devices
    que tem um js (o SDL conta os controles na mesma ordem em que aparecem). Os que
    tambem sao mouse (a pistola de luz, como a GunCon 2) ficam de fora: o SDL nao
    os conta como controle, e eles nao sao um jogador."""
    count = 0
    try:
        with open(path or INPUT_DEVICES, encoding='utf-8', errors='replace') as f:
            for line in f:
                if (line.startswith('H: Handlers=') and re.search(r'\bjs\d+\b', line)
                        and not re.search(r'\bmouse\d+\b', line)):
                    count += 1
    except OSError:
        return 0
    return count


def active_players(players, connected):
    """{jogador: ligado?}. Um jogador de teclado (encoder que se diz teclado) esta
    sempre ligado; o de controle, se o aparelho dele existe (o indice do SDL que o
    mapa guardou e menor que os joysticks ligados)."""
    out = {}
    for player, binds in players.items():
        indexes = [index for index, _ in binds.values()]
        out[player] = all(i < 0 for i in indexes) or all(i < connected for i in indexes if i >= 0)
    return out


def mame_code(index, element):
    """O codigo do MAME (joystickprovider sdljoy) de um elemento do SDL."""
    if is_key(element):
        return 'KEYCODE_' + element[2:]
    joy = 'JOYCODE_%d_' % (index + 1)
    if element.startswith('b'):
        return joy + 'BUTTON%d' % (int(element[1:]) + 1)
    if element.startswith('h'):
        hat, direction = element[1:].split('.')
        return joy + 'HAT%d%s' % (int(hat) + 1, MAME_HAT[direction])
    sign, axis = element[0], int(element[2:])
    name = MAME_AXES[axis] if axis < len(MAME_AXES) else MAME_AXES[-1]
    if name == 'XAXIS':
        side = 'LEFT' if sign == '-' else 'RIGHT'
    elif name == 'YAXIS':
        side = 'UP' if sign == '-' else 'DOWN'
    else:
        side = 'NEG' if sign == '-' else 'POS'
    return joy + '%s_%s_SWITCH' % (name, side)


# O lado que o bind nao usa (o botao de um bind por eixo, o eixo de um bind
# por botao). "nul" nao serve: para o RetroArch e "sem bind do usuario", e
# ele usa o do perfil automatico do controle. No Xbox 360 o B (botao 2 de um
# painel assim) e o A do RetroPad, e o botao 2 apertava junto o 5 no MAME
# 2010. Um indice que nao existe nunca e apertado.
# Nas direcoes o "nul" fica: o perfil ali so traz a mesma direcao.
# O hat vai nos dois lados: "h0up" no botao (driver udev) e o eixo do
# /dev/input/js no eixo (driver linuxraw, o do FliperOS: ali o hat chega como
# eixo e o "h0up" nunca e apertado). So com o perfil o direcional de hat
# andava, e um controle sem perfil linuxraw (o 8BitDo Ultimate, por exemplo)
# ficava sem direcional.
RA_NONE_BTN, RA_NONE_AXIS = '99', '+99'
DIRECTIONS = ('up', 'down', 'left', 'right')
JS_HAT = {'1': ('-', 1), '4': ('+', 1), '8': ('-', 0), '2': ('+', 0)}


def js_axes(codes):
    """({eixo do SDL: eixo do /dev/input/js}, {hat: (eixo x, eixo y)}) pelos
    codigos ABS do controle: o joydev (o linuxraw do RetroArch) numera todos
    os eixos em ordem, hats junto; o SDL pula os hats. None sem os codigos."""
    if codes is None:
        return None
    axes, hats, sdl_index = {}, {}, 0
    for js_index, code in enumerate(codes):
        if 0x10 <= code <= 0x17:
            hats.setdefault((code - 0x10) // 2, [None, None])[(code - 0x10) % 2] = js_index
        else:
            axes[sdl_index] = js_index
            sdl_index += 1
    return axes, {h: tuple(v) for h, v in hats.items() if None not in v}


def retroarch_lines(player, control, element, js=None):
    """Os binds do RetroArch de um controle de um jogador: o botao e o hat na
    numeracao do SDL (a do udev); o eixo na do /dev/input/js com `js`
    (js_axes do aparelho), que so difere da do SDL quando ha hat antes dele.
    O analogico do joypad (lsup, lsleft...) da os dois sentidos do eixo; o
    hotkey nao tem bind no RetroArch."""
    if control in STICKS:
        return retroarch_stick(player, control, element, js)
    if control not in RA_KEYS:
        return []
    key = 'input_player%d_%s' % (player, RA_KEYS[control])
    if control in DIRECTIONS:
        none_btn = none_axis = 'nul'
    else:
        none_btn, none_axis = RA_NONE_BTN, RA_NONE_AXIS
    if is_key(element):
        return ['%s = "%s"' % (key, KEYS[element[2:]][0]), '%s_btn = "%s"' % (key, none_btn),
                '%s_axis = "%s"' % (key, none_axis)]
    if element.startswith('b'):
        return ['%s_btn = "%s"' % (key, element[1:]), '%s_axis = "%s"' % (key, none_axis)]
    if element.startswith('h'):
        hat, direction = element[1:].split('.')
        axis = none_axis
        if js and int(hat) in js[1] and direction in JS_HAT:
            sign, xy = JS_HAT[direction]
            axis = sign + str(js[1][int(hat)][xy])
        return ['%s_btn = "h%s%s"' % (key, hat, RA_HAT[direction]), '%s_axis = "%s"' % (key, axis)]
    index = int(element[2:])
    if js:
        index = js[0].get(index, index)
    return ['%s_axis = "%s%d"' % (key, element[0], index), '%s_btn = "%s"' % (key, none_btn)]


def stick_axis(element):
    """(eixo, invertido?) de um analogico pego no sentido de cima ou da
    esquerda: "-a1" e o eixo 1 como o SDL o ve, "+a1" o mesmo ao contrario.
    None se o que foi apertado nao e eixo."""
    m = re.fullmatch(r'([+-])a(\d+)', element)
    return (int(m.group(2)), m.group(1) == '+') if m else None


def retroarch_stick(player, control, element, js=None):
    """O analogico no RetroArch: input_playerN_l_x_minus_axis e o plus."""
    axis = stick_axis(element)
    if axis is None:
        return []
    index, inverted = axis
    if js:
        index = js[0].get(index, index)
    side, xy = STICKS[control]
    minus, plus = ('+', '-') if inverted else ('-', '+')
    key = 'input_player%d_%s_%s' % (player, side, xy)
    return ['%s_minus_axis = "%s%d"' % (key, minus, index), '%s_plus_axis = "%s%d"' % (key, plus, index)]


def keep_hat_axes(lines, old):
    """Com o controle desligado no save (a atualizacao do sistema grava o mapa
    de novo), o eixo do hat que o save anterior achou fica: o mesmo "hNdir"
    no botao e o eixo "nul" agora."""
    out = []
    for line in lines:
        m = re.fullmatch(r'(input_player\d+_\w+)_axis = "nul"', line)
        btn = old.get(m.group(1) + '_btn', '') if m else ''
        axis = old.get(m.group(1) + '_axis', 'nul') if m else 'nul'
        if m and btn.startswith('h') and '%s_btn = "%s"' % (m.group(1), btn) in lines and axis != 'nul':
            line = '%s_axis = "%s"' % (m.group(1), axis)
        out.append(line)
    return out


def read_cfg(path):
    """{chave: valor} de uma config do RetroArch; vazio sem o arquivo."""
    try:
        with open(path, encoding='utf-8') as f:
            return dict(re.findall(r'^(\w+) = "([^"\n]*)"', f.read(), re.M))
    except OSError:
        return {}


def retroarch_triggers(player, binds):
    """Os botoes nos gatilhos (um eixo que so vai para um lado, como o LT e o
    RT do Xbox 360): o perfil automatico os poe tambem no L2 e no R2, e cada
    um apertaria dois botoes do RetroPad. L2 e R2 ficam sem nada, menos os
    que o mapa da a um comando (o botao 7 e o 8, os gatilhos de um joypad)."""
    if not any(e[0] in '+-' and control.startswith('b') for control, (_, e) in binds.items()):
        return []
    mapped = {RA_KEYS[c] for c in binds if c in RA_KEYS}
    return ['input_player%d_%s_%s = "%s"' % (player, pad, kind, RA_NONE_BTN if kind == 'btn' else RA_NONE_AXIS)
            for pad in ('l2', 'r2') if pad not in mapped for kind in ('btn', 'axis')]


def read_map(path):
    """{jogador: {controle: (indice, elemento)}} e {indice: nome}."""
    players, names = {}, {}
    with open(path, encoding='utf-8') as f:
        for line in f:
            parts = line.split(None, 4)
            if len(parts) < 4 or parts[1] not in ALL_CONTROLS:
                continue
            player, control, index, element = int(parts[0]), parts[1], int(parts[2]), parts[3]
            players.setdefault(player, {})[control] = (index, element)
            names[index] = parts[4].strip() if len(parts) > 4 else ''
    return players, names


def read_kinds(path):
    """{jogador: "arcade" ou "pad"} das linhas "JOGADOR kind INDICE TIPO NOME";
    o jogador sem linha e arcade (o mapa de antes do joypad)."""
    kinds = {}
    try:
        with open(path, encoding='utf-8') as f:
            for line in f:
                parts = line.split(None, 4)
                if len(parts) >= 4 and parts[1] == 'kind' and parts[0].isdigit() and parts[3] in KINDS:
                    kinds[int(parts[0])] = parts[3]
    except OSError:
        pass
    return kinds


def player_kind(kinds, player):
    return kinds.get(player, 'arcade')


def map_text(players, names, kinds=None, autos=None, ports=None):
    """O mapa de volta no formato do arquivo; autos ({jogador: GUID}) sao os
    controles Bluetooth postos pela ordem de conexao, ports ({jogador:
    porta}) a porta de cada com fio."""
    lines = []
    for player in sorted(players):
        binds = players[player]
        index = next(iter(binds.values()))[0]
        if autos and player in autos:
            lines.append('%d bt %d %s %s\n' % (player, index, autos[player], names.get(index, '')))
        elif ports and player in ports:
            lines.append('%d usb %d %s %s\n' % (player, index, ports[player], names.get(index, '')))
        if kinds and player in kinds:
            lines.append('%d kind %d %s %s\n' % (player, index, kinds[player], names.get(index, '')))
        for control in ALL_CONTROLS:
            if control in binds:
                index, element = binds[control]
                lines.append('%d %s %d %s %s\n' % (player, control, index, element, names.get(index, '')))
    return ''.join(lines)


def fix_triggers(players, devices):
    """O sentido de cada meio eixo pelo repouso do controle agora: num eixo
    que repousa em -32768 (gatilho) so existe "+". Um "-a5" ali vinha de uma
    captura que comecou com o gatilho apertado e pegou a soltura, e o botao
    ficava apertado no repouso em todo emulador. Devolve quantos mudaram."""
    fixed = 0
    for binds in players.values():
        for control, (index, element) in list(binds.items()):
            if element[0] not in '+-' or index not in devices:
                continue
            rests, axis = devices[index][4], int(element[2:])
            rest = rests[axis] if axis < len(rests) else 0
            sign = '+' if rest <= -TRIGGER_REST else '-' if rest >= TRIGGER_REST else element[0]
            if sign != element[0]:
                binds[control] = (index, sign + element[1:])
                fixed += 1
    return fixed


def device_js(devices, index):
    """O js_axes do controle INDICE, se ligado (sdl_devices)."""
    return js_axes(devices[index][6]) if devices and index in devices else None


def retroarch_cfg(players, names, devices=None, old=None):
    """O buttons.cfg; `devices` (sdl_devices) da os eixos do /dev/input/js,
    `old` (read_cfg do anterior) o eixo do hat de quem esta desligado."""
    lines = ['# Gerado pelo Setup > Joysticks > Button mapping (fliperos-buttons): os botoes',
             '# de cada jogador, por cima do perfil automatico do controle. O fliperos-kms-run',
             '# soma este arquivo a config (--appendconfig).']
    for player in sorted(players):
        binds = players[player]
        index = next(iter(binds.values()))[0]
        lines += ['', '# Jogador %d: %s' % (player, names.get(index, ''))]
        if index >= 0:
            lines.append('input_player%d_joypad_index = "%d"' % (player, index))
        js = device_js(devices, index)
        mine = []
        for control in ALL_CONTROLS:
            if control in binds:
                mine += retroarch_lines(player, control, binds[control][1], js)
        lines += mine if js or not old else keep_hat_axes(mine, old)
        lines += retroarch_triggers(player, binds)
    # As teclas de atalho do RetroArch que caem nas teclas do mapa.
    used = {KEYS[e[2:]][0] for binds in players.values() for _, e in binds.values() if is_key(e)}
    hotkeys = sorted(RA_HOTKEYS[k] for k in used if k in RA_HOTKEYS)
    if hotkeys:
        lines += ['', '# Atalhos do RetroArch nas teclas do painel: desligados.']
        lines += ['%s = "nul"' % h for h in hotkeys]
    return '\n'.join(lines) + '\n'


def read_layouts(path):
    """{botoes: [posicao no painel do botao 1, do 2...]} do buttons.layout,
    sem as linhas invalidas e sem as que deixam cada botao na sua posicao."""
    layouts = {}
    try:
        with open(path, encoding='utf-8') as f:
            rows = [line.split() for line in f]
    except OSError:
        return layouts
    for row in rows:
        if not row or not all(v.isdigit() for v in row):
            continue
        count, order = int(row[0]), [int(v) for v in row[1:]]
        if (count in LAYOUT_COUNTS and len(order) == count and len(set(order)) == count
                and all(1 <= v <= PANEL_BUTTONS for v in order) and order != list(range(1, count + 1))):
            layouts[count] = order
    return layouts


def layout_order(layouts, count):
    """A posicao no painel de cada um dos 6 botoes de um jogo de `count`
    botoes: os do layout, e os que o jogo nao tem nas posicoes que sobram."""
    order = list(layouts.get(count, []))
    return order + [p for p in range(1, PANEL_BUTTONS + 1) if p not in order]


def read_games(path):
    """{set: (botoes, pai)} da tabela do fliperos-romclean buttons."""
    games = {}
    try:
        with open(path, encoding='utf-8') as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 2 and parts[1].isdigit():
                    games[parts[0]] = (int(parts[1]), parts[2] if len(parts) > 2 else '')
    except OSError:
        pass
    return games


def layout_games(layouts, games):
    """[(set, [posicao do botao 1, do 2...])] dos jogos que saem do padrao,
    os pais antes dos clones. O MAME aplica ao clone o <system> do pai: o
    clone so entra se o dele for outro (outro numero de botoes)."""
    def wanted(count, upto):
        return layout_order(layouts, count)[:upto]

    parents, clones = [], []
    for name in sorted(games):
        count, parent = games[name]
        if parent in games:
            upto = min(max(count, games[parent][0]), PANEL_BUTTONS)
            # O <system> do pai so tem os botoes do pai: os outros ficam no padrao.
            inherited = layouts.get(games[parent][0], [])
            inherited = inherited + list(range(len(inherited) + 1, upto + 1))
            if wanted(count, upto) != inherited:
                clones.append((name, wanted(count, upto)))
        elif count in layouts:
            parents.append((name, wanted(count, count)))
    return parents + clones


def mame_port(player, control, bind):
    seq = mame_code(*bind)
    key = MAME_KEYS.get(player, {}).get(control)
    # A tecla padrao junto so com controle. Com o teclado ela e a de outro
    # comando quando o Buttons layout troca os botoes de lugar (o botao 1
    # do jogo no X: o Ctrl esquerdo apertaria dois).
    if key and not is_key(bind[1]):
        seq += ' OR KEYCODE_%s' % key
    # O gatilho e o botao de recarregar da pistola do jogador (lightgun do
    # MAME), como no padrao do MAME (inpttype.ipp): sem eles o gatilho so
    # funcionava quando a GunCon caia na lista como o controle daquele jogador
    # (um JOYCODE), e um reboot que trocava a ordem o deixava sem nada. No
    # botao 2 tambem o botao 3 da pistola: no SDL o direito e o 3 (o 2 e o do
    # meio), e e o direito que o driver da GunCon aperta no A, no C e no tiro
    # fora da tela, a recarga dos jogos que a tem no botao 2 (Zombie Raid).
    if control == 'b1' and player in MAME_KEYS:
        seq += ' OR GUNCODE_%d_BUTTON1' % player
    elif control == 'b2' and player in MAME_KEYS:
        seq += ' OR GUNCODE_%d_BUTTON2 OR GUNCODE_%d_BUTTON3' % (player, player)
    return ('            <port type="%s">\n                <newseq type="standard">%s</newseq>\n'
            '            </port>\n' % (MAME_PORTS[control] % player, seq))


def mame_cfg(players, names, layouts=None, games=None):
    ports = []
    for player in sorted(players):
        for control in CONTROLS:
            if control in players[player]:
                ports.append(mame_port(player, control, players[player][control]))
    systems = []
    # Buttons layout: o botao N do jogo na posicao do painel escolhida.
    for name, order in layout_games(layouts or {}, games or {}):
        entry = []
        for player in sorted(players):
            for n, position in enumerate(order, 1):
                if 'b%d' % position in players[player]:
                    entry.append(mame_port(player, 'b%d' % n, players[player]['b%d' % position]))
                else:
                    # A posicao que o jogador nao tem (um painel de menos
                    # botoes, o 6 do teclado do jogador 2): o botao fica sem
                    # nada. Sem a linha valeria o padrao, que pode ser o
                    # comando posto noutro botao deste jogo.
                    entry.append('            <port type="%s">\n                <newseq type="standard">NONE'
                                 '</newseq>\n            </port>\n' % (MAME_PORTS['b%d' % n] % player))
        if entry:
            systems.append('    <system name="%s">\n        <input>\n%s        </input>\n    </system>\n'
                           % (escape(name), ''.join(entry)))
    devices = ''.join('<!-- JOYCODE_%d: %s -->\n' % (i + 1, escape(n)) for i, n in sorted(names.items()))
    return ('<?xml version="1.0"?>\n<!-- Gerado pelo Setup > Joysticks > Button mapping (fliperos-buttons). -->\n'
            + devices + '<mameconfig version="10">\n    <system name="default">\n        <input>\n'
            + ''.join(ports) + '        </input>\n    </system>\n' + ''.join(systems) + '</mameconfig>\n')


def retroarch_layout_cfg(players, count, order, devices=None):
    """O buttons-BOTOES.cfg: os binds dos 6 botoes de cada jogador com o
    botao N do jogo na posicao do painel escolhida, por cima do buttons.cfg."""
    lines = ['# Gerado pelo Setup > Joysticks > Buttons layout (fliperos-buttons): os jogos de',
             '# %d botoes nos cores MAME. O fliperos-kms-run soma este arquivo depois do' % count,
             '# buttons.cfg.']
    for player in sorted(players):
        binds = players[player]
        lines.append('')
        for n, position in enumerate(order, 1):
            if 'b%d' % position in binds:
                index, element = binds['b%d' % position]
                lines += retroarch_lines(player, 'b%d' % n, element, device_js(devices, index))
            else:
                key = 'input_player%d_%s' % (player, RA_KEYS['b%d' % n])
                lines += ['%s_btn = "%s"' % (key, RA_NONE_BTN), '%s_axis = "%s"' % (key, RA_NONE_AXIS)]
    return '\n'.join(lines) + '\n'


def write(path, text, owner=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + '.new', 'w', encoding='utf-8') as f:
        f.write(text)
    os.chmod(path + '.new', 0o644)
    os.replace(path + '.new', path)
    if owner is not None:
        try:
            os.chown(os.path.dirname(path), owner, owner)
            os.chown(path, owner, owner)
        except OSError:
            pass


def write_bytes(path, data, owner=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + '.new', 'wb') as f:
        f.write(data)
    os.chmod(path + '.new', 0o644)
    os.replace(path + '.new', path)
    if owner is not None:
        try:
            os.chown(path, owner, owner)
        except OSError:
            pass


# ── SDL game controller ─────────────────────────────────────────

# O painel como fight stick: X Y RB em cima, A B RT embaixo; a ficha e o Back.
# A notacao dos elementos (b3, -a1, h0.1) e a do proprio mapeamento do SDL.
# O 7 e o 8 de um painel de 8 botoes: LB em cima, LT embaixo (o fight stick
# de 8 botoes).
SDL_SLOTS = {'up': 'dpup', 'down': 'dpdown', 'left': 'dpleft', 'right': 'dpright', 'b1': 'x', 'b2': 'y',
             'b3': 'rightshoulder', 'b4': 'a', 'b5': 'b', 'b6': 'righttrigger', 'b7': 'leftshoulder',
             'b8': 'lefttrigger', 'start': 'start', 'coin': 'back'}
# O joypad como ele e: cada botao no seu lugar (o mesmo que o SDL faz para
# um controle do banco dele), o hotkey no Guide e os analogicos.
SDL_PAD_SLOTS = {'up': 'dpup', 'down': 'dpdown', 'left': 'dpleft', 'right': 'dpright', 'b1': 'x', 'b2': 'y',
                 'b3': 'leftshoulder', 'b4': 'a', 'b5': 'b', 'b6': 'rightshoulder', 'b7': 'lefttrigger',
                 'b8': 'righttrigger', 'start': 'start', 'coin': 'back', 'hotkey': 'guide', 'l3': 'leftstick',
                 'r3': 'rightstick'}
SDL_STICKS = {'lsup': 'lefty', 'lsleft': 'leftx', 'rsup': 'righty', 'rsleft': 'rightx'}


def sdl_mapping_line(guid, name, binds, slots=None, rests=()):
    """A linha do mapeamento do SDL. Com o joypad (SDL_PAD_SLOTS) vao os
    analogicos ("lefty:a1", com ~ se pego ao contrario) e o gatilho num eixo
    que repousa embaixo vai inteiro ("lefttrigger:a2"), como no banco do SDL:
    "+a2" seria so a metade do curso."""
    slots = slots or SDL_SLOTS
    fields = []
    for c, (_, e) in sorted(binds.items()):
        # O hotkey no proprio Select (o que o Batocera sugere sem um botao
        # so dele) fica so no Back: o mesmo botao em dois lugares do SDL.
        if c == 'hotkey' and binds.get('coin', (None, None))[1] == e:
            continue
        if c in slots:
            m = re.fullmatch(r'\+a(\d+)', e)
            if slots is SDL_PAD_SLOTS and m and c in ('b7', 'b8'):
                axis = int(m.group(1))
                if axis < len(rests) and rests[axis] <= -TRIGGER_REST:
                    e = 'a%d' % axis
            fields.append('%s:%s' % (slots[c], e))
        elif slots is SDL_PAD_SLOTS and c in SDL_STICKS and stick_axis(e):
            axis, inverted = stick_axis(e)
            fields.append('%s:a%d%s' % (SDL_STICKS[c], axis, '~' if inverted else ''))
    return ','.join([guid, name.replace(',', ' ')] + sorted(fields) + ['platform:Linux']) + ','


def sdl_user_db(players, devices, kinds=None):
    """As linhas do gamecontrollerdb-user.txt: um aparelho (GUID) por linha,
    pelo primeiro jogador que o usa (dois paineis iguais tem o mesmo GUID).
    O painel vai como fight stick; o joypad, como ele e."""
    lines = {}
    for player in sorted(players):
        binds = players[player]
        index = next(iter(binds.values()))[0]
        if index in devices and devices[index][0] not in lines:
            guid, name = devices[index][:2]
            pad = player_kind(kinds or {}, player) == 'pad'
            rests = devices[index][4] if len(devices[index]) > 4 else ()
            lines[guid] = sdl_mapping_line(guid, name, binds, SDL_PAD_SLOTS if pad else SDL_SLOTS, rests)
    return lines


# ── SM2-Emu (Model 2) ───────────────────────────────────────────

# O SM2-Emu le o game controller do SDL: os botoes 1 a 4 do jogo em A B X Y
# (os pad*_button_* padrao do sm2-emu.ini), Start e a ficha no Back. No
# layout de fight stick dos outros emuladores o botao 1 do jogo caia na
# linha de baixo, e o RB (o 3 do painel) e sempre o botao 4 dele: o Model 2
# ganha um mapeamento proprio, com o botao N do jogo na posicao do painel
# do layout (sem layout, na posicao N).
MODEL2_SLOTS = {'up': 'dpup', 'down': 'dpdown', 'left': 'dpleft', 'right': 'dpright', 'b1': 'a', 'b2': 'b',
                'b3': 'x', 'b4': 'y', 'start': 'start', 'coin': 'back'}
MODEL2_BUTTONS = 4


def model2_db(players, devices, order):
    """As linhas do mapeamento do Model 2, um aparelho (GUID) por linha."""
    lines = {}
    for player in sorted(players):
        binds = players[player]
        index = next(iter(binds.values()))[0]
        if index not in devices or devices[index][0] in lines:
            continue
        guid, name = devices[index][:2]
        game = {c: b for c, b in binds.items() if not c.startswith('b')}
        for n, position in enumerate(order[:MODEL2_BUTTONS], 1):
            if 'b%d' % position in binds:
                game['b%d' % n] = binds['b%d' % position]
        lines[guid] = sdl_mapping_line(guid, name, game, MODEL2_SLOTS)
    return lines


def model2_save(players, devices, layouts):
    """O gamecontrollerdb-model2.txt e o de cada numero de botoes com layout."""
    paths = []
    for count in [0] + list(range(1, MODEL2_BUTTONS + 1)):
        path = MODEL2_DB if not count else '%s-%d.txt' % (os.path.splitext(MODEL2_DB)[0], count)
        if count and count not in layouts:
            if os.path.isfile(path):
                os.remove(path)
            continue
        lines = model2_db(players, devices, layout_order(layouts, count))
        write(path, ''.join(line + '\n' for line in lines.values()))
        paths.append(path)
    return paths


