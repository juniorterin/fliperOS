}
# Cada tecla do MAME nos outros: (RetroArch, scancode do SDL (OpenBOR,
# Flycast), Supermodel, SDL_Keycode (Hypseus)).
KEYS = {
    'UP': ('up', 82, 'UP', 'SDLK_UP'), 'DOWN': ('down', 81, 'DOWN', 'SDLK_DOWN'),
    'LEFT': ('left', 80, 'LEFT', 'SDLK_LEFT'), 'RIGHT': ('right', 79, 'RIGHT', 'SDLK_RIGHT'),
    'LCONTROL': ('ctrl', 224, 'LEFTCTRL', 'SDLK_LCTRL'), 'LALT': ('alt', 226, 'LEFTALT', 'SDLK_LALT'),
    'LSHIFT': ('shift', 225, 'LEFTSHIFT', 'SDLK_LSHIFT'), 'SPACE': ('space', 44, 'SPACE', 'SDLK_SPACE'),
    'RCONTROL': ('rctrl', 228, 'RIGHTCTRL', 'SDLK_RCTRL'), 'RSHIFT': ('rshift', 229, 'RIGHTSHIFT', 'SDLK_RSHIFT'),
    'ENTER': ('enter', 40, 'RETURN', 'SDLK_RETURN'),
    '8_PAD': ('keypad8', 96, 'KEYPAD8', 'SDLK_KP_8'), '2_PAD': ('keypad2', 90, 'KEYPAD2', 'SDLK_KP_2'),
    '4_PAD': ('keypad4', 92, 'KEYPAD4', 'SDLK_KP_4'), '6_PAD': ('keypad6', 94, 'KEYPAD6', 'SDLK_KP_6'),
