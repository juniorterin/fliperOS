#!/usr/bin/env python3
"""Configurador de botoes do FliperOS (Setup > Joysticks > Button mapping).

  fliperos-buttons capture [--timeout SEGUNDOS]
      espera o proximo comando de qualquer controle e imprime
      "INDICE ELEMENTO NOME" (status 1 se o tempo acabou)
  fliperos-buttons save MAPA
      grava os botoes no RetroArch e no GroovyMAME

ELEMENTO na numeracao do SDL (joystick, nao game controller): b3 (botao),
-a1 / +a1 (meio eixo), h0.1 / h0.2 / h0.4 / h0.8 (hat: cima, direita,
baixo, esquerda). INDICE e a ordem do controle no SDL. MAPA: linhas
"JOGADOR CONTROLE INDICE ELEMENTO NOME", CONTROLE em up down left right b1
... b6 start coin (b1 a b6: os botoes na ordem do painel, 1 2 3 em cima e 4
5 6 embaixo).

RetroArch: binds por jogador num arquivo que o fliperos-kms-run soma a
config (--appendconfig), por cima do perfil automatico do controle; os
botoes do painel no layout dos cores de arcade (FBNeo, MAME), como o
fliperos-controllers: Y X L / B A R, Start e Select (ficha).

GroovyMAME: um ctrlr (~/.mame/ctrlr/fliperos.cfg) com os JOYCODE de cada
jogador, e no mame.ini "ctrlr fliperos" e "joystickprovider sdljoy" (o
Setup grava): no sdljoy o MAME numera os botoes como o SDL, na ordem do
aparelho; no sdlgame (o padrao) ele os ve pelo mapeamento de game
controller (A, B, X, Y...), que num painel nao segue a ordem.
"""
import argparse
import ctypes
import ctypes.util
import os
import sys
import time
from xml.sax.saxutils import escape

RA_BUTTONS = os.environ.get('FLIPEROS_RA_BUTTONS', '/etc/fliperos/retroarch/buttons.cfg')
MAME_CTRLR = os.environ.get('FLIPEROS_MAME_CTRLR', '/home/fliperos/.mame/ctrlr/fliperos.cfg')
USER_ID = 1000

CONTROLS = ['up', 'down', 'left', 'right', 'b1', 'b2', 'b3', 'b4', 'b5', 'b6', 'start', 'coin']
# Os botoes do painel no RetroPad (layout dos cores de arcade).
RA_KEYS = {'up': 'up', 'down': 'down', 'left': 'left', 'right': 'right', 'b1': 'y', 'b2': 'x', 'b3': 'l',
           'b4': 'b', 'b5': 'a', 'b6': 'r', 'start': 'start', 'coin': 'select'}
RA_HAT = {'1': 'up', '2': 'right', '4': 'down', '8': 'left'}
MAME_PORTS = {'up': 'P%d_JOYSTICK_UP', 'down': 'P%d_JOYSTICK_DOWN', 'left': 'P%d_JOYSTICK_LEFT',
              'right': 'P%d_JOYSTICK_RIGHT', 'start': 'START%d', 'coin': 'COIN%d'}
MAME_PORTS.update({'b%d' % n: 'P%%d_BUTTON%d' % n for n in range(1, 7)})
# As teclas padrao do MAME continuam valendo junto (jogadores 1 e 2).
MAME_KEYS = {
    1: {'up': 'UP', 'down': 'DOWN', 'left': 'LEFT', 'right': 'RIGHT', 'b1': 'LCONTROL', 'b2': 'LALT',
        'b3': 'SPACE', 'b4': 'LSHIFT', 'b5': 'Z', 'b6': 'X', 'start': '1', 'coin': '5'},
    2: {'up': 'R', 'down': 'F', 'left': 'D', 'right': 'G', 'b1': 'A', 'b2': 'S', 'b3': 'Q', 'b4': 'W',
        'start': '2', 'coin': '6'},
    3: {'start': '3', 'coin': '7'},
    4: {'start': '4', 'coin': '8'},
}
MAME_AXES = ['XAXIS', 'YAXIS', 'ZAXIS', 'RXAXIS', 'RYAXIS', 'RZAXIS', 'SLIDER1', 'SLIDER2']
MAME_HAT = {'1': 'UP', '2': 'RIGHT', '4': 'DOWN', '8': 'LEFT'}
AXIS_PRESS = 20000


def mame_code(index, element):
    """O codigo do MAME (joystickprovider sdljoy) de um elemento do SDL."""
    joy = 'JOYCODE_%d_' % (index + 1)
    if element.startswith('b'):
        return joy + 'BUTTON%d' % (int(element[1:]) + 1)
    if element.startswith('h'):
        hat, direction = element[1:].split('.')
        return joy + 'HAT%d%s' % (int(hat) + 1, MAME_HAT[direction])
    sign, axis = element[0], int(element[2:])
    name = MAME_AXES[axis] if axis < len(MAME_AXES) else MAME_AXES[-1]
    if name == 'XAXIS':
        side = 'LEFT' if sign == '-' else 'RIGHT'
    elif name == 'YAXIS':
        side = 'UP' if sign == '-' else 'DOWN'
    else:
        side = 'NEG' if sign == '-' else 'POS'
    return joy + '%s_%s_SWITCH' % (name, side)


def retroarch_lines(player, control, element):
    """Os binds do RetroArch (driver udev) de um controle de um jogador."""
    key = 'input_player%d_%s' % (player, RA_KEYS[control])
    if element.startswith('b'):
        return ['%s_btn = "%s"' % (key, element[1:]), '%s_axis = "nul"' % key]
    if element.startswith('h'):
        hat, direction = element[1:].split('.')
        return ['%s_btn = "h%s%s"' % (key, hat, RA_HAT[direction]), '%s_axis = "nul"' % key]
    return ['%s_axis = "%s%s"' % (key, element[0], element[2:]), '%s_btn = "nul"' % key]


def read_map(path):
    """{jogador: {controle: (indice, elemento)}} e {indice: nome}."""
    players, names = {}, {}
    with open(path, encoding='utf-8') as f:
        for line in f:
            parts = line.split(None, 4)
            if len(parts) < 4 or parts[1] not in CONTROLS:
                continue
            player, control, index, element = int(parts[0]), parts[1], int(parts[2]), parts[3]
            players.setdefault(player, {})[control] = (index, element)
            names[index] = parts[4].strip() if len(parts) > 4 else ''
    return players, names


def retroarch_cfg(players, names):
    lines = ['# Gerado pelo Setup > Joysticks > Button mapping (fliperos-buttons): os botoes',
             '# de cada jogador, por cima do perfil automatico do controle. O fliperos-kms-run',
             '# soma este arquivo a config (--appendconfig).']
    for player in sorted(players):
        binds = players[player]
        index = next(iter(binds.values()))[0]
        lines += ['', '# Jogador %d: %s' % (player, names.get(index, '')),
                  'input_player%d_joypad_index = "%d"' % (player, index)]
        for control in CONTROLS:
            if control in binds:
                lines += retroarch_lines(player, control, binds[control][1])
    return '\n'.join(lines) + '\n'


def mame_cfg(players, names):
    ports = []
    for player in sorted(players):
        for control in CONTROLS:
            if control not in players[player]:
                continue
            index, element = players[player][control]
            seq = mame_code(index, element)
            key = MAME_KEYS.get(player, {}).get(control)
            if key:
                seq += ' OR KEYCODE_%s' % key
            ports.append('            <port type="%s">\n                <newseq type="standard">%s</newseq>\n'
                         '            </port>\n' % (MAME_PORTS[control] % player, seq))
    devices = ''.join('<!-- JOYCODE_%d: %s -->\n' % (i + 1, escape(n)) for i, n in sorted(names.items()))
    return ('<?xml version="1.0"?>\n<!-- Gerado pelo Setup > Joysticks > Button mapping (fliperos-buttons). -->\n'
            + devices + '<mameconfig version="10">\n    <system name="default">\n        <input>\n'
            + ''.join(ports) + '        </input>\n    </system>\n</mameconfig>\n')


def write(path, text, owner=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + '.new', 'w', encoding='utf-8') as f:
        f.write(text)
    os.chmod(path + '.new', 0o644)
    os.replace(path + '.new', path)
    if owner is not None:
        try:
            os.chown(os.path.dirname(path), owner, owner)
            os.chown(path, owner, owner)
        except OSError:
            pass


def cmd_save(args):
    players, names = read_map(args.map)
    if not players:
        sys.exit('mapa vazio: %s' % args.map)
    write(RA_BUTTONS, retroarch_cfg(players, names))
    write(MAME_CTRLR, mame_cfg(players, names), USER_ID)
    print(RA_BUTTONS)
    print(MAME_CTRLR)


# ── SDL: o proximo comando ──────────────────────────────────────

def sdl():
    lib = ctypes.CDLL(ctypes.util.find_library('SDL2') or 'libSDL2-2.0.so.0')
    lib.SDL_JoystickOpen.restype = ctypes.c_void_p
    lib.SDL_JoystickName.restype = ctypes.c_char_p
    for f in ('SDL_JoystickNumButtons', 'SDL_JoystickNumAxes', 'SDL_JoystickNumHats', 'SDL_JoystickName'):
        getattr(lib, f).argtypes = [ctypes.c_void_p]
    lib.SDL_JoystickGetButton.argtypes = [ctypes.c_void_p, ctypes.c_int]
    lib.SDL_JoystickGetAxis.argtypes = [ctypes.c_void_p, ctypes.c_int]
    lib.SDL_JoystickGetAxis.restype = ctypes.c_int16
    lib.SDL_JoystickGetHat.argtypes = [ctypes.c_void_p, ctypes.c_int]
    lib.SDL_JoystickGetHat.restype = ctypes.c_uint8
    return lib


def state(lib, js):
    return ([lib.SDL_JoystickGetButton(js, i) for i in range(lib.SDL_JoystickNumButtons(js))],
            [lib.SDL_JoystickGetAxis(js, i) for i in range(lib.SDL_JoystickNumAxes(js))],
            [lib.SDL_JoystickGetHat(js, i) for i in range(lib.SDL_JoystickNumHats(js))])


def pressed(rest, now):
    """O primeiro elemento apertado em relacao ao repouso, ou None."""
    for i, (r, n) in enumerate(zip(rest[0], now[0])):
        if n and not r:
            return 'b%d' % i
    for i, (r, n) in enumerate(zip(rest[1], now[1])):
        if n - r > AXIS_PRESS:
            return '+a%d' % i
        if r - n > AXIS_PRESS:
            return '-a%d' % i
    for i, (r, n) in enumerate(zip(rest[2], now[2])):
        if n and n != r:
            for bit in (1, 2, 4, 8):
                if n & bit:
                    return 'h%d.%d' % (i, bit)
    return None


def settle(rest, now):
    """O repouso depois que o que estava apertado no comeco foi solto: o botao
    solto, o eixo que voltou ao centro (um gatilho em -32768 nao volta e
    continua repouso) e o hat solto passam a valer de novo."""
    buttons = [min(r, n) for r, n in zip(rest[0], now[0])]
    axes = [n if abs(r) > AXIS_PRESS and abs(n) < 8000 else r for r, n in zip(rest[1], now[1])]
    hats = [0 if r and not n else r for r, n in zip(rest[2], now[2])]
    return buttons, axes, hats


def cmd_capture(args):
    for var in ('SDL_GAMECONTROLLERCONFIG', 'SDL_GAMECONTROLLERCONFIG_FILE'):
        os.environ.pop(var, None)
    lib = sdl()
    if lib.SDL_Init(0x200) != 0:  # JOYSTICK
        sys.exit('SDL: sem joystick')
    try:
        sticks = [lib.SDL_JoystickOpen(i) for i in range(lib.SDL_NumJoysticks())]
        lib.SDL_JoystickUpdate()
        time.sleep(0.05)
        lib.SDL_JoystickUpdate()
        # O repouso de cada controle: o que estiver apertado agora (o comando
        # anterior ainda segurado, um gatilho em -32768) nao conta.
        rest = [state(lib, js) if js else None for js in sticks]
        deadline = time.monotonic() + args.timeout
        while time.monotonic() < deadline:
            lib.SDL_JoystickUpdate()
            for index, js in enumerate(sticks):
                if not js:
                    continue
                now = state(lib, js)
                element = pressed(rest[index], now)
                if element:
                    name = (lib.SDL_JoystickName(js) or b'').decode(errors='replace')
                    print('%d %s %s' % (index, element, name))
                    return 0
                rest[index] = settle(rest[index], now)
            time.sleep(0.005)
        return 1
    finally:
        lib.SDL_Quit()


def main():
    parser = argparse.ArgumentParser(prog='fliperos-buttons')
    sub = parser.add_subparsers(dest='command', required=True)
    p = sub.add_parser('capture')
    p.add_argument('--timeout', type=float, default=8)
    p.set_defaults(func=cmd_capture)
    p = sub.add_parser('save')
    p.add_argument('map')
    p.set_defaults(func=cmd_save)
    args = parser.parse_args()
    sys.exit(args.func(args) or 0)


if __name__ == '__main__':
    main()
