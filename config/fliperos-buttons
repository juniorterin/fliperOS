def flycast_cfg(name, binds, keys):
    digital, analog = [], []
    for control, (_, element) in sorted(binds.items()):
        key = keys.get(control)
        if element.startswith('b'):
            digital.append('%s:%s' % (element[1:], key))
        elif element[0] in '+-':
            analog.append('%s%s:%s' % (element[2:], element[0], key))
    text = '[analog]\n' + ''.join('bind%d = %s\n' % (i, b) for i, b in enumerate(analog))
    text += '\n[digital]\n' + ''.join('bind%d = %s\n' % (i, b) for i, b in enumerate(digital))
    text += ('\n[emulator]\ndead_zone = 10\nmapping_name = %s\nrumble_power = 100\nsaturation = 100\n'
             'triggers = \nversion = 4\n' % name)
    return text


def flycast_filename(name, arcade):
    clean = re.sub(r'[/\\:*?"<>|]', '-', name)
    return 'SDL_%s%s.cfg' % (clean, '_arcade' if arcade else '')


# ── OpenBOR ─────────────────────────────────────────────────────

# O struct s_savedata (engine/source/savedata.h, #pragma pack(1), com SDL):
# 10 ints, keys[4][13], joyrumble[4], 12 ints, hwscale (float), hwfilter.
OPENBOR_VERSION = 0x00033749      # COMPATIBLEVERSION
OPENBOR_SIZE = 320
OPENBOR_KEYS_AT = 40
OPENBOR_NONE = 600 + 1 + 64 * 99  # CONTROL_NONE
# SDID: MOVEUP MOVEDOWN MOVELEFT MOVERIGHT ATTACK ATTACK2 ATTACK3 ATTACK4 JUMP
# SPECIAL START SCREENSHOT ESC. O painel: 1 ataque, 2 pulo, 3 especial, 4 5 6
# os outros ataques; a ficha e o Esc (o menu do OpenBOR).
OPENBOR_ACTIONS = {'up': 0, 'down': 1, 'left': 2, 'right': 3, 'b1': 4, 'b4': 5, 'b5': 6, 'b6': 7, 'b2': 8,
                   'b3': 9, 'start': 10, 'coin': 12}
# As teclas do jogador 1 do clearbuttons() (scancodes do SDL).
OPENBOR_P1_KEYS = [82, 81, 80, 79, 4, 22, 29, 27, 7, 9, 40, 69, 0]


def openbor_code(index, element, nbuttons, naxes):
    """O codigo do OpenBOR (engine/sdl/control.c) de um elemento do SDL."""
    base = 600 + 1 + index * 64
    if element.startswith('b'):
        return base + int(element[1:])
    if element.startswith('h'):
        hat, direction = element[1:].split('.')
        return base + nbuttons + 2 * naxes + 4 * int(hat) + {'1': 0, '2': 1, '4': 2, '8': 3}[direction]
    return base + nbuttons + 2 * int(element[2:]) + (1 if element[0] == '+' else 0)


def openbor_default():
    """O s_savedata do clearsettings(), com a tela cheia do FliperOS."""
    keys = OPENBOR_P1_KEYS + [OPENBOR_NONE] * 13 * 3
    data = struct.pack('<I9i', OPENBOR_VERSION, 0, 0, 100, 1, 100, 100, 1, 0, 0)
    data += struct.pack('<52i', *keys) + struct.pack('<4i', 0, 0, 0, 0)
    # showtitles videoNTSC swfilter logo uselog debuginfo fullscreen stretch
    # screen[0][0] screen[0][1] fpslimit usegl
    data += struct.pack('<12i', 0, 0, 0, 1, 1, 0, 1, 0, 0, 0, 1, 1)
    return data + struct.pack('<fi', 1.0, 1)


def openbor_with_keys(data, players, devices):
    keys = list(struct.unpack_from('<52i', data, OPENBOR_KEYS_AT))
    for player, binds in players.items():
        if not 1 <= player <= 4:
            continue
        for control, (index, element) in binds.items():
            if control in OPENBOR_ACTIONS and index in devices:
                nbuttons, naxes = devices[index][2:4]
                keys[(player - 1) * 13 + OPENBOR_ACTIONS[control]] = openbor_code(index, element, nbuttons, naxes)
    return data[:OPENBOR_KEYS_AT] + struct.pack('<52i', *keys) + data[OPENBOR_KEYS_AT + 52 * 4:]


def openbor_save(players, devices):
    """O default.cfg (criado, se nao existe) e o .cfg de cada pak."""
    os.makedirs(OPENBOR_SAVES, exist_ok=True)
    paths = {os.path.join(OPENBOR_SAVES, f) for f in os.listdir(OPENBOR_SAVES) if f.endswith('.cfg')}
    paths.add(os.path.join(OPENBOR_SAVES, 'default.cfg'))
    for path in sorted(paths):
        try:
            with open(path, 'rb') as f:
                data = f.read()
        except OSError:
            data = openbor_default()
        if len(data) != OPENBOR_SIZE or struct.unpack_from('<I', data)[0] != OPENBOR_VERSION:
            continue
        write_bytes(path, openbor_with_keys(data, players, devices), USER_ID)


# ── Supermodel ──────────────────────────────────────────────────

# controle: (chave do jogador 1, chave do jogador 2, tecla padrao do jogador 1)
SUPERMODEL_KEYS = {
    'start': ('InputStart1', 'InputStart2', 'KEY_1'), 'coin': ('InputCoin1', 'InputCoin2', 'KEY_3'),
    'up': ('InputJoyUp', 'InputJoyUp2', 'KEY_UP'), 'down': ('InputJoyDown', 'InputJoyDown2', 'KEY_DOWN'),
    'left': ('InputJoyLeft', 'InputJoyLeft2', 'KEY_LEFT'), 'right': ('InputJoyRight', 'InputJoyRight2', 'KEY_RIGHT'),
    'b1': ('InputPunch', 'InputPunch2', 'KEY_A'), 'b2': ('InputKick', 'InputKick2', 'KEY_S'),
    'b3': ('InputGuard', 'InputGuard2', 'KEY_D'), 'b4': ('InputEscape', 'InputEscape2', 'KEY_F'),
}
SUPERMODEL_P2_KEYS = {'start': 'KEY_2', 'coin': 'KEY_4'}
SUPERMODEL_AXES = ['XAXIS', 'YAXIS', 'ZAXIS', 'RXAXIS', 'RYAXIS', 'RZAXIS']
SUPERMODEL_HAT = {'1': 'UP', '2': 'RIGHT', '4': 'DOWN', '8': 'LEFT'}


def supermodel_code(index, element):
    """O nome de entrada do Supermodel (SDL: JOY1 e o controle 0) de um elemento."""
    joy = 'JOY%d_' % (index + 1)
    if element.startswith('b'):
        return joy + 'BUTTON%d' % (int(element[1:]) + 1)
    if element.startswith('h'):
        hat, direction = element[1:].split('.')
        return joy + 'POV%d_%s' % (int(hat) + 1, SUPERMODEL_HAT[direction])
    axis = int(element[2:])
    name = SUPERMODEL_AXES[axis] if axis < len(SUPERMODEL_AXES) else SUPERMODEL_AXES[-1]
    return joy + '%s_%s' % (name, 'NEG' if element[0] == '-' else 'POS')


def supermodel_values(players):
    """{chave do Supermodel.ini: valor} dos jogadores 1 e 2."""
    out = {}
    for player in (1, 2):
        for control, (index, element) in players.get(player, {}).items():
            if control not in SUPERMODEL_KEYS:
                continue
            key = SUPERMODEL_KEYS[control][player - 1]
            default = SUPERMODEL_KEYS[control][2] if player == 1 else SUPERMODEL_P2_KEYS.get(control)
            code = supermodel_code(index, element)
            out[key] = '"%s,%s"' % (default, code) if default else '"%s"' % code
    return out


def supermodel_ini(text, values):
    """O Supermodel.ini com as chaves de `values` na secao [ Global ]: as que
    ja existem trocadas, as que faltam logo depois do cabecalho."""
    lines = text.splitlines()
    rest = dict(values)
    for i, line in enumerate(lines):
        m = re.match(r'\s*(\w+)\s*=', line)
        if m and m.group(1) in rest:
            lines[i] = '%s = %s' % (m.group(1), rest.pop(m.group(1)))
    if rest:
        new = ['%s = %s' % kv for kv in sorted(rest.items())]
        head = next((i for i, l in enumerate(lines) if re.match(r'\s*\[\s*Global\s*\]', l)), None)
        if head is None:
            lines = ['[ Global ]'] + new + [''] + lines
        else:
            lines[head + 1:head + 1] = new
    return '\n'.join(lines) + '\n'


def supermodel_save(players):
    try:
        with open(SUPERMODEL_INI, encoding='utf-8', errors='replace') as f:
            text = f.read()
    except OSError:
        text = ''
    write(SUPERMODEL_INI, supermodel_ini(text, supermodel_values(players)), USER_ID)
    try:
        os.chown(os.path.dirname(os.path.dirname(SUPERMODEL_INI)), USER_ID, USER_ID)
    except OSError:
        pass


def read_text(path):
    try:
        with open(path, encoding='utf-8', errors='replace') as f:
            return f.read()
    except OSError:
        return ''


def ini_get(text, section, key):
    current = None
    for line in text.splitlines():
        m = re.match(r'\s*\[(.*)\]\s*$', line)
        if m:
            current = m.group(1).strip()
            continue
        m = re.match(r'\s*([^=]+?)\s*=\s*(.*?)\s*$', line)
        if m and current == section and m.group(1) == key:
            return m.group(2)
    return None


def ini_section(text, section, values, replace=False):
    """`text` com os pares de `values` na secao [section]: os que ja existem
    trocados, os que faltam no fim dela (e a secao no fim do arquivo, se
    faltar). Com replace, a secao fica so com `values`."""
    lines = text.splitlines()
    start = next((i for i, l in enumerate(lines) if l.strip() == '[%s]' % section), None)
    new = ['%s = %s' % kv for kv in values]
    if start is None:
        while lines and not lines[-1].strip():
            lines.pop()
        return '\n'.join(lines + ([''] if lines else []) + ['[%s]' % section] + new) + '\n'
    end = next((i for i in range(start + 1, len(lines)) if lines[i].lstrip().startswith('[')), len(lines))
    if replace:
        body = new
    else:
        body, rest = lines[start + 1:end], dict(values)
        for i, line in enumerate(body):
            m = re.match(r'\s*([^=]+?)\s*=', line)
            if m and m.group(1) in rest:
                body[i] = '%s = %s' % (m.group(1), rest.pop(m.group(1)))
        while body and not body[-1].strip():
            body.pop()
        body += ['%s = %s' % (k, v) for k, v in values if k in rest]
    tail = lines[end:]
    return '\n'.join(lines[:start + 1] + body + ([''] if tail else []) + tail) + '\n'


# ── Dolphin ─────────────────────────────────────────────────────

# O Dolphin abre o painel como game controller do SDL (o gamecontrollerdb):
# o controle de GameCube pelo layout de fight stick, 4 = A, 1 = B, 5 = X,
# 2 = Y, 3 = Z, 6 = R, e a ficha na Coin do Triforce. O L fica no LB, que um
# painel de 6 botoes nao tem.
DOLPHIN_GCPAD = [
    ('Buttons/A', 'Button S'), ('Buttons/B', 'Button W'), ('Buttons/X', 'Button E'), ('Buttons/Y', 'Button N'),
    ('Buttons/Z', 'Shoulder R'), ('Buttons/Start', 'Start'),
    ('Main Stick/Up', 'Pad N'), ('Main Stick/Down', 'Pad S'), ('Main Stick/Left', 'Pad W'),
    ('Main Stick/Right', 'Pad E'),
    ('Triggers/L', 'Shoulder L'), ('Triggers/R', 'Trigger R'), ('Triggers/L-Analog', 'Shoulder L'),
    ('Triggers/R-Analog', 'Trigger R'), ('Triforce/Coin', 'Back'),
]
DOLPHIN_CALIBRATION = ' '.join(['100.00 141.42'] * 4)
DOLPHIN_GC_CONTROLLER = '6'  # SIDEVICE_GC_CONTROLLER


def dolphin_save(players, devices):
    """GCPad1 a GCPad4 no GCPadNew.ini, e no Dolphin.ini a porta de cada
    jogador como controle de GameCube (sem nada nela, a 2 a 4 vem vazia)."""
    gcpad = os.path.join(DOLPHIN_DIR, 'GCPadNew.ini')
    text = read_text(gcpad)
    ports = []
    for player in sorted(p for p in players if p <= 4):
        index = next(iter(players[player].values()))[0]
        if index not in devices:
            continue
        name = devices[index][1].replace(',', ' ')
        # Aparelhos de mesmo nome: 0, 1... na ordem do SDL.
        cid = sum(1 for i in devices if i < index and devices[i][1].replace(',', ' ') == name)
        values = [('Device', 'SDL/%d/%s' % (cid, name))]
        values += [(k, '`%s`' % v) for k, v in DOLPHIN_GCPAD]
        values += [('Main Stick/Calibration', DOLPHIN_CALIBRATION)]
        text = ini_section(text, 'GCPad%d' % player, values, replace=True)
        ports.append(player)
    if not ports:
        return []
    write(gcpad, text, USER_ID)
    main = os.path.join(DOLPHIN_DIR, 'Dolphin.ini')
    text = read_text(main)
    keys = ['SIDevice%d' % (p - 1) for p in ports]
    keys = [k for k in keys if ini_get(text, 'Core', k) in (None, '0')]
    if keys:
        write(main, ini_section(text, 'Core', [(k, DOLPHIN_GC_CONTROLLER) for k in keys]), USER_ID)
    return [gcpad, main]


# ── Hypseus Singe ───────────────────────────────────────────────

# [KEYBOARD] do hypinput.ini: nome, tecla 1, tecla 2 (as do exemplo do
# projeto). O botao do joystick e 100 * controle + botao + 1; o eixo,
# o mesmo com o sinal; o hat (so o primeiro de um controle) se liga pelo
# botao do KEY_UP, 100 * controle.
HYPSEUS_DEFAULT = [
    ('KEY_UP', 'SDLK_UP', '0'), ('KEY_DOWN', 'SDLK_DOWN', '0'), ('KEY_LEFT', 'SDLK_LEFT', '0'),
    ('KEY_RIGHT', 'SDLK_RIGHT', '0'), ('KEY_COIN1', 'SDLK_5', '0'), ('KEY_COIN2', 'SDLK_6', '0'),
    ('KEY_START1', 'SDLK_1', '0'), ('KEY_START2', 'SDLK_2', '0'), ('KEY_BUTTON1', 'SDLK_LCTRL', '0'),
    ('KEY_BUTTON2', 'SDLK_LALT', '0'), ('KEY_BUTTON3', 'SDLK_SPACE', '0'), ('KEY_SKILL1', 'SDLK_LSHIFT', '0'),
    ('KEY_SKILL2', 'SDLK_z', '0'), ('KEY_SKILL3', 'SDLK_x', '0'), ('KEY_SERVICE', 'SDLK_9', '0'),
    ('KEY_TEST', 'SDLK_F2', 'SDLK_F4'), ('KEY_RESET', 'SDLK_0', '0'), ('KEY_SCREENSHOT', 'SDLK_F12', '0'),
    ('KEY_QUIT', 'SDLK_ESCAPE', '0'), ('KEY_PAUSE', 'SDLK_p', '0'), ('KEY_CONSOLE', 'SDLK_BACKSLASH', '0'),
    ('KEY_TILT', 'SDLK_t', '0'),
]
HYPSEUS_KEYS = {'up': 'KEY_UP', 'down': 'KEY_DOWN', 'left': 'KEY_LEFT', 'right': 'KEY_RIGHT',
                'b1': 'KEY_BUTTON1', 'b2': 'KEY_BUTTON2', 'b3': 'KEY_BUTTON3', 'b4': 'KEY_SKILL1',
                'b5': 'KEY_SKILL2', 'b6': 'KEY_SKILL3', 'start': 'KEY_START1', 'coin': 'KEY_COIN1'}
HYPSEUS_P2_KEYS = {'start': 'KEY_START2', 'coin': 'KEY_COIN2'}
HYPSEUS_MOUSE = '[MOUSE]\nMOUSE_BUTTON1   = KEY_BUTTON3\nMOUSE_BUTTON2   = KEY_BUTTON1\nMOUSE_BUTTON3   = KEY_BUTTON2\nEND\n'


def hypseus_keyboard(players):
    joy = {}
    for player, keys in ((1, HYPSEUS_KEYS), (2, HYPSEUS_P2_KEYS)):
        for control, (index, element) in players.get(player, {}).items():
            if control not in keys:
                continue
            name = keys[control]
            if element.startswith('b'):
                joy[name] = ('%03d' % (index * 100 + int(element[1:]) + 1), None)
            elif element.startswith('h'):
                if name == 'KEY_UP':
                    joy[name] = ('%03d' % (index * 100), None)
            else:
                joy[name] = (None, '%s%03d' % (element[0], index * 100 + int(element[2:]) + 1))
    lines = ['[KEYBOARD]']
    for name, key1, key2 in HYPSEUS_DEFAULT:
        button, axis = joy.get(name, (None, None))
        line = '%-15s = %-15s %-12s %-10s %s' % (name, key1, key2, button or '0', axis or '')
        lines.append(line.rstrip())
    return '\n'.join(lines + ['END']) + '\n'


def hypseus_save(players):
    text = read_text(HYPSEUS_INI)
    keyboard = hypseus_keyboard(players)
    m = re.search(r'(?ims)^\[KEYBOARD\].*?^END[ \t]*\n?', text)
    if m:
        text = text[:m.start()] + keyboard + text[m.end():]
    else:
        text = ('# Gerado pelo Setup > Joysticks > Button mapping (fliperos-buttons).\n\n'
                + keyboard + '\n' + HYPSEUS_MOUSE)
    write(HYPSEUS_INI, text, USER_ID)


def sdl_devices():
    """{indice: (guid, nome, botoes, eixos)} dos controles ligados; vazio sem
    o SDL."""
    try:
        lib = sdl()
    except OSError:
        return {}

    class GUID(ctypes.Structure):
        _fields_ = [('data', ctypes.c_uint8 * 16)]
    lib.SDL_JoystickGetDeviceGUID.restype = GUID
    lib.SDL_JoystickGetGUIDString.argtypes = [GUID, ctypes.c_char_p, ctypes.c_int]
    lib.SDL_JoystickNameForIndex.restype = ctypes.c_char_p
    if lib.SDL_Init(0x200) != 0:
        return {}
    out = {}
    try:
        for i in range(lib.SDL_NumJoysticks()):
            buf = ctypes.create_string_buffer(33)
            lib.SDL_JoystickGetGUIDString(lib.SDL_JoystickGetDeviceGUID(i), buf, 33)
            js = lib.SDL_JoystickOpen(i)
            if not js:
                continue
            out[i] = (buf.value.decode(), (lib.SDL_JoystickNameForIndex(i) or b'').decode(errors='replace'),
                      lib.SDL_JoystickNumButtons(js), lib.SDL_JoystickNumAxes(js))
    finally:
        lib.SDL_Quit()
    return out


