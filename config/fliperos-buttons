    'up': ('InputJoyUp', 'InputJoyUp2', 'KEY_UP'), 'down': ('InputJoyDown', 'InputJoyDown2', 'KEY_DOWN'),
    'left': ('InputJoyLeft', 'InputJoyLeft2', 'KEY_LEFT'), 'right': ('InputJoyRight', 'InputJoyRight2', 'KEY_RIGHT'),
    'b1': ('InputPunch', 'InputPunch2', 'KEY_A'), 'b2': ('InputKick', 'InputKick2', 'KEY_S'),
    'b3': ('InputGuard', 'InputGuard2', 'KEY_D'), 'b4': ('InputEscape', 'InputEscape2', 'KEY_F'),
}
SUPERMODEL_P2_KEYS = {'start': 'KEY_2', 'coin': 'KEY_4'}
SUPERMODEL_AXES = ['XAXIS', 'YAXIS', 'ZAXIS', 'RXAXIS', 'RYAXIS', 'RZAXIS']
SUPERMODEL_HAT = {'1': 'UP', '2': 'RIGHT', '4': 'DOWN', '8': 'LEFT'}


# Os botoes de cada tipo de jogo do Games.xml (<input type>), na ordem do
# padrao do Supermodel (JOYn_BUTTON1, 2...): (jogador 1, jogador 2). O
# Spikeout tem um jogador por gabinete.
SUPERMODEL_FAMILIES = {
    'fighting': [('InputPunch', 'InputPunch2'), ('InputKick', 'InputKick2'), ('InputGuard', 'InputGuard2'),
                 ('InputEscape', 'InputEscape2')],
    'spikeout': [('InputShift', None), ('InputBeat', None), ('InputCharge', None), ('InputJump', None)],
    'soccer': [('InputShortPass', 'InputShortPass2'), ('InputLongPass', 'InputLongPass2'),
               ('InputShoot', 'InputShoot2')],
}
SUPERMODEL_BUTTON_KEYS = ['KEY_A', 'KEY_S', 'KEY_D', 'KEY_F']


def supermodel_code(index, element):
    """O nome de entrada do Supermodel (SDL: JOY1 e o controle 0) de um elemento."""
    if is_key(element):
        return 'KEY_' + KEYS[element[2:]][2]
    joy = 'JOY%d_' % (index + 1)
    if element.startswith('b'):
        return joy + 'BUTTON%d' % (int(element[1:]) + 1)
    if element.startswith('h'):
        hat, direction = element[1:].split('.')
        return joy + 'POV%d_%s' % (int(hat) + 1, SUPERMODEL_HAT[direction])
    axis = int(element[2:])
    name = SUPERMODEL_AXES[axis] if axis < len(SUPERMODEL_AXES) else SUPERMODEL_AXES[-1]
    return joy + '%s_%s' % (name, 'NEG' if element[0] == '-' else 'POS')


def supermodel_values(players):
    """{chave do Supermodel.ini: valor} dos jogadores 1 e 2."""
    out = {}
    for player in (1, 2):
        for control, (index, element) in players.get(player, {}).items():
            if control not in SUPERMODEL_KEYS:
                continue
            key = SUPERMODEL_KEYS[control][player - 1]
            default = SUPERMODEL_KEYS[control][2] if player == 1 else SUPERMODEL_P2_KEYS.get(control)
            code = supermodel_code(index, element)
            # Com o teclado no layout do MAME, a tecla padrao do Supermodel
            # (o A do soco) seria a de outro comando: so a do mapa.
            if is_key(element):
                default = None
            out[key] = '"%s,%s"' % (default, code) if default else '"%s"' % code
    for family in ('spikeout', 'soccer'):
        out.update(supermodel_buttons(players, SUPERMODEL_FAMILIES[family], range(1, PANEL_BUTTONS + 1)))
    return out


def supermodel_buttons(players, inputs, order):
    """{chave: valor} dos botoes de um tipo de jogo, o botao N na posicao
    order[N - 1] do painel; a tecla padrao junto no jogador 1."""
    out = {}
    for n, keys in enumerate(inputs):
        for player, key in zip((1, 2), keys):
            bind = players.get(player, {}).get('b%d' % order[n])
            if not key or not bind:
                continue
            code = supermodel_code(*bind)
            if player == 1 and not is_key(bind[1]):
                out[key] = '"%s,%s"' % (SUPERMODEL_BUTTON_KEYS[n], code)
            else:
                out[key] = '"%s"' % code
    return out


def supermodel_games(path):
    """{jogo: tipo} dos jogos do Games.xml com botoes de SUPERMODEL_FAMILIES."""
    import xml.etree.ElementTree as ET
    games = {}
    try:
        root = ET.parse(path).getroot()
    except (OSError, ET.ParseError):
        return games
    for game in root.iter('game'):
        for inp in game.iter('input'):
            if inp.get('type') in SUPERMODEL_FAMILIES and game.get('name'):
                games[game.get('name')] = inp.get('type')
    return games


def supermodel_game_section(text, game, values):
    """O Supermodel.ini com `values` na secao [ game ] (o Supermodel a soma
    a [ Global ] ao abrir o jogo), sem os botoes de um layout anterior; o
    resto da secao fica, e a que fica vazia sai."""
    owned = {k for inputs in SUPERMODEL_FAMILIES.values() for keys in inputs for k in keys if k}
    lines = text.splitlines()
    start = next((i for i, l in enumerate(lines) if re.match(r'\s*\[\s*%s\s*\]\s*$' % re.escape(game), l)), None)
    new = ['%s = %s' % kv for kv in sorted(values.items())]
    if start is None:
        if not new:
            return text
        while lines and not lines[-1].strip():
            lines.pop()
        return '\n'.join(lines + ([''] if lines else []) + ['[ %s ]' % game] + new) + '\n'
    end = next((i for i in range(start + 1, len(lines)) if lines[i].lstrip().startswith('[')), len(lines))
    body = []
    for line in lines[start + 1:end]:
        m = re.match(r'\s*(\w+)\s*=', line)
        if not (m and m.group(1) in owned):
            body.append(line)
    while body and not body[-1].strip():
        body.pop()
    body += new
    head, tail = lines[:start], lines[end:]
    if not any(l.strip() for l in body):
        while head and not head[-1].strip():
            head.pop()
        return '\n'.join(head + ([''] if head and tail else []) + tail) + '\n'
    return '\n'.join(head + [lines[start]] + body + ([''] if tail else []) + tail) + '\n'


def supermodel_layouts(text, players, layouts, table, games):
    """As secoes dos jogos do Games.xml: os botoes no layout do numero de
    botoes do jogo (o da tabela; sem ele, os do tipo do jogo)."""
    for game in sorted(games):
        inputs = SUPERMODEL_FAMILIES[games[game]]
        count = min(table[game][0], len(inputs)) if game in table else len(inputs)
        values = {}
        if count in layouts:
            values = supermodel_buttons(players, inputs[:count], layout_order(layouts, count))
        text = supermodel_game_section(text, game, values)
    return text


def supermodel_ini(text, values):
    """O Supermodel.ini com as chaves de `values` na secao [ Global ]: as que
    ja existem trocadas, as que faltam logo depois do cabecalho."""
    lines = text.splitlines()
    rest = dict(values)
    for i, line in enumerate(lines):
        m = re.match(r'\s*(\w+)\s*=', line)
        if m and m.group(1) in rest:
            lines[i] = '%s = %s' % (m.group(1), rest.pop(m.group(1)))
    if rest:
        new = ['%s = %s' % kv for kv in sorted(rest.items())]
        head = next((i for i, l in enumerate(lines) if re.match(r'\s*\[\s*Global\s*\]', l)), None)
        if head is None:
            lines = ['[ Global ]'] + new + [''] + lines
        else:
            lines[head + 1:head + 1] = new
    return '\n'.join(lines) + '\n'


def supermodel_save(players, layouts=None, table=None):
    try:
        with open(SUPERMODEL_INI, encoding='utf-8', errors='replace') as f:
            text = f.read()
    except OSError:
        text = ''
    text = supermodel_ini(text, supermodel_values(players))
    text = supermodel_layouts(text, players, layouts or {}, table or {}, supermodel_games(SUPERMODEL_GAMES))
    write(SUPERMODEL_INI, text, USER_ID)
    try:
        os.chown(os.path.dirname(os.path.dirname(SUPERMODEL_INI)), USER_ID, USER_ID)
    except OSError:
        pass


def read_text(path):
    try:
        with open(path, encoding='utf-8', errors='replace') as f:
            return f.read()
    except OSError:
        return ''


def ini_get(text, section, key):
    current = None
    for line in text.splitlines():
        m = re.match(r'\s*\[(.*)\]\s*$', line)
        if m:
            current = m.group(1).strip()
            continue
        m = re.match(r'\s*([^=]+?)\s*=\s*(.*?)\s*$', line)
        if m and current == section and m.group(1) == key:
            return m.group(2)
    return None


def ini_section(text, section, values, replace=False):
    """`text` com os pares de `values` na secao [section]: os que ja existem
    trocados, os que faltam no fim dela (e a secao no fim do arquivo, se
    faltar). Com replace, a secao fica so com `values`."""
    lines = text.splitlines()
    start = next((i for i, l in enumerate(lines) if l.strip() == '[%s]' % section), None)
    new = ['%s = %s' % kv for kv in values]
    if start is None:
        while lines and not lines[-1].strip():
            lines.pop()
        return '\n'.join(lines + ([''] if lines else []) + ['[%s]' % section] + new) + '\n'
    end = next((i for i in range(start + 1, len(lines)) if lines[i].lstrip().startswith('[')), len(lines))
    if replace:
        body = new
    else:
        body, rest = lines[start + 1:end], dict(values)
        for i, line in enumerate(body):
            m = re.match(r'\s*([^=]+?)\s*=', line)
            if m and m.group(1) in rest:
                body[i] = '%s = %s' % (m.group(1), rest.pop(m.group(1)))
        while body and not body[-1].strip():
            body.pop()
        body += ['%s = %s' % (k, v) for k, v in values if k in rest]
    tail = lines[end:]
    return '\n'.join(lines[:start + 1] + body + ([''] if tail else []) + tail) + '\n'


