# O Dolphin abre o painel como game controller do SDL (o gamecontrollerdb):
# o controle de GameCube pelo layout de fight stick, 4 = A, 1 = B, 5 = X,
# 2 = Y, 3 = Z, 6 = R, e a ficha na Coin do Triforce. O L fica no LB, que um
# painel de 6 botoes nao tem.
DOLPHIN_GCPAD = [
    ('Buttons/A', 'Button S'), ('Buttons/B', 'Button W'), ('Buttons/X', 'Button E'), ('Buttons/Y', 'Button N'),
    ('Buttons/Z', 'Shoulder R'), ('Buttons/Start', 'Start'),
    ('Main Stick/Up', 'Pad N'), ('Main Stick/Down', 'Pad S'), ('Main Stick/Left', 'Pad W'),
    ('Main Stick/Right', 'Pad E'),
    ('Triggers/L', 'Shoulder L'), ('Triggers/R', 'Trigger R'), ('Triggers/L-Analog', 'Shoulder L'),
    ('Triggers/R-Analog', 'Trigger R'), ('Triforce/Coin', 'Back'),
]
DOLPHIN_CALIBRATION = ' '.join(['100.00 141.42'] * 4)
DOLPHIN_GC_CONTROLLER = '6'  # SIDEVICE_GC_CONTROLLER


def dolphin_save(players, devices):
    """GCPad1 a GCPad4 no GCPadNew.ini, e no Dolphin.ini a porta de cada
    jogador como controle de GameCube (sem nada nela, a 2 a 4 vem vazia)."""
    gcpad = os.path.join(DOLPHIN_DIR, 'GCPadNew.ini')
    text = read_text(gcpad)
    ports = []
    for player in sorted(p for p in players if p <= 4):
        index = next(iter(players[player].values()))[0]
        if index not in devices:
            continue
        name = devices[index][1].replace(',', ' ')
        # Aparelhos de mesmo nome: 0, 1... na ordem do SDL.
        cid = sum(1 for i in devices if i < index and devices[i][1].replace(',', ' ') == name)
        values = [('Device', 'SDL/%d/%s' % (cid, name))]
        values += [(k, '`%s`' % v) for k, v in DOLPHIN_GCPAD]
        values += [('Main Stick/Calibration', DOLPHIN_CALIBRATION)]
        text = ini_section(text, 'GCPad%d' % player, values, replace=True)
        ports.append(player)
    if not ports:
        return []
    write(gcpad, text, USER_ID)
    main = os.path.join(DOLPHIN_DIR, 'Dolphin.ini')
    text = read_text(main)
    keys = ['SIDevice%d' % (p - 1) for p in ports]
    keys = [k for k in keys if ini_get(text, 'Core', k) in (None, '0')]
    if keys:
        write(main, ini_section(text, 'Core', [(k, DOLPHIN_GC_CONTROLLER) for k in keys]), USER_ID)
    return [gcpad, main]


