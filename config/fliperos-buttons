def sdl_devices():
    """{indice: (guid, nome, botoes, eixos, repouso dos eixos, codigos ABS
    dos eixos ou None)} dos controles ligados; vazio sem o SDL."""
    try:
        lib = sdl()
    except OSError:
        return {}

    class GUID(ctypes.Structure):
        _fields_ = [('data', ctypes.c_uint8 * 16)]
    lib.SDL_JoystickGetDeviceGUID.restype = GUID
    lib.SDL_JoystickGetGUIDString.argtypes = [GUID, ctypes.c_char_p, ctypes.c_int]
    lib.SDL_JoystickNameForIndex.restype = ctypes.c_char_p
    if lib.SDL_Init(0x200) != 0:
        return {}
    out = {}
    try:
        sticks = {i: lib.SDL_JoystickOpen(i) for i in range(lib.SDL_NumJoysticks())}
        # Os eixos so tem o valor de verdade depois da primeira leitura.
        lib.SDL_JoystickUpdate()
        time.sleep(0.05)
        lib.SDL_JoystickUpdate()
        for i, js in sticks.items():
            if not js:
                continue
            buf = ctypes.create_string_buffer(33)
            lib.SDL_JoystickGetGUIDString(lib.SDL_JoystickGetDeviceGUID(i), buf, 33)
            out[i] = (buf.value.decode(), (lib.SDL_JoystickNameForIndex(i) or b'').decode(errors='replace'),
                      lib.SDL_JoystickNumButtons(js), lib.SDL_JoystickNumAxes(js), state(lib, js)[1],
                      abs_codes(lib, i))
    finally:
        lib.SDL_Quit()
    return out


