}
KEYS.update({c: (c.lower(), 4 + i, c, 'SDLK_' + c.lower()) for i, c in enumerate('ABCDEFGHIJKLMNOPQRSTUVWXYZ')})
KEYS.update({str(n): ('num%d' % n, 29 + n, str(n), 'SDLK_%d' % n) for n in range(1, 10)})
# As teclas de atalho padrao do RetroArch nas letras do layout do MAME (o
# Espaco e o botao 3, o F o baixo do jogador 2): sem elas, com o teclado.
RA_HOTKEYS = {'space': 'input_toggle_fast_forward', 'l': 'input_hold_fast_forward', 'f': 'input_toggle_fullscreen',
              'r': 'input_rewind', 'e': 'input_hold_slowmotion', 'k': 'input_frame_advance',
              'i': 'input_netplay_game_watch', 'p': 'input_pause_toggle', 'h': 'input_reset',
              'o': 'input_movie_record_toggle', 'm': 'input_shader_next', 'n': 'input_shader_prev',
              't': 'input_cheat_index_minus', 'y': 'input_cheat_index_plus', 'u': 'input_cheat_toggle'}
# O "controle" do mapa de teclado: indice -1, elemento k:TECLA.
KEYBOARD_INDEX = -1
MAME_AXES = ['XAXIS', 'YAXIS', 'ZAXIS', 'RXAXIS', 'RYAXIS', 'RZAXIS', 'SLIDER1', 'SLIDER2']
MAME_HAT = {'1': 'UP', '2': 'RIGHT', '4': 'DOWN', '8': 'LEFT'}
AXIS_PRESS = 20000
# Um eixo parado perto de uma ponta e um gatilho (xpad: -32768 solto, 32767
# apertado): apertar o leva para a outra ponta, nunca para alem desta.
TRIGGER_REST = 30000


def is_key(element):
    """O elemento e uma tecla (k:TECLA, nome do MAME), nao um do SDL?"""
    return element.startswith('k:')


def mame_code(index, element):
    """O codigo do MAME (joystickprovider sdljoy) de um elemento do SDL."""
    if is_key(element):
        return 'KEYCODE_' + element[2:]
    joy = 'JOYCODE_%d_' % (index + 1)
    if element.startswith('b'):
        return joy + 'BUTTON%d' % (int(element[1:]) + 1)
    if element.startswith('h'):
        hat, direction = element[1:].split('.')
        return joy + 'HAT%d%s' % (int(hat) + 1, MAME_HAT[direction])
    sign, axis = element[0], int(element[2:])
    name = MAME_AXES[axis] if axis < len(MAME_AXES) else MAME_AXES[-1]
    if name == 'XAXIS':
        side = 'LEFT' if sign == '-' else 'RIGHT'
    elif name == 'YAXIS':
        side = 'UP' if sign == '-' else 'DOWN'
    else:
        side = 'NEG' if sign == '-' else 'POS'
    return joy + '%s_%s_SWITCH' % (name, side)


# O lado que o bind nao usa (o botao de um bind por eixo, o eixo de um bind
# por botao). "nul" nao serve: para o RetroArch e "sem bind do usuario", e
# ele usa o do perfil automatico do controle. No Xbox 360 o B (botao 2 de um
# painel assim) e o A do RetroPad, e o botao 2 apertava junto o 5 no MAME
# 2010. Um indice que nao existe nunca e apertado.
# Nas direcoes o "nul" fica: o perfil ali so traz a mesma direcao, e e por
# ele que o direcional anda no driver linuxraw do RetroArch (o /dev/input/js,
# onde o hat do Xbox 360 chega como eixo e o "h0up" nunca e apertado).
RA_NONE_BTN, RA_NONE_AXIS = '99', '+99'
DIRECTIONS = ('up', 'down', 'left', 'right')


def retroarch_lines(player, control, element):
    """Os binds do RetroArch (driver udev) de um controle de um jogador."""
    key = 'input_player%d_%s' % (player, RA_KEYS[control])
    if control in DIRECTIONS:
        none_btn = none_axis = 'nul'
    else:
        none_btn, none_axis = RA_NONE_BTN, RA_NONE_AXIS
    if is_key(element):
        return ['%s = "%s"' % (key, KEYS[element[2:]][0]), '%s_btn = "%s"' % (key, none_btn),
                '%s_axis = "%s"' % (key, none_axis)]
    if element.startswith('b'):
        return ['%s_btn = "%s"' % (key, element[1:]), '%s_axis = "%s"' % (key, none_axis)]
    if element.startswith('h'):
        hat, direction = element[1:].split('.')
        return ['%s_btn = "h%s%s"' % (key, hat, RA_HAT[direction]), '%s_axis = "%s"' % (key, none_axis)]
    return ['%s_axis = "%s%s"' % (key, element[0], element[2:]), '%s_btn = "%s"' % (key, none_btn)]


def retroarch_triggers(player, binds):
    """Os botoes nos gatilhos (um eixo que so vai para um lado, como o LT e o
    RT do Xbox 360): o perfil automatico os poe tambem no L2 e no R2, e cada
    um apertaria dois botoes do RetroPad. L2 e R2 ficam sem nada."""
    if not any(e[0] in '+-' and control.startswith('b') for control, (_, e) in binds.items()):
        return []
    return ['input_player%d_%s_%s = "%s"' % (player, pad, kind, RA_NONE_BTN if kind == 'btn' else RA_NONE_AXIS)
            for pad in ('l2', 'r2') for kind in ('btn', 'axis')]


def read_map(path):
    """{jogador: {controle: (indice, elemento)}} e {indice: nome}."""
    players, names = {}, {}
    with open(path, encoding='utf-8') as f:
        for line in f:
            parts = line.split(None, 4)
            if len(parts) < 4 or parts[1] not in CONTROLS:
                continue
            player, control, index, element = int(parts[0]), parts[1], int(parts[2]), parts[3]
            players.setdefault(player, {})[control] = (index, element)
            names[index] = parts[4].strip() if len(parts) > 4 else ''
    return players, names


def map_text(players, names):
    """O mapa de volta no formato do arquivo."""
    lines = []
    for player in sorted(players):
        binds = players[player]
        for control in CONTROLS:
            if control in binds:
                index, element = binds[control]
                lines.append('%d %s %d %s %s\n' % (player, control, index, element, names.get(index, '')))
    return ''.join(lines)


def fix_triggers(players, devices):
    """O sentido de cada meio eixo pelo repouso do controle agora: num eixo
    que repousa em -32768 (gatilho) so existe "+". Um "-a5" ali vinha de uma
    captura que comecou com o gatilho apertado e pegou a soltura, e o botao
    ficava apertado no repouso em todo emulador. Devolve quantos mudaram."""
    fixed = 0
    for binds in players.values():
        for control, (index, element) in list(binds.items()):
            if element[0] not in '+-' or index not in devices:
                continue
            rests, axis = devices[index][4], int(element[2:])
            rest = rests[axis] if axis < len(rests) else 0
            sign = '+' if rest <= -TRIGGER_REST else '-' if rest >= TRIGGER_REST else element[0]
            if sign != element[0]:
                binds[control] = (index, sign + element[1:])
                fixed += 1
    return fixed


def retroarch_cfg(players, names):
    lines = ['# Gerado pelo Setup > Joysticks > Button mapping (fliperos-buttons): os botoes',
             '# de cada jogador, por cima do perfil automatico do controle. O fliperos-kms-run',
             '# soma este arquivo a config (--appendconfig).']
    for player in sorted(players):
        binds = players[player]
        index = next(iter(binds.values()))[0]
        lines += ['', '# Jogador %d: %s' % (player, names.get(index, ''))]
        if index >= 0:
            lines.append('input_player%d_joypad_index = "%d"' % (player, index))
        for control in CONTROLS:
            if control in binds:
                lines += retroarch_lines(player, control, binds[control][1])
        lines += retroarch_triggers(player, binds)
    # As teclas de atalho do RetroArch que caem nas teclas do mapa.
    used = {KEYS[e[2:]][0] for binds in players.values() for _, e in binds.values() if is_key(e)}
    hotkeys = sorted(RA_HOTKEYS[k] for k in used if k in RA_HOTKEYS)
    if hotkeys:
        lines += ['', '# Atalhos do RetroArch nas teclas do painel: desligados.']
        lines += ['%s = "nul"' % h for h in hotkeys]
    return '\n'.join(lines) + '\n'


def read_layouts(path):
    """{botoes: [posicao no painel do botao 1, do 2...]} do buttons.layout,
    sem as linhas invalidas e sem as que deixam cada botao na sua posicao."""
    layouts = {}
    try:
        with open(path, encoding='utf-8') as f:
            rows = [line.split() for line in f]
    except OSError:
        return layouts
    for row in rows:
        if not row or not all(v.isdigit() for v in row):
            continue
        count, order = int(row[0]), [int(v) for v in row[1:]]
        if (count in LAYOUT_COUNTS and len(order) == count and len(set(order)) == count
                and all(1 <= v <= PANEL_BUTTONS for v in order) and order != list(range(1, count + 1))):
            layouts[count] = order
    return layouts


def layout_order(layouts, count):
    """A posicao no painel de cada um dos 6 botoes de um jogo de `count`
    botoes: os do layout, e os que o jogo nao tem nas posicoes que sobram."""
    order = list(layouts.get(count, []))
    return order + [p for p in range(1, PANEL_BUTTONS + 1) if p not in order]


def read_games(path):
    """{set: (botoes, pai)} da tabela do fliperos-romclean buttons."""
    games = {}
    try:
        with open(path, encoding='utf-8') as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 2 and parts[1].isdigit():
                    games[parts[0]] = (int(parts[1]), parts[2] if len(parts) > 2 else '')
    except OSError:
        pass
    return games


def layout_games(layouts, games):
    """[(set, [posicao do botao 1, do 2...])] dos jogos que saem do padrao,
    os pais antes dos clones. O MAME aplica ao clone o <system> do pai: o
    clone so entra se o dele for outro (outro numero de botoes)."""
    def wanted(count, upto):
        return layout_order(layouts, count)[:upto]

    parents, clones = [], []
    for name in sorted(games):
        count, parent = games[name]
        if parent in games:
            upto = min(max(count, games[parent][0]), PANEL_BUTTONS)
            # O <system> do pai so tem os botoes do pai: os outros ficam no padrao.
            inherited = layouts.get(games[parent][0], [])
            inherited = inherited + list(range(len(inherited) + 1, upto + 1))
            if wanted(count, upto) != inherited:
                clones.append((name, wanted(count, upto)))
        elif count in layouts:
            parents.append((name, wanted(count, count)))
    return parents + clones


def mame_port(player, control, bind):
    seq = mame_code(*bind)
    key = MAME_KEYS.get(player, {}).get(control)
    # A tecla padrao junto so com controle. Com o teclado ela e a de outro
    # comando quando o Buttons layout troca os botoes de lugar (o botao 1
    # do jogo no X: o Ctrl esquerdo apertaria dois).
    if key and not is_key(bind[1]):
        seq += ' OR KEYCODE_%s' % key
    return ('            <port type="%s">\n                <newseq type="standard">%s</newseq>\n'
            '            </port>\n' % (MAME_PORTS[control] % player, seq))


def mame_cfg(players, names, layouts=None, games=None):
    ports = []
    for player in sorted(players):
        for control in CONTROLS:
            if control in players[player]:
                ports.append(mame_port(player, control, players[player][control]))
    systems = []
    # Buttons layout: o botao N do jogo na posicao do painel escolhida.
    for name, order in layout_games(layouts or {}, games or {}):
        entry = []
        for player in sorted(players):
            for n, position in enumerate(order, 1):
                if 'b%d' % position in players[player]:
                    entry.append(mame_port(player, 'b%d' % n, players[player]['b%d' % position]))
                else:
                    # A posicao que o jogador nao tem (um painel de menos
                    # botoes, o 6 do teclado do jogador 2): o botao fica sem
                    # nada. Sem a linha valeria o padrao, que pode ser o
                    # comando posto noutro botao deste jogo.
                    entry.append('            <port type="%s">\n                <newseq type="standard">NONE'
                                 '</newseq>\n            </port>\n' % (MAME_PORTS['b%d' % n] % player))
        if entry:
            systems.append('    <system name="%s">\n        <input>\n%s        </input>\n    </system>\n'
                           % (escape(name), ''.join(entry)))
    devices = ''.join('<!-- JOYCODE_%d: %s -->\n' % (i + 1, escape(n)) for i, n in sorted(names.items()))
    return ('<?xml version="1.0"?>\n<!-- Gerado pelo Setup > Joysticks > Button mapping (fliperos-buttons). -->\n'
            + devices + '<mameconfig version="10">\n    <system name="default">\n        <input>\n'
            + ''.join(ports) + '        </input>\n    </system>\n' + ''.join(systems) + '</mameconfig>\n')


def retroarch_layout_cfg(players, count, order):
    """O buttons-BOTOES.cfg: os binds dos 6 botoes de cada jogador com o
    botao N do jogo na posicao do painel escolhida, por cima do buttons.cfg."""
    lines = ['# Gerado pelo Setup > Joysticks > Buttons layout (fliperos-buttons): os jogos de',
             '# %d botoes nos cores MAME. O fliperos-kms-run soma este arquivo depois do' % count,
             '# buttons.cfg.']
    for player in sorted(players):
        binds = players[player]
        lines.append('')
        for n, position in enumerate(order, 1):
            if 'b%d' % position in binds:
                lines += retroarch_lines(player, 'b%d' % n, binds['b%d' % position][1])
            else:
                key = 'input_player%d_%s' % (player, RA_KEYS['b%d' % n])
                lines += ['%s_btn = "%s"' % (key, RA_NONE_BTN), '%s_axis = "%s"' % (key, RA_NONE_AXIS)]
    return '\n'.join(lines) + '\n'


def write(path, text, owner=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + '.new', 'w', encoding='utf-8') as f:
        f.write(text)
    os.chmod(path + '.new', 0o644)
    os.replace(path + '.new', path)
    if owner is not None:
        try:
            os.chown(os.path.dirname(path), owner, owner)
            os.chown(path, owner, owner)
        except OSError:
            pass


def write_bytes(path, data, owner=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + '.new', 'wb') as f:
        f.write(data)
    os.chmod(path + '.new', 0o644)
    os.replace(path + '.new', path)
    if owner is not None:
        try:
            os.chown(path, owner, owner)
        except OSError:
            pass


# ── SDL game controller ─────────────────────────────────────────

# O painel como fight stick: X Y RB em cima, A B RT embaixo; a ficha e o Back.
# A notacao dos elementos (b3, -a1, h0.1) e a do proprio mapeamento do SDL.
SDL_SLOTS = {'up': 'dpup', 'down': 'dpdown', 'left': 'dpleft', 'right': 'dpright', 'b1': 'x', 'b2': 'y',
             'b3': 'rightshoulder', 'b4': 'a', 'b5': 'b', 'b6': 'righttrigger', 'start': 'start', 'coin': 'back'}


def sdl_mapping_line(guid, name, binds, slots=None):
    slots = slots or SDL_SLOTS
    fields = ['%s:%s' % (slots[c], e) for c, (_, e) in sorted(binds.items()) if c in slots]
    return ','.join([guid, name.replace(',', ' ')] + sorted(fields) + ['platform:Linux']) + ','


def sdl_user_db(players, devices):
    """As linhas do gamecontrollerdb-user.txt: um aparelho (GUID) por linha,
    pelo primeiro jogador que o usa (dois paineis iguais tem o mesmo GUID)."""
    lines = {}
    for player in sorted(players):
        binds = players[player]
        index = next(iter(binds.values()))[0]
        if index in devices and devices[index][0] not in lines:
            guid, name = devices[index][:2]
            lines[guid] = sdl_mapping_line(guid, name, binds)
    return lines


# ── SM2-Emu (Model 2) ───────────────────────────────────────────

# O SM2-Emu le o game controller do SDL: os botoes 1 a 4 do jogo em A B X Y
# (os pad*_button_* padrao do sm2-emu.ini), Start e a ficha no Back. No
# layout de fight stick dos outros emuladores o botao 1 do jogo caia na
# linha de baixo, e o RB (o 3 do painel) e sempre o botao 4 dele: o Model 2
# ganha um mapeamento proprio, com o botao N do jogo na posicao do painel
# do layout (sem layout, na posicao N).
MODEL2_SLOTS = {'up': 'dpup', 'down': 'dpdown', 'left': 'dpleft', 'right': 'dpright', 'b1': 'a', 'b2': 'b',
                'b3': 'x', 'b4': 'y', 'start': 'start', 'coin': 'back'}
MODEL2_BUTTONS = 4


def model2_db(players, devices, order):
    """As linhas do mapeamento do Model 2, um aparelho (GUID) por linha."""
    lines = {}
    for player in sorted(players):
        binds = players[player]
        index = next(iter(binds.values()))[0]
        if index not in devices or devices[index][0] in lines:
            continue
        guid, name = devices[index][:2]
        game = {c: b for c, b in binds.items() if not c.startswith('b')}
        for n, position in enumerate(order[:MODEL2_BUTTONS], 1):
            if 'b%d' % position in binds:
                game['b%d' % n] = binds['b%d' % position]
        lines[guid] = sdl_mapping_line(guid, name, game, MODEL2_SLOTS)
    return lines


def model2_save(players, devices, layouts):
    """O gamecontrollerdb-model2.txt e o de cada numero de botoes com layout."""
    paths = []
    for count in [0] + list(range(1, MODEL2_BUTTONS + 1)):
        path = MODEL2_DB if not count else '%s-%d.txt' % (os.path.splitext(MODEL2_DB)[0], count)
        if count and count not in layouts:
            if os.path.isfile(path):
                os.remove(path)
            continue
        lines = model2_db(players, devices, layout_order(layouts, count))
        write(path, ''.join(line + '\n' for line in lines.values()))
        paths.append(path)
    return paths


# ── Flycast ─────────────────────────────────────────────────────

# Dreamcast pelo layout do SDL (como o fliperos-controllers); arcade (Naomi,
# Atomiswave) com o botao N do painel no botao N do jogo e a ficha no D.
FLYCAST_DC = {'up': 'btn_dpad1_up', 'down': 'btn_dpad1_down', 'left': 'btn_dpad1_left', 'right': 'btn_dpad1_right',
              'b1': 'btn_x', 'b2': 'btn_y', 'b3': 'btn_c', 'b4': 'btn_a', 'b5': 'btn_b', 'b6': 'btn_trigger_right',
              'start': 'btn_start', 'coin': 'btn_menu'}
FLYCAST_ARCADE = dict(FLYCAST_DC, b1='btn_a', b2='btn_b', b3='btn_c', b4='btn_x', b5='btn_y', b6='btn_z',
                      coin='btn_d')


# O hat no Flycast e um botao: (hat + 1) << 8, mais 0 cima, 1 baixo, 2
# esquerda, 3 direita (core/sdl/sdl.cpp, SDL_JOYHATMOTION).
FLYCAST_HAT = {'1': 0, '4': 1, '8': 2, '2': 3}


def flycast_cfg(name, binds, keys, rests=()):
    """O mapeamento do Flycast; rests e o repouso dos eixos do aparelho: um
    gatilho vai em "triggers" (o Flycast o le de ponta a ponta, sempre "+";
    com ~ quando repousa em cima), senao ele o trata como eixo de centro."""
    digital, analog, triggers = [], [], []
    for control, (_, element) in sorted(binds.items()):
        key = keys.get(control)
        if is_key(element):
            digital.append('%d:%s' % (KEYS[element[2:]][1], key))
        elif element.startswith('b'):
            digital.append('%s:%s' % (element[1:], key))
        elif element.startswith('h'):
            hat, bit = element[1:].split('.')
            digital.append('%d:%s' % (((int(hat) + 1) << 8) | FLYCAST_HAT[bit], key))
        elif element[0] in '+-':
            axis = int(element[2:])
            rest = rests[axis] if axis < len(rests) else 0
            if abs(rest) >= TRIGGER_REST:
                analog.append('%d+:%s' % (axis, key))
                trigger = '%d%s' % (axis, '~' if rest > 0 else '')
                if trigger not in triggers:
                    triggers.append(trigger)
            else:
                analog.append('%s%s:%s' % (element[2:], element[0], key))
    # O mapa do teclado substitui o padrao do Flycast, e com ele ia o Tab do
    # menu (o unico jeito de chegar nele num jogo de arcade). Volta, se o
    # painel nao usa o Tab.
    if any(is_key(element) for _, element in binds.values()) and not any(b.startswith('43:') for b in digital):
        digital.append('43:btn_menu')
    text = '[analog]\n' + ''.join('bind%d = %s\n' % (i, b) for i, b in enumerate(analog))
    text += '\n[digital]\n' + ''.join('bind%d = %s\n' % (i, b) for i, b in enumerate(digital))
    text += ('\n[emulator]\ndead_zone = 10\nmapping_name = %s\nrumble_power = 100\nsaturation = 100\n'
             'triggers = %s\nversion = 4\n' % (name, ','.join(triggers)))
    return text


# ── Attract-Mode Plus ───────────────────────────────────────────

# O Attract-Mode le o controle pelo SFML (/dev/input/js*), na mesma ordem
# do SDL (os dois enumeram pelo udev): JoyN e o controle N do mapa, os
# botoes na ordem do joydev, que e a do SDL. Os eixos tem nome (SFML): o do
# eixo N do SDL vem do codigo ABS_* do evdev (o SDL numera todos menos os
# hats).
AM_AXES = {0: ('Left', 'Right'), 1: ('Up', 'Down'), 2: ('Zneg', 'Zpos'), 6: ('Zneg', 'Zpos'),
           5: ('Rneg', 'Rpos'), 7: ('Rneg', 'Rpos'), 3: ('Uneg', 'Upos'), 4: ('Vneg', 'Vpos')}
# O SFML so tem um hat (PovX/PovY); cima e o PovY negativo, como no evdev.
AM_HAT = {'1': 'PovYneg', '2': 'PovXpos', '4': 'PovYpos', '8': 'PovXneg'}
# Os comandos do frontend: direcional, botao 1 seleciona, 2 volta (todo
# jogador); os atalhos padrao do Attract-Mode (FeInputMap) no jogador 1.
AM_MOVES = {'up': 'up', 'down': 'down', 'left': 'left', 'right': 'right', 'b1': 'select', 'b2': 'back'}
AM_COMBOS = [('prev_letter', ('up', 'b1')), ('next_letter', ('down', 'b1')), ('filters_menu', ('left', 'b1')),
             ('next_filter', ('right', 'b1')), ('configure', ('up', 'b2')), ('edit_game', ('down', 'b2')),
             ('add_favourite', ('b1', 'b2'))]
AM_SECTION = 'input_map'
# O teclado que o Attract-Mode poe sozinho (FeInputMap::initialize_mappings):
# o dos comandos de tela so quando o comando nao tem nenhuma entrada, os
# atalhos so com o input_map vazio. Com o joystick gravado antes do primeiro
# save dele, nenhum dos dois entrava e o teclado ficava sem funcionar.
AM_KEYS_UI = [('back', 'Escape'), ('up', 'Up'), ('down', 'Down'), ('left', 'Left'), ('right', 'Right'),
              ('select', 'Return'), ('select', 'LControl')]
AM_KEYS_SHORTCUTS = [('configure', 'Tab'), ('prev_letter', 'Up+LControl'), ('next_letter', 'Down+LControl'),
                     ('filters_menu', 'Left+LControl'), ('next_filter', 'Right+LControl'),
                     ('configure', 'Escape+Up'), ('edit_game', 'Escape+Down'), ('add_favourite', 'Escape+LControl')]


def abs_codes(lib, index):
    """Os codigos ABS_* dos eixos do controle INDICE, na ordem do SDL; None
    sem o caminho dele (SDL antes do 2.24)."""
    try:
        path_for = lib.SDL_JoystickPathForIndex
    except AttributeError:
        return None
    path_for.restype = ctypes.c_char_p
    path_for.argtypes = [ctypes.c_int]
    node = os.path.basename((path_for(index) or b'').decode())
    try:
        with open('/sys/class/input/%s/device/capabilities/abs' % node) as f:
            words = f.read().split()
    except OSError:
        return None
    bits = 0
    for word in words:
        bits = (bits << 64) | int(word, 16)
    return [c for c in range(0x3f) if bits >> c & 1 and not 0x10 <= c <= 0x17]


def attract_code(index, element, codes):
    """O nome do Attract-Mode ("Joy0 Button3", "Joy1 PovYneg") de um elemento
    do SDL; None se ele nao tem (teclado, segundo hat, eixo sem nome)."""
    if is_key(element) or index < 0:
        return None
    if element.startswith('b'):
        return 'Joy%d Button%s' % (index, element[1:])
    if element.startswith('h'):
        hat, bit = element[1:].split('.')
        return 'Joy%d %s' % (index, AM_HAT[bit]) if hat == '0' and bit in AM_HAT else None
    axis = int(element[2:])
    codes = codes if codes is not None else list(range(8))
    if axis >= len(codes) or codes[axis] not in AM_AXES:
        return None
    return 'Joy%d %s' % (index, AM_AXES[codes[axis]][element[0] == '+'])


def attract_inputs(players, devices):
    """As linhas (comando, entrada) de joystick do input_map."""
    lines = []
    first = True
    for player in sorted(players):
        binds = players[player]
        index = next(iter(binds.values()))[0]
        codes = devices[index][5] if index in devices else None
        names = {c: attract_code(i, e, codes) for c, (i, e) in binds.items()}
        lines += [(AM_MOVES[c], names[c]) for c in CONTROLS if c in AM_MOVES and names.get(c)]
        # Direcional num hat: o analogico do controle (o padrao do
        # Attract-Mode) continua andando pelo menu.
        if codes is None or {0, 1} <= set(codes):
            lines += [(c, 'Joy%d %s' % (index, c.capitalize())) for c in ('up', 'down', 'left', 'right')
                      if names.get(c) and binds[c][1].startswith('h')]
        if first and any(names.values()):
            first = False
            lines += [(cmd, '+'.join(names[c] for c in combo)) for cmd, combo in AM_COMBOS
                      if all(names.get(c) for c in combo)]
    return lines


def attract_cfg(text, inputs):
    """O attract.cfg com o joystick do input_map trocado: saem as entradas de
    joystick dos comandos acima (o controle novo no lugar do antigo) e as de
    outro comando que usam um botao deles; as de teclado e as outras ficam."""
    managed = {cmd for cmd, _ in inputs}
    used = {part for _, value in inputs for part in value.split('+')}
    # O teclado que a secao tem; o que falta volta (ver AM_KEYS_UI).
    keyed, section = set(), False
    for line in text.splitlines():
        stripped = line.strip()
        if stripped and not line[:1].isspace():
            section = stripped == AM_SECTION
        elif section and stripped:
            command, _, value = stripped.partition(' ')
            if command != 'default' and not any(p.strip().startswith('Joy') for p in value.split('+')):
                keyed.add(command)
    missing = [(c, k) for c, k in AM_KEYS_UI if c not in keyed]
    if not keyed:
        missing += AM_KEYS_SHORTCUTS
    entries = ['    %-24s%s\n' % (cmd, value) for cmd, value in missing + inputs]
    out, inside = [], False

    def flush():
        # As entradas novas no fim da secao, antes dos "default".
        out.extend(entries)
        entries.clear()

    for line in text.splitlines(keepends=True):
        stripped = line.strip()
        if stripped and not line[:1].isspace():
            if inside:
                flush()
            inside = stripped == AM_SECTION
        elif inside and not stripped:
            flush()
        elif inside:
            command, _, value = stripped.partition(' ')
            if command == 'default':
                flush()
            else:
                parts = [p.strip() for p in value.split('+')]
                if any(p.startswith('Joy') for p in parts) and (command in managed or used.intersection(parts)):
                    continue
        out.append(line)
    if inside:
        flush()
    return ''.join(out)


def attract_path():
    base = os.environ.get('FLIPEROS_ATTRACT_DIR', '/home/fliperos/.attract')
    for path in (os.path.join(base, 'config', 'attract.cfg'), os.path.join(base, 'attract.cfg')):
        if os.path.isfile(path):
            return path
    return None


def attract_save(players, devices):
    """Grava o joystick no attract.cfg (so se ele existe: antes da primeira
    execucao o Attract-Mode ainda nao o criou, e o --session-start do Setup
    chama de novo). Devolve o caminho, ou None."""
    path = attract_path()
    inputs = attract_inputs(players, devices)
    if not path or not inputs:
        return None
    with open(path, encoding='utf-8', errors='replace') as f:
        text = f.read()
    if AM_SECTION not in text.split():
        return None
    new = attract_cfg(text, inputs)
    if new != text:
        write(path, new, USER_ID)
    return path


