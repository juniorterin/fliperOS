# O fork nao espelha o [Pad1]: os botoes dos jogos de arcade vem da secao
# [JVS] do PCSX2.ini, uma chave por botao, e sem ela o jogo nao recebe nada.
# O pcsx2x6-jvs-bindings (tools/pcsx2x6-jvs-bindings.py) diz o que cada chave
# e: um papel do SDL (direcional, Start, ficha) ou "button:C:N", o botao N de
# um jogo de C botoes. Esse cai na posicao do painel que o Buttons layout dita
# (sem layout, a posicao N), e a posicao no papel do layout de fight stick do
# SDL_SLOTS (X Y RB em cima, A B RT embaixo) como o PCSX2 oficial o ve.
PCSX2X6_INI = os.environ.get('FLIPEROS_PCSX2X6_INI', '/home/fliperos/.config/PCSX2x6/inis/PCSX2.ini')
PCSX2X6_BINDINGS = os.environ.get('FLIPEROS_PCSX2X6_BINDINGS', '/etc/fliperos/pcsx2x6-jvs-bindings')
PCSX2X6_PANEL = {1: 'FaceWest', 2: 'FaceNorth', 3: 'RightShoulder', 4: 'FaceSouth', 5: 'FaceEast',
                 6: '+RightTrigger'}
PCSX2X6_CONTROLS = {'DPadUp': 'up', 'DPadDown': 'down', 'DPadLeft': 'left', 'DPadRight': 'right',
                    'Start': 'start', 'Back': 'coin'}
# Os jogos de 4 botoes da Namco (Tekken, Soul Calibur, Bloody Roar...) sao 2x2
# no gabinete: 1 2 em cima, 3 4 embaixo. Vale so no PCSX2x6 e so sem uma linha
# de 4 botoes no Buttons layout (essa e a escolha da pessoa para todos).
PCSX2X6_LAYOUTS = {4: [1, 2, 4, 5]}


def pcsx2x6_table(path=None):
    """[(chave, jogador, papel ou button:C:N)] do pcsx2x6-jvs-bindings."""
    rows = []
    for line in read_text(path or PCSX2X6_BINDINGS).splitlines():
        parts = line.split('\t')
        if len(parts) == 3 and not line.startswith('#') and parts[1].isdigit():
            rows.append((parts[0], int(parts[1]), parts[2]))
    return rows


def pcsx2x6_values(players, devices, layouts, table):
    """[(chave, "SDL-N/Papel")] do [JVS]: o aparelho de cada jogador no
    Button mapping (o indice do SDL), e so o que o painel dele tem."""
    values = []
    for key, player, kind in table:
        binds = players.get(player)
        if not binds:
            continue
        index = next(iter(binds.values()))[0]
        if index not in devices:
            continue
        if kind.startswith('button:'):
            count, n = (int(v) for v in kind.split(':')[1:])
            position = layout_order({**PCSX2X6_LAYOUTS, **layouts}, count)[n - 1] if n <= PANEL_BUTTONS else 0
            if position not in PCSX2X6_PANEL or 'b%d' % position not in binds:
                continue
            role = PCSX2X6_PANEL[position]
        elif PCSX2X6_CONTROLS.get(kind) in binds:
            role = kind
        else:
            continue
        values.append((key, 'SDL-%d/%s' % (index, role)))
    return values


def pcsx2x6_save(players, devices, layouts):
    """A secao [JVS] do PCSX2.ini do PCSX2x6, se ele ja abriu uma vez (sem o
    ini, o fliperos-x11-run o cria e grava a secao). Os outros ajustes do ini
    ficam; o que a pessoa mudou nas chaves de [JVS] volta ao Button mapping."""
    text = read_text(PCSX2X6_INI)
    values = pcsx2x6_values(players, devices, layouts, pcsx2x6_table()) if text else []
    if not values:
        return []
    write(PCSX2X6_INI, ini_section(text, 'JVS', values), USER_ID)
    os.chmod(PCSX2X6_INI, 0o600)
    return [PCSX2X6_INI]


