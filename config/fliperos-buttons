# ── SDL: o proximo comando ──────────────────────────────────────

# Sem isto o SDL_Init troca o SIGTERM e o SIGINT por um SDL_QUIT que ninguem
# le: o watch do painel web nao saia no SIGTERM, e o desligar esperava os 90 s
# do systemd ate o SIGKILL. Vale para todo SDL_Init deste programa.
os.environ['SDL_NO_SIGNAL_HANDLERS'] = '1'
# Sem o HIDAPI do SDL: como root (o Setup, o fliperos-controllers) ele abre
# um controle Nintendo ou PlayStation pelo /dev/hidraw, com outro nome, outro
# GUID (o barramento USB, mesmo pelo Bluetooth) e no comeco da lista; os
# emuladores, como o usuario, nao leem o hidraw (so do root) e o veem pelo
# evdev, no fim. O mapa tem de ter os indices e os GUIDs que eles veem: o
# GameCube Nyxi do gabinete virava o controle 0 "com fio" (2026-11-09).
os.environ['SDL_JOYSTICK_HIDAPI'] = '0'


def sdl():
    lib = ctypes.CDLL(ctypes.util.find_library('SDL2') or 'libSDL2-2.0.so.0')
    lib.SDL_JoystickOpen.restype = ctypes.c_void_p
    lib.SDL_JoystickName.restype = ctypes.c_char_p
    for f in ('SDL_JoystickNumButtons', 'SDL_JoystickNumAxes', 'SDL_JoystickNumHats', 'SDL_JoystickName'):
        getattr(lib, f).argtypes = [ctypes.c_void_p]
    lib.SDL_JoystickGetButton.argtypes = [ctypes.c_void_p, ctypes.c_int]
    lib.SDL_JoystickGetAxis.argtypes = [ctypes.c_void_p, ctypes.c_int]
    lib.SDL_JoystickGetAxis.restype = ctypes.c_int16
    lib.SDL_JoystickGetHat.argtypes = [ctypes.c_void_p, ctypes.c_int]
    lib.SDL_JoystickGetHat.restype = ctypes.c_uint8
    return lib


def state(lib, js):
    return ([lib.SDL_JoystickGetButton(js, i) for i in range(lib.SDL_JoystickNumButtons(js))],
            [lib.SDL_JoystickGetAxis(js, i) for i in range(lib.SDL_JoystickNumAxes(js))],
            [lib.SDL_JoystickGetHat(js, i) for i in range(lib.SDL_JoystickNumHats(js))])


def pressed(rest, now):
    """O primeiro elemento apertado em relacao ao repouso, ou None."""
    for i, (r, n) in enumerate(zip(rest[0], now[0])):
        if n and not r:
            return 'b%d' % i
    for i, (r, n) in enumerate(zip(rest[1], now[1])):
        if n - r > AXIS_PRESS:
            return '+a%d' % i
        if r - n > AXIS_PRESS and not released_trigger(r, n):
            return '-a%d' % i
    for i, (r, n) in enumerate(zip(rest[2], now[2])):
        if n and n != r:
            for bit in (1, 2, 4, 8):
                if n & bit:
                    return 'h%d.%d' % (i, bit)
    return None


def released_trigger(rest, now):
    """Um gatilho que estava apertado quando a captura comecou e foi solto
    agora (de cima para -32768, onde ele repousa): nao e um comando."""
    return rest > AXIS_PRESS and now <= -TRIGGER_REST


def settle(rest, now):
    """O repouso depois que o que estava apertado no comeco foi solto: o botao
    solto, o eixo que voltou ao centro (um gatilho em -32768 nao volta e
    continua repouso), o gatilho solto e o hat solto passam a valer de novo."""
    buttons = [min(r, n) for r, n in zip(rest[0], now[0])]
    axes = [n if (abs(r) > AXIS_PRESS and abs(n) < 8000) or released_trigger(r, n) else r
            for r, n in zip(rest[1], now[1])]
    hats = [0 if r and not n else r for r, n in zip(rest[2], now[2])]
    return buttons, axes, hats


def cmd_capture(args):
    for var in ('SDL_GAMECONTROLLERCONFIG', 'SDL_GAMECONTROLLERCONFIG_FILE'):
        os.environ.pop(var, None)
    lib = sdl()
    if lib.SDL_Init(0x200) != 0:  # JOYSTICK
        sys.exit('SDL: no joystick')
    try:
        sticks = [lib.SDL_JoystickOpen(i) for i in range(lib.SDL_NumJoysticks())]
        lib.SDL_JoystickUpdate()
        time.sleep(0.05)
        lib.SDL_JoystickUpdate()
        # O repouso de cada controle: o que estiver apertado agora (o comando
        # anterior ainda segurado, um gatilho em -32768) nao conta.
        rest = [state(lib, js) if js else None for js in sticks]
        deadline = time.monotonic() + args.timeout
        while time.monotonic() < deadline:
            # O Esc da tela do Button mapping (a interface grafica cria o arquivo).
            if args.cancel and os.path.exists(args.cancel):
                return 3
            lib.SDL_JoystickUpdate()
            for index, js in enumerate(sticks):
                if not js or args.device >= 0 and index != args.device:
                    continue
                now = state(lib, js)
                element = pressed(rest[index], now)
                if element:
                    if args.hold and hold_skips(lib, js, element, args.hold):
                        return 2
                    name = (lib.SDL_JoystickName(js) or b'').decode(errors='replace')
                    print('%d %s %s' % (index, element, name))
                    return 0
                rest[index] = settle(rest[index], now)
            time.sleep(0.005)
        return 1
    finally:
        lib.SDL_Quit()


def hold_skips(lib, js, element, hold):
    """Como no mapeador do Batocera ("hold any button to skip"): o comando
    vale quando o elemento e solto; segurado por `hold` segundos, ele pula o
    comando da vez (True)."""
    since = time.monotonic()
    while time.monotonic() - since < hold:
        lib.SDL_JoystickUpdate()
        if not held(element, state(lib, js)):
            return False
        time.sleep(0.005)
    return True


# ── identify: o controle que o SDL conhece ──────────────────────

# O tipo do controle (SDL_GameControllerType) e o desenho dos botoes: as
# letras do Xbox, os simbolos do PlayStation ou as letras da Nintendo (A no
# leste). O resto, os nomes de posicao (sul, leste...), como no Batocera.
SDL_TYPES = {1: 'xbox', 2: 'xbox', 3: 'playstation', 4: 'playstation', 5: 'nintendo', 7: 'playstation',
             8: 'xbox', 9: 'xbox', 10: 'xbox', 11: 'nintendo', 12: 'nintendo', 13: 'nintendo'}
NAME_TYPES = [(r'xbox|x-box|xinput|8bitdo.*ultimate', 'xbox'),
              (r'playstation|dualshock|dualsense|sony|ps[2345]\b', 'playstation'),
              (r'nintendo|switch|joy-con|pro controller|snes|nes\b', 'nintendo')]


def pad_type(sdl_type, name):
    """xbox, playstation, nintendo ou generic: pelo SDL ou, sem ele, pelo nome."""
    if sdl_type in SDL_TYPES:
        return SDL_TYPES[sdl_type]
    for pattern, kind in NAME_TYPES:
        if re.search(pattern, name or '', re.I):
            return kind
    return 'generic'


def mapping_binds(mapping):
    """{controle do mapa: elemento} de um mapeamento do SDL ("a:b0,lefty:a1"),
    no joypad (o inverso do SDL_PAD_SLOTS): o gatilho num eixo inteiro vira
    "+a2", o analogico o sentido de cima ou da esquerda ("lefty:a1~" e +a1)."""
    slots = {v: k for k, v in SDL_PAD_SLOTS.items()}
    sticks = {v: k for k, v in SDL_STICKS.items()}
    out = {}
    for field in (mapping or '').split(',')[2:]:
        key, _, value = field.partition(':')
        if key in sticks:
            m = re.fullmatch(r'a(\d+)(~?)', value)
            if m:
                out[sticks[key]] = ('+' if m.group(2) else '-') + 'a' + m.group(1)
        elif key in slots:
            m = re.fullmatch(r'a(\d+)~?', value)
            if m:
                value = '+a' + m.group(1)
            if re.fullmatch(r'b\d+|h\d+\.[1248]|[+-]a\d+', value):
                out[slots[key]] = value
    return out


def cmd_identify(args):
    """O controle INDICE (a numeracao do SDL da captura): name=, guid=,
    type= (xbox, playstation, nintendo, generic), known= (1: o banco do SDL
    tem o mapeamento dele, que vem em mapping= e, no formato do mapa, em
    linhas "bind CONTROLE ELEMENTO"). Como o EmulationStation acha um
    controle conhecido; o mapeamento gerado pelo fliperos-controllers nao
    conta (sem os arquivos dele)."""
    for var in ('SDL_GAMECONTROLLERCONFIG', 'SDL_GAMECONTROLLERCONFIG_FILE'):
        os.environ.pop(var, None)
    # As letras A B X Y pela posicao, nao pelo rotulo (Nintendo: A no leste).
    os.environ['SDL_GAMECONTROLLER_USE_BUTTON_LABELS'] = '0'
    lib = sdl()

    class GUID(ctypes.Structure):
        _fields_ = [('data', ctypes.c_uint8 * 16)]
    lib.SDL_JoystickGetDeviceGUID.restype = GUID
    lib.SDL_JoystickGetGUIDString.argtypes = [GUID, ctypes.c_char_p, ctypes.c_int]
    lib.SDL_JoystickNameForIndex.restype = ctypes.c_char_p
    lib.SDL_GameControllerMappingForDeviceIndex.restype = ctypes.c_void_p
    lib.SDL_free.argtypes = [ctypes.c_void_p]
    if lib.SDL_Init(0x200 | 0x2000) != 0:  # JOYSTICK | GAMECONTROLLER
        sys.exit('SDL: no joystick')
    try:
        if not 0 <= args.index < lib.SDL_NumJoysticks():
            return 1
        buf = ctypes.create_string_buffer(33)
        lib.SDL_JoystickGetGUIDString(lib.SDL_JoystickGetDeviceGUID(args.index), buf, 33)
        name = (lib.SDL_JoystickNameForIndex(args.index) or b'').decode(errors='replace')
        mapping = ''
        if lib.SDL_IsGameController(args.index):
            p = lib.SDL_GameControllerMappingForDeviceIndex(args.index)
            if p:
                mapping = ctypes.string_at(p).decode(errors='replace')
                lib.SDL_free(p)
        try:
            sdl_type = lib.SDL_GameControllerTypeForIndex(args.index)
        except AttributeError:
            sdl_type = 0
    finally:
        lib.SDL_Quit()
    # Do banco do SDL (tem "platform:"), como no fliperos-controllers; o
    # automatico do SDL nao e um controle conhecido.
    known = 'platform:' in mapping
    print('name=%s' % name)
    print('guid=%s' % buf.value.decode())
    print('type=%s' % pad_type(sdl_type, name))
    print('known=%d' % known)
    print('mapping=%s' % (mapping if known else ''))
    if known:
        for control, element in sorted(mapping_binds(mapping).items(), key=lambda kv: ALL_CONTROLS.index(kv[0])):
            print('bind %s %s' % (control, element))
    return 0


