    else:
        text = ('# Gerado pelo Setup > Joysticks > Button mapping (fliperos-buttons).\n\n'
                + keyboard + '\n' + HYPSEUS_MOUSE)
    write(HYPSEUS_INI, text, USER_ID)


# ── FBNeo do Fightcade (Wine) ───────────────────────────────────

# O preset de cada jogador (nPlayerDefaultControls 15 e szPlayerDefaultIni no
# ini do emulador; o fliperos-fightcade os liga): linhas 'input "NOME" switch
# CODIGO', so para as entradas ainda sem nada. NOME e o szInfo dos drivers
# ("p1 fire 3"), igual em todos os jogos; os nomes de tela mais comuns vao
# junto para as versoes que so conhecem eles. O botao N do painel e o fire N
# do jogo, como no MAME.
FBNEO_NAMES = {'up': ['Up'], 'down': ['Down'], 'left': ['Left'], 'right': ['Right'], 'start': ['Start'],
               'coin': ['Coin'],
               'b1': ['Fire 1', 'Button 1', 'Weak Punch', 'Button A'],
               'b2': ['Fire 2', 'Button 2', 'Medium Punch', 'Button B'],
               'b3': ['Fire 3', 'Button 3', 'Strong Punch', 'Button C'],
               'b4': ['Fire 4', 'Button 4', 'Weak Kick', 'Button D'],
               'b5': ['Fire 5', 'Button 5', 'Medium Kick'],
               'b6': ['Fire 6', 'Button 6', 'Strong Kick'],
               'b7': ['Fire 7', 'Button 7'], 'b8': ['Fire 8', 'Button 8']}
FBNEO_HAT = {'1': 2, '2': 1, '4': 3, '8': 0}


def fbneo_code(index, element):
    """O codigo do FBNeo (DirectInput: 0x4000 | joystick << 8 | elemento) de
    um elemento do SDL. Com o "Map Controllers" do Wine desligado o painel
    chega cru: os botoes, os eixos (X Y Z rX rY rZ) e os hats na ordem do
    SDL."""
    base = 0x4000 | (index << 8)
    if element.startswith('b'):
        return base | (0x80 + int(element[1:]))
    if element.startswith('h'):
        hat, direction = element[1:].split('.')
        return base | (0x10 + 4 * int(hat) + FBNEO_HAT[direction])
    return base | (2 * int(element[2:]) + (1 if element[0] == '+' else 0))


def fbneo_preset(players, version):
    lines = ['// Gerado pelo Setup > Joysticks > Button mapping (fliperos-buttons).',
             'version 0x%06X' % version, '']
    for player in sorted(players):
        for control in CONTROLS:
            if control not in players[player] or is_key(players[player][control][1]):
                continue
            code = fbneo_code(*players[player][control])
            for name in FBNEO_NAMES[control]:
                lines.append('input  "P%d %s"  switch 0x%04X' % (player, name, code))
            lines.append('input  "p%d %s"  switch 0x%04X' % (player, FBNEO_NAMES[control][0].lower(), code))
    return '\r\n'.join(lines) + '\r\n'


def cmd_fbneo(args):
    players, _ = read_map(args.map)
    if not players:
        sys.exit('mapa vazio: %s' % args.map)
    sys.stdout.write(fbneo_preset(players, int(args.version, 0)))


def sdl_devices():
    """{indice: (guid, nome, botoes, eixos, repouso dos eixos, codigos ABS
    dos eixos ou None, todos os codigos ABS ou None, caminho do evdev ou
    "")} dos controles ligados; vazio sem o SDL."""
    try:
        lib = sdl()
    except OSError:
        return {}

    class GUID(ctypes.Structure):
        _fields_ = [('data', ctypes.c_uint8 * 16)]
    lib.SDL_JoystickGetDeviceGUID.restype = GUID
    lib.SDL_JoystickGetGUIDString.argtypes = [GUID, ctypes.c_char_p, ctypes.c_int]
    lib.SDL_JoystickNameForIndex.restype = ctypes.c_char_p
    if lib.SDL_Init(0x200) != 0:
        return {}
    out = {}
    try:
        sticks = {i: lib.SDL_JoystickOpen(i) for i in range(lib.SDL_NumJoysticks())}
        # Os eixos so tem o valor de verdade depois da primeira leitura.
        lib.SDL_JoystickUpdate()
        time.sleep(0.05)
        lib.SDL_JoystickUpdate()
        for i, js in sticks.items():
            if not js:
                continue
            buf = ctypes.create_string_buffer(33)
            lib.SDL_JoystickGetGUIDString(lib.SDL_JoystickGetDeviceGUID(i), buf, 33)
            out[i] = (buf.value.decode(), (lib.SDL_JoystickNameForIndex(i) or b'').decode(errors='replace'),
                      lib.SDL_JoystickNumButtons(js), lib.SDL_JoystickNumAxes(js), state(lib, js)[1],
                      abs_codes(lib, i), abs_all(lib, i), device_path(lib, i))
    finally:
        lib.SDL_Quit()
    return out


def device_path(lib, index):
    """O /dev/input/eventN do controle INDICE ("" sem o SDL 2.24)."""
    try:
        path_for = lib.SDL_JoystickPathForIndex
    except AttributeError:
        return ''
    path_for.restype = ctypes.c_char_p
    path_for.argtypes = [ctypes.c_int]
    return (path_for(index) or b'').decode(errors='replace')


# ── Controles Bluetooth: o jogador pela ordem de conexao ────────

# Um controle Bluetooth nao tem jogador fixo: o Button mapping guarda o
# mapeamento dele pelo aparelho (o GUID do SDL) em buttons-bt.map, linhas
# "GUID CONTROLE ELEMENTO NOME" ("GUID kind pad NOME" o tipo), e a cada
# controle ligado ou tirado (fliperos-controllers, pela regra do udev) os
# Bluetooth ligados ganham os jogadores que os fixos (painel, USB) nao usam,
# na ordem em que conectaram, como no Batocera. No buttons.map eles entram
# com uma linha "JOGADOR bt INDICE GUID NOME", e cada save os refaz.
BT_MAP = os.environ.get('FLIPEROS_BUTTONS_BT_MAP', '/etc/fliperos/buttons-bt.map')
MAX_PLAYERS = 8


def is_bluetooth(guid):
    """O GUID do SDL comeca pelo barramento (16 bits, little endian): 0x0005
    e Bluetooth."""
    return guid[:4].lower() == '0500'


def read_bt_profiles(path=None):
    """{GUID: (tipo, {controle: elemento}, nome)} do buttons-bt.map."""
    out = {}
    for line in read_text(path or BT_MAP).splitlines():
        parts = line.split(None, 3)
        if len(parts) < 3 or not re.fullmatch(r'[0-9a-fA-F]{32}', parts[0]):
            continue
        guid, control, element = parts[0].lower(), parts[1], parts[2]
        kind, binds, name = out.get(guid, ('pad', {}, ''))
        name = parts[3].strip() if len(parts) > 3 else name
        if control == 'kind' and element in KINDS:
            kind = element
        elif control in ALL_CONTROLS:
            binds[control] = element
        out[guid] = (kind, binds, name)
    return out


def read_autos(path):
    """{jogador: GUID} das linhas "JOGADOR bt INDICE GUID NOME"."""
    out = {}
    for line in read_text(path).splitlines():
        parts = line.split(None, 4)
        if len(parts) >= 4 and parts[1] == 'bt' and parts[0].isdigit():
            out[int(parts[0])] = parts[3].lower()
    return out


def connected_at(device):
    """Quando o controle foi ligado: a criacao do no do evdev dele (a ordem do
    SDL repete o numero de um evento solto, e nao e a da conexao)."""
    path = device[7] if len(device) > 7 else ''
    try:
        return os.stat(path).st_ctime_ns if path else 0
    except OSError:
        return 0


def resolve_bluetooth(players, names, kinds, autos, devices, profiles):
    """Tira os jogadores Bluetooth do mapa e poe os ligados agora: cada um com
    o perfil do aparelho (o GUID, senao o nome), nos jogadores livres em ordem,
    pela ordem de conexao. Muda os dicionarios; devolve se algo mudou."""
    before = (repr(sorted(players.items())), repr(sorted(kinds.items())), repr(sorted(autos.items())))
    for player in list(autos):
        players.pop(player, None)
        kinds.pop(player, None)
        autos.pop(player, None)
    taken = set(players)
    fixed = {index for binds in players.values() for index, _ in binds.values()}
    by_name = {name: guid for guid, (_, _, name) in profiles.items() if name}
    ligados = sorted((i for i in devices if is_bluetooth(devices[i][0]) and i not in fixed),
                     key=lambda i: (connected_at(devices[i]), i))
    for index in ligados:
        guid, name = devices[index][0].lower(), devices[index][1]
        profile = profiles.get(guid) or profiles.get(by_name.get(name, ''))
        free = [p for p in range(1, MAX_PLAYERS + 1) if p not in taken]
        if not profile or not profile[1] or not free:
            continue
        player = free[0]
        taken.add(player)
        players[player] = {c: (index, e) for c, e in profile[1].items()}
        kinds[player] = profile[0]
        autos[player] = guid
        names[index] = name
    after = (repr(sorted(players.items())), repr(sorted(kinds.items())), repr(sorted(autos.items())))
    return before != after


# ── Controles com fio: o jogador pela porta ─────────────────────

# O indice do SDL e a ordem dos /dev/input/eventN, e um controle ligado depois
# (um Bluetooth) pode pegar um numero que estava livre e passar a frente dos
# com fio: o "jogador 1 = controle 0" do mapa caia nele. Cada jogador com fio
# guarda a porta do controle dele (o caminho no sysfs ate a interface USB),
# numa linha "JOGADOR usb INDICE PORTA NOME", e cada save poe nele o indice
# de agora do controle daquela porta. Os com fio tem a prioridade: os
# Bluetooth so pegam os jogadores que sobram.
UNPLUGGED = 90                    # o indice de um com fio desligado: nenhum


def port_of(device):
    """A porta do controle: o caminho dele no sysfs sem o "input/inputN" do
    fim ("pci0000:00/0000:00:1a.7/usb2/2-2/2-2.2/2-2.2:1.0"); "" sem o
    caminho."""
    path = device[7] if len(device) > 7 else ''
    if not path:
        return ''
    try:
        real = os.path.realpath('/sys/class/input/%s/device' % os.path.basename(path))
    except OSError:
        return ''
    real = re.sub(r'/input/input\d+$', '', real)
    return real.split('/sys/devices/', 1)[-1] if '/sys/devices/' in real else ''


def read_ports(path):
    """{jogador: porta} das linhas "JOGADOR usb INDICE PORTA NOME"."""
    out = {}
    for line in read_text(path).splitlines():
        parts = line.split(None, 4)
        if len(parts) >= 4 and parts[1] == 'usb' and parts[0].isdigit():
            out[int(parts[0])] = parts[3]
    return out


def resolve_wired(players, names, ports, autos, devices):
    """Poe em cada jogador com fio o indice de agora do controle da porta dele
    (sem porta guardada, a do indice de agora, que o Button mapping acabou de
    pegar). Fora da porta, um com fio de mesmo nome que sobrou; desligado, o
    indice UNPLUGGED + jogador, que nao existe. Devolve se algo mudou."""
    wired = {i: port_of(d) for i, d in devices.items() if not is_bluetooth(d[0])}
    by_port = {p: i for i, p in wired.items() if p}
    changed, used = False, set()
    order = sorted(p for p in players if p not in autos)
    # Uma porta, um controle: o jogador que repete a porta de um de numero
    # menor e um resto (o Nyxi que o HIDAPI fazia passar por com fio) e sai.
    seen = set()
    for player in list(order):
        port = ports.get(player)
        if port and port in seen:
            players.pop(player)
            ports.pop(player)
            order.remove(player)
            changed = True
        elif port:
            seen.add(port)
    targets = {}
    for player in order:
        indexes = {i for i, _ in players[player].values()}
        if any(i < 0 for i in indexes):
            continue                      # teclado
        index = next(iter(indexes))
        port = ports.get(player)
        if not port and index in wired:
            port = wired[index]
            if port:
                ports[player] = port
                changed = True
        if port in by_port and by_port[port] not in used:
            targets[player] = by_port[port]
            used.add(by_port[port])
    for player in order:
        indexes = {i for i, _ in players[player].values()}
        if player in targets or any(i < 0 for i in indexes):
            continue
        old = names.get(next(iter(indexes)), '')
        same = [i for i in sorted(wired) if i not in used and devices[i][1] == old]
        if same:
            targets[player] = same[0]
            used.add(same[0])
            if wired[same[0]]:
                ports[player] = wired[same[0]]
        else:
            targets[player] = UNPLUGGED + player
    for player, index in targets.items():
        old = next(iter(players[player].values()))[0]
        if old != index:
            name = names.get(old, '')
            players[player] = {c: (index, e) for c, (_, e) in players[player].items()}
            names[index] = devices[index][1] if index in devices else name
            changed = True
    return changed


