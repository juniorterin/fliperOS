<?xml version="1.0" encoding="UTF-8"?>
<!--
  Menu raiz do openbox (botao direito na area de trabalho).

  Existe porque o menu do openbox e ESTATICO: ao contrario do LXDE, ele nao le
  os .desktop de /usr/share/applications, entao a entrada de configuracao tem
  de ser declarada aqui tambem. E o openbox sem painel nao tem nenhuma pista
  visivel de como abrir nada — sem este menu a tela fica util so pra quem ja
  sabe que precisa clicar com o direito.

  Instalado no ~/.config do usuario, nao em /etc/xdg: assim nao sobrescreve um
  conffile do pacote openbox.
-->
<openbox_menu xmlns="http://openbox.org/3.4/menu">

<menu id="root-menu" label="FliperOS">

  <item label="Configuração do FliperOS">
    <action name="Execute">
      <command>lxterminal -e sudo /usr/local/bin/fliperos-config</command>
    </action>
  </item>

  <item label="Launcher de emuladores">
    <action name="Execute">
      <command>lxterminal -e /opt/fliperos/bin/fliperos-session</command>
    </action>
  </item>

  <separator/>

  <item label="Diagnóstico de vídeo">
    <action name="Execute">
      <command>lxterminal -e sudo /usr/local/bin/fliperos-video-check</command>
    </action>
  </item>

  <item label="Terminal">
    <action name="Execute">
      <command>lxterminal</command>
    </action>
  </item>

  <separator/>

  <item label="Reiniciar">
    <action name="Execute"><command>sudo /sbin/reboot</command></action>
  </item>

  <item label="Desligar">
    <action name="Execute"><command>sudo /sbin/poweroff</command></action>
  </item>

  <item label="Sair do window manager">
    <action name="Exit"/>
  </item>

</menu>

</openbox_menu>
