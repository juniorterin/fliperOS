#!/usr/bin/env bash
# Arcadeflow (github.com/zpaolo11x/Arcadeflow): o tema padrao das telas do
# Attract-Mode Plus no FliperOS.
#
# O repositorio dele nao tem licenca, ou seja, nao da permissao de
# redistribuir: nao vem na imagem nem no repositorio do FliperOS. O Setup > Games >
# Frontend baixa a versao fixada do GitHub (fetch) para
# ~/.attract/layouts/Arcadeflow - pasta do usuario, porque o tema grava as
# opcoes e o banco de jogos dele nela. Sem ele (sem rede, por exemplo) as
# telas ficam no Basic do FliperOS (config/attractplus-layouts).
#
#   fliperos-arcadeflow fetch [--progress]   baixa e instala (de novo: repara)
#   fliperos-arcadeflow screen [LARGURA ALTURA]   o desenho em 4:3 num modo
#                                            de pixel largo (640x240)
#   fliperos-arcadeflow prefs                as opcoes do FliperOS que este
#                                            tema ainda nao recebeu
#   fliperos-arcadeflow systems              o logotipo das telas do FliperOS
#                                            ("TELA|SISTEMA..." na entrada)
#
# Pede o Attract-Mode Plus 3.2.0 ou mais novo (layout.nut, FeVersionNum).
set -uo pipefail
attract=${ATTRACT_DIR:-/home/fliperos/.attract}
version=${ARCADEFLOW_VERSION:-17.7}
url=${ARCADEFLOW_URL:-https://github.com/zpaolo11x/Arcadeflow/archive/refs/tags/$version.tar.gz}
user=${FLIPEROS_USER:-fliperos}
layouts=$attract/layouts
dir=$layouts/Arcadeflow
self=$(readlink -f -- "${BASH_SOURCE[0]}")

# say PORCENTAGEM TEXTO: uma etapa para a tela de progresso do Setup
# (lib/progress.sh), ou so o texto.
progress=0
say() {
  if ((progress)); then printf '@step %s %s\n' "$1" "$2"; else printf '%s\n' "$2"; fi
}
# fail TEXTO: sai com erro, avisando a tela de progresso.
fail() {
  if ((progress)); then printf '@fail Arcadeflow|%s\n' "$1"; else printf 'fliperos-arcadeflow: %s\n' "$1" >&2; fi
  exit 1
}

# prefs: as opcoes do tema que o FliperOS grava, no formato do
# pref_layoutoptions.txt dele (a versao na primeira linha e "|OPCAO|indice|";
# o que nao esta no arquivo fica no padrao do tema). Sem o aviso de versao
# nova: a versao e a fixada aqui, e o aviso espera uma resposta do teclado.
# O menu de contexto no botao de escolher (o padrao do tema: o primeiro
# aperto abre o menu sobre o jogo, com as informacoes, o favorito e as tags,
# e o segundo abre o jogo): o FliperOS o tirou por um tempo, e o valor esta
# aqui para voltar nos temas instalados nesse tempo.
# Sem o indicador de jogo indisponivel: o tema marca com um X, e nao abre, o
# jogo sem arquivo proprio na pasta, e num romset merged o clone esta dentro
# do zip do pai (o GroovyMAME o abre pelo nome). A romlist do FliperOS so tem
# o que esta na pasta, dessa forma ou com arquivo proprio.
# O video do jogo sob o seletor no menor tempo do tema ("Video delay
# multiplier" em 0.25x): ele espera 60 quadros (1 s) parado no jogo antes de
# carregar o video, e mais uns 35 ate comecar a mostra-lo.
fliperos_prefs=(UPDATECHECK 1 OVERMENUBUTTON 1 REDCROSS 1 THUMBVIDELAY 0)
prefs() {
  printf '%s\n\n' "$version"
  printf '|%s|%s|\n' "${fliperos_prefs[@]}"
}

# prefs_marks: as opcoes acima, "OPCAO=indice" por linha: o que vai em
# pref_fliperos.txt, a lista das que o FliperOS ja gravou neste tema.
prefs_marks() {
  local i
  for ((i = 0; i < ${#fliperos_prefs[@]}; i += 2)); do
    printf '%s=%s\n' "${fliperos_prefs[i]}" "${fliperos_prefs[i + 1]}"
  done
}

# clones_patch: com "Group Clones" (o padrao do Attract-Mode Plus) o botao de
# escolher, num jogo com clones, nao abre o jogo: o Attract-Mode troca a lista
# pela dos clones dele (voltar retorna a lista toda). O tema ja tinha apagado
# a tela para o jogo abrir e ficava so com o fundo, com a lista dos clones la,
# sem ser vista, ate outro aperto. Uma linha no comeco do on_transition dele
# acende a tela de novo quando a lista nova e a de clones. Num tema sem essa
# funcao (outra versao), nada.
clones_patch() {
  local at='function on_transition(ttype, var0, ttime) {'
  local line='	if (ttype == Transition.ToNewList \&\& fe.list.clones_list) startfade(flowT.groupbg, 0.06, 3.0) // FliperOS'
  grep -qF 'fe.list.clones_list) startfade' "$dir/layout.nut" && return 0
  grep -qxF "$at" "$dir/layout.nut" || return 0
  sed -i "s|^$at\$|&\n$line|" "$dir/layout.nut"
}

# prefs_apply: o que um tema ja instalado ainda nao recebeu do FliperOS: a
# linha dos clones (clones_patch) e as opcoes que entraram ou mudaram na
# lista acima. Cada opcao e gravada uma vez so, e anotada em
# pref_fliperos.txt: o que a pessoa escolher depois, nas opcoes do tema,
# fica. Nao com o Attract-Mode aberto (o tema regrava as opcoes).
prefs_apply() {
  local file=$dir/pref_layoutoptions.txt mark=$dir/pref_fliperos.txt i name value
  [[ -f $dir/layout.nut ]] || return 0
  pgrep -x attractplus > /dev/null 2>&1 && return 0
  if ((EUID == 0)) && [[ $user != root ]]; then
    exec runuser -u "$user" -- "$self" prefs
  fi
  clones_patch
  [[ -f $file ]] || return 0
  for ((i = 0; i < ${#fliperos_prefs[@]}; i += 2)); do
    name=${fliperos_prefs[i]} value=${fliperos_prefs[i + 1]}
    grep -qxF "$name=$value" "$mark" 2> /dev/null && continue
    sed -i "/^|$name|/d" "$file"
    printf '|%s|%s|\n' "$name" "$value" >> "$file"
    printf '%s=%s\n' "$name" "$value" >> "$mark"
  done
}

# displays_file: o arquivo das telas. O Attract-Mode Plus 3.x le as de
# config/displays.cfg quando ha config/attract.cfg; antes da primeira
# execucao, as do attract.cfg (que ele migra).
displays_file() {
  if [[ -f $attract/config/attract.cfg ]]; then
    printf '%s\n' "$attract/config/displays.cfg"
  else
    printf '%s\n' "$attract/attract.cfg"
  fi
}

# displays_switch: as telas que estao no Basic ou no BasicPlus (o padrao de
# antes e o das telas que o Attract-Mode Plus cria) passam para o Arcadeflow;
# as de outro layout, escolhido pela pessoa, ficam. Na primeira instalacao (o
# fliperos-setup --session-start faz o mesmo a cada abertura do launcher), e
# nao com o Attract-Mode aberto (ele regrava o arquivo ao fechar).
displays_switch() {
  local file
  file=$(displays_file)
  [[ -f $file ]] || return 0
  pgrep -x attractplus > /dev/null 2>&1 && return 0
  sed -i -E 's/^([[:space:]]+layout[[:space:]]+)Basic(Plus)?[[:space:]]*$/\1Arcadeflow/' "$file"
}

# screen [LARGURA ALTURA]: o tamanho em que o tema desenha, para o modo de
# video de um tubo 4:3. Num modo de pixel largo (640x240: 8:3 em pixels, que
# o tubo mostra em 4:3) o tema se arrumava para uma tela 8:3 e tudo saia com
# o dobro da largura. Nele o tema desenha em 4:3 na mesma altura (320x240, a
# opcao "Resolution W x H" dele) e o Attract-Mode estica ate a largura do
# modo (200%), como os emuladores do fliperos-x11-run. O tema mantem a
# proporcao do desenho (sairia com faixas pretas dos lados): a linha do
# layout.nut que pede isso passa a olhar o arquivo fliperos_stretch, que so
# existe com o esticado ligado. Num modo 4:3, ou sem argumentos (monitor de
# pixel quadrado), o que foi gravado aqui e desfeito; um tamanho posto pela
# pessoa fica. Nao com o Attract-Mode aberto (o tema regrava as opcoes).
screen() {
  local w=${1:-4} h=${2:-3} size="" file=$dir/pref_layoutoptions.txt mark=$dir/fliperos_stretch
  local keep='fe.layout.preserve_aspect_ratio = true'
  local stretch='fe.layout.preserve_aspect_ratio = !file_exist(AF.folder + "fliperos_stretch")'
  [[ -f $dir/layout.nut ]] || return 0
  [[ $w =~ ^[1-9][0-9]*$ && $h =~ ^[1-9][0-9]*$ ]] || fail "invalid mode: $w x $h"
  pgrep -x attractplus > /dev/null 2>&1 && return 0
  if ((EUID == 0)) && [[ $user != root ]]; then
    exec runuser -u "$user" -- "$self" screen "$@"
  fi
  ((w * 3 > h * 4)) && size=$((h * 4 / 3))x$h
  if [[ -z $size ]]; then
    [[ -f $mark ]] || return 0
    [[ -f $file ]] && sed -i '/^|CUSTOMSIZE|/d' "$file"
    rm -f "$mark"
    return 0
  fi
  if ! grep -qxF "$stretch" "$dir/layout.nut"; then
    grep -qxF "$keep" "$dir/layout.nut" || fail "this Arcadeflow has no aspect ratio line to change"
    sed -i "s|^$keep\$|$stretch|" "$dir/layout.nut" || fail "could not write $dir/layout.nut"
  fi
  [[ -f $file ]] || prefs > "$file"
  # O texto depois do valor faz parte do formato: sem ele o tema le a opcao
  # como vazia.
  sed -i '/^|CUSTOMSIZE|/d' "$file"
  printf '|CUSTOMSIZE|%s| Resolution W x H : Res\n' "$size" >> "$file"
  : > "$mark"
}

fetch() {
  local part="$layouts/.arcadeflow.part" new="$layouts/.arcadeflow.new" first=1 f
  [[ ${1:-} == --progress ]] && progress=1
  # Pelo Setup (root): a pasta e do usuario, e o download roda como ele.
  if ((EUID == 0)) && [[ $user != root ]]; then
    if ! mkdir -p "$layouts" || ! chown "$user:" "$attract" "$layouts"; then
      fail "could not create $layouts"
    fi
    exec runuser -u "$user" -- "$self" fetch "$@"
  fi
  mkdir -p "$layouts" 2> /dev/null && [[ -w $layouts ]] || fail "$layouts is not writable"
  [[ -f $dir/layout.nut ]] && first=0
  say 0 "Downloading Arcadeflow $version from GitHub (55 MB)"
  if ! curl -sSfL --retry 3 --max-time 1800 -o "$part" "$url" >&2; then
    rm -f "$part"
    fail "the download failed (no network?)"
  fi
  say 80 "Unpacking"
  rm -rf "$new"
  if ! mkdir -p "$new" || ! tar -xzf "$part" -C "$new" --strip-components=1 --no-same-owner 2> /dev/null ||
    [[ ! -f $new/layout.nut ]]; then
    rm -rf "$part" "$new"
    fail "the downloaded file is not the Arcadeflow theme"
  fi
  rm -f "$part"
  # Num reparo, as opcoes e a conta do ScreenScraper da pessoa ficam.
  for f in "$dir"/pref_*.txt "$dir"/ss_login.txt; do
    [[ -f $f ]] && cp -f "$f" "$new/"
  done
  if [[ ! -f $new/pref_layoutoptions.txt ]]; then
    prefs > "$new/pref_layoutoptions.txt"
    prefs_marks > "$new/pref_fliperos.txt"
  fi
  rm -rf "$dir"
  mv "$new" "$dir" || fail "could not write $dir"
  clones_patch
  if ((first)); then
    say 95 "Putting the Attract-Mode Plus displays on Arcadeflow"
    displays_switch
  fi
  say 100 "Arcadeflow $version installed"
}

# systems: o logotipo de cada tela do FliperOS no menu de telas do tema. O
# Arcadeflow acha o sistema de uma tela (logotipo, arte, fabricante, ano)
# pelo nome dela no data_systems.txt dele, onde cada sistema e uma linha de
# dados seguida dos outros nomes que ele tem, um por linha. "Model 2" esta
# la; "Supermodel" e "Arcade (various) (MAME 2010 (0.139))", os nomes das
# telas do FliperOS, nao, e ficavam sem logotipo. Le da entrada
# "TELA|SISTEMA[|SISTEMA...]" por linha e poe o nome de cada tela, em
# minusculas, entre os nomes do primeiro SISTEMA que o tema conhece (uma tela
# que ele ja conhece, ou sem sistema conhecido, fica como esta). Os nomes
# postos ficam anotados em fliperos_systems.txt e saem na vez seguinte: uma
# tela que mudou de sistema, ou sumiu, nao deixa nome para tras. Nome com
# virgula nao entra (seria lido como a linha de dados de um sistema).
systems() {
  local data=$dir/data_systems.txt mark=$dir/fliperos_systems.txt new
  [[ -f $data ]] || return 0
  if ((EUID == 0)) && [[ $user != root ]]; then
    exec runuser -u "$user" -- "$self" systems
  fi
  [[ -f $mark ]] || : > "$mark"
  new=$(mktemp "$dir/.systems.XXXXXX") || return 0
  if awk -v old_file="$mark" -v mark="$mark.new" '
    function known(line) { return index(line, ",") ? substr(line, 1, index(line, ",") - 1) : line }
    BEGIN {
      while ((getline line < old_file) > 0) old[line] = 1
      while ((getline line < "/dev/stdin") > 0) {
        cut = index(line, "|")
        name = tolower(substr(line, 1, cut - 1))
        if (cut > 1 && !index(name, ",") && !(name in want)) {
          order[++screens] = name
          want[name] = tolower(substr(line, cut + 1))
        }
      }
    }
    {
      if (!index($0, ",") && ($0 in old)) next
      lines[++n] = $0
      if ($0 != "") key[known($0)] = 1
    }
    END {
      printf "" > mark
      for (i = 1; i <= screens; i++) {
        name = order[i]
        if (name in key) continue
        count = split(want[name], targets, "|")
        for (t = 1; t <= count; t++) {
          if (targets[t] != "" && (targets[t] in key)) {
            add[targets[t]] = add[targets[t]] name "\n"
            print name > mark
            break
          }
        }
      }
      for (i = 1; i <= n; i++) {
        print lines[i]
        if (lines[i] != "" && (known(lines[i]) in add)) {
          printf "%s", add[known(lines[i])]
          delete add[known(lines[i])]
        }
      }
    }' "$data" > "$new" && [[ -s $new ]]; then
    cat "$new" > "$data"
    mv -f "$mark.new" "$mark"
  fi
  rm -f "$new" "$mark.new"
}

case ${1:-} in
  systems)
    systems
    ;;
  fetch)
    shift
    fetch "$@"
    ;;
  screen)
    shift
    screen "$@"
    ;;
  prefs)
    prefs_apply
    ;;
  *)
    echo "usage: fliperos-arcadeflow fetch [--progress] | screen [WIDTH HEIGHT] | prefs | systems" >&2
    exit 2
    ;;
esac
