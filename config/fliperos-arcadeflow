#!/usr/bin/env bash
# Arcadeflow (github.com/zpaolo11x/Arcadeflow): o tema padrao das telas do
# Attract-Mode Plus no FliperOS.
#
# O repositorio dele nao tem licenca, ou seja, nao da permissao de
# redistribuir: nao vem na imagem nem no repositorio do FliperOS. O Setup >
# Frontend baixa a versao fixada do GitHub (fetch) para
# ~/.attract/layouts/Arcadeflow - pasta do usuario, porque o tema grava as
# opcoes e o banco de jogos dele nela. Sem ele (sem rede, por exemplo) as
# telas ficam no Basic do FliperOS (config/attractplus-layouts).
#
#   fliperos-arcadeflow fetch [--progress]   baixa e instala (de novo: repara)
#   fliperos-arcadeflow screen [LARGURA ALTURA]   o desenho em 4:3 num modo
#                                            de pixel largo (640x240)
#   fliperos-arcadeflow prefs                as opcoes do FliperOS que este
#                                            tema ainda nao recebeu
#
# Pede o Attract-Mode Plus 3.2.0 ou mais novo (layout.nut, FeVersionNum).
set -uo pipefail
attract=${ATTRACT_DIR:-/home/fliperos/.attract}
version=${ARCADEFLOW_VERSION:-17.7}
url=${ARCADEFLOW_URL:-https://github.com/zpaolo11x/Arcadeflow/archive/refs/tags/$version.tar.gz}
user=${FLIPEROS_USER:-fliperos}
layouts=$attract/layouts
dir=$layouts/Arcadeflow
self=$(readlink -f -- "${BASH_SOURCE[0]}")

# say PORCENTAGEM TEXTO: uma etapa para a tela de progresso do Setup
# (lib/progress.sh), ou so o texto.
progress=0
say() {
  if ((progress)); then printf '@step %s %s\n' "$1" "$2"; else printf '%s\n' "$2"; fi
}
# fail TEXTO: sai com erro, avisando a tela de progresso.
fail() {
  if ((progress)); then printf '@fail Arcadeflow|%s\n' "$1"; else printf 'fliperos-arcadeflow: %s\n' "$1" >&2; fi
  exit 1
}

# prefs: as opcoes do tema que o FliperOS muda, no formato do
# pref_layoutoptions.txt dele (a versao na primeira linha e "|OPCAO|indice|";
# o que nao esta no arquivo fica no padrao do tema). Sem o aviso de versao
# nova: a versao e a fixada aqui, e o aviso espera uma resposta do teclado.
# Sem o menu de contexto no botao de escolher (o padrao do tema): com ele o
# primeiro aperto abre o menu sobre o jogo e so o segundo abre o jogo.
fliperos_prefs=(UPDATECHECK 1 OVERMENUBUTTON 0)
prefs() {
  printf '%s\n\n' "$version"
  printf '|%s|%s|\n' "${fliperos_prefs[@]}"
}

# prefs_names: as opcoes acima, uma por linha: o que vai em pref_fliperos.txt,
# a lista das que o FliperOS ja gravou neste tema.
prefs_names() {
  local i
  for ((i = 0; i < ${#fliperos_prefs[@]}; i += 2)); do
    printf '%s\n' "${fliperos_prefs[i]}"
  done
}

# prefs_apply: num tema instalado antes de uma opcao entrar na lista acima, a
# opcao seguia no padrao do tema (no gabinete, o menu de contexto no botao de
# escolher). Cada opcao e gravada uma vez so, e anotada em pref_fliperos.txt:
# o que a pessoa escolher depois, nas opcoes do tema, fica. Nao com o
# Attract-Mode aberto (o tema regrava as opcoes).
prefs_apply() {
  local file=$dir/pref_layoutoptions.txt mark=$dir/pref_fliperos.txt i name
  [[ -f $dir/layout.nut && -f $file ]] || return 0
  pgrep -x attractplus > /dev/null 2>&1 && return 0
  if ((EUID == 0)) && [[ $user != root ]]; then
    exec runuser -u "$user" -- "$self" prefs
  fi
  for ((i = 0; i < ${#fliperos_prefs[@]}; i += 2)); do
    name=${fliperos_prefs[i]}
    grep -qxF "$name" "$mark" 2> /dev/null && continue
    sed -i "/^|$name|/d" "$file"
    printf '|%s|%s|\n' "$name" "${fliperos_prefs[i + 1]}" >> "$file"
    printf '%s\n' "$name" >> "$mark"
  done
}

# displays_file: o arquivo das telas. O Attract-Mode Plus 3.x le as de
# config/displays.cfg quando ha config/attract.cfg; antes da primeira
# execucao, as do attract.cfg (que ele migra).
displays_file() {
  if [[ -f $attract/config/attract.cfg ]]; then
    printf '%s\n' "$attract/config/displays.cfg"
  else
    printf '%s\n' "$attract/attract.cfg"
  fi
}

# displays_switch: as telas que estao no Basic ou no BasicPlus (o padrao de
# antes e o das telas que o Attract-Mode Plus cria) passam para o Arcadeflow;
# as de outro layout, escolhido pela pessoa, ficam. Na primeira instalacao (o
# fliperos-setup --session-start faz o mesmo a cada abertura do launcher), e
# nao com o Attract-Mode aberto (ele regrava o arquivo ao fechar).
displays_switch() {
  local file
  file=$(displays_file)
  [[ -f $file ]] || return 0
  pgrep -x attractplus > /dev/null 2>&1 && return 0
  sed -i -E 's/^([[:space:]]+layout[[:space:]]+)Basic(Plus)?[[:space:]]*$/\1Arcadeflow/' "$file"
}

# screen [LARGURA ALTURA]: o tamanho em que o tema desenha, para o modo de
# video de um tubo 4:3. Num modo de pixel largo (640x240: 8:3 em pixels, que
# o tubo mostra em 4:3) o tema se arrumava para uma tela 8:3 e tudo saia com
# o dobro da largura. Nele o tema desenha em 4:3 na mesma altura (320x240, a
# opcao "Resolution W x H" dele) e o Attract-Mode estica ate a largura do
# modo (200%), como os emuladores do fliperos-x11-run. O tema mantem a
# proporcao do desenho (sairia com faixas pretas dos lados): a linha do
# layout.nut que pede isso passa a olhar o arquivo fliperos_stretch, que so
# existe com o esticado ligado. Num modo 4:3, ou sem argumentos (monitor de
# pixel quadrado), o que foi gravado aqui e desfeito; um tamanho posto pela
# pessoa fica. Nao com o Attract-Mode aberto (o tema regrava as opcoes).
screen() {
  local w=${1:-4} h=${2:-3} size="" file=$dir/pref_layoutoptions.txt mark=$dir/fliperos_stretch
  local keep='fe.layout.preserve_aspect_ratio = true'
  local stretch='fe.layout.preserve_aspect_ratio = !file_exist(AF.folder + "fliperos_stretch")'
  [[ -f $dir/layout.nut ]] || return 0
  [[ $w =~ ^[1-9][0-9]*$ && $h =~ ^[1-9][0-9]*$ ]] || fail "invalid mode: $w x $h"
  pgrep -x attractplus > /dev/null 2>&1 && return 0
  if ((EUID == 0)) && [[ $user != root ]]; then
    exec runuser -u "$user" -- "$self" screen "$@"
  fi
  ((w * 3 > h * 4)) && size=$((h * 4 / 3))x$h
  if [[ -z $size ]]; then
    [[ -f $mark ]] || return 0
    [[ -f $file ]] && sed -i '/^|CUSTOMSIZE|/d' "$file"
    rm -f "$mark"
    return 0
  fi
  if ! grep -qxF "$stretch" "$dir/layout.nut"; then
    grep -qxF "$keep" "$dir/layout.nut" || fail "this Arcadeflow has no aspect ratio line to change"
    sed -i "s|^$keep\$|$stretch|" "$dir/layout.nut" || fail "could not write $dir/layout.nut"
  fi
  [[ -f $file ]] || prefs > "$file"
  # O texto depois do valor faz parte do formato: sem ele o tema le a opcao
  # como vazia.
  sed -i '/^|CUSTOMSIZE|/d' "$file"
  printf '|CUSTOMSIZE|%s| Resolution W x H : Res\n' "$size" >> "$file"
  : > "$mark"
}

fetch() {
  local part="$layouts/.arcadeflow.part" new="$layouts/.arcadeflow.new" first=1 f
  [[ ${1:-} == --progress ]] && progress=1
  # Pelo Setup (root): a pasta e do usuario, e o download roda como ele.
  if ((EUID == 0)) && [[ $user != root ]]; then
    if ! mkdir -p "$layouts" || ! chown "$user:" "$attract" "$layouts"; then
      fail "could not create $layouts"
    fi
    exec runuser -u "$user" -- "$self" fetch "$@"
  fi
  mkdir -p "$layouts" 2> /dev/null && [[ -w $layouts ]] || fail "$layouts is not writable"
  [[ -f $dir/layout.nut ]] && first=0
  say 0 "Downloading Arcadeflow $version from GitHub (55 MB)"
  if ! curl -sSfL --retry 3 --max-time 1800 -o "$part" "$url" >&2; then
    rm -f "$part"
    fail "the download failed (no network?)"
  fi
  say 80 "Unpacking"
  rm -rf "$new"
  if ! mkdir -p "$new" || ! tar -xzf "$part" -C "$new" --strip-components=1 --no-same-owner 2> /dev/null ||
    [[ ! -f $new/layout.nut ]]; then
    rm -rf "$part" "$new"
    fail "the downloaded file is not the Arcadeflow theme"
  fi
  rm -f "$part"
  # Num reparo, as opcoes e a conta do ScreenScraper da pessoa ficam.
  for f in "$dir"/pref_*.txt "$dir"/ss_login.txt; do
    [[ -f $f ]] && cp -f "$f" "$new/"
  done
  if [[ ! -f $new/pref_layoutoptions.txt ]]; then
    prefs > "$new/pref_layoutoptions.txt"
    prefs_names > "$new/pref_fliperos.txt"
  fi
  rm -rf "$dir"
  mv "$new" "$dir" || fail "could not write $dir"
  if ((first)); then
    say 95 "Putting the Attract-Mode Plus displays on Arcadeflow"
    displays_switch
  fi
  say 100 "Arcadeflow $version installed"
}

case ${1:-} in
  fetch)
    shift
    fetch "$@"
    ;;
  screen)
    shift
    screen "$@"
    ;;
  prefs)
    prefs_apply
    ;;
  *)
    echo "usage: fliperos-arcadeflow fetch [--progress] | screen [WIDTH HEIGHT] | prefs" >&2
    exit 2
    ;;
esac
