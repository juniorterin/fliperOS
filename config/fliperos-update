def read_level():
    try:
        with open(LEVEL, encoding='utf-8') as f:
            return int(f.read().strip() or 0)
    except (OSError, ValueError):
        return 0


def write_level(n):
    os.makedirs(os.path.dirname(LEVEL), exist_ok=True)
    with open(LEVEL + '.tmp', 'w', encoding='utf-8') as f:
        f.write('%d\n' % n)
    os.replace(LEVEL + '.tmp', LEVEL)


def manifest_path():
    return os.path.join(STATE, 'manifest')


def read_manifest():
    out = {}
    try:
        with open(manifest_path(), encoding='utf-8') as f:
            for line in f:
                path, _, value = line.rstrip('\n').partition('\t')
                if path and value:
                    out[path] = value
    except OSError:
        pass
    return out


def write_manifest(data):
    os.makedirs(STATE, exist_ok=True)
    with open(manifest_path() + '.tmp', 'w', encoding='utf-8') as f:
        for path in sorted(data):
            f.write('%s\t%s\n' % (path, data[path]))
    os.replace(manifest_path() + '.tmp', manifest_path())


class lock:
    def __enter__(self):
        os.makedirs(STATE, exist_ok=True)
        self.f = open(os.path.join(STATE, '.lock'), 'w')
        try:
            fcntl.flock(self.f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            raise Fail('another update is running')
        return self

    def __exit__(self, *a):
        self.f.close()


