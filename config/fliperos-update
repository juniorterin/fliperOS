def write_result(args, lines):
    text = ''.join('%s\n' % line for line in lines)
    if getattr(args, 'result', None):
        with open(args.result, 'w', encoding='utf-8') as f:
            f.write(text)
    elif not getattr(args, 'progress', False):
        sys.stdout.write(text)


def cmd_level(args):
    print(read_level())


def pending_file():
    return os.path.join(STATE, 'pending')


def cmd_check(args):
    lines = ['%d\t%s\t%s' % (n, 'yes' if reboot else 'no', title) for n, _, _, reboot, title in pending()]
    for line in lines:
        print(line)
    if args.save:
        # O boot nao espera a rede para perguntar: le isto (cmd_pending). So
        # um check que leu o indice grava; sem rede fica o anterior.
        os.makedirs(STATE, exist_ok=True)
        tmp = pending_file() + '.tmp'
        with open(tmp, 'w', encoding='utf-8') as f:
            f.write(''.join(line + '\n' for line in lines))
        os.chmod(tmp, 0o644)
        os.replace(tmp, pending_file())


def saved_pending():
    """As linhas do ultimo check --save que o nivel de agora ainda nao tem."""
    level = read_level()
    hold = read_hold()
    try:
        with open(pending_file(), encoding='utf-8') as f:
            lines = [line.rstrip('\n') for line in f
                     if line[:1].isdigit() and int(line.split('\t', 1)[0]) > level]
    except (OSError, ValueError):
        return []
    # Guardado antes da escolha: so conta se ha um depois do mais novo visto.
    if hold and not any(int(line.split('\t', 1)[0]) > hold[1] for line in lines):
        return []
    return lines


def cmd_pending(args):
    for line in saved_pending():
        print(line)


def powering_off():
    try:
        jobs = subprocess.run(JOBS, capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return 'poweroff.target' in jobs or 'halt.target' in jobs


def cmd_shutdown(args):
    """O ExecStop do fliperos-update-shutdown.service: desligando com um
    update pendente, ele entra agora, com a rede ainda de pe."""
    # Com uma versao escolhida nada entra sozinho: o boot pergunta.
    if read_hold() or not saved_pending() or not powering_off():
        return
    log('powering off with an update pending: applying it')
    try:
        subprocess.run(['plymouth', 'display-message', '--text=Updating FliperOS, do not turn off'],
                       capture_output=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass
    # O tools/cabinet-update.sh reinicia servicos; desligando, o systemd
    # recusaria. Assim o systemctl so mexe nos arquivos das unidades.
    os.environ['SYSTEMD_OFFLINE'] = '1'
    cmd_apply(argparse.Namespace(progress=False, result=None))


def plain(text):
    """O Markdown das notas em texto para a tela (sem **, ` e enderecos)."""
    text = re.sub(r'\*\*|`', '', text)
    return re.sub(r'\[([^]]*)\]\([^)]*\)', r'\1', text).strip()


def cmd_notes(args):
    """O que muda em cada update pendente, do mais velho ao mais novo: o
    titulo e as notas dele (sem notas, so o titulo)."""
    blocks = []
    for n, commit, _, reboot, title in pending():
        try:
            notes = plain(fetch(NOTES_URL.format(commit=commit, n=n)).decode('utf-8', 'replace'))
        except OSError:
            notes = ''
        head = 'Update %d: %s%s' % (n, title, ' (restarts the computer)' if reboot else '')
        blocks.append(head + ('\n\n' + notes if notes else ''))
    if blocks:
        print('\n\n'.join(blocks))


def cmd_plan(args):
    """O aviso antes de aplicar: o ensaio da arvore do ultimo pendente (a
    que fica no fim) contra a raiz de agora."""
    say(args.progress, '@step 5 Reading the update list')
    todo = pending()
    lines = ['pending=%d' % len(todo)]
    if todo:
        src = download(todo[-1], args.progress, 20)
        say(args.progress, '@step 60 Checking which files change')
        changed, local, unknown, exact = classify(src, ROOT)
        lines += ['changed=%d' % len(changed), 'exact=%s' % ('yes' if exact else 'no')]
        lines += ['local\t/%s' % p for p in local] + ['unknown\t/%s' % p for p in unknown]
    write_result(args, lines)
    say(args.progress, '@step 100 Done')


def run_step(step, env, args, lines, n, saved):
    """Um passo do update N (o INSTALL, o updates/NNNN.sh), com a saida no log
    e as linhas "== " na tela; falhou, para tudo ali."""
    with open(LOG, 'a', encoding='utf-8') as out:
        proc = subprocess.Popen(['bash', '-c', step], env=env, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, text=True)
        for line in proc.stdout:
            out.write(line)
            if line.startswith('== '):
                say(args.progress, '@msg %s' % line[3:].strip()[:70])
        if proc.wait():
            lines.append('failed\t%d\tbackup\t%s' % (n, saved))
            write_result(args, lines)
            raise Fail('update %d stopped (exit %d, see %s); its backup is in %s'
                       % (n, proc.returncode, LOG, saved))


def run_patches(todo, args, lines):
    """Aplica TODO em ordem, um de cada vez (com o lock na mao)."""
    for i, patch in enumerate(todo):
        n = patch[0]
        span = 100 // max(len(todo), 1)
        pct = i * span
        if read_level() != n - 1:
            raise Fail('update %d needs update %d first' % (n, n - 1))
        # O cabinet-update.sh do patch (o de quando ele saiu) usa o apt: as
        # fontes em conflito o parariam ali, num update velho que nao as conserta.
        try:
            apt_heal()
        except OSError as e:
            log('apt sources not checked: %s' % e)
        src = download(patch, args.progress, pct + 2)
        say(args.progress, '@step %d Update %d: saving the files it replaces' % (pct + span // 5, n))
        changed, local, unknown, _ = classify(src, ROOT)
        saved = backup(n, ROOT, changed)
        log('update %d (%s): %d files replaced, %d with local changes, backup %s'
            % (n, patch[4], len(changed), len(local) + len(unknown), saved))
        say(args.progress, '@step %d Update %d: %s' % (pct + span // 3, n, patch[4]))
        env = dict(os.environ, SRC=src, FLIPEROS_UPDATE='1', FLIPEROS_UPDATE_SRC=src)
        steps = [INSTALL]
        script = os.path.join(src, 'updates', '%04d.sh' % n)
        if os.path.isfile(script):
            steps.append('bash "%s"' % script)
        for step in steps:
            run_step(step, env, args, lines, n, saved)
        record(src, ROOT, changed)
        write_level(n)
        if patch[3]:
            mark_reboot()
        lines.append('applied\t%d\t%s\t%s\t%s' % (n, 'yes' if patch[3] else 'no', saved, patch[4]))
        log('update %d applied' % n)


def go_back(patch, index, args, lines):
    """Leva o gabinete de volta ao update PATCH: a arvore dele instalada por
    cima (o INSTALL, sem os updates/NNNN.sh, que ja rodaram), com a copia do
    que ela troca. Este fliperos-update fica (o da arvore antiga nao conhece
    a escolha e aplicaria tudo de novo ao desligar)."""
    n, level = patch[0], read_level()
    try:
        apt_heal()
    except OSError as e:
        log('apt sources not checked: %s' % e)
    src = download(patch, args.progress, 5)
    say(args.progress, '@step 25 Back to update %d: saving the files it replaces' % n)
    changed, local, unknown, _ = classify(src, ROOT)
    saved = backup(n, ROOT, changed, 'back-')
    log('back to update %d (%s) from %d: %d files replaced, %d with local changes, backup %s'
        % (n, patch[4], level, len(changed), len(local) + len(unknown), saved))
    try:
        with open(os.path.abspath(__file__), 'rb') as f:
            me = f.read()
    except OSError:
        me = None
    say(args.progress, '@step 40 Back to update %d: %s' % (n, patch[4]))
    env = dict(os.environ, SRC=src, FLIPEROS_UPDATE='1', FLIPEROS_UPDATE_SRC=src, FLIPEROS_UPDATE_BACK='1')
    run_step(INSTALL, env, args, lines, n, saved)
    extra = list(changed)
    if me and os.path.isdir(os.path.dirname(BIN)):
        with open(BIN + '.tmp', 'wb') as f:
            f.write(me)
        os.chmod(BIN + '.tmp', 0o755)
        os.replace(BIN + '.tmp', BIN)
        if os.path.abspath(BIN).startswith(os.path.abspath(ROOT)):
            extra.append(os.path.relpath(BIN, ROOT))
    record(src, ROOT, extra)
    write_level(n)
    # Os que saem pediam reiniciar: a volta tambem pede.
    reboot = any(p[3] for p in index if n < p[0] <= level)
    if reboot:
        mark_reboot()
    lines.append('back\t%d\t%s\t%s\t%s' % (n, 'yes' if reboot else 'no', saved, patch[4]))
    log('back to update %d' % n)


def cmd_apply(args):
    lines = []
    with lock():
        index = read_index()
        todo = pending(index)
        run_patches(todo, args, lines)
        # Aplicar leva ao mais novo: a versao escolhida sai.
        if todo and read_level() == index[-1][0]:
            clear_hold()
    lines.append('level=%d' % read_level())
    write_result(args, lines)
    say(args.progress, '@step 100 FliperOS is up to date')


def cmd_versions(args):
    """Os updates que se pode escolher (da base ao mais novo), do mais novo ao
    mais velho, e o estado: nivel, base, mais novo, escolha, reiniciar."""
    index = read_index()
    level, base, hold = read_level(), read_base(), read_hold()
    latest = index[-1][0] if index else 0
    print('level=%d' % level)
    print('base=%d' % base)
    print('latest=%d' % latest)
    print('hold=%s' % (hold[0] if hold else ''))
    print('reboot=%s' % ('yes' if os.path.exists(REBOOT_FLAG) else 'no'))
    for n, _, _, reboot, title in reversed(index):
        if n < base:
            continue
        state = 'current' if n == level else 'older' if n < level else 'newer'
        print('%d\t%s\t%s\t%s' % (n, state, 'yes' if reboot else 'no', title))


def cmd_goto(args):
    """Leva o gabinete ao update N (para frente ou para tras) e o deixa nele
    (abaixo do mais novo) ou volta a seguir os updates (o mais novo)."""
    say(args.progress, '@step 2 Reading the update list')
    index = read_index()
    if not index:
        raise Fail('the update list is empty')
    latest = index[-1][0]
    if args.n == 'latest':
        n = latest
    elif args.n.isdigit():
        n = int(args.n)
    else:
        raise Fail('give an update number or "latest"')
    base = max(read_base(), 1)
    if not base <= n <= latest:
        raise Fail('update %d cannot be chosen here (from %d to %d)' % (n, base, latest))
    lines = []
    with lock():
        level = read_level()
        if n > level:
            run_patches([p for p in index if level < p[0] <= n], args, lines)
        elif n < level:
            go_back(index[n - 1], index, args, lines)
        if n < latest:
            write_hold(n, latest)
        else:
            clear_hold()
        # O que o boot guardou para perguntar ja nao vale.
        try:
            os.remove(pending_file())
        except OSError:
            pass
        log('version: update %d%s' % (n, ' (held)' if n < latest else ' (following the updates)'))
    lines.append('level=%d' % read_level())
    lines.append('hold=%s' % (n if n < latest else ''))
    write_result(args, lines)
    say(args.progress, '@step 100 FliperOS is at update %d' % read_level())


def cmd_restore(args):
    base = os.path.join(STATE, 'backup')
    found = sorted(d for d in os.listdir(base) if d.startswith('%04d-' % args.n)) if os.path.isdir(base) else []
    if not found:
        raise Fail('no backup of update %d' % args.n)
    src = os.path.join(base, found[-1])
    count = 0
    for rel in walk(src):
        target = os.path.join(ROOT, rel)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        if os.path.lexists(target):
            os.remove(target)
        if os.path.islink(os.path.join(src, rel)):
            os.symlink(os.readlink(os.path.join(src, rel)), target)
        else:
            shutil.copy2(os.path.join(src, rel), target)
        count += 1
    print('restored=%d' % count)
    print('from=%s' % src)


def cmd_record(args):
    """Depois do tools/cabinet-update.sh (o push de desenvolvimento) e no
    build da ISO: o manifesto e o nivel do ultimo patch do updates/index
    da ORIGEM (essa arvore ja tem todos)."""
    count = record(os.path.abspath(args.src), ROOT)
    last = 0
    try:
        with open(os.path.join(args.src, 'updates', 'index'), encoding='utf-8') as f:
            for line in f:
                if line[:1].isdigit():
                    last = max(last, int(line.split('\t', 1)[0]))
    except OSError as e:
        raise Fail('updates/index missing in %s: %s' % (args.src, e))
    write_level(max(last, read_level()))
    if args.root:
        # O build da ISO: o nivel dela e o mais velho que se pode escolher.
        os.makedirs(os.path.dirname(BASE), exist_ok=True)
        with open(BASE, 'w', encoding='utf-8') as f:
            f.write('%d\n' % read_level())
    print('manifest=%d' % count)
    print('level=%d' % read_level())


def main():
    global ROOT, STATE, LEVEL, BASE, HOLD
    p = argparse.ArgumentParser(prog='fliperos-update')
    sub = p.add_subparsers(dest='cmd', required=True)
    sub.add_parser('level').set_defaults(func=cmd_level)
    s = sub.add_parser('check')
    s.add_argument('--save', action='store_true')
    s.set_defaults(func=cmd_check)
    sub.add_parser('pending').set_defaults(func=cmd_pending)
    sub.add_parser('shutdown').set_defaults(func=cmd_shutdown)
    sub.add_parser('notes').set_defaults(func=cmd_notes)
    sub.add_parser('apt-heal').set_defaults(func=cmd_apt_heal)
    for name, func in (('plan', cmd_plan), ('apply', cmd_apply)):
        s = sub.add_parser(name)
        s.add_argument('--progress', action='store_true')
        s.add_argument('--result')
        s.set_defaults(func=func)
    sub.add_parser('versions').set_defaults(func=cmd_versions)
    s = sub.add_parser('goto')
    s.add_argument('n')
    s.add_argument('--progress', action='store_true')
    s.add_argument('--result')
    s.set_defaults(func=cmd_goto)
    s = sub.add_parser('restore')
    s.add_argument('n', type=int)
    s.set_defaults(func=cmd_restore)
    s = sub.add_parser('record')
    s.add_argument('src')
    s.add_argument('--root')
    s.set_defaults(func=cmd_record)
    args = p.parse_args()
    if getattr(args, 'root', None):
        # Outra raiz (o chroot do build): o manifesto e o nivel ficam nela.
        ROOT = args.root
        STATE = os.path.join(ROOT, STATE.lstrip('/'))
        LEVEL = os.path.join(ROOT, LEVEL.lstrip('/'))
        BASE = os.path.join(ROOT, BASE.lstrip('/'))
        HOLD = os.path.join(ROOT, HOLD.lstrip('/'))
    try:
        args.func(args)
    except Fail as e:
        log('error: %s' % e)
        if getattr(args, 'progress', False):
            print('@fail FliperOS update|%s' % e, flush=True)
        sys.exit('fliperos-update: %s' % e)


if __name__ == '__main__':
    main()
