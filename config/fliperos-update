STATE = os.environ.get('FLIPEROS_UPDATE_STATE', '/var/lib/fliperos/update')
LEVEL = os.environ.get('FLIPEROS_UPDATE_LEVEL', '/etc/fliperos/patch-level')
ROOT = os.environ.get('FLIPEROS_UPDATE_ROOT', '/')
