def fetch(url):
    with urllib.request.urlopen(url, timeout=TIMEOUT) as r:
        return r.read()


def read_index():
    """[(n, commit, treehash, reboot, titulo)], conferido: 1, 2, 3... sem
    buraco e sem repetir."""
    try:
        text = fetch(INDEX_URL).decode('utf-8')
    except OSError as e:
        raise Fail('could not read the update list (%s)' % e)
    out = []
    for line in text.splitlines():
        if not line.strip() or line.startswith('#'):
            continue
        parts = line.split('\t')
        if len(parts) < 5 or not parts[0].isdigit():
            raise Fail('bad line in the update list: %s' % line[:60])
        n = int(parts[0])
        if n != len(out) + 1:
            raise Fail('the update list skips from %d to %d' % (len(out), n))
        out.append((n, parts[1], parts[2], parts[3] == 'yes', parts[4]))
    return out


def pending(index=None):
    """Os updates acima do nivel. Com uma versao escolhida, nenhum ate sair
    um depois do mais novo de quando ela foi escolhida; entao todos (o Apply
    leva ao mais novo e solta a escolha)."""
    level = read_level()
    index = read_index() if index is None else index
    hold = read_hold()
    if hold and (not index or index[-1][0] <= hold[1]):
        return []
    return [p for p in index if p[0] > level]


def work_dir(n):
    return os.path.join(STATE, 'work', '%04d' % n)


def download(patch, progress, pct):
    """A arvore do patch em STATE/work/NNNN, conferida pelo treehash."""
    n, commit, expected = patch[0], patch[1], patch[2]
    dest = work_dir(n)
    if os.path.isdir(dest) and treehash(dest) == expected:
        return dest
    say(progress, '@step %d Downloading update %d' % (pct, n))
    try:
        data = fetch(TARBALL_URL.format(commit=commit))
    except OSError as e:
        raise Fail('could not download update %d (%s)' % (n, e))
    shutil.rmtree(dest, ignore_errors=True)
    tmp = dest + '.tmp'
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(tmp)
    with tarfile.open(fileobj=io.BytesIO(data), mode='r:*') as tar:
        members = []
        for m in tar.getmembers():
            # O tar do GitHub tem uma pasta de cima (fliperOS-COMMIT/).
            parts = m.name.split('/', 1)
            if len(parts) < 2 or not parts[1]:
                continue
            m.name = parts[1]
            members.append(m)
        try:
            tar.extractall(tmp, members=members, filter='data')
        except TypeError:
            tar.extractall(tmp, members=members)
    got = treehash(tmp)
    if got != expected:
        shutil.rmtree(tmp, ignore_errors=True)
        raise Fail('update %d does not match the update list (treehash %s, expected %s)'
                   % (n, got[:12], expected[:12]))
    os.replace(tmp, dest)
    return dest


