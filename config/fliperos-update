def digest(path):
    """O conteudo de um arquivo ("sha256") ou o destino de um link
    ("->destino"); None se nao existe."""
    try:
        if os.path.islink(path):
            return '->' + os.readlink(path)
        if not os.path.isfile(path):
            return None
        h = hashlib.sha256()
        with open(path, 'rb') as f:
            for block in iter(lambda: f.read(1 << 20), b''):
                h.update(block)
        return h.hexdigest()
    except OSError:
        return None


def skipped(rel):
    return any(rel == s or rel.startswith(s + '/') for s in SKIP)


def walk(base):
    """Os caminhos relativos dos arquivos e links de BASE (sem as pastas)."""
    out = []
    for top, dirs, files in os.walk(base):
        for name in files + [d for d in dirs if os.path.islink(os.path.join(top, d))]:
            path = os.path.join(top, name)
            rel = os.path.relpath(path, base)
            if os.path.islink(path) or os.path.isfile(path):
                out.append(rel)
    return sorted(out)


def treehash(src):
    lines = []
    for part in TREE:
        path = os.path.join(src, part)
        rels = [part] if os.path.isfile(path) else [os.path.join(part, r) for r in walk(path)]
        for rel in rels:
            if '__pycache__' in rel.split(os.sep):
                continue
            lines.append('%s\t%s\n' % (rel.replace(os.sep, '/'), digest(os.path.join(src, rel))))
    return hashlib.sha256(''.join(sorted(lines)).encode()).hexdigest()


