def read_level():
    try:
        with open(LEVEL, encoding='utf-8') as f:
            return int(f.read().strip() or 0)
    except (OSError, ValueError):
        return 0


def write_level(n):
    os.makedirs(os.path.dirname(LEVEL), exist_ok=True)
    with open(LEVEL + '.tmp', 'w', encoding='utf-8') as f:
        f.write('%d\n' % n)
    os.replace(LEVEL + '.tmp', LEVEL)


def read_hold():
    """(N, mais novo visto) da versao escolhida; None sem escolha."""
    try:
        with open(HOLD, encoding='utf-8') as f:
            n, seen = (int(word) for word in f.read().split()[:2])
        return n, seen
    except (OSError, ValueError):
        return None


def write_hold(n, seen):
    os.makedirs(os.path.dirname(HOLD), exist_ok=True)
    with open(HOLD + '.tmp', 'w', encoding='utf-8') as f:
        f.write('%d %d\n' % (n, seen))
    os.replace(HOLD + '.tmp', HOLD)


def clear_hold():
    try:
        os.remove(HOLD)
    except OSError:
        pass


def read_base():
    """O update mais velho que se pode escolher: o nivel da ISO (o build o
    grava). Numa instalacao de antes dele: o nivel antes do primeiro update
    aplicado aqui (as copias em STATE/backup), ou o de agora."""
    try:
        with open(BASE, encoding='utf-8') as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        pass
    base = read_level()
    try:
        applied = [int(d[:4]) for d in os.listdir(os.path.join(STATE, 'backup')) if re.match(r'\d{4}-', d)]
        if applied:
            base = min(base, min(applied) - 1)
    except OSError:
        pass
    base = max(base, 0)
    try:
        os.makedirs(os.path.dirname(BASE), exist_ok=True)
        with open(BASE, 'w', encoding='utf-8') as f:
            f.write('%d\n' % base)
    except OSError:
        pass
    return base


