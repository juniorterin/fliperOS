def write_result(args, lines):
    text = ''.join('%s\n' % line for line in lines)
    if getattr(args, 'result', None):
        with open(args.result, 'w', encoding='utf-8') as f:
            f.write(text)
    elif not getattr(args, 'progress', False):
        sys.stdout.write(text)


def cmd_level(args):
    print(read_level())


def cmd_check(args):
    for n, _, _, reboot, title in pending():
        print('%d\t%s\t%s' % (n, 'yes' if reboot else 'no', title))


def cmd_plan(args):
    """O aviso antes de aplicar: o ensaio da arvore do ultimo pendente (a
    que fica no fim) contra a raiz de agora."""
    say(args.progress, '@step 5 Reading the update list')
    todo = pending()
    lines = ['pending=%d' % len(todo)]
    if todo:
        src = download(todo[-1], args.progress, 20)
        say(args.progress, '@step 60 Checking which files change')
        changed, local, unknown, exact = classify(src, ROOT)
        lines += ['changed=%d' % len(changed), 'exact=%s' % ('yes' if exact else 'no')]
        lines += ['local\t/%s' % p for p in local] + ['unknown\t/%s' % p for p in unknown]
    write_result(args, lines)
    say(args.progress, '@step 100 Done')


def cmd_apply(args):
    todo = pending()
    lines, done = [], []
    with lock():
        for i, patch in enumerate(todo):
            n = patch[0]
            span = 100 // max(len(todo), 1)
            pct = i * span
            if read_level() != n - 1:
                raise Fail('update %d needs update %d first' % (n, n - 1))
            src = download(patch, args.progress, pct + 2)
            say(args.progress, '@step %d Update %d: saving the files it replaces' % (pct + span // 5, n))
            changed, local, unknown, _ = classify(src, ROOT)
            saved = backup(n, ROOT, changed)
            log('update %d (%s): %d files replaced, %d with local changes, backup %s'
                % (n, patch[4], len(changed), len(local) + len(unknown), saved))
            say(args.progress, '@step %d Update %d: %s' % (pct + span // 3, n, patch[4]))
            env = dict(os.environ, SRC=src, FLIPEROS_UPDATE='1', FLIPEROS_UPDATE_SRC=src)
            steps = [INSTALL]
            script = os.path.join(src, 'updates', '%04d.sh' % n)
            if os.path.isfile(script):
                steps.append('bash "%s"' % script)
            for step in steps:
                with open(LOG, 'a', encoding='utf-8') as out:
                    proc = subprocess.Popen(['bash', '-c', step], env=env, stdout=subprocess.PIPE,
                                            stderr=subprocess.STDOUT, text=True)
                    for line in proc.stdout:
                        out.write(line)
                        if line.startswith('== '):
                            say(args.progress, '@msg %s' % line[3:].strip()[:70])
                    if proc.wait():
                        lines.append('failed\t%d\tbackup\t%s' % (n, saved))
                        write_result(args, lines)
                        raise Fail('update %d stopped (exit %d, see %s); its backup is in %s'
                                   % (n, proc.returncode, LOG, saved))
            record(src, ROOT, changed)
            write_level(n)
            done.append(n)
            lines.append('applied\t%d\t%s\t%s\t%s' % (n, 'yes' if patch[3] else 'no', saved, patch[4]))
            log('update %d applied' % n)
    lines.append('level=%d' % read_level())
    write_result(args, lines)
    say(args.progress, '@step 100 FliperOS is up to date')


def cmd_restore(args):
    base = os.path.join(STATE, 'backup')
    found = sorted(d for d in os.listdir(base) if d.startswith('%04d-' % args.n)) if os.path.isdir(base) else []
    if not found:
        raise Fail('no backup of update %d' % args.n)
    src = os.path.join(base, found[-1])
    count = 0
    for rel in walk(src):
        target = os.path.join(ROOT, rel)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        if os.path.lexists(target):
            os.remove(target)
        if os.path.islink(os.path.join(src, rel)):
            os.symlink(os.readlink(os.path.join(src, rel)), target)
        else:
            shutil.copy2(os.path.join(src, rel), target)
        count += 1
    print('restored=%d' % count)
    print('from=%s' % src)


def cmd_record(args):
    """Depois do tools/cabinet-update.sh (o push de desenvolvimento) e no
    build da ISO: o manifesto e o nivel do ultimo patch do updates/index
    da ORIGEM (essa arvore ja tem todos)."""
    count = record(os.path.abspath(args.src), ROOT)
    last = 0
    try:
        with open(os.path.join(args.src, 'updates', 'index'), encoding='utf-8') as f:
            for line in f:
                if line[:1].isdigit():
                    last = max(last, int(line.split('\t', 1)[0]))
    except OSError:
        pass
    write_level(max(last, read_level()))
    print('manifest=%d' % count)
    print('level=%d' % read_level())


def main():
    global ROOT, STATE, LEVEL
    p = argparse.ArgumentParser(prog='fliperos-update')
    sub = p.add_subparsers(dest='cmd', required=True)
    sub.add_parser('level').set_defaults(func=cmd_level)
    sub.add_parser('check').set_defaults(func=cmd_check)
    for name, func in (('plan', cmd_plan), ('apply', cmd_apply)):
        s = sub.add_parser(name)
        s.add_argument('--progress', action='store_true')
        s.add_argument('--result')
        s.set_defaults(func=func)
    s = sub.add_parser('restore')
    s.add_argument('n', type=int)
    s.set_defaults(func=cmd_restore)
    s = sub.add_parser('record')
    s.add_argument('src')
    s.add_argument('--root')
    s.set_defaults(func=cmd_record)
    args = p.parse_args()
    if getattr(args, 'root', None):
        # Outra raiz (o chroot do build): o manifesto e o nivel ficam nela.
        ROOT = args.root
        STATE = os.path.join(ROOT, STATE.lstrip('/'))
        LEVEL = os.path.join(ROOT, LEVEL.lstrip('/'))
    try:
        args.func(args)
    except Fail as e:
        log('error: %s' % e)
        if getattr(args, 'progress', False):
            print('@fail FliperOS update|%s' % e, flush=True)
        sys.exit('fliperos-update: %s' % e)


if __name__ == '__main__':
    main()
