def dry_run(src, root):
    """{caminho relativo: digest novo} do que o fliperos-rootfs.sh de SRC
    escreveria em ROOT; None sem overlay (nem DRYRUN)."""
    base = tempfile.mkdtemp(prefix='fliperos-update-', dir='/run' if os.path.isdir('/run') else None)
    upper, work, merged = (os.path.join(base, d) for d in ('upper', 'work', 'merged'))
    mounted = scratch = False
    if not DRYRUN:
        # Um tmpfs so do ensaio: o /run e pequeno, e a escrita do
        # fliperos-rootfs.sh o enchia ("No space left on device"; o aviso
        # passava a dar todos os arquivos como mudados aqui). Ele so ocupa a
        # RAM do que for escrito.
        scratch = subprocess.run(['mount', '-t', 'tmpfs', '-o', 'size=50%,mode=0700', 'fliperos-update', base],
                                 capture_output=True).returncode == 0
    for d in (upper, work, merged):
        os.makedirs(d)
    try:
        if DRYRUN:
            r = subprocess.run(['bash', '-c', DRYRUN], env=dict(os.environ, SRC=src, UPPER=upper),
                               capture_output=True, text=True)
            if r.returncode:
                log('dry run failed: %s' % r.stderr.strip()[-300:])
                return None
        else:
            r = subprocess.run(['mount', '-t', 'overlay', 'overlay', '-o',
                                'lowerdir=%s,upperdir=%s,workdir=%s' % (root, upper, work), merged],
                               capture_output=True, text=True)
            if r.returncode:
                log('overlay failed: %s' % r.stderr.strip())
                return None
            mounted = True
            r = subprocess.run(['bash', os.path.join(src, 'fliperos-rootfs.sh'), merged],
                               capture_output=True, text=True)
            if r.returncode:
                log('dry run of fliperos-rootfs.sh failed: %s' % r.stderr.strip()[-300:])
                return None
        # O walk deixa de fora as marcas de apagado do overlay (dispositivo 0/0).
        return {rel: digest(os.path.join(upper, rel)) for rel in walk(upper) if not skipped(rel)}
    finally:
        if mounted:
            subprocess.run(['umount', '-l', merged], capture_output=True)
        if scratch:
            subprocess.run(['umount', '-l', base], capture_output=True)
        shutil.rmtree(base, ignore_errors=True)


def known_files(root):
    out = {}
    for part in KNOWN:
        path = os.path.join(root, part)
        rels = [part] if os.path.isfile(path) else [os.path.join(part, r) for r in walk(path)] \
            if os.path.isdir(path) else []
        for rel in rels:
            if not skipped(rel):
                out[rel] = digest(os.path.join(root, rel))
    return out


def classify(src, root):
    """(trocados, mudados aqui, sem registro, ensaio_ok): os que o patch
    troca; dos trocados, os que nao estao como o manifesto diz; e os que o
    manifesto nao conhece (instalacao antiga)."""
    manifest = read_manifest()
    new = dry_run(src, root)
    if new is None:
        # Sem o ensaio: os do manifesto que mudaram aqui podem ser trocados.
        local = [p for p, v in manifest.items() if digest(os.path.join(root, p)) not in (v, None)]
        return sorted(local), sorted(local), [], False
    changed, local, unknown = [], [], []
    for rel, value in new.items():
        live = digest(os.path.join(root, rel))
        if live is None or live == value:
            continue
        changed.append(rel)
        if rel not in manifest:
            unknown.append(rel)
        elif manifest[rel] != live:
            local.append(rel)
    return sorted(changed), sorted(local), sorted(unknown), True


def record(src, root, extra=()):
    """O manifesto depois de uma instalacao: o que o patch escreve (pelo
    ensaio) mais o que ja estava nele, como esta agora."""
    manifest = read_manifest()
    new = dry_run(src, root)
    paths = set(new) if new is not None else set(known_files(root))
    paths |= set(manifest) | set(extra)
    data = {}
    for rel in paths:
        value = digest(os.path.join(root, rel))
        if value is not None and not skipped(rel):
            data[rel] = value
    write_manifest(data)
    return len(data)


def backup(n, root, paths, prefix=''):
    """A copia do que o update N troca, em STATE/backup/NNNN-DATA (o goto
    para tras: back-NNNN-DATA, fora do restore N)."""
    dest = os.path.join(STATE, 'backup', '%s%04d-%s' % (prefix, n, time.strftime('%Y%m%d-%H%M%S')))
    for rel in paths:
        src = os.path.join(root, rel)
        if not os.path.lexists(src):
            continue
        target = os.path.join(dest, rel)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        if os.path.islink(src):
            os.symlink(os.readlink(src), target)
        else:
            shutil.copy2(src, target)
    os.makedirs(dest, exist_ok=True)
    return dest


