SKIP = ('home/fliperos/.config/falkon', 'home/fliperos/.config/pulse', 'etc/fliperos/patch-level',
        'usr/local/share/fliperos/romclean', 'usr/local/share/fliperos/mame2010.xml.xz')


def say(progress, line):
    if progress:
        print(line, flush=True)


def log(text):
    try:
        with open(LOG, 'a', encoding='utf-8') as f:
            f.write('%s %s\n' % (time.strftime('%Y-%m-%d %H:%M:%S'), text))
    except OSError:
        pass


class Fail(Exception):
    pass


