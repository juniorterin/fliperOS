# O teclado na tela do desktop: o Onboard (config/fliperos-lxde o abre e
# config/fliperos-deskpad o liga ao controle). Abre quando se CLICA num campo
# de texto (auto-show, pelo AT-SPI) e sai quando o foco sai, e num terminal (o
# deskpad o acha pela classe da janela). O auto-show nasce desligado e o
# deskpad o liga so no instante de um clique do controle: mexer o ponteiro, uma
# janela que abre ou um terminal que escreve nao abrem o teclado (com um
# teclado ou mouse de verdade ele tambem nao abre; o botao 3 do controle o abre
# a qualquer hora);
# encaixado embaixo, com as teclas na proporcao do layout (a altura do encaixe
# segue a tela, no fliperos-lxde). Escuro, sem dicas e minimizado ao abrir.
# Os eventos pelo GTK e as teclas pelo XTest: os cliques do controle chegam
# pelo XTest, e o Onboard caia com eles pelo XInput (visto no Xvfb).
[org.onboard]
use-system-defaults=false
layout='Compact'
theme='Nightshade'
system-theme-tracking-enabled=false
start-minimized=true
show-tooltips=false

[org.onboard.auto-show]
enabled=false

[org.onboard.keyboard]
input-event-source='GTK'
key-synth='XTest'

[org.onboard.window]
docking-enabled=true
docking-edge='bottom'
docking-shrink-workarea=false
docking-aspect-change-range=[1.0, 1.0]
keep-aspect-ratio=true
force-to-top=true
window-decoration=false

[org.onboard.window.landscape]
dock-expand=true
