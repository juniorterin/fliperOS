# Os servicos em "After boot" (Setup > System > Services) sobem depois que
# a primeira tela abre (fliperos-services-screen.timer). Este e a reserva:
# sem tela nenhuma (o tty1 nao abriu), eles sobem 3 min depois do boot,
# para o SSH e o painel web chegarem mesmo assim.
[Unit]
Description=FliperOS services after boot (if no screen opens)

[Timer]
OnBootSec=3min
AccuracySec=1s
Unit=fliperos-services-late.service

[Install]
WantedBy=timers.target
