+// --netplay host|join: no dialogs to click. The host starts the game when `players` have it;
+// a guest retries for a while (the host may still be opening). Dolphin quits if it fails.
+void MainWindow::StartNetPlayFromCommandLine(bool host, const std::string& game_path,
+                                             int players)
+{
+  auto game = std::make_shared<UICommon::GameFile>(game_path);
+  if (!game->IsValid())
+  {
+    ERROR_LOG_FMT(NETPLAY, "--netplay: cannot read the game {}", game_path);
+    QTimer::singleShot(0, this, [] { QGuiApplication::exit(1); });
+    return;
+  }
+  m_netplay_dialog->SetCommandLineGame(game, host ? std::max(players, 1) : 0);
+  auto attempt = std::make_shared<std::function<void(int)>>();
+  *attempt = [this, host, game, weak = std::weak_ptr(attempt)](int left) {
+    if (host ? NetPlayHost(*game) : NetPlayJoin())
+      return;
+    if (host || left <= 0)
+    {
+      QGuiApplication::exit(1);
+      return;
+    }
+    QTimer::singleShot(1000, this, [weak, left] {
+      if (const auto next = weak.lock())
+        (*next)(left - 1);
+    });
+  };
+  m_netplay_retry = attempt;
+  QTimer::singleShot(0, this, [attempt] { (*attempt)(20); });
+}
+
 void MainWindow::NetPlayQuit()
 {
   Settings::Instance().ResetNetPlayClient();
