#!/usr/bin/env bash
# Setup > Games > Emulators & Games: os emuladores do menu do desktop, quais estao
# instalados e a instalacao dos que nao vem na imagem, um por um.
#
#   fliperos-emulators list                    nome|instalado (0 ou 1)|tipo|descricao
#   fliperos-emulators installed NOME          status 0 se instalado
#   fliperos-emulators versions                nome|versao instalada
#   fliperos-emulators latest NOME             instalada|a do update|same, new ou unknown
#   fliperos-emulators install NOME [--progress] [--source PASTA]   (como root)
#   fliperos-emulators edge-available NOME     status 0 se compila o mais novo
#   fliperos-emulators edge NOME [--progress]  compila o mais novo (como root)
#   fliperos-emulators edge-off NOME           volta ao pacote (como root)
#   fliperos-emulators edge-status NOME        o commit do mais novo instalado
#   fliperos-emulators restorable              nome|1 se tem configuracao para restaurar
#   fliperos-emulators restore NOME [--progress]  as configuracoes originais do
#                                              FliperOS (como root; as de agora vao
#                                              para ~/config-backup/NOME-DATA)
#
# tipo: image (compilado na imagem: nao se instala depois), package (um .deb
# pronto, fora da imagem: o hbgroovymame, o odin e o xemu-chihiro; baixado do release
# "packages" pela updates/packages.list), fetch (baixado do
# site de quem o faz: o Fightcade, config/fliperos-fightcade, e o DuckStation,
# config/fliperos-duckstation) e source (um jogo convertido: config/
# fliperos-kof; baixado do itch.io, ou da pasta que a pessoa traz, --source
# PASTA).
#
# Com --progress, as etapas saem no formato da tela de progresso do Setup
# (lib/progress.sh); a saida dos comandos vai para o stderr (o log do Setup).
set -uo pipefail

user=${FLIPEROS_USER:-fliperos}
home=${FLIPEROS_HOME:-$(getent passwd "$user" 2> /dev/null | cut -d: -f6)}
home=${home:-/home/$user}
root=${FLIPEROS_EMULATORS_ROOT:-}
fightcade=${FLIPEROS_FIGHTCADE:-/opt/fliperos/bin/fliperos-fightcade}
duckstation=${FLIPEROS_DUCKSTATION:-/opt/fliperos/bin/fliperos-duckstation}
kof=${FLIPEROS_KOF:-/usr/local/bin/fliperos-kof}

# nome|tipo|o arquivo que diz que esta instalado|descricao. Os caminhos sao
# os do TryExec de config/applications: o que o menu do desktop mostra.
table() {
  cat << EOF
retroarch|image|$root/usr/local/bin/retroarch|RetroArch (consoles and arcade cores)
groovymame|image|$root/usr/local/bin/groovymame|GroovyMAME (arcade)
hbgroovymame|package|$root/usr/local/libexec/hbgroovymame|HBMAME with Switchres (arcade hacks and homebrews)
odin|package|$root/usr/local/bin/odin|Odin (Sega Hikaru and Gaelco 3D arcades)
xemu-chihiro|package|$root/usr/local/bin/xemu-chihiro|xemu (Sega Chihiro arcades)
anybor|package|$root/opt/fliperos/retroarch/cores/anybor_libretro.so|AnyBOR (OpenBOR core for RetroArch)
flycast|image|$root/usr/local/bin/flycast|Flycast (Dreamcast, Naomi, Atomiswave)
pcsx2|image|$root/usr/local/bin/pcsx2|PCSX2 (PlayStation 2)
pcsx2x6|image|$root/usr/local/bin/pcsx2x6|PCSX2x6 (Namco System 246/256)
dolphin|image|$root/usr/local/bin/dolphin-emu|Dolphin (GameCube, Wii, Triforce)
openbor|image|$root/usr/local/bin/openbor|OpenBOR (beat 'em ups)
keisho|image|$root/usr/local/bin/keisho|Keisho (Sega Model 2 and 3)
fightcade|fetch|$root/opt/fliperos/fightcade/fightcade|Fightcade 2 (online arcade)
duckstation|fetch|$root/usr/local/bin/duckstation|DuckStation (PlayStation)
kof|source|$home/roms/ikemen/kof-final-attack/Ikemen_GO_Linux|KOF Final Attack (Ikemen GO, 4:3)
EOF
}

field() {
  table | awk -F'|' -v n="$1" -v f="$2" '$1 == n { print $f; exit }'
}

emulator_installed() {
  local file
  file=$(field "$1" 3)
  [[ -n $file && -x $file ]]
}

# ── Versoes ──────────────────────────────────────────────────────
# A versao instalada sai de arquivos, sem abrir o emulador: o que o build da
# imagem gravou (emulator-versions, nome=versao), o metainfo dos AppImages, o
# VERSION.txt do Fightcade e, numa imagem
# antiga sem o arquivo, o texto de versao do binario do GroovyMAME. Um
# emulador que vem num pacote do FliperOS (o RetroArch) grava a sua em
# emulator-versions.d/NOME, que vale antes: o pacote atualizado pela rede
# troca a versao sem mexer no arquivo da imagem.
versions_file=${FLIPEROS_EMULATOR_VERSIONS:-$root/usr/local/share/fliperos/emulator-versions}
versions_dir=${FLIPEROS_EMULATOR_VERSIONS_DIR:-$root/usr/local/share/fliperos/emulator-versions.d}
# O que a proxima imagem do FliperOS traz (as versoes fixadas no build).
mkiso_url=${FLIPEROS_MKISO_URL:-https://raw.githubusercontent.com/juniorterin/fliperOS/main/fliperos-mkiso.sh}
net_timeout=${FLIPEROS_VERSION_TIMEOUT:-8}

metainfo_version() {
  sed -n 's/.*<release [^>]*version="v\{0,1\}\([^"]*\)".*/\1/p' "$1"/usr/share/metainfo/*.xml 2> /dev/null | head -n 1
}

emulator_version() {
  local name=$1 v=""
  [[ -f $versions_dir/$name ]] && v=$(head -n 1 "$versions_dir/$name")
  [[ -n $v ]] || v=$(awk -F= -v n="$name" '$1 == n { sub(/^[^=]*=/, ""); print; exit }' "$versions_file" 2> /dev/null)
  if [[ -z $v ]]; then
    case $name in
      pcsx2) v=$(metainfo_version "$root/opt/pcsx2") ;;
      duckstation) v=$(metainfo_version "$root/opt/duckstation") ;;
      fightcade) v=$(tr -d '[:space:]' < "$root/opt/fliperos/fightcade/VERSION.txt" 2> /dev/null) ;;
      groovymame)
        v=$(grep -a -o -m 1 -E '0\.[0-9]{3} \((unknown|mame[0-9]+)\)' "$root/usr/local/libexec/groovymame" 2> /dev/null |
          head -n 1)
        v=${v%% *}
        ;;
    esac
  fi
  [[ -n $v ]] && printf '%s\n' "$v"
}

# remote_head URL [REF]: o commit curto do ramo principal (ou de REF).
remote_head() {
  timeout "$net_timeout" git ls-remote "$1" "${2:-HEAD}" 2> /dev/null | awk 'NR == 1 { print substr($1, 1, 7) }'
}

# pinned VARIAVEL [URL]: o valor fixado no fliperos-mkiso.sh do repositorio
# (ou na receita do pacote em URL).
pinned() {
  timeout "$net_timeout" curl -fsL "${2:-$mkiso_url}" 2> /dev/null |
    sed -n "s/^$1=\"\\([^\"]*\\)\".*/\\1/p" | head -n 1
}

# emulator_latest NOME: a versao que o update traz (precisa da rede; sem
# ela, nada). As da imagem mudam com a proxima imagem do FliperOS.
emulator_latest() {
  local v
  case $1 in
    pcsx2) pinned PKG_VERSION "${mkiso_url%/*}/packaging/packages/fliperos-pcsx2.sh" ;;
    pcsx2x6) pinned PCSX2X6_VERSION ;;
    # A versao da receita do pacote, a que o proximo update leva.
    dolphin) pinned PKG_VERSION "${mkiso_url%/*}/packaging/packages/fliperos-dolphin.sh" ;;
    groovymame)
      v=$(pinned GROOVYMAME_TAG "${mkiso_url%/*}/packaging/packages/fliperos-groovymame.sh")
      [[ $v =~ ^gm0([0-9]{3}) ]] && echo "0.${BASH_REMATCH[1]}"
      ;;
    # A versao da receita do pacote opcional, a que o update e a lista levam.
    hbgroovymame | odin | xemu-chihiro) pinned PKG_VERSION "${mkiso_url%/*}/packaging/packages/fliperos-$1.sh" ;;
    openbor)
      v=$(pinned OPENBOR_COMMIT "${mkiso_url%/*}/packaging/packages/fliperos-openbor.sh")
      [[ -n $v ]] && echo "${v:0:7}"
      ;;
    retroarch)
      # O commit da receita do pacote, o que o proximo update leva.
      v=$(pinned RA_COMMIT "${mkiso_url%/*}/packaging/packages/fliperos-retroarch.sh")
      [[ -n $v ]] && echo "${v:0:7}"
      ;;
    flycast)
      v=$(pinned FLYCAST_COMMIT "${mkiso_url%/*}/packaging/packages/fliperos-flycast.sh")
      [[ -n $v ]] && echo "${v:0:7}"
      ;;
    keisho)
      v=$(pinned KEISHO_COMMIT "${mkiso_url%/*}/packaging/packages/fliperos-keisho.sh")
      [[ -n $v ]] && echo "${v:0:7}"
      ;;
    duckstation) remote_head https://github.com/stenzek/duckstation refs/tags/latest ;;
  esac
}

# same_version INSTALADA NOVA: a mesma (o commit curto dentro da instalada,
# como "0.1-12083-g00e299795" e 00e2997).
same_version() {
  [[ -n $1 && -n $2 ]] && { [[ $1 == "$2" ]] || [[ $2 =~ ^[0-9a-f]{7}$ && $1 == *"$2"* ]]; }
}

progress=0 label=""
say() {
  if ((progress)); then printf '@step %s %s\n' "$1" "$2"; else printf '%s\n' "$2"; fi
}
fail() {
  if ((progress)); then printf '@fail %s|%s\n' "$label" "$1"; else printf 'fliperos-emulators: %s\n' "$1" >&2; fi
  exit 1
}

# as_user COMANDO...: o que fica na pasta pessoal roda como o usuario.
as_user() {
  if ((EUID == 0)) && [[ $user != root ]]; then
    runuser -u "$user" -- env HOME="$home" "$@"
  else
    HOME=$home "$@"
  fi
}

# ── Um pacote pronto, fora da imagem ─────────────────────────────
# O hbgroovymame (o HBMAME leva horas para compilar) e o odin: o .deb vem
# pronto (packaging/packages/fliperos-NOME.sh, PKG_OPTIONAL), do release
# "packages" do GitHub, na versao e com o sha256 da updates/packages.list. Um
# gabinete que o tem sobe de versao pelos updates (a linha da lista e
# "installed"); isto e para quem ainda nao o tem, ou quer a versao nova ja.
packages_list_url=${FLIPEROS_PACKAGES_LIST_URL:-https://raw.githubusercontent.com/juniorterin/fliperOS/main/updates/packages.list}
packages_url=${FLIPEROS_PACKAGES_URL:-https://github.com/juniorterin/fliperOS/releases/download/packages}
packages_cache=${FLIPEROS_PACKAGES_CACHE:-/var/cache/fliperos/packages}
packages_arch=${FLIPEROS_PACKAGES_ARCH:-amd64}

# package_sum ARQUIVO: o sha256 (vazio: sem o arquivo).
package_sum() {
  sha256sum "$1" 2> /dev/null | cut -d' ' -f1
}

package_install() {
  local pkg=fliperos-$1 row version sum file deb total have pid
  say 3 "Looking for $label"
  row=$(timeout "$net_timeout" curl -fsL "$packages_list_url" 2> /dev/null |
    awk -F'\t' -v n="$pkg" '$1 == n { print; exit }')
  [[ -n $row ]] || fail "$label is not published yet, or there is no network"
  IFS=$'\t' read -r _ version sum _ <<< "$row"
  file=${pkg}_${version}_${packages_arch}.deb
  deb=$packages_cache/$file
  mkdir -p "$packages_cache" 2> /dev/null || fail "could not create $packages_cache"
  if [[ $(package_sum "$deb") != "$sum" ]]; then
    total=$(timeout "$net_timeout" curl -fsIL "$packages_url/$file" 2> /dev/null |
      awk 'tolower($1) == "content-length:" { n = $2 + 0 } END { print n + 0 }')
    say 5 "Downloading $label"
    rm -f "$deb.part"
    curl -fsSL -m 3600 -o "$deb.part" "$packages_url/$file" >&2 &
    pid=$!
    # A barra anda com o arquivo que chega (sem o tamanho, fica onde esta).
    while kill -0 "$pid" 2> /dev/null; do
      sleep 1
      have=$(stat -c %s "$deb.part" 2> /dev/null || echo 0)
      ((total > 0)) && say $((5 + have * 60 / total)) "Downloading $label ($((have / 1048576)) of $((total / 1048576)) MB)"
    done
    wait "$pid" || { rm -f "$deb.part"; fail "could not download $file"; }
    if [[ $(package_sum "$deb.part") != "$sum" ]]; then
      rm -f "$deb.part"
      fail "$file does not match the sha256 of the list"
    fi
    mv -f "$deb.part" "$deb"
  fi
  say 70 "Installing $label"
  DEBIAN_FRONTEND=noninteractive apt-get -y -o DPkg::Lock::Timeout=120 install "$deb" >&2 ||
    fail "could not install $file (details in the log)"
  say 100 "$label installed"
}

emulator_install() {
  local name=$1 source=$2 kind args=()
  kind=$(field "$name" 2)
  label=$(field "$name" 4)
  ((progress)) && args=(--progress)
  case $kind in
    image) fail "it comes compiled in the FliperOS image, and this image was built without it" ;;
    package) package_install "$name" ;;
    fetch)
      local fetcher
      case $name in
        fightcade) fetcher=$fightcade ;;
        duckstation) fetcher=$duckstation ;;
      esac
      [[ -x $fetcher ]] || fail "the installer ($fetcher) is missing"
      "$fetcher" fetch "${args[@]}"
      ;;
    source)
      [[ -x $kof ]] || fail "the installer ($kof) is missing"
      # Sem --source, o jogo vem do itch.io.
      as_user "$kof" install ${source:+"$source"} "${args[@]}"
      ;;
    *) fail "unknown emulator: $name" ;;
  esac
}

# ── O mais novo do projeto (edge) ────────────────────────────────
# Um emulador num pacote do FliperOS (o Flycast) cuja receita sabe de onde vem
# o codigo (PKG_UPSTREAM): a mesma receita compila aqui o ultimo commit do
# projeto, com os patches do FliperOS. Os arquivos do pacote ficam guardados
# (dpkg-divert, com .fliperos-package no fim): os updates continuam trocando o
# pacote sem apagar este build, e edge-off volta ao pacote. Um patch que nao
# encaixa mais no codigo novo para tudo: o pacote fica.
recipes=${FLIPEROS_RECIPES:-$root/usr/local/share/fliperos/packaging/packages}
edge_state=${FLIPEROS_EDGE_STATE:-$root/var/lib/fliperos/edge}
edge_work=${FLIPEROS_EDGE_WORK:-/var/cache/fliperos/edge}

# edge_recipe NOME imprime a receita do pacote, se ela compila o mais novo.
edge_recipe() {
  local recipe=$recipes/fliperos-$1.sh
  [[ -f $recipe ]] && grep -q '^PKG_UPSTREAM=' "$recipe" && printf '%s\n' "$recipe"
}

# edge_remove NOME: o build sai e os arquivos do pacote voltam.
edge_remove() {
  local name=$1 rel list=$edge_state/$1.files
  [[ -f $list ]] || return 0
  while IFS= read -r rel; do
    [[ -n $rel ]] || continue
    rm -f "$root$rel"
    if [[ -n $(dpkg-divert --list "$rel" 2> /dev/null) ]]; then
      dpkg-divert --quiet --local --rename --remove "$rel" >&2 || return 1
    fi
  done < "$list"
  rm -f "$list" "$edge_state/$name.commit"
}

# edge_install NOME STAGING COMMIT: os arquivos do build no lugar dos do
# pacote, que vao para o lado. Um arquivo igual ao do pacote fica como esta:
# o GroovyMAME traz milhares (listas de software, shaders), e desviar cada um
# levava minutos para ir e para voltar.
edge_install() {
  local name=$1 staging=$2 commit=$3 path rel list=$edge_state/$1.files
  mkdir -p "$edge_state"
  edge_remove "$name" || return 1
  : > "$list"
  while IFS= read -r -d '' path; do
    rel=${path#"$staging"}
    cmp -s "$path" "$root$rel" && continue
    if dpkg-query -S "$rel" > /dev/null 2>&1 && [[ -z $(dpkg-divert --list "$rel" 2> /dev/null) ]]; then
      dpkg-divert --quiet --local --rename --divert "$rel.fliperos-package" --add "$rel" >&2 || return 1
    fi
    printf '%s\n' "$rel" >> "$list"
    install -D -m "$(stat -c %a "$path")" "$path" "$root$rel" || return 1
  done < <(find "$staging" -type f -print0)
  printf '%s\n' "$commit" > "$edge_state/$name.commit"
}

edge_build() {
  local name=$1 recipe
  label=$(field "$name" 4)
  recipe=$(edge_recipe "$name") || fail "$label can't be built here"
  (
    # shellcheck source=/dev/null
    . "$recipe"
    say 5 "Asking for the newest $label"
    if [[ -n ${PKG_EDGE_RELEASE:-} ]]; then
      # O ultimo release estavel do GitHub (o PCSX2: as tags tambem marcam os
      # builds noturnos).
      head=$(timeout "$net_timeout" curl -fsSL "https://api.github.com/repos/${PKG_UPSTREAM#https://github.com/}/releases/latest" \
        2> /dev/null | sed -n 's/^ *"tag_name": *"\([^"]*\)".*/\1/p' | head -n 1)
      [[ -n $head ]] || fail "could not reach $PKG_UPSTREAM (no network?)"
    elif [[ -n ${PKG_EDGE_TAGS:-} ]]; then
      # A tag estavel mais recente (o Dolphin), nao o master.
      head=$(timeout "$net_timeout" git ls-remote --tags --refs "$PKG_UPSTREAM" 2> /dev/null |
        sed 's|.*refs/tags/||' | grep -E "$PKG_EDGE_TAGS" | sort -V | tail -n 1)
      [[ -n $head ]] || fail "could not reach $PKG_UPSTREAM (no network?)"
    else
      head=$(timeout "$net_timeout" git ls-remote "$PKG_UPSTREAM" HEAD 2> /dev/null | awk 'NR == 1 { print $1 }')
      [[ $head =~ ^[0-9a-f]{40}$ ]] || fail "could not reach $PKG_UPSTREAM (no network?)"
    fi
    printf -v "$PKG_COMMIT_VAR" '%s' "$head"
    # Um commit aparece curto; uma tag (2612, gm0289sr222f), inteira.
    shown=$head
    [[ $head =~ ^[0-9a-f]{40}$ ]] && shown=${head:0:7}
    say 10 "Installing the build tools"
    # shellcheck disable=SC2086 # um pacote por palavra
    { apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends \
      $PKG_BUILD_DEPS; } >&2 || fail "could not install the build tools (no network?)"
    rm -rf "${edge_work:?}/$name"
    SRC=$edge_work/$name/src STAGING=$edge_work/$name/staging
    mkdir -p "$SRC" "$STAGING"
    # FLIPEROS_EDGE: a receita sabe que o commit nao e o fixado nela (o
    # GroovyMAME nao confere o sha256 do release novo).
    FLIPEROS_EDGE=1
    export SRC STAGING FLIPEROS_EDGE
    # PKG_EDGE_WAIT: quanto demora, quando nao sao minutos (o GroovyMAME
    # compila o MAME inteiro com os patches: horas).
    say 30 "Preparing $label $shown (${PKG_EDGE_WAIT:-several minutes})"
    log=$edge_work/$name/build.log
    if ! pkg_build > "$log" 2>&1; then
      cat "$log" >&2
      grep -q 'patch failed\|does not apply' "$log" &&
        fail "the FliperOS patch does not fit $label $shown; the package stays"
      fail "the build failed (details in the log); the package stays"
    fi
    say 90 "Installing it over the package (the package stays saved)"
    edge_install "$name" "$STAGING" "$head" || fail "could not install the build; the package stays"
    rm -rf "${edge_work:?}/$name"
    say 100 "$label $shown installed"
  ) || exit 1
}

# ── Restaurar as configuracoes originais ─────────────────────────
# Emulators & Games > um emulador > Restore FliperOS settings: o que a pessoa
# (ou o menu do proprio emulador) mudou volta ao que o FliperOS instala. A
# configuracao de agora nao se perde: vai inteira para
# ~/config-backup/NOME-DATA, com os mesmos caminhos (etc/... para o que fica
# em /etc). ROMs, saves, nvram, cheats e arte nao sao configuracao e ficam.
# Depois, as originais: as que o abridor do emulador (fliperos-x11-run,
# fliperos-kms-run, o comando groovymame) refaz quando faltam ficam so
# faltando; as que a imagem instala vem de $defaults (fliperos-rootfs.sh); e
# o que o Setup decide por maquina (botoes, monitor, latencia, a largura do
# CRT SwitchRes) e gravado de novo (fliperos-setup --reapply-emulators).
defaults=${FLIPEROS_EMULATOR_DEFAULTS:-$root/usr/local/share/fliperos/emulator-defaults}
setup_cmd=${FLIPEROS_SETUP_CMD:-$root/usr/local/bin/fliperos-setup}
mame_etc=${FLIPEROS_MAME_ETC:-$root/etc/fliperos/mame}
hbmame_etc=${FLIPEROS_HBMAME_ETC:-$root/etc/fliperos/hbmame}

# restore_paths NOME: o que e configuracao do emulador, um caminho por linha
# (os de ~ sem o ~/, os absolutos com a /). Nada: o emulador nao tem o que
# restaurar.
restore_paths() {
  case $1 in
    retroarch) printf '%s\n' .config/retroarch/retroarch.cfg .config/retroarch/retroarch-core-options.cfg \
      .config/retroarch/config ;;
    groovymame) printf '%s\n' "$mame_etc/mame.ini" "$mame_etc/ui.ini" "$mame_etc/plugin.ini" .mame/cfg ;;
    hbgroovymame) printf '%s\n' "$hbmame_etc/hbmame.ini" .hbmame/cfg ;;
    flycast) printf '%s\n' .config/flycast/emu.cfg .config/flycast/mappings ;;
    pcsx2) printf '%s\n' .config/PCSX2/inis ;;
    pcsx2x6) printf '%s\n' .config/PCSX2x6/inis ;;
    dolphin) printf '%s\n' .config/dolphin-emu ;;
    duckstation) printf '%s\n' .local/share/duckstation/settings.ini ;;
    keisho) printf '%s\n' .config/keisho/keisho.ini ;;
    odin) printf '%s\n' .local/share/odin/odin.ini ;;
    xemu-chihiro) printf '%s\n' .local/share/xemu-chihiro/xemu.toml ;;
  esac
}

# restore_full CAMINHO: o caminho de verdade (os relativos na home).
restore_full() {
  if [[ $1 == /* ]]; then printf '%s\n' "$1"; else printf '%s\n' "$home/$1"; fi
}

# restore_has NOME: status 0 se ha alguma configuracao dele para restaurar.
restore_has() {
  local p
  while IFS= read -r p; do
    [[ -e $(restore_full "$p") ]] && return 0
  done < <(restore_paths "$1")
  return 1
}

# restore_defaults NOME: as originais que a imagem instala (o resto, o
# abridor do emulador refaz).
restore_defaults() {
  local name=$1 file dir
  case $name in
    retroarch)
      # Os remaps e os switchres.ini por core do FliperOS (config/retroarch-remaps,
      # config/retroarch-switchres).
      for file in "$defaults"/retroarch-remaps/*.rmp; do
        [[ -f $file ]] || continue
        dir=$home/.config/retroarch/config/remaps/$(basename "$file" .rmp)
        as_user mkdir -p "$dir" && install -m644 -o "$user" -g "$user" "$file" "$dir/"
      done
      for file in "$defaults"/retroarch-switchres/*.switchres.ini; do
        [[ -f $file ]] || continue
        dir=$home/.config/retroarch/config/$(basename "$file" .switchres.ini)
        as_user mkdir -p "$dir" && install -m644 -o "$user" -g "$user" "$file" "$dir/"
      done
      ;;
    groovymame)
      # O mame.ini inteiro, como no build: o -createconfig do GroovyMAME com
      # as opcoes do FliperOS por cima; sem o GroovyMAME, so as do FliperOS.
      mkdir -p "$mame_etc"
      if [[ -f $defaults/mame.ini ]]; then
        "$root/opt/fliperos/bin/fliperos-mame-ini" "$defaults/mame.ini" "$mame_etc/mame.ini" >&2 ||
          install -m644 "$defaults/mame.ini" "$mame_etc/mame.ini"
      fi
      [[ ! -f $defaults/mame-ui.ini ]] || install -m644 "$defaults/mame-ui.ini" "$mame_etc/ui.ini"
      chown -R 1000:1000 "$mame_etc" 2> /dev/null || true
      ;;
    flycast)
      [[ ! -f $defaults/flycast-emu.cfg ]] ||
        install -D -m644 -o "$user" -g "$user" "$defaults/flycast-emu.cfg" "$home/.config/flycast/emu.cfg"
      ;;
  esac
  return 0
}

# emulator_restore NOME: guarda, restaura e reaplica. Imprime backup=PASTA.
emulator_restore() {
  local name=$1 stamp backup p full dest moved=0
  label="Restore $(field "$name" 4 | sed 's/ (.*//')"
  [[ -n $(restore_paths "$name") ]] || fail "$name has no settings to restore"
  ((EUID == 0)) || [[ -n $root ]] || fail "restore needs root"
  say 5 "Saving the current settings"
  stamp=$(date +%Y%m%d-%H%M%S)
  backup=$home/config-backup/$name-$stamp
  while IFS= read -r p; do
    full=$(restore_full "$p")
    [[ -e $full || -L $full ]] || continue
    if [[ $p == /* ]]; then dest=$backup/${p#/}; else dest=$backup/$p; fi
    mkdir -p "$(dirname "$dest")" || fail "could not make $backup"
    mv -- "$full" "$dest" || fail "could not move $full to $backup"
    moved=1
  done < <(restore_paths "$name")
  if ((moved)); then
    chown -R "$user:$user" "$home/config-backup" 2> /dev/null || true
  fi
  say 40 "Putting back the FliperOS settings"
  restore_defaults "$name"
  say 70 "Applying the Setup settings (buttons, monitor, latency)"
  if [[ -x $setup_cmd ]]; then
    "$setup_cmd" --reapply-emulators >&2 || say 90 "Some Setup settings were not applied (see the Setup log)"
  fi
  ((moved)) && printf 'backup=%s\n' "$backup"
  say 100 "$(field "$name" 4 | sed 's/ (.*//') is back to the FliperOS settings"
}

case ${1:-} in
  restorable)
    # nome|1 se ha configuracao para restaurar (0: ainda nao abriu)
    while IFS='|' read -r name _ _ _; do
      [[ -n $(restore_paths "$name") ]] || continue
      if restore_has "$name"; then has=1; else has=0; fi
      printf '%s|%s\n' "$name" "$has"
    done < <(table)
    ;;
  restore)
    name=${2:?name}
    [[ ${3:-} == --progress ]] && progress=1
    [[ -n $(field "$name" 1) ]] || fail "no such emulator: $name"
    emulator_restore "$name"
    ;;
  edge-available) edge_recipe "${2:?name}" > /dev/null ;;
  edge-status)
    # O commit do build mais novo instalado (vazio: o do pacote).
    cat "$edge_state/${2:?name}.commit" 2> /dev/null
    true
    ;;
  edge)
    name=${2:?name}
    [[ ${3:-} == --progress ]] && progress=1
    edge_build "$name"
    ;;
  edge-off)
    label=$(field "${2:?name}" 4)
    edge_remove "$2" || fail "could not bring the package back"
    ;;
  list)
    while IFS='|' read -r name kind file desc; do
      if [[ -x $file ]]; then inst=1; else inst=0; fi
      printf '%s|%s|%s|%s\n' "$name" "$inst" "$kind" "$desc"
    done < <(table)
    ;;
  installed) emulator_installed "${2:?name}" ;;
  versions)
    # nome|versao instalada (vazia: nao instalado, ou sem como saber)
    while IFS='|' read -r name kind file _; do
      version=""
      [[ -x $file ]] && version=$(emulator_version "$name")
      printf '%s|%s\n' "$name" "$version"
    done < <(table)
    ;;
  latest)
    # instalada|nova|same (a mesma), new (outra) ou unknown (sem rede)
    name=${2:?name}
    have=""
    emulator_installed "$name" && have=$(emulator_version "$name")
    want=$(emulator_latest "$name")
    if [[ -z $want ]]; then state=unknown
    elif same_version "$have" "$want"; then state=same
    else state=new
    fi
    printf '%s|%s|%s\n' "$have" "$want" "$state"
    ;;
  install)
    name=${2:?name} source=""
    shift 2
    while (($#)); do
      case $1 in
        --progress) progress=1 ;;
        --source) source=${2:-}; shift ;;
      esac
      shift
    done
    emulator_install "$name" "$source"
    ;;
  *)
    echo "Usage: fliperos-emulators list | installed NAME | versions | latest NAME | install NAME [--progress] [--source FOLDER] | restorable | restore NAME [--progress]" >&2
    exit 2
    ;;
esac
