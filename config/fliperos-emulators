#!/usr/bin/env bash
# Setup > Games > Emulators & Games: os emuladores do menu do desktop, quais estao
# instalados e a instalacao dos que nao vem na imagem, um por um.
#
#   fliperos-emulators list                    nome|instalado (0 ou 1)|tipo|descricao
#   fliperos-emulators installed NOME          status 0 se instalado
#   fliperos-emulators versions                nome|versao instalada
#   fliperos-emulators latest NOME             instalada|a do update|same, new ou unknown
#   fliperos-emulators install NOME [--progress] [--source PASTA]   (como root)
#   fliperos-emulators edge-available NOME     status 0 se compila o mais novo
#   fliperos-emulators edge NOME [--progress]  compila o mais novo (como root)
#   fliperos-emulators edge-off NOME           volta ao pacote (como root)
#   fliperos-emulators edge-status NOME        o commit do mais novo instalado
#
# tipo: image (compilado na imagem: nao se instala depois), build (o SM2-Emu,
# clonado e compilado na maquina: config/fliperos-sm2emu), fetch (baixado do
# site de quem o faz: o Fightcade, config/fliperos-fightcade, e o DuckStation,
# config/fliperos-duckstation) e source (um jogo convertido: config/
# fliperos-kof; baixado do itch.io, ou da pasta que a pessoa traz, --source
# PASTA).
#
# Com --progress, as etapas saem no formato da tela de progresso do Setup
# (lib/progress.sh); a saida dos comandos vai para o stderr (o log do Setup).
set -uo pipefail

user=${FLIPEROS_USER:-fliperos}
home=${FLIPEROS_HOME:-$(getent passwd "$user" 2> /dev/null | cut -d: -f6)}
home=${home:-/home/$user}
root=${FLIPEROS_EMULATORS_ROOT:-}
sm2emu=${FLIPEROS_SM2EMU:-/usr/local/bin/fliperos-sm2emu}
fightcade=${FLIPEROS_FIGHTCADE:-/opt/fliperos/bin/fliperos-fightcade}
duckstation=${FLIPEROS_DUCKSTATION:-/opt/fliperos/bin/fliperos-duckstation}
kof=${FLIPEROS_KOF:-/usr/local/bin/fliperos-kof}

# nome|tipo|o arquivo que diz que esta instalado|descricao. Os caminhos sao
# os do TryExec de config/applications: o que o menu do desktop mostra.
table() {
  cat << EOF
retroarch|image|$root/usr/local/bin/retroarch|RetroArch (consoles and arcade cores)
groovymame|image|$root/usr/local/bin/groovymame|GroovyMAME (arcade)
flycast|image|$root/usr/local/bin/flycast|Flycast (Dreamcast, Naomi, Atomiswave)
pcsx2|image|$root/usr/local/bin/pcsx2|PCSX2 (PlayStation 2)
pcsx2x6|image|$root/usr/local/bin/pcsx2x6|PCSX2x6 (Namco System 246/256)
dolphin|image|$root/usr/local/bin/dolphin-emu|Dolphin (GameCube, Wii, Triforce)
supermodel|image|$root/usr/local/bin/supermodel|Supermodel (Sega Model 3)
openbor|image|$root/usr/local/bin/openbor|OpenBOR (beat 'em ups)
model2|build|$home/.local/src/sm2-emu/build/bin/sm2-emu|Model 2 (SM2-Emu, Sega Model 2)
fightcade|fetch|$root/opt/fliperos/fightcade/fightcade|Fightcade 2 (online arcade)
duckstation|fetch|$root/usr/local/bin/duckstation|DuckStation (PlayStation)
kof|source|$home/roms/ikemen/kof-final-attack/Ikemen_GO_Linux|KOF Final Attack (Ikemen GO, 4:3)
EOF
}

field() {
  table | awk -F'|' -v n="$1" -v f="$2" '$1 == n { print $f; exit }'
}

emulator_installed() {
  local file
  file=$(field "$1" 3)
  [[ -n $file && -x $file ]]
}

# ── Versoes ──────────────────────────────────────────────────────
# A versao instalada sai de arquivos, sem abrir o emulador: o que o build da
# imagem gravou (emulator-versions, nome=versao), o metainfo dos AppImages, o
# VERSION.txt do Fightcade, o commit do codigo do SM2-Emu e, numa imagem
# antiga sem o arquivo, o texto de versao do binario do GroovyMAME. Um
# emulador que vem num pacote do FliperOS (o RetroArch) grava a sua em
# emulator-versions.d/NOME, que vale antes: o pacote atualizado pela rede
# troca a versao sem mexer no arquivo da imagem.
versions_file=${FLIPEROS_EMULATOR_VERSIONS:-$root/usr/local/share/fliperos/emulator-versions}
versions_dir=${FLIPEROS_EMULATOR_VERSIONS_DIR:-$root/usr/local/share/fliperos/emulator-versions.d}
# O que a proxima imagem do FliperOS traz (as versoes fixadas no build).
mkiso_url=${FLIPEROS_MKISO_URL:-https://raw.githubusercontent.com/juniorterin/fliperOS/main/fliperos-mkiso.sh}
net_timeout=${FLIPEROS_VERSION_TIMEOUT:-8}

metainfo_version() {
  sed -n 's/.*<release [^>]*version="v\{0,1\}\([^"]*\)".*/\1/p' "$1"/usr/share/metainfo/*.xml 2> /dev/null | head -n 1
}

emulator_version() {
  local name=$1 v=""
  [[ -f $versions_dir/$name ]] && v=$(head -n 1 "$versions_dir/$name")
  [[ -n $v ]] || v=$(awk -F= -v n="$name" '$1 == n { sub(/^[^=]*=/, ""); print; exit }' "$versions_file" 2> /dev/null)
  if [[ -z $v ]]; then
    case $name in
      pcsx2) v=$(metainfo_version "$root/opt/pcsx2") ;;
      duckstation) v=$(metainfo_version "$root/opt/duckstation") ;;
      fightcade) v=$(tr -d '[:space:]' < "$root/opt/fliperos/fightcade/VERSION.txt" 2> /dev/null) ;;
      model2) v=$(git -c safe.directory='*' -C "$home/.local/src/sm2-emu" log -1 --format='%cs %h' 2> /dev/null) ;;
      groovymame)
        v=$(grep -a -o -m 1 -E '0\.[0-9]{3} \((unknown|mame[0-9]+)\)' "$root/usr/local/libexec/groovymame" 2> /dev/null |
          head -n 1)
        v=${v%% *}
        ;;
    esac
  fi
  [[ -n $v ]] && printf '%s\n' "$v"
}

# remote_head URL [REF]: o commit curto do ramo principal (ou de REF).
remote_head() {
  timeout "$net_timeout" git ls-remote "$1" "${2:-HEAD}" 2> /dev/null | awk 'NR == 1 { print substr($1, 1, 7) }'
}

# pinned VARIAVEL [URL]: o valor fixado no fliperos-mkiso.sh do repositorio
# (ou na receita do pacote em URL).
pinned() {
  timeout "$net_timeout" curl -fsL "${2:-$mkiso_url}" 2> /dev/null |
    sed -n "s/^$1=\"\\([^\"]*\\)\".*/\\1/p" | head -n 1
}

# emulator_latest NOME: a versao que o update traz (precisa da rede; sem
# ela, nada). As da imagem mudam com a proxima imagem do FliperOS.
emulator_latest() {
  local v
  case $1 in
    pcsx2) pinned PCSX2_VERSION ;;
    pcsx2x6) pinned PCSX2X6_VERSION ;;
    # A versao da receita do pacote, a que o proximo update leva.
    dolphin) pinned PKG_VERSION "${mkiso_url%/*}/packaging/packages/fliperos-dolphin.sh" ;;
    groovymame)
      v=$(pinned GROOVYMAME_TAG)
      [[ $v =~ ^gm0([0-9]{3}) ]] && echo "0.${BASH_REMATCH[1]}"
      ;;
    openbor)
      v=$(pinned OPENBOR_COMMIT)
      [[ -n $v ]] && echo "${v:0:7}"
      ;;
    retroarch)
      # O commit da receita do pacote, o que o proximo update leva.
      v=$(pinned RA_COMMIT "${mkiso_url%/*}/packaging/packages/fliperos-retroarch.sh")
      [[ -n $v ]] && echo "${v:0:7}"
      ;;
    flycast)
      v=$(pinned FLYCAST_COMMIT "${mkiso_url%/*}/packaging/packages/fliperos-flycast.sh")
      [[ -n $v ]] && echo "${v:0:7}"
      ;;
    supermodel) remote_head https://github.com/trzy/Supermodel ;;
    model2) remote_head "${FLIPEROS_SM2_REPO:-https://github.com/dmanlfc/sm2-emu.git}" ;;
    duckstation) remote_head https://github.com/stenzek/duckstation refs/tags/latest ;;
  esac
}

# same_version INSTALADA NOVA: a mesma (o commit curto dentro da instalada,
# como "0.1-12083-g00e299795" e 00e2997).
same_version() {
  [[ -n $1 && -n $2 ]] && { [[ $1 == "$2" ]] || [[ $2 =~ ^[0-9a-f]{7}$ && $1 == *"$2"* ]]; }
}

progress=0 label=""
say() {
  if ((progress)); then printf '@step %s %s\n' "$1" "$2"; else printf '%s\n' "$2"; fi
}
fail() {
  if ((progress)); then printf '@fail %s|%s\n' "$label" "$1"; else printf 'fliperos-emulators: %s\n' "$1" >&2; fi
  exit 1
}

# as_user COMANDO...: o que fica na pasta pessoal roda como o usuario.
as_user() {
  if ((EUID == 0)) && [[ $user != root ]]; then
    runuser -u "$user" -- env HOME="$home" "$@"
  else
    HOME=$home "$@"
  fi
}

emulator_install() {
  local name=$1 source=$2 kind args=()
  kind=$(field "$name" 2)
  label=$(field "$name" 4)
  ((progress)) && args=(--progress)
  case $kind in
    image) fail "it comes compiled in the FliperOS image, and this image was built without it" ;;
    build)
      [[ -x $sm2emu ]] || fail "the Model 2 builder ($sm2emu) is missing"
      say 5 "Installing the build tools"
      "$sm2emu" --deps >&2 || fail "could not install the build tools (no network?)"
      say 20 "Downloading and building Model 2 (a few minutes)"
      as_user "$sm2emu" --build >&2 || fail "the build failed (details in the log)"
      say 100 "Model 2 installed"
      ;;
    fetch)
      local fetcher
      case $name in
        fightcade) fetcher=$fightcade ;;
        duckstation) fetcher=$duckstation ;;
      esac
      [[ -x $fetcher ]] || fail "the installer ($fetcher) is missing"
      "$fetcher" fetch "${args[@]}"
      ;;
    source)
      [[ -x $kof ]] || fail "the installer ($kof) is missing"
      # Sem --source, o jogo vem do itch.io.
      as_user "$kof" install ${source:+"$source"} "${args[@]}"
      ;;
    *) fail "unknown emulator: $name" ;;
  esac
}

# ── O mais novo do projeto (edge) ────────────────────────────────
# Um emulador num pacote do FliperOS (o Flycast) cuja receita sabe de onde vem
# o codigo (PKG_UPSTREAM): a mesma receita compila aqui o ultimo commit do
# projeto, com os patches do FliperOS. Os arquivos do pacote ficam guardados
# (dpkg-divert, com .fliperos-package no fim): os updates continuam trocando o
# pacote sem apagar este build, e edge-off volta ao pacote. Um patch que nao
# encaixa mais no codigo novo para tudo: o pacote fica.
recipes=${FLIPEROS_RECIPES:-$root/usr/local/share/fliperos/packaging/packages}
edge_state=${FLIPEROS_EDGE_STATE:-$root/var/lib/fliperos/edge}
edge_work=${FLIPEROS_EDGE_WORK:-/var/cache/fliperos/edge}

# edge_recipe NOME imprime a receita do pacote, se ela compila o mais novo.
edge_recipe() {
  local recipe=$recipes/fliperos-$1.sh
  [[ -f $recipe ]] && grep -q '^PKG_UPSTREAM=' "$recipe" && printf '%s\n' "$recipe"
}

# edge_remove NOME: o build sai e os arquivos do pacote voltam.
edge_remove() {
  local name=$1 rel list=$edge_state/$1.files
  [[ -f $list ]] || return 0
  while IFS= read -r rel; do
    [[ -n $rel ]] || continue
    rm -f "$root$rel"
    if [[ -n $(dpkg-divert --list "$rel" 2> /dev/null) ]]; then
      dpkg-divert --local --rename --remove "$rel" >&2 || return 1
    fi
  done < "$list"
  rm -f "$list" "$edge_state/$name.commit"
}

# edge_install NOME STAGING COMMIT: os arquivos do build no lugar dos do
# pacote, que vao para o lado.
edge_install() {
  local name=$1 staging=$2 commit=$3 path rel list=$edge_state/$1.files
  mkdir -p "$edge_state"
  edge_remove "$name" || return 1
  : > "$list"
  while IFS= read -r -d '' path; do
    rel=${path#"$staging"}
    if dpkg-query -S "$rel" > /dev/null 2>&1 && [[ -z $(dpkg-divert --list "$rel" 2> /dev/null) ]]; then
      dpkg-divert --local --rename --divert "$rel.fliperos-package" --add "$rel" >&2 || return 1
    fi
    printf '%s\n' "$rel" >> "$list"
    install -D -m "$(stat -c %a "$path")" "$path" "$root$rel" || return 1
  done < <(find "$staging" -type f -print0)
  printf '%s\n' "$commit" > "$edge_state/$name.commit"
}

edge_build() {
  local name=$1 recipe
  label=$(field "$name" 4)
  recipe=$(edge_recipe "$name") || fail "$label can't be built here"
  (
    # shellcheck source=/dev/null
    . "$recipe"
    say 5 "Asking for the newest $label"
    head=$(timeout "$net_timeout" git ls-remote "$PKG_UPSTREAM" HEAD 2> /dev/null | awk 'NR == 1 { print $1 }')
    [[ $head =~ ^[0-9a-f]{40}$ ]] || fail "could not reach $PKG_UPSTREAM (no network?)"
    printf -v "$PKG_COMMIT_VAR" '%s' "$head"
    say 10 "Installing the build tools"
    # shellcheck disable=SC2086 # um pacote por palavra
    { apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends \
      $PKG_BUILD_DEPS; } >&2 || fail "could not install the build tools (no network?)"
    rm -rf "${edge_work:?}/$name"
    SRC=$edge_work/$name/src STAGING=$edge_work/$name/staging
    mkdir -p "$SRC" "$STAGING"
    export SRC STAGING
    say 30 "Building $label ${head:0:7} with the FliperOS patches (several minutes)"
    log=$edge_work/$name/build.log
    if ! pkg_build > "$log" 2>&1; then
      cat "$log" >&2
      grep -q 'patch failed\|does not apply' "$log" &&
        fail "the FliperOS patch does not fit $label ${head:0:7}; the package stays"
      fail "the build failed (details in the log); the package stays"
    fi
    say 90 "Installing it over the package (the package stays saved)"
    edge_install "$name" "$STAGING" "$head" || fail "could not install the build; the package stays"
    rm -rf "${edge_work:?}/$name"
    say 100 "$label ${head:0:7} installed"
  ) || exit 1
}

case ${1:-} in
  edge-available) edge_recipe "${2:?name}" > /dev/null ;;
  edge-status)
    # O commit do build mais novo instalado (vazio: o do pacote).
    cat "$edge_state/${2:?name}.commit" 2> /dev/null
    true
    ;;
  edge)
    name=${2:?name}
    [[ ${3:-} == --progress ]] && progress=1
    edge_build "$name"
    ;;
  edge-off)
    label=$(field "${2:?name}" 4)
    edge_remove "$2" || fail "could not bring the package back"
    ;;
  list)
    while IFS='|' read -r name kind file desc; do
      if [[ -x $file ]]; then inst=1; else inst=0; fi
      printf '%s|%s|%s|%s\n' "$name" "$inst" "$kind" "$desc"
    done < <(table)
    ;;
  installed) emulator_installed "${2:?name}" ;;
  versions)
    # nome|versao instalada (vazia: nao instalado, ou sem como saber)
    while IFS='|' read -r name kind file _; do
      version=""
      [[ -x $file ]] && version=$(emulator_version "$name")
      printf '%s|%s\n' "$name" "$version"
    done < <(table)
    ;;
  latest)
    # instalada|nova|same (a mesma), new (outra) ou unknown (sem rede)
    name=${2:?name}
    have=""
    emulator_installed "$name" && have=$(emulator_version "$name")
    want=$(emulator_latest "$name")
    if [[ -z $want ]]; then state=unknown
    elif same_version "$have" "$want"; then state=same
    else state=new
    fi
    printf '%s|%s|%s\n' "$have" "$want" "$state"
    ;;
  install)
    name=${2:?name} source=""
    shift 2
    while (($#)); do
      case $1 in
        --progress) progress=1 ;;
        --source) source=${2:-}; shift ;;
      esac
      shift
    done
    emulator_install "$name" "$source"
    ;;
  *)
    echo "Usage: fliperos-emulators list | installed NAME | versions | latest NAME | install NAME [--progress] [--source FOLDER]" >&2
    exit 2
    ;;
esac
