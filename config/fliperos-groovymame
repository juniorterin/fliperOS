#!/usr/bin/env bash
# O comando groovymame do FliperOS (fliperos-launch, frontends, terminal). O
# binario e o release do GroovyMAME, em /usr/local/libexec/groovymame.
#
#  - Chamado no console, roda no KMS (fliperos-kms-run), como o GroovyArcade:
#    o Switchres pendura o modo de cada jogo no conector (o ATTACHMODE do
#    patch 06 do kernel) e o SDL troca para ele. Precisa do SDL2 do pacote
#    fliperos-sdl2-kms (packaging/packages), que le de novo os modos do
#    conector: com o SDL do Ubuntu o jogo ficava no modo do boot. E sem o
#    SDL_KMSDRM_REQUIRE_DRM_MASTER=0, que faz o Switchres trocar o modo por
#    conta propria, e o SDL desfazia a troca.
#  - No X, num Xorg so para ele (fliperos-x11-run), onde o Switchres troca o
#    modo pelo XRandR: sem aquele SDL (uma instalacao so atualizada pela
#    rede), com os jogos de varias telas em mais de um monitor (no KMS so o
#    principal fica ligado) ou com groovymame_video=x11 no fliperos.conf. O
#    fliperos-x11-run devolve o groovymame para ca, entao as linhas de
#    frontend gravadas com ele tambem seguem esta escolha.
#    Comandos sem tela (-listxml, -showconfig, -verifyroms...) rodam direto.
#  - -inipath /etc/fliperos/mame: o mame.ini do sistema, que o Setup grava.
#    O padrao do release e ".;ini", relativo a pasta de onde se abre. Um
#    -inipath na linha de comando vale mais.
#  - Com mais de um monitor (Setup > Video Setup > Multiple Monitors) e os
#    jogos de varias telas ligados (multiscreen= do fliperos.conf), a
#    pasta screens no inipath (o numscreens dos jogos de 2 ou 3 telas,
#    config/fliperos-mame-screens) e cada janela na saida da sua tela.
real=${FLIPEROS_GROOVYMAME_BIN:-/usr/local/libexec/groovymame}
inidir=${FLIPEROS_MAME_INI_DIR:-/etc/fliperos/mame}
x11run=${FLIPEROS_X11_RUN:-/opt/fliperos/bin/fliperos-x11-run}
kmsrun=${FLIPEROS_KMS_RUN_BIN:-/opt/fliperos/bin/fliperos-kms-run}
kmssdl=${FLIPEROS_SDL2_KMS:-/usr/local/lib/fliperos/sdl2-kms}
conf=${FLIPEROS_CONF:-/etc/fliperos/fliperos.conf}
screens_gen=${FLIPEROS_MAME_SCREENS:-/opt/fliperos/bin/fliperos-mame-screens}
multiscreen=${FLIPEROS_MULTISCREEN:-/opt/fliperos/bin/fliperos-multiscreen}

# opens_video ARGUMENTOS: o comando abre a tela (um jogo ou a lista do MAME)?
opens_video() {
  local arg
  for arg in "$@"; do
    case $arg in
      -list* | --list* | -verify* | --verify* | -show* | --show* | -create* | --create* | -valid* | -help | --help | \
        -h | -romident | -getsoftlist | -version | --version) return 1 ;;
    esac
  done
  return 0
}

# use_kms: abre no KMS (o cabecalho diz quando fica no X).
use_kms() {
  [[ -f $kmssdl/libSDL2-2.0.so.0 ]] || return 1
  grep -q '^groovymame_video=x11' "$conf" 2> /dev/null && return 1
  if grep -q '^screens=.*,' "$conf" 2> /dev/null && ! grep -q '^multiscreen=off' "$conf" 2> /dev/null; then
    return 1
  fi
  return 0
}

if [[ -z ${DISPLAY:-} && -z ${FLIPEROS_GROOVYMAME_X11:-} ]] && opens_video "$@" && use_kms; then
  # Pelo fliperos-kms-run (o log, o marquee, as saidas, o filtro), se quem
  # chamou ja nao passou por ele (a sessao, um frontend).
  [[ -n ${FLIPEROS_KMS_RUN:-} ]] || exec "$kmsrun" "$0" "$@"
  export LD_LIBRARY_PATH="$kmssdl${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  unset SDL_KMSDRM_REQUIRE_DRM_MASTER
  export FLIPEROS_GROOVYMAME_NO_X=1
fi

# A interface do MAME (aberto sem jogo) tem 640x480 a 30 Hz: num CRT de
# 15 kHz o Switchres a poria em 480 linhas entrelacadas. Ela vai sem
# entrelacar (-nointerlace; no gabinete, 640x248 a 60 Hz) e o X ja abre no
# mesmo modo (o Switchres de fora com o mesmo pedido e --interlace 0): entre
# a interface e o jogo o GroovyMAME volta ao modo em que o X abriu, e sendo o
# mesmo o tubo nao troca de sincronismo. Um jogo de mais de 240 linhas
# escolhido na interface tambem fica sem entrelacar; aberto com o jogo
# (frontends) nao muda nada.
if [[ -z ${DISPLAY:-} && -z ${FLIPEROS_GROOVYMAME_NO_X:-} ]] && opens_video "$@"; then
  export FLIPEROS_GROOVYMAME_X11=1
  (($# == 0)) && export FLIPEROS_SWITCHRES_OPTS="--interlace 0" && exec "$x11run" --mode 640x480@30 "$0"
  exec "$x11run" "$0" "$@"
fi

# Aberto sem jogo (a interface do MAME: a sessao e o menu do desktop), o jogo
# escolhido nela roda no mesmo processo, e o emusync do GroovyMAME no X
# (src/osd/modules/emusync/emusync_linux.cpp, gm0289sr222f) usa o
# /dev/dri/card0 que fechou ao sair da interface: o osd_deinit fecha o fd
# mas nao o zera, e o osd_init seguinte nao reabre ("drmCrtcGetSequence(-1)").
# Com o autosync, o Switchres liga o syncrefresh, que tira o throttle e
# deixa a velocidade com esse vblank quebrado: o jogo corria acelerado (no
# gabinete, o MvC escolhido na interface). Sem o autosync, a velocidade e a
# do throttle e o vsync e o do OpenGL (waitvsync). Aberto ja com o jogo
# (frontends, linha de comando) o vblank funciona e fica tudo como esta.
(($# == 0)) && set -- -noautosync -waitvsync -nointerlace

# As saidas na ordem das telas dos jogos (screens= do fliperos.conf).
inipath=$inidir
restore_primary=""
IFS=, read -r -a outputs <<< "$(sed -n 's/^screens=//p' "$conf" 2> /dev/null | tail -1)"
# Setup > Video Setup > Multiple Monitors > Multi-Screen Games: Off deixa tudo no monitor 1.
grep -q '^multiscreen=off' "$conf" 2> /dev/null && outputs=()
if ((${#outputs[@]} > 1)) && opens_video "$@"; then
  # Feitos pelo Setup; refeitos aqui se o GroovyMAME ou o numero de monitores
  # mudou (sem nada a fazer, sai na hora).
  "$screens_gen" "${#outputs[@]}" > /dev/null || true
  [[ -d $inidir/screens ]] && inipath="$inidir;$inidir/screens"
  if [[ -n ${DISPLAY:-} ]] && command -v xrandr > /dev/null; then
    # As saidas ligadas do X, na ordem do XRandR. O Switchres acha a tela
    # "screenN" do GroovyMAME por essa ordem; o SDL numera as telas com a
    # primaria primeiro. Com a primeira saida como primaria as duas contas
    # batem; no X do fliperos-x11-run ela fica assim, no desktop volta ao
    # fechar.
    names=()
    primary=""
    while read -r name is_primary; do
      names+=("$name")
      ((is_primary)) && primary=$name
    done < <(xrandr --query 2> /dev/null | awk '$2 == "connected" {
      for (i = 3; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) { print $1, ($3 == "primary"); break } }')
    if [[ -n $primary && $primary != "${names[0]}" ]] && xrandr --output "${names[0]}" --primary 2> /dev/null; then
      [[ -n ${FLIPEROS_X11_RUN_SESSION:-} ]] || restore_primary=$primary
    fi
    export SDL_VIDEO_X11_XRANDR=1
    # Os nomes do XRandR: uma saida de outra placa (card1:VGA-1) tem outro
    # nome no X (VGA-1-1).
    mapfile -t xouts < <("$multiscreen" xnames 2> /dev/null)
    ((${#xouts[@]} == ${#outputs[@]})) && outputs=("${xouts[@]}")
    for i in "${!outputs[@]}"; do
      for j in "${!names[@]}"; do
        [[ ${names[j]} == "${outputs[i]}" ]] && set -- "$@" "-screen$i" "screen$j"
      done
    done
  fi
fi
case " $* " in
  *" -inipath "* | *" --inipath "*) ;;
  *) set -- -inipath "$inipath" "$@" ;;
esac
# As saidas do jogo pela rede (porta 8000), para o Hook Of The Reaper e o LEDSpicer
# (config/fliperos-outputs). So com um deles instalado: a porta fica visivel
# na rede.
outputs_helper=${FLIPEROS_OUTPUTS:-/opt/fliperos/bin/fliperos-outputs}
if [[ " $* " != *" -output "* ]] && opens_video "$@" && [[ -x $outputs_helper ]] && "$outputs_helper" installed; then
  set -- -output network "$@"
fi
# O placar de uma partida versus no LED do gabinete (config/fliperos-versus):
# num jogo que tem detector ou linha na tabela, com um painel instalado, o
# plugin fliperos-versus le o placar da memoria e o escreve num arquivo que o
# fliperos-versus acompanha. O -plugin e o -pluginspath da linha de comando
# trocam os do mame.ini, entao o hiscore e as pastas de la vao junto (o
# plugin e do FliperOS, fora da pasta que o build do GroovyMAME recria).
versus=${FLIPEROS_VERSUS:-/opt/fliperos/bin/fliperos-versus}
panel=${FLIPEROS_PIXELCADE:-/opt/fliperos/bin/fliperos-pixelcade}
plugins=${FLIPEROS_MAME_PLUGINS:-/usr/local/share/fliperos/mame-plugins}
game=${*: -1}
if opens_video "$@" && [[ $game != -* && " $* " != *" -plugin "* && -x $versus && -x $panel ]] &&
  "$panel" panel && "$versus" has mame "${game##*/}"; then
  set -- -plugin hiscore,fliperos-versus \
    -pluginspath "/usr/local/share/groovymame/plugins;$plugins;$HOME/.mame/plugins" "$@"
fi
# O som pelo "default" do ALSA (config/fliperos-sdl-audio.c): o dmix, a
# placa do Setup e a tela ao vivo. Sem a biblioteca, o MAME abria o hw: da
# placa direto e gravava essa saida no cfg de cada jogo; esses sound_map
# saem uma vez (o MAME grava o default no lugar ao fechar o jogo).
sdlaudio=${FLIPEROS_SDL_AUDIO:-/usr/local/lib/fliperos/libfliperos-sdl-audio.so}
cfgdir=${FLIPEROS_MAME_CFG_DIR:-$HOME/.mame/cfg}
if opens_video "$@" && [[ -f $sdlaudio ]]; then
  export LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD:}$sdlaudio"
  if [[ -d $cfgdir && ! -e $cfgdir/.fliperos-sound-default ]]; then
    for cfg in "$cfgdir"/*.cfg; do
      [[ -f $cfg ]] && sed -i -e '/<sound_map[^>]*\/>/d' -e '/<sound_map[^>]*[^/]>/,/<\/sound_map>/d' "$cfg"
    done
    : > "$cfgdir/.fliperos-sound-default"
  fi
fi
# Uma pistola de luz ligada (config/fliperos-lightgun): o MAME le a mira do
# ponteiro, sem o modo relativo do SDL (config/fliperos-sdl-gun.c), e nao
# desenha mira por cima do jogo (as cross1-8.png transparentes).
sdlgun=${FLIPEROS_SDL_GUN:-/usr/local/lib/fliperos/libfliperos-sdl-gun.so}
lightgun=${FLIPEROS_LIGHTGUN:-/opt/fliperos/bin/fliperos-lightgun}
crosshairs=${FLIPEROS_BLANK_CROSSHAIRS:-/usr/local/share/fliperos/crosshair}
if opens_video "$@" && [[ -f $sdlgun && -x $lightgun && -n $("$lightgun" guns 2> /dev/null) ]]; then
  export LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD:}$sdlgun"
  [[ -d $crosshairs ]] && set -- -crosshairpath "$crosshairs" "$@"
fi
if [[ -n $restore_primary ]]; then
  "$real" "$@"
  rc=$?
  xrandr --output "$restore_primary" --primary 2> /dev/null
  exit "$rc"
fi
exec "$real" "$@"
