#!/usr/bin/env bash
# O comando groovymame do FliperOS (fliperos-launch, frontends, terminal). O
# binario e o release do GroovyMAME, em /usr/local/libexec/groovymame.
#
#  - Roda no X, como o GroovyArcade no modo X: chamado no console, abre-se
#    num Xorg so para ele (fliperos-x11-run), e o Switchres do GroovyMAME
#    cria e troca o modo de cada jogo pelo XRandR (modesetting 1 no
#    mame.ini). No KMS desta instalacao o Switchres calculava o modo mas o
#    SDL continuava desenhando no tamanho do modo do boot: jogo esticado,
#    espremido ou no centro com barras pretas, conforme a resolucao do Setup.
#    Comandos sem tela (-listxml, -showconfig, -verifyroms...) rodam direto.
#  - -inipath /etc/fliperos/mame: o mame.ini do sistema, que o Setup grava.
#    O padrao do release e ".;ini", relativo a pasta de onde se abre. Um
#    -inipath na linha de comando vale mais.
real=${FLIPEROS_GROOVYMAME_BIN:-/usr/local/libexec/groovymame}
inidir=${FLIPEROS_MAME_INI_DIR:-/etc/fliperos/mame}
x11run=${FLIPEROS_X11_RUN:-/opt/fliperos/bin/fliperos-x11-run}

# opens_video ARGUMENTOS: o comando abre a tela (um jogo ou a lista do MAME)?
opens_video() {
  local arg
  for arg in "$@"; do
    case $arg in
      -list* | --list* | -verify* | --verify* | -show* | --show* | -create* | --create* | -valid* | -help | --help | \
        -h | -romident | -getsoftlist | -version | --version) return 1 ;;
    esac
  done
  return 0
}

if [[ -z ${DISPLAY:-} && -z ${FLIPEROS_GROOVYMAME_NO_X:-} ]] && opens_video "$@"; then
  exec "$x11run" "$0" "$@"
fi

# Aberto sem jogo (a interface do MAME: a sessao e o menu do desktop), o jogo
# escolhido nela roda no mesmo processo, e o emusync do GroovyMAME no X
# (src/osd/modules/emusync/emusync_linux.cpp, gm0289sr222f) usa o
# /dev/dri/card0 que fechou ao sair da interface: o osd_deinit fecha o fd
# mas nao o zera, e o osd_init seguinte nao reabre ("drmCrtcGetSequence(-1)").
# Com o autosync, o Switchres liga o syncrefresh, que tira o throttle e
# deixa a velocidade com esse vblank quebrado: o jogo corria acelerado (no
# gabinete, o MvC escolhido na interface). Sem o autosync, a velocidade e a
# do throttle e o vsync e o do OpenGL (waitvsync). Aberto ja com o jogo
# (frontends, linha de comando) o vblank funciona e fica tudo como esta.
(($# == 0)) && set -- -noautosync -waitvsync
case " $* " in
  *" -inipath "* | *" --inipath "*) ;;
  *) set -- -inipath "$inidir" "$@" ;;
esac
exec "$real" "$@"
