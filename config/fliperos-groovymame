#!/usr/bin/env bash
# O comando groovymame do FliperOS (fliperos-launch, frontends, terminal). O
# binario e o release do GroovyMAME, em /usr/local/libexec/groovymame; este
# atalho passa o inipath:
#
#  - /etc/fliperos/mame: o mame.ini do sistema, que o Setup grava. O padrao
#    do release e ".;ini", relativo a pasta de onde se abre.
#  - se ligado em Setup > Video Setup > GroovyMAME 4:3 (mame_crt_aspect=yes;
#    desligado por padrao, como no GroovyArcade), num CRT de 15 kHz, depois
#    dela, /etc/fliperos/mame/aspect: um .ini por jogo de menos de 240 linhas
#    com a proporcao corrigida (fliperos-mame-aspect). Vale para o jogo
#    escolhido na lista do proprio GroovyMAME tambem; um .ini do usuario na
#    pasta principal vale mais.
#
# Um -inipath na linha de comando vale mais.
real=${FLIPEROS_GROOVYMAME_BIN:-/usr/local/libexec/groovymame}
inidir=${FLIPEROS_MAME_INI_DIR:-/etc/fliperos/mame}
conf=${FLIPEROS_CONF:-/etc/fliperos/fliperos.conf}

conf_value() {
  sed -n "s/^$1=//p" "$conf" 2> /dev/null | tail -1
}

inipath=$inidir
if [[ -d $inidir/aspect && $(conf_value mame_crt_aspect) == yes && $(conf_value frequency) == 15* &&
  $(conf_value orientation) =~ ^(horizontal)?$ ]]; then
  inipath="$inidir;$inidir/aspect"
fi
case " $* " in
  *" -inipath "* | *" --inipath "*) ;;
  *) set -- -inipath "$inipath" "$@" ;;
esac
exec "$real" "$@"
