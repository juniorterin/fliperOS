[Unit]
Description=FliperOS ZeDMD LED display (dmdserver)
# So depois do Setup > Games > Extras > ZeDMD (config/fliperos-pixelcade fetch-zedmd).
ConditionPathExists=/home/fliperos/zedmd/dmdserver
# Sem o ZeDMD conectado o dmdserver sai com erro: tres tentativas (a USB
# ainda enumerando no boot) e para. A udev (99-fliperos-zedmd.rules) o abre
# quando o ZeDMD e conectado.
StartLimitIntervalSec=180
StartLimitBurst=3

[Service]
User=fliperos
WorkingDirectory=/home/fliperos/zedmd
ExecStart=/opt/fliperos/bin/fliperos-pixelcade zedmd-daemon
# "Bye" no painel quando o computador desliga.
ExecStop=-/opt/fliperos/bin/fliperos-pixelcade bye zedmd
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
