#!/usr/bin/env python3
"""A arte de uma tela do FliperOS no menu de telas do Arcadeflow, feita da
arte que o tema tem para o sistema dela (config/fliperos-arcadeflow systems).

  fliperos-arcadeflow-art stamp SISTEMA TIPO TEXTO ORIGEM DESTINO

A tela do core mame2010 chama "MAME 2010" e usa a arte do MAME do tema com
"2010" escrito por cima, inclinado, no estilo do logotipo: assim ela nao se
confunde com a do GroovyMAME, que e "MAME". SISTEMA e o nome do sistema no
tema (MAME), TIPO a pasta da arte (system_images: o gabinete, 800x800 com
transparencia; system_bgs: a foto de fundo, 1280x720) e TEXTO o que se
escreve. Onde, de que tamanho e de que cor fica em STAMPS, por sistema e
tipo, em fracoes da imagem: uma arte de outro tamanho recebe o texto no
mesmo lugar.

Status 3: sem o Pillow (python3-pil); 4: nao ha lugar marcado para este
sistema e tipo. Nos dois casos quem chama usa a arte do sistema como esta.
"""
import os
import sys

# (centro x, centro y, altura do texto, angulo em graus, inclinacao das
# letras, cor, cor do contorno): as fracoes sao da largura (x), da altura (y
# e altura do texto) da imagem.
STAMPS = {
    ('MAME', 'system_bgs'): [
        (0.622, 0.300, 0.078, 22.0, 0.45, (16, 16, 16), None),
    ],
    ('MAME', 'system_images'): [
        (0.470, 0.840, 0.058, 12.0, 0.40, (22, 60, 110), (150, 205, 240)),
    ],
}
FONTS = ('/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf',
         '/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf',
         '/usr/share/fonts/truetype/freefont/FreeSansBold.ttf')


def text_layer(text, height, slant, color, outline):
    """O texto em letras inclinadas (como as do logotipo), com transparencia."""
    from PIL import Image, ImageDraw, ImageFont
    font = next((f for f in FONTS if os.path.isfile(f)), None)
    if font is None:
        sys.exit(4)
    # A fonte no tamanho em que as maiusculas tem a altura pedida.
    size = max(8, int(height / 0.73))
    font = ImageFont.truetype(font, size)
    stroke = max(1, size // 14) if outline else 0
    left, top, right, bottom = font.getbbox(text, stroke_width=stroke)
    w, h = right - left, bottom - top
    pad = int(h * slant) + 4
    layer = Image.new('RGBA', (w + 2 * pad, h + 8), (0, 0, 0, 0))
    ImageDraw.Draw(layer).text((pad - left, 4 - top), text, font=font, fill=color + (255,),
                               stroke_width=stroke, stroke_fill=(outline or color) + (255,))
    # Inclinacao: cada linha desliza para a direita quanto mais alta.
    return layer.transform(layer.size, Image.AFFINE, (1, slant, -slant * layer.size[1] / 2, 0, 1, 0),
                           resample=Image.BICUBIC)


def stamp(system, kind, text, src, dst):
    try:
        from PIL import Image
    except ImportError:
        return 3
    places = STAMPS.get((system, kind))
    if not places:
        return 4
    image = Image.open(src)
    mode = 'RGBA' if dst.lower().endswith('.png') else 'RGB'
    base = image.convert('RGBA')
    for cx, cy, height, angle, slant, color, outline in places:
        layer = text_layer(text, height * base.height, slant, color, outline)
        layer = layer.rotate(angle, resample=Image.BICUBIC, expand=True)
        base.alpha_composite(layer, (int(cx * base.width - layer.width / 2),
                                     int(cy * base.height - layer.height / 2)))
    tmp = '%s.%d.tmp' % (dst, os.getpid())
    if mode == 'RGB':
        base.convert('RGB').save(tmp, 'JPEG', quality=90)
    else:
        base.save(tmp, 'PNG', optimize=True)
    os.replace(tmp, dst)
    return 0


# O texto ao lado do logotipo, no glifo: tamanho em relacao as letras da
# fonte, angulo (graus, subindo para a direita), inclinacao das letras, e
# onde comeca: quanto do avanco do logotipo ele invade e quanto sobe.
GLYPH_SCALE, GLYPH_ANGLE, GLYPH_SLANT, GLYPH_OVERLAP, GLYPH_RISE = 0.88, 14.0, 0.22, 0.02, -0.12


def glyphs(src, dst, specs):
    """Os logotipos das telas com sistema proprio, na fonte do tema. No menu
    de telas o logotipo de um sistema e um glifo dessa fonte, o de numero
    0xe900 + a posicao do sistema no data_systems.txt: um sistema posto no
    fim do arquivo cai num numero sem glifo (um ponto na tela). Para cada
    (codigo, codigo do sistema de origem, texto) faz o glifo novo: o
    logotipo de origem com o texto ao lado, inclinado ("MAME" + "2010")."""
    try:
        from fontTools.misc.transform import Transform
        from fontTools.pens.transformPen import TransformPen
        from fontTools.pens.ttGlyphPen import TTGlyphPen
        from fontTools.ttLib import TTFont
    except ImportError:
        return 3
    import math
    font = TTFont(src)
    if 'glyf' not in font:
        return 4
    cmap = font.getBestCmap()
    glyph_set = font.getGlyphSet()
    order = font.getGlyphOrder()
    for code, base_code, text in specs:
        base = cmap.get(base_code)
        letters = [cmap.get(ord(ch)) for ch in text.upper()]
        if base is None or any(g is None for g in letters if g is not None) or code in cmap:
            return 4
        pen = TTGlyphPen(glyph_set)
        glyph_set[base].draw(pen)
        advance = font['hmtx'][base][0]
        bounds = font['glyf'][base]
        height = bounds.yMax - bounds.yMin
        # Inclina as letras, gira e leva para depois do logotipo.
        place = (Transform().translate(advance * (1 - GLYPH_OVERLAP), bounds.yMin + height * (0.5 + GLYPH_RISE))
                 .rotate(math.radians(GLYPH_ANGLE)).skew(math.radians(math.degrees(math.atan(GLYPH_SLANT))), 0)
                 .scale(GLYPH_SCALE))
        x = 0
        for ch, name in zip(text.upper(), letters):
            if name is None:
                # Um espaco (ou o que a fonte nao tem): so o vao.
                x += font['hmtx'][cmap[ord('0')]][0] // 2
                continue
            glyph_set[name].draw(TransformPen(pen, place.translate(x, -font['glyf'][name].yMax / 2
                                                                    if hasattr(font['glyf'][name], 'yMax') else 0)))
            x += font['hmtx'][name][0]
        end = place.transformPoint((x, 0))[0]
        name = 'uni%04X' % code
        if name in order:
            return 4
        glyph = pen.glyph()
        # O glyf acrescenta o nome a ordem dos glifos, que pode ser a mesma lista.
        font['glyf'][name] = glyph
        if name not in order:
            order.append(name)
        glyph.recalcBounds(font['glyf'])
        font['hmtx'][name] = (int(max(advance, end) + font['hmtx'][base][1]), font['hmtx'][base][1])
        for table in font['cmap'].tables:
            if table.isUnicode():
                table.cmap[code] = name
    font.setGlyphOrder(order)
    tmp = '%s.%d.tmp' % (dst, os.getpid())
    font.save(tmp)
    os.replace(tmp, dst)
    return 0


def main():
    args = sys.argv[1:]
    if len(args) == 6 and args[0] == 'stamp':
        return stamp(*args[1:])
    if len(args) >= 6 and args[0] == 'glyphs' and (len(args) - 3) % 3 == 0:
        try:
            specs = [(int(args[i], 16), int(args[i + 1], 16), args[i + 2]) for i in range(3, len(args), 3)]
        except ValueError:
            return 2
        return glyphs(args[1], args[2], specs)
    sys.stderr.write('usage: fliperos-arcadeflow-art stamp SYSTEM KIND TEXT SOURCE DESTINATION\n'
                     '       fliperos-arcadeflow-art glyphs FONT NEWFONT CODE BASECODE TEXT [CODE BASECODE TEXT...]\n')
    return 2


if __name__ == '__main__':
    sys.exit(main())
