#!/usr/bin/env bash
# A luz colorida dos controles nas cores do FliperOS (o roxo do Dracula).
#
# O kernel mostra a luz RGB de um controle como um LED multicolorido em
# /sys/class/leds (multi_index diz a ordem das cores, multi_intensity recebe
# os tres valores): o DualSense e o DualShock 4 (hid-playstation, hid-sony),
# e os 8BitDo que se apresentam como um deles. A maioria dos 8BitDo nao
# expoe a luz ao Linux (o anel RGB do Ultimate 2 so muda pelo programa
# deles): nesses nao ha o que mudar, e nada acontece.
#
#   fliperos-padcolor apply LED      a cor num LED (/sys/class/leds/NOME ou o
#                                    caminho dele), so se for de um controle
#   fliperos-padcolor all            em todos os LEDs de controle ligados
#
# Chamado pela regra do udev (99-fliperos-input.rules) a cada LED novo.
# A cor: FLIPEROS_PADCOLOR (RRGGBB), ou padcolor= do fliperos.conf; "off"
# deixa a luz como o controle a acende.
set -uo pipefail
leds=${FLIPEROS_LEDS:-/sys/class/leds}
conf=${FLIPEROS_CONF:-/etc/fliperos/fliperos.conf}
# O roxo do Dracula (#bd93f9), o destaque do FliperOS.
color=${FLIPEROS_PADCOLOR:-$(sed -n 's/^padcolor=//p' "$conf" 2> /dev/null | tail -n 1)}
color=${color:-bd93f9}

# is_pad LED: o LED e de um controle de jogo (o aparelho dele tem um input
# com joystick) ou o nome diz que e de um (os drivers poem o nome do driver).
is_pad() {
  local dev
  dev=$(readlink -f "$1/device" 2> /dev/null) || return 1
  [[ -n $dev ]] || return 1
  compgen -G "$dev/input/input*/js*" > /dev/null && return 0
  case ${1##*/} in
    *playstation* | *sony* | *8bitdo* | *8BitDo* | *ps4* | *ps5* | *dualsense* | *dualshock*) return 0 ;;
  esac
  return 1
}

# apply LED: escreve a cor na ordem do multi_index e a luz no maximo.
apply() {
  local led=$1 index max r g b values="" name
  [[ $led == /* ]] || led=$leds/$led
  [[ $color =~ ^[0-9a-fA-F]{6}$ ]] || return 0
  # O DualShock 4 no hid-sony: um LED por cor (NOME:red, :green, :blue).
  case ${led##*/} in
    *:red | *:green | *:blue)
      is_pad "$led" || return 0
      max=$(cat "$led/max_brightness" 2> /dev/null)
      [[ $max =~ ^[0-9]+$ && $max -gt 0 ]] || max=255
      case ${led##*:} in
        red) r=${color:0:2} ;;
        green) r=${color:2:2} ;;
        blue) r=${color:4:2} ;;
      esac
      echo $((16#$r * max / 255)) > "$led/brightness" 2> /dev/null
      return 0
      ;;
  esac
  [[ -f $led/multi_intensity && -f $led/multi_index ]] || return 0
  is_pad "$led" || return 0
  read -r index < "$led/multi_index" || return 0
  max=$(cat "$led/max_brightness" 2> /dev/null)
  [[ $max =~ ^[0-9]+$ && $max -gt 0 ]] || max=255
  r=$((16#${color:0:2} * max / 255))
  g=$((16#${color:2:2} * max / 255))
  b=$((16#${color:4:2} * max / 255))
  for name in $index; do
    case $name in
      red) values+="$r " ;;
      green) values+="$g " ;;
      blue) values+="$b " ;;
      *) values+="0 " ;;
    esac
  done
  echo "${values% }" > "$led/multi_intensity" 2> /dev/null || return 0
  echo "$max" > "$led/brightness" 2> /dev/null
  return 0
}

[[ ${color,,} == off ]] && exit 0
case ${1:-} in
  apply)
    [[ -n ${2:-} ]] || { echo "usage: fliperos-padcolor apply LED" >&2; exit 2; }
    apply "$2"
    ;;
  all)
    for led in "$leds"/*; do
      [[ -e $led ]] && apply "$led"
    done
    ;;
  *)
    echo "usage: fliperos-padcolor apply LED | all" >&2
    exit 2
    ;;
esac
exit 0
