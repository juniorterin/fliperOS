#!/usr/bin/env bash
# A luz colorida dos controles nas cores do FliperOS.
#
# O kernel mostra a luz RGB de um controle como um LED multicolorido em
# /sys/class/leds (multi_index diz a ordem das cores, multi_intensity recebe
# os tres valores): o DualSense e o DualShock 4 (hid-playstation, hid-sony),
# e os 8BitDo que se apresentam como um deles. O 8BitDo Ultimate 2 guarda a
# luz dos aneis na configuracao dele: o fliperos-padcolor-8bitdo grava pelo
# cabo USB ou pelo dongle 2.4G, e ela fica valendo tambem no Bluetooth (que
# nao tem o canal de configuracao). Os outros 8BitDo nao expoem a luz.
#
# padcolor= do fliperos.conf (ou FLIPEROS_PADCOLOR):
#   fliperos (o padrao)  no Ultimate 2, a roleta nos menus (um LED roxo
#                        girando sobre o rosa) e, com um jogo aberto, o anel
#                        esquerdo roxo e o direito rosa; nos outros, o roxo
#   RRGGBB               uma cor so
#   off                  a luz como o controle a acende
#
#   fliperos-padcolor apply LED      a cor num LED (/sys/class/leds/NOME ou o
#                                    caminho dele), so se for de um controle
#   fliperos-padcolor hidraw NOME    um hidraw novo: se for o canal de
#                                    configuracao de um Ultimate 2, grava a luz
#                                    nele (em segundo plano)
#   fliperos-padcolor all            em todos os controles ligados
#   fliperos-padcolor list           os controles cuja luz muda agora
#                                    ("led NOME", "8bitdo NOME") e os
#                                    Ultimate 2 so no Bluetooth ("bluetooth NOME")
#   fliperos-padcolor launch PROGRAMA [ARGS...]
#                                    do fliperos-kms-run e do fliperos-x11-run:
#                                    com um jogo na linha de comando, o Ultimate 2
#                                    fica nas cores de jogo ate ele fechar
#
# Chamado pela regra do udev (99-fliperos-input.rules) a cada LED e hidraw novo.
set -uo pipefail
leds=${FLIPEROS_LEDS:-/sys/class/leds}
conf=${FLIPEROS_CONF:-/etc/fliperos/fliperos.conf}
color=${FLIPEROS_PADCOLOR:-$(sed -n 's/^padcolor=//p' "$conf" 2> /dev/null | tail -n 1)}
color=${color:-fliperos}
color=${color,,}
# O roxo do FliperOS num LED so: o do Dracula (#bd93f9) sai esbranquicado no
# LED; este e o mesmo roxo saturado.
ledcolor=$color
[[ $color == fliperos ]] && ledcolor=7a00ff
ultimate2=${FLIPEROS_PADCOLOR_8BITDO:-/opt/fliperos/bin/fliperos-padcolor-8bitdo}

# is_pad LED: o LED e de um controle de jogo (o aparelho dele tem um input
# com joystick) ou o nome diz que e de um (os drivers poem o nome do driver).
is_pad() {
  local dev
  dev=$(readlink -f "$1/device" 2> /dev/null) || return 1
  [[ -n $dev ]] || return 1
  compgen -G "$dev/input/input*/js*" > /dev/null && return 0
  case ${1##*/} in
    *playstation* | *sony* | *8bitdo* | *8BitDo* | *ps4* | *ps5* | *dualsense* | *dualshock*) return 0 ;;
  esac
  return 1
}

# apply LED: escreve a cor na ordem do multi_index e a luz no maximo.
apply() {
  local led=$1 index max r g b values="" name
  [[ $led == /* ]] || led=$leds/$led
  [[ $ledcolor =~ ^[0-9a-fA-F]{6}$ ]] || return 0
  # O DualShock 4 no hid-sony: um LED por cor (NOME:red, :green, :blue).
  case ${led##*/} in
    *:red | *:green | *:blue)
      is_pad "$led" || return 0
      max=$(cat "$led/max_brightness" 2> /dev/null)
      [[ $max =~ ^[0-9]+$ && $max -gt 0 ]] || max=255
      case ${led##*:} in
        red) r=${ledcolor:0:2} ;;
        green) r=${ledcolor:2:2} ;;
        blue) r=${ledcolor:4:2} ;;
      esac
      echo $((16#$r * max / 255)) > "$led/brightness" 2> /dev/null
      return 0
      ;;
  esac
  [[ -f $led/multi_intensity && -f $led/multi_index ]] || return 0
  is_pad "$led" || return 0
  read -r index < "$led/multi_index" || return 0
  max=$(cat "$led/max_brightness" 2> /dev/null)
  [[ $max =~ ^[0-9]+$ && $max -gt 0 ]] || max=255
  r=$((16#${ledcolor:0:2} * max / 255))
  g=$((16#${ledcolor:2:2} * max / 255))
  b=$((16#${ledcolor:4:2} * max / 255))
  for name in $index; do
    case $name in
      red) values+="$r " ;;
      green) values+="$g " ;;
      blue) values+="$b " ;;
      *) values+="0 " ;;
    esac
  done
  echo "${values% }" > "$led/multi_intensity" 2> /dev/null || return 0
  echo "$max" > "$led/brightness" 2> /dev/null
  return 0
}

# color_led LED: um LED de cor de um controle (o que o apply muda).
color_led() {
  case ${1##*/} in
    *:green | *:blue) return 1 ;;   # o DualShock 4 conta uma vez, pelo :red
    *:red) ;;
    *) [[ -f $1/multi_intensity && -f $1/multi_index ]] || return 1 ;;
  esac
  is_pad "$1"
}

# list: os controles cuja luz o FliperOS muda agora, e os Ultimate 2 que estao
# so no Bluetooth (esses mudam pelo cabo). Vale tambem com padcolor=off.
list() {
  local led name
  for led in "$leds"/*; do
    if [[ ! -e $led ]] || ! color_led "$led"; then continue; fi
    name=$(sed -n 's/^HID_NAME=//p' "$led/device/uevent" 2> /dev/null)
    echo "led ${name:-${led##*/}}"
  done
  [[ -x $ultimate2 ]] || return 0
  "$ultimate2" list 2> /dev/null | while read -r _ name; do echo "8bitdo $name"; done
  "$ultimate2" bluetooth 2> /dev/null | while read -r name; do echo "bluetooth $name"; done
}

[[ ${1:-} == list ]] && { list; exit 0; }
[[ $color == off ]] && exit 0
case ${1:-} in
  apply)
    [[ -n ${2:-} ]] || { echo "usage: fliperos-padcolor apply LED" >&2; exit 2; }
    apply "$2"
    ;;
  hidraw)
    # Do udev: so o 8BitDo (2dc8) segue; a gravacao leva segundos e o js do
    # controle tem de existir, entao vai fora do udev, depois de um instante.
    [[ -n ${2:-} && -x $ultimate2 ]] || exit 0
    grep -qi '^HID_ID=0003:00002DC8:' "/sys/class/hidraw/${2##*/}/device/uevent" 2> /dev/null || exit 0
    [[ $color == fliperos || $color =~ ^[0-9a-f]{6}$ ]] || exit 0
    # shellcheck disable=SC2016 # o $0 e os $N sao do sh -c
    cmd=(sh -c 'sleep 2; exec "$0" apply "$1" "$2"' "$ultimate2" "/dev/${2##*/}" "$color")
    if command -v systemd-run > /dev/null; then
      systemd-run --no-block --quiet --collect -- "${cmd[@]}" > /dev/null 2>&1 || setsid "${cmd[@]}" > /dev/null 2>&1 &
    else
      setsid "${cmd[@]}" > /dev/null 2>&1 &
    fi
    ;;
  launch)
    # O jogo e PADCOLOR_GAME_PID (o fliperos-kms-run e o fliperos-x11-run
    # chamam pelo after_game, fora da arvore do jogo, e viram o emulador; sem
    # ele, o pai): cores de jogo ate ele fechar, mesmo fechado pelo atalho
    # do frontend, que mata tudo abaixo do jogo. Jogo,
    # como no fliperos-pixelcade: o ultimo argumento e um arquivo, ou o set
    # do GroovyMAME e do Model 2. Sem jogo (um frontend, o menu de um
    # emulador), nada.
    [[ $color == fliperos && -x $ultimate2 && $# -ge 3 ]] || exit 0
    prog=${2##*/}
    last=${*: -1}
    case $prog in
      groovymame | fliperos-model2) [[ $last == -* ]] && exit 0 ;;
      *) [[ -f $last ]] || exit 0 ;;
    esac
    pid=${PADCOLOR_GAME_PID:-$PPID}
    [[ $pid =~ ^[0-9]+$ ]] && ((pid > 1)) || exit 0
    "$ultimate2" game on > /dev/null 2>&1
    tail --pid="$pid" -f /dev/null 2> /dev/null
    "$ultimate2" game off > /dev/null 2>&1
    ;;
  all)
    for led in "$leds"/*; do
      [[ -e $led ]] && apply "$led"
    done
    [[ -x $ultimate2 && ( $color == fliperos || $color =~ ^[0-9a-f]{6}$ ) ]] && "$ultimate2" all "$color" 2> /dev/null
    ;;
  *)
    echo "usage: fliperos-padcolor apply LED | hidraw NAME | all | list | launch PROGRAM [ARGS...]" >&2
    exit 2
    ;;
esac
exit 0
