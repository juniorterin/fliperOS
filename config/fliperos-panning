#!/usr/bin/env bash
# Rolagem no desktop para janelas maiores que a tela. Num CRT de 15 kHz o
# desktop tem 640x480, e muita janela nao cabe nem maximizada: o GTK nao a
# deixa menor que o tamanho minimo dela (a do Transmission pede 846 de
# largura) e nao poe barra de rolagem. Enquanto uma janela assim esta
# aberta, a area do desktop cresce ate caber nela (o panning do XRandR) e a
# imagem rola quando o mouse encosta na borda; fechada, volta ao tamanho do
# modo. So cresce na direcao que falta.
#
# Roda junto com o LXDE (config/fliperos-lxde) e sai com o X.
#
# A conta usa o tamanho minimo das janelas maximizadas, nao o atual: com a
# area maior o Openbox as maximiza nela, e a area nunca mais encolheria.
# A posicao nao conta: arrastar uma janela pequena para fora da tela nao
# aumenta o desktop.
set -uo pipefail

# Maior que isto nao: uma janela com tamanho minimo absurdo nao vira um
# desktop do tamanho de um outdoor.
MAX=${FLIPEROS_PANNING_MAX:-2048}

# screen_state imprime "SAIDA LARGURA ALTURA PAN_L PAN_A" (o modo atual e o
# panning de agora; 0x0 sem panning). Nada com a tela girada (vertical):
# ali o panning nao e usado.
screen_state() {
  xrandr --verbose 2> /dev/null | awk '
    /^[^ \t]/ { inside = ($2 == "connected" && $3 ~ /^(primary|[0-9]+x[0-9]+)/); if (inside) { out = $1; rot = "" ;
                for (i = 3; i <= NF; i++) if ($i ~ /^\(0x/) { rot = $(i + 1); break } } next }
    !inside { next }
    /^\tPanning:/ { split($2, p, /[x+]/); pw = p[1]; ph = p[2] }
    /\*current/ { cur = 1; next }
    cur && /h: +width/ { w = $3 }
    cur && /v: +height/ { h = $3; cur = 0
      if (rot == "normal") { print out, w, h, (pw ? pw : 0), (ph ? ph : 0); exit } }'
}

# windows_need imprime "LARGURA ALTURA" que as janelas abertas pedem.
windows_need() {
  local id props geo type state minw minh l r t b w h needw=0 needh=0
  for id in $(xprop -root _NET_CLIENT_LIST 2> /dev/null | sed -n 's/.*# //p' | tr -d ','); do
    props=$(xprop -id "$id" _NET_WM_WINDOW_TYPE _NET_WM_STATE WM_NORMAL_HINTS _NET_FRAME_EXTENTS 2> /dev/null) || continue
    type=$(sed -n 's/^_NET_WM_WINDOW_TYPE(ATOM) = //p' <<< "$props")
    # O fundo (pcmanfm) e o painel seguem o tamanho da tela.
    [[ $type == *_DESKTOP* || $type == *_DOCK* ]] && continue
    state=$(sed -n 's/^_NET_WM_STATE(ATOM) = //p' <<< "$props")
    [[ $state == *_HIDDEN* ]] && continue
    read -r minw minh < <(sed -n 's/.*program specified minimum size: \([0-9]*\) by \([0-9]*\).*/\1 \2/p' <<< "$props")
    IFS=', ' read -r l r t b < <(sed -n 's/^_NET_FRAME_EXTENTS(CARDINAL) = //p' <<< "$props")
    geo=$(xwininfo -id "$id" 2> /dev/null | awk '/^  Width:/ { w = $2 } /^  Height:/ { h = $2 } END { print w + 0, h + 0 }')
    read -r w h <<< "$geo"
    [[ $state == *_MAXIMIZED_HORZ* ]] && w=0
    [[ $state == *_MAXIMIZED_VERT* ]] && h=0
    ((${minw:-0} > w)) && w=$minw
    ((${minh:-0} > h)) && h=$minh
    w=$((w + ${l:-0} + ${r:-0}))
    h=$((h + ${t:-0} + ${b:-0}))
    ((w > needw)) && needw=$w
    ((h > needh)) && needh=$h
  done
  printf '%s %s\n' "$needw" "$needh"
}

update() {
  local out mw mh pw ph needw needh want
  read -r out mw mh pw ph < <(screen_state) || return 0
  [[ -n ${out:-} && ${mw:-0} -gt 0 && ${mh:-0} -gt 0 ]] || return 0
  read -r needw needh < <(windows_need)
  ((needw < mw)) && needw=$mw
  ((needh < mh)) && needh=$mh
  ((needw > MAX)) && needw=$MAX
  ((needh > MAX)) && needh=$MAX
  ((pw == 0)) && pw=$mw
  ((ph == 0)) && ph=$mh
  # Cada troca do panning volta a imagem ao canto de cima: com ele ligado a
  # area so cresce, e so volta ao modo quando nenhuma janela precisa mais
  # (uma janela que muda 2 px ao ganhar ou perder a moldura nao a mexe).
  if ((pw > mw || ph > mh)) && ! ((needw == mw && needh == mh)); then
    ((needw < pw)) && needw=$pw
    ((needh < ph)) && needh=$ph
  fi
  ((needw == pw && needh == ph)) && return 0
  want=${needw}x${needh}
  xrandr --output "$out" --panning "$want" 2> /dev/null &&
    echo "fliperos-panning: $out ${mw}x${mh}, desktop $want" >&2
}

if [[ ${1:-} == --once ]]; then
  update
  exit 0
fi

# A cada janela aberta ou fechada (o xprop -spy escreve uma linha) e a cada
# 2 s (uma janela que mudou de tamanho). O xprop sai com o X, e o laco junto.
update
while true; do
  read -r -t 2 _
  rc=$?
  # 0: mudou a lista; >128: so o tempo; outro: o xprop saiu (o X fechou).
  ((rc == 0 || rc > 128)) || break
  update
done < <(xprop -root -spy _NET_CLIENT_LIST 2> /dev/null)
