#!/usr/bin/env bash
# Rolagem no desktop para janelas que nao cabem na tela. Num CRT de 15 kHz o
# desktop tem 640x480, e muita janela nao cabe nem maximizada: o programa
# forca um tamanho minimo (o GTK nao a deixa menor que o conteudo; a do
# Transmission tem 846 de largura) e nao poe barra de rolagem, e os botoes
# da base ficam fora da tela ou atras da barra de tarefas. Enquanto uma
# janela assim esta aberta, a area do desktop cresce ate caber nela (o
# panning do XRandR), e a imagem rola quando o mouse encosta na borda;
# fechada, volta ao tamanho do modo. Vale para qualquer programa.
#
# Na vertical conta a altura da janela mais as barras (a de tarefas do
# LXDE). Na horizontal, so a largura minima que o programa forca: uma janela
# larga que pode encolher cabe maximizada.
#
# Roda junto com o LXDE (config/fliperos-lxde) e sai com o X.
#
# A conta usa a altura minima das janelas maximizadas, nao a atual: com a
# area maior o Openbox as maximiza nela, e a area nunca mais encolheria.
# A posicao nao conta: arrastar uma janela pequena para fora da tela nao
# aumenta o desktop.
set -uo pipefail

# Maior que isto nao: uma janela com altura minima absurda nao vira um
# desktop do tamanho de um outdoor.
MAX=${FLIPEROS_PANNING_MAX:-2048}

# screen_state imprime "SAIDA LARGURA ALTURA PAN_L PAN_A" (o modo atual e o
# panning de agora; 0x0 sem panning). Nada com a tela girada (vertical):
# ali o panning nao e usado.
screen_state() {
  xrandr --verbose 2> /dev/null | awk '
    /^[^ \t]/ { inside = ($2 == "connected" && $3 ~ /^(primary|[0-9]+x[0-9]+)/); if (inside) { out = $1; rot = "" ;
                for (i = 3; i <= NF; i++) if ($i ~ /^\(0x/) { rot = $(i + 1); break } } next }
    !inside { next }
    /^\tPanning:/ { split($2, p, /[x+]/); pw = p[1]; ph = p[2] }
    /\*current/ { cur = 1; next }
    cur && /h: +width/ { w = $3 }
    cur && /v: +height/ { h = $3; cur = 0
      if (rot == "normal") { print out, w, h, (pw ? pw : 0), (ph ? ph : 0); exit } }'
}

# windows_need imprime "LARGURA ALTURA" que as janelas abertas pedem, com a
# moldura; na altura, mais as barras de cima e de baixo (o painel do LXDE
# reserva a faixa dele no _NET_WM_STRUT: a janela fica entre as barras).
windows_need() {
  local id props geo type state minw minh l r t b h strut needw=0 needh=0 bars=0
  local -a s
  for id in $(xprop -root _NET_CLIENT_LIST 2> /dev/null | sed -n 's/.*# //p' | tr -d ','); do
    props=$(xprop -id "$id" _NET_WM_WINDOW_TYPE _NET_WM_STATE WM_NORMAL_HINTS _NET_FRAME_EXTENTS \
      _NET_WM_STRUT_PARTIAL _NET_WM_STRUT 2> /dev/null) || continue
    type=$(sed -n 's/^_NET_WM_WINDOW_TYPE(ATOM) = //p' <<< "$props")
    # O fundo (pcmanfm) segue o tamanho da tela; o painel so conta a faixa.
    [[ $type == *_DESKTOP* ]] && continue
    if [[ $type == *_DOCK* ]]; then
      strut=$(sed -n 's/^_NET_WM_STRUT_PARTIAL(CARDINAL) = //p' <<< "$props")
      [[ -n $strut ]] || strut=$(sed -n 's/^_NET_WM_STRUT(CARDINAL) = //p' <<< "$props")
      IFS=', ' read -ra s <<< "$strut"
      bars=$((bars + ${s[2]:-0} + ${s[3]:-0}))
      continue
    fi
    state=$(sed -n 's/^_NET_WM_STATE(ATOM) = //p' <<< "$props")
    [[ $state == *_HIDDEN* ]] && continue
    read -r minw minh < <(sed -n 's/.*program specified minimum size: \([0-9]*\) by \([0-9]*\).*/\1 \2/p' <<< "$props")
    IFS=', ' read -r l r t b < <(sed -n 's/^_NET_FRAME_EXTENTS(CARDINAL) = //p' <<< "$props")
    geo=$(xwininfo -id "$id" 2> /dev/null | awk '/^  Height:/ { h = $2 } END { print h + 0 }')
    h=$geo
    [[ $state == *_MAXIMIZED_VERT* ]] && h=0
    ((${minh:-0} > h)) && h=$minh
    h=$((h + ${t:-0} + ${b:-0}))
    ((h > needh)) && needh=$h
    ((${minw:-0} + ${l:-0} + ${r:-0} > needw)) && needw=$((minw + ${l:-0} + ${r:-0}))
  done
  ((needh > 0)) && needh=$((needh + bars))
  printf '%s %s\n' "$needw" "$needh"
}

# keep NECESSARIO ATUAL MODO: cada troca do panning volta a imagem ao canto
# de cima, entao com a rolagem ligada numa direcao ela so cresce, e volta ao
# modo quando nenhuma janela precisa mais (uma janela que muda 2 px ao
# ganhar ou perder a moldura nao a mexe).
keep() {
  if (($2 > $3 && $1 > $3 && $1 < $2)); then
    printf '%s\n' "$2"
  else
    printf '%s\n' "$1"
  fi
}

update() {
  local out mw mh pw ph needw needh want
  read -r out mw mh pw ph < <(screen_state) || return 0
  [[ -n ${out:-} && ${mw:-0} -gt 0 && ${mh:-0} -gt 0 ]] || return 0
  read -r needw needh < <(windows_need)
  ((needw < mw)) && needw=$mw
  ((needh < mh)) && needh=$mh
  ((needw > MAX)) && needw=$MAX
  ((needh > MAX)) && needh=$MAX
  ((pw == 0)) && pw=$mw
  ((ph == 0)) && ph=$mh
  needw=$(keep "$needw" "$pw" "$mw")
  needh=$(keep "$needh" "$ph" "$mh")
  ((needw == pw && needh == ph)) && return 0
  want=${needw}x${needh}
  xrandr --output "$out" --panning "$want" 2> /dev/null &&
    echo "fliperos-panning: $out ${mw}x${mh}, desktop $want" >&2
}

if [[ ${1:-} == --once ]]; then
  update
  exit 0
fi

# A cada janela aberta ou fechada (o xprop -spy escreve uma linha) e a cada
# 2 s (uma janela que mudou de tamanho). O xprop sai com o X, e o laco junto.
update
while true; do
  read -r -t 2 _
  rc=$?
  # 0: mudou a lista; >128: so o tempo; outro: o xprop saiu (o X fechou).
  ((rc == 0 || rc > 128)) || break
  update
done < <(xprop -root -spy _NET_CLIENT_LIST 2> /dev/null)
