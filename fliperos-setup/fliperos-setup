#!/usr/bin/env bash
# fliperos-setup: o equivalente do gasetup do GroovyArcade.
#
# Na midia de instalacao testa as saidas de video e abre o "FliperOS Setup"
# (instalar, recuperar, terminal, desligar). No sistema instalado e o menu
# que aparece quando o frontend fecha.
#
#   sudo fliperos-setup                 fluxo normal
#   sudo fliperos-setup --menu [--remote]
#                                       o mesmo, pelo laco do fliperos-tty1
#                                       (sai com 20 para abrir um launcher);
#                                       --remote: num terminal do SSH, em texto
#   sudo fliperos-setup --desktop DISPLAY [XAUTHORITY]
#                                       pelo atalho do LXDE: a interface
#                                       grafica numa janela do X
#   sudo fliperos-setup --first-boot    escolhe o launcher padrao
#   sudo fliperos-setup --output-test   refaz o teste de saidas
#   sudo fliperos-setup --video-setup   abre direto o Video Setup
#   sudo fliperos-setup --latency       abre direto o Setup > System > Latency
#   sudo fliperos-setup --update-check  pergunta pelo update do FliperOS
#   sudo fliperos-setup --driver-confirm  confirma a imagem do driver de video trocado
#
# Sem tela (servico de boot, sessao de jogo, teclas de volume e monitores
# extras, ver lib/latency.sh, lib/audio.sh e lib/multimonitor.sh):
#   --latency-boot, --session-start, --session-end, --volume up|down|mute|get|set N, --systems, --downloader status|add|start|remove, --settings, --setting KEY VALUE, --outputs main|all,
#   --padkeys on|off, --services-boot, --services-late (lib/services.sh),
#   --bios-check (as BIOS que faltam, lib/downloader.sh)
#
# lib/ tem a logica (nenhum arquivo de lib/ chama o gum, exceto lib/ui.sh);
# screens/ tem as telas.

