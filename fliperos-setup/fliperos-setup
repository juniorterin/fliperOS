# A versao do Setup em disco quando este processo abriu e os argumentos dele:
# atualizado com a tela aberta (System Update, tools/cabinet-update.sh), ele
# se reabre no proximo menu (screen_reload_if_updated). As telas ja
# carregadas aqui sao as de antes e chamariam os programas novos com as
# opcoes antigas.
SETUP_STAMP=$(setup_stamp)
SETUP_ARGS=("$@")

usage() {
  sed -n '8,20p' "${BASH_SOURCE[0]}" | sed 's/^# *//'
}

restore_terminal() {
  ui_done
  padkeys_off
  speak_stop
  printf '\e[?25h' > /dev/tty 2> /dev/null
  stty echo < /dev/tty 2> /dev/null
  return 0
}

main() {
  local rc=0
  case ${1:-} in
    --version)
      echo "fliperos-setup $FLIPEROS_SETUP_VERSION"
      return 0
      ;;
    --help | -h)
      usage
      return 0
      ;;
  esac
  if ((EUID != 0)); then
    echo "Run with sudo: sudo fliperos-setup" >&2
    return 1
  fi
  case ${1:-} in
    --latency-boot)
      latency_boot
      return 0
      ;;
    --driver-trial-boot)
      # A vigia da troca de driver (fliperos-driver-trial.service).
      amd_driver_trial_boot
      return 0
      ;;
    --session-start)
      # O som da tela ao vivo sem o loopback neste boot: o asound.conf sem a
      # copia, senao nada toca (lib/audio.sh).
      audio_stream_check
      # O jogo direto no boot (fliperos-session --session-start game): so a
      # latencia. As listas, a arte e a config dos frontends nao servem a
      # ele e atrasavam a abertura do jogo.
      if [[ ${2:-} == game ]]; then
        latency_session_start
        return 0
      fi
      # A arte que ainda esta em ~/media por plataforma (arcade, snes) vai
      # para as pastas com o nome das de ~/roms.
      media_refolder
      latency_session_start
      # A configuracao de 240p dos frontends que ainda nao a tem (nenhum
      # esta aberto agora).
      frontends_240p
      if launcher_installed attractplus && [[ -d $ATTRACT_DIR/emulators ]]; then
        # Os jogos copiados desde a ultima vez (pela rede, num disco): a
        # pasta nova ganha a tela dela e a lista de cada pasta segue os
        # arquivos. Com os padroes e as romlists refeitas, como abaixo.
        frontends_attract
      else
        # Os padroes do Attract-Mode Plus: as telas no Arcadeflow, com as
        # opcoes do FliperOS.
        frontends_attract_defaults
        # Uma romlist refeita desde a ultima vez: o Arcadeflow a le de novo.
        frontends_arcadeflow_sync
      fi
      # O Arcadeflow em 4:3 num modo de pixel largo (640x240).
      frontends_arcadeflow_screen
      return 0
      ;;
    --session-end)
      latency_session_end
      return 0
      ;;
    --services-boot)
      services_boot
      return 0
      ;;
    --services-late)
      services_late
      return 0
      ;;
    --settings)
      # Os ajustes que o painel web mostra (lib/system.sh).
      settings_list
      return 0
      ;;
    --setting)
      settings_set "${2:-}" "${3:-}"
      return
      ;;
    --downloader)
      # O Downloader sem tela (lib/downloader.sh): o painel web.
      downloader_cli "${@:2}"
      return
      ;;
    --systems)
      # As pastas com jogos e o comando de cada uma (lib/frontends.sh): o
      # painel web (config/fliperos-web, Games), com "|1" no fim das de
      # arcade (sets do MAME: o painel busca as informacoes pelo nome do set).
      local line
      while IFS= read -r line; do
        if scraper_arcade "${line%%|*}"; then printf '%s|1\n' "$line"; else printf '%s|0\n' "$line"; fi
      done < <(frontends_systems)
      return 0
      ;;
    --romfilter)
      # O filtro do MAME ROM Cleaner e do Downloader sem tela (lib/romclean.sh):
      # a pagina ROM filter do painel web.
      romfilter_cli "${@:2}"
      return
      ;;
    --filters)
      # Os filtros de jogos do FliperOS (genero, fabricante, ano), no formato
      # do Attract-Mode: os das telas dele e os do painel web.
      scraper_attract_filters
      return 0
      ;;
    --romlists)
      # O frontend do FliperOS (gui/fliperos-frontend), ao abrir e quando uma
      # pasta de jogos muda: as listas seguem as pastas, e as de arcade ganham
      # o nome, o ano e os clones do XML do MAME (o -listxml e lido se ainda
      # nao esta no cache). Um de cada vez.
      local lock
      exec {lock}> /run/fliperos-romlists.lock
      flock -n "$lock" || return 0
      FRONTENDS_RESYNC_FULL=1 frontends_attract > /dev/null
      chown -R "$FLIPEROS_USER:" "$ATTRACT_DIR" 2> /dev/null
      return 0
      ;;
    --bios-check)
      # A checagem automatica das BIOS, que o menu abre em segundo plano.
      bios_auto
      return 0
      ;;
    --volume)
      audio_step "${@:2}"
      return
      ;;
    --outputs)
      mm_outputs "${2:-all}"
      return 0
      ;;
    --padkeys)
      # O controle como teclado fora do Setup: o navegador do Downloader
      # (config/fliperos-browser) o liga enquanto esta aberto.
      if [[ ${2:-} == on ]]; then padkeys_on; else padkeys_off; fi
      return 0
      ;;
  esac
  if ! have gum; then
    echo "gum was not found; the setup screens need it." >&2
    return 1
  fi
  if [[ ! -r /dev/tty ]]; then
    echo "fliperos-setup needs a terminal." >&2
    return 1
  fi
  if [[ ${1:-} == --menu ]]; then
    SETUP_MENU_LOOP=1
    shift
  fi
  # Pelo SSH (o fliperos-tty1 ve que o terminal nao e um VT): o menu em
  # texto, e o que abre no monitor (frontend, jogo, desktop) fica de fora.
  if [[ ${1:-} == --remote ]]; then
    SETUP_REMOTE=1
    export FLIPEROS_UI=text
    shift
  fi
  # Pelo atalho do desktop: o display do X (e o Xauthority) que o sudo
  # tirou do ambiente, para a interface grafica abrir numa janela.
  if [[ ${1:-} == --desktop ]]; then
    SETUP_DESKTOP=1
    [[ -n ${2:-} ]] && export DISPLAY=$2
    [[ -n ${3:-} && -r ${3:-} ]] && export XAUTHORITY=$3
    shift $(($# < 3 ? $# : 3))
  fi
  # E um menu de gabinete: sai-se dele pelo menu. Ctrl+C no meio de uma
  # instalacao deixaria o disco pela metade.
  trap '' INT QUIT TSTP
  trap restore_terminal EXIT
  log_info "fliperos-setup $FLIPEROS_SETUP_VERSION $* (live=$(is_live && echo yes || echo no))"
  ui_init
  # Controle como teclado enquanto o menu esta na tela (lib/padkeys.sh).
  padkeys_on

  case ${1:-} in
    --first-boot)
      screen_first_boot
      return 0
      ;;
    --output-test)
      screen_video_detection
      return 0
      ;;
    --video-setup)
      screen_video_setup
      return 0
      ;;
    --latency)
      screen_latency
      return 0
      ;;
    --update-check)
      screen_update_check
      return 0
      ;;
    --driver-confirm)
      screen_amd_driver_confirm
      return 0
      ;;
  esac

  if is_live; then
    # O teste roda uma vez por boot da midia (o fliperos.conf da midia
    # vive na RAM e comeca vazio a cada boot).
    if ! conf_get output_test > /dev/null 2>&1; then
      if screen_video_detection; then
        conf_set output_test "done"
      else
        conf_set output_test skipped
      fi
    fi
    screen_live_menu
    rc=$?
  else
    [[ -f $FLIPEROS_ETC/firstboot ]] && screen_first_boot
    # De volta do navegador do Downloader: a tela do magnet link.
    ((SETUP_MENU_LOOP == 1)) && screen_downloader_resume
    screen_main_menu
    rc=$?
  fi
  ((rc == SETUP_EXIT_SHELL)) && return 0
  return "$rc"
}

main "$@"
