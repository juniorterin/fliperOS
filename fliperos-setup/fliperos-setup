# A versao do Setup em disco quando este processo abriu e os argumentos dele:
# atualizado com a tela aberta (System Update, tools/cabinet-update.sh), ele
# se reabre no proximo menu (screen_reload_if_updated). As telas ja
# carregadas aqui sao as de antes e chamariam os programas novos com as
# opcoes antigas.
SETUP_STAMP=$(setup_stamp)
SETUP_ARGS=("$@")

usage() {
  sed -n '8,19p' "${BASH_SOURCE[0]}" | sed 's/^# *//'
}

restore_terminal() {
  padkeys_off
  speak_stop
  printf '\e[?25h' > /dev/tty 2> /dev/null
  stty echo < /dev/tty 2> /dev/null
  return 0
}

main() {
  local rc=0
  case ${1:-} in
    --version)
      echo "fliperos-setup $FLIPEROS_SETUP_VERSION"
      return 0
      ;;
    --help | -h)
      usage
      return 0
      ;;
  esac
  if ((EUID != 0)); then
    echo "Run with sudo: sudo fliperos-setup" >&2
    return 1
  fi
  case ${1:-} in
    --latency-boot)
      latency_boot
      return 0
      ;;
    --session-start)
      latency_session_start
      # A configuracao de 240p dos frontends que ainda nao a tem (nenhum
      # esta aberto agora).
      frontends_240p
      return 0
      ;;
    --session-end)
      latency_session_end
      return 0
      ;;
    --volume)
      audio_step "${2:-}"
      return
      ;;
  esac
  if ! have gum; then
    echo "gum was not found; the setup screens need it." >&2
    return 1
  fi
  if [[ ! -r /dev/tty ]]; then
    echo "fliperos-setup needs a terminal." >&2
    return 1
  fi
  if [[ ${1:-} == --menu ]]; then
    SETUP_MENU_LOOP=1
    shift
  fi
  # E um menu de gabinete: sai-se dele pelo menu. Ctrl+C no meio de uma
  # instalacao deixaria o disco pela metade.
  trap '' INT QUIT TSTP
  trap restore_terminal EXIT
  log_info "fliperos-setup $FLIPEROS_SETUP_VERSION $* (live=$(is_live && echo yes || echo no))"
  ui_init
  # Controle como teclado enquanto o menu esta na tela (lib/padkeys.sh).
  padkeys_on

  case ${1:-} in
    --first-boot)
      screen_first_boot
      return 0
      ;;
    --output-test)
      screen_video_detection
      return 0
      ;;
    --video-setup)
      screen_video_setup
      return 0
      ;;
    --latency)
      screen_latency
      return 0
      ;;
    --update-check)
      screen_update_check
      return 0
      ;;
  esac

  if is_live; then
    # O teste roda uma vez por boot da midia (o fliperos.conf da midia
    # vive na RAM e comeca vazio a cada boot).
    if ! conf_get output_test > /dev/null 2>&1; then
      if screen_video_detection; then
        conf_set output_test "done"
      else
        conf_set output_test skipped
      fi
    fi
    screen_live_menu
    rc=$?
  else
    [[ -f $FLIPEROS_ETC/firstboot ]] && screen_first_boot
    screen_main_menu
    rc=$?
  fi
  ((rc == SETUP_EXIT_SHELL)) && return 0
  return "$rc"
}

main "$@"
