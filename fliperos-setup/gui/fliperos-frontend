#!/usr/bin/env python3
# O frontend do FliperOS: a lista de jogos no visual do menu do Setup
# (Press Start 2P, Dracula, o fundo animado), em 320x240 esticado para o
# modo da tela, como a interface grafica (gui/fliperos-gui). Os dados sao os
# do painel web (gui/fedata.py); o controle, o do Button mapping
# (gui/feinput.py).
#
# Tres modos: lista (os jogos a esquerda, a midia e as informacoes a
# direita), tela cheia (a imagem do jogo no fundo) e grade (as capas, como o
# Arcadeflow). O Start troca o modo.
#
#   cima/baixo    os jogos (segurando acelera; com 3 s, de letra em letra)
#   esquerda/dir. a romlist (na grade: anda nela e troca so com o jogo
#                 encostado na lateral)
#   1  o menu do jogo (Jogar, Favoritar, +); na lista, num jogo com clones,
#      abre e fecha os clones
#   2  volta       3/6  pagina acima/abaixo   4  favorito   5  filtros
#   Tab  classificar, renomear, scrape do jogo; e as opcoes do frontend
#
# Tab > Frontend options tambem tem o atalho que fecha o jogo (uma tecla do
# teclado e/ou botoes do painel segurados juntos), o botao de desligar nos
# jogos e o modo comercial: sem ficha nao se escolhe jogo, cada ficha soma
# os minutos escolhidos, o tempo que acaba fecha o jogo, e o controle nao
# fecha o frontend (quiosque).
#
#   fliperos-frontend [--shot PREFIXO] [--keys "b1 down ..."]
#
# --shot grava a tela em PREFIXO-<n>.png depois de cada tecla de --keys, sem
# video (os testes e os prints da documentacao).

import argparse
import atexit
import json
import os
import signal
import subprocess
import sys
import threading
import time

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
FPS = 60                     # (o CRT e 60 Hz; o quadro custa poucos ms)
CONFIG = os.path.join(os.path.expanduser("~"), ".config", "fliperos", "frontend.json")

# A rolagem segurando cima/baixo: comeca a repetir depois de FIRST, acelera
# de RATE0 a RATE1 jogos por segundo ate LETTERS segundos, e dai vai de letra
# em letra (LRATE0 letras por segundo, e ate LRATE1 depois de LSPEEDUP).
FIRST, RATE0, RATE1, LETTERS = 0.4, 6.0, 30.0, 3.0
LRATE0, LRATE1, LSPEEDUP = 3.0, 10.0, 0.8
# No modo letra cada toque passa uma letra; LETTER_IDLE segundos sem mexer e
# a lista volta ao normal.
LETTER_IDLE = 2.0
# Um jogo sem video e sem imagem, com o cursor parado nele por este tempo,
# ganha o scrape sozinho (as informacoes, as imagens e o video, nas pastas de
# ~/media).
AUTO_SCRAPE = 2.0
MODES = ("list", "full", "flow")
MODE_NAMES = {"list": "LIST", "full": "FULL SCREEN", "flow": "GRID"}
COLS = 3                     # as colunas da grade (o GRID_COLS do feview.py)


# As linhas do Tab: 0 a 4 do jogo, e as do frontend (os minutos por ficha so
# com o modo comercial ligado).
OPT_MODE, OPT_CLONES, OPT_HIDDEN, OPT_EXIT_KEY, OPT_EXIT_PAD, OPT_POWER, OPT_COMMERCIAL, OPT_COIN = range(5, 13)

# O atalho que fecha o jogo e as fichas do modo comercial, lidos junto com o
# jogo (config/fliperos-buttons hotkey).
BUTTONS_TOOL = os.environ.get("FLIPEROS_BUTTONS_TOOL", "/opt/fliperos/bin/fliperos-buttons")
# Os botoes do atalho do painel, segurados juntos por EXIT_HOLD segundos
# (no jogo e na hora de escolher). CAPTURE_WAIT: sem apertar, a escolha sai.
EXIT_HOLD, CAPTURE_WAIT = 1.0, 8.0
COMBO_CONTROLS = ("up", "down", "left", "right", "b1", "b2", "b3", "b4", "b5", "b6", "start", "coin")
# Os minutos de cada ficha (Frontend options > Minutes per coin).
COIN_MINUTES = (1, 2, 3, 4, 5, 6, 8, 10, 12, 15, 20, 25, 30, 40, 45, 50, 60)


def evdev_keys(pg):
    """As teclas que fecham o jogo: a do pygame -> (nome, codigo do evdev,
    o do kernel, que o fliperos-buttons hotkey le junto com o jogo)."""
    k = pg
    table = {k.K_ESCAPE: ("ESC", 1), k.K_BACKSPACE: ("BACKSPACE", 14), k.K_TAB: ("TAB", 15),
             k.K_RETURN: ("ENTER", 28), k.K_SPACE: ("SPACE", 57), k.K_PAUSE: ("PAUSE", 119),
             k.K_HOME: ("HOME", 102), k.K_END: ("END", 107), k.K_INSERT: ("INSERT", 110),
             k.K_DELETE: ("DELETE", 111), k.K_PAGEUP: ("PAGE UP", 104), k.K_PAGEDOWN: ("PAGE DOWN", 109),
             k.K_0: ("0", 11)}
    for n, code in enumerate((59, 60, 61, 62, 63, 64, 65, 66, 67, 68, 87, 88), 1):
        table[getattr(k, "K_F%d" % n)] = ("F%d" % n, code)
    for row, first in (("qwertyuiop", 16), ("asdfghjkl", 30), ("zxcvbnm", 44)):
        for i, c in enumerate(row):
            table[getattr(k, "K_" + c)] = (c.upper(), first + i)
    for n in range(1, 10):
        table[getattr(k, "K_%d" % n)] = (str(n), n + 1)
    return table


def panel_keys(rows):
    """Os nomes das teclas que o Button mapping deu ao painel (um encoder
    que se diz teclado, "k:NOME" do MAME): uma delas nao fecha o jogo."""
    alias = {"LCONTROL": "CTRL", "RCONTROL": "CTRL", "LALT": "ALT", "LSHIFT": "SHIFT", "RSHIFT": "SHIFT"}
    return {alias.get(e[2:], e[2:]) for _, _, e in rows if e.startswith("k:")}


def combo_names(combo):
    """Os botoes do atalho na tela: START, COIN, 1 a 6 e as direcoes."""
    return [c[1:] if c[0] == "b" and c[1:].isdigit() else c.upper() for c in combo]


def tree(pid):
    """O processo e os que estao abaixo dele (o jogo e o X, o emulador...)."""
    import glob
    found = [pid]
    for path in glob.glob("/proc/%d/task/*/children" % pid):
        try:
            with open(path) as f:
                for child in f.read().split():
                    found += tree(int(child))
        except (OSError, ValueError):
            pass
    return found


def load_config():
    try:
        with open(CONFIG, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_config(data):
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG + ".tmp", "w", encoding="utf-8") as f:
            json.dump(data, f)
        os.replace(CONFIG + ".tmp", CONFIG)
    except OSError:
        pass


class Frontend:
    def __init__(self, args):
        if args.shot:
            os.environ["SDL_VIDEODRIVER"] = "dummy"
        os.environ.setdefault("PYGAME_HIDE_SUPPORT_PROMPT", "1")
        import pygame
        self.pg = pygame
        pygame.init()
        import fedata
        import theme
        # O monitor em pe (Video Setup > orientation): a tela logica em pe,
        # antes de importar o que guarda o tamanho dela.
        try:
            orientation = fedata.web.conf_values().get("orientation", "")
        except OSError:
            orientation = ""
        orientation = os.environ.get("FLIPEROS_FE_ORIENTATION", orientation)
        theme.set_orientation(orientation)
        self.vertical = theme.VERTICAL is not None
        import background
        import feinput
        import feharvest
        import fevideo
        import feview
        import tiny
        import widgets
        self.view = feview
        self.T, self.W, self.tiny, self.fd = theme, widgets, tiny, fedata
        self.shot = args.shot
        self.window = None
        self.open()
        self.input = feinput.Input(pygame)
        self.keytable = evdev_keys(pygame)
        self.nag_at = 0.0
        self.back = pygame.Surface((theme.WIDTH, theme.HEIGHT))
        self.bg = background.pick(None if not self.shot else "stars", seed=7 if self.shot else None)
        self.start = time.monotonic()
        # As listas levam uns segundos: enquanto isso, o fundo do menu e o
        # aviso na tela (vindo do menu, a tela ficava preta ate aqui).
        cfg = load_config()
        loaded = {}

        def load():
            try:
                lib = fedata.Library()
                cats = lib.categories()
                cat = next((c for c in cats if c["key"] == cfg.get("category")), cats[0] if cats else None)
                if cat:
                    lib.games(cat)       # a lista que abre, ja lida
                loaded["lib"] = lib
            except Exception as e:  # o erro sai aqui, no laco principal
                loaded["error"] = e

        worker = threading.Thread(target=load, daemon=True)
        worker.start()
        while worker.is_alive() and not self.shot:
            self.splash()
            time.sleep(1 / 30)
        worker.join()
        if "error" in loaded:
            raise loaded["error"]
        self.lib = loaded["lib"]
        self.mode = cfg.get("mode", "list") if cfg.get("mode") in MODES else "list"
        self.cats = self.lib.categories()
        self.cat = next((i for i, c in enumerate(self.cats) if c["key"] == cfg.get("category")), 0)
        # O filtro e de cada romlist (frontend.json filters, pela chave dela):
        # trocar de romlist traz o filtro que ela tinha. O "filter" de antes,
        # um so para todas, vale para a romlist em que o frontend estava.
        self.filter_by = dict(cfg.get("filters") or {})
        if cfg.get("filter") and self.category() and self.category()["key"] not in self.filter_by:
            self.filter_by[self.category()["key"]] = cfg["filter"]
        self.load_filter()
        self.opened = set()        # os jogos pai com os clones abertos (na lista)
        # Tab > Frontend options > Show clones (gravado no frontend.json).
        self.show_clones = cfg.get("clones", True) is not False
        # Tab > Frontend options: o atalho que fecha o jogo (a tecla, como
        # [nome, codigo do evdev], e os botoes do painel), o botao de desligar
        # no jogo, o modo comercial e os minutos de cada ficha; o tempo
        # comprado vai ate credit_until (a hora do relogio: segue correndo
        # com o gabinete desligado).
        key = cfg.get("exit_key")
        self.exit_key = key if isinstance(key, list) and len(key) == 2 else None
        combo = cfg.get("exit_combo")
        self.exit_combo = [c for c in combo if c in COMBO_CONTROLS] if isinstance(combo, list) else []
        self.power_exit = cfg.get("power_exit", True) is not False
        self.commercial = cfg.get("commercial") is True
        self.coin_minutes = cfg.get("coin_minutes") if cfg.get("coin_minutes") in COIN_MINUTES else 5
        self.credit_until = float(cfg.get("credit_until") or 0)
        self.coin_at = 0.0         # a ultima ficha (o relogio aparece piscando)
        self.cursor = 0
        self.top = 0
        self.overlay = "guide"     # o guia dos controles ao abrir
        self.ov = {}               # o estado do que esta por cima
        self.ribbon_until = 0
        self.letter = None         # (letra, ate quando aparece)
        self.letter_mode = None
        self.toast = None
        self.repeat = {}           # acao -> proxima repeticao
        self.acc = 0.0
        self.media = {}            # (caminho, w, h, modo) -> surface
        self.anim = {}             # a rolagem animada: nome -> (valor, quando)
        # As imagens dos jogos em volta do cursor, lidas antes numa thread:
        # a troca de jogo fica instantanea.
        self.ready = {}            # (caminho, w, h, modo) -> surface lida
        self.flush = False         # um scrape trouxe arquivos novos
        self.ahead = []            # o que a thread le, o mais perto primeiro
        self.ahead_at = None
        self.ahead_wake = threading.Event()
        if not self.shot:
            threading.Thread(target=self.prefetch_work, daemon=True).start()
        # O video do jogo (fevideo.py); no --shot, sem video.
        self.player = fevideo.Player()
        # Os da grade, um por miniatura (fevideo.Grid).
        self.grid = fevideo.Grid()
        if self.shot:
            self.player.ok = False
            self.grid.ok = False
        # O ffmpeg do video fecha junto, saia o frontend como sair (o
        # SIGTERM da sessao ou do painel web passa pelo atexit).
        atexit.register(self.player.stop)
        atexit.register(self.grid.stop)
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        # O scrape sozinho: o jogo sem video e sem imagem, com o cursor
        # parado nele por AUTO_SCRAPE segundos.
        self.rest = (None, 0.0)    # (jogo sob o cursor, desde quando)
        self.scraped = set()       # os ja tentados nesta abertura
        self.scraping = None       # o jogo que esta sendo buscado
        # O scrape automatico de todos os jogos (feharvest.py), em segundo
        # plano; os jogos que ele buscou tem os caminhos de midia lidos de novo.
        self.dirty = set()         # (pasta, jogo)
        self.harvest = feharvest.Harvester(self)
        self.followed_at = 0.0
        if not self.shot:
            self.harvest.external = self.harvest.follow()
            self.harvest.start()
        self.generation = self.lib.generation
        self.last_check = time.monotonic()
        self.rows = []
        # Onde o cursor parou em cada game list (frontend.json positions).
        self.positions = dict(cfg.get("positions") or {})
        self.rebuild(keep=self.positions.get((self.category() or {}).get("key")) or cfg.get("game"))
        # As listas acompanham as pastas: o Setup confere e refaz (as de
        # arcade pelo XML do MAME) em segundo plano.
        if not self.shot:
            self.lib.refresh()

    # ── Video ──
    def open(self):
        pg = self.pg
        pg.display.init()
        size, flags = self.T.MODE, 0
        driver = os.environ.get("SDL_VIDEODRIVER")
        if driver == "kmsdrm":
            flags = pg.FULLSCREEN
            modes = pg.display.list_modes()
            if not isinstance(modes, list) or size not in modes:
                info = pg.display.Info()
                size = (info.current_w, info.current_h)
        elif driver == "x11":
            info = pg.display.Info()
            size, flags = (info.current_w, info.current_h), pg.NOFRAME
        self.window = pg.display.set_mode(size, flags)
        pg.display.set_caption("FliperOS")
        pg.mouse.set_visible(False)

    def close(self):
        import drmmaster
        self.pg.display.quit()
        # Na Intel o Mesa deixa o master da tela para tras e o jogo nao abre.
        drmmaster.drop()
        self.window = None

    def load_filter(self):
        """O filtro da romlist de agora (sem nota, o All Games)."""
        cat = self.category()
        names = [f["name"] for f in self.lib.filters]
        name = self.filter_by.get(cat["key"]) if cat else None
        self.flt = names.index(name) if name in names else self.default_filter()

    def set_filter(self, index):
        self.flt = index
        cat = self.category()
        if cat:
            self.filter_by[cat["key"]] = self.lib.filters[index % len(self.lib.filters)]["name"]

    def default_filter(self):
        names = [f["name"].lower() for f in self.lib.filters]
        return names.index("all games") if "all games" in names else 0

    # ── A lista da tela ──
    def category(self):
        return self.cats[self.cat % len(self.cats)] if self.cats else None

    def filtered(self):
        cat = self.category()
        if not cat:
            return []
        hidden = self.lib.hidden()
        games = [g for g in self.lib.games(cat) if (g["_system"]["key"], g["Name"]) not in hidden]
        return self.fd.apply_filter(games, self.lib.filters[self.flt % len(self.lib.filters)])

    def rebuild(self, keep=None):
        """As linhas da tela: (jogo, nivel, clones). Na lista os clones ficam
        debaixo do pai (abertos ou nao); na tela cheia e na grade, sempre logo
        depois dele (com o selo CLONE)."""
        games = self.filtered()
        rows = []
        for game, clones in self.fd.tree(games):
            if not self.show_clones:
                # Sem clones: so os jogos pai (e o clone sem o pai na lista).
                rows.append((game, 0, []))
                continue
            if self.mode == "list":
                rows.append((game, 0, clones))
                if clones and game["Name"] in self.opened:
                    rows.append((game, 1, "main"))
                    rows.extend((c, 1, game) for c in clones)
            else:
                rows.append((game, 0, clones))
                rows.extend((c, 1, game) for c in clones or ())
        self.rows = rows
        if keep:
            # O mesmo jogo, onde ele estiver agora (trocar de modo muda a
            # posicao dos clones): a linha dele mesmo, nao a "MAIN SET".
            found = [i for i, (g, _, extra) in enumerate(rows) if g["Name"] == keep and extra != "main"]
            if found:
                self.cursor = min(found, key=lambda i: (abs(i - self.cursor) if rows[i][1] else -1))
            else:
                # Um clone com o pai fechado na lista: o pai abre e ele aparece.
                g = next((g for g in games if g["Name"] == keep), None)
                parent = g.get("CloneOf") if g else None
                if parent and self.mode == "list" and self.show_clones and parent not in self.opened:
                    self.opened.add(parent)
                    return self.rebuild(keep)
        self.cursor = max(0, min(self.cursor, len(rows) - 1))

    def game(self):
        return self.rows[self.cursor][0] if self.rows else None

    def remember(self):
        g = self.game()
        self.keep_position()
        save_config({"mode": self.mode, "category": (self.category() or {}).get("key"),
                     "filters": self.filter_by,
                     "game": g["Name"] if g else None, "positions": self.positions,
                     "clones": self.show_clones, "exit_key": self.exit_key, "exit_combo": self.exit_combo,
                     "power_exit": self.power_exit, "commercial": self.commercial,
                     "coin_minutes": self.coin_minutes, "credit_until": self.credit_until})

    def keep_position(self):
        """O jogo onde o cursor esta, anotado para a game list de agora: ao
        voltar a ela (ou abrir o frontend de novo), o cursor volta nele."""
        g, cat = self.game(), self.category()
        if g and cat:
            self.positions[cat["key"]] = g["Name"]

    # ── Andar ──
    def move(self, step, wrap=True):
        """Anda step jogos; do ultimo para a frente volta ao primeiro, e do
        primeiro para tras vai ao ultimo (o salto que passa do fim para no
        fim, e o proximo da a volta). Segurando (wrap False) para no fim: um
        toque novo da a volta."""
        if not self.rows:
            return
        last = len(self.rows) - 1
        if wrap and step > 0 and self.cursor == last:
            self.cursor = 0
        elif wrap and step < 0 and self.cursor == 0:
            self.cursor = last
        else:
            self.cursor = max(0, min(last, self.cursor + step))

    def switch_category(self, step):
        if len(self.cats) < 2:
            return
        # A tira das romlists anda de onde estava (cat_pos nao da a volta).
        old = getattr(self, "cat_pos", self.cat)
        self.anim.setdefault("ribbon", (old, time.monotonic()))
        self.cat_pos = old + step
        self.keep_position()
        self.cat = (self.cat + step) % len(self.cats)
        self.load_filter()
        # A tela de antes desliza para fora (feview.draw).
        if getattr(self, "last_ui", None) is not None:
            self.slide = (self.last_ui, 1 if step > 0 else -1, time.monotonic())
        self.cursor = 0
        self.opened.clear()
        # O jogo onde o cursor parou nesta game list da ultima vez.
        self.rebuild(keep=self.positions.get((self.category() or {}).get("key")))
        self.remember()
        self.ribbon_until = time.monotonic() + 1.4

    def letter_jump(self, step, wrap=True):
        """O cursor no primeiro jogo da letra seguinte (ou anterior)."""
        if not self.rows:
            return
        letters = []
        for i, (g, level, _) in enumerate(self.rows):
            if level:
                continue
            c = self.fd.first_letter(g)
            if not letters or letters[-1][0] != c:
                letters.append((c, i))
        here = self.fd.first_letter(self.rows[self.cursor][0])
        idx = next((k for k, (c, _) in enumerate(letters) if c == here), 0)
        # Do Z volta ao comeco (segurando, para nele).
        idx = (idx + step) % len(letters) if wrap else max(0, min(len(letters) - 1, idx + step))
        self.cursor = letters[idx][1]
        # A letra fica no meio da tela enquanto o modo letra dura.
        self.letter = (letters[idx][0], float("inf"))
        if self.letter_mode:
            self.letter_mode["last"] = time.monotonic()

    def letter_off(self):
        """Fim do modo letra: a lista normal, no jogo da letra."""
        self.letter_mode = None
        self.letter = None

    def page(self):
        return {"list": 13, "full": 1, "flow": COLS * (3 if self.vertical else 2)}[self.mode]

    # ── As acoes ──
    def act(self, a):
        if a == "quit":
            return "quit"
        if a == "coin" and self.commercial and self.overlay != "exitpad":
            # A ficha vale em qualquer tela, ate com um menu aberto.
            self.insert_coin()
            return None
        if self.overlay:
            return self.overlay_act(a)
        if self.letter_mode and a in ("up", "down"):
            # No modo letra, cada toque passa uma letra; segurando, repete
            # (tick). Dois segundos sem mexer, volta a lista normal.
            now = time.monotonic()
            self.letter_mode["press"] = now
            self.letter_jump(1 if a == "down" else -1)
            self.repeat[a] = now + FIRST
            return None
        if self.letter_mode:
            # Outro botao: sai do modo letra e faz o que ele faz.
            self.letter_off()
        if a in ("up", "down"):
            step = 1 if a == "down" else -1
            self.move(step * (COLS if self.mode == "flow" else 1))
            self.repeat[a] = time.monotonic() + FIRST
            self.acc = 0.0
        elif a in ("left", "right"):
            step = 1 if a == "right" else -1
            if self.mode == "flow":
                col = self.cursor % COLS
                edge = (step < 0 and col == 0) or (step > 0 and (col == COLS - 1 or self.cursor == len(self.rows) - 1))
                if edge:
                    self.switch_category(step)
                else:
                    self.move(step)
            else:
                self.switch_category(step)
        elif a == "b3":
            self.move(-self.page())
        elif a == "b6":
            self.move(self.page())
        elif a == "b1":
            g, level, clones = self.rows[self.cursor] if self.rows else (None, 0, None)
            if g is None:
                return None
            if self.mode == "list" and level == 0 and clones:
                if g["Name"] in self.opened:
                    self.opened.discard(g["Name"])
                else:
                    self.opened.add(g["Name"])
                self.rebuild()
                if g["Name"] in self.opened:
                    self.cursor += 1
            elif self.locked():
                # O modo comercial sem tempo: escolher um jogo, so com ficha.
                self.nag()
            else:
                self.overlay, self.ov = "popup", {"sel": 0}
        elif a == "b2":
            # Num clone aberto, fecha o grupo (na tela cheia e na grade, volta ao pai);
            # senao, pergunta se sai. No modo comercial (quiosque) o cliente
            # nao fecha o frontend: so o Tab > Frontend options o desliga.
            g, level, parent = self.rows[self.cursor] if self.rows else (None, 0, None)
            if level:
                owner = g if parent == "main" else parent
                self.opened.discard(owner["Name"])
                self.rebuild(keep=owner["Name"])
                self.closed_group = time.monotonic()
            elif not self.commercial:
                self.overlay, self.ov = "exit", {"sel": 1}
        elif a == "esc" and self.commercial and time.monotonic() - getattr(self, "closed_group", 0) > 0.3:
            # O Esc do teclado (o operador) fecha o frontend mesmo no modo
            # comercial; o botao 2 do controle (o cliente), nao.
            self.overlay, self.ov = "exit", {"sel": 1}
        elif a == "b4":
            self.toggle_fav()
        elif a == "b5":
            self.overlay, self.ov = "filter", {"sel": self.flt % len(self.lib.filters), "top": 0}
        elif a == "start":
            self.set_mode(1)
            self.say(MODE_NAMES[self.mode])
        elif a == "tab":
            # Sem jogo na lista, so as opcoes do frontend.
            self.overlay, self.ov = "options", {"sel": 0 if self.game() else OPT_MODE}
        return None

    def set_mode(self, step):
        """O modo seguinte (ou o anterior), ja gravado."""
        g = self.game()
        self.mode = MODES[(MODES.index(self.mode) + step) % len(MODES)]
        self.rebuild(keep=g["Name"] if g else None)
        self.remember()

    def toggle_fav(self):
        g = self.game()
        if g:
            on = self.lib.set_favourite(g, g.get("Favourite") != "1")
            self.say("ADDED TO FAVOURITES" if on else "REMOVED FROM FAVOURITES")

    def say(self, text, seconds=1.6):
        self.toast = (text, time.monotonic() + seconds)

    # ── O modo comercial ──
    def left(self):
        """Os segundos de jogo que a ficha ainda paga."""
        return max(0.0, self.credit_until - time.time())

    def locked(self):
        """Modo comercial sem tempo: nao se escolhe jogo."""
        return self.commercial and self.left() <= 0

    def insert_coin(self):
        """Cada ficha soma os minutos dela ao tempo que ainda resta."""
        self.credit_until = max(time.time(), self.credit_until) + self.coin_minutes * 60
        self.coin_at = time.monotonic()
        self.say("+%d MIN" % self.coin_minutes)
        self.remember()

    def nag(self):
        """Um jogo pedido sem tempo: o indicador pisca mais forte."""
        self.nag_at = time.monotonic()
        self.say("INSERT COIN")

    def option_count(self):
        return OPT_COIN + 1 if self.commercial else OPT_COIN

    def overlay_act(self, a):
        o = self.overlay
        if o == "guide":
            if a not in ("up", "down", "left", "right"):
                self.overlay = None
            return None
        if a == "b2" and o not in ("rename", "exitkey", "exitpad"):
            self.overlay = {"more": "popup", "classify": "options"}.get(o)
            if self.overlay == "popup":
                self.ov = {"sel": 2}
            elif self.overlay == "options":
                self.ov = {"sel": 0}
            return None
        if o == "exit":
            if a in ("left", "right", "up", "down"):
                self.ov["sel"] ^= 1
            elif a == "b1":
                if self.ov["sel"] == 0:
                    return "quit"
                self.overlay = None
            return None
        if o == "popup":
            if a in ("left", "right"):
                self.ov["sel"] = (self.ov["sel"] + (1 if a == "right" else -1)) % 3
            elif a == "b4":
                self.toggle_fav()
            elif a == "b1":
                sel = self.ov["sel"]
                if sel == 0:
                    self.overlay = None
                    return "launch"
                if sel == 1:
                    self.toggle_fav()
                    self.overlay = None
                else:
                    self.open_more()
            return None
        if o == "more":
            if a in ("up", "down"):
                self.ov["scroll"] = max(0, self.ov.get("scroll", 0) + (1 if a == "down" else -1))
            elif a in ("left", "right"):
                # A pagina 2 (fotos e mais dados) fica a direita.
                page = 1 if a == "right" else 0
                if page != self.ov.get("page", 0):
                    self.ov["page"], self.ov["scroll"] = page, 0
            elif a == "b1":
                self.overlay = None
                return "launch"
            elif a == "b4":
                self.toggle_fav()
            return None
        if o == "filter":
            n = len(self.lib.filters)
            if a in ("up", "down"):
                self.ov["sel"] = (self.ov["sel"] + (1 if a == "down" else -1)) % n
            elif a in ("b3", "b6"):
                self.ov["sel"] = max(0, min(n - 1, self.ov["sel"] + (-10 if a == "b3" else 10)))
            elif a in ("b1", "b5"):
                if a == "b1":
                    g = self.game()
                    self.set_filter(self.ov["sel"])
                    self.cursor = 0
                    self.rebuild(keep=g["Name"] if g else None)
                    self.remember()
                self.overlay = None
            return None
        if o == "options":
            # 0 a 4: as opcoes do jogo (3: esconder, 4: apagar); depois as do
            # frontend: o modo, os clones, a lista dos escondidos, o atalho
            # que fecha o jogo (teclado e painel), o botao de desligar no
            # jogo, o modo comercial e os minutos de cada ficha.
            sel = self.ov["sel"]
            if a in ("up", "down"):
                self.ov["sel"] = (sel + (1 if a == "down" else -1)) % self.option_count()
            elif sel == OPT_EXIT_KEY and a == "b1":
                self.overlay, self.ov = "exitkey", {"since": time.monotonic()}
                self.input.capture = True
            elif sel == OPT_EXIT_PAD and a == "b1":
                self.overlay, self.ov = "exitpad", {"since": time.monotonic(), "held": None}
            elif sel in (OPT_EXIT_KEY, OPT_EXIT_PAD) and a in ("left", "right", "delete"):
                # Para o lado ou DELETE: o atalho sai (OFF).
                if sel == OPT_EXIT_KEY:
                    self.exit_key = None
                else:
                    self.exit_combo = []
                self.remember()
                if a == "delete":  # DELETE
                    self.say("EXIT KEY CLEARED" if sel == OPT_EXIT_KEY else "EXIT BUTTONS CLEARED", 2)
            elif sel == OPT_POWER and a in ("left", "right", "b1"):
                self.power_exit = not self.power_exit
                self.remember()
                self.say("POWER BUTTON CLOSES THE GAME" if self.power_exit else "POWER BUTTON OFF IN GAMES", 2.2)
            elif sel == OPT_COMMERCIAL and a in ("left", "right", "b1"):
                self.commercial = not self.commercial
                self.say("COMMERCIAL MODE ON" if self.commercial else "COMMERCIAL MODE OFF")
                if not self.commercial:
                    # Desligado, o tempo que restava some: ligado de novo,
                    # comeca sem ficha.
                    self.credit_until = 0.0
                if self.commercial and "coin" in self.exit_combo:
                    # A ficha passa a somar tempo: o atalho com ela sai.
                    self.exit_combo = []
                    self.say("EXIT BUTTONS OFF: COIN NOW ADDS TIME", 2.6)
                self.remember()
            elif sel == OPT_COIN and a in ("left", "right"):
                i = COIN_MINUTES.index(self.coin_minutes) + (1 if a == "right" else -1)
                self.coin_minutes = COIN_MINUTES[max(0, min(len(COIN_MINUTES) - 1, i))]
                self.remember()
            elif sel == OPT_MODE and a in ("left", "right", "b1"):
                self.set_mode(-1 if a == "left" else 1)
            elif sel == OPT_CLONES and a in ("left", "right", "b1"):
                g = self.game()
                self.show_clones = not self.show_clones
                self.rebuild(keep=(g.get("CloneOf") or g["Name"]) if g else None)
                self.remember()
                self.say("CLONES SHOWN" if self.show_clones else "CLONES HIDDEN")
            elif sel == OPT_HIDDEN and a == "b1":
                self.overlay, self.ov = "hidden", {"sel": 0, "rows": self.lib.hidden_games()}
            elif a == "b1" and sel == 3 and self.game():
                g = self.game()
                self.lib.set_hidden(g["_system"]["key"], g["Name"], True)
                self.overlay = None
                self.rebuild(keep=None)
                self.say("HIDDEN: TAB > HIDDEN GAMES BRINGS IT BACK", 2.5)
            elif a in ("b1",) and self.game() and sel < OPT_MODE:
                g = self.game()
                if sel == 0:
                    self.open_classify(g)
                elif sel == 1:
                    self.overlay = "rename"
                    self.ov = {"value": g.get("Title") or g["Name"], "key": (1, 0)}
                    self.input.text = True
                elif sel == 2:
                    self.overlay = None
                    self.scrape(g)
                elif self.lib.rom_files(g):
                    # Apagar pergunta antes, com o NO escolhido.
                    self.overlay, self.ov = "delete", {"sel": 1, "game": g, "files": self.lib.rom_files(g)}
                else:
                    self.overlay = None
                    self.say("NO FILE OF ITS OWN (IT IS IN THE PARENT'S)", 2.5)
            elif a == "tab":
                self.overlay = None
            return None
        if o == "exitkey":
            # A tecla que fecha o jogo: a proxima apertada no teclado. Uma do
            # painel (o encoder que se diz teclado) nao serve: cada botao faz
            # uma coisa so. O botao 2 de um controle desiste.
            if a.startswith("key:"):
                key = self.keytable.get(int(a[4:]))
                if key is None:
                    self.say("THIS KEY CANNOT BE USED", 2)
                elif key[0] in panel_keys(self.input.rows):
                    self.say("%s IS A PANEL CONTROL" % key[0], 2.4)
                else:
                    self.exit_key = list(key)
                    self.remember()
                    self.say("EXIT KEY: " + key[0], 2)
                self.capture_done("options", OPT_EXIT_KEY)
            elif a == "b2":
                self.capture_done("options", OPT_EXIT_KEY)
            return None
        if o == "exitpad":
            # Os botoes segurados juntos (capture_tick): os toques nao fazem nada.
            return None
        if o == "hidden":
            # Os escondidos: o botao 1 traz o jogo de volta; o 2 volta ao Tab.
            rows = self.ov["rows"]
            if a in ("up", "down") and rows:
                self.ov["sel"] = (self.ov["sel"] + (1 if a == "down" else -1)) % len(rows)
            elif a == "b1" and rows:
                key, name, _, title = rows.pop(self.ov["sel"])
                self.lib.set_hidden(key, name, False)
                self.ov["sel"] = min(self.ov["sel"], max(0, len(rows) - 1))
                g = self.game()
                self.rebuild(keep=g["Name"] if g else None)
                self.say("BACK IN THE LIST: " + title.upper(), 2)
            elif a in ("b2", "tab"):
                self.overlay, self.ov = "options", {"sel": OPT_HIDDEN}
            return None
        if o == "delete":
            if a in ("left", "right", "up", "down"):
                self.ov["sel"] ^= 1
            elif a == "b1":
                g = self.ov["game"]
                if self.ov["sel"] == 0:
                    self.player.stop()
                    n = self.lib.delete(g)
                    self.media.clear()
                    self.ready.clear()
                    self.rebuild(keep=None)
                    self.say("GAME DELETED" if n else "COULD NOT DELETE IT")
                self.overlay = None
            return None
        if o == "classify":
            fields = self.ov["fields"]
            sel = self.ov["sel"]
            if a in ("up", "down"):
                self.ov["sel"] = (sel + (1 if a == "down" else -1)) % (len(fields) + 1)
            elif a in ("left", "right") and sel < len(fields):
                field, values, i = fields[sel]
                if values:
                    i = (i + (1 if a == "right" else -1)) % len(values)
                    fields[sel] = (field, values, i)
            elif a == "b1":
                changes = {f: v[i] for f, v, i in fields if v and v[i] != (self.ov["game"].get(f) or "")}
                if changes and self.lib.save_edits(self.ov["game"], changes):
                    self.say("SAVED")
                    self.lib.forget()
                    self.rebuild(keep=self.ov["game"]["Name"])
                self.overlay = None
            return None
        if o == "rename":
            return self.rename_act(a)
        return None

    def capture_done(self, overlay, sel):
        """Fim da escolha do atalho: de volta ao Tab, na linha dele."""
        self.input.capture = False
        self.overlay, self.ov = overlay, {"sel": sel}

    def capture_tick(self, now):
        """A escolha dos botoes do atalho: dois ou mais comandos do painel
        segurados juntos por EXIT_HOLD segundos; CAPTURE_WAIT sem nada, sai
        como estava."""
        o = self.overlay
        if o not in ("exitkey", "exitpad"):
            return
        held = frozenset(a for a in COMBO_CONTROLS if self.input.held(a) is not None)
        if o == "exitpad" and self.commercial and "coin" in held:
            # No modo comercial a ficha soma tempo: ela nao fecha o jogo.
            self.say("IN COMMERCIAL MODE COIN ADDS TIME", 2.4)
            self.capture_done("options", OPT_EXIT_PAD)
            return
        if o == "exitpad" and len(held) >= 2:
            if held != self.ov["held"]:
                self.ov["held"], self.ov["at"] = held, now
            elif now - self.ov["at"] >= EXIT_HOLD:
                self.exit_combo = [a for a in COMBO_CONTROLS if a in held]
                self.remember()
                self.say("EXIT BUTTONS: " + "+".join(combo_names(self.exit_combo)), 2.4)
                self.capture_done("options", OPT_EXIT_PAD)
            return
        if o == "exitpad":
            self.ov["held"] = None
            if held:
                self.ov["since"] = now
        if now - self.ov["since"] > CAPTURE_WAIT:
            self.say("NOTHING CHANGED")
            self.capture_done("options", OPT_EXIT_KEY if o == "exitkey" else OPT_EXIT_PAD)

    KEYS = ["1234567890", "QWERTYUIOP", "ASDFGHJKL-", "ZXCVBNM.:/"]

    def rename_act(self, a):
        r, c = self.ov["key"]
        if a.startswith("char:"):
            self.ov["value"] += a[5:]
        elif a == "backspace":
            self.ov["value"] = self.ov["value"][:-1]
        elif a in ("up", "down"):
            r = (r + (1 if a == "down" else -1)) % 5
        elif a in ("left", "right"):
            c = (c + (1 if a == "right" else -1)) % (10 if r < 4 else 3)
        elif a == "b1":
            if r < 4:
                self.ov["value"] += self.KEYS[r][c]
            elif c == 0:
                self.ov["value"] += " "
            elif c == 1:
                self.ov["value"] = self.ov["value"][:-1]
            else:
                g = self.game()
                title = self.ov["value"].strip()
                if title and self.lib.save_edits(g, {"Title": title}):
                    self.lib.forget()
                    self.rebuild(keep=g["Name"])
                    self.say("RENAMED")
                self.overlay = None
                self.input.text = False
        elif a == "b2":
            self.overlay = None
            self.input.text = False
        if r == 4:
            c = min(c, 2)
        self.ov["key"] = (r, c)
        return None

    def open_more(self):
        g = self.game()
        self.overlay = "more"
        self.ov = {"game": g, "info": None, "loading": False, "scroll": 0}
        system = g["_system"]
        if not system["arcade"]:
            return
        self.ov["loading"] = True
        ov = self.ov

        def work():
            try:
                info, _ = self.lib.info.arcade(system["key"], g["Name"], "en")
            except (OSError, ValueError):
                info = None
            ov["info"], ov["loading"] = info, False

        threading.Thread(target=work, daemon=True).start()

    def open_classify(self, g):
        cat = self.category()
        fields = []
        for field in ("Category", "Players", "Buttons", "Control", "Year", "Manufacturer", "Rotation", "Series"):
            values = self.lib.values(cat, field)
            cur = g.get(field) or ""
            if cur and cur not in values:
                values.insert(0, cur)
            fields.append((field, values, values.index(cur) if cur in values else 0))
        self.overlay = "classify"
        self.ov = {"game": g, "fields": fields, "sel": 0}

    def auto_scrape(self, now):
        """O jogo sob o cursor ha AUTO_SCRAPE segundos, em qualquer modo, sem
        alguma das artes (a tela, a capa, o marquee, o video): busca uma vez
        so o que falta (o que vier fica nas pastas de ~/media)."""
        g = self.game()
        if g is None or self.overlay or self.letter_mode:
            self.rest = (None, now)
            return
        if self.rest[0] is not g:
            self.rest = (g, now)
            return
        # Parado ali: a posicao ja fica gravada (desligar sem sair do
        # frontend tambem volta nela).
        if now - self.rest[1] >= AUTO_SCRAPE and getattr(self, "saved_at", None) is not g:
            self.saved_at = g
            self.remember()
        key = (g["_system"]["key"], g["Name"])
        if (self.scraping or key in self.scraped or now - self.rest[1] < AUTO_SCRAPE
                or self.harvest.current is g):
            return
        self.scraped.add(key)
        # Com tudo (as informacoes, a arte e o video), nada a buscar; e o que
        # ja foi buscado assim nos ultimos dias (a fonte nao tem o que falta)
        # nao e buscado de novo a cada abertura.
        before = self.fd.missing_art(self.lib, g)
        if not before and not self.harvest.missing(g):
            return
        hkey = self.harvest.key(g)
        rested = self.harvest.state.setdefault("rested", {})
        if time.time() - rested.get(hkey, 0) < self.harvest.RETRY_DAYS * 86400:
            return
        self.scraping = g

        def work():
            try:
                self.fd.scrape(self.lib, g, only_missing=True)
            except Exception:  # sem rede, um site fora: tenta de novo na proxima abertura
                pass
            after = self.fd.missing_art(self.lib, g)
            rested[hkey] = int(time.time())
            self.harvest.save()
            self.flush = True
            self.scraping = None
            if len(after) < len(before) and self.game() is g:
                self.say("ART DOWNLOADED")

        threading.Thread(target=work, daemon=True).start()

    def scrape(self, g):
        self.say("SCRAPING...", 60)

        def work():
            n = self.fd.scrape(self.lib, g)
            self.flush = True
            self.say("%d FILES" % n if n else "NOTHING FOUND")

        threading.Thread(target=work, daemon=True).start()

    # ── Jogar ──
    def launch(self):
        g = self.game()
        argv = self.lib.command(g) if g else None
        if not argv:
            self.say("CANNOT OPEN THIS GAME")
            return
        if self.locked():
            self.nag()
            return
        self.remember()
        pg = self.pg
        # O video, o som, os controles (e a rede) ficam para o jogo.
        self.player.stop()
        self.grid.stop()
        self.harvest.paused = True
        self.input.close()
        try:
            pg.mixer.quit()
        except pg.error:
            pass
        self.close()
        started = time.monotonic()
        ended = self.play(argv)
        played = time.monotonic() - started
        if played > 10:
            self.lib.played(g, played)
        self.harvest.paused = False
        self.open()
        self.input.open()
        self.media.clear()
        self.repeat.clear()
        pg.event.clear()
        if ended:
            self.say(ended, 3)

    def play(self, argv):
        """Abre o jogo e espera ele fechar. Enquanto isso: o atalho que o
        fecha (Tab > Frontend options), as fichas e o fim do tempo do modo
        comercial, e o arquivo do botao de desligar (FLIPEROS_POWERKEY
        games:ARQ, do config/fliperos-session) com o PID do jogo, ou "hold"
        com o botao desligado nos jogos. Devolve o aviso para a volta."""
        try:
            proc = subprocess.Popen(argv)
        except OSError:
            return None
        role = os.environ.get("FLIPEROS_POWERKEY", "")
        mark = role[len("games:"):] if role.startswith("games:") else None
        if mark:
            try:
                with open(mark, "w") as f:
                    f.write("%d\n" % proc.pid if self.power_exit else "hold\n")
            except OSError:
                mark = None
        state = {}
        watch = self.hotkeys()
        if watch:
            def read():
                for line in watch.stdout:
                    if line.strip() == "exit":
                        state["exit"] = True
                    elif line.strip() == "coin":
                        self.insert_coin()
            threading.Thread(target=read, daemon=True).start()
        try:
            while proc.poll() is None:
                if state.pop("exit", False):
                    self.stop(proc, state)
                elif self.commercial and self.left() <= 0 and "time" not in state:
                    # O tempo acabou: o jogo fecha.
                    state["time"] = True
                    self.stop(proc, state)
                elif state.get("kill") and time.monotonic() > state["kill"]:
                    self.stop(proc, state, signal.SIGKILL)
                time.sleep(0.1)
        finally:
            if proc.poll() is None:
                self.stop(proc, state)
            if watch:
                watch.terminate()
                try:
                    watch.wait(2)
                except subprocess.TimeoutExpired:
                    watch.kill()
            if mark:
                try:
                    os.unlink(mark)
                except OSError:
                    pass
        return "TIME IS UP - INSERT COIN" if state.get("time") else None

    def stop(self, proc, state, sig=signal.SIGTERM):
        """Fecha o jogo: ele e o que esta abaixo dele (o X, o emulador); quem
        nao sai em 4 s leva o SIGKILL."""
        for pid in tree(proc.pid):
            try:
                os.kill(pid, sig)
            except OSError:
                pass
        state["kill"] = time.monotonic() + 4 if sig == signal.SIGTERM else None

    def hotkeys(self):
        """O fliperos-buttons hotkey junto com o jogo: o atalho que o fecha e,
        no modo comercial, as fichas. Sem nada a ler, nenhum."""
        args = []
        if self.exit_key:
            args += ["--key", str(self.exit_key[1])]
        if self.exit_combo:
            args += ["--combo", "+".join(self.exit_combo), "--hold", str(EXIT_HOLD)]
        if self.commercial:
            args.append("--coin")
        if not args or not os.access(BUTTONS_TOOL, os.X_OK):
            return None
        try:
            return subprocess.Popen([BUTTONS_TOOL, "hotkey"] + args, stdin=subprocess.DEVNULL,
                                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        except OSError:
            return None

    # ── O laco ──
    def tick(self, now):
        """As repeticoes segurando, a aceleracao e o modo letra."""
        dt = min(0.1, now - getattr(self, "last_tick", now))
        self.last_tick = now
        if self.overlay and self.overlay not in ("filter", "classify", "rename", "more"):
            return
        # O modo letra acaba com LETTER_IDLE segundos sem mexer.
        if (self.letter_mode and self.input.held("up") is None and self.input.held("down") is None
                and now - self.letter_mode["last"] > LETTER_IDLE):
            self.letter_off()
        for a in ("up", "down"):
            held = self.input.held(a)
            if held is None:
                self.repeat.pop(a, None)
                continue
            if self.overlay:
                # Nos menus, a repeticao simples (sem acelerar).
                if a not in self.repeat:
                    self.repeat[a] = now + FIRST
                elif now >= self.repeat[a]:
                    self.repeat[a] = now + 0.12
                    self.overlay_act(a)
                continue
            step = 1 if a == "down" else -1
            if self.letter_mode:
                # Segurando no modo letra: repete a letra, devagar e depois
                # mais rapido.
                lheld = now - self.letter_mode["press"]
                if lheld >= FIRST and now >= self.repeat.get(a, 0):
                    rate = LRATE0 if lheld < LSPEEDUP else min(LRATE1, LRATE0 + (lheld - LSPEEDUP) * 9)
                    self.letter_jump(step, wrap=False)
                    self.repeat[a] = now + 1.0 / rate
            elif held >= LETTERS:
                # 3 s segurando: entra no modo letra, que ja comeca andando.
                self.letter_mode = {"press": now - FIRST, "last": now}
                self.letter_jump(step, wrap=False)
                self.repeat[a] = now + 1.0 / LRATE0
            elif held >= FIRST:
                k = min(1.0, (held - FIRST) / (LETTERS - FIRST))
                self.acc += (RATE0 + (RATE1 - RATE0) * k ** 1.5) * dt
                n = int(self.acc)
                if n:
                    self.acc -= n
                    self.move(step * n * (COLS if self.mode == "flow" else 1), wrap=False)
        for a, gap in (("left", 0.5), ("right", 0.5), ("b3", 0.18), ("b6", 0.18)):
            held = self.input.held(a)
            if held is None or self.overlay:
                continue
            if held >= gap and now >= self.repeat.get(a, 0):
                self.repeat[a] = now + (0.35 if a in ("left", "right") else 0.15)
                self.act(a)

    def run(self, keys=()):
        clock = self.pg.time.Clock()
        if self.shot:
            self.overlay = None
            frames = [None] + list(keys)
            for i, k in enumerate(frames):
                if k:
                    if self.act(k) == "quit":
                        break
                self.draw(time.monotonic())
                self.pg.image.save(self.back, "%s-%d.png" % (self.shot, i))
            return 0
        while True:
            now = time.monotonic()
            for a in self.input.poll():
                r = self.act(a)
                if r == "quit":
                    self.remember()
                    return 0
                if r == "launch":
                    self.launch()
            self.tick(now)
            self.capture_tick(now)
            # O tempo do modo comercial acabou aqui no frontend.
            paid = self.commercial and self.left() > 0
            if getattr(self, "paid", False) and not paid:
                self.say("TIME IS UP - INSERT COIN", 3)
            self.paid = paid
            if self.lib.generation != self.generation:
                self.generation = self.lib.generation
                g = self.game()
                key = (self.category() or {}).get("key")
                self.cats = self.lib.categories()
                self.cat = next((i for i, c in enumerate(self.cats) if c["key"] == key), 0)
                self.load_filter()
                self.rebuild(keep=g["Name"] if g else None)
            if now - self.last_check > 4 and not self.lib.refreshing:
                self.last_check = now
                if self.lib.changed():
                    self.say("UPDATING THE LISTS...", 3)
                    self.lib.refresh()
            self.auto_scrape(now)
            # O servico do scrape automatico (fliperos-scrape --daemon): o
            # andamento dele e a midia nova; sem ele, o laco e o daqui.
            if now - self.followed_at > 3:
                self.followed_at = now
                self.harvest.external = self.harvest.follow()
            while self.dirty:
                folder, name = self.dirty.pop()
                for kind in ("snap", "box", "marquee", "logo", "preview"):
                    self.media.pop(("path", kind, folder, name), None)
                self.media.pop(("video", folder, name), None)
                self.ahead_at = None
            if self.flush:
                # Um scrape trouxe arquivos: os caminhos e as imagens guardados
                # sao lidos de novo (limpos aqui, fora da thread dele).
                self.flush = False
                self.media.clear()
                self.ready.clear()
                self.ahead_at = None
            self.prefetch()
            self.draw(now)
            self.present()
            clock.tick(FPS)

    def splash(self):
        """A tela de abrir: o fundo animado do menu e o aviso."""
        T, W = self.T, self.W
        self.pg.event.pump()
        self.bg.draw(self.back, time.monotonic() - self.start)
        ui = self.pg.Surface((T.WIDTH, T.HEIGHT), self.pg.SRCALPHA)
        W.frame(ui, {}, "FliperOS", [])
        msg = "LOADING THE GAMES..."
        ui.blit(W.big(msg, 1, W.LABEL), ((T.WIDTH - W.width(msg)) // 2, T.HEIGHT // 2 - 4))
        self.back.blit(ui, (0, 0))
        self.present()

    # ── Adiantar as imagens ──
    def prefetch(self):
        """Quando o cursor (ou o modo, ou a lista) muda, passa a thread as
        imagens dos proximos jogos para os dois lados, as do lado de baixo
        primeiro; na grade, tambem as da fileira de cima e de baixo."""
        at = (self.cursor, self.mode, id(self.rows), len(self.rows), self.overlay)
        if at == self.ahead_at or not self.rows:
            return
        self.ahead_at = at
        reach = 3 * COLS if self.mode == "flow" else 6
        order = [0]
        for k in range(1, reach + 1):
            order += [k, -k]
        keys = []
        import feview
        for k in order:
            i = self.cursor + k
            if 0 <= i < len(self.rows):
                for key in feview.wanted(self, self.rows[i][0]):
                    if key not in self.media and key not in self.ready and key not in keys:
                        keys.append(key)
        self.ahead = keys
        self.ahead_wake.set()

    def prefetch_work(self):
        import feview
        while True:
            self.ahead_wake.wait()
            self.ahead_wake.clear()
            while self.ahead:
                keys = self.ahead
                key = keys[0]
                if keys is self.ahead:
                    self.ahead = keys[1:]
                if key in self.media or key in self.ready:
                    continue
                try:
                    img = feview.load(*key)
                except Exception:  # um arquivo estragado: o desenho tenta de novo
                    continue
                if len(self.ready) > 120:
                    try:
                        self.ready.pop(next(iter(self.ready)), None)
                    except (RuntimeError, StopIteration):
                        pass
                self.ready[key] = img

    def present(self):
        if self.window is None:
            return
        # Em pe, a tela logica gira para o lado do monitor antes de esticar.
        self.pg.transform.scale(self.T.upright(self.back), self.window.get_size(), self.window)
        self.pg.display.flip()

    # ── Desenho ──
    def draw(self, now):
        self.view.draw(self, now)   # (o desenho fica em gui/feview.py)


def main():
    parser = argparse.ArgumentParser(description="FliperOS frontend")
    parser.add_argument("--shot", help="no video: write PREFIX-N.png after each key of --keys")
    parser.add_argument("--keys", default="", help="actions to run first, e.g. 'b1 right b1'")
    args = parser.parse_args()
    fe = Frontend(args)
    return fe.run(args.keys.split())


if __name__ == "__main__":
    sys.exit(main())
