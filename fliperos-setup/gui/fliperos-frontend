def evdev_keys(pg):
    """As teclas que fecham o jogo: a do pygame -> (nome, codigo do evdev,
    o do kernel, que o fliperos-buttons hotkey le junto com o jogo)."""
    k = pg
    table = {k.K_ESCAPE: ("ESC", 1), k.K_BACKSPACE: ("BACKSPACE", 14), k.K_TAB: ("TAB", 15),
             k.K_RETURN: ("ENTER", 28), k.K_SPACE: ("SPACE", 57), k.K_PAUSE: ("PAUSE", 119),
             k.K_HOME: ("HOME", 102), k.K_END: ("END", 107), k.K_INSERT: ("INSERT", 110),
             k.K_DELETE: ("DELETE", 111), k.K_PAGEUP: ("PAGE UP", 104), k.K_PAGEDOWN: ("PAGE DOWN", 109),
             k.K_0: ("0", 11)}
    for n, code in enumerate((59, 60, 61, 62, 63, 64, 65, 66, 67, 68, 87, 88), 1):
        table[getattr(k, "K_F%d" % n)] = ("F%d" % n, code)
    for row, first in (("qwertyuiop", 16), ("asdfghjkl", 30), ("zxcvbnm", 44)):
        for i, c in enumerate(row):
            table[getattr(k, "K_" + c)] = (c.upper(), first + i)
    for n in range(1, 10):
        table[getattr(k, "K_%d" % n)] = (str(n), n + 1)
    return table


def panel_keys(rows):
    """Os nomes das teclas que o Button mapping deu ao painel (um encoder
    que se diz teclado, "k:NOME" do MAME): uma delas nao fecha o jogo."""
    alias = {"LCONTROL": "CTRL", "RCONTROL": "CTRL", "LALT": "ALT", "LSHIFT": "SHIFT", "RSHIFT": "SHIFT"}
    return {alias.get(e[2:], e[2:]) for _, _, e in rows if e.startswith("k:")}


def combo_names(combo):
    """Os botoes do atalho na tela: START, COIN, 1 a 6 e as direcoes."""
    return [c[1:] if c[0] == "b" and c[1:].isdigit() else c.upper() for c in combo]


def game_env():
    """O ambiente do jogo: sem o SDL do KMS que a sessao deu ao frontend
    (FLIPEROS_FRONTEND_SDL, config/fliperos-session). Os emuladores abrem com o
    SDL de sempre; o GroovyMAME poe o do KMS ele mesmo."""
    env = dict(os.environ)
    sdl = env.pop("FLIPEROS_FRONTEND_SDL", "")
    if sdl:
        rest = [p for p in env.get("LD_LIBRARY_PATH", "").split(":") if p and p != sdl]
        if rest:
            env["LD_LIBRARY_PATH"] = ":".join(rest)
        else:
            env.pop("LD_LIBRARY_PATH", None)
    return env


def missing_core(argv):
    """O core do RetroArch do comando (-L /.../NOME_libretro.so) quando ele
    ainda nao esta instalado; senao None."""
    for flag, core in zip(argv, argv[1:]):
        if flag in ("-L", "--libretro") and core.endswith("_libretro.so") and "/" in core:
            return None if os.path.exists(core) else core
    return None


def tree(pid):
    """O processo e os que estao abaixo dele (o jogo e o X, o emulador...)."""
    import glob
    found = [pid]
    for path in glob.glob("/proc/%d/task/*/children" % pid):
        try:
            with open(path) as f:
                for child in f.read().split():
                    found += tree(int(child))
        except (OSError, ValueError):
            pass
    return found


def load_config():
    try:
        with open(CONFIG, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_config(data):
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG + ".tmp", "w", encoding="utf-8") as f:
            json.dump(data, f)
        os.replace(CONFIG + ".tmp", CONFIG)
    except OSError:
        pass


class Frontend:
    def __init__(self, args):
        if args.shot:
            os.environ["SDL_VIDEODRIVER"] = "dummy"
        os.environ.setdefault("PYGAME_HIDE_SUPPORT_PROMPT", "1")
        import pygame
        self.pg = pygame
        pygame.init()
        import fedata
        import theme
        # O monitor em pe (Video Setup > orientation): a tela logica em pe,
        # antes de importar o que guarda o tamanho dela.
        try:
            orientation = fedata.web.conf_values().get("orientation", "")
        except OSError:
            orientation = ""
        orientation = os.environ.get("FLIPEROS_FE_ORIENTATION", orientation)
        theme.set_orientation(orientation)
        self.vertical = theme.VERTICAL is not None
        import background
        import feinput
        import febios
        import feharvest
        import fevideo
        import feview
        import tiny
        import widgets
        self.view = feview
        self.T, self.W, self.tiny, self.fd = theme, widgets, tiny, fedata
        self.shot = args.shot
        self.window = None
        self.open()
        cfg = load_config()
        # As funcoes de cada botao e tecla (Tab > Frontend options > Frontend controls).
        self.fi = feinput
        self.input = feinput.Input(pygame, feinput.load_binds(pygame, cfg.get("controls")))
        # O formato do painel, para o guia (feview.PANEL_LAYOUTS).
        self.panel_layout = cfg.get("panel_layout") if cfg.get("panel_layout") in feview.PANEL_COUNT else "6"
        # A animacao da troca de romlist de cada modo (Tab > Transition;
        # feview.transition confere o nome).
        self.transitions = cfg.get("transitions") if isinstance(cfg.get("transitions"), dict) else {}
        self.keytable = evdev_keys(pygame)
        self.nag_at = 0.0
        self.back = pygame.Surface((theme.WIDTH, theme.HEIGHT))
        self.bg = background.pick(None if not self.shot else "stars", seed=7 if self.shot else None)
        self.start = time.monotonic()
        # As listas levam uns segundos: enquanto isso, o fundo do menu e o
        # aviso na tela (vindo do menu, a tela ficava preta ate aqui).
        loaded = {}

        def load():
            try:
                lib = fedata.Library()
                cats = lib.categories()
                cat = next((c for c in cats if c["key"] == cfg.get("category")), cats[0] if cats else None)
                if cat:
                    lib.games(cat)       # a lista que abre, ja lida
                loaded["lib"] = lib
            except Exception as e:  # o erro sai aqui, no laco principal
                loaded["error"] = e

        worker = threading.Thread(target=load, daemon=True)
        worker.start()
        while worker.is_alive() and not self.shot:
            self.splash()
            time.sleep(1 / 30)
        worker.join()
        if "error" in loaded:
            raise loaded["error"]
        self.lib = loaded["lib"]
        self.mode = cfg.get("mode", "list") if cfg.get("mode") in MODES else "list"
        self.cats = self.lib.categories()
        self.cat = next((i for i, c in enumerate(self.cats) if c["key"] == cfg.get("category")), 0)
        # O filtro e de cada romlist (frontend.json filters, pela chave dela):
        # trocar de romlist traz o filtro que ela tinha. O "filter" de antes,
        # um so para todas, vale para a romlist em que o frontend estava.
        self.filter_by = dict(cfg.get("filters") or {})
        if cfg.get("filter") and self.category() and self.category()["key"] not in self.filter_by:
            self.filter_by[self.category()["key"]] = cfg["filter"]
        # O tipo de controle (o 5 > CONTROL), tambem de cada romlist.
        self.ctrl_by = dict(cfg.get("control_filters") or {})
        self.load_filter()
        self.opened = set()        # os jogos pai com os clones abertos (na lista)
        self.groups_open = set()   # RECENT / FAVOURITES abertos no alto da lista
        self.parties_open = set()  # (sistema, jogo) do alto com as parties abertas
        # Tab > Frontend options > Show clones (gravado no frontend.json).
        self.show_clones = cfg.get("clones", True) is not False
        # Tab > Frontend options: o atalho que fecha o jogo (a tecla, como
        # [nome, codigo do evdev], e os botoes do painel), o botao de desligar
        # no jogo, o modo comercial e os minutos de cada ficha; o tempo
        # comprado vai ate credit_until (a hora do relogio: segue correndo
        # com o gabinete desligado).
        key = cfg.get("exit_key")
        self.exit_key = key if isinstance(key, list) and len(key) == 2 else None
        combo = cfg.get("exit_combo")
        self.exit_combo = [c for c in combo if c in COMBO_CONTROLS] if isinstance(combo, list) else []
        self.power_exit = cfg.get("power_exit", True) is not False
        self.commercial = cfg.get("commercial") is True
        self.coin_minutes = cfg.get("coin_minutes") if cfg.get("coin_minutes") in COIN_MINUTES else 5
        self.credit_until = float(cfg.get("credit_until") or 0)
        self.coin_at = 0.0         # a ultima ficha (o relogio aparece piscando)
        self.cursor = 0
        self.top = 0
        self.overlay = "guide"     # o guia dos controles ao abrir
        self.ov = {}               # o estado do que esta por cima
        # A primeira vez que o frontend abre: antes do guia, o Frontend
        # controls, para o usuario dizer o que cada botao faz.
        self.controls_seen = cfg.get("controls_seen") is True
        if not self.controls_seen:
            self.overlay, self.ov = "controls", {"sel": 0, "col": 0, "wait": None}
        self.ribbon_until = 0
        self.pick = 0              # os passos andados na tira, a lista ainda nao trocou
        self.pick_at = 0.0
        # A tira aberta esperando a escolha (tambem com pick 0: andou e voltou
        # ao sistema da lista).
        self.picking = False
        self.letter = None        # (letra, ate quando aparece)
        self.letter_mode = None
        self.toast = None
        self.repeat = {}           # acao -> proxima repeticao
        self.acc = 0.0
        self.media = {}            # (caminho, w, h, modo) -> surface
        self.anim = {}             # a rolagem animada: nome -> (valor, quando)
        # As imagens dos jogos em volta do cursor, lidas antes numa thread:
        # a troca de jogo fica instantanea.
        self.ready = {}            # (caminho, w, h, modo) -> surface lida
        self.flush = False         # um scrape trouxe arquivos novos
        self.ahead = []            # o que a thread le, o mais perto primeiro
        self.ahead_at = None
        self.ahead_wake = threading.Event()
        if not self.shot:
            threading.Thread(target=self.prefetch_work, daemon=True).start()
        # O video do jogo (fevideo.py); no --shot, sem video.
        self.player = fevideo.Player()
        # Os da grade, um por miniatura (fevideo.Grid).
        self.grid = fevideo.Grid()
        if self.shot:
            self.player.ok = False
            self.grid.ok = False
        # O ffmpeg do video fecha junto, saia o frontend como sair (o
        # SIGTERM da sessao ou do painel web passa pelo atexit).
        atexit.register(self.player.stop)
        atexit.register(self.grid.stop)
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        # O scrape sozinho: o jogo sem video e sem imagem, com o cursor
        # parado nele por AUTO_SCRAPE segundos.
        self.rest = (None, 0.0)    # (jogo sob o cursor, desde quando)
        self.scraped = set()       # os ja tentados nesta abertura
        self.scraping = None       # o jogo que esta sendo buscado
        # O scrape automatico de todos os jogos (feharvest.py), em segundo
        # plano; os jogos que ele buscou tem os caminhos de midia lidos de novo.
        self.dirty = set()         # (pasta, jogo)
        self.harvest = feharvest.Harvester(self)
        self.followed_at = 0.0
        # O baixador de BIOS (febios.py): o andamento dele no menu do Tab, como o
        # do scrape. A checagem automatica sai daqui tambem (o frontend abre
        # antes do menu do Setup); so olha de novo se as pastas mudaram.
        self.bios = febios.BiosStatus()
        if not self.shot:
            febios.start_check()
            self.harvest.external = self.harvest.follow()
            self.harvest.start()
        self.generation = self.lib.generation
        self.last_check = time.monotonic()
        # O link play (gui/felink.py): quem esta na rede cabeada, a festa e o
        # comando dos jogos de link. Sem cabo, ele fica desligado.
        import felink
        self.felink = felink
        self.link = felink.Link(fedata.web.player_home(), wire=None if self.shot else False)
        self.link_game = None      # o jogo da festa (a sala e a copia dos arquivos)
        self.link_sig = ()         # o que a rede mostra, para refazer a lista quando muda
        # O aviso embaixo, com o sininho, quando outro gabinete abre uma party
        # ou um link: (nome do gabinete, jogo, ate quando). parties_seen: as que
        # ja avisaram.
        self.notice = None
        self.parties_seen = set()
        self.players_seen = None   # os jogadores de agora, para avisar quando um controle sai ou volta
        # FLIPEROS_LINK_FAKE: a rede de mentira (os testes de tela e o
        # emulador do frontend, tools/fe-emulator, que so olha a rede).
        self.link_fake = bool(os.environ.get("FLIPEROS_LINK_FAKE"))
        if self.shot or self.link_fake:
            felink.fake_link(self.link, os.environ.get("FLIPEROS_LINK_FAKE"))
        else:
            self.link.start()
            atexit.register(self.link.stop)
        self.rows = []
        # Onde o cursor parou em cada game list (frontend.json positions).
        self.positions = dict(cfg.get("positions") or {})
        self.rebuild(keep=self.positions.get((self.category() or {}).get("key")) or cfg.get("game"))
        # As listas acompanham as pastas: o Setup confere e refaz (as de
        # arcade pelo XML do MAME) em segundo plano.
        if not self.shot:
            self.lib.refresh()

    # ── Video ──
    def open(self):
        pg = self.pg
        pg.display.init()
        size, flags = self.T.MODE, 0
        driver = os.environ.get("SDL_VIDEODRIVER")
        if driver == "kmsdrm":
            flags = pg.FULLSCREEN
            modes = pg.display.list_modes()
            if not isinstance(modes, list) or size not in modes:
                info = pg.display.Info()
                size = (info.current_w, info.current_h)
        elif driver == "x11":
            info = pg.display.Info()
            size, flags = (info.current_w, info.current_h), pg.NOFRAME
        self.window = pg.display.set_mode(size, flags)
        pg.display.set_caption("FliperOS")
        pg.mouse.set_visible(False)

    def close(self):
        import drmmaster
        self.pg.display.quit()
        # Na Intel o Mesa deixa o master da tela para tras e o jogo nao abre.
        drmmaster.drop()
        self.window = None

    def load_filter(self):
        """O filtro da romlist de agora (sem nota, o All Games)."""
        cat = self.category()
        names = [f["name"] for f in self.lib.filters]
        name = self.filter_by.get(cat["key"]) if cat else None
        self.flt = names.index(name) if name in names else self.default_filter()
        self.ctrl = self.ctrl_by.get(cat["key"]) if cat else None

    def set_control(self, kind):
        """O tipo de controle da romlist de agora (None: todos)."""
        self.ctrl = kind
        cat = self.category()
        if cat:
            if kind:
                self.ctrl_by[cat["key"]] = kind
            else:
                self.ctrl_by.pop(cat["key"], None)

    def open_filters(self):
        """O menu do 5: a linha CONTROL (os tipos que algum jogo da romlist
        tem) e os filtros que deixam ao menos um jogo nela (o de agora fica
        sempre, para o visto mostrar onde se esta)."""
        cat = self.category()
        hidden = self.lib.hidden()
        games = [g for g in self.lib.games(cat) if (g["_system"]["key"], g["Name"]) not in hidden] if cat else []
        now = self.flt % len(self.lib.filters)
        items = [i for i, f in enumerate(self.lib.filters) if i == now or self.fd.has_games(games, f)]
        ctrls = [None] + self.fd.controls_present(games)
        if self.ctrl and self.ctrl not in ctrls:
            ctrls.append(self.ctrl)
        self.overlay, self.ov = "filter", {"items": items, "sel": 1 + items.index(now), "top": 0,
                                           "ctrls": ctrls, "ctrl": ctrls.index(self.ctrl)}

    def set_filter(self, index):
        self.flt = index
        cat = self.category()
        if cat:
            self.filter_by[cat["key"]] = self.lib.filters[index % len(self.lib.filters)]["name"]

    def default_filter(self):
        names = [f["name"].lower() for f in self.lib.filters]
        return names.index("all games") if "all games" in names else 0

    # ── A lista da tela ──
    def category(self):
        return self.cats[self.cat % len(self.cats)] if self.cats else None

    def filtered(self):
        cat = self.category()
        if not cat:
            return []
        hidden = self.lib.hidden()
        games = [g for g in self.lib.games(cat) if (g["_system"]["key"], g["Name"]) not in hidden]
        games = self.fd.apply_control(games, self.ctrl)
        return self.fd.apply_filter(games, self.lib.filters[self.flt % len(self.lib.filters)])

    def rebuild(self, keep=None):
        """As linhas da tela: (jogo, nivel, clones). Na lista os clones ficam
        debaixo do pai (abertos ou nao); na tela cheia e na grade, sempre logo
        depois dele (com o selo CLONE)."""
        games = self.filtered()
        # A linha onde o cursor esta agora: se for um jogo dentro de um grupo,
        # o cursor volta a ele la (e nao a linha dele na lista).
        old = self.rows[self.cursor][2] if self.rows and self.cursor < len(self.rows) else None
        rows = []
        for game, clones in self.fd.tree(games):
            if not self.show_clones:
                # Sem clones: so os jogos pai (e o clone sem o pai na lista).
                rows.append((game, 0, []))
                continue
            if self.mode == "list":
                rows.append((game, 0, clones))
                if clones and game["Name"] in self.opened:
                    rows.append((game, 1, "main"))
                    rows.extend((c, 1, game) for c in clones)
            else:
                rows.append((game, 0, clones))
                rows.extend((c, 1, game) for c in clones or ())
        # Na lista, no alto, os grupos RECENT (os ultimos jogados) e FAVOURITES:
        # um cabecalho que abre e fecha, e os jogos dele quando aberto.
        if self.mode == "list":
            head = []
            for key, _ in self.fd.GROUPS:
                items = (self.lib.recent(games) if key == "recent"
                         else [g for g in games if g.get("Favourite") == "1"])
                if items:
                    head.append((None, 0, ("group", key, len(items))))
                    if key in self.groups_open:
                        head.extend((g, 0, ("in", key)) for g in items)
            rows = head + rows
        # Na lista, no alto, os jogos que outros gabinetes jogam agora (o link):
        # uma linha por jogo, a que abre o menu com o JOIN. Com mais de uma
        # party no mesmo jogo, a linha tem o [+]: aberto, uma linha por party
        # (o nome do gabinete que a abriu).
        link = getattr(self, "link", None)
        if self.mode == "list" and link and link.available():
            here = {(g["_system"]["key"], g["Name"]): g for g in games}
            by_game = {}
            for p in link.parties():
                g = here.get((p["system"], p["game"]))
                if g is not None:
                    by_game.setdefault((p["system"], p["game"]), (g, []))[1].append(p)
            # O [+] aberto de um jogo que voltou a ter uma party so fecha.
            self.parties_open &= {k for k, (_, parties) in by_game.items() if len(parties) > 1}
            top = []
            for key, (g, parties) in by_game.items():
                top.append((g, 0, "elsewhere"))
                if len(parties) > 1 and key in self.parties_open:
                    top.extend((g, 0, ("party", p["party"])) for p in self.party_order(parties))
            rows = top + rows
        self.rows = rows
        if keep:
            # O mesmo jogo, onde ele estiver agora (trocar de modo muda a
            # posicao dos clones): a linha dele mesmo, nao a "MAIN SET" nem a
            # que repete o jogo no alto.
            found = [i for i, (g, _, extra) in enumerate(rows)
                     if g is not None and g["Name"] == keep and extra != "main" and not self.fd.elsewhere(extra)
                     and (not self.fd.group_item(extra) or extra == old)]
            if found:
                self.cursor = min(found, key=lambda i: (rows[i][2] != old, abs(i - self.cursor) if rows[i][1] else -1))
            else:
                # Um clone com o pai fechado na lista: o pai abre e ele aparece.
                g = next((g for g in games if g["Name"] == keep), None)
                parent = g.get("CloneOf") if g else None
                if parent and self.mode == "list" and self.show_clones and parent not in self.opened:
                    self.opened.add(parent)
                    return self.rebuild(keep)
        self.cursor = max(0, min(self.cursor, len(rows) - 1))

    def game(self):
        return self.rows[self.cursor][0] if self.rows else None

    def remember(self):
        g = self.game()
        self.keep_position()
        save_config({"mode": self.mode, "category": (self.category() or {}).get("key"),
                     "filters": self.filter_by, "control_filters": self.ctrl_by,
                     "game": g["Name"] if g else None, "positions": self.positions,
                     "clones": self.show_clones, "exit_key": self.exit_key, "exit_combo": self.exit_combo,
                     "power_exit": self.power_exit, "commercial": self.commercial,
                     "coin_minutes": self.coin_minutes, "credit_until": self.credit_until,
                     "controls": self.input.binds, "panel_layout": self.panel_layout,
                     "controls_seen": self.controls_seen, "transitions": self.transitions})

    def keep_position(self):
        """O jogo onde o cursor esta, anotado para a game list de agora: ao
        voltar a ela (ou abrir o frontend de novo), o cursor volta nele."""
        g, cat = self.game(), self.category()
        if g and cat:
            self.positions[cat["key"]] = g["Name"]

    # ── Andar ──
    def move(self, step, wrap=True):
        """Anda step jogos; do ultimo para a frente volta ao primeiro, e do
        primeiro para tras vai ao ultimo (o salto que passa do fim para no
        fim, e o proximo da a volta). Segurando (wrap False) para no fim: um
        toque novo da a volta."""
        if not self.rows:
            return
        last = len(self.rows) - 1
        if wrap and step > 0 and self.cursor == last:
            self.cursor = 0
        elif wrap and step < 0 and self.cursor == 0:
            self.cursor = last
        else:
            self.cursor = max(0, min(last, self.cursor + step))

    def marquee_logo(self, name, before, step):
        """O logotipo do sistema novo no marquee (Pixelcade e ZeDMD): entra
        deslizando para o lado em que a lista andou, como a tela, e pisca duas
        vezes. Em segundo plano; sem marquee, o fliperos-pixelcade nao faz nada."""
        if self.shot or not name:
            return
        self.announced = name
        try:
            subprocess.Popen([PIXELCADE_TOOL, "bg", "logo", name, before, "-1" if step < 0 else "1"],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError:
            pass

    def marquee_idle(self, now, active):
        """O protetor de tela do marquee: active = apertaram algum botao (ou ha um
        segurado). Passados IDLE_SECONDS sem isso, o marquee toca a animacao do
        logo; o primeiro toque traz o logotipo do sistema de agora (o "logo", que
        tambem tira o protetor de tela, sem depender do que estava gravado antes
        dele). Sem sistema, o "stop". Em segundo plano: um Pixelcade que nao
        responde nao trava o menu. Sem marquee, nao faz nada."""
        if active:
            self.last_input = now
        idle = bool(IDLE_SECONDS) and now - self.last_input >= IDLE_SECONDS
        if idle == self.idle or self.shot:
            return
        self.idle = idle
        name = "" if idle else (self.category() or {}).get("name", "")
        if name:
            self.marquee_logo(name, "", 1)
            return
        try:
            subprocess.Popen([PIXELCADE_TOOL, "bg", "screensaver", "start" if idle else "stop"],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError:
            pass

    def attract_tick(self, now):
        """O modo atracao: passados ATTRACT_SECONDS sem botao, o cursor salta
        para um jogo sorteado da lista de agora (so os pais, nao os clones
        abertos) e de novo a cada ATTRACT_STEP segundos. O guia dos controles
        aberto nao segura (ele fecha); os outros menus seguram, alguem esta
        no meio de algo."""
        if (not ATTRACT_SECONDS or now - self.last_input < ATTRACT_SECONDS
                or self.overlay not in (None, "guide") or self.letter_mode):
            self.attract_next = None
            return
        if self.attract_next is not None and now < self.attract_next:
            return
        self.attract_next = now + ATTRACT_STEP
        picks = [i for i, (g, level, extra) in enumerate(self.rows)
                 if not level and g is not None and not self.fd.group_item(extra) and i != self.cursor]
        if picks:
            self.overlay = None
            self.cursor = random.choice(picks)

    def switch_category(self, step):
        """Um sistema para o lado na tira: so os azulejos andam. A lista troca
        em pick_category (PICK_WAIT segundos parado, ou o botao 1)."""
        if len(self.cats) < 2:
            return
        # A tira das romlists anda de onde estava (cat_pos nao da a volta).
        now = time.monotonic()
        old = getattr(self, "cat_pos", self.cat)
        self.anim.setdefault("ribbon", (old, 0.0, now))     # (posicao, velocidade, quando): feview.spring
        self.cat_pos = old + step
        self.pick += step
        self.pick_at = now
        self.picking = True
        self.ribbon_until = float("inf")

    def cancel_pick(self):
        """O botao 2 com a tira andando: ela volta ao sistema da lista."""
        self.cat_pos = getattr(self, "cat_pos", self.cat) - self.pick
        self.pick = 0
        self.picking = False
        self.ribbon_until = time.monotonic() + 0.4

    def pick_category(self):
        """O sistema da tira escolhido: a lista troca, com a animacao."""
        step, self.pick = self.pick, 0
        self.picking = False
        self.ribbon_until = time.monotonic() + 0.25       # some aos poucos (feview.RIBBON_FADE)
        if not step % len(self.cats):
            return                # deu a volta e parou no mesmo
        self.keep_position()
        before = (self.category() or {}).get("name", "")
        self.cat = (self.cat + step) % len(self.cats)
        self.marquee_logo((self.category() or {}).get("name", ""), before, step)
        self.load_filter()
        # A tela de antes sai e a nova entra, pedaco por pedaco (feview.draw:
        # o slide da tela inteira, ou a animacao do modo, feview.TRANSITIONS).
        if getattr(self, "last_ui", None) is not None:
            self.slide = (self.last_ui, 1 if step > 0 else -1, time.monotonic())
            self.intro = {"side": 1 if step > 0 else -1, "start": time.monotonic(),
                          "old": getattr(self, "last_screen", None)}
        self.cursor = 0
        self.opened.clear()
        # O jogo onde o cursor parou nesta game list da ultima vez.
        self.rebuild(keep=self.positions.get((self.category() or {}).get("key")))
        self.remember()

    def letter_jump(self, step, wrap=True):
        """O cursor no primeiro jogo da letra seguinte (ou anterior)."""
        if not self.rows:
            return
        letters = []
        for i, (g, level, extra) in enumerate(self.rows):
            if level or g is None or self.fd.group_item(extra):
                continue
            c = self.fd.first_letter(g)
            if not letters or letters[-1][0] != c:
                letters.append((c, i))
        if not letters:
            return
        here = self.rows[self.cursor][0]
        here = self.fd.first_letter(here) if here is not None else None
        idx = next((k for k, (c, _) in enumerate(letters) if c == here), 0)
        # Do Z volta ao comeco (segurando, para nele).
        idx = (idx + step) % len(letters) if wrap else max(0, min(len(letters) - 1, idx + step))
        self.cursor = letters[idx][1]
        # A letra fica no meio da tela enquanto o modo letra dura.
        self.letter = (letters[idx][0], float("inf"))
        if self.letter_mode:
            self.letter_mode["last"] = time.monotonic()

    def letter_off(self):
        """Fim do modo letra: a lista normal, no jogo da letra."""
        self.letter_mode = None
        self.letter = None

    def page(self):
        return {"list": 13, "full": 1, "flow": COLS * (3 if self.vertical else 2)}[self.mode]

    # ── As acoes ──
    def act(self, a):
        if a == "quit":
            return "quit"
        if a == "coin" and self.commercial and self.overlay != "exitpad":
            # A ficha vale em qualquer tela, ate com um menu aberto.
            self.insert_coin()
            return None
        if self.overlay:
            return self.overlay_act(a)
        if self.picking:
            # A tira andando: esquerda e direita seguem nela (tambem na grade),
            # o botao 1 escolhe o sistema e o 2 volta ao de antes; outro botao
            # escolhe e faz o que ele faz.
            if a in ("left", "right"):
                self.switch_category(1 if a == "right" else -1)
                return None
            if a == "b2":
                self.cancel_pick()
                return None
            self.pick_category()
            if a == "b1":
                return None
        if self.letter_mode and a in ("up", "down"):
            # No modo letra, cada toque passa uma letra; segurando, repete
            # (tick). Dois segundos sem mexer, volta a lista normal.
            now = time.monotonic()
            self.letter_mode["press"] = now
            self.letter_jump(1 if a == "down" else -1)
            self.repeat[a] = now + FIRST
            return None
        if self.letter_mode:
            # Outro botao: sai do modo letra e faz o que ele faz.
            self.letter_off()
        if a in ("up", "down"):
            step = 1 if a == "down" else -1
            self.move(step * (COLS if self.mode == "flow" else 1))
            self.repeat[a] = time.monotonic() + FIRST
            self.acc = 0.0
        elif a in ("left", "right"):
            step = 1 if a == "right" else -1
            if self.mode == "flow":
                col = self.cursor % COLS
                edge = (step < 0 and col == 0) or (step > 0 and (col == COLS - 1 or self.cursor == len(self.rows) - 1))
                if edge:
                    self.switch_category(step)
                else:
                    self.move(step)
            else:
                self.switch_category(step)
        elif a == "b3":
            self.move(-self.page())
        elif a == "b6":
            self.move(self.page())
        elif a == "b1":
            g, level, clones = self.rows[self.cursor] if self.rows else (None, 0, None)
            if g is None:
                if self.fd.group_head(clones):
                    # Um cabecalho (RECENT, FAVOURITES): abre ou fecha o grupo.
                    key = clones[1]
                    self.groups_open ^= {key}
                    self.rebuild()
                    if key in self.groups_open:
                        self.cursor += 1
                return None
            if self.mode == "list" and level == 0 and isinstance(clones, list) and clones:
                if g["Name"] in self.opened:
                    self.opened.discard(g["Name"])
                else:
                    self.opened.add(g["Name"])
                self.rebuild()
                if g["Name"] in self.opened:
                    self.cursor += 1
            elif clones == "elsewhere" and len(self.link_parties(g)) > 1:
                # Outros gabinetes em parties separadas no mesmo jogo: o [+]
                # abre (ou fecha) uma linha por party, com o nome do gabinete.
                key = (g["_system"]["key"], g["Name"])
                self.parties_open ^= {key}
                self.rebuild()
                if key in self.parties_open:
                    self.cursor += 1
            elif self.locked():
                # O modo comercial sem tempo: escolher um jogo, so com ficha.
                self.nag()
            else:
                # Na linha de uma party, o menu ja no azulejo dela (JOIN ou o estado).
                pid = clones[1] if self.fd.elsewhere(clones) and clones != "elsewhere" else None
                tiles = self.popup_tiles() if pid else []
                sel = next((k for k, t in enumerate(tiles) if (t.get("party") or {}).get("party") == pid), 0)
                self.overlay, self.ov = "popup", {"sel": sel}
        elif a == "b2":
            # Num clone aberto, fecha o grupo (na tela cheia e na grade, volta ao pai);
            # senao, pergunta se sai. No modo comercial (quiosque) o cliente
            # nao fecha o frontend: so o Tab > Frontend options o desliga.
            g, level, parent = self.rows[self.cursor] if self.rows else (None, 0, None)
            if self.fd.group_item(parent):
                # Num jogo de RECENT ou FAVOURITES: fecha o grupo e volta ao cabecalho.
                self.groups_open.discard(parent[1])
                self.rebuild()
                self.cursor = next((i for i, (g0, _, e) in enumerate(self.rows)
                                    if g0 is None and e[1] == parent[1]), 0)
                self.closed_group = time.monotonic()
            elif level:
                owner = g if parent == "main" else parent
                self.opened.discard(owner["Name"])
                self.rebuild(keep=owner["Name"])
                self.closed_group = time.monotonic()
            elif self.fd.elsewhere(parent) and parent != "elsewhere":
                # Na linha de uma party: fecha as parties e volta a linha do jogo.
                self.parties_open.discard((g["_system"]["key"], g["Name"]))
                self.rebuild()
                self.cursor = next((i for i, (g0, _, e) in enumerate(self.rows)
                                    if e == "elsewhere" and g0 is g), 0)
                self.closed_group = time.monotonic()
            elif not self.commercial:
                self.overlay, self.ov = "exit", {"sel": 1}
        elif a == "esc" and self.commercial and time.monotonic() - getattr(self, "closed_group", 0) > 0.3:
            # O Esc do teclado (o operador) fecha o frontend mesmo no modo
            # comercial; o botao 2 do controle (o cliente), nao.
            self.overlay, self.ov = "exit", {"sel": 1}
        elif a == "b4":
            self.toggle_fav()
        elif a == "b5":
            self.open_filters()
        elif a == "start":
            self.set_mode(1)
            self.say(MODE_NAMES[self.mode])
        elif a == "tab":
            # Sem jogo na lista, so as opcoes do frontend.
            self.overlay, self.ov = "options", {"sel": 0 if self.game() else OPT_MODE}
        return None

    def set_mode(self, step):
        """O modo seguinte (ou o anterior), ja gravado."""
        g = self.game()
        self.mode = MODES[(MODES.index(self.mode) + step) % len(MODES)]
        self.rebuild(keep=g["Name"] if g else None)
        self.remember()

    def toggle_fav(self):
        g = self.game()
        if g:
            on = self.lib.set_favourite(g, g.get("Favourite") != "1")
            self.say("ADDED TO FAVOURITES" if on else "REMOVED FROM FAVOURITES")
            if self.mode == "list":
                self.rebuild(keep=g["Name"])      # o grupo FAVOURITES acompanha

    def say(self, text, seconds=1.6):
        self.toast = (text, time.monotonic() + seconds)

    # ── O modo comercial ──
    def left(self):
        """Os segundos de jogo que a ficha ainda paga."""
        return max(0.0, self.credit_until - time.time())

    def locked(self):
        """Modo comercial sem tempo: nao se escolhe jogo."""
        return self.commercial and self.left() <= 0

    def insert_coin(self):
        """Cada ficha soma os minutos dela ao tempo que ainda resta."""
        self.credit_until = max(time.time(), self.credit_until) + self.coin_minutes * 60
        self.coin_at = time.monotonic()
        self.say("+%d MIN" % self.coin_minutes)
        self.remember()

    def nag(self):
        """Um jogo pedido sem tempo: o indicador pisca mais forte."""
        self.nag_at = time.monotonic()
        self.say("INSERT COIN")

    def option_count(self):
        return OPT_COIN + 1 if self.commercial else OPT_COIN

    def overlay_act(self, a):
        o = self.overlay
        if o == "guide":
            if a not in ("up", "down", "left", "right"):
                self.overlay = None
            return None
        if o == "controls":
            return self.controls_act(a)
        if o in ("lobby", "transfer"):
            return self.link_act(a)
        if o == "unpack":
            if a == "b2":
                self.ov["cancel"].set()
            return None
        if a == "b2" and o not in ("rename", "exitkey", "exitpad"):
            self.overlay = {"more": "popup", "classify": "options"}.get(o)
            if self.overlay == "popup":
                self.ov = {"sel": len(self.popup_tiles()) - 1}
            elif self.overlay == "options":
                self.ov = {"sel": 0}
            return None
        if o == "exit":
            if a in ("left", "right", "up", "down"):
                self.ov["sel"] ^= 1
            elif a == "b1":
                if self.ov["sel"] == 0:
                    return "quit"
                self.overlay = None
            return None
        if o == "popup":
            tiles = self.popup_tiles()
            tile = tiles[self.ov["sel"] % len(tiles)]
            # Num azulejo de net play com mais de um controle aqui, para baixo vai
            # aos jogadores (row 1): esquerda/direita escolhem quantos este
            # gabinete fornece; para cima volta aos azulejos.
            more = tile.get("net") and (tile.get("most") or 1) > 1
            if self.ov.get("row") and not more:
                self.ov["row"] = 0
            if a == "down" and more:
                self.ov["row"] = 1
            elif a == "up":
                self.ov["row"] = 0
            elif a in ("left", "right") and self.ov.get("row"):
                self.ov["take"] = max(1, min(tile["most"], tile["take"] + (1 if a == "right" else -1)))
            elif a in ("left", "right"):
                self.ov["sel"] = (self.ov["sel"] + (1 if a == "right" else -1)) % len(tiles)
            elif a == "b4":
                self.toggle_fav()
            elif a == "b1":
                kind = tile["kind"]
                if kind == "play":
                    self.overlay = None
                    return "launch"
                if kind == "fav":
                    self.toggle_fav()
                    self.overlay = None
                elif kind == "more":
                    self.open_more()
                elif kind in ("link", "new"):
                    self.link_host(tile.get("take"))
                elif kind == "join":
                    self.link_join(tile["party"], tile.get("take"))
                else:
                    self.say(tile["label"])
            return None
        if o == "more":
            if a in ("up", "down"):
                self.ov["scroll"] = max(0, self.ov.get("scroll", 0) + (1 if a == "down" else -1))
            elif a in ("left", "right"):
                # A pagina 2 (fotos e mais dados) fica a direita.
                page = 1 if a == "right" else 0
                if page != self.ov.get("page", 0):
                    self.ov["page"], self.ov["scroll"] = page, 0
            elif a == "b1":
                self.overlay = None
                return "launch"
            elif a == "b4":
                self.toggle_fav()
            return None
        if o == "filter":
            # Linha 0: CONTROL (esquerda/direita trocam o tipo); depois os
            # filtros. O 1 aplica os dois, o 5 sai sem mudar nada.
            n = 1 + len(self.ov["items"])
            if a in ("up", "down"):
                self.ov["sel"] = (self.ov["sel"] + (1 if a == "down" else -1)) % n
            elif a in ("b3", "b6"):
                self.ov["sel"] = max(0, min(n - 1, self.ov["sel"] + (-10 if a == "b3" else 10)))
            elif a in ("left", "right"):
                self.ov["sel"] = 0
                self.ov["ctrl"] = (self.ov["ctrl"] + (1 if a == "right" else -1)) % len(self.ov["ctrls"])
            elif a in ("b1", "b5"):
                if a == "b1":
                    g = self.game()
                    if self.ov["sel"]:
                        self.set_filter(self.ov["items"][self.ov["sel"] - 1])
                    self.set_control(self.ov["ctrls"][self.ov["ctrl"]])
                    self.cursor = 0
                    self.rebuild(keep=g["Name"] if g else None)
                    self.remember()
                self.overlay = None
            return None
        if o == "options":
            # 0 a 4: as opcoes do jogo (3: esconder, 4: apagar); depois as do
            # frontend: o modo, a animacao da troca de romlist dele, os
            # clones, a lista dos escondidos, os
            # controles (as funcoes e o atalho que fecha o jogo), o botao de
            # desligar no jogo, o modo comercial e os minutos de cada ficha.
            sel = self.ov["sel"]
            if a in ("up", "down"):
                self.ov["sel"] = (sel + (1 if a == "down" else -1)) % self.option_count()
            elif sel == OPT_POWER and a in ("left", "right", "b1"):
                self.power_exit = not self.power_exit
                self.remember()
                self.say("POWER BUTTON CLOSES THE GAME" if self.power_exit else "POWER BUTTON OFF IN GAMES", 2.2)
            elif sel == OPT_COMMERCIAL and a in ("left", "right", "b1"):
                self.commercial = not self.commercial
                self.say("COMMERCIAL MODE ON" if self.commercial else "COMMERCIAL MODE OFF")
                if not self.commercial:
                    # Desligado, o tempo que restava some: ligado de novo,
                    # comeca sem ficha.
                    self.credit_until = 0.0
                if self.commercial and "coin" in self.exit_combo:
                    # A ficha passa a somar tempo: o atalho com ela sai.
                    self.exit_combo = []
                    self.say("EXIT BUTTONS OFF: COIN NOW ADDS TIME", 2.6)
                self.remember()
            elif sel == OPT_COIN and a in ("left", "right"):
                i = COIN_MINUTES.index(self.coin_minutes) + (1 if a == "right" else -1)
                self.coin_minutes = COIN_MINUTES[max(0, min(len(COIN_MINUTES) - 1, i))]
                self.remember()
            elif sel == OPT_MODE and a in ("left", "right", "b1"):
                self.set_mode(-1 if a == "left" else 1)
            elif sel == OPT_TRANSITION and a in ("left", "right", "b1"):
                # A proxima (ou a anterior) das cinco do modo de agora.
                names = self.view.TRANSITION_CHOICES[self.mode]
                i = names.index(self.view.transition(self)) + (-1 if a == "left" else 1)
                self.transitions[self.mode] = names[i % len(names)]
                self.remember()
            elif sel == OPT_CLONES and a in ("left", "right", "b1"):
                g = self.game()
                self.show_clones = not self.show_clones
                self.rebuild(keep=(g.get("CloneOf") or g["Name"]) if g else None)
                self.remember()
                self.say("CLONES SHOWN" if self.show_clones else "CLONES HIDDEN")
            elif sel == OPT_HIDDEN and a == "b1":
                self.overlay, self.ov = "hidden", {"sel": 0, "rows": self.lib.hidden_games()}
            elif sel == OPT_CONTROLS and a == "b1":
                self.overlay, self.ov = "controls", {"sel": 0, "col": 0, "wait": None}
            elif a == "b1" and sel == 3 and self.game():
                g = self.game()
                self.lib.set_hidden(g["_system"]["key"], g["Name"], True)
                self.overlay = None
                self.rebuild(keep=None)
                self.say("HIDDEN: TAB > HIDDEN GAMES BRINGS IT BACK", 2.5)
            elif a in ("b1",) and self.game() and sel < OPT_MODE:
                g = self.game()
                if sel == 0:
                    self.open_classify(g)
                elif sel == 1:
                    self.overlay = "rename"
                    self.ov = {"value": g.get("Title") or g["Name"], "key": (1, 0)}
                    self.input.text = True
                elif sel == 2:
                    self.overlay = None
                    self.scrape(g)
                elif self.lib.rom_files(g):
                    # Apagar pergunta antes, com o NO escolhido.
                    self.overlay, self.ov = "delete", {"sel": 1, "game": g, "files": self.lib.rom_files(g)}
                else:
                    self.overlay = None
                    self.say("NO FILE OF ITS OWN (IT IS IN THE PARENT'S)", 2.5)
            elif a == "tab":
                self.overlay = None
            return None
        if o == "exitkey":
            # A tecla que fecha o jogo: a proxima apertada no teclado. Uma do
            # painel (o encoder que se diz teclado) nao serve: cada botao faz
            # uma coisa so. O botao 2 de um controle desiste.
            if a.startswith("key:"):
                key = self.keytable.get(int(a[4:]))
                if key is None:
                    self.say("THIS KEY CANNOT BE USED", 2)
                elif key[0] in panel_keys(self.input.rows):
                    self.say("%s IS A PANEL CONTROL" % key[0], 2.4)
                else:
                    self.exit_key = list(key)
                    self.remember()
                    self.say("EXIT KEY: " + key[0], 2)
                self.capture_done(1)
            elif a == "b2":
                self.capture_done(1)
            return None
        if o == "exitpad":
            # Os botoes segurados juntos (capture_tick): os toques nao fazem nada.
            return None
        if o == "hidden":
            # Os escondidos: o botao 1 traz o jogo de volta; o 2 volta ao Tab.
            rows = self.ov["rows"]
            if a in ("up", "down") and rows:
                self.ov["sel"] = (self.ov["sel"] + (1 if a == "down" else -1)) % len(rows)
            elif a == "b1" and rows:
                key, name, _, title = rows.pop(self.ov["sel"])
                self.lib.set_hidden(key, name, False)
                self.ov["sel"] = min(self.ov["sel"], max(0, len(rows) - 1))
                g = self.game()
                self.rebuild(keep=g["Name"] if g else None)
                self.say("BACK IN THE LIST: " + title.upper(), 2)
            elif a in ("b2", "tab"):
                self.overlay, self.ov = "options", {"sel": OPT_HIDDEN}
            return None
        if o == "delete":
            if a in ("left", "right", "up", "down"):
                self.ov["sel"] ^= 1
            elif a == "b1":
                g = self.ov["game"]
                if self.ov["sel"] == 0:
                    self.player.stop()
                    n = self.lib.delete(g)
                    self.media.clear()
                    self.ready.clear()
                    self.rebuild(keep=None)
                    self.say("GAME DELETED" if n else "COULD NOT DELETE IT")
                self.overlay = None
            return None
        if o == "classify":
            fields = self.ov["fields"]
            sel = self.ov["sel"]
            if a in ("up", "down"):
                self.ov["sel"] = (sel + (1 if a == "down" else -1)) % (len(fields) + 1)
            elif a in ("left", "right") and sel < len(fields):
                field, values, i = fields[sel]
                if values:
                    i = (i + (1 if a == "right" else -1)) % len(values)
                    fields[sel] = (field, values, i)
            elif a == "b1":
                changes = {f: v[i] for f, v, i in fields if v and v[i] != (self.ov["game"].get(f) or "")}
                if changes and self.lib.save_edits(self.ov["game"], changes):
                    self.say("SAVED")
                    self.lib.forget()
                    self.rebuild(keep=self.ov["game"]["Name"])
                self.overlay = None
            return None
        if o == "rename":
            return self.rename_act(a)
        return None

    def controls_act(self, a):
        """Tab > Frontend options > Frontend controls: as funcoes, cada uma com o
        comando do painel (coluna 0) e a tecla (coluna 1); o atalho que fecha o
        jogo (EXIT GAME: os botoes do painel segurados juntos e a tecla); o
        formato do painel (o desenho do guia) e o RESET no fim. O botao 1 pede o
        novo: o proximo comando apertado no painel ou a proxima tecla. Quem o
        tinha fica com o de antes da funcao; o mesmo de novo, ou o Delete, a
        deixa sem nada. Cada troca ja vale e fica gravada."""
        ov = self.ov
        funcs = self.fi.FUNCTIONS
        exit_row, layout_row, reset_row = len(funcs), len(funcs) + 1, len(funcs) + 2
        if ov["wait"] == "pad":
            if a.startswith("pad:"):
                self.bind_control(funcs[ov["sel"]], "pad", a[4:])
                self.controls_wait(None)
            elif a == "delete":
                self.bind_control(funcs[ov["sel"]], "pad", None)
                self.controls_wait(None)
            elif a == "esc":
                self.controls_wait(None)
            return None
        if ov["wait"] == "key":
            if a.startswith("key:"):
                key = int(a[4:])
                if key == self.pg.K_DELETE:
                    self.bind_control(funcs[ov["sel"]], "key", None)
                elif key in self.input.panel_keys:
                    self.say("%s IS A PANEL CONTROL" % self.fi.key_name(self.pg, key), 2.4)
                else:
                    self.bind_control(funcs[ov["sel"]], "key", key)
                self.controls_wait(None)
            elif a == "b2":
                # Um controle desiste (o teclado esta escolhendo).
                self.controls_wait(None)
            return None
        sel = ov["sel"]
        if a in ("up", "down"):
            ov["sel"] = (sel + (1 if a == "down" else -1)) % (reset_row + 1)
            if ov["sel"] == reset_row:
                # A ultima linha: RESET e SAVE lado a lado, comecando no SAVE.
                ov["col"] = 1
        elif sel == layout_row and a in ("left", "right", "b1"):
            names = [k for k, _ in self.view.PANEL_LAYOUTS]
            i = names.index(self.panel_layout) + (-1 if a == "left" else 1)
            self.panel_layout = names[i % len(names)]
            self.remember()
        elif a in ("left", "right"):
            ov["col"] ^= 1
        elif a == "b1" and sel == reset_row and ov["col"] == 1:
            self.remember()
            self.say("CONTROLS SAVED")
            self.controls_leave()
        elif a == "b1" and sel == reset_row:
            self.input.bind(self.fi.default_binds(self.pg))
            self.remember()
            self.say("CONTROLS RESET")
        elif a == "b1" and sel == exit_row and ov["col"] == 0:
            self.overlay, self.ov = "exitpad", {"since": time.monotonic(), "held": None}
        elif a == "b1" and sel == exit_row:
            self.overlay, self.ov = "exitkey", {"since": time.monotonic()}
            self.input.capture = True
        elif a == "b1":
            self.controls_wait("pad" if ov["col"] == 0 else "key")
        elif a == "delete" and sel == exit_row:
            # O atalho sai (OFF).
            if ov["col"] == 0:
                self.exit_combo = []
            else:
                self.exit_key = None
            self.remember()
            self.say("EXIT BUTTONS OFF" if ov["col"] == 0 else "EXIT KEY OFF", 2)
        elif a == "delete" and sel < len(funcs):
            self.bind_control(funcs[sel], "pad" if ov["col"] == 0 else "key", None)
        elif a in ("b2", "esc"):
            self.controls_leave()
        return None

    def controls_leave(self):
        """Sai do Frontend controls (o SAVE ou o back): de volta ao Tab; na
        primeira vez (ao abrir o frontend), para o guia ja com o que ficou, e
        nas proximas aberturas so o guia."""
        if self.controls_seen:
            self.overlay, self.ov = "options", {"sel": OPT_CONTROLS}
        else:
            self.controls_seen = True
            self.overlay, self.ov = "guide", {}
            self.remember()
        # Sem escolher ou voltar pelo painel, o menu so abre pelo teclado.
        lost = [self.view.FUNCTION_NAMES[f] for f in ("b1", "b2") if not self.input.binds[f]["pad"]]
        if lost:
            self.say("/".join(lost) + ": NO PANEL BUTTON", 2.6)

    def controls_wait(self, kind):
        """Esperando o comando do painel ("pad") ou a tecla ("key") da funcao
        escolhida; None, de volta a lista."""
        self.ov["wait"], self.ov["since"] = kind, time.monotonic()
        self.input.capture_pad = kind == "pad"
        self.input.capture = kind == "key"

    def bind_control(self, function, kind, value):
        """A funcao com o comando do painel ou a tecla value (None: nenhum), ja
        valendo e gravado; o aviso diz o que mudou."""
        binds = self.input.binds
        value, other = self.fi.assign(binds, function, kind, value)
        self.input.bind(binds)
        self.remember()
        names = self.view.FUNCTION_NAMES
        if value is None:
            self.say("%s: NO %s" % (names[function], "BUTTON" if kind == "pad" else "KEY"), 2)
        elif other:
            self.say("SWAPPED WITH " + names[other], 2.2)
        else:
            shown = self.fi.pad_name(value) if kind == "pad" else self.fi.key_name(self.pg, value)
            self.say("%s: %s" % (names[function], shown), 2)

    def capture_done(self, col):
        """Fim da escolha do atalho: de volta ao Frontend controls, na linha
        EXIT GAME e na coluna dele (0 os botoes, 1 a tecla)."""
        self.input.capture = False
        self.overlay = "controls"
        self.ov = {"sel": len(self.fi.FUNCTIONS), "col": col, "wait": None}

    def capture_tick(self, now):
        """A escolha dos botoes do atalho: dois ou mais comandos do painel
        segurados juntos por EXIT_HOLD segundos; CAPTURE_WAIT sem nada, sai
        como estava."""
        o = self.overlay
        if o == "controls" and self.ov.get("wait") and now - self.ov["since"] > CAPTURE_WAIT:
            self.say("NOTHING CHANGED")
            self.controls_wait(None)
        if o not in ("exitkey", "exitpad"):
            return
        held = frozenset(self.input.pad_held())
        if o == "exitpad" and self.commercial and "coin" in held:
            # No modo comercial a ficha soma tempo: ela nao fecha o jogo.
            self.say("IN COMMERCIAL MODE COIN ADDS TIME", 2.4)
            self.capture_done(0)
            return
        if o == "exitpad" and len(held) >= 2:
            if held != self.ov["held"]:
                self.ov["held"], self.ov["at"] = held, now
            elif now - self.ov["at"] >= EXIT_HOLD:
                self.exit_combo = [a for a in COMBO_CONTROLS if a in held]
                self.remember()
                self.say("EXIT BUTTONS: " + "+".join(combo_names(self.exit_combo)), 2.4)
                self.capture_done(0)
            return
        if o == "exitpad":
            self.ov["held"] = None
            if held:
                self.ov["since"] = now
        if now - self.ov["since"] > CAPTURE_WAIT:
            self.say("NOTHING CHANGED")
            self.capture_done(1 if o == "exitkey" else 0)

    KEYS = ["1234567890", "QWERTYUIOP", "ASDFGHJKL-", "ZXCVBNM.:/"]

    def rename_act(self, a):
        r, c = self.ov["key"]
        if a.startswith("char:"):
            self.ov["value"] += a[5:]
        elif a == "backspace":
            self.ov["value"] = self.ov["value"][:-1]
        elif a in ("up", "down"):
            r = (r + (1 if a == "down" else -1)) % 5
        elif a in ("left", "right"):
            c = (c + (1 if a == "right" else -1)) % (10 if r < 4 else 3)
        elif a == "b1":
            if r < 4:
                self.ov["value"] += self.KEYS[r][c]
            elif c == 0:
                self.ov["value"] += " "
            elif c == 1:
                self.ov["value"] = self.ov["value"][:-1]
            else:
                g = self.game()
                title = self.ov["value"].strip()
                if title and self.lib.save_edits(g, {"Title": title}):
                    self.lib.forget()
                    self.rebuild(keep=g["Name"])
                    self.say("RENAMED")
                self.overlay = None
                self.input.text = False
        elif a == "b2":
            self.overlay = None
            self.input.text = False
        if r == 4:
            c = min(c, 2)
        self.ov["key"] = (r, c)
        return None

    def open_more(self):
        g = self.game()
        self.overlay = "more"
        self.ov = {"game": g, "info": None, "loading": False, "scroll": 0}
        system = g["_system"]
        if not system["arcade"]:
            return
        self.ov["loading"] = True
        ov = self.ov

        def work():
            try:
                info, _ = self.lib.info.arcade(system["key"], g["Name"], "en")
            except (OSError, ValueError):
                info = None
            ov["info"], ov["loading"] = info, False

        threading.Thread(target=work, daemon=True).start()

    def open_classify(self, g):
        cat = self.category()
        fields = []
        for field in ("Category", "Players", "Buttons", "Control", "Year", "Manufacturer", "Rotation", "Series"):
            values = self.lib.values(cat, field)
            cur = g.get(field) or ""
            if cur and cur not in values:
                values.insert(0, cur)
            fields.append((field, values, values.index(cur) if cur in values else 0))
        self.overlay = "classify"
        self.ov = {"game": g, "fields": fields, "sel": 0}

    def auto_scrape(self, now):
        """O jogo sob o cursor ha AUTO_SCRAPE segundos, em qualquer modo, sem
        alguma das artes (a tela, a capa, o marquee, o video): busca uma vez
        so o que falta (o que vier fica nas pastas de ~/media)."""
        g = self.game()
        if g is None or self.overlay or self.letter_mode:
            self.rest = (None, now)
            return
        if self.rest[0] is not g:
            self.rest = (g, now)
            return
        # Parado ali: a posicao ja fica gravada (desligar sem sair do
        # frontend tambem volta nela).
        if now - self.rest[1] >= AUTO_SCRAPE and getattr(self, "saved_at", None) is not g:
            self.saved_at = g
            self.remember()
        key = (g["_system"]["key"], g["Name"])
        if (self.scraping or key in self.scraped or now - self.rest[1] < AUTO_SCRAPE
                or self.harvest.current is g):
            return
        self.scraped.add(key)
        # Com tudo (as informacoes, a arte e o video), nada a buscar; e o que
        # ja foi buscado assim nos ultimos dias (a fonte nao tem o que falta)
        # nao e buscado de novo a cada abertura.
        before = self.fd.missing_art(self.lib, g)
        if not before and not self.harvest.missing(g):
            return
        hkey = self.harvest.key(g)
        rested = self.harvest.state.setdefault("rested", {})
        if time.time() - rested.get(hkey, 0) < self.harvest.RETRY_DAYS * 86400:
            return
        self.scraping = g

        def work():
            try:
                self.fd.scrape(self.lib, g, only_missing=True)
            except Exception:  # sem rede, um site fora: tenta de novo na proxima abertura
                pass
            after = self.fd.missing_art(self.lib, g)
            rested[hkey] = int(time.time())
            self.harvest.save()
            self.flush = True
            self.scraping = None
            if len(after) < len(before) and self.game() is g:
                self.say("ART DOWNLOADED")

        threading.Thread(target=work, daemon=True).start()

    def scrape(self, g):
        self.say("SCRAPING...", 60)

        def work():
            n = self.fd.scrape(self.lib, g)
            self.flush = True
            self.say("%d FILES" % n if n else "NOTHING FOUND")

        threading.Thread(target=work, daemon=True).start()

    # ── Jogar ──
    # ── O link play (gui/felink.py) ──
    def link_profile(self, g):
        """O perfil de link do jogo (os que ligam gabinetes) ou o de net play
        (felink.netplay_profile: um core do RetroArch que faz net play, ou o GGPO
        do Flycast no Naomi e no Atomiswave)."""
        if not g:
            return None
        key = g["_system"]["key"]
        return self.link.profile_of(key, g["Name"]) or self.link.netplay_of(key, g["Name"], g.get("Players"))

    def link_kind(self, g):
        prof = self.link_profile(g)
        return None if not prof else ("net" if prof.get("netplay") else "link")

    def link_mark(self, g):
        """None: o jogo nao tem link nem net play, ou nao ha outro gabinete na
        rede (sem ninguem com quem jogar, o globo nao aparece na lista). False:
        tem, e ninguem joga. True: alguem joga."""
        if not self.link_profile(g) or not self.link.others():
            return None
        return bool(self.link.parties_for(g["_system"]["key"], g["Name"]))

    def link_rom(self, g):
        """O arquivo do jogo (o zip do set), que o RetroArch do net play abre."""
        files = self.lib.rom_files(g)
        return files[0] if files else None

    @staticmethod
    def party_order(parties):
        """As que ainda aceitam gente primeiro, depois pelo nome do gabinete."""
        return sorted(parties, key=lambda p: (p["state"] != "lobby", p["host"] or ""))

    def link_parties(self, g):
        """As festas de outros gabinetes nesse jogo (party_order)."""
        return self.party_order(self.link.parties_for(g["_system"]["key"], g["Name"])) if g else []

    def link_party(self, g):
        """A festa de outro gabinete nesse jogo (a que ainda aceita gente primeiro)."""
        parties = self.link_parties(g)
        return parties[0] if parties else None

    def popup_tiles(self):
        """Os azulejos do menu do jogo. Num jogo de link, depois do PLAY: JOIN
        de cada festa aberta, as que nao aceitam mais gente (apagadas, so o
        estado) e NEW LINK; sem festa nenhuma, o LINK PLAY (este gabinete e o
        primeiro)."""
        g = self.game()
        tiles = [{"kind": "play", "label": "PLAY"}]
        prof = self.link_profile(g)
        if prof:
            net = bool(prof.get("netplay"))
            # "Party", e nao "net play": e so na rede local, nada de Internet.
            word = ("PARTY", "PARTY PLAY") if net else ("LINK", "LINK PLAY")
            parties = self.link.parties_for(g["_system"]["key"], g["Name"])
            # Os jogadores que este gabinete fornece: ate um por controle (most);
            # o escolhido na linha de baixo (ov["take"]) vale para todos os azulejos.
            local = self.link.max_take(prof)
            pick = (self.ov or {}).get("take") if self.overlay == "popup" else None
            for p in parties:
                if self.felink.joinable(p):
                    most = max(1, min(local, (p["max"] or 0) - p["used"]))
                    tiles.append({"kind": "join", "label": "JOIN " + word[0], "party": p, "lit": True, "net": net,
                                  "most": most, "take": min(pick or most, most)})
            for p in parties:
                if not self.felink.joinable(p):
                    tiles.append({"kind": "closed", "label": "STARTED" if p["state"] == "playing" else "FULL",
                                  "party": p, "lit": True, "net": net})
            tiles.append({"kind": "new" if parties else "link", "label": "NEW " + word[0] if parties else word[1],
                          "max": prof["max"], "lit": False, "net": net, "most": min(local, prof["max"]),
                          "take": min(pick or local, local, prof["max"])})
        fav = g is not None and g.get("Favourite") == "1"
        tiles.append({"kind": "fav", "label": "UNFAVOURITE" if fav else "FAVOURITE"})
        tiles.append({"kind": "more", "label": "MORE"})
        return tiles

    def link_files(self, g):
        """Os arquivos do jogo que a festa serve a quem entra sem eles: o do
        jogo, o pai (num clone) e os extras do perfil (os que existem)."""
        system = g["_system"]
        paths = list(self.lib.rom_files(g))
        parent = g.get("CloneOf")
        for ext in (system.get("extensions") or [".zip"]) if parent else ():
            path = os.path.join(system["folder"], parent + ext)
            if os.path.isfile(path):
                paths.append(path)
        return self.link.served(paths)

    def link_host(self, take=None):
        """NEW LINK / LINK PLAY: este gabinete abre a festa (e o numero 1);
        take: os jogadores que ele fornece (os escolhidos no menu)."""
        g = self.game()
        prof = self.link_profile(g)
        if not self.link.host_game(prof, g["_system"]["key"], g["Name"], self.link_files(g), self.link_rom(g), take=take):
            self.say(self.link.message or "CANNOT OPEN THE PARTY", 3)
            return
        self.link_game = g
        self.overlay, self.ov = "lobby", {}

    def link_join(self, party, take=None):
        """JOIN LINK: primeiro os arquivos (so copia o que falta, do anfitriao),
        depois a entrada na festa."""
        g = self.game()
        self.link_game = g
        self.overlay, self.ov = "transfer", {"progress": (0, 0, ""), "party": party, "result": None, "take": take}
        ov = self.ov

        def work():
            def progress(done, total, name):
                ov["progress"] = (done, total, name)
            ok, _ = self.felink.fetch_files(party["host_ip"], self.link.home, None, progress=progress)
            ov["result"] = ok
        threading.Thread(target=work, daemon=True).start()

    def link_act(self, a):
        """A sala e a copia: B sai; na sala, A comeca (o anfitriao, num jogo
        de tamanho flexivel, com o minimo)."""
        if self.overlay == "transfer":
            if a == "b2":
                self.ov["result"] = "cancel"
                self.overlay = None
            return None
        if a == "b2":
            self.link.leave()
            self.overlay = None
        elif a == "b1":
            lob = self.link.lobby()
            if lob and lob["role"] == "host" and not lob["plan"] and not self.link.start_now():
                self.say("WAITING FOR MORE CABINETS")
        return None

    def link_tick(self, now):
        """O cabo, a rede e a festa, a cada volta do laco: a lista de cima
        refeita quando outro gabinete abre ou fecha uma festa, a copia dos
        arquivos que acabou e a hora de abrir o jogo."""
        link = self.link
        if self.shot:
            return
        if not self.link_fake:
            link.poll(now)
        # Um controle solto ou ligado: o numero de jogadores muda (os que o net
        # play ocupa), e a tela avisa.
        players = link.local_players
        if self.players_seen is not None and players != self.players_seen:
            self.say("%d PLAYER%s" % (players, "" if players == 1 else "S"), 2.5)
        self.players_seen = players
        if not link.available():
            if self.overlay in ("lobby", "transfer"):
                self.overlay = None
                self.say("NO NETWORK CABLE", 3)
            return
        self.notify_parties(link.parties())
        sig = tuple((p["system"], p["game"], p["used"], p["state"]) for p in link.parties())
        if sig != self.link_sig:
            self.link_sig = sig
            if not self.overlay or self.overlay == "popup":
                g = self.game()
                extra = self.rows[self.cursor][2] if self.rows else None
                self.rebuild(keep=g["Name"] if g else None)
                if g is not None and self.fd.elsewhere(extra):
                    # O cursor numa linha do alto (o jogo ou uma party dele)
                    # fica nela; a party que acabou volta a linha do jogo.
                    same = [i for i, (g0, _, e) in enumerate(self.rows)
                            if g0 is not None and g0["Name"] == g["Name"] and e in (extra, "elsewhere")
                            and g0["_system"]["key"] == g["_system"]["key"]]
                    if same:
                        self.cursor = min(same, key=lambda i: self.rows[i][2] != extra)
        if self.overlay == "transfer" and self.ov.get("result") not in (None, "cancel"):
            ok = self.ov["result"]
            party = self.ov["party"]
            g = self.link_game
            self.overlay = None
            if not ok:
                self.say("COULD NOT COPY THE GAME FILES", 3)
            elif link.join_party(party, self.link_profile(g), g["_system"]["key"], g["Name"], self.link_rom(g),
                                 take=self.ov.get("take")):
                self.overlay, self.ov = "lobby", {}
            else:
                self.say(link.message or "COULD NOT JOIN", 3)
        r = link.tick(now)
        if r == "launch":
            self.launch_link()
        elif r == "closed":
            link.leave()
            self.overlay = None
            self.say("THE PARTY CLOSED", 3)

    def notify_parties(self, parties):
        """Uma party ou um link novo de outro gabinete: o aviso "NOME IS
        PLAYING" embaixo, com o sininho, por NOTICE segundos (com o jogo, se
        esta na lista aberta). A deste gabinete (anfitriao ou convidado) nao
        avisa."""
        link = self.link
        mine = link.ident if link.role == "host" else ((link.guest.party or {}).get("party") if link.guest else None)
        ids = set()
        for p in parties:
            if not p.get("host"):
                continue
            ids.add(p["party"])
            if p["party"] in self.parties_seen or p["party"] == mine:
                continue
            g = next((g for g in self.filtered() if (g["_system"]["key"], g["Name"]) == (p["system"], p["game"])), None)
            title = self.fd.short_title(g) if g else ""
            name = self.felink.clean_name(p["host"]) or "A CABINET"
            self.notice = (name, title, time.monotonic() + NOTICE)
        # As que acabaram saem: a mesma maquina abrindo outra avisa de novo.
        self.parties_seen = ids

    def launch_link(self):
        """A festa chegou na hora: o jogo abre com o comando, a NVRAM e o ini
        deste numero, e a festa acaba junto com ele."""
        g = self.link_game
        argv = self.lib.command(g) if g else None
        if not argv:
            self.link.leave()
            self.overlay = None
            self.say("CANNOT OPEN THIS GAME")
            return
        argv = self.link.command(argv)
        self.overlay = None
        self.launch(argv, g)
        self.link.leave()
        self.link_game = None
        self.last_input = time.monotonic()
        self.marquee_logo((self.category() or {}).get("name", ""), "", 1)

    def unpack_start(self, g):
        """Extrai o jogo Namco empacotado (gui/fenamco.py): o disco, o dongle e
        o boot.elf vao para a estrutura do PCSX2x6, e os .gz usados saem. A
        barra fica no centro da tela; B cancela."""
        ov = {"game": g, "progress": (0, 0, ""), "result": None, "cancel": threading.Event(), "error": ""}
        self.overlay, self.ov = "unpack", ov
        system, name, fenamco = g["_system"], g["Name"], self.fd.fenamco

        def work():
            def progress(done, total, file):
                ov["progress"] = (done, total, file)
            try:
                fenamco.unpack(system, name, progress, ov["cancel"])
                ov["result"] = True
            except InterruptedError:
                ov["result"] = "cancel"
            except Exception as e:      # o disco cheio, o proverb fora do ar, um .gz truncado...
                ov["error"] = str(e)
                ov["result"] = False
                # O motivo fica num log (o aviso da tela e curto).
                try:
                    import traceback
                    path = os.path.join(os.path.expanduser("~"), ".cache", "fliperos", "namco-unpack.log")
                    os.makedirs(os.path.dirname(path), exist_ok=True)
                    with open(path, "a", encoding="utf-8") as log:
                        log.write("%s %s\n%s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), name, traceback.format_exc()))
                except OSError:
                    pass
        threading.Thread(target=work, daemon=True).start()

    def core_start(self, g, argv, core):
        """O core do RetroArch do jogo nao esta instalado: baixado do buildbot
        (config/fliperos-core fetch --progress) com a barra no centro, como a
        extracao; B cancela. Depois o jogo abre (unpack_tick)."""
        name = os.path.basename(core)[:-len("_libretro.so")]
        ov = {"game": g, "argv": argv, "kind": "core", "title": "DOWNLOADING",
              "progress": (0, 100, name), "result": None, "cancel": threading.Event(), "error": ""}
        self.overlay, self.ov = "unpack", ov

        def work():
            try:
                proc = subprocess.Popen([CORE_TOOL, "fetch", name, "--progress"], stdout=subprocess.PIPE,
                                        stderr=subprocess.DEVNULL, text=True, start_new_session=True,
                                        env=dict(os.environ, FLIPEROS_RA_CORES=os.path.dirname(core)))
            except OSError:
                ov["error"], ov["result"] = "no tool", False
                return

            def cancel():
                # O script e o python do download, que segura a saida.
                ov["cancel"].wait()
                if proc.poll() is None:
                    try:
                        os.killpg(proc.pid, signal.SIGTERM)
                    except OSError:
                        pass
            threading.Thread(target=cancel, daemon=True).start()
            for line in proc.stdout:
                if line.startswith("@step "):
                    pct, _, text = line[6:].strip().partition(" ")
                    if pct.isdigit():
                        ov["progress"] = (int(pct), 100, text)
                elif line.startswith("@fail "):
                    ov["error"] = line.strip().partition("|")[2]
            proc.stdout.close()
            proc.wait()
            if ov["cancel"].is_set():
                ov["result"] = "cancel"
            else:
                ov["result"] = proc.returncode == 0 and os.path.isfile(core)
            ov["cancel"].set()       # a thread do cancelamento sai
        threading.Thread(target=work, daemon=True).start()

    def unpack_tick(self):
        """A extracao (ou o download do core) acabou: com sucesso o jogo (agora
        um .acgame da pasta) abre; senao o aviso."""
        if self.overlay != "unpack" or self.ov.get("result") is None:
            return
        result, error, g = self.ov["result"], self.ov.get("error", ""), self.ov["game"]
        self.overlay = None
        if self.ov.get("kind") == "core":
            if result is True:
                self.launch(self.ov["argv"], g)
            elif result == "cancel":
                self.say("DOWNLOAD CANCELLED", 3)
            elif "not available" in error:
                self.say("CORE NOT AVAILABLE", 4)
            elif "network" in error:
                self.say("NO NETWORK FOR THE CORE", 4)
            elif "space" in error:
                self.say("NOT ENOUGH SPACE", 4)
            else:
                self.say("COULD NOT DOWNLOAD THE CORE", 4)
            return
        if result is True:
            self.lib.forget()
            self.rebuild(keep=g["Name"])
            now = self.game()
            if now and now["Name"] == g["Name"] and not now.get("Packed"):
                self.launch(None, now)
            else:
                self.say("GAME READY", 3)
        elif result == "cancel":
            self.say("EXTRACTION CANCELLED", 3)
        else:
            if "incomplete" in error:
                self.say("FILE INCOMPLETE: COPY IT AGAIN", 5)
            elif "space" in error:
                self.say("NOT ENOUGH SPACE", 4)
            elif "boot.elf" in error or "urlopen" in error or "URLError" in error:
                self.say("NO NETWORK FOR THE BOOT FILE", 4)
            else:
                self.say("COULD NOT EXTRACT THE GAME", 4)

    def launch(self, argv=None, game=None):
        g = game or self.game()
        if g and g.get("Packed") and argv is None:
            # Um jogo Namco ainda em .gz nao tem comando: extrai (com a barra no
            # centro) e so entao abre (unpack_tick). Vem antes do "sem comando".
            if self.locked():
                self.nag()
                return
            self.unpack_start(g)
            return
        argv = argv or (self.lib.command(g) if g else None)
        if not argv:
            self.say("CANNOT OPEN THIS GAME")
            return
        if self.locked():
            self.nag()
            return
        core = missing_core(argv)
        if core:
            self.core_start(g, argv, core)
            return
        self.remember()
        pg = self.pg
        # O video, o som, os controles (e a rede) ficam para o jogo.
        self.player.stop()
        self.grid.stop()
        self.harvest.paused = True
        self.input.close()
        try:
            pg.mixer.quit()
        except pg.error:
            pass
        self.close()
        started = time.monotonic()
        ended = self.play(argv)
        played = time.monotonic() - started
        if played > 10:
            self.lib.played(g, played)
            self.rebuild(keep=g["Name"])          # o grupo RECENT acompanha
        self.harvest.paused = False
        self.open()
        self.input.open()
        self.media.clear()
        self.repeat.clear()
        pg.event.clear()
        if ended:
            self.say(ended, 3)

    def play(self, argv):
        """Abre o jogo e espera ele fechar. Enquanto isso: o atalho que o
        fecha (Tab > Frontend options), as fichas e o fim do tempo do modo
        comercial, e o arquivo do botao de desligar (FLIPEROS_POWERKEY
        games:ARQ, do config/fliperos-session) com o PID do jogo, ou "hold"
        com o botao desligado nos jogos. Devolve o aviso para a volta."""
        try:
            proc = subprocess.Popen(argv, env=game_env())
        except OSError:
            return None
        role = os.environ.get("FLIPEROS_POWERKEY", "")
        mark = role[len("games:"):] if role.startswith("games:") else None
        if mark:
            try:
                with open(mark, "w") as f:
                    f.write("%d\n" % proc.pid if self.power_exit else "hold\n")
            except OSError:
                mark = None
        state = {}
        watch = self.hotkeys()
        if watch:
            def read():
                for line in watch.stdout:
                    if line.strip() == "exit":
                        state["exit"] = True
                    elif line.strip() == "coin":
                        self.insert_coin()
            threading.Thread(target=read, daemon=True).start()
        try:
            while proc.poll() is None:
                if state.pop("exit", False):
                    self.stop(proc, state)
                elif self.commercial and self.left() <= 0 and "time" not in state:
                    # O tempo acabou: o jogo fecha.
                    state["time"] = True
                    self.stop(proc, state)
                elif state.get("kill") and time.monotonic() > state["kill"]:
                    self.stop(proc, state, signal.SIGKILL)
                time.sleep(0.1)
        finally:
            if proc.poll() is None:
                self.stop(proc, state)
            if watch:
                watch.terminate()
                try:
                    watch.wait(2)
                except subprocess.TimeoutExpired:
                    watch.kill()
            if mark:
                try:
                    os.unlink(mark)
                except OSError:
                    pass
        return "TIME IS UP - INSERT COIN" if state.get("time") else None

    def stop(self, proc, state, sig=signal.SIGTERM):
        """Fecha o jogo: ele e o que esta abaixo dele (o X, o emulador); quem
        nao sai em 4 s leva o SIGKILL."""
        for pid in tree(proc.pid):
            try:
                os.kill(pid, sig)
            except OSError:
                pass
        state["kill"] = time.monotonic() + 4 if sig == signal.SIGTERM else None

    def hotkeys(self):
        """O fliperos-buttons hotkey junto com o jogo: o atalho que o fecha e,
        no modo comercial, as fichas. Sem nada a ler, nenhum."""
        args = []
        if self.exit_key:
            args += ["--key", str(self.exit_key[1])]
        if self.exit_combo:
            args += ["--combo", "+".join(self.exit_combo), "--hold", str(EXIT_HOLD)]
        if self.commercial:
            args.append("--coin")
        if not args or not os.access(BUTTONS_TOOL, os.X_OK):
            return None
        try:
            return subprocess.Popen([BUTTONS_TOOL, "hotkey"] + args, stdin=subprocess.DEVNULL,
                                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        except OSError:
            return None

    # ── O laco ──
    def tick(self, now):
        """As repeticoes segurando, a aceleracao e o modo letra."""
        dt = min(0.1, now - getattr(self, "last_tick", now))
        self.last_tick = now
        if self.picking and now - self.pick_at >= PICK_WAIT:
            self.pick_category()
        if self.overlay and self.overlay not in ("filter", "classify", "rename", "more"):
            return
        # O modo letra acaba com LETTER_IDLE segundos sem mexer.
        if (self.letter_mode and self.input.held("up") is None and self.input.held("down") is None
                and now - self.letter_mode["last"] > LETTER_IDLE):
            self.letter_off()
        for a in ("up", "down"):
            held = self.input.held(a)
            if held is None:
                self.repeat.pop(a, None)
                continue
            if self.overlay:
                # Nos menus, a repeticao simples (sem acelerar).
                if a not in self.repeat:
                    self.repeat[a] = now + FIRST
                elif now >= self.repeat[a]:
                    self.repeat[a] = now + 0.12
                    self.overlay_act(a)
                continue
            step = 1 if a == "down" else -1
            if self.letter_mode:
                # Segurando no modo letra: repete a letra, devagar e depois
                # mais rapido.
                lheld = now - self.letter_mode["press"]
                if lheld >= FIRST and now >= self.repeat.get(a, 0):
                    rate = LRATE0 if lheld < LSPEEDUP else min(LRATE1, LRATE0 + (lheld - LSPEEDUP) * 9)
                    self.letter_jump(step, wrap=False)
                    self.repeat[a] = now + 1.0 / rate
            elif held >= LETTERS:
                # 3 s segurando: entra no modo letra, que ja comeca andando.
                self.letter_mode = {"press": now - FIRST, "last": now}
                self.letter_jump(step, wrap=False)
                self.repeat[a] = now + 1.0 / LRATE0
            elif held >= FIRST:
                k = min(1.0, (held - FIRST) / (LETTERS - FIRST))
                self.acc += (RATE0 + (RATE1 - RATE0) * k ** 1.5) * dt
                n = int(self.acc)
                if n:
                    self.acc -= n
                    self.move(step * n * (COLS if self.mode == "flow" else 1), wrap=False)
        for a, gap in (("left", 0.5), ("right", 0.5), ("b3", 0.18), ("b6", 0.18)):
            held = self.input.held(a)
            if held is None or self.overlay:
                continue
            if held >= gap and now >= self.repeat.get(a, 0):
                self.repeat[a] = now + (0.35 if a in ("left", "right") else 0.15)
                self.act(a)

    def run(self, keys=()):
        clock = self.pg.time.Clock()
        if self.shot:
            self.overlay = None
            frames = [None] + list(keys)
            for i, k in enumerate(frames):
                if k:
                    if self.act(k) == "quit":
                        break
                self.draw(time.monotonic())
                self.pg.image.save(self.back, "%s-%d.png" % (self.shot, i))
            return 0
        self.last_input, self.idle = time.monotonic(), False
        self.attract_next = None
        # O marquee abre no logotipo do sistema em que o frontend abriu (as
        # trocas o mandam em switch_category).
        self.marquee_logo((self.category() or {}).get("name", ""), "", 1)
        while True:
            now = time.monotonic()
            acts = self.input.poll()
            woke = bool(acts) and self.attract_next is not None
            self.marquee_idle(now, bool(acts) or bool(self.input.down))
            if woke:
                # O modo atracao passava os jogos: o toque so acorda, no jogo
                # em que parou (o quit, que vem do sistema, ainda vale).
                self.attract_next = None
                acts = [a for a in acts if a == "quit"]
            for a in acts:
                r = self.act(a)
                if r == "quit":
                    self.remember()
                    # Fora do frontend (o menu): o marquee sai do sistema e toca
                    # a animacao do logo.
                    if not self.shot:
                        try:
                            subprocess.Popen([PIXELCADE_TOOL, "bg", "home"], stdin=subprocess.DEVNULL,
                                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                             start_new_session=True)
                        except OSError:
                            pass
                    return 0
                if r == "launch":
                    self.launch()
                    self.last_input = time.monotonic()
                    # O jogo fechou: o marquee volta ao logotipo do sistema (o
                    # "end" do vigia do jogo nem sempre chega, e um atrasado
                    # acha o estado ja trocado e nao mexe nele).
                    self.marquee_logo((self.category() or {}).get("name", ""), "", 1)
            self.attract_tick(now)
            self.tick(now)
            self.link_tick(now)
            self.capture_tick(now)
            # O tempo do modo comercial acabou aqui no frontend.
            paid = self.commercial and self.left() > 0
            if getattr(self, "paid", False) and not paid:
                self.say("TIME IS UP - INSERT COIN", 3)
            self.paid = paid
            if self.lib.generation != self.generation:
                self.generation = self.lib.generation
                g = self.game()
                key = (self.category() or {}).get("key")
                if self.picking:
                    self.cancel_pick()    # a tira apontaria para outro sistema
                self.cats = self.lib.categories()
                self.cat = next((i for i, c in enumerate(self.cats) if c["key"] == key), 0)
                self.load_filter()
                self.rebuild(keep=g["Name"] if g else None)
                # As listas chegaram (ou mudaram): o marquee ainda nao tem o sistema de agora.
                name = (self.category() or {}).get("name", "")
                if name and name != getattr(self, "announced", None):
                    self.marquee_logo(name, "", 1)
            if now - self.last_check > 4 and not self.lib.refreshing:
                self.last_check = now
                if self.lib.changed():
                    self.say("UPDATING THE LISTS...", 3)
                    self.lib.refresh()
            self.auto_scrape(now)
            self.bios.refresh(now)
            self.unpack_tick()
            # O servico do scrape automatico (fliperos-scrape --daemon): o
            # andamento dele e a midia nova; sem ele, o laco e o daqui.
            if now - self.followed_at > 3:
                self.followed_at = now
                self.harvest.external = self.harvest.follow()
            while self.dirty:
                folder, name = self.dirty.pop()
                for kind in ("snap", "box", "marquee", "logo", "preview"):
                    self.media.pop(("path", kind, folder, name), None)
                self.media.pop(("video", folder, name), None)
                self.media.pop(("desc", folder, name), None)   # a sinopse (feview.game_description)
                self.ahead_at = None
            if self.flush:
                # Um scrape trouxe arquivos: os caminhos e as imagens guardados
                # sao lidos de novo (limpos aqui, fora da thread dele).
                self.flush = False
                self.media.clear()
                self.ready.clear()
                self.ahead_at = None
            self.prefetch()
            self.draw(now)
            self.present()
            clock.tick(FPS)

    def splash(self):
        """A tela de abrir: o fundo animado do menu e o aviso."""
        T, W = self.T, self.W
        self.pg.event.pump()
        self.bg.draw(self.back, time.monotonic() - self.start)
        ui = self.pg.Surface((T.WIDTH, T.HEIGHT), self.pg.SRCALPHA)
        W.frame(ui, {}, "FliperOS", [])
        msg = "LOADING THE GAMES..."
        ui.blit(W.big(msg, 1, W.LABEL), ((T.WIDTH - W.width(msg)) // 2, T.HEIGHT // 2 - 4))
        self.back.blit(ui, (0, 0))
        self.present()

    # ── Adiantar as imagens ──
    def prefetch(self):
        """Quando o cursor (ou o modo, ou a lista) muda, passa a thread as
        imagens dos proximos jogos para os dois lados, as do lado de baixo
        primeiro; na grade, tambem as da fileira de cima e de baixo."""
        at = (self.cursor, self.mode, id(self.rows), len(self.rows), self.overlay)
        if at == self.ahead_at or not self.rows:
            return
        self.ahead_at = at
        reach = 3 * COLS if self.mode == "flow" else 6
        order = [0]
        for k in range(1, reach + 1):
            order += [k, -k]
        keys = []
        import feview
        for k in order:
            i = self.cursor + k
            if 0 <= i < len(self.rows):
                if self.rows[i][0] is None:
                    continue
                for key in feview.wanted(self, self.rows[i][0]):
                    if key not in self.media and key not in self.ready and key not in keys:
                        keys.append(key)
        self.ahead = keys
        self.ahead_wake.set()

    def prefetch_work(self):
        import feview
        while True:
            self.ahead_wake.wait()
            self.ahead_wake.clear()
            while self.ahead:
                keys = self.ahead
                key = keys[0]
                if keys is self.ahead:
                    self.ahead = keys[1:]
                if key in self.media or key in self.ready:
                    continue
                try:
                    img = feview.load(*key)
                except Exception:  # um arquivo estragado: o desenho tenta de novo
                    continue
                if len(self.ready) > 120:
                    try:
                        self.ready.pop(next(iter(self.ready)), None)
                    except (RuntimeError, StopIteration):
                        pass
                self.ready[key] = img

    def present(self):
        if self.window is None:
            return
        # Em pe, a tela logica gira para o lado do monitor antes de esticar.
        self.pg.transform.scale(self.T.upright(self.back), self.window.get_size(), self.window)
        self.pg.display.flip()

    # ── Desenho ──
    def draw(self, now):
        self.view.draw(self, now)   # (o desenho fica em gui/feview.py)


def main():
    parser = argparse.ArgumentParser(description="FliperOS frontend")
    parser.add_argument("--shot", help="no video: write PREFIX-N.png after each key of --keys")
    parser.add_argument("--keys", default="", help="actions to run first, e.g. 'b1 right b1'")
    args = parser.parse_args()
    fe = Frontend(args)
    return fe.run(args.keys.split())


if __name__ == "__main__":
    sys.exit(main())
