def game_program(argv):
    """O programa do comando do jogo: o de depois do fliperos-x11-run/kms-run
    (e do --mode e do --app dele), o nome que o config/fliperos-buttons conhece."""
    if len(argv) < 2 or os.path.basename(argv[0]) not in ("fliperos-x11-run", "fliperos-kms-run"):
        return None
    words = argv[1:]
    while len(words) > 2 and words[0] in ("--mode", "--app"):
        words = words[2:]
    return os.path.basename(words[0]) if words else None


def game_env():
    """O ambiente do jogo: sem o SDL do KMS que a sessao deu ao frontend
    (FLIPEROS_FRONTEND_SDL, config/fliperos-session). Os emuladores abrem com o
    SDL de sempre; o GroovyMAME poe o do KMS ele mesmo."""
    env = dict(os.environ)
    sdl = env.pop("FLIPEROS_FRONTEND_SDL", "")
    if sdl:
        rest = [p for p in env.get("LD_LIBRARY_PATH", "").split(":") if p and p != sdl]
        if rest:
            env["LD_LIBRARY_PATH"] = ":".join(rest)
        else:
            env.pop("LD_LIBRARY_PATH", None)
    return env


def missing_core(argv):
    """O core do RetroArch do comando (-L /.../NOME_libretro.so) quando ele
    ainda nao esta instalado; senao None."""
    for flag, core in zip(argv, argv[1:]):
        if flag in ("-L", "--libretro") and core.endswith("_libretro.so") and "/" in core:
            return None if os.path.exists(core) else core
    return None


