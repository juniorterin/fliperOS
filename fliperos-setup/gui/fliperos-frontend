    def link_profile(self, g):
        """O perfil de link do jogo (os que ligam gabinetes) ou o de net play
        (felink.netplay_profile: um core do RetroArch que faz net play, ou o GGPO
        do Flycast no Naomi e no Atomiswave)."""
        if not g:
            return None
        key = g["_system"]["key"]
        return self.link.profile_of(key, g["Name"]) or self.link.netplay_of(key, g["Name"], g.get("Players"))

    def link_kind(self, g):
        prof = self.link_profile(g)
        return None if not prof else ("net" if prof.get("netplay") else "link")

    def link_mark(self, g):
        """None: o jogo nao tem link nem net play, ou nao ha outro gabinete na
        rede (sem ninguem com quem jogar, o globo nao aparece na lista). False:
        tem, e ninguem joga. True: alguem joga."""
        if not self.link_profile(g) or not self.link.others():
            return None
        return bool(self.link.parties_for(g["_system"]["key"], g["Name"]))

    def link_rom(self, g):
        """O arquivo do jogo (o zip do set), que o RetroArch do net play abre."""
        files = self.lib.rom_files(g)
        return files[0] if files else None

    @staticmethod
    def party_order(parties):
        """As que ainda aceitam gente primeiro, depois pelo nome do gabinete."""
        return sorted(parties, key=lambda p: (p["state"] != "lobby", p["host"] or ""))

    def link_parties(self, g):
        """As festas de outros gabinetes nesse jogo (party_order)."""
        return self.party_order(self.link.parties_for(g["_system"]["key"], g["Name"])) if g else []

    def link_party(self, g):
        """A festa de outro gabinete nesse jogo (a que ainda aceita gente primeiro)."""
        parties = self.link_parties(g)
        return parties[0] if parties else None

    def popup_tiles(self):
        """Os azulejos do menu do jogo. Num jogo de link, depois do PLAY: JOIN
        de cada festa aberta, as que nao aceitam mais gente (apagadas, so o
        estado) e NEW LINK; sem festa nenhuma, o LINK PLAY (este gabinete e o
        primeiro). Sem outro gabinete na rede, nada de link: so o PLAY."""
        g = self.game()
        tiles = [{"kind": "play", "label": "PLAY"}]
        prof = self.link_profile(g)
        if prof and self.link.others():
            net = bool(prof.get("netplay"))
            # "Party", e nao "net play": e so na rede local, nada de Internet.
            word = ("PARTY", "PARTY PLAY") if net else ("LINK", "LINK PLAY")
            parties = self.link.parties_for(g["_system"]["key"], g["Name"])
            # Os jogadores que este gabinete fornece: ate um por controle (most);
            # o escolhido na linha de baixo (ov["take"]) vale para todos os azulejos.
            local = self.link.max_take(prof)
            pick = (self.ov or {}).get("take") if self.overlay == "popup" else None
            for p in parties:
                if self.felink.joinable(p):
                    most = max(1, min(local, (p["max"] or 0) - p["used"]))
                    tiles.append({"kind": "join", "label": "JOIN " + word[0], "party": p, "lit": True, "net": net,
                                  "most": most, "take": min(pick or most, most)})
            for p in parties:
                if not self.felink.joinable(p):
                    tiles.append({"kind": "closed", "label": "STARTED" if p["state"] == "playing" else "FULL",
                                  "party": p, "lit": True, "net": net})
            tiles.append({"kind": "new" if parties else "link", "label": "NEW " + word[0] if parties else word[1],
                          "max": prof["max"], "lit": False, "net": net, "most": min(local, prof["max"]),
                          "take": min(pick or local, local, prof["max"])})
        fav = g is not None and g.get("Favourite") == "1"
        tiles.append({"kind": "fav", "label": "UNFAVOURITE" if fav else "FAVOURITE"})
        # Um jogo com conquistas do RetroAchievements (o mesmo do selo): o
        # trofeu abre a lista delas (open_cheevos).
        if g is not None and self.view.cheevos_of(self, g):
            tiles.append({"kind": "cheevos", "label": "ACHIEVEMENTS"})
        tiles.append({"kind": "more", "label": "MORE"})
        return tiles

    def link_files(self, g):
        """Os arquivos do jogo que a festa serve a quem entra sem eles: o do
        jogo, o pai (num clone) e os extras do perfil (os que existem)."""
        system = g["_system"]
        paths = list(self.lib.rom_files(g))
        parent = g.get("CloneOf")
        for ext in (system.get("extensions") or [".zip"]) if parent else ():
            path = os.path.join(system["folder"], parent + ext)
            if os.path.isfile(path):
                paths.append(path)
        return self.link.served(paths)

    def link_host(self, take=None):
        """NEW LINK / LINK PLAY: este gabinete abre a festa (e o numero 1);
        take: os jogadores que ele fornece (os escolhidos no menu)."""
        g = self.game()
        prof = self.link_profile(g)
        if not self.link.host_game(prof, g["_system"]["key"], g["Name"], self.link_files(g), self.link_rom(g), take=take):
            self.say(self.link.message or "CANNOT OPEN THE PARTY", 3)
            return
        self.link_game = g
        self.overlay, self.ov = "lobby", {}

    def link_join(self, party, take=None):
        """JOIN LINK: primeiro os arquivos (so copia o que falta, do anfitriao),
        depois a entrada na festa."""
        g = self.game()
        self.link_game = g
        self.overlay, self.ov = "transfer", {"progress": (0, 0, ""), "party": party, "result": None, "take": take}
        ov = self.ov

        def work():
            def progress(done, total, name):
                ov["progress"] = (done, total, name)
            ok, _ = self.felink.fetch_files(party["host_ip"], self.link.home, None, progress=progress)
            ov["result"] = ok
        threading.Thread(target=work, daemon=True).start()

    def link_act(self, a):
        """A sala e a copia: B sai; na sala, A comeca (o anfitriao, num jogo
        de tamanho flexivel, com o minimo)."""
        if self.overlay == "transfer":
            if a == "b2":
                self.ov["result"] = "cancel"
                self.overlay = None
            return None
        if a == "b2":
            self.link.leave()
            self.overlay = None
        elif a == "b1":
            lob = self.link.lobby()
            if lob and lob["role"] == "host" and not lob["plan"] and not self.link.start_now():
                self.say("WAITING FOR MORE CABINETS")
        return None

    def link_tick(self, now):
        """O cabo, a rede e a festa, a cada volta do laco: a lista de cima
        refeita quando outro gabinete abre ou fecha uma festa, a copia dos
        arquivos que acabou e a hora de abrir o jogo."""
        link = self.link
        if self.shot:
            return
        if not self.link_fake:
            link.poll(now)
        # Um controle solto ou ligado: o numero de jogadores muda (os que o net
        # play ocupa), e a tela avisa.
        players = link.local_players
        if self.players_seen is not None and players != self.players_seen:
            self.say("%d PLAYER%s" % (players, "" if players == 1 else "S"), 2.5)
        self.players_seen = players
        if not link.available():
            if self.overlay in ("lobby", "transfer"):
                self.overlay = None
                self.say("NO NETWORK CABLE", 3)
            return
        self.notify_parties(link.parties())
        sig = tuple((p["system"], p["game"], p["used"], p["state"]) for p in link.parties())
        if sig != self.link_sig:
            self.link_sig = sig
            if not self.overlay or self.overlay == "popup":
                g = self.game()
                extra = self.rows[self.cursor][2] if self.rows else None
                self.rebuild(keep=g["Name"] if g else None)
                if g is not None and self.fd.elsewhere(extra):
                    # O cursor numa linha do alto (o jogo ou uma party dele)
                    # fica nela; a party que acabou volta a linha do jogo.
                    same = [i for i, (g0, _, e) in enumerate(self.rows)
                            if g0 is not None and g0["Name"] == g["Name"] and e in (extra, "elsewhere")
                            and g0["_system"]["key"] == g["_system"]["key"]]
                    if same:
                        self.cursor = min(same, key=lambda i: self.rows[i][2] != extra)
        if self.overlay == "transfer" and self.ov.get("result") not in (None, "cancel"):
            ok = self.ov["result"]
            party = self.ov["party"]
            g = self.link_game
            self.overlay = None
            if not ok:
                self.say("COULD NOT COPY THE GAME FILES", 3)
            elif link.join_party(party, self.link_profile(g), g["_system"]["key"], g["Name"], self.link_rom(g),
                                 take=self.ov.get("take")):
                self.overlay, self.ov = "lobby", {}
            else:
                self.say(link.message or "COULD NOT JOIN", 3)
        r = link.tick(now)
        if r == "launch":
            self.launch_link()
        elif r == "closed":
            link.leave()
            self.overlay = None
            self.say("THE PARTY CLOSED", 3)

    def notify_parties(self, parties):
        """Uma party ou um link novo de outro gabinete: o aviso "NOME IS
        PLAYING" embaixo, com o sininho, por NOTICE segundos (com o jogo, se
        esta na lista aberta). A deste gabinete (anfitriao ou convidado) nao
        avisa."""
        link = self.link
        mine = link.ident if link.role == "host" else ((link.guest.party or {}).get("party") if link.guest else None)
        ids = set()
        for p in parties:
            if not p.get("host"):
                continue
            ids.add(p["party"])
            if p["party"] in self.parties_seen or p["party"] == mine:
                continue
            g = next((g for g in self.filtered() if (g["_system"]["key"], g["Name"]) == (p["system"], p["game"])), None)
            title = self.fd.short_title(g) if g else ""
            name = self.felink.clean_name(p["host"]) or "A CABINET"
            self.notice = (name, title, time.monotonic() + NOTICE)
        # As que acabaram saem: a mesma maquina abrindo outra avisa de novo.
        self.parties_seen = ids

    def launch_link(self):
        """A festa chegou na hora: o jogo abre com o comando, a NVRAM e o ini
        deste numero, e a festa acaba junto com ele."""
        g = self.link_game
        argv = self.lib.command(g) if g else None
        if not argv:
            self.link.leave()
            self.overlay = None
            self.say("CANNOT OPEN THIS GAME")
            return
        argv = self.link.command(argv)
        self.overlay = None
        self.launch(argv, g)
        self.link.leave()
        self.link_game = None
        self.last_input = time.monotonic()
        self.marquee_logo((self.category() or {}).get("name", ""), "", 1)

    def unpack_start(self, g):
        """Extrai o jogo Namco empacotado (gui/fenamco.py): o disco, o dongle e
        o boot.elf vao para a estrutura do PCSX2x6, e os .gz usados saem. A
        barra fica no centro da tela; B cancela."""
        ov = {"game": g, "progress": (0, 0, ""), "result": None, "cancel": threading.Event(), "error": ""}
        self.overlay, self.ov = "unpack", ov
        system, name, fenamco = g["_system"], g["Name"], self.fd.fenamco

        def work():
            def progress(done, total, file):
                ov["progress"] = (done, total, file)
            try:
                fenamco.unpack(system, name, progress, ov["cancel"])
                ov["result"] = True
            except InterruptedError:
                ov["result"] = "cancel"
            except Exception as e:      # o disco cheio, o proverb fora do ar, um .gz truncado...
                ov["error"] = str(e)
                ov["result"] = False
                # O motivo fica num log (o aviso da tela e curto).
                try:
                    import traceback
                    path = os.path.join(os.path.expanduser("~"), ".cache", "fliperos", "namco-unpack.log")
                    os.makedirs(os.path.dirname(path), exist_ok=True)
                    with open(path, "a", encoding="utf-8") as log:
                        log.write("%s %s\n%s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), name, traceback.format_exc()))
                except OSError:
                    pass
        threading.Thread(target=work, daemon=True).start()

    def core_start(self, g, argv, core, media=False):
        """O core do RetroArch do jogo nao esta instalado: baixado do buildbot
        (config/fliperos-core fetch --progress) com a barra no centro, como a
        extracao; B cancela. Depois o jogo abre (unpack_tick). media: o jogo e
        o disco do drive, e o cartao dele volta depois."""
        name = os.path.basename(core)[:-len("_libretro.so")]
        self.fetch_start(g, argv, "core", "DOWNLOADING", name, [CORE_TOOL, "fetch", name, "--progress"],
                         lambda: os.path.isfile(core), media,
                         env=dict(os.environ, FLIPEROS_RA_CORES=os.path.dirname(core)))

    def emulator_start(self, g, argv, name, media=False):
        """O emulador do jogo nao esta instalado: o Setup o instala (o pacote,
        ou baixado) ou compila (com os patches do FliperOS), com a barra no
        centro, como o core (fliperos-setup --emulator-ensure). Depois o jogo
        abre."""
        cmd = [self.fd.SETUP, "--emulator-ensure", name]
        if os.geteuid() != 0 and os.path.exists("/usr/bin/sudo"):
            cmd = ["sudo", "-n"] + cmd
        self.fetch_start(g, argv, "emulator", "INSTALLING", name, cmd,
                         lambda: missing_emulator(argv) is None, media)

    def fetch_start(self, g, argv, kind, title, name, cmd, ready, media=False, env=None):
        """Um comando com os eventos @step/@fail na barra do centro; B cancela.
        ready(): o que o comando devia trazer esta aqui."""
        ov = {"game": g, "argv": argv, "kind": kind, "title": title,
              "progress": (0, 100, name), "result": None, "cancel": threading.Event(), "error": ""}
        if media:
            ov["back"] = (self.overlay, self.ov)
        self.overlay, self.ov = "unpack", ov

        def work():
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stdin=subprocess.DEVNULL,
                                        stderr=subprocess.DEVNULL, text=True, start_new_session=True,
                                        env=env)
            except OSError:
                ov["error"], ov["result"] = "no tool", False
                return

            def cancel():
                # O script e o python do download, que segura a saida.
                ov["cancel"].wait()
                if proc.poll() is None:
                    try:
                        os.killpg(proc.pid, signal.SIGTERM)
                    except OSError:
                        pass
            threading.Thread(target=cancel, daemon=True).start()
            for line in proc.stdout:
                if line.startswith("@step "):
                    pct, _, text = line[6:].strip().partition(" ")
                    if pct.isdigit():
                        ov["progress"] = (int(pct), 100, text)
                elif line.startswith("@fail "):
                    ov["error"] = line.strip().partition("|")[2]
            proc.stdout.close()
            proc.wait()
            if ov["cancel"].is_set():
                ov["result"] = "cancel"
            else:
                ov["result"] = proc.returncode == 0 and ready()
            ov["cancel"].set()       # a thread do cancelamento sai
        threading.Thread(target=work, daemon=True).start()

    def unpack_tick(self):
        """A extracao (ou o download do core) acabou: com sucesso o jogo (agora
        um .acgame da pasta) abre; senao o aviso."""
        if self.overlay != "unpack" or self.ov.get("result") is None:
            return
        result, error, g = self.ov["result"], self.ov.get("error", ""), self.ov["game"]
        self.overlay = None
        if self.ov.get("kind") in ("core", "emulator"):
            back, argv = self.ov.get("back"), self.ov["argv"]
            core = self.ov.get("kind") == "core"
            if back:
                # O disco do drive: de volta ao cartao dele (e o jogo abre dali).
                self.overlay, self.ov = back
            if result is True and back:
                self.launch(argv, media=True)
            elif result is True:
                self.launch(argv, g)
            elif result == "cancel":
                self.say("DOWNLOAD CANCELLED" if core else "INSTALL CANCELLED", 3)
            elif not core:
                self.say("NO NETWORK FOR THE EMULATOR" if "network" in error
                         else "NOT ENOUGH SPACE" if "space" in error
                         else "COULD NOT INSTALL THE EMULATOR", 4)
            elif "not available" in error:
                self.say("CORE NOT AVAILABLE", 4)
            elif "network" in error:
                self.say("NO NETWORK FOR THE CORE", 4)
            elif "space" in error:
                self.say("NOT ENOUGH SPACE", 4)
            else:
                self.say("COULD NOT DOWNLOAD THE CORE", 4)
            return
        if result is True:
            self.lib.forget()
            self.rebuild(keep=g["Name"])
            now = self.game()
            if now and now["Name"] == g["Name"] and not now.get("Packed"):
                self.launch(None, now)
            else:
                self.say("GAME READY", 3)
        elif result == "cancel":
            self.say("EXTRACTION CANCELLED", 3)
        else:
            if "incomplete" in error:
                self.say("FILE INCOMPLETE: COPY IT AGAIN", 5)
            elif "space" in error:
                self.say("NOT ENOUGH SPACE", 4)
            elif "boot.elf" in error or "urlopen" in error or "URLError" in error:
                self.say("NO NETWORK FOR THE BOOT FILE", 4)
            else:
                self.say("COULD NOT EXTRACT THE GAME", 4)

    # ── A midia fisica (gui/femedia.py) ──
    def media_watch(self):
        """Os drives e o estado de cada um, a cada MEDIA_POLL segundos; parado
        com o jogo aberto (o emulador le o drive)."""
        while True:
            if self.window is not None:
                try:
                    self.devices = self.fm.scan()
                except Exception:  # um drive sumindo no meio da leitura
                    pass
            time.sleep(MEDIA_POLL)

    def device(self, key):
        return next((d for d in self.devices if d["key"] == key), None)

    def strip_act(self, a):
        """A fileira PHYSICAL MEDIA: esquerda e direita andam nos drives, para
        cima volta a tira dos sistemas, o 1 le o disco e o 2 fecha tudo."""
        n = len(self.devices)
        if not n:
            self.strip = None
            return None
        self.strip %= n
        if a in ("left", "right"):
            self.strip = (self.strip + (1 if a == "right" else -1)) % n
        elif a == "up":
            self.strip = None
            self.pick_at = time.monotonic()
        elif a == "b2":
            self.strip = None
            self.cancel_pick()
        elif a == "b1":
            self.media_open(self.devices[self.strip])
        return None

    def media_open(self, d, system=None):
        """O botao 1 num drive: sem disco, o aviso; com disco, o READING
        enquanto o console e reconhecido (femedia.identify, numa thread). No
        OSCR: os cartuchos dos slots (SCAN) ou, com system, o daquele sistema
        (INFO), pela USB."""
        if d["kind"] == "oscr":
            name = self.fm.CONSOLES[self.fm.CARTS[system]]["name"].upper() if system else ""
            ov = {"dev": d, "oscr": True, "system": system, "result": None, "since": time.monotonic(),
                  "where": "OSCR - CART READER (%s)" % os.path.basename(d["dev"]).upper(),
                  "step": "READING THE %s CART" % name if system else "LOOKING AT EACH SLOT"}
            self.overlay, self.ov = "mediaload", ov

            def scan():
                ov["result"] = self.fm.oscr_call(d["dev"], "info" if system else "scan", system)
            threading.Thread(target=scan, daemon=True).start()
            return
        state = d.get("state")
        if state in ("empty", "open", "unknown"):
            self.say("NO DISC IN " + d["name"], 2)
            return
        if state == "noaccess":
            self.say("NO ACCESS TO " + d["name"], 2.4)
            return
        ov = {"dev": d, "where": "%s - %s (%s)" % (d["name"], d["model"], d["key"]),
              "step": "WHICH CONSOLE IS IT?", "result": None, "since": time.monotonic()}
        self.overlay, self.ov = "mediaload", ov

        def work():
            try:
                info = self.fm.identify(d["dev"])
            except Exception as e:  # o disco saiu no meio da leitura
                info = {"console": None, "error": str(e)}
            ov["result"] = info
        threading.Thread(target=work, daemon=True).start()

    def media_card(self, d, info):
        """O cartao do disco reconhecido, com o emulador da ultima vez (ou o
        primeiro: o standalone, se instalado)."""
        console = info["console"]
        option = self.fm.pick(console, self.media_emus.get(console))
        if option is None:
            self.say("NO EMULATOR FOR " + info["name"].upper(), 3)
            return False
        serial = info.get("serial") or ""
        sub = " - ".join(p for p in (info["name"], serial, d["name"]) if p)
        self.overlay, self.ov = "mediacard", {"dev": d, "info": info, "sel": 0, "option": option,
                                              "title": info.get("title") or info["name"], "sub": sub,
                                              "oscr": bool(info.get("oscr"))}
        self.media_labels()
        return True

    def cart_info(self, cart):
        """O cartucho do OSCR como um disco reconhecido: o console, o nome do
        jogo (o do cabecalho) e o tamanho da ROM no lugar do serial."""
        size = cart.get("rom") or 0
        label = ("%d MBIT" % (size // 131072) if size >= 131072 else "%d KB" % (size // 1024)) if size else ""
        name = self.fm.CONSOLES[cart["console"]]["name"]
        return {"console": cart["console"], "name": name, "title": cart.get("title") or name, "serial": label,
                "oscr": True, "system": cart["system"]}

    def oscr_result(self, d, result, system):
        """O que o OSCR respondeu: um cartucho vai ao cartao; mais de um, a
        escolha; nenhum (a 3,3 V do SCAN), a lista dos sistemas, e o OSCR
        poe a tensao do escolhido, como no menu dele."""
        err = result.get("error")
        if err:
            self.say({"firmware": "THE OSCR NEEDS THE FLIPEROS FIRMWARE",
                      "noaccess": "NO ACCESS TO THE OSCR"}.get(err, "THE OSCR DID NOT ANSWER"), 3.5)
            if self.boot:
                self.overlay, self.ov = "medianone", self.none_ov()
            return
        carts = [c for c in result.get("carts", []) if c.get("console")]
        if len(carts) == 1 and self.media_card(d, self.cart_info(carts[0])):
            return
        if carts:
            self.overlay, self.ov = "mediacarts", {"dev": d, "carts": carts, "sel": 0}
            return
        if system:
            self.say("NO %s CARTRIDGE" % self.fm.CONSOLES[self.fm.CARTS[system]]["name"].upper(), 3)
        rows = [{"label": self.fm.CONSOLES[self.fm.CARTS[s]]["name"].upper(), "icon": s.lower(), "system": s}
                for s in result.get("systems") or [] if s in self.fm.CARTS]
        self.overlay, self.ov = "medialist", {"dev": d, "level": "system", "rows": rows,
                                              "sel": next((i for i, r in enumerate(rows) if r["system"] == system), 0),
                                              "head": "WHICH SYSTEM?", "title": "NO CARTRIDGE ANSWERED AT 3.3V",
                                              "note": "THE OSCR SETS THE VOLTAGE OF THE SYSTEM"}

    def media_labels(self):
        """O que o cartao escreve do emulador de agora: o nome, o icone e a
        pasta do rip."""
        ov, option = self.ov, self.ov["option"]
        name = option["label"] if not option["core"] else "RETROARCH - " + option["label"]
        if option.get("missing"):
            name += " (DOWNLOAD)"
        ov["emu"], ov["icon"] = name, option["icon"]
        ov["dest"] = "ROMS/" + option["folder"].upper()

    def media_choose(self, option):
        """O emulador escolhido para o console, ja gravado; de volta ao cartao."""
        card = self.ov["card"]
        card["option"] = option
        self.media_emus[card["info"]["console"]] = option["id"]
        self.remember()
        self.overlay, self.ov = "mediacard", card
        self.media_labels()

    def media_list(self, card, level):
        """A lista do EMULATOR: os standalones e o RETROARCH (que abre os
        cores); level "cores": so os cores do RetroArch que leem o drive."""
        console = card["info"]["console"]
        options = self.fm.emulators(console)
        now = card["option"]["id"]
        rows = []
        if level == "emu":
            for o in options:
                if not o["core"]:
                    rows.append({"label": o["label"], "icon": o["icon"], "tag": "STANDALONE", "opt": o,
                                 "current": o["id"] == now})
            if any(o["core"] for o in options):
                rows.append({"label": "RETROARCH", "icon": "retroarch", "more": True,
                             "current": now.startswith("retroarch:")})
            head = "EMULATOR"
        else:
            for o in options:
                if o["core"]:
                    rows.append({"label": o["label"], "icon": "retroarch", "opt": o, "current": o["id"] == now,
                                 "tag": "DOWNLOAD" if o.get("missing") else ""})
            head = "RETROARCH CORE"
        sel = next((i for i, r in enumerate(rows) if r["current"]), 0)
        self.overlay, self.ov = "medialist", {"card": card, "level": level, "rows": rows, "sel": sel, "head": head,
                                              "title": card["info"]["name"],
                                              "note": "ONLY CORES THAT READ A REAL DISC" if level == "cores" else ""}

    def media_act(self, a):
        o, ov = self.overlay, self.ov
        if o == "medianone":
            if a == "b2":
                self.boot_leave()
            elif a == "b1" and self.boot.startswith("oscr") and self.device(self.boot) and not ov["inserted"]:
                # O OSCR nao sente o cartucho entrar: o botao 1 diz que ja esta la.
                ov["inserted"] = time.monotonic()
            return None
        if o == "mediacarts":
            if a in ("left", "right"):
                ov["sel"] = (ov["sel"] + (1 if a == "right" else -1)) % len(ov["carts"])
            elif a == "b1":
                self.media_card(ov["dev"], self.cart_info(ov["carts"][ov["sel"]]))
            elif a == "b2":
                if self.boot:
                    self.boot_leave()
                else:
                    self.overlay = None
            return None
        if o == "medialist" and ov["level"] == "system":
            rows = ov["rows"]
            if a in ("up", "down") and rows:
                ov["sel"] = (ov["sel"] + (1 if a == "down" else -1)) % len(rows)
            elif a == "b1" and rows:
                self.media_open(ov["dev"], rows[ov["sel"]]["system"])
            elif a == "b2":
                if self.boot:
                    self.overlay, self.ov = "medianone", self.none_ov()
                else:
                    self.overlay = None
            return None
        if o == "mediaload":
            if a == "b2":
                ov["result"] = ov.get("result") or {"console": None, "cancel": True}
                if self.boot:
                    self.boot_leave()
                else:
                    self.overlay = None
            return None
        if o == "mediarip":
            if a == "b2" and ov.get("proc") and ov["proc"].poll() is None:
                try:
                    os.killpg(ov["proc"].pid, signal.SIGTERM)
                except OSError:
                    pass
            return None
        if o == "mediacard":
            if a in ("left", "right"):
                ov["sel"] = (ov["sel"] + (1 if a == "right" else -1)) % 3
            elif a == "b2":
                if self.boot:
                    self.boot_leave()
                else:
                    self.overlay = None
            elif a == "b1" and ov["sel"] == 0:
                self.media_play()
            elif a == "b1" and ov["sel"] == 1:
                self.media_list(ov, "emu")
            elif a == "b1":
                self.media_rip()
            return None
        if o == "medialist":
            rows = ov["rows"]
            if a in ("up", "down") and rows:
                ov["sel"] = (ov["sel"] + (1 if a == "down" else -1)) % len(rows)
            elif a == "b2":
                if ov["level"] == "cores":
                    self.media_list(ov["card"], "emu")
                else:
                    self.overlay, self.ov = "mediacard", ov["card"]
            elif a == "b1" and rows:
                row = rows[ov["sel"]]
                if not row.get("more"):
                    self.media_choose(row["opt"])
                    self.say(self.ov["emu"], 2)
                    return None
                cores = [x for x in self.fm.emulators(ov["card"]["info"]["console"]) if x["core"]]
                if len(cores) == 1:
                    # Um core so: direto nele, sem a lista.
                    self.media_choose(cores[0])
                    self.say("ONE CORE: " + cores[0]["label"], 2.4)
                else:
                    self.media_list(ov["card"], "cores")
            return None
        return None

    def media_play(self):
        """Joga o disco direto do drive com o emulador do cartao; o jogo
        fechado, o cartao volta. O cartucho do OSCR e lido antes para uma
        copia temporaria (o OSCR nao serve o jogo ao vivo)."""
        ov = self.ov
        if ov.get("oscr"):
            self.media_rip(play=True)
            return
        argv = self.fm.command(ov["info"]["console"], ov["option"], ov["dev"])
        if not argv:
            self.say("RETROARCH CANNOT READ THIS DRIVE", 3)
            return
        self.launch(argv, media=True)
        self.last_input = time.monotonic()

    def media_rip(self, play=False):
        """O rip do disco (ou o dump do cartucho) para a pasta do emulador do
        cartao (femedia.py rip / oscr-rip, um processo so dele): a barra, e B
        cancela. play: o cartucho para uma copia temporaria, e o jogo abre
        dela (media_tick)."""
        card = self.ov
        oscr = card.get("oscr")
        # O disco: o titulo e o serial; o cartucho: o nome do cabecalho.
        name = self.fm.file_name({"title": card["title"]} if oscr else card["info"])
        if play:
            folder = os.path.join(self.fd.web.player_home(), ".cache", "fliperos", "oscr")
            shutil.rmtree(folder, ignore_errors=True)
        else:
            folder = os.path.join(self.fd.web.player_home(), "roms", card["option"]["folder"])
        if oscr:
            argv = ["oscr-rip", card["dev"]["dev"], card["info"]["system"], folder, name]
        else:
            argv = ["rip", card["dev"]["dev"], folder, name]
        try:
            proc = subprocess.Popen([sys.executable, self.fm.__file__] + argv,
                                    stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                    text=True, start_new_session=True)
        except OSError:
            self.say("COULD NOT START THE RIP", 3)
            return
        head = "READING THE CARTRIDGE" if play else ("DUMPING" if oscr else "RIPPING")
        dest = "TEMPORARY COPY - NOTHING IS KEPT" if play else "%s/%s" % (card["dest"], name.upper())
        ov = {"card": card, "proc": proc, "head": head, "title": card["title"], "result": None, "error": "",
              "progress": (0, 100, "STARTING"), "dest": dest, "oscr": oscr, "play": play}
        self.overlay, self.ov = "mediarip", ov

        def read():
            for line in proc.stdout:
                kind, _, rest = line.strip().partition(" ")
                if kind == "@step":
                    pct, _, text = rest.partition(" ")
                    if pct.isdigit():
                        ov["progress"] = (int(pct), 100, text)
                elif kind == "@done":
                    ov["path"] = rest
                elif kind == "@fail":
                    ov["error"] = rest
            proc.wait()
            ov["result"] = "ok" if proc.returncode == 0 and ov.get("path") else "fail"
        threading.Thread(target=read, daemon=True).start()

    def none_ov(self, msg=None, bad=False):
        """O estado da tela do boot pela midia sem disco (ou sem cartucho: o
        OSCR nao sente o cartucho entrar, e o botao 1 o le)."""
        d = self.device(self.boot) if self.boot else None
        if (self.boot or "").startswith("oscr"):
            return {"since": time.monotonic(), "inserted": None, "msg": msg or "NO CARTRIDGE", "bad": bad,
                    "cart": True, "sub": "PUT A CARTRIDGE IN THE OSCR AND PRESS 1"}
        name = d["name"] if d else "THE DRIVE"
        return {"since": time.monotonic(), "inserted": None, "msg": msg or "NO DISC", "bad": bad,
                "sub": "PUT A DISC IN %s TO CONTINUE" % name}

    def boot_leave(self):
        """O botao 2 no boot pela midia: a lista de jogos, como num boot comum."""
        self.boot = None
        self.overlay, self.ov = None, {}

    def media_tick(self, now):
        """O disco lido (o cartao ou o aviso), o rip que acabou, o disco que
        saiu com o cartao aberto e, no boot pela midia, o disco que chegou."""
        o, ov = self.overlay, self.ov
        if o == "mediaload" and ov.get("result") is not None and now - ov["since"] >= MEDIA_MIN_LOAD:
            info = ov["result"]
            self.overlay = None
            if ov.get("oscr") and not info.get("cancel"):
                self.oscr_result(ov["dev"], info, ov.get("system"))
                return
            if info.get("cancel"):
                pass
            elif info.get("console") and self.media_card(ov["dev"], info):
                return
            elif info.get("unsupported"):
                self.say("%s DISCS ARE NOT SUPPORTED" % info["unsupported"], 3)
            elif info.get("audio_only"):
                self.say("AUDIO CD: NO GAME ON IT", 3)
            elif not info.get("console") and not info.get("cancel"):
                self.say("UNKNOWN DISC", 3)
            if self.boot:
                # O disco nao abre: a tela pede outro (este nao e lido de novo).
                self.overlay, self.ov = "medianone", self.none_ov("UNKNOWN DISC", bad=True)
            return
        if o == "mediarip" and ov.get("result"):
            card = ov["card"]
            self.overlay, self.ov = "mediacard", card
            if ov["result"] == "ok" and ov.get("play"):
                # O cartucho lido: o jogo abre da copia, e o cartao volta depois.
                self.launch(self.fm.command(card["info"]["console"], card["option"], card["dev"], ov["path"]),
                            media=True)
                self.last_input = time.monotonic()
            elif ov["result"] == "ok":
                self.say("SAVED IN " + card["dest"], 3)
                self.lib.forget()
                self.lib.refresh()
            else:
                err = ov.get("error", "")
                fallback = "COULD NOT READ THE CARTRIDGE" if ov.get("oscr") else "COULD NOT RIP THE DISC"
                self.say({"cancelled": "CANCELLED", "not enough space": "NOT ENOUGH SPACE",
                          "cdrdao is not installed": "THE RIP TOOL IS MISSING",
                          "firmware": "THE OSCR NEEDS THE FLIPEROS FIRMWARE", "nocart": "NO CARTRIDGE FOUND",
                          "crc": "THE COPY CAME DAMAGED: TRY AGAIN", "noanswer": "THE OSCR DID NOT ANSWER",
                          "error": "THE OSCR STOPPED ON AN ERROR"}.get(err, fallback), 3)
            return
        if o in ("mediacard", "medialist"):
            card = ov if o == "mediacard" else ov.get("card")
            if not card:
                return
            d = self.device(card["dev"]["key"])
            if d and d.get("state") in ("empty", "open"):
                # O disco saiu: no boot, de volta a tela que pede outro.
                if self.boot:
                    self.overlay, self.ov = "medianone", self.none_ov()
                else:
                    self.overlay = None
                    self.say("DISC REMOVED", 2)
            return
        if o == "medianone" and ov.get("cart"):
            # O OSCR: o botao 1 (media_act) poe o cartucho; depois da animacao, o SCAN.
            d = self.device(self.boot)
            ov["sub"] = "PUT A CARTRIDGE IN THE OSCR AND PRESS 1" if d else "THE OSCR IS NOT CONNECTED"
            if d and ov["inserted"] is not None and now - ov["inserted"] >= self.view.INSERT_TIME + 0.3:
                self.media_open(d)
            return
        if o == "medianone":
            d = self.device(self.boot)
            state = d.get("state") if d else None
            if ov.get("bad"):
                if state != "disc":
                    self.ov = self.none_ov()
                return
            if d is None:
                ov["sub"] = "THE DRIVE IS NOT CONNECTED"
            elif state == "noaccess":
                ov["sub"] = "NO ACCESS TO THE DRIVE"
            elif state in ("disc", "busy") and ov["inserted"] is None:
                ov["inserted"] = now
            elif state in ("empty", "open") and ov["inserted"] is not None:
                self.ov = self.none_ov()
            if (state == "disc" and ov["inserted"] is not None
                    and now - ov["inserted"] >= self.view.INSERT_TIME + 0.3):
                self.media_open(d)

    def launch(self, argv=None, game=None, media=False):
        # media: o disco do drive (argv pronto), sem jogo da lista para contar
        # a partida.
        g = None if media else (game or self.game())
        if g and g.get("Packed") and argv is None:
            # Um jogo Namco ainda em .gz nao tem comando: extrai (com a barra no
            # centro) e so entao abre (unpack_tick). Vem antes do "sem comando".
            if self.locked():
                self.nag()
                return
            self.unpack_start(g)
            return
        argv = argv or (self.lib.command(g) if g else None)
        if not argv:
            self.say("CANNOT OPEN THIS GAME")
            return
        if self.locked():
            self.nag()
            return
        core = missing_core(argv)
        if core:
            self.core_start(g, argv, core, media)
            return
        emulator = missing_emulator(argv)
        if emulator:
            self.emulator_start(g, argv, emulator, media)
            return
        self.remember()
        pg = self.pg
        # O video, o som, os controles (e a rede) ficam para o jogo.
        self.player.stop()
        self.grid.stop()
        self.harvest.paused = True
        self.input.close()
        try:
            pg.mixer.quit()
        except pg.error:
            pass
        self.close()
        started = time.monotonic()
        ended = self.play(argv)
        played = time.monotonic() - started
        if played > 10 and g:
            self.lib.played(g, played)
            self.rebuild(keep=g["Name"])          # o grupo RECENT acompanha
            if getattr(self, "cheevos", None) is not None:
                self.cheevos.refresh_game(g)      # as conquistas desta partida no selo
        self.harvest.paused = False
        self.open()
        self.input.open()
        self.media.clear()
        self.repeat.clear()
        pg.event.clear()
        if ended:
            self.say(ended, 3)

    def play(self, argv):
        """Abre o jogo e espera ele fechar. Enquanto isso: o atalho que o
        fecha (Tab > Frontend options), as fichas e o fim do tempo do modo
        comercial, e o arquivo do botao de desligar (FLIPEROS_POWERKEY
        games:ARQ, do config/fliperos-session) com o PID do jogo, ou "hold"
        com o botao desligado nos jogos. Devolve o aviso para a volta.

        O atalho do menu do emulador vem antes do jogo: o teclado virtual
        por onde a tecla do menu sai ja existe quando o jogo abre ("ready")."""
        state = {}
        watch = self.hotkeys(argv)
        if watch:
            ready = threading.Event()

            def read():
                for line in watch.stdout:
                    if line.strip() == "exit":
                        state["exit"] = True
                    elif line.strip() == "coin":
                        self.insert_coin()
                    elif line.strip() == "ready":
                        ready.set()
                ready.set()
            threading.Thread(target=read, daemon=True).start()
            ready.wait(2)
            argv = self.menu_argv(argv)
        try:
            proc = subprocess.Popen(argv, env=game_env())
        except OSError:
            if watch:
                watch.terminate()
            return None
        role = os.environ.get("FLIPEROS_POWERKEY", "")
        mark = role[len("games:"):] if role.startswith("games:") else None
        if mark:
            try:
                with open(mark, "w") as f:
                    f.write("%d\n" % proc.pid if self.power_exit else "hold\n")
            except OSError:
                mark = None
        try:
            while proc.poll() is None:
                if state.pop("exit", False):
                    self.stop(proc, state)
                elif self.commercial and self.left() <= 0 and "time" not in state:
                    # O tempo acabou: o jogo fecha.
                    state["time"] = True
                    self.stop(proc, state)
                elif state.get("kill") and time.monotonic() > state["kill"]:
                    self.stop(proc, state, signal.SIGKILL)
                time.sleep(0.1)
        finally:
            if proc.poll() is None:
                self.stop(proc, state)
            if watch:
                watch.terminate()
                try:
                    watch.wait(2)
                except subprocess.TimeoutExpired:
                    watch.kill()
            if mark:
                try:
                    os.unlink(mark)
                except OSError:
                    pass
        return "TIME IS UP - INSERT COIN" if state.get("time") else None

    def stop(self, proc, state, sig=signal.SIGTERM):
        """Fecha o jogo: ele e o que esta abaixo dele (o X, o emulador); quem
        nao sai em 4 s leva o SIGKILL."""
        for pid in tree(proc.pid):
            try:
                os.kill(pid, sig)
            except OSError:
                pass
        state["kill"] = time.monotonic() + 4 if sig == signal.SIGTERM else None

    def menu_argv(self, argv):
        """O comando do jogo com o atalho do menu: no RetroArch, sem o Start +
        Select dele (RA_NO_COMBO num --appendconfig), que abriria o menu e o
        nosso o fecharia."""
        if not (self.menu_combo or self.menu_key) or game_program(argv) != "retroarch":
            return argv
        path = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "fliperos-retroarch-menu.cfg")
        try:
            with open(path, "w") as f:
                f.write(RA_NO_COMBO)
        except OSError:
            return argv
        # Logo depois do retroarch: o fliperos-kms-run le o jogo do fim.
        i = argv.index("retroarch") + 1 if "retroarch" in argv else 2
        return argv[:i] + ["--appendconfig", path] + argv[i:]

    def hotkeys(self, argv=None):
        """O fliperos-buttons hotkey junto com o jogo: o atalho que o fecha, o
        que abre o menu do emulador (--program: o fliperos-buttons sabe a
        tecla de cada um) e, no modo comercial, as fichas. Sem nada a ler,
        nenhum."""
        args = []
        if self.exit_key:
            args += ["--key", str(self.exit_key[1])]
        if self.exit_combo:
            args += ["--combo", "+".join(self.exit_combo), "--hold", str(EXIT_HOLD)]
        if self.menu_key:
            args += ["--menu-key", str(self.menu_key[1])]
        if self.menu_combo:
            args += ["--menu-combo", "+".join(self.menu_combo), "--menu-hold", str(EXIT_HOLD)]
        if (self.menu_key or self.menu_combo) and game_program(argv or []):
            args += ["--program", game_program(argv)]
        if self.commercial:
            args.append("--coin")
        if not args or not os.access(BUTTONS_TOOL, os.X_OK):
            return None
        try:
            return subprocess.Popen([BUTTONS_TOOL, "hotkey"] + args, stdin=subprocess.DEVNULL,
                                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        except OSError:
            return None

    # ── O laco ──
    def tick(self, now):
        """As repeticoes segurando, a aceleracao e o modo letra."""
        dt = min(0.1, now - getattr(self, "last_tick", now))
        self.last_tick = now
        if self.picking and self.strip is None and now - self.pick_at >= PICK_WAIT:
            self.pick_category()
        if self.overlay and self.overlay not in ("filter", "classify", "rename", "more"):
            return
        # O modo letra acaba com LETTER_IDLE segundos sem mexer.
        if (self.letter_mode and self.input.held("up") is None and self.input.held("down") is None
                and now - self.letter_mode["last"] > LETTER_IDLE):
            self.letter_off()
        for a in ("up", "down"):
            held = self.input.held(a)
            if held is None:
                self.repeat.pop(a, None)
                continue
            if self.overlay:
                # Nos menus, a repeticao simples (sem acelerar).
                if a not in self.repeat:
                    self.repeat[a] = now + FIRST
                elif now >= self.repeat[a]:
                    self.repeat[a] = now + 0.12
                    self.overlay_act(a)
                continue
            step = 1 if a == "down" else -1
            if self.letter_mode:
                # Segurando no modo letra: repete a letra, devagar e depois
                # mais rapido.
                lheld = now - self.letter_mode["press"]
                if lheld >= FIRST and now >= self.repeat.get(a, 0):
                    rate = LRATE0 if lheld < LSPEEDUP else min(LRATE1, LRATE0 + (lheld - LSPEEDUP) * 9)
                    self.letter_jump(step, wrap=False)
                    self.repeat[a] = now + 1.0 / rate
            elif held >= LETTERS:
                # 3 s segurando: entra no modo letra, que ja comeca andando.
                self.letter_mode = {"press": now - FIRST, "last": now}
                self.letter_jump(step, wrap=False)
                self.repeat[a] = now + 1.0 / LRATE0
            elif held >= FIRST:
                k = min(1.0, (held - FIRST) / (LETTERS - FIRST))
                self.acc += (RATE0 + (RATE1 - RATE0) * k ** 1.5) * dt
                n = int(self.acc)
                if n:
                    self.acc -= n
                    self.move(step * n * (COLS if self.mode == "flow" else 1), wrap=False)
        for a, gap in (("left", 0.5), ("right", 0.5), ("b3", 0.18), ("b6", 0.18)):
            held = self.input.held(a)
            if held is None or self.overlay:
                continue
            if held >= gap and now >= self.repeat.get(a, 0):
                self.repeat[a] = now + (0.35 if a in ("left", "right") else 0.15)
                self.act(a)

    def run(self, keys=()):
        clock = self.pg.time.Clock()
        if self.shot:
            self.overlay = None
            frames = [None] + list(keys)
            for i, k in enumerate(frames):
                if k:
                    if self.act(k) == "quit":
                        break
                self.draw(time.monotonic())
                self.pg.image.save(self.back, "%s-%d.png" % (self.shot, i))
            return 0
        self.last_input, self.idle = time.monotonic(), False
        self.attract_next = None
        # O marquee abre no logotipo do sistema em que o frontend abriu (as
        # trocas o mandam em switch_category).
        self.marquee_logo((self.category() or {}).get("name", ""), "", 1)
        while True:
            now = time.monotonic()
            acts = self.input.poll()
            woke = bool(acts) and self.attract_next is not None
            self.marquee_idle(now, bool(acts) or bool(self.input.down))
            if woke:
                # O modo atracao passava os jogos: o toque so acorda, no jogo
                # em que parou (o quit, que vem do sistema, ainda vale).
                self.attract_next = None
                acts = [a for a in acts if a == "quit"]
            for a in acts:
                r = self.act(a)
                if r == "quit":
                    self.remember()
                    # Fora do frontend (o menu): o marquee sai do sistema e toca
                    # a animacao do logo.
                    if not self.shot:
                        try:
                            subprocess.Popen([PIXELCADE_TOOL, "bg", "home"], stdin=subprocess.DEVNULL,
                                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                             start_new_session=True)
                        except OSError:
                            pass
                    return 0
                if r == "launch":
                    self.launch()
                    self.last_input = time.monotonic()
                    # O jogo fechou: o marquee volta ao logotipo do sistema (o
                    # "end" do vigia do jogo nem sempre chega, e um atrasado
                    # acha o estado ja trocado e nao mexe nele).
                    self.marquee_logo((self.category() or {}).get("name", ""), "", 1)
            self.attract_tick(now)
            self.tick(now)
            self.link_tick(now)
            self.capture_tick(now)
            # O tempo do modo comercial acabou aqui no frontend.
            paid = self.commercial and self.left() > 0
            if getattr(self, "paid", False) and not paid:
                self.say("TIME IS UP - INSERT COIN", 3)
            self.paid = paid
            if self.lib.generation != self.generation:
                self.generation = self.lib.generation
                g = self.game()
                key = (self.category() or {}).get("key")
                if self.picking:
                    self.cancel_pick()    # a tira apontaria para outro sistema
                self.cats = self.lib.categories()
                self.cat = next((i for i, c in enumerate(self.cats) if c["key"] == key), 0)
                self.load_filter()
                self.rebuild(keep=g["Name"] if g else None)
                # O --romlists tambem grava arte (a tela de titulo dos paks do
                # OpenBOR, fliperos-openbor-meta): um jogo guardado sem
                # imagem e procurado de novo.
                self.flush = True
                # As listas chegaram (ou mudaram): o marquee ainda nao tem o sistema de agora.
                name = (self.category() or {}).get("name", "")
                if name and name != getattr(self, "announced", None):
                    self.marquee_logo(name, "", 1)
            if now - self.last_check > 4 and not self.lib.refreshing:
                self.last_check = now
                if self.lib.changed():
                    self.say("UPDATING THE LISTS...", 3)
                    self.lib.refresh()
            self.auto_scrape(now)
            self.bios.refresh(now)
            self.unpack_tick()
            self.media_tick(now)
            # O servico do scrape automatico (fliperos-scrape --daemon): o
            # andamento dele e a midia nova; sem ele, o laco e o daqui.
            if now - self.followed_at > 3:
                self.followed_at = now
                self.harvest.external = self.harvest.follow()
            while self.dirty:
                folder, name = self.dirty.pop()
                for kind in ("snap", "box", "marquee", "logo", "preview"):
                    self.media.pop(("path", kind, folder, name), None)
                self.media.pop(("video", folder, name), None)
                self.media.pop(("desc", folder, name), None)   # a sinopse (feview.game_description)
                self.ahead_at = None
            if self.flush:
                # Um scrape trouxe arquivos: os caminhos e as imagens guardados
                # sao lidos de novo (limpos aqui, fora da thread dele).
                self.flush = False
                self.media.clear()
                self.ready.clear()
                self.ahead_at = None
            self.prefetch()
            self.draw(now)
            self.present()
            clock.tick(FPS)

    def splash(self):
        """A tela de abrir: o fundo animado do menu e o aviso."""
        T, W = self.T, self.W
        self.pg.event.pump()
        self.bg.draw(self.back, time.monotonic() - self.start)
        ui = self.pg.Surface((T.WIDTH, T.HEIGHT), self.pg.SRCALPHA)
        W.frame(ui, {}, "FliperOS", [])
        msg = "LOADING THE GAMES..."
        ui.blit(W.big(msg, 1, W.LABEL), ((T.WIDTH - W.width(msg)) // 2, T.HEIGHT // 2 - 4))
        self.back.blit(ui, (0, 0))
        self.present()

    # ── Adiantar as imagens ──
    def prefetch(self):
        """Quando o cursor (ou o modo, ou a lista) muda, passa a thread as
        imagens dos proximos jogos para os dois lados, as do lado de baixo
        primeiro; na grade, tambem as da fileira de cima e de baixo."""
        at = (self.cursor, self.mode, id(self.rows), len(self.rows), self.overlay)
        if at == self.ahead_at or not self.rows:
            return
        self.ahead_at = at
        reach = 3 * COLS if self.mode == "flow" else 6
        order = [0]
        for k in range(1, reach + 1):
            order += [k, -k]
        keys = []
        import feview
        for k in order:
            i = self.cursor + k
            if 0 <= i < len(self.rows):
                if self.rows[i][0] is None:
                    continue
                for key in feview.wanted(self, self.rows[i][0]):
                    if key not in self.media and key not in self.ready and key not in keys:
                        keys.append(key)
        self.ahead = keys
        self.ahead_wake.set()

    def prefetch_work(self):
        import feview
        while True:
            self.ahead_wake.wait()
            self.ahead_wake.clear()
            while self.ahead:
                keys = self.ahead
                key = keys[0]
                if keys is self.ahead:
                    self.ahead = keys[1:]
                if key in self.media or key in self.ready:
                    continue
                try:
                    img = feview.load(*key)
                except Exception:  # um arquivo estragado: o desenho tenta de novo
                    continue
                if len(self.ready) > 120:
                    try:
                        self.ready.pop(next(iter(self.ready)), None)
                    except (RuntimeError, StopIteration):
                        pass
                self.ready[key] = img

    def present(self):
        if self.window is None:
            return
        # Em pe, a tela logica gira para o lado do monitor antes de esticar.
        self.pg.transform.scale(self.T.upright(self.back), self.window.get_size(), self.window)
        self.pg.display.flip()

    # ── Desenho ──
    def draw(self, now):
        self.view.draw(self, now)   # (o desenho fica em gui/feview.py)


def main():
    parser = argparse.ArgumentParser(description="FliperOS frontend")
    parser.add_argument("--shot", help="no video: write PREFIX-N.png after each key of --keys")
    parser.add_argument("--keys", default="", help="actions to run first, e.g. 'b1 right b1'")
    parser.add_argument("--media", action="store_true",
                        help="boot from media: ask for the disc of the drive set in Setup > Frontend")
    args = parser.parse_args()
    fe = Frontend(args)
    return fe.run(args.keys.split())


if __name__ == "__main__":
    sys.exit(main())
