#!/usr/bin/env python3
# A interface grafica do FliperOS Setup.
#
# Roda em 640x240. A interface e desenhada numa tela logica de 320x240 e
# esticada 200% na horizontal: no modo 640x240 o pixel e duas vezes mais
# largo que alto, entao o resultado no tubo 4:3 sao pixels quadrados. Sem
# esse modo na saida, usa o modo atual e estica a tela logica ate ele.
#
#   fliperos-gui --serve PASTA
#       O servidor do fliperos-setup (lib/ui.sh): le os pedidos de tela de
#       PASTA/req e responde em PASTA/resp (serve.py).
#   fliperos-gui --demo main                      uma tela de demonstracao
#   fliperos-gui --demo main --preview            numa janela 4:3 de 960x720
#   fliperos-gui --demo main --keys "right enter" --shot /tmp/main
#       grava /tmp/main-640x240.png (o quadro que vai para a placa) e
#       /tmp/main-crt.png (como aparece no tubo) e sai, sem abrir video.
#
# O fundo e animado e sorteado a cada abertura (background.py); --bg NOME
# ou FLIPEROS_GUI_BG fixam um.
#
# O joystick nao e lido aqui: o fliperos-padkeys ja o transforma nas teclas
# do menu (setas, Enter, Esc, Espaco, PageUp, PageDown).

import argparse
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

PREVIEW = (960, 720)
FPS = 60


class App:
    """A janela, o fundo animado e o laco de teclas."""

    def __init__(self, preview=False, headless=False, bg=None, keys=()):
        if headless:
            os.environ["SDL_VIDEODRIVER"] = "dummy"
        os.environ.setdefault("PYGAME_HIDE_SUPPORT_PROMPT", "1")
        import pygame

        import background
        import theme

        self.pygame, self.theme, self.background = pygame, theme, background
        self.preview = preview
        self.queue = list(keys)   # teclas de teste, apertadas antes das de verdade
        self.window = None
        self.open()
        pygame.font.init()
        self.clock = pygame.time.Clock()
        self.bg_name = bg
        self.start = time.monotonic()
        self.fixed_time = None    # os prints: um instante fixo do fundo
        # A orientacao do monitor (lib/ui.sh a passa; o pedido "orient" a troca).
        self.set_orientation(os.environ.get("FLIPEROS_GUI_ORIENTATION", "horizontal"))

    def set_orientation(self, orientation):
        """Em pe (Video Setup > Monitor Orientation), a tela logica e
        240x320: a interface e desenhada em pe, do tamanho dela, e so o
        quadro pronto gira para o lado do monitor (final)."""
        pygame, theme = self.pygame, self.theme
        self.orientation = orientation
        theme.set_orientation(orientation)
        self.background.set_size(theme.WIDTH, theme.HEIGHT)
        self.back = pygame.Surface((theme.WIDTH, theme.HEIGHT))
        self.ui = pygame.Surface((theme.WIDTH, theme.HEIGHT), pygame.SRCALPHA)
        old = getattr(self, "bg", None)
        self.bg = self.background.pick(self.bg_name or (old.name if old else None))
        self.sounds = {}
        self.names = {
            pygame.K_UP: "up", pygame.K_DOWN: "down", pygame.K_LEFT: "left", pygame.K_RIGHT: "right",
            pygame.K_RETURN: "enter", pygame.K_KP_ENTER: "enter", pygame.K_ESCAPE: "esc",
            pygame.K_SPACE: "space", pygame.K_PAGEUP: "pgup", pygame.K_PAGEDOWN: "pgdn",
            pygame.K_BACKSPACE: "backspace",
        }

    def open(self):
        """Abre o video: 640x240 se a saida tem o modo, senao o modo atual.
        No desktop (SDL_VIDEODRIVER=x11, o atalho FliperOS Setup do LXDE),
        uma janela sem borda do tamanho da tela."""
        pygame = self.pygame
        pygame.display.init()
        flags = 0
        size = PREVIEW if self.preview else self.theme.MODE
        driver = os.environ.get("SDL_VIDEODRIVER")
        if driver == "kmsdrm":
            flags = pygame.FULLSCREEN
            modes = pygame.display.list_modes()
            if not isinstance(modes, list) or size not in modes:
                info = pygame.display.Info()
                size = (info.current_w, info.current_h)
        elif driver == "x11" and not self.preview:
            info = pygame.display.Info()
            size, flags = (info.current_w, info.current_h), pygame.NOFRAME
        self.window = pygame.display.set_mode(size, flags)
        self.size = self.window.get_size()
        pygame.display.set_caption("FliperOS Setup")
        pygame.mouse.set_visible(False)
        self.mute_console(True)

    def close(self):
        """Solta o video (um programa de texto ou outro modo vai usa-lo)."""
        if self.window is not None:
            self.mute_console(False)
            self.pygame.display.quit()
            # Na Intel o Mesa deixa o master da tela para tras (gui/drmmaster.py).
            import drmmaster
            drmmaster.drop()
            self.window = None

    def mute_console(self, mute):
        """O teclado do console (FLIPEROS_GUI_CONSOLE, o VT da tela) calado
        enquanto a interface esta no video. O SDL so cala o terminal de
        controle do processo, que aqui e o pty do sudo: sem isto o que se
        aperta no menu se acumula no tty1 e aparece de uma vez quando ele
        fecha. Ao soltar, volta o modo de antes e o acumulado e descartado."""
        import fcntl
        import struct
        import termios

        path = os.environ.get("FLIPEROS_GUI_CONSOLE", "")
        if not path:
            return
        kdgkbmode, kdskbmode, k_off, k_unicode = 0x4B44, 0x4B45, 0x04, 0x03
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NOCTTY)
        except OSError:
            return
        try:
            if mute:
                buf = fcntl.ioctl(fd, kdgkbmode, struct.pack("i", 0))
                self.kbmode = struct.unpack("i", buf)[0]
                if self.kbmode != k_off:
                    fcntl.ioctl(fd, kdskbmode, k_off)
            else:
                fcntl.ioctl(fd, kdskbmode, getattr(self, "kbmode", k_unicode) or k_unicode)
                termios.tcflush(fd, termios.TCIFLUSH)
        except OSError:
            pass
        finally:
            os.close(fd)

    def load_sounds(self):
        """Os sons do menu, os mesmos do gum (GUM_SOUND_MOVE/SELECT). Sem
        audio livre, fica sem som."""
        try:
            self.pygame.mixer.init()
            for name in ("move", "select"):
                path = os.environ.get("GUM_SOUND_" + name.upper(), "")
                if path and os.path.isfile(path):
                    self.sounds[name] = self.pygame.mixer.Sound(path)
        except Exception:
            self.sounds = {}

    def beep(self, key):
        name = "select" if key == "enter" else "move" if key in ("up", "down", "left", "right") else ""
        if name in self.sounds:
            self.sounds[name].play()

    def keys(self):
        """As teclas apertadas desde a ultima chamada, pelo nome."""
        pygame = self.pygame
        out = []
        if self.queue:
            out.append(self.queue.pop(0))
        if self.window is None:
            return out
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                out.append("quit")
            elif event.type == pygame.KEYDOWN:
                key = self.names.get(event.key)
                if key is None and event.unicode and event.unicode.isprintable():
                    key = event.unicode
                if key:
                    out.append(key)
        return out

    def flush(self):
        """Descarta as teclas apertadas enquanto nada era perguntado."""
        if self.window is not None:
            self.pygame.event.clear()

    def compose(self, screen, ctx, redraw=True):
        """Um quadro na tela logica: o fundo e, por cima, a interface."""
        if self.fixed_time is not None and getattr(screen, "slide", None):
            # Os prints: o carrossel ja parado, sem a transicao.
            screen.slide = None
        now = self.fixed_time if self.fixed_time is not None else time.monotonic() - self.start
        self.now = now
        if redraw:
            self.ui.fill((0, 0, 0, 0))
            if screen is not None:
                # O relogio das animacoes da tela (o azulejo escolhido): o
                # mesmo do fundo, parado nos prints.
                if isinstance(ctx, dict):
                    ctx["now"] = now
                screen.draw(self.ui, ctx)
        self.bg.draw(self.back, now)
        self.back.blit(self.ui, (0, 0))
        return self.back

    def final(self, frame):
        """O quadro como vai ao tubo: em pe, a tela de 240x320 gira para o
        lado do monitor, como o console (fbcon rotate 1 = horario)."""
        return self.theme.upright(frame)

    def show(self, screen, ctx, redraw=True, busy=False):
        """Um quadro no video. busy: o Setup esta trabalhando, e a ampulheta
        gira no canto."""
        if self.window is None:
            return
        frame = self.compose(screen, ctx, redraw)
        if busy:
            import widgets
            widgets.hourglass(frame, self.now)
        self.pygame.transform.scale(self.final(frame), self.size, self.window)
        self.pygame.display.flip()

    def tick(self):
        self.clock.tick(FPS)

    def save(self, screen, ctx, prefix):
        frame = self.final(self.compose(screen, ctx))
        scale = self.pygame.transform.scale
        self.pygame.image.save(scale(frame, self.theme.MODE), prefix + "-640x240.png")
        self.pygame.image.save(scale(frame, PREVIEW), prefix + "-crt.png")


def run_demo(app, args):
    import demo

    stack = [demo.SCREENS[args.demo]()]

    def press(key):
        """Entrega a tecla a tela de cima. False quando a ultima tela fecha."""
        result = stack[-1].key(key)
        if not result:
            return True
        action, value = result
        target = demo.LINKS.get(value, value) if isinstance(value, str) else None
        if action == "select" and target in demo.SCREENS:
            stack.append(demo.SCREENS[target]())
        elif action == "back" or value == "return":
            stack.pop()
        return bool(stack)

    for key in args.keys.split():
        if not press(key):
            return 0
    if args.shot:
        app.fixed_time = args.time
        app.save(stack[-1], demo.CONTEXT, args.shot)
        return 0
    redraw = True
    while True:
        for key in app.keys():
            if key == "quit" or not press(key):
                return 0
            redraw = True
        tick = getattr(stack[-1], "tick", None)
        if tick and tick() == "redraw":
            redraw = True
        app.show(stack[-1], demo.CONTEXT, redraw)
        redraw = False
        app.tick()


def main():
    parser = argparse.ArgumentParser(description="FliperOS graphical setup")
    parser.add_argument("--serve", metavar="DIR", help="serve the screens of fliperos-setup (DIR/req, DIR/resp)")
    parser.add_argument("--demo", default="main", help="demo screen to open")
    parser.add_argument("--keys", default="", help="keys to press first, e.g. 'right right enter'")
    parser.add_argument("--shot", metavar="PREFIX", help="write PREFIX-640x240.png and PREFIX-crt.png and exit")
    parser.add_argument("--bg", help="background: stars, snow, water, fire or smoke (default: random)")
    parser.add_argument("--time", type=float, default=3.0, help="with --shot, the moment of the background")
    parser.add_argument("--preview", action="store_true", help="open a 960x720 window, as seen on the 4:3 tube")
    parser.add_argument("--list", action="store_true", help="list the demo screens")
    args = parser.parse_args()

    if args.serve:
        import serve
        return serve.main(App, args)

    app = App(args.preview, bool(args.shot) or args.list, args.bg or ("stars" if args.shot else None))
    import demo

    if args.list:
        print("\n".join(demo.SCREENS))
        return 0
    if args.demo not in demo.SCREENS:
        print("fliperos-gui: unknown demo screen: " + args.demo, file=sys.stderr)
        return 2
    return run_demo(app, args)


if __name__ == "__main__":
    sys.exit(main())
