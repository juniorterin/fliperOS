# Build isolado do fliperos-mkiso.sh — evita o vazamento de /dev do host
# que o WSL2 causa com chroot+debootstrap nativo (ver CLAUDE.md).
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      debootstrap squashfs-tools xorriso \
      grub-pc-bin grub-efi-amd64-bin grub-common \
      mtools dosfstools \
      ca-certificates wget curl git python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY fliperos-*.sh fliperos-*.py crt15-edid.bin ./
COPY config/ ./config/
RUN chmod +x ./*.sh
