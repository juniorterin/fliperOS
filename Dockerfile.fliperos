# Build isolado do fliperos-mkiso.sh — evita o vazamento de /dev do host
# que o WSL2 causa com chroot+debootstrap nativo (ver CLAUDE.md).
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

# O kernel 15 kHz e compilado aqui mesmo (fliperos-kernel.sh instala as
# dependencias dele quando precisa compilar, e nao quando ha cache).
RUN apt-get update && apt-get install -y --no-install-recommends \
      debootstrap squashfs-tools xorriso \
      gcc libc6-dev make \
      ca-certificates wget curl git python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY fliperos-*.sh fliperos*.py ./
COPY fliperos-setup/ ./fliperos-setup/
COPY config/ ./config/
COPY patches/ ./patches/
COPY updates/ ./updates/
RUN chmod +x ./*.sh ./fliperos-setup/fliperos-setup
