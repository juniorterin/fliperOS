# Build isolado do fliperos-mkiso.sh — evita o vazamento de /dev do host
# que o WSL2 causa com chroot+debootstrap nativo (ver CLAUDE.md).
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      debootstrap squashfs-tools xorriso \
      gcc libc6-dev make \
      ca-certificates wget curl git python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
# O glob e "fliperos*.py", nao "fliperos-*.py": o modulo compartilhado de
# interface e fliperos_tui.py, com underscore, e o hifen nao o pegaria.
COPY fliperos-*.sh fliperos*.py crt15-edid.bin crt25-edid.bin crt31-edid.bin ./
COPY config/ ./config/
COPY patches/ ./patches/
RUN chmod +x ./*.sh
