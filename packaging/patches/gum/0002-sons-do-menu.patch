diff --git a/internal/sfx/sfx.go b/internal/sfx/sfx.go
new file mode 100644
--- /dev/null
+++ b/internal/sfx/sfx.go
@@ -0,0 +1,44 @@
+// Package sfx plays the FliperOS menu sounds: GUM_SOUND_MOVE when the cursor
+// moves and GUM_SOUND_SELECT on submit (WAV files, played with aplay). Unset
+// or missing files are silent.
+package sfx
+
+import (
+	"os"
+	"os/exec"
+	"sync"
+)
+
+var (
+	mu   sync.Mutex
+	last *exec.Cmd
+)
+
+func play(env string) {
+	file := os.Getenv(env)
+	if file == "" {
+		return
+	}
+	if _, err := os.Stat(file); err != nil {
+		return
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	// A new sound cuts the one still playing (scrolling fast).
+	if last != nil && last.Process != nil {
+		_ = last.Process.Kill()
+	}
+	cmd := exec.Command("aplay", "-q", file)
+	if err := cmd.Start(); err != nil {
+		last = nil
+		return
+	}
+	last = cmd
+	go func() { _ = cmd.Wait() }()
+}
+
+// Move plays the cursor sound.
+func Move() { play("GUM_SOUND_MOVE") }
+
+// Select plays the selection sound. It keeps playing after gum exits.
+func Select() { play("GUM_SOUND_SELECT") }
