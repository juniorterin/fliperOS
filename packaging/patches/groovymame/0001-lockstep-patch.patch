+#ifndef MAME_EMU_LOCKSTEP_H
+#define MAME_EMU_LOCKSTEP_H
+
+#pragma once
+
+#include <memory>
+
+class lockstep_manager
+{
+public:
+	// the party of this machine, from fliperos-lockstep.ini in the cfg
+	// directory with transport=native; nullptr when there is none
+	static std::unique_ptr<lockstep_manager> create(running_machine &machine);
+	virtual ~lockstep_manager() = default;
+
+	// called once per video frame, after the ports are updated and before
+	// their values go anywhere: every player's bits of frame - delay
+	virtual void frame_update() = 0;
+};
+
+#endif // MAME_EMU_LOCKSTEP_H
