+    // FliperOS: on a CRT mode with wide pixels (640x240 on a 4:3 tube) ESDE_STRETCH_X=N renders
+    // the interface at 1/N of the display width and stretches it N times horizontally, so
+    // text and images keep their proportions on the tube.
+    const char* stretchX {getenv("ESDE_STRETCH_X")};
+    if (stretchX != nullptr && !Settings::getInstance()->getInt("ScreenWidth") &&
+        Settings::getInstance()->getInt("ScreenRotate") == 0) {
+        const int factor {atoi(stretchX)};
+        if (factor >= 2 && factor <= 4 && displayMode.w % factor == 0) {
+            mStretchX = factor;
+            sScreenWidth = displayMode.w / factor;
+            LOG(LogInfo) << "Horizontal stretch: " << factor << "x (ESDE_STRETCH_X)";
