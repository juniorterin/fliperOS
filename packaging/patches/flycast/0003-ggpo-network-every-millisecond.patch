+// The network of the session every millisecond, apart from the frames
+// (FliperOS): what arrived is read and what waits is sent at once, so an
+// input or an acknowledgement never waits for the next frame, about 16 ms
+// on each side, and the ping GGPO measures (which sets how far ahead a side
+// may run, and so how much it predicts and rolls back) is the cable's.
+// Rollbacks stay in the frame (ggpo_idle in nextFrame). try_lock: it never
+// holds up a frame or a stopSession waiting for it.
+static void networkLoop()
+{
+	ThreadName _("GGPO-net");
+#ifdef _WIN32
+	timeBeginPeriod(1);
+#endif
+	while (netRunning)
+	{
+		{
+			std::unique_lock<std::recursive_mutex> lock(ggpoMutex, std::try_to_lock);
+			if (lock.owns_lock() && ggpoSession != nullptr && !inRollback)
+			{
+				try {
+					ggpo_poll_network(ggpoSession);
+				} catch (const std::exception& e) {
+					// A disconnection (on_event throws): the next frame ends the session.
+					std::lock_guard<std::mutex> _(netErrorMutex);
+					netError = e.what();
+					netRunning = false;
+				}
+			}
+		}
+		std::this_thread::sleep_for(std::chrono::milliseconds(1));
+	}
+#ifdef _WIN32
+	timeEndPeriod(1);
+#endif
+}
+
+static void stopNetworkThread()
+{
+	netRunning = false;
+	if (netThread.joinable() && netThread.get_id() != std::this_thread::get_id())
+		netThread.join();
+}
