+	stopNetworkThread();
+	{
+		std::lock_guard<std::mutex> _(netErrorMutex);
+		netError.clear();
+	}
+	netRunning = true;
+	netThread = std::thread(networkLoop);
 	DEBUG_LOG(NETWORK, "GGPO session started");
 #endif
 }
 
