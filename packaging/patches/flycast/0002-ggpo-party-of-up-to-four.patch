+static std::vector<std::string> splitList(const std::string& s)
+{
+	std::vector<std::string> out;
+	std::string item;
+	for (char c : s + ";")
+	{
+		if (c == ';' || c == ',' || c == ' ')
+		{
+			if (!item.empty())
+				out.push_back(item);
+			item.clear();
+		}
+		else
+			item += c;
+	}
+	return out;
+}
+
+// The party (FliperOS): network:GGPOPeers has the machines of the session in
+// order ("ip" or "ip:port", separated by ';'), network:GGPOPlayerNum this
+// one's place in it (from 1) and network:GGPOSlots how many controllers each
+// one plays (same order, 1 when missing). The ports go to the machines in
+// order: 2;1;1 gives ports 1 and 2 to the first one, 3 to the second and 4 to
+// the third. Without GGPOPeers, Flycast's own session of two (network:server).
+static void setupPlayers(int& localPlayerNum, int& localPort)
+{
+	std::vector<std::string> peers = splitList(config::GGPOPeers.get());
+	partyMode = !peers.empty();
+	if (!partyMode)
+	{
+		numPlayers = 2;
+		portCount[0] = portCount[1] = 1;
+		firstPort[0] = 0;
+		firstPort[1] = 1;
+		return;
+	}
+	numPlayers = (int)peers.size();
+	if (numPlayers < 2 || numPlayers > MAX_PLAYERS)
+		throw FlycastException(strprintf("GGPO: %d machines in GGPOPeers, 2 to %d expected", numPlayers, MAX_PLAYERS));
+	localPlayerNum = config::GGPOPlayerNum.get() - 1;
+	if (localPlayerNum < 0 || localPlayerNum >= numPlayers)
+		throw FlycastException("GGPO: GGPOPlayerNum is not a place in GGPOPeers");
+	std::vector<std::string> slots = splitList(config::GGPOSlots.get());
+	int port = 0;
+	for (int i = 0; i < numPlayers; i++)
+	{
+		int n = i < (int)slots.size() ? atoi(slots[i].c_str()) : 1;
+		// Every machine after this one still needs a port.
+		portCount[i] = std::max(1, std::min(n, 4 - port - (numPlayers - 1 - i)));
+		firstPort[i] = port;
+		port += portCount[i];
+		size_t colon = peers[i].find(':');
+		partyAddress[i] = peers[i].substr(0, colon);
+		partyPort[i] = colon == std::string::npos ? SERVER_PORT : atoi(peers[i].substr(colon + 1).c_str());
+		NOTICE_LOG(NETWORK, "GGPO party: machine %d %s:%d, ports %d to %d%s", i + 1, partyAddress[i].c_str(), partyPort[i],
+				firstPort[i] + 1, firstPort[i] + portCount[i], i == localPlayerNum ? " (this one)" : "");
+	}
+	localPort = partyPort[localPlayerNum];
+}
